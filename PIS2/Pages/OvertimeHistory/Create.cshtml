@page
@model PIS2.Pages.OvertimHistory.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>overtimeHistoryModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="overtimeHistoryModel.overtimeRecordID" class="control-label"></label>
                <select asp-for="overtimeHistoryModel.overtimeRecordID" class ="form-control" asp-items="ViewBag.overtimeRecordID"></select>
            </div>
            <div class="form-group">
                <label asp-for="overtimeHistoryModel.modifiedDate" class="control-label"></label>
                <input asp-for="overtimeHistoryModel.modifiedDate" class="form-control" type="date" />
                <span asp-validation-for="overtimeHistoryModel.modifiedDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeHistoryModel.overtimeHistoryAction" class="control-label"></label>
                <select asp-for="overtimeHistoryModel.overtimeHistoryAction" class="form-control" asp-items="Html.GetEnumSelectList<Models.overtimeStatus>()"></select>
                <span asp-validation-for="overtimeHistoryModel.overtimeHistoryAction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
