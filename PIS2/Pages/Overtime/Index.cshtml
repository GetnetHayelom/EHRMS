@page
@model PIS2.Pages.Overtime.IndexModel

@{
    ViewData["Title"] = "Overtime Types";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Overtime Types</h1>

<p>
    <a asp-page="Create">Add New Overtime Type</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>
                Rate
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.overtimeModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeRate)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.overtimeID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.overtimeID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.overtimeID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
