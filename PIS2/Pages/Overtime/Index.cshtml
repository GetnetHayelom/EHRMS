@page
@using PIS2.Enums
@model PIS2.Pages.Overtime.IndexModel

@{
    ViewData["Title"] = "Overtime Types";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">Overtime Types</h2>
        <p>
            <a asp-page="Create" class="btn btn-primary">Add New Overtime Type</a>
        </p>
    </div>
    <div class="d-flex justify-content-end">
        <div class="me-2">@await Html.PartialAsync("filter")</div>

        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="Overtime_Types_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>



<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>
                Rate
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.overtimeModel) 
        {
            <tr onclick="location.href='@Url.Page("Edit", new{id = item.overtimeID})'" style="cursor:pointer">
                <td>
                    @Html.DisplayFor(modelItem => item.overtimeName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.overtimeDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.overtimeRate)
                    </td>
                <td>
                    @if (item.overtimeStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.overtimeStatus)</span>

                    }
                    else if (item.overtimeStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.overtimeStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.overtimeStatus)</span>
                    }
                </td>
            
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.overtimeID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.overtimeID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>   
        }
    </tbody>
</table>
<div class="d-flex justify-content-end">
   
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Overtime_Types_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
