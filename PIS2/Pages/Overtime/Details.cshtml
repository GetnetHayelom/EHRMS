@page
@model PIS2.Pages.Overtime.DetailsModel

@{
    ViewData["Title"] = "Overtime Type Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Overtime Types</h1>
<h4>Overtime Type Details</h4>
<div>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeName)
        </dd>
        <dt class="col-sm-2">
            Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeDescription)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeStatus)
        </dd>
        <dt class="col-sm-2">
            Rate: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeRate)
        </dd>
    </dl>
</div>
@if (TempData["ErrorMessage"] != null) { }
<div>
    <a asp-page="./Edit" asp-route-id="@Model.overtimeModel.overtimeID">Edit</a> |
    <a asp-page="./Index">View All Overtime Types</a>
</div>
