@page
@model PIS2.Pages.Overtime.DeleteModel

@{
    ViewData["Title"] = "Delete Overtime Type";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Overtime Types</h1>

<h3>Are you sure you want to delete this overtime type?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeName)
        </dd>
        <dt class="col-sm-2">
            Description
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeDescription)
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeStatus)
        </dd>
        <dt class="col-sm-2">
            Rate
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.overtimeModel.overtimeRate)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="overtimeModel.overtimeID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
