@page
@model PIS2.Pages.Company.DeleteModel

@{
    ViewData["Title"] = "Delete Company";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Companies</h1>

<h3>Are you sure you want to delete this company?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Company Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyName)
        </dd>
        <dt class="col-sm-2">
            Company Alias:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyAlias)
        </dd>
        <dt class="col-sm-2">
            Company Manager
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.employmentID)
        </dd>
        <dt class="col-sm-2">
            Address: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.addressModel.addressFormatted)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="companyModel.companyID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
