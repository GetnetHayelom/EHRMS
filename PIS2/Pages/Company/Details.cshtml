@page
@model PIS2.Pages.Company.DetailsModel

@{
    ViewData["Title"] = "Company Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Companies</h1>

<div>
    <h4>Company Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Company Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyName)
        </dd>
        <dt class="col-sm-2">
            Company Alias:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyAlias)
        </dd>
        <dt class="col-sm-2">
            Manager:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.employmentID)
        </dd>
        <dt class="col-sm-2">
            Address:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.addressModel.addressFormatted)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.companyModel.companyStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.companyModel.companyID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
