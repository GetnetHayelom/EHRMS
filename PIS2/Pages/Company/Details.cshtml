@page
@using PIS2.Enums
@model PIS2.Pages.Company.DetailsModel

@{
    ViewData["Title"] = "Company Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-end align-items-end m-2"></div>
<div>
    <h2 class="fw-bold mb-0">Companies</h2>
    <p class="text-muted mb-0">Company details #@Model.companyModel.companyID</p>
</div>

<div class="card shadow-sm m-1 p-0">
    <div class="d-flex justify-content-end align-items-end m-0">
        <form method="get" class="d-flex">
            <label class="form-label"> Filter by Status</label>
            <select asp-for="DepartmentStatus" class="form-control m-2" asp-items="@Html.GetEnumSelectList<mainStatus>()" onchange="this.form.submit()">
                <option value="" selected> All</option>
            </select>
        </form>
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("back")
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="JobCategories_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>
<div>
    <hr />
    <dl class="d-flex justify-content-between">
        <div class="d-flex ">
            <dt class="me-2">
                Company Name:
            </dt>
            <dd class=" ">
                <u>@Html.DisplayFor(model => model.companyModel.companyName)</u>
            </dd>
        </div>
        
        <div class="d-flex ">
            <dt class="me-2">
                Company Alias:
            </dt>
            <dd class=" ">
                <u>@Html.DisplayFor(model => model.companyModel.companyAlias)</u>
            </dd>
        </div>
        
        <div class="d-flex ">
            <dt class="me-2">
                Manager:
            </dt>
            <dd class=" ">
                <u>@Html.DisplayFor(model => model.companyModel.employmentModel.personModel.personFullName)</u>
            </dd>
        </div>
        
        
        <div class="d-flex ">
            <dt class="me-2">
                Address:
            </dt>
            <dd class=" ">
                <u>@Html.DisplayFor(model => model.companyModel.addressModel.addressFormatted)</u>
            </dd>
        </div>
   
        <div class="d-flex ">
            <dt class="me-2">
                Status:
            </dt>
            <dd class=" ">
                <u>@Html.DisplayFor(model => model.companyModel.companyStatus)</u>
            </dd>
        </div>
    
    </dl>
</div>
<div class="flex-grow-1">
    <table class="table table-boredered table-striped table-hover">
        <thead class="bg-dark text-white">
            <tr>
                <th>S/No</th>
                <th>Department Name</th>
                <th>Alias</th>
                <th>SubAccount</th>
                <th>Manager</th>
                <th>Employees</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;

                foreach(var item in Model.Departments)
                {
                    <tr onclick="location.href='@Url.Page("/Department/Details", new{id=item.departmentID})'" style="cursor:pointer;">
                        <td>@index</td>
                        <td>@item.departmentName</td>
                        <td>@item.departmentShort</td>
                        <td>@item.subAccountModel?.subAccountName</td>
                        <td>@item.employmentModel?.personModel?.personFullName</td>
                        <td>@item.JobPlacements.Where(jp => jp.jobPlacementStatus == mainStatus.Active).Count()</td>
                        <td>
                            @if (item.departmentStatus == mainStatus.Active)
                            {
                                <span class="badge bg-success">@Html.DisplayFor(modelItem => item.departmentStatus)</span>

                            }
                            else if (item.departmentStatus == mainStatus.Suspended)
                            {
                                <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.departmentStatus)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.departmentStatus)</span>
                            }
                            
                        </td>
                    </tr>
                    index++;
                }
               
            }
            
        </tbody>
        <tfoot class="bg-secondary fw-bold">
            <tr>
                
                <td colspan="5">Total</td>
                <td>@Model.Departments.SelectMany(d => d.JobPlacements).Where(jp => jp.jobPlacementStatus ==mainStatus.Active)?.Count()</td>
                <td>@Model.Departments.Where(d => d.departmentStatus == mainStatus.Active).Count()</td>
                
            </tr>
        </tfoot>

    </table>
</div>
<div class="d-flex justify-content-end">
    @if(Model.companyModel.companyStatus == mainStatus.Active)
    {
        <a class="btn btn-warning m-2" asp-page="/Department/Create" asp-route-id="@Model.companyModel.companyID">Add Department</a>
    }
    
    <a class="btn btn-primary m-2" asp-page="./Edit" asp-route-id="@Model.companyModel.companyID">@L.T("Edit")</a>
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>
<a asp-page="./Index">View All Companies</a>