@page
@using PIS2.Enums
@model PIS2.Pages.Company.CreateModel

@{
    ViewData["Title"] = "New Company";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="fw-bold mb-0">Companies</h2>

<p class="text-muted mb-0">Maintain new company</p>
<hr />
<div class="row">
    <div class="col-md-4">
        @await Html.PartialAsync("success")
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="companyModel.companyName" class="control-label">Company Name</label>
                <input asp-for="companyModel.companyName" class="form-control" />
                <span asp-validation-for="companyModel.companyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.companyAlias" class="control-label">Company Alias</label>
                <input asp-for="companyModel.companyAlias" class="form-control" />
                <span asp-validation-for="companyModel.companyAlias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.employmentID" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Person
                </label>
                <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" />
                <input type="hidden" asp-for="companyModel.employmentID" id="personIDHidden" />
                <datalist id="personList">
                    @foreach (var person in Model.Manager)
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="companyModel.employmentID" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="companyModel.addressID" class="control-label">Address</label>
                <select asp-for="companyModel.addressID" class ="form-control" asp-items="ViewBag.addressID"></select>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.companyStatus" class="control-label">Status</label>
                <select asp-for="companyModel.companyStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="companyModel.companyStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <button type="submit" class="btn btn-success m-2"><i class="bi bi-save-fill me-2"></i>@L.T("Save")</button>
                @await Html.PartialAsync("back")                
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Companies</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
