@page
@using PIS2.Enums
@model PIS2.Pages.Company.EditModel

@{
    ViewData["Title"] = "Edit Company";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-0">Companies</h2>
<p class="text-muted mb-0">@L.T("Update") Company Details #@Model.companyModel.companyID</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="companyModel.companyID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="companyModel.companyName" class="control-label">Company Name</label>
                <input asp-for="companyModel.companyName" class="form-control" />
                <span asp-validation-for="companyModel.companyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.companyAlias" class="control-label">Company Alias</label>
                <input asp-for="companyModel.companyAlias" class="form-control" />
                <span asp-validation-for="companyModel.companyAlias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.employmentID" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Manager
                </label>
                <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.companyModel?.employmentModel?.personModel?.personFullName"/>
                <input type="hidden" asp-for="companyModel.employmentID" id="personIDHidden" value="@Model.companyModel?.employmentID"/>
                <datalist id="personList">
                    @foreach (var person in Model.Manager)
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="companyModel.employmentID" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="companyModel.addressID" class="control-label">Address</label>
                <select asp-for="companyModel.addressID" class="form-control" asp-items="ViewBag.addressID"></select>
                <span asp-validation-for="companyModel.addressID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="companyModel.companyStatus" class="control-label">Status</label>
                <select asp-for="companyModel.companyStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="companyModel.companyStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                @await Html.PartialAsync("back")
                <button type="submit" class="btn btn-success m-2" ><i class="bi bi-save-fill me-2"></i>@L.T("Save")</button>                
            </div>
        </form>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex align-items-center">
                <i class="bi bi-clock-history me-2"></i> Audit Trail
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase">
                                <th>Date</th>
                                <th>User</th>
                                <th>Field</th>
                                <th>Old Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.History.Any())
                            {
                                @foreach (var log in Model.History)
                                {
                                    <tr>
                                        <td class="small">@log.ModifiedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                        <td class="small fw-bold">@log.ModifiedBy</td>
                                        <td><span class="badge bg-light text-dark">@Model.GetFriendlyColumnName(log.ColumnName)</span></td>
                                        <td class="text-muted italic small">
                                            <span class="text-danger text-decoration-line-through small">
                                                @Model.FormatAuditValue(log.ColumnName, log.OldValue)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No change history found for this record.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white small text-muted">
                Total changes tracked: @Model.History.Count
            </div>
        </div>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Companies</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
