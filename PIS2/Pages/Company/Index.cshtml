@page
@model PIS2.Pages.Company.IndexModel

@{
    ViewData["Title"] = "Companies";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Companies</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Company</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Company Name
            </th>
            <th>
                Company Alias
            </th>
            <th>
                Manager
            </th>
            <th>
                Address
            </th>
            <th>
                Status
            </th>
   
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.companyModel) {
        <tr onclick="location.href='@Url.Page("/Management/CompanyP", new {id =item.companyID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.companyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.companyAlias)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.addressModel.addressFormatted)
            </td>
            <td>
                    @if(item.companyStatus != Models.mainStatus.Active)
                    {
                        <p class="fw-bold text-danger">@Html.DisplayFor(modelItem => item.companyStatus)
                        </p>
                    }
                    else{
                         <p class="fw-bold text-success">
                        @Html.DisplayFor(modelItem => item.companyStatus)
                        </p>
                        }
                        
            </td>

        </tr>
}
    </tbody>
</table>
