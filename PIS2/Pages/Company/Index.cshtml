@page
@model PIS2.Pages.Company.IndexModel

@{
    ViewData["Title"] = "Companies";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple","")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold mb-0">Companies</h2>
       <p class="text-muted mb-0">Companies catalog</p>
    </div>
    <a asp-page="Create" class="btn btn-primary d-print-none"><i class="bi bi-plus-circle me-2"></i>Add New Company</a>
</div>
<div class="card shadow-sm m-1">
    <div class="d-flex justify-content-end d-print-none">

        <form method="get" class="d-flex">
            <label class="form-label"> Filter by Status</label>
            <select asp-for="CompanyStatus" class="form-control m-2" asp-items="@Html.GetEnumSelectList<Models.mainStatus>()" onchange="this.form.submit()">
                <option value="" selected> All</option>
            </select>
        </form>
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>

<table class="table table-striped table-hover print-full-width" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>S/N</th>
            <th>
                Company Name
            </th>
            <th>
                Company Alias
            </th>
            <th>
                Manager
            </th>
            <th>
                Address
            </th>
            <th>
                Status
            </th>
   <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int sn = 1;
        }
        @foreach (var item in Model.companyModel) {
        <tr onclick="location.href='@Url.Page("/Company/Details", new {id =item.companyID})'" style="cursor:pointer;">
            <td>@sn</td>
            
            <td>
                @Html.DisplayFor(modelItem => item.companyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.companyAlias)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.personModel.personFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.addressModel.addressFormatted)
            </td>
            <td>
                    @if (item.companyStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.companyStatus)</span>

                    }
                    else if (item.companyStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.companyStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.companyStatus)</span>
                    }
            </td>
                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.companyID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.companyID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>
            sn++;
    }
    
    </tbody>
</table>

<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
