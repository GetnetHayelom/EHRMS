@page
@model PIS2.Pages.WorkSite.DetailsModel

@{
    ViewData["Title"] = "Work Location Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Work Location</h1>

<div class="d-flex flex-wrap d-print-flex print-wrap">
    <div class="col-sm-6">
        <h4>Work Location Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                Work Location Name:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteName)
            </dd>
            <dt class="col-sm-4">
                Work Location Type:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteNature)
            </dd>
            <dt class="col-sm-4">
                Establish Date:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteEstablishDate)
            </dd>
            <dt class="col-sm-4">
                Status:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteStatus)
            </dd>
            <dt class="col-sm-4">
                Location
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.addressModel.addressRegion)
            </dd>
        </dl>
    </div>
    <div class="col-sm-6">
        <h4>Work Location History</h4>
        <hr/>
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-dark text-white print-dark">
                    <th>Date</th>
                    <th>Name</th>
                
                    <th>Location</th>
                
                    <th>Status</th>
                
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.workSiteModel.WorkSiteHistories)
                {
                    <tr>
            <td>@item.workSiteHistoryDate.ToString("MMM dd, yyyy")</td>
                    <td>@item.worksiteName</td>
                
                    <td>@item.addressID</td>
                
                    <td>@item.workSiteHistoryAction</td>
                    <td>@item.workSiteUser</td>
                    </tr>
                }
            
            </tbody>
        </table>
    </div>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.workSiteModel.workSiteID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
