@page
@model PIS2.Pages.WorkSite.DetailsModel

@{
    ViewData["Title"] = "Work Location Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Work Locations</h1>
<h6 class="fw-bold text-muted">Work Loactions Details(#@Model.workSiteModel.workSiteID)</h6>

<div class="d-flex flex-wrap d-print-flex print-wrap gap-4">
    <div class="card shadow-sm p-2 flex-fill">
        <dl class="row">
            <dt class="col-sm-4">
                Work Location Name:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteName)
            </dd>
            <dt class="col-sm-4">
                Work Location Type:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteNature)
            </dd>
            <dt class="col-sm-4">
                Establish Date:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteEstablishDate)
            </dd>
            <dt class="col-sm-4">
                Status:
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.workSiteStatus)
            </dd>
            <dt class="col-sm-4">
                Location
            </dt>
            <dd class="col-sm-6">
                <a href="@Model.workSiteModel.mapLink">@Html.DisplayFor(model => model.workSiteModel.addressModel.addressFormatted)</a>               
            </dd>
            <dt class="col-sm-4">
                Site Manager/Coordinator
            </dt>
            <dd class="col-sm-6">
                @Html.DisplayFor(model => model.workSiteModel.employmentModel.personModel.personFullName)
            </dd>
        </dl>
    </div>
    <div class=" card shadow-sm p-2 flex-fill">
        <h6 class="fw-bold">Work Location History</h6>
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-dark text-white print-dark">
                    <th>Date</th>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Map Link</th>
                    <th>Manager/Coordinator</th>
                    <th>Status</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.workSiteModel.WorkSiteHistories)
                {
                    <tr>
                        <td>@item.modifiedDate.ToString("MM/dd/yyyy")</td>
                        <td>@item.worksiteName</td>
                        <td>@item.addressModel?.addressFormatted</td>
                        <td>@item.mapLink</td>
                        <td>@item.employmentModel?.personModel?.personFullName</td>
                        <td>@item.workSiteHistoryAction</td>
                        <td>@item.modifiedBy</td>
                    </tr>
                }
            
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end gap-2 m-2">
    @if (User.IsInRole("MIE\\PMS_HRADMIN"))
    {
        <a class="btn btn-primary m-2" asp-page="./Edit" asp-route-id="@Model.workSiteModel.workSiteID">Edit</a>
    }
    @await Html.PartialAsync("print")
    <a class="btn btn-secondary text-white m-2" asp-page="./Index">Back To List </a>
</div>
