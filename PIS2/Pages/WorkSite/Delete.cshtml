@page
@model PIS2.Pages.WorkSite.DeleteModel

@{
    ViewData["Title"] = "Delete Work Location";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Work Locations</h1>

<h3>Are you sure you want to delete this work location?</h3>
<div class="d-flex flex-wrap d-print-flex print-wrap">
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Work Location Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.workSiteModel.workSiteName)
        </dd>
        <dt class="col-sm-2">
            Work Location Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.workSiteModel.workSiteNature)
        </dd>
        <dt class="col-sm-2">
            Establish Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.workSiteModel.workSiteEstablishDate)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.workSiteModel.workSiteStatus)
        </dd>
        <dt class="col-sm-2">
            Location
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.workSiteModel.addressModel.addressRegion)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="workSiteModel.workSiteID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
