@page
@using PIS2.Enums
@model PIS2.Pages.WorkSite.EditModel

@{
    ViewData["Title"] = "Edit Work Location";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Work Locations</h1>
<h6 class="fw-bold text-muted">@L.T("Update") Work Location Details</h6>

<hr />
<div class="d-flex gap-4">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="workSiteModel.workSiteID" />
            <div class="form-group">
                <label asp-for="workSiteModel.workSiteName" class="control-label">Site Name</label>
                <input asp-for="workSiteModel.workSiteName" class="form-control" />
                <span asp-validation-for="workSiteModel.workSiteName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.workSiteCode" class="control-label">Site Alias</label>
                <input asp-for="workSiteModel.workSiteCode" class="form-control" />
                <span asp-validation-for="workSiteModel.workSiteCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.workSiteNature" class="control-label">Site Type</label>
                <input asp-for="workSiteModel.workSiteNature" class="form-control" />
                <span asp-validation-for="workSiteModel.workSiteNature" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="form-label fw-semibold">
                    <span class="text-danger">*</span> Site Manager/Representative
                </label>
                <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.workSiteModel.employmentModel?.personModel?.personFullName" />
                <input type="hidden" asp-for="workSiteModel.employmentID" id="personIDHidden" />
                <datalist id="personList">
                    @foreach (var person in Model.Manager)
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="workSiteModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.workSiteEstablishDate" class="control-label">Date</label>
                <input asp-for="workSiteModel.workSiteEstablishDate" class="form-control" type="date"/>
                <span asp-validation-for="workSiteModel.workSiteEstablishDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.mapLink" class="control-label">Map Link</label>
                <input asp-for="workSiteModel.mapLink" class="form-control" type="text" value="N/A" />
                <span asp-validation-for="workSiteModel.mapLink" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.subAccountID" class="control-label">Sub Account</label>
                <input asp-for="workSiteModel.subAccountID" class="form-control" type="text" />
                <span asp-validation-for="workSiteModel.subAccountID" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="workSiteModel.workSiteStatus" class="control-label">Status</label>
                <select asp-for="workSiteModel.workSiteStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="workSiteModel.workSiteStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="workSiteModel.addressID" class="control-label">Address</label>
                <select asp-for="workSiteModel.addressID" class="form-control" asp-items="ViewBag.addressID"></select>
                <span asp-validation-for="workSiteModel.addressID" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                @await Html.PartialAsync("back")
                <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    <div class="card shadow-sm p-2 flex-fill">
        <table class="table table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>
                        Site Name
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Map Coordination
                    </th>
                    <th>
                        Site Manager
                    </th>
                    <th>
                        Modified By
                    </th>
                    <th>
                        Modified Date
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model?.workSiteModel?.WorkSiteHistories)
                {
                    <tr>
                        <td>
                            @item.workSiteModel?.workSiteName
                        </td>
                        <td>
                            @item.workSiteHistoryAction
                        </td>
                        <td>@item.mapLink</td>
                        <td>@(item.employmentModel?.personModel?.personFullName ?? "")</td>
                        <td>
                            @item.modifiedBy
                        </td>
                        <td>
                            @(item.modifiedDate)
                        </td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Work Sites</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
