
@page
@model PIS2.Pages.WorkSite.IndexModel

@{
    ViewData["Title"] = "Work Locations";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div id="printDiv" class="col-12">
    <h1 class="fw-bold">Work Locations</h1>
    
    <p>
        <a class="btn btn-primary d-print-none" asp-page="Create" >Add New Work Location</a>
    </p>
    @await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Work Location Name
            </th>
            <th>
                Work Location Type
            </th>
            <th>
                Establish Date
            </th>
            <th>
                Status
            </th>
            <th>
                Location
            </th>
                <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.workSiteModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.workSiteName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.workSiteNature)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.workSiteEstablishDate)
            </td>
            <td>
                        @if(item.workSiteStatus == Models.mainStatus.Active)
                        {
                            <p class="fw-bold text-success">@Html.DisplayFor(modelItem => item.workSiteStatus)</p>
                        }
                        else{
                            <p class="fw-bold text-danger">@Html.DisplayFor(modelItem => item.workSiteStatus)</p>
                        }
                        
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.addressModel.addressFormatted)
            </td>
            <td class="d-print-none">
                <a asp-page="./Edit" asp-route-id="@item.workSiteID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.workSiteID">Details</a> 
            </td>
        </tr>
}
    </tbody>
</table>
</div>
<div class="d-flex justify-content-end">@await Html.PartialAsync("print")</div>
