@page
@model PIS2.Pages.BankInfo.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between">
    <div>
        <h1 class="fw-bold">Bank Accounts Info</h1>

        <p>
            <a asp-page="Create" class="btn btn-primary">Add Employee Bank Information</a>

        </p>
    </div>


    <div class="col-4">
        <div class="d-flex align-items-end">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>
    </div>
   
</div>
<hr />
<div class="m-2 flex-md-grow-1 justify-content-between">
    <form method="get" class="d-flex align-items-end">
            <div class="form-group m-2 d-flex">
                
                <select asp-for="Bank" class="form-control select2">
                    <option value="">Select Bank</option>
                    @foreach (var item in Model.bankInfoModel.GroupBy(b => b.bankName.ToLower()).Select(g => g.Key).ToList())
                    {
                        <option value="@item">@item.ToUpper()</option>
                    }
                </select>
                
            </div>
        <div class="form-group m-2">
            <input asp-for="EmployeeOnly" type="checkbox" id="EmployeeOnly" class="cool-check-input" />
            <label for="EmployeeOnly" class="cool-check" role="checkbox" aria-checked="false">
               
                <span class="label-text">@Html.DisplayNameFor(m => m.EmployeeOnly)</span>
            </label>
            <span asp-validation-for="EmployeeOnly" class="text-danger"></span>
        </div>
            <div><button type="submit" value="Filter" class="btn btn-primary m-2">Filter</button></div>
        </form>
    </div>
<hr />

<table class="table table-bordered table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>S/No</th>
            <th>
                Name
            </th>
            <th>
                Employee ID
            </th>
            <th>
                Bank Name
            </th>
            <th>
                Account Number
            </th>
            <th>
                Branch
            </th>
            <th>
               Status
            </th>   
        </tr>
    </thead>
    <tbody>
        @{
            int index = 1;
            foreach (var item in Model.bankInfoModel) {
            <tr>
                <td>@index</td>
                <td>
                    @item.personModel?.personFullName
                </td>
                <td>@(item.personModel?.Employments?.FirstOrDefault(e => e.employmentStatus == Models.mainStatus.Active)?.givenID ?? "Not Employed")</td>
                <td>
                    @Html.DisplayFor(modelItem => item.bankName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.bankAccountNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.bankBranch)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.bankInfoStatus)
                </td>
                <td>
                
                </td>
            </tr>
            index++;
        }
    }

    </tbody>
</table>
