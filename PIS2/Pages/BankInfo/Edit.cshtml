@page
@using PIS2.Enums
@model PIS2.Pages.BankInfo.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>bankInfoModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="bankInfoModel.bankInfoID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="bankInfoModel.personID" class="control-label"></label>
                <select asp-for="bankInfoModel.personID" class="form-control" asp-items="ViewBag.personID"></select>
                <span asp-validation-for="bankInfoModel.personID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="bankInfoModel.bankName" class="control-label"></label>
                <input asp-for="bankInfoModel.bankName" class="form-control" />
                <span asp-validation-for="bankInfoModel.bankName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="bankInfoModel.bankAccountNumber" class="control-label"></label>
                <input asp-for="bankInfoModel.bankAccountNumber" class="form-control" />
                <span asp-validation-for="bankInfoModel.bankAccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="bankInfoModel.bankBranch" class="control-label"></label>
                <input asp-for="bankInfoModel.bankBranch" class="form-control" />
                <span asp-validation-for="bankInfoModel.bankBranch" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="bankInfoModel.bankInfoStatus" class="control-label"></label>
                <select asp-for="bankInfoModel.bankInfoStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="bankInfoModel.bankInfoStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
