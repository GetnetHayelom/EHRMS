@page
@model PIS2.Pages.LetterType.EditModel
@{
}
<h2 class="fw-bold">Letter Types</h2>
<h6 class="text-muted">Maintain Letter Type #@Model.LetterType.letterTypeID</h6>
<div class="container mt-2">
<div class="d-flex gap-4"></div>  
    <form method="post" class="flex-fill card shadow-sm p-2">
        <input asp-for="LetterType.letterTypeID" class="form-control" hidden value="@Model.LetterType.letterTypeID">
        <div class="mb-3">
            <label>Name</label>
            <input asp-for="LetterType.letterTypeName" class="form-control" required>
        </div>
        <div class="mb-3">
            <label>Prefix</label>
            <input asp-for="LetterType.letterTypePrefix" class="form-control" required>
        </div>
        <div class="mb-3">
            <label>Code</label>
            <input asp-for="LetterType.letterTypeCode" class="form-control" required>
        </div>

        <div class="mb-3">
            <label>Description</label>
            <textarea asp-for="LetterType.letterTypeDescription" class="form-control"></textarea>
        </div>
        <div class="d-flex justify-content-end m-2 gap-2">
            <button class="btn btn-success">Save</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
        
    </form>

</div>