@page
@using PIS2.Enums
@model PIS2.Pages.Loyalty.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Loyalty Setup</h1>

<h4 class="fw-bold">Create New Loyalty</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="loyaltyModel.loyaltyName" class="control-label">Loyalty Name</label>
                <input asp-for="loyaltyModel.loyaltyName" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyAmount" class="control-label">Amount</label>
                <input asp-for="loyaltyModel.loyaltyAmount" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyCounter" class="control-label">Years</label>
                <input asp-for="loyaltyModel.loyaltyCounter" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyCounter" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyStatus" class="control-label">Status</label>
                <select asp-for="loyaltyModel.loyaltyStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="loyaltyModel.loyaltyStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Save" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Loyalty Types</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
