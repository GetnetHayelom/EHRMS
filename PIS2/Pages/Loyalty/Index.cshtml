@page
@model PIS2.Pages.Loyalty.IndexModel

@{
    ViewData["Title"] = "Loyalty";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Loyalty</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Loyalty</a>
</p>
<table class="table table-hover table-striped" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Loyalty Name
            </th>
            <th>
                Loyalty Amount
            </th>
            <th>
                Loyalty Counter
            </th>
            <th>
                Loyalty Status
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.loyaltyModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyCounter)
            </td>
            <td>
                    @if (item.loyaltyStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.loyaltyStatus)</span>

                    }
                    else if (item.loyaltyStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.loyaltyStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.loyaltyStatus)</span>
                    }
            </td>
            <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.loyaltyID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.loyaltyID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
