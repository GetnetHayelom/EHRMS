@page
@model PIS2.Pages.Loyalty.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>loyaltyModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="loyaltyModel.loyaltyID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="loyaltyModel.loyaltyName" class="control-label"></label>
                <input asp-for="loyaltyModel.loyaltyName" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyAmount" class="control-label"></label>
                <input asp-for="loyaltyModel.loyaltyAmount" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyCounter" class="control-label"></label>
                <input asp-for="loyaltyModel.loyaltyCounter" class="form-control" />
                <span asp-validation-for="loyaltyModel.loyaltyCounter" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="loyaltyModel.loyaltyStatus" class="control-label"></label>
                <select asp-for="loyaltyModel.loyaltyStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="loyaltyModel.loyaltyStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
