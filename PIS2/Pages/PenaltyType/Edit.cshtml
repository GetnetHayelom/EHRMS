@page
@using PIS2.Enums
@model PIS2.Pages.PenaltyType.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Penalty Types</h1>

<h4 class="fw-bold">Update Penalty Type</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="penaltyTypeModel.penaltyTypeID" />
            <div class="form-group">
                <label asp-for="penaltyTypeModel.penaltyName" class="control-label">Penalty Name</label>
                <input asp-for="penaltyTypeModel.penaltyName" class="form-control" />
                <span asp-validation-for="penaltyTypeModel.penaltyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyTypeModel.penaltyTypeStatus" class="control-label">Status</label>
                <select asp-for="penaltyTypeModel.penaltyTypeStatus" class="form-control" asp-items="@Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="penaltyTypeModel.penaltyTypeStatus" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check form-switch">
                <!-- IsPercentage toggle -->
                <input asp-for="penaltyTypeModel.IsPercentage" class="form-check-input" type="checkbox" id="IsPercentageToggle" />
                <label class="form-check-label" for="IsPercentageToggle">
                    Use percentage
                </label>
                <span class="form-text">If checked the value will be treated as a percentage of the chosen base.</span>
                <span asp-validation-for="penaltyTypeModel.IsPercentage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyTypeModel.penaltyValidity" class="control-label">Validity In Months</label>
                <input asp-for="penaltyTypeModel.penaltyValidity" class="form-control" type="number"/>
                <span asp-validation-for="penaltyTypeModel.penaltyValidity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyTypeModel.penaltyAmount" class="control-label">Rate</label>
                <input asp-for="penaltyTypeModel.penaltyAmount" class="form-control" type="number" />
                <span asp-validation-for="penaltyTypeModel.penaltyAmount" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Penalty Types</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
