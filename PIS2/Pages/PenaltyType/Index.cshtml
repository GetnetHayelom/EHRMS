@page
@model PIS2.Pages.PenaltyType.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Penalty Types</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Penalty Type</a>
</p>
<hr />
<div class="d-flex">
    @await Html.PartialAsync("filter")
    @await Html.PartialAsync("print")
</div>

<table class="table table-bordered table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Penalty Name
            </th>
            <th>
                Status
            </th>
            <th>
                Method
            </th>
            <th>
                Rate
            </th>
            <th>
                Validty
            </th>
            <th>
                Modified Date
            </th>
            <th>
                Modified By
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.penaltyTypeModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyTypeStatus)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyMethod)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.penaltyRate)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyValidity)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.penaltyTypeID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.penaltyTypeID">Details</a> 
                
            </td>
        </tr>
}
    </tbody>
</table>


