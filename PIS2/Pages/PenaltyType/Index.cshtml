@page
@model PIS2.Pages.PenaltyType.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.penaltyTypeModel[0].penaltyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyTypeModel[0].penaltyTypeStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyTypeModel[0].modifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyTypeModel[0].modifiedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.penaltyTypeModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyTypeStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.penaltyTypeID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.penaltyTypeID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.penaltyTypeID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
