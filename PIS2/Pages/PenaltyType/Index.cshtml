@page
@using PIS2.Enums
@model PIS2.Pages.PenaltyType.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Penalty Types</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Penalty Type</a>
</p>
<hr />
<div class="d-flex">
    @await Html.PartialAsync("filter")
    @await Html.PartialAsync("print")
</div>

<table class="table table-bordered table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Penalty Name
            </th>
         
            <th>
                Method
            </th>
            <th>
                Rate
            </th>
            <th>
                Validty
            </th>
            <th>
                Status
            </th>
            <th>
                Modified Date
            </th>
            <th>
                Modified By
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.penaltyTypeModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyName)
            </td>
            
                <td>
                    @Html.DisplayFor(modelItem => item.IsPercentage)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.penaltyAmount)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyValidity)
                </td>
                <td>
                    @if (item.penaltyTypeStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.penaltyTypeStatus)</span>

                    }
                    else if (item.penaltyTypeStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.penaltyTypeStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.penaltyTypeStatus)</span>
                    }
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.penaltyTypeID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.penaltyTypeID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                
            </td>
        </tr>
}
    </tbody>
</table>


