@page
@model PIS2.Pages.EducationLevel.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Academic Level Details</h1>

<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelName)
        </dd>
        <dt class="col-sm-2">
            Grade: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelGrade)
        </dd>
        <dt class="col-sm-2">
            Category: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelCategory)
        </dd>
        <dt class="col-sm-2">
            Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelDescription)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.educationLevelModel.educationLevelID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
