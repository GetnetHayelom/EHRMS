@page
@model PIS2.Pages.EducationLevel.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Education/Academic Levels</h1>

<p>
    <a asp-page="Create">Add New Academic Level</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Name
            </th>
            <th>
                Grade
            </th>
            <th>
                Category
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.educationLevelModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.educationLevelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.educationLevelGrade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.educationLevelCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.educationLevelDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.educationLevelStatus)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.educationLevelID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.educationLevelID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.educationLevelID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
