@page
@using PIS2.Enums
@model PIS2.Pages.EducationLevel.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="fw-bold">Education/Academic Levels</h2>
<h6 class="text-muted">Manage Education and Certification Levels</h6>

<div class="card shadow-sm p-2 mb-4">
    <div class="d-flex justify-content-between">
        <div class="d-flex d-print-none m-2">
            <a asp-page="Create" class="btn btn-primary">Add New Academic Level</a>
        </div>
        <div class="d-flex justify-content-end d-print-none">
            <div class="me-2">@await Html.PartialAsync("filter")</div>
            @await Html.PartialAsync("print")
            <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
        </div>
    </div>
</div>



<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Name
            </th>
            <th>
                Grade
            </th>
            <th>
                Category
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var levels in Model.educationLevelModel.GroupBy(e => e.educationLevelCategory)) 
        {
            <tr class="table-primary">
                <th>@levels.FirstOrDefault().educationLevelCategory</th>
                <th colspan="5"></th>
            </tr>
            @foreach (var item in levels) 
            {
                <tr>
                    <td>
                        
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.educationLevelName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.educationLevelGrade)
                    </td>
                
                    <td>
                        @Html.DisplayFor(modelItem => item.educationLevelDescription)
                    </td>
                    <td>
                
                            @if (item.educationLevelStatus == mainStatus.Active)
                            {
                                <span class="badge bg-success">@Html.DisplayFor(modelItem => item.educationLevelStatus)</span>

                            }
                            else if (item.educationLevelStatus == mainStatus.Suspended)
                            {
                                <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.educationLevelStatus)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.educationLevelStatus)</span>
                            }
                    </td>   
                    <td class="d-print-none">
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.educationLevelID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.educationLevelID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            } 
        }
        
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
  
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
</div>