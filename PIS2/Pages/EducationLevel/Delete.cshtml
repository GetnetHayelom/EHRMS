@page
@model PIS2.Pages.EducationLevel.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Delete Academic Level</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
   
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelName)
        </dd>
        <dt class="col-sm-2">
            Grade: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelGrade)
        </dd>
        <dt class="col-sm-2">
            Category: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelCategory)
        </dd>
        <dt class="col-sm-2">
            Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelDescription)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.educationLevelModel.educationLevelStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="educationLevelModel.educationLevelID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
