@page
@model PIS2.Pages.PersonEducationLevel.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Education and Certification</h2>

<p class="text-muted">Maintain New Certification</p>
<hr />
<div class="d-flex justify-content-between">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="personEducationLevelModel.personID" class="control-label">Person Name</label>
                <select asp-for="personEducationLevelModel.personID" class ="form-control" asp-items="ViewBag.personID"></select>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelID" class="control-label">Certification Name</label>
                <select asp-for="personEducationLevelModel.educationLevelID" class ="form-control" asp-items="ViewBag.educationLevelID"></select>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationField" class="control-label">Field of Study</label>
                <input asp-for="personEducationLevelModel.educationField" class="form-control" type="text" />
                <span asp-validation-for="personEducationLevelModel.educationField" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelDate" class="control-label">Date Issued</label>
                <input asp-for="personEducationLevelModel.educationLevelDate" class="form-control" type="date"/>
                <span asp-validation-for="personEducationLevelModel.educationLevelDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelMark" class="control-label">Grade/Commulative</label>
                <input asp-for="personEducationLevelModel.educationLevelMark" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelMark" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelInstitutionName" class="control-label">Institution Name</label>
                <input asp-for="personEducationLevelModel.educationLevelInstitutionName" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelInstitutionName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelNumber" class="control-label">Certificate Number</label>
                <input asp-for="personEducationLevelModel.educationLevelNumber" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationDiscipline" class="control-label">Discipline</label>
                <input asp-for="personEducationLevelModel.educationDiscipline" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationDiscipline" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    @if (Model.CertificationList.Any())
    {
        <div class="flex-grow">
        <h4 class="fw-bold">Certifications</h4>
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-info text-white">
                <tr>
                    <th>Level</th>
                    <th>Category</th>
                    <th>Field</th>
                    <th>Mark</th>
                    <th>Issued Date</th>
                    <th>Institution</th>
                    <th>Certification Number</th>
                    <th>Modified By</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.CertificationList)
                {
                    <tr>
                        <td>@item?.educationLevelModel?.educationLevelName</td>
                        <td>@item?.educationLevelModel?.educationLevelCategory</td>
                        <td>@item?.educationField</td>
                        <td>@item?.educationLevelMark</td>
                        <td>@item?.educationLevelDate</td>
                        <td>@item?.educationLevelInstitutionName</td>
                        <td>@item?.educationLevelNumber</td>
                        <td>@item?.modifiedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
    
</div>

<div>
    <a asp-page="Index">View All Certifications</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
