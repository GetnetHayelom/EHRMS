@page
@model PIS2.Pages.PersonEducationLevel.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Education and Certification</h1>

<h3 class="fw-bold">Are you sure you want to delete this certification record?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Person Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            Certification Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelModel.educationLevelName)
        </dd>
        <dt class="col-sm-2">
            Date Issued
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelDate)
        </dd>
        <dt class="col-sm-2">
            Grade/Commulative
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelMark)
        </dd>
        <dt class="col-sm-2">
            Institution Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelInstitutionName)
        </dd>
        <dt class="col-sm-2">
            Certificate Number
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelNumber)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="personEducationLevelModel.personEducationLevelID" />
        <input type="submit" value="Delete" class="btn btn-danger" />   
    </form>
    <a asp-page="./Index">View All Certifications</a>
</div>
