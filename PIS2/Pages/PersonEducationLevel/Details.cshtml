@page
@model PIS2.Pages.PersonEducationLevel.DetailsModel

@{
    ViewData["Title"] = "Certification Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Certification Profile</h1>
            <p class="text-muted small mb-0">Detailed view of educational credentials and verified documents.</p>
        </div>
        <div class="btn-group shadow-sm">
            <a asp-page="./Edit" asp-route-id="@Model.personEducationLevelModel.personEducationLevelID" class="btn btn-primary">
                Edit Record
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-primary">Academic Information</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3 pb-2 border-bottom">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Full Name</div>
                        <div class="col-sm-7 fw-semibold">@Html.DisplayFor(model => model.personEducationLevelModel.personModel.personID)</div>
                    </div>

                    <div class="row mb-3 pb-2 border-bottom">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Education Level</div>
                        <div class="col-sm-7">
                            <span class="badge bg-info text-dark">
                                @Html.DisplayFor(model => model.personEducationLevelModel.educationLevelModel.educationLevelName)
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3 pb-2 border-bottom">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Institution</div>
                        <div class="col-sm-7 fw-semibold text-primary">@Html.DisplayFor(model => model.personEducationLevelModel.educationLevelInstitutionName)</div>
                    </div>

                    <div class="row mb-3 pb-2 border-bottom">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Date Issued</div>
                        <div class="col-sm-7">@Model.personEducationLevelModel.educationLevelDate.ToString("MMMM dd, yyyy")</div>
                    </div>

                    <div class="row mb-3 pb-2 border-bottom">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Score / Mark</div>
                        <div class="col-sm-7 fw-bold">@Html.DisplayFor(model => model.personEducationLevelModel.educationLevelMark)</div>
                    </div>

                    <div class="row mb-0">
                        <div class="col-sm-5 text-muted small fw-bold text-uppercase">Certificate #</div>
                        <div class="col-sm-7 font-monospace">@Html.DisplayFor(model => model.personEducationLevelModel.educationLevelNumber)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary">Verified Attachments</h6>
                    <span class="badge rounded-pill bg-light text-dark border">@Model.attachments.Count() Files</span>
                </div>
                <div class="card-body bg-light-subtle">
                    @if (Model.attachments.Any())
                    {
                        <div class="row g-3">
                            @foreach (var file in Model.attachments)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                                        <div class="ratio ratio-4x3 bg-dark d-flex align-items-center justify-content-center">
                                            @if (file.FileName.ToLower().EndsWith(".jpg") || file.FileName.ToLower().EndsWith(".png") || file.FileName.ToLower().EndsWith(".jpeg"))
                                            {
                                                <img src="@file.FilePath" class="card-img-top object-fit-cover" alt="@file.FileName">
                                            }
                                            else
                                            {
                                                <div class="text-white d-flex flex-column align-items-center justify-content-center">
                                                    <div class="h1 mb-0"><i class="bi bi-file-earmark-pdf"></i></div>
                                                    <small class="text-uppercase text-white-50">Document</small>
                                                </div>
                                            }
                                        </div>
                                        <div class="card-body p-2 border-top bg-white">
                                            <p class="card-text small text-truncate mb-2 fw-semibold" title="@file.FileName">
                                                @file.FileName
                                            </p>
                                            <div class="d-grid">
                                                <a href="@file.FilePath" target="_blank" class="btn btn-outline-primary btn-sm py-1">
                                                    View Full File
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cloud-slash text-muted display-1"></i>
                            <p class="mt-3 text-muted">No digital attachments are associated with this record.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>