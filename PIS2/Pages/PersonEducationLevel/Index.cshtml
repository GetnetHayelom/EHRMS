@page
@model PIS2.Pages.PersonEducationLevel.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between">
    <h1 class="fw-bold">Education and Certification</h1>
    <div class="d-flex d-print-none">
        @if (User.IsInRole("MIE\\PMS_HRCLERK"))
        {
            <a asp-page="Create" class="btn btn-primary d-print-none m-2">Add New Certification</a>   
        }
        <ul class="nav nav-tabs">

            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#summaryView">Certification Summary</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#companyView">Certification Lookup</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#talentPool">Talent Pool</button>
            </li>
            <li>@await Html.PartialAsync("print")</li>
        </ul>
        
    </div>
</div>

<hr />
<div class="tab-content">
    <!--Certification Summary-->
    <div class="tab-pane fade show active" id="summaryView">
        <h4 class="fw-bold">Active Employees Certification Summary</h4>
        <div class="d-flex gap-3 print-full-width">
            <div class="col-md-6">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Certification Category</th>
                            <th>Male</th>
                            <th>Female</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CertificationSummary)
                        {
                            <tr>
                                <td>@item.CertificationCategory</td>
                                <td>@item.Male</td>
                                <td>@item.Female</td>
                                <td>@item.Total</td>
                            </tr>
                        }
                        <tr>
                            <td class="fw-bold">Total</td>
                            <td class="fw-bold">@Model.CertificationSummary.Sum(cs => cs.Male)</td>
                            <td class="fw-bold">@Model.CertificationSummary.Sum(cs => cs.Female)</td>
                            <td class="fw-bold">@Model.CertificationSummary.Sum(cs => cs.Total)</td>
                        </tr>
                    </tbody>
                </table>
            </div>


            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header">Summary Graph</div>
                    <div class="card-body"><canvas id="certChart" height="120"></canvas></div>
                    
                </div>
                
                <div class="d-flex justify-content-end">
                    @await Html.PartialAsync("print")
                </div>
            </div>
        </div>
       
        
    </div>

    <!--Talent View Based on Certification-->
    <div class="tab-pane fade" id="companyView">
        <h4 class="fw-bold">Certification By Company</h4>
        <!-- SUMMARY POINTS -->
        <div class="card shadow-sm mb-4 p-2">
            <div class="d-flex gap-3 d-print-flex flex-wrap">

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-info border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total</small>
                                <h3 class="fw-bold mb-0"><u id="TotalRecords1">@Model.TotalRecords</u></h3>
                            </div>
                            <div><i class="bi bi-list-check fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Male</small>
                                <h3 class="fw-bold mb-0"><u id="Male1">@Model.Male</u></h3>
                            </div>
                            <div><i class="bi bi-gender-male fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-danger border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Female</small>
                                <h3 class="fw-bold mb-0"><u id="Female1">@Model.Female</u></h3>
                            </div>
                            <div><i class="bi bi-gender-female fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-success border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Active Employees</small>
                                <h3 class="fw-bold mb-0"><u id="Active1">@Model.ActiveEmp</u></h3>
                            </div>
                            <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>

            </div>
        </div> 

        <!--FILTER CONTROLS-->
        <div class="card p-2 m-2">
            <div class="d-flex m-2 justify-content-between flex-wrap">
                <div class="flex-fill m-2 d-print-flex">
                    <label for="filter-company">Company:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-company">
                        <option value="">All</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.companyID">@company.companyName</option>
                        }
                    </select>
                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="filter-department">Department:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-department">
                        <option value="">All</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.departmentID">@department.departmentName</option>
                        }
                    </select>
                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="filter-category">Category:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-category" asp-items="@Html.GetEnumSelectList<Models.educationCategory>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="filter-discipline">Discipline:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-discipline">
                        <option value="">All</option>
                        @foreach (var edu in Model.EducationDescipline)
                        {
                            <option value="@edu">@edu</option>
                        }
                    </select>
                </div>
                <div class="flex-fill d-print-flex m-2">
                    <label for="filter-field">Field of Study:</label>
                    <input list="CertificationFieldOptions" class="form-control" id="filter-field" placeholder="Type or select Field of Study" />
                    <datalist id="CertificationFieldOptions">
                        <option value="">All</option>
                        @foreach (var field in Model.EducationFields)
                        {
                            <option value="@field">@field</option>
                        }
                    </datalist>

                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="filter-status">Employment Status:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-status1" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="dateStart">Date From:</label>
                    <input class="form-control" type="date" id="dateStart" asp-for="SDate" />
                </div>
                <div class="flex-fill m-2 d-print-flex">
                    <label for="dateEnd">Date of End Upto:</label>
                    <input class="form-control" type="date" asp-for="EDate" id="dateEnd" />
                </div>
                <div class="flex-fill m-2 d-flex align-items-end d-print-none justify-content-end">
                    <button class="btn btn-primary d-print-none m-2" onclick="filterCertification()">Load</button>
                    @await Html.PartialAsync("print")
                </div>
            </div>
        </div>
       

        <!--LIST TABLE-->
        <table class="table table-striped table-hover" id="dataTable1">
            <thead class="bg-dark text-white">
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Full Name
                    </th>
                    <th>
                        Certification Title
                    </th>
                    <th>
                        Issue Date
                    </th>
                    <th>
                        Grade/Commulative
                    </th>
                    <th>Employees</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="table-body1">
                @foreach (var comp in Model.personEducationLevelModel.OrderBy(c => c.CompanyName).GroupBy(c => c.CompanyID))
                {
                    <tr class="table-primary fw-bold">
                        <td colspan="8">@comp.FirstOrDefault().CompanyName</td>
                        <td>@comp.Select(c => c.PersonID).Distinct().Count()</td>
                        <td>@comp.Count()</td>
                    </tr>
                    @foreach(var dept in comp.GroupBy(c => c.DepartmentID).ToList())
                    {
                        <tr class="table-secondary fw-bold">
                            <td></td>
                            <td colspan="7">@dept.FirstOrDefault().DepartmentName</td>
                            <td>@dept.Select(c => c.PersonID).Distinct().Count()</td>
                            <td>@dept.Count()</td>
                        </tr>
                        @foreach (var el in dept.GroupBy(c => c.EducationLevelCategory).ToList())
                        {
                            <tr class="table-secondary fw-bold">
                                <td colspan="2"></td>
                                <td colspan="6">@el.FirstOrDefault().EducationLevelCategory</td>
                                <td>@el.Select(c => c.PersonID).Distinct().Count()</td>
                                <td>@el.Count()</td>
                            </tr>
                            @foreach (var gender in el.GroupBy(c => c.PersonGender).ToList())
                            {
                                <tr class="fw-bold">
                                    <td colspan="3"></td>
                                    <td colspan="5">@gender.FirstOrDefault().PersonGender</td>
                                    <td>@gender.Select(c => c.PersonID).Distinct().Count()</td>
                                    <td>@gender.Count()</td>
                                </tr>

                                @foreach (var d in gender.OrderBy(e => e.GivenID))
                                {
                                    <tr class="">
                                        <td colspan="3"></td>
                                        <td>@d.GivenID</td>
                                        <td>@d.FullName</td>
                                        <td>@d.EducationField</td>
                                        <td>@d.EducationLevelDate.Value.ToString("MM/dd/yyyy")</td>
                                        <td>@d.EducationLevelMark</td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                            
                        }
                    }
                }
            </tbody>
        </table>
    </div>


    <!--Talent pool based on experience-->
    <div class="tab-pane fade" id="talentPool">
        <h4 class="fw-bold">Talent Pool</h4>
        <!-- SUMMARY POINTS -->
        <div class="card shadow-sm mb-4 p-2">
            <div class="d-flex gap-3 d-print-flex flex-wrap">

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-info border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total</small>
                                <h3 class="fw-bold mb-0"><u id="totalRecords">@Model.TotalRecords1.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-list-check fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Male</small>
                                <h3 class="fw-bold mb-0"><u id="maleCount">@Model.Male1</u></h3>
                            </div>
                            <div><i class="bi bi-gender-male fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-danger border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Female</small>
                                <h3 class="fw-bold mb-0"><u id="femaleCount">@Model.Female1</u></h3>
                            </div>
                            <div><i class="bi bi-gender-female fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-success border-3">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Active Employees</small>
                                <h3 class="fw-bold mb-0"><u id="activeEmps">@Model.ActiveEmp1</u></h3>
                            </div>
                            <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        

        <!--FILTER CONTROLS-->
        <div class="card p-2 m-2">
            <div class="d-flex m-2 justify-content-between flex-wrap">
                <div class="col-3 m-2 d-print-flex">
                    <label for="filter-company">Job Class:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-jobClassID">
                        <option value="">All</option>
                        @foreach (var jc in Model.JobClasses)
                        {
                            <option value="@jc.JobClassId">@jc.JobClassName</option>
                        }
                    </select>
                </div>
                <div class="col-3 m-2 d-print-flex">
                    <label for="filter-jobTitle">Job Title:</label>
                    <input list="jobTitleOptions" class="form-control" id="filter-jobTitle" placeholder="Type or select a job title" />
                    <datalist id="jobTitleOptions">
                        <option value="">All</option>
                        @foreach (var job in Model.Jobs)
                        {
                            <option value="@job.jobTitle">@job.jobTitle</option>
                        }
                    </datalist>
                </div>

                <div class="col-3 m-2 d-print-flex">
                    <label for="filter-status">Employment Status:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-status" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-3 m-2 d-print-flex">
                    <label for="filter-status">Gender:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-gender" asp-items="Html.GetEnumSelectList<Models.Gender>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-3 m-2 d-print-flex">
                    <label for="filter-duration">Min Experience in Months:</label>
                    <input class="form-select" id="filter-duration" type="number" value="0" />

                </div>
                <div class="d-flex align-items-end">
                    <button onclick="filterTalent()" class="btn btn-primary d-print-none">Load</button>
                </div>

            </div>
        </div>
        
        
        <!--LIST TABLE-->
        <table class="table table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>
                        Full Name
                    </th>
                    <th>
                        Job Title
                    </th>
                    <th>
                        Employment Status
                    </th>
                    <th>
                        Gender
                    </th>
                    <th>
                        Duration
                    </th>
                    
                </tr>
            </thead>
            <tbody id="table-body">
                
        </table>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>
<script src="~/js/filter-jobs.js"></script>


<script>
    function filterTalent() {
        var jobClassID = $("#filter-jobClassID").val();
        var EmploymentStatus = $("#filter-status").val();
        var JobTitle = $("#filter-jobTitle").val();
        var Gender = $("#filter-gender").val();
        var Duration = $("#filter-duration").val();
       

        // Normalize empty values to null
        jobClassID = (!jobClassID || jobClassID === "") ? null : jobClassID;
        EmploymentStatus = (!EmploymentStatus || EmploymentStatus === "") ? null : EmploymentStatus;
        JobTitle = (!JobTitle || JobTitle === "") ? null : JobTitle;
        Gender = (!Gender || Gender === "") ? null : Gender;
        Duration = (!Duration || Duration === "") ? null : Duration;


            var filters = {
                jobClassID: jobClassID,
                jobTitle: JobTitle,
                empStatus: EmploymentStatus,
                duration: Duration,
                gender: Gender
            };

    var url = "?handler=TalentExperienceFilter&" + $.param(filters);

        // jQuery AJAX
        $.getJSON(url, function (data) {
            

                //$("#table-body").html(data.tableHtml);
                $("#table-body").html(
                    data.tableHtml.map(e => `
                        <tr onclick="location.href='${e.detailsUrl}'" style="cursor:pointer;">
                        <td>${e.fullName}</td>
                        <td>${e.jobTitle}</td>
                        <td>${e.employmentStatus}</td>
                        <td>${e.gender}</td>
                        <td>${e.durationText}</td>
                    </tr>
                    `).join('')
                );

                $("#totalRecords").text(data.totalRecords);
                $("#maleCount").text(data.male);
                $("#femaleCount").text(data.female);
                $("#activeEmps").text(data.activeEmp);

            
     
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error("Error:", textStatus, errorThrown);
        });
    }

    function filterCertification() {

        var CompanyID = $("#filter-company").val();
        var DepartmentID = $("#filter-department").val();
        var Category = $("#filter-category").val();
        var Discipline = $("#filter-discipline").val(); // FIXED
        var Field = $("#filter-field").val();
        var EmploymentStatus = $("#filter-status1").val();
        var Start = $("#dateStart").val();
        var End = $("#dateEnd").val();

        // Normalize empty values to null
        CompanyID = CompanyID || null;
        DepartmentID = DepartmentID || null;
        Category = Category || null;
        Discipline = Discipline || null;
        Field = Field || null;
        EmploymentStatus = EmploymentStatus || null;
        Start = Start || null;
        End = End || null;

        var filters = {
            CompanyID: CompanyID,
            DepartmentID: DepartmentID,
            Category: Category,
            Discipline: Discipline,
            Field: Field,
            EmploymentStatus: EmploymentStatus,
            Start: Start,
            End: End
        };

        var url = "?handler=EducationReport&" + $.param(filters);

            $.getJSON(url, function (data) {

        let html = "";

        data.data.forEach(company => {

            // ---------------------- Company Row -----------------------
            html += `
                <tr class="table-primary fw-bold">
                    <td colspan="8">${company.companyName}</td>
                    <td>${company.distinctPersons}</td>
                    <td>${company.totalRecords}</td>
                </tr>
            `;

            // ---------------------- Department Rows -------------------
            (company.departments || []).forEach(dept => {

                html += `
                    <tr class="table-secondary fw-bold">
                        <td></td>
                        <td colspan="7">${dept.departmentName}</td>
                        <td>${dept.distinctPersons}</td>
                        <td>${dept.totalRecords}</td>
                    </tr>
                `;

                // ---------------------- Education Level Rows ------------
                (dept.educationLevels || []).forEach(level => {

                    html += `
                        <tr class="table-secondary fw-bold">
                            <td colspan="2"></td>
                            <td colspan="6">${level.levelCategory}</td>
                            <td>${level.distinctPersons}</td>
                            <td>${level.totalRecords}</td>
                        </tr>
                    `;

                    // ---------------------- Gender Rows -------------------
                    (level.genders || []).forEach(gender => {

                        html += `
                            <tr class="fw-bold">
                                <td colspan="3"></td>
                                <td colspan="5">${gender.gender}</td>
                                <td>${gender.distinctPersons}</td>
                                <td>${gender.totalRecords}</td>
                            </tr>
                        `;

                        // ---------------------- Individual Rows -------------
                        (gender.individuals || []).forEach(ind => {

                            html += `
                                <tr>
                                    <td colspan="3"></td>
                                    <td>${ind.givenID}</td>
                                    <td>${ind.fullName}</td>
                                    <td>${ind.educationField ?? ""}</td>
                                    <td>${ind.date}</td>
                                    <td>${ind.educationLevelMark ?? ""}</td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            `;

                        });

                    });

                });

            });

        });

        // Insert into table
        $("#table-body1").html(html);

        // ---------------------------------------
        // Update Summary Counts (WORKS NOW)
        // ---------------------------------------
        $("#TotalRecords1").text(data.totalRecords);
        $("#Male1").text(data.male);
        $("#Female1").text(data.female);
        $("#Active1").text(data.activeEmp);

    })
    .fail(function (jqXHR, textStatus, errorThrown) {
        console.error("Error:", textStatus, errorThrown);
    });
    }
   
</script>

<script>
    const labels = [
        @foreach (var item in Model.CertificationSummary)
        {
                @: "@item.CertificationCategory",
        }
    ];

    const maleData = [
        @foreach (var item in Model.CertificationSummary)
        {
                @: @item.Male,
        }
    ];

    const femaleData = [
        @foreach (var item in Model.CertificationSummary)
        {
                @: @item.Female,
        }
    ];

    const totalData = [
        @foreach (var item in Model.CertificationSummary)
        {
                @: @item.Total,
        }
    ];

    const ctx = document.getElementById('certChart').getContext('2d');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Male',
                    data: maleData,
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                },
                {
                    label: 'Female',
                    data: femaleData,
                    backgroundColor: 'rgba(255, 99, 132, 0.7)',
                    borderColor: 'rgba(255, 99, 132, 1)',
                    borderWidth: 1
                },
                {
                    label: 'Total',
                    data: totalData,
                    backgroundColor: 'rgba(75, 192, 192, 0.7)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                title: {
                    display: true,
                    text: ''
                }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
