@page
@model PIS2.Pages.PersonEducationLevel.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Education and Certification</h1>

<h4 class="fw-bold">Edit Certification Record</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="personEducationLevelModel.personEducationLevelID" />
            <input type="hidden" asp-for="personEducationLevelModel.modifiedBy" value="@User.Identity.Name" />
            <div class="form-group">
                <label asp-for="personEducationLevelModel.personID" class="control-label">Person Name</label>
                <select asp-for="personEducationLevelModel.personID" class="form-control" asp-items="ViewBag.personID"></select>
                <span asp-validation-for="personEducationLevelModel.personID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelID" class="control-label">Education/Certification Level</label>
                <select asp-for="personEducationLevelModel.educationLevelID" class="form-control" asp-items="ViewBag.educationLevelID"></select>
                <span asp-validation-for="personEducationLevelModel.educationLevelID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationField" class="control-label">Field/Title</label>
                <input asp-for="personEducationLevelModel.educationField" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationField" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelDate" class="control-label">Date</label>
                <input asp-for="personEducationLevelModel.educationLevelDate" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelMark" class="control-label">Obtained Grade/Mark</label>
                <input asp-for="personEducationLevelModel.educationLevelMark" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelMark" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelInstitutionName" class="control-label">Institution Name</label>
                <input asp-for="personEducationLevelModel.educationLevelInstitutionName" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelInstitutionName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="personEducationLevelModel.educationLevelNumber" class="control-label">Certificate Number</label>
                <input asp-for="personEducationLevelModel.educationLevelNumber" class="form-control" />
                <span asp-validation-for="personEducationLevelModel.educationLevelNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
