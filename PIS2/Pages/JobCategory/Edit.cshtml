@page
@model PIS2.Pages.JobCategory.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit Job Category</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="jobCategoryModel.jobCategoryID" />
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryName" class="control-label">Name</label>
                <input asp-for="jobCategoryModel.jobCategoryName" class="form-control" />
                <span asp-validation-for="jobCategoryModel.jobCategoryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryDescription" class="control-label">Description</label>
                <input asp-for="jobCategoryModel.jobCategoryDescription" class="form-control" />
                <span asp-validation-for="jobCategoryModel.jobCategoryDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryStatus" class="control-label">Status</label>
                <select asp-for="jobCategoryModel.jobCategoryStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="jobCategoryModel.jobCategoryStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
