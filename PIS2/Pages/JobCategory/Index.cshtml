@page
@model PIS2.Pages.JobCategory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">Job Categories</h2>

        <p class="d-print-none">
            <a asp-page="Create" class="btn btn-primary">Add New Job Category</a>
        </p>
    </div>
    <div class="d-flex justify-content-end d-print-none">
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="JobCategories_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>


<table class="table table-striped table-hover print-full-width" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Category Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.jobCategoryModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.jobCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobCategoryDescription)
            </td>
            <td>
                    @if (item.jobCategoryStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>

                    }
                    else if (item.jobCategoryStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>
                    }

            </td>
                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.jobCategoryID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.jobCategoryID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
    
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="JobCategories_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
