@page
@using PIS2.Enums
@model PIS2.Pages.JobCategory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end m-2">
    <div>
        <h2 class="fw-bold mb-0">Job Categories</h2>
        
        <p class="text-muted mb-0">
            Job categories catalog
        </p>
    </div><a asp-page="Create" class="btn btn-primary d-print-none"><i class="bi bi-plus-circle-fill me-2"></i>Add New Job Category</a>
</div>

<div class="card shadow-sm m-1 p-0">
    <div class="d-flex justify-content-end align-items-end m-0">
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("back")
        @await Html.PartialAsync("print")
        <div class="mx-2"><excel-export table="dataTable" filename="JobCategories_@(DateTime.UtcNow).xlsx"><i class="bi bi-box-arrow-up"></i></excel-export></div>
    </div>
</div>

<table class="table table-striped table-hover print-full-width" id="dataTable">
    <thead class ="table-dark">
        <tr >
            <th>S/No</th>
            <th>
                Category Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.jobCategoryModel == null || !Model.jobCategoryModel.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">
                    No job category found.
                </td>
            </tr>
        }
        @{
            int index = 1;
        }
        @foreach (var item in Model.jobCategoryModel) {
        <tr>
            <td>@(index++)</td>
            <td>
                @Html.DisplayFor(modelItem => item.jobCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobCategoryDescription)
            </td>
            <td>
                    @if (item.jobCategoryStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>

                    }
                    else if (item.jobCategoryStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobCategoryStatus)</span>
                    }

            </td>
                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.jobCategoryID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.jobCategoryID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
    }
    </tbody>
</table>
<div class="d-flex justify-content-end align-items-center m-0 d-print-none">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>
