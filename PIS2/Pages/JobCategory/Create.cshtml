@page
@using PIS2.Enums
@model PIS2.Pages.JobCategory.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Category</h1>

<h4 class="fw-bold">New Job Category</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryName" class="control-label">Job Category Name</label>
                <input asp-for="jobCategoryModel.jobCategoryName" class="form-control" />
                <span asp-validation-for="jobCategoryModel.jobCategoryName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryDescription" class="control-label">Description</label>
                <input asp-for="jobCategoryModel.jobCategoryDescription" class="form-control" />
                <span asp-validation-for="jobCategoryModel.jobCategoryDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobCategoryModel.jobCategoryStatus" class="control-label">Status</label>
                <select asp-for="jobCategoryModel.jobCategoryStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="jobCategoryModel.jobCategoryStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Job Categories</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
