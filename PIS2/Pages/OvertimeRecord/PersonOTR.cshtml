@page
@model PIS2.Pages.OvertimeRecord.PersonOTRModel

@{
    ViewData["Title"] = "PersonOTR";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int num = 0;
}
@await Html.PartialAsync("headerSimple", "")


<div class="d-flex justify-content-around">
    <h1 class="fw-bold col-5">Overtime Request</h1>
    <div class="col-md-5 d-print-none d-flex">
       
       
        @if (Model.overtimeRecordModel.Any())
        {
            <div class="m-2">@await Html.PartialAsync("filter")</div>
            
        }
        <div class="m-2 d-flex flex-grow">
            <a asp-page="Create" class="btn btn-primary m-2 d-print-none"><i class="bi bi-plus-circle-fill"></i>New Overtime</a>
            
        </div>
        <div class="m-2 d-flex">
            
            @await Html.PartialAsync("print");
        </div>
        
    </div>
    <hr />
</div>
<!--SUMMARY DATA-->
<div class="d-flex">
    <dl class="d-flex">
        <div class="d-flex me-4">
            <dt class="me-2 fw-bold">Employee ID:</dt>
            <dd onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.employmentModel.employmentID })'" style="cursor:pointer;">
                <u>@Model.employmentModel.givenID</u>
            </dd>
        </div>
        <div class="d-flex me-4">
            <dt class="me-2 fw-bold">Employee Name:</dt>
            <dd onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.employmentModel.employmentID })'" style="cursor:pointer;">
                <u>@Model.employmentModel.personModel.personFullName</u>
            </dd>
        </div>
        <div class="d-flex me-4">
            <dt class="me-2 fw-bold">Department:</dt>
            <dd><u>@Model.departmentModel?.departmentName</u></dd>
        </div>
        <div class="d-flex me-4">
            <dt class="me-2 fw-bold">Total Cost:</dt>
            <dd><u>@Math.Round(Model.TotalOtCost,2).ToString("N2")<span class="small"> Br</span></u></dd>
        </div>
    </dl>
</div>
<table class="table" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Date of Overtime
            </th>
            <th>
                Reason
            </th>
            
            <th>
                No
            </th>
            <th>
                Overtime Batch Number
            </th>
            
            <th>
                Overtime Type
            </th>
            
            <th>
                Start Time
            </th>
            <th>
                End Time
            </th>
            <th>
                Status
            </th>
            <th>
                Employee Rate
            </th>
            <th>
                Overtime Rate
            </th>
            <th>
                Time Elapsed
            </th>
            <th>
                OT Cost
            </th>
            <th>
                Modified By
            </th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var gr in Model.overtimeRecordModel.OrderByDescending(or => or.overtimeRecordDate).GroupBy(o => o.overtimeRecordDate))
        {
            bool first = true;

            @foreach (var item in gr.OrderByDescending(or => or.overtimeRecordStartTime))
            {
            num++;
            <tr onclick="location.href='@Url.Page("Details", new { id = item.overtimeRecordID })'" style="cursor:pointer;">
                    
                    @if (first)
                    {
                        <th rowspan="@gr.Count()">
                            @gr.Key.ToString("MM/dd/yyyy")
                        </th>
                        <td rowspan="@gr.Count()">
                            @gr.First().overtimeRecordReason
                        </td>
                        first = false;
                    
                    }<td>@num</td>

                <td>
                    @Html.DisplayFor(modelItem => item.overtimeRecordID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.overtimeModel.overtimeName)
                </td>
                
                <td>
                    @item.overtimeRecordStartTime.ToString(@"hh\:mm")
                </td>
                <td>
                    @item.overtimeRecordEndTime.ToString(@"hh\:mm")
                </td>
                <td>
                    @if (item.overtimeRecordStatus == Models.overtimeStatus.Posted)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>

                    }
                    else if (item.overtimeRecordStatus == Models.overtimeStatus.Hold)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                    }
                    else if (item.overtimeRecordStatus == Models.overtimeStatus.Approved)
                    {
                        <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                    }
                </td>
                <td>
                    @Math.Round(item.overtimeRecordEmploymentRate,2)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.overtimeRate)
                </td>
                <td>
                    @item.TimeElapsed.ToString(@"hh\:mm")
                </td>
                <td>
                    @Math.Round(item.GetOtCost,2)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.modifiedBy)
                </td>
                      
            </tr>
        }
    
        }
    
    </tbody>
</table>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>
<div class="print-full-width">@await Html.PartialAsync("signature")</div>


