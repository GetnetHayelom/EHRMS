@page
@model PIS2.Pages.OvertimeRecord.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int num = 0;
}

<h1 class="fw-bold">Overtime</h1>

<hr />
<div class="d-flex justify-content-between">
    <div class="col-md-4">
        <div class="">
            <form method="get" class="d-print-none">
                <div class="d-flex flex-column">
                    <h4 class="fw-bold">Overtime Record</h4>
                    <div class="d-flex">
                        <input asp-for="Employment.givenID" id="givenID" class="form-control me-2" placeholder="Enter ID" name="givenID" />
                        <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                    </div>
                    <h4 class="fw-bold mt-2 mb-2"><u>@Model.Person.personFullName</u></h4>
                    
                </div>
            </form>
        </div>
        @if(Model.Employment.employmentStatus == Models.mainStatus.Active)
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-2">
                    <label asp-for="overtimeRecordModel.overtimeRecordDate" class="control-label">Overtime Date</label>
                    <input asp-for="overtimeRecordModel.overtimeRecordDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="overtimeRecordModel.overtimeRecordDate" class="text-danger"></span>
                </div>
                <p>Note: A day starts at 12:00 AM(00:00) after midnight and ends at 11:59 PM(23:59) before midnight.</p>
                <div class="form-group mb-2">
                    <label asp-for="overtimeRecordModel.overtimeRecordStartTime" class="control-label">Start Time</label>
                    <input asp-for="overtimeRecordModel.overtimeRecordStartTime" class="form-control" type="time" step="60" asp-format="{0:hh\\:mm}" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" />
                    <span asp-validation-for="overtimeRecordModel.overtimeRecordStartTime" class="text-danger"></span>
                </div>
                <div class="form-group mb-2">
                    <label asp-for="overtimeRecordModel.overtimeRecordEndTime" class="control-label">End Time</label>
                    <input asp-for="overtimeRecordModel.overtimeRecordEndTime" class="form-control" type="time" step="60" asp-format="{0:hh\\:mm}" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" />
                    <span asp-validation-for="overtimeRecordModel.overtimeRecordEndTime" class="text-danger"></span>
                </div>
                <div class="form-group mb-2">
                    <label asp-for="overtimeRecordModel.overtimeRecordReason" class="control-label">Reason</label>
                    <input asp-for="overtimeRecordModel.overtimeRecordReason" class="form-control" type="text" />
                    <span asp-validation-for="overtimeRecordModel.overtimeRecordReason" class="text-danger"></span>
                </div>
                <div class="form-group d-flex justify-content-end">
                    <input type="submit" value="Save" class="btn btn-success d-print-none" />
                    
                </div>
            </form>
        }
        else if (Model.Employment.employmentStatus == Models.mainStatus.Inactive)
        {
            <div class="bg-danger p-4 text-white"><h4>Employee is not Active</h4></div>
        }
        else if (Model.EmployeeID == 0)
        {
            <div class="bg-danger p-4 text-white"><h4>Employee is not Active</h4></div>
        }
    </div>
    <div class="col-md-6 d-print-none">
        <h4 class="fw-bold">Pending Overtime</h4>
        @if(Model.OtRecords != null && Model.OtRecords.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="bg-info text-white">
                    <tr>
                        <th>No</th>
                        <th>Date</th>
                        <th>OT Type</th>
                        <th>Reason</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Time Elapsed</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
            
                    @foreach(var item in Model.OtRecords)
                    {
                        num++;
                        <tr onclick="location.href='@Url.Page("Details", new {id = item.overtimeRecordID})'" style="cursor:pointer;">
                            <td>@num</td>
                            <td>@item.overtimeRecordDate.ToString("MM/dd/yyyy")</td>
                            <td>@item.overtimeModel?.overtimeName</td>
                            <td>@item.overtimeRecordReason</td>
                            <td>@item.overtimeRecordStartTime.ToString(@"hh\:mm")</td>
                            <td>@item.overtimeRecordEndTime.ToString(@"hh\:mm")</td>
                            <td>@item.TimeElapsed.ToString(@"hh\:mm")</td>
                            <td>@Math.Round(item.GetOtCost,2).ToString("N2")</td>
                        </tr>
                    }
              
                </tbody>
            </table>
        }else
        {
            <p class="">No Pending Overtime Records. Would you rather like to view your <a asp-page="./PersonOTR" asp-route-otrID="null" asp-route-empID="@Model.EmployeeID">Overtime History.</a></p>
        }
    </div>
</div>



<div class="container my-4">
    <h4 class="fw-bold mb-3">Ethiopian Time vs International Time</h4>

    <div class="table-responsive">
        <table class="table table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <!-- Morning 6 hours -->
                    <th colspan="6" class="bg-primary">Morning</th>

                    <!-- Afternoon 6 hours -->
                    <th colspan="6" class="bg-success">Afternoon</th>

                    <!-- Evening 4 hours -->
                    <th colspan="4" class="bg-warning">Evening</th>

                    <!-- Night 8 hours -->
                    <th colspan="8" class="bg-secondary">Night</th>
                </tr>

                
            </thead>

            <tbody>
                <!-- Ethiopian Local Time Row -->
                <tr class="table-primary">
                    <!-- Fill Ethiopian times hour-by-hour -->
                    <td>1 AM</td>
                    <td>2 AM</td>
                    <td>3 AM</td>
                    <td>4 AM</td>
                    <td>5 AM</td>
                    <td>6 AM</td>

                    <td>7 AM</td>
                    <td>8 AM</td>
                    <td>9 AM</td>
                    <td>10 AM</td>
                    <td>11 AM</td>
                    <td>12 PM</td>

                    <td>1 PM</td>
                    <td>2 PM</td>
                    <td>3 PM</td>
                    <td>4 PM</td>
                    <td>5 PM</td>
                    <td>6 PM</td>

                    <td>7 PM</td>
                    <td>8 PM</td>
                    <td>9 PM</td>
                    <td>10 PM</td>
                    <td>11 PM</td>
                    <td>12 AM</td>
                    
                </tr>

                <!-- International Time Row -->
                <tr class="table-secondary">
                    <!-- Example uses UTC time = Ethiopia - 3 -->
                    <td>7 PM</td>
                    <td>8 PM</td>
                    <td>9 PM</td>
                    <td>10 PM</td>
                    <td>11 PM</td>
                    <td>12 AM</td>

                    <td>1 AM</td>
                    <td>2 AM</td>
                    <td>3 AM</td>
                    <td>4 AM</td>
                    <td>5 AM</td>
                    <td>6 AM</td>

                    <td>7 AM</td>
                    <td>8 AM</td>
                    <td>9 AM</td>
                    <td>10 AM</td>
                    <td>11 AM</td>
                    <td>12 PM</td>

                    <td>1 PM</td>
                    <td>2 PM</td>
                    <td>3 PM</td>
                    <td>4 PM</td>
                    <td>5 PM</td>
                    <td>6 PM</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



<div class="d-flex justify-content-end">
    <a asp-page="./PersonOTR" asp-route-otrID="null" asp-route-empID="@Model.EmployeeID" class="btn btn-secondary me-2 d-print-none">Preview</a>
    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
