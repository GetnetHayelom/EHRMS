@page
@model PIS2.Pages.OvertimeRecord.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.overtimeRecordModel[0].employmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.overtimeRecordModel[0].overtimeModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.overtimeRecordModel[0].overtimeRecordDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.overtimeRecordModel[0].overtimeRecordStartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.overtimeRecordModel[0].overtimeRecordEndTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.overtimeRecordModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeModel.overtimeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeRecordDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeRecordStartTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overtimeRecordEndTime)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.overtimeRecordID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.overtimeRecordID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.overtimeRecordID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
