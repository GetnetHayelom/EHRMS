@page
@model PIS2.Pages.OvertimeRecord.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Overtime Record</h1>

<h4 class="fw-bold">@L.T("Update") Overtime Record</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="overtimeRecordModel.overtimeRecordID" />
            <div class="form-group">
                <label asp-for="overtimeRecordModel.employmentID" class="control-label">Employee ID</label>
                <select asp-for="overtimeRecordModel.employmentID" class="form-control" asp-items="ViewBag.employmentID" readonly></select>
                <span asp-validation-for="overtimeRecordModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeID" class="control-label">Overtime Type</label>
                <select asp-for="overtimeRecordModel.overtimeID" class="form-control" asp-items="ViewBag.overtimeID" readonnly></select>
                <span asp-validation-for="overtimeRecordModel.overtimeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordDate" class="control-label">Date</label>
                <input asp-for="overtimeRecordModel.overtimeRecordDate" class="form-control" type="date" readonnly />
                <span asp-validation-for="overtimeRecordModel.overtimeRecordDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordStartTime" class="control-label">Start Time</label>
                <input asp-for="overtimeRecordModel.overtimeRecordStartTime" class="form-control" type="time" readonnly />
                <span asp-validation-for="overtimeRecordModel.overtimeRecordStartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordEndTime" class="control-label">End Time</label>
                <input asp-for="overtimeRecordModel.overtimeRecordEndTime" class="form-control" type="time" readonnly />
                <span asp-validation-for="overtimeRecordModel.overtimeRecordEndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordStatus" class="control-label">Status</label>
                <select asp-for="overtimeRecordModel.overtimeRecordStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Enums.overtimeStatus>()"></select>
                <span asp-validation-for="overtimeRecordModel.overtimeRecordStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
            </div>
            
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Overtime Records</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
