@page
@model PIS2.Pages.OvertimeRecord.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Overtime Record</h1>

<h4 class="fw-bold">Update Overtime Record</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="overtimeRecordModel.overtimeRecordID" />
            <div class="form-group">
                <label asp-for="overtimeRecordModel.employmentID" class="control-label"></label>
                <select asp-for="overtimeRecordModel.employmentID" class="form-control" asp-items="ViewBag.employmentID"></select>
                <span asp-validation-for="overtimeRecordModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeID" class="control-label"></label>
                <select asp-for="overtimeRecordModel.overtimeID" class="form-control" asp-items="ViewBag.overtimeID"></select>
                <span asp-validation-for="overtimeRecordModel.overtimeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordDate" class="control-label"></label>
                <input asp-for="overtimeRecordModel.overtimeRecordDate" class="form-control" type="date"/>
                <span asp-validation-for="overtimeRecordModel.overtimeRecordDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordStartTime" class="control-label"></label>
                <input asp-for="overtimeRecordModel.overtimeRecordStartTime" class="form-control" type="time"/>
                <span asp-validation-for="overtimeRecordModel.overtimeRecordStartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="overtimeRecordModel.overtimeRecordEndTime" class="control-label"></label>
                <input asp-for="overtimeRecordModel.overtimeRecordEndTime" class="form-control" type="time"/>
                <span asp-validation-for="overtimeRecordModel.overtimeRecordEndTime" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Overtime Records</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
