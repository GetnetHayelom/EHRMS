@page
@model PIS2.Pages.OvertimeRecord.DetailsModel

@{
    ViewData["Title"] = "Overtime Record Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Overtime Record</h1>
<div class="d-flex row">
    <div class="print-full-width col-md-4">
        <h4>Overtime Record Details</h4>
        <hr />
        <div class="d-flex">
            <h6 class="me-2"><b>Voucher ID:</b></h6>
            <h6><u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordID)</u></h6>
        </div>
        
        <dl class="row">
            <dt class="col-md-4">
                Employee ID:
            </dt>
            <dd class="col-md-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.employmentModel.givenID)
            </dd>
            <dt class="col-md-4">
                Employee Name:
            </dt>
            <dd class="col-md-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.employmentModel.personModel.personFullName)
            </dd>
            <dt class="col-md-4">
                Type of Overtime:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.overtimeModel.overtimeName)
            </dd>
            <dt class="col-sm-4">
                Date:
            </dt>
            <dd class="col-sm-8">
                @Model.overtimeRecordModel.overtimeRecordDate.ToString("dd MMM, yyyy")
            </dd>
            <dt class="col-sm-4">
                Start Time:
            </dt>
            <dd class="col-sm-8">
                @Model.overtimeRecordModel.overtimeRecordStartTime
            </dd>
            <dt class="col-sm-4">
                End Time:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordEndTime)
            </dd>
            <dt class="col-sm-4">
                Status:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordStatus)
            </dd>
            <dt class="col-sm-4">
                Reason:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordReason)
            </dd>
            <dt class="col-sm-4">
                Cost:
            </dt>
            <dd class="col-sm-8">
                @Model.overtimeRecordModel.GetOtCost
            </dd>
        </dl>
    </div>

    <div class="flex-grow-1 col-md-6">
        <h4><u>Overtime Record History</u></h4>
        <hr />
        <table class="table table-striped table-hover d-print-block print-full-width">
        <thead class="bg-info text-white">
            <tr>
                <th>Date</th>
                <th>Status</th>
                <th>Modified By</th>
               
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.OvertimeHistories)
            {
                <tr>
                    <td>@item.modifiedDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.overtimeHistoryAction</td>
                    <td>@item.modifiedBy</td>
                    
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
<div>
    <a class="btn btn-success me-2" asp-page="./Edit" asp-route-id="@Model.overtimeRecordModel.overtimeRecordID">Edit</a>
    <a class="btn btn-grey me-2" asp-page="./Index">Back to List</a>
    @await Html.PartialAsync("print")
</div>

