@page
@model PIS2.Pages.OvertimeRecord.DetailsModel

@{
    ViewData["Title"] = "Overtime Record Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Overtime Record</h1>
<div class="d-flex print-flex-column">
    <div class="col-md-6 print-full-width">
        <h4 class="fw-bold"><u>Overtime Record Details</u></h4>
        <hr />
        <div class="d-flex">
            <h6 class="me-2"><b>Voucher ID:</b></h6>
            <h6><u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordID)</u></h6>
        </div>
        
        <dl class="col">
            <div class="d-flex">
                <dt class="me-2">
                Employee ID:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.employmentModel.givenID)</u>
                </dd>
            </div>
            <div class="d-flex">    
                <dt class="me-2">
                    Employee Name:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.employmentModel.personModel.personFullName)</u>
                </dd>
            </div>
            <div class="d-flex">                    
                <dt class="me-2">
                    Type of Overtime:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeModel.overtimeName)</u>
                </dd>
            </div>
            <div class="d-flex">                
                <dt class="me-2">
                    Date:
                </dt>
                <dd class="me-4">
                    <u>@Model.overtimeRecordModel.overtimeRecordDate.ToString("dd MMM, yyyy")</u>
                </dd>
            </div>
            <div class="d-flex">                   
                <dt class="me-2">
                    Start Time:
                </dt>
                <dd class="me-4">
                    <u>@Model.overtimeRecordModel.overtimeRecordStartTime</u>
                </dd>
            </div>
            <div class="d-flex">               
                <dt class="me-2">
                    End Time:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordEndTime)</u>
                </dd>
            </div>
            <div class="d-flex">                
                <dt class="me-2">
                    Status:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordStatus)</u>
                </dd>
            </div>
            <div class="d-flex">                
                <dt class="me-2">
                    Reason:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.overtimeRecordModel.overtimeRecordReason)</u>
                </dd>
            </div>
            <div class="d-flex">                
                <dt class="me-2">
                    Cost:
                </dt>
                <dd class="me-4">
                    <u>@Model.overtimeRecordModel.GetOtCost.ToString("N2") <span class="small"> Br</span></u>
                </dd>
            </div>
        </dl>
        @if (Model.overtimeRecordModel.overtimeRecordStatus == Models.overtimeStatus.Hold)
        {
            @await Html.PartialAsync("signature");
        }
    </div>

    <div class="col-md-6 print-full-width">     
        <form method="get" class="d-print-none">
            <div class="d-flex justify-content-between">
                <h4 class="fw-bold"><u>Overtime Record History</u></h4>
                <div class="d-flex">
                    <input id="overtimeRecordID" class="form-control me-2" placeholder="Enter OT Batch Number" name="id" />
                    <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                </div>
            </div>
        </form>
        
        <hr />
       
        @{
            var tableClass = Model.overtimeRecordModel.overtimeRecordStatus == Models.overtimeStatus.Hold
            ? "table table-striped table-hover d-print-none"
            : "table table-striped table-hover print-full-width";
        }
        <table class="@tableClass">
            <thead class="bg-info text-white">
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Modified By</th>
                    <th>Modified Date</th>
               
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.OvertimeHistories)
                {
                    <tr>
                        <td>@item.modifiedDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.overtimeHistoryAction</td>
                        <td>@item.modifiedBy</td>
                        <td>@item.modifiedDate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end">
    @if(Model.overtimeRecordModel.overtimeRecordStatus == Models.overtimeStatus.Hold)
    {
        <a class="btn btn-success me-2 d-print-none" asp-page="./Edit" asp-route-id="@Model.overtimeRecordModel.overtimeRecordID">Edit</a>
    }   
    <a class="btn btn-secondary me-2 d-print-none" asp-page="./Index">Back to List</a>
    @await Html.PartialAsync("print")
</div>

