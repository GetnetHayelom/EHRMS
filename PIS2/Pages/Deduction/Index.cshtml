@page
@using PIS2.Enums
@model PIS2.Pages.Deductions.IndexModel
@{
    ViewData["Title"] = "Deduction Types";
}

<div class="container mt-1">
    <div class="d-flex justify-content-between align-items-end mb-2">
        <div>
            <h2 class="fw-bold text-text mb-0">Deduction Types</h2>
            <p class="text-muted mb-0">Deduction Types Catalog</p>
        </div>
        
        <a asp-page="./Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New Deduction
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.DeductionTypes != null && Model.DeductionTypes.Any())
            {
                <div class="card shadow-sm m-1 p-0">
                    <div class="d-flex justify-content-end align-items-end m-0">
                        @await Html.PartialAsync("filter")
                        @await Html.PartialAsync("back")
                        @await Html.PartialAsync("print")
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>S/No</th>
                                <th>Deduction Name</th>
                                <th>Deduct From</th>
                                <th>Priority</th>
                                <th>Recurring</th>
                                <th>Mandatory</th>
                                <th>Status</th>
                                <th>Modified By</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DeductionTypes)
                            {
                                <tr>
                                    <td>@item.deductionTypeID</td>
                                    <td>@item.deductionName
                                    <p class="m-0 text-muted">@item.Account?.accountName</p></td>
                                    <td>@item.deductBase</td>
                                    <td>@item.deductionPriority</td>
                                    <td>
                                        @if (item.isRecurring)
                                        {
                                            <span class="badge bg-info text-dark">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.isMandatory)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">No</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (item.deductionStatus)
                                        {
                                            case mainStatus.Active:
                                                <span class="badge bg-success">Active</span>
                                                ;
                                                break;
                                            case mainStatus.Suspended:
                                                <span class="badge bg-warning text-dark">Suspended</span>
                                                ;
                                                break;
                                            case mainStatus.Inactive:
                                                <span class="badge bg-danger">Inactive</span>
                                                ;
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Unknown</span>
                                                ;
                                                break;
                                        }
                                    </td>
                                    <td>@item.modifiedBy</td>
                                    <td class="text-end">   
                                        <div class="btn-group" role="group">
                                            <a asp-page="./Details" asp-route-id="@item.deductionTypeID" class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="./Edit" asp-route-id="@item.deductionTypeID" class="btn btn-sm btn-outline-success" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end align-items-center m-0">
                    @await Html.PartialAsync("back")
                    @await Html.PartialAsync("print")
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-info-circle me-2"></i> No deduction types found.
                </div>
            }
        </div>
    </div>
</div>
