@page "{id:int}"
@using PIS2.Enums
@model PIS2.Pages.Deduction.EditModel
@{
    ViewData["Title"] = "Edit Deduction Type";
}
<h2 class="fw-bold">Deduction Types</h2>
<p class="mb-0 fw-bold text-muted"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Deduction Type #@Model.DeductionType.deductionTypeID</p>
<div class="container mt-2">
    <div class="card shadow-sm border-0">

        <div class="card-body">
            <form method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="DeductionType.deductionTypeID" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductionName" class="form-label fw-semibold">Name</label>
                        <input asp-for="DeductionType.deductionName" class="form-control" placeholder="Enter deduction name" />
                        <span asp-validation-for="DeductionType.deductionName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductBase" class="form-label fw-semibold">Base</label>
                        <select asp-for="DeductionType.deductBase" class="form-select" asp-items="Html.GetEnumSelectList<Enums.deductionBase>()"></select>
                        <span asp-validation-for="DeductionType.deductBase" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductionCode" class="form-label fw-semibold"><span class="text-danger">*</span>Code</label>
                        <input asp-for="DeductionType.deductionCode" class="form-control" placeholder="Enter deduction code" required/>
                        <span asp-validation-for="DeductionType.deductionCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductionDescription" class="form-label fw-semibold"><span class="text-danger">*</span>Description</label>
                        <input asp-for="DeductionType.deductionDescription" class="form-control" placeholder="Enter deduction description" required />
                        <span asp-validation-for="DeductionType.deductionDescription" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductionPriority" class="form-label fw-semibold">Priority</label>
                        <input asp-for="DeductionType.deductionPriority" class="form-control" type="number" min="1" />
                        <span asp-validation-for="DeductionType.deductionPriority" class="text-danger"></span>
                    </div>
                    <!-- Type -->
                    <!-- Selector -->
                    <div class="col-md-6">
                        <label asp-for="DeductionType.accountID" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Account
                        </label>
                        <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.DeductionType.Account?.accountName" />
                        <input type="hidden" asp-for="DeductionType.accountID" id="personIDHidden" value="@Model.DeductionType.accountID" />
                        <datalist id="personList">
                            @foreach (var account in Model.Accounts)
                            {
                                <option data-id="@account.Value" value="@account.Text"></option>
                            }
                        </datalist>
                        <span asp-validation-for="DeductionType.accountID" class="text-danger"></span>
                    </div>
                    
                </div>
                <div class="col-md-1">
                    <div class="form-check mt-4">
                        <input asp-for="DeductionType.isRecurring" class="form-check-input" type="checkbox" />
                        <label asp-for="DeductionType.isRecurring" class="form-check-label fw-semibold">Is Recuring</label>
                    </div>
                </div>

                <div class="col-md-1">
                    <div class="form-check mt-4">
                        <input asp-for="DeductionType.isMandatory" class="form-check-input" type="checkbox" />
                        <label asp-for="DeductionType.isMandatory" class="form-check-label fw-semibold">Is Mandatory</label>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="DeductionType.deductionStatus" class="form-label fw-semibold">Deduction Status</label>
                        <select asp-for="DeductionType.deductionStatus" class="form-select" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DeductionType.modifiedBy" class="form-label fw-semibold">User</label>
                        <input asp-for="DeductionType.modifiedBy" class="form-control" readonly />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left m-2"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save m-2"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
