@page
@using PIS2.Enums
@model PIS2.Pages.Person.DetailsModel

@{
    ViewData["Title"] = "Person Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<style>
    /* Print Utility */
    @@media print {
        body * {
            visibility: hidden;
        }

        #printID, #printID * {
            visibility: visible;
        }

        #printID {
            position: absolute;
            left: 0;
            top: 0;
        }

        .d-none {
            display: block !important;
        }
    }

    .print-card-wrapper {
        display: flex;
        justify-content: center;
        padding: 20px;
        background: #f0f0f0;
    }

    .id-card {
        width: 323px; /* ~85.6mm */
        height: 502px; /* ~133mm - Standard Vertical Format */
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        border: 1px solid #ddd;
        display: flex;
        flex-direction: column;
    }

    .id-header {
        background: #1a3a5a; /* Deep Industrial Blue */
        color: white;
        padding: 20px 10px;
        text-align: center;
        border-bottom: 4px solid #e67e22; /* Safety Orange Accent */
    }

        .id-header h3 {
            margin: 0;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .id-subtitle {
        font-size: 10px;
        margin-top: 5px;
        opacity: 0.8;
    }

    .id-body {
        padding: 15px;
        flex-grow: 1;
        text-align: center;
    }

    .photo-box {
        width: 110px;
        height: 130px;
        margin: 0 auto 15px;
        border: 3px solid #1a3a5a;
        border-radius: 8px;
        overflow: hidden;
        background: #eee;
    }

        .photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .info-box {
        text-align: left;
        margin-top: 10px;
    }

        .info-box p {
            margin: 4px 0;
            font-size: 11px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 2px;
        }

        .info-box span {
            font-weight: bold;
            color: #1a3a5a;
            width: 80px;
            display: inline-block;
            font-size: 9px;
        }

    .id-footer {
        padding: 15px;
        background: #f9f9f9;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-top: 1px solid #eee;
    }

    .signature-section {
        text-align: center;
        flex: 1;
    }

    .signature-line {
        border-top: 1px solid #666;
        margin-bottom: 5px;
        width: 80%;
    }

    .signature-section span {
        font-size: 9px;
        color: #888;
    }

    .qr-box {
        width: 50px;
        height: 50px;
        background: #ddd;
        border: 1px solid #ccc;
    }

    .qr-mock {
        width: 100%;
        height: 100%;
        background-image: linear-gradient(45deg, #000 25%, transparent 25%), linear-gradient(-45deg, #000 25%, transparent 25%);
        background-size: 4px 4px;
        opacity: 0.3;
    }
</style>
<div class="container-fluid py-0" id="body_container">
    <!--HEADER-->
    <div class="d-flex justify-content-between align-items-center mb-2 d-print-none">
        <div>
            <h2 class="fw-bold m-0">Personal Profile</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-page="./Index">Persons</a>
                        
                    </li>
                    <li class="breadcrumb-item active">View Profile(#@Model.personModel.personID)</li>
                </ol>
            </nav>
            
        </div>
        <!--CALL TO ACTION-->
        @if (User.IsInRole("MIE\\PMS_HRCLERK"))
        {
            <div>
                <div class="btn-group shadow-sm">
                    <input type="text" class="" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" />
                    <input type="hidden" asp-for="personModel.personID" id="personIDHidden" />
                    <datalist id="personList">
                        @foreach (var person in Model.PersonList)
                        {
                            <option data-id="@person.Value" value="@person.Text"></option>
                        }
                    </datalist>
                    <a onclick="this.href='/Person/Details?id=' + document.getElementById('personIDHidden').value" class="btn btn-outline-primary"><i class="bi bi-eye"></i></a>
                </div>


                <div class="btn-group shadow-sm">
                    <a asp-page="./Edit" asp-route-id="@Model.personModel.personID" class="btn btn-outline-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <button class="btn btn-outline-dark" onclick="printEmployeeID()">
                        <i class="bi bi-printer"></i> ID Card
                    </button>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">Actions</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (Model.isPersonActiveEmployee)
                            {
                                <li><a class="dropdown-item text-danger" asp-page="/Termination/Create" asp-route-id="@Model.personModel.Employments.FirstOrDefault(e => e.employmentStatus == mainStatus.Active).employmentID">Terminate Employment</a></li>
                                <li><a class="dropdown-item" asp-page="/Employment/Details" asp-route-id="@Model.personModel.Employments.FirstOrDefault().employmentID">View Employment Info</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-page="/Employment/Create" asp-route-id="@Model.personModel.personID">Add to Employment</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Family/Create?id=@Model.personModel.personID">Add Relative</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
                
        }
    
    </div>

    <div class="row">
        <!--PERSONAL INFO CARD-->
        <div class="col-lg-4 col-xl-3">
            <div class="card shadow-sm mb-4 border-0">
                <div class="mb-2">
                    <small class="text-muted d-block">Record Number</small>
                    <span class="fw-semibold">#@Model.personModel.personRecordNumber</span>
                </div>
                <div class="card-body text-center">
                    @await Html.PartialAsync("_PersonalInfoPartial", Model.personModel)
                </div>
            </div>
        </div>

        <!--MORE VIEWS-->
        <div class="col-lg-8 col-xl-9">
            <!--PERSON DETAILS-->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold m-0 text-dark">Information Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3">Personal Details</h6>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted small">Date of Birth</div>
                                <div class="col-sm-7 fw-medium">@Model.personModel.personDoB.ToString("MMM dd, yyyy")</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted small">Gender</div>
                                <div class="col-sm-7">@Html.DisplayFor(model => model.personModel.personGender)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-sm-5 text-muted small">Home Address</div>
                                <div class="col-sm-7 small">@Model.personModel.addressModel?.addressFormatted</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-bold small mb-3">Emergency Contact</h6>
                            <div class="bg-light p-3 rounded">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="flex-grow-1">
                                        <div class="fw-bold">@Model.personModel2?.personFullName</div>
                                        <div class="small text-muted">@Model.personModel2?.personPhoneNumber</div>
                                    </div>
                                    @if(Model.personModel2 !=null)
                                    {
                                        <a href="/Person/Details?id=@Model.personModel2?.personID" class="btn btn-sm btn-outline-secondary">View Profile</a>
                                    }
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--ACCORDION VIEWS-->
            <div class="accordion accordion-flush shadow-sm rounded border overflow-hidden" id="detailsAccordion">
                <!--EDUCATION ACCORDION-->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCert">
                            Certifications & Education
                        </button>
                    </h2>
                    <div id="collapseCert" class="accordion-collapse collapse" data-bs-parent="#detailsAccordion">
                        <div class="accordion-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th class="ps-3">Type</th>
                                            <th>Date</th>
                                            <th>Title/School</th>
                                            <th>CGPA</th>
                                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                            {
                                                <th class="text-end pe-3">Action</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.personCertifications)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-bold">@item.educationLevelModel?.educationLevelCategory</td>
                                                <td>@item.educationLevelDate.ToString("yyyy")</td>
                                                <td>
                                                    <div class="fw-semibold">@item.educationField</div>
                                                    <div class="small text-muted">@item.educationLevelInstitutionName</div>
                                                </td>
                                                <td><span class="badge bg-secondary">@item.educationLevelMark</span></td>
                                                @if(User.IsInRole("<IE\\PMS_HRCLERK"))
                                                {
                                                    <td class="text-end pe-3">
                                                        <a href="@Url.Page("/PersonEducationLevel/Edit", new { id = item.personEducationLevelID })" class="btn btn-sm btn-light">Edit</a>
                                                    </td>
                                                }
                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                            {
                                <div class="p-3 bg-light border-top text-end">
                                    <a asp-page="/PersonEducationLevel/Create" asp-route-id="@Model.personModel.personID" class="btn btn-sm btn-primary">+ Add New</a>
                                </div>
                            }
                            
                        </div>
                    </div>
                </div>
                <!--EMPLOYMENT ACCORDION-->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEmp">
                            Employment History
                        </button>
                    </h2>
                    <div id="collapseEmp" class="accordion-collapse collapse" data-bs-parent="#detailsAccordion">
                        <div class="accordion-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-uppercase">
                                            <th class="ps-3">Type</th>
                                            <th>Hire Date</th>
                                            <th>Status</th>
                                            <th class="text-end pe-3">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.personEmployments)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-bold">@item.employmentTypeModel?.employmentTypeName</td>
                                                <td>@item.employmentDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge @(item.employmentStatus == mainStatus.Active ? "bg-success" : "bg-danger")">
                                                        @item.employmentStatus
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <a href="@Url.Page("/Employment/Details", new { id = item.employmentID })" class="btn btn-sm btn-outline-primary">Details</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!--FAMILY ACCORDION-->
                @if (Model.familyRelations != null && Model.familyRelations.Any())
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="famHeader">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFam" aria-expanded="false" aria-controls="collapseFam">
                                Family & Dependents
                            </button>
                        </h2>
                        <div id="collapseFam" class="accordion-collapse collapse" aria-labelledby="famHeader" data-bs-parent="#detailsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr class="small text-uppercase">
                                                <th class="ps-3">Full Name</th>
                                                <th>Relationship</th>
                                                <th>Last Updated</th>
                                                <th>Verified By</th>
                                                @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                {
                                                    <th class="text-end pe-3">Action</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.familyRelations)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-xs me-2 bg-light rounded-circle text-center" style="width:30px; height:30px; line-height:30px;">
                                                                <i class="bi bi-person-fill text-secondary"></i>
                                                            </div>
                                                            <div class="fw-bold">
                                                                @if (item.personID != Model.personModel.personID)
                                                                {
                                                                    <a href="/Person/Details?id=@item.personID" class="text-decoration-none text-dark">@item.personModel?.personFullName</a>
                                                                }
                                                                else
                                                                {
                                                                    <a href="/Person/Details?id=@item.personID2" class="text-decoration-none text-dark">@item.personModel2?.personFullName</a>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge rounded-pill bg-info text-dark fw-medium">
                                                            @item.relation
                                                        </span>
                                                    </td>
                                                    <td class="small text-muted">@item.modifiedDate.ToString("MM/dd/yyyy")</td>
                                                    <td class="small">@item.modifiedBy</td>
                                                    <td class="text-end pe-3">
                                                        <a href="/Person/Details?id=@(item.personID != Model.personModel.personID ? item.personID : item.personID2)" class="btn btn-sm btn-outline-secondary">
                                                            View Profile
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if(User.IsInRole("MIE\\PMS_HRCLERK"))
                                {
                                    <div class="p-3 bg-light border-top text-end">
                                        <a href="/Family/Create?id=@Model.personModel.personID" class="btn btn-sm btn-primary">
                                            <i class="bi bi-plus"></i> Add Family Member
                                        </a>
                                    </div>
                                }
                                
                            </div>
                        </div>
                    </div>
                }

                <!--EXPERIENCE ACCORDION-->
                @if (Model.personExperiences != null && Model.personExperiences.Any())
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExp">
                                Professional Experience
                            </button>
                        </h2>
                        <div id="collapseExp" class="accordion-collapse collapse" data-bs-parent="#detailsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr class="small text-uppercase">
                                                <th class="ps-3">Duration</th>
                                                <th>Job Title & Company</th>
                                                <th>Type</th>
                                                <th>Salary</th>
                                                @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                {
                                                    <th class="text-end pe-3">Action</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.personExperiences)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <span class="small fw-bold text-primary">@item.experienceStartDate.Year - @item.experienceEndDate.Year</span>
                                                        <div class="text-muted small">(@(item.experienceEndDate.Year - item.experienceStartDate.Year) Years)</div>
                                                    </td>
                                                    <td>
                                                        <div class="fw-bold">@item.jobTitle</div>
                                                        <div class="small text-muted">@item.jobDepartment</div>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@item.experienceType</span></td>
                                                    <td class="fw-medium text-success">@item.jobSalary</td>
                                                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                    {
                                                        <td class="text-end pe-3">
                                                            <a href="@Url.Page("/Experience/Edit", new { id = item.experienceID })" class="btn btn-sm btn-light border">Edit</a>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                {
                                    <div class="p-3 bg-light border-top text-end">
                                        <a asp-page="/Experience/Create" asp-route-id="@Model.personModel.personID" class="btn btn-sm btn-primary">+ Add Experience</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!--RECORD HISTORY-->
                @if (Model.personModel.PersonHistories != null && Model.personModel.PersonHistories.Any())
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseHistory">
                                Data Change Logs (Audit Trail)
                            </button>
                        </h2>
                        <div id="collapseHistory" class="accordion-collapse collapse" data-bs-parent="#detailsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="bg-dark text-white">
                                            <tr class="text-nowrap">
                                                <th class="ps-3">Modified Date</th>
                                                <th>Modified By</th>
                                                <th>Full Name</th>
                                                <th>ID Info</th>
                                                <th>Contact</th>
                                                <th>Address</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.personModel.PersonHistories)
                                            {
                                                <tr class="text-nowrap">
                                                    <td class="ps-3 fw-bold text-primary">@item.modifiedDate?.ToString()</td>
                                                    <td><span class="badge bg-secondary">@item.modifiedBy</span></td>
                                                    <td>@item.personFirstName @item.personLastName</td>
                                                    <td>
                                                        <div class="small">@item.personIDType</div>
                                                        <div class="fw-bold text-muted">@item.personIDNumber</div>
                                                    </td>
                                                    <td>
                                                        <div class="small">@item.personPhoneNumber</div>
                                                        <div class="small text-muted">@item.personEmailAddress</div>
                                                    </td>
                                                    <td class="text-truncate" style="max-width: 150px;">@(item.addressModel?.addressFormatted ?? "N/A")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            
            </div>
            <div class="d-flex justify-content-end m-2">
                <div class="btn-group">
                    <a asp-page="/Applications/Create" asp-route-personId="@Model.personModel.personID" class="btn btn-primary"> <i class="bi bi-person-plus me-2"></i> Add As Applicant</a>
                    @if (!Model.isPersonActiveEmployee)
                    {
                        <a class="btn btn-warning" asp-page="/Employment/Create" asp-route-id="@Model.personModel.personID">Add to Employment</a>
                    }
                </div>
                
            </div>
            
        </div>
    </div>
    @await Html.PartialAsync("_AttachmentPartial",
    new Pages.Shared.AttachmentPartialModel
    {
        tableName = "Person",
        recordId = Model.personModel.personID
    })
</div>

<!--PRINT ID-->
<div id="printID" class="print-card-wrapper d-none">
    <div class="id-card">

        <div class="id-header">
            <h3 class="fw-bold">MESFIN METALS & ENGINEERING PLC</h3>
            <p class="id-subtitle">Employee Identification</p>
        </div>

        <div class="id-body">
            <div class="photo-box">
                <img src="/api/attachments/viewprofile/@Model?.personModel?.personID" alt="Profile Picture">
            </div>

            <div class="info-box">
                <p><span>NAME:</span> @Model?.personModel.personFullName</p>
                <p><span>ID NO:</span> @Model?.currentEmployment?.givenID</p>

                @if (Model.isPersonActiveEmployee)
                {
                    <p><span>JOB TITLE:</span> @Model.currentJob?.jobModel?.jobTitle</p>
                    <p><span>DEPARTMENT:</span> @Model.currentJob?.departmentModel?.departmentName</p>
                }
                <p><span>PHONE:</span> @Model?.personModel.personPhoneNumber</p>
                <p><span>EMAIL:</span> @Model?.personModel.personEmailAddress</p>
            </div>
        </div>

        <div class="id-footer">
            <div class="signature-section">
                <div class="signature-line"></div>
                <span>Authorized Signature</span>
            </div>
            <div class="qr-box">
                <div class="qr-mock"></div>
            </div>
        </div>
    </div>
</div>

<script>
    function printEmployeeID() {
        var body = $('#body_container');
        var card = $('#printID');
        
        body.addClass('d-none');
        card.removeClass('d-none');
        window.print();
        
        body.removeClass('d-none');
        card.addClass('d-none');
    }
</script>