@page
@model PIS2.Pages.Person.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold d-print-none">Person View</h1>

<div>
    <div><h4 class="fw-bold">Person Details</h4></div>
    
    <hr />
    <div class="d-flex flex-column mt-2 mb-1 p-2">
        <div class="d-flex d-print-d-flex">
            <div class="d-flex flex-column justify-content-center align-items-center col-4">
                @{
                    var imagePath = $"~/images/{Model.personModel.personID}.jpg";
                    if (!Model.PhotoExists)
                    {
                        imagePath = Model.personModel.personGender == Models.Gender.Female ? "~/images/female-default.png" : "~/images/male-default.png";
                    }
                }
                <img src="@Url.Content(imagePath)" class="rounded-circle mb-4 print-small-image normal-image" />
                <h4 class="fw-bold"><u>@Model.personModel.personFullName</u></h4>
                
            </div>
            <div class="d-flex d-print-block col-8">
                <div class="col-6 print-full-width">
                    <h4 class="fw-bold"><u>Personal Info</u></h4>
                    <dl>                   
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Date of Birth:
                            </dt>
                            <dd class="">
                                <u>@Model.personModel.personDoB.ToString("MMM dd, yyyy")</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Gender:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personGender)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Provided ID:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personIDType)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                ID Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personIDNumber)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Record Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personRecordNumber)</u>
                            </dd>
                        </div>
                
                    </dl>
                </div>
        
                <div class="col-6 print-full-width">
                    <h4 class="fw-bold"><u>Contact & Address Info</u></h4>
                    <dl>
                        <div class="d-flex me-2">
                            <dt class="">
                                Phone Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personPhoneNumber)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Email:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personEmailAddress)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Address:
                            </dt>
                            <dd class="">
                                <u>@Model.personModel.addressModel?.addressFormatted</u>
                            </dd>
                        </div>
                
                    </dl>
                </div>
            </div>
        </div>
    </div>

</div>
    
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.personModel.personID" class="btn btn-success m-2 d-print-none">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary m-2 d-print-none">Back to List</a>
    @if (Model.isPersonActiveEmployee)
    {
        <a asp-page="/Termination/Create" asp-route-id="@Model.personModel.Employments.FirstOrDefault(e => e.employmentStatus == Models.mainStatus.Active).employmentID" class="btn btn-danger m-2 d-print-none">Terminate Employment</a>
        <a asp-page="/Employment/Details" asp-route-id="@Model.personModel.Employments.FirstOrDefault().employmentID" class="btn btn-info m-2 d-print-none">Employment Info</a>
    }
    else
    {
        <a asp-page="/Employment/Create" asp-route-id="@Model.personModel.personID" class="btn btn-primary m-2 d-print-none">Add To employment</a>
    }
    @await Html.PartialAsync("print")
</div>
<div class="accordion d-print-none" id="accordion">
  <!--Person Certification -->  
    @if (Model.personCertifications != null && Model.personCertifications.Any())
    {
        <div class="collapse-item">
            <h4 class="collapse-header" id="header3">
                <button class="accordion-button fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                    Person Certifications
                </button>
            </h4>
            <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="header3" data-bs-parent="#collapse">
                <div class="collapse-body">
                    <table class="table table-striped table-hover">
                        <thead class="bg-info text-white">
                            <tr>
                                <td>Certification Type</td>
                                <td>Date</td>
                                <td>CGPA</td>
                                <td>Title</td>
                                <td>School</td>
                                <td>Certificate Number</td>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.personCertifications)
                            {
                                <tr onclick="location.href='@Url.Page("/PersonEducationLevel/Edit", new {id = item.personEducationLevelID})'" style="cursor:pointer">
                                    <td>@item.educationLevelModel?.educationLevelCategory</td>
                                    <td>@item.educationLevelDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.educationLevelMark</td>
                                    <td>@item.educationField</td>
                                    <td>@item.educationLevelInstitutionName</td>
                                    <td>@item.educationLevelNumber</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-end">
                        <a asp-page="/PersonEducationLevel/Create"
                           asp-route-id="@Model.personModel.personID"
                           class="btn btn-primary m-2">
                            Add New Certification
                        </a>
                    </div>

                </div>
            </div>
        </div>
        
    }

    <!--Person Experiences -->
    @if (Model.personExperiences != null && Model.personExperiences.Any())
    {
        <div class="collapse-item">
            <h4 class="collapse-header" id="header4">
                <button class="accordion-button fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                    Person Experience
                </button>
            </h4>
            <div id="collapse4" class="accordion-collapse collapse" aria-labelledby="header4" data-bs-parent="#collapse">
                <div class="collapse-body">
                    <table class="table table-striped table-hover">
                        <thead class="bg-info text-white">
                            <tr>
                                <td>From-To</td>
                                <td>Job Title</td>
                                <td>Salary</td>

                                <td>Type</td>
                                <td>Company</td>
                                <td>Duration</td>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.personExperiences)
                            {
                                <tr onclick="location.href='@Url.Page("/Experience/Edit", new {id = item.experienceID})'" style="cursor:pointer">
                                    <td>@item.experienceStartDate.ToString("MM/dd/yyyy") - @item.experienceEndDate.ToString("MM/dd/yyyy")</td>
                                    <td>@item.jobTitle</td>
                                    <td>@item.jobSalary</td>

                                    <td>@item.experienceType</td>
                                    <td>@item.jobDepartment</td>
                                    <td>@(item.experienceEndDate.Year - item.experienceStartDate.Year)</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary m-2">Add New Experiences</button>
                    </div>
                </div>
            </div>
        </div>

    }

    <!--Person Employments -->
    @if (Model.personEmployments != null && Model.personEmployments.Any())
    {
        <div class="accordio-item">
            <h4 class="accordion-header" id="header2">
                <button class="accordion-button fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">Person Employment History History</button>
            </h4>
            <div id="collapse2" class="accordion-collapse collapse" aria-labelledby="header2" data-bs-parent="#collapse">
                <div class="accordion-body">
                    <table class="table table-striped table-hover">
                        <thead class="bg-info text-white">
                            <tr>
                                <td>Given ID</td>
                                <td>Employment Type</td>
                                <td>Hire Date</td>
                                <td>Termination Date</td>
                                <td>Termination Reason</td>
                                <td>Employment Status</td>
                
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.personEmployments)
                            {
                                <tr onclick="location.href='@Url.Page("/Employment/Details", new {id = item.employmentID})'" style="cursor:pointer;">
                                    <td>@item.givenID</td>
                                    <td>@item.employmentTypeModel?.employmentTypeName</td>
                                    <td>@item.employmentDate.ToString("yyyy-MM-dd")</td>
                                    <td>@item.employmentTerminationDate</td>
                                    <td>@item.TerminationModel?.terminationReason</td>
                                    <td>@item.employmentStatus</td>
                    
                                </tr>
                            }
            
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!--Person Record History -->
    @if (Model.personModel.PersonHistories != null && Model.personModel.PersonHistories.Any())
    {
        <div class="accordion-item">
            <h4 class="accordion-header" id="header1">
                <button class="accordion-button fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="false" aria-controls="collapse1">Person Record History</button>
            </h4>
            <div id="collapse1" class="accordion-collapse collapse" aria-labelledby="header1" data-bs-parent="#collapse">
                <div class="accordion-body">
                    <table class="table table-striped table-hover historyTable">
                        <thead class="bg-info text-white">
                            <tr>
                                <td>Record ID</td>
                                <td>First Name</td>
                                <td>Fathers Name</td>
                                <td>Last Name</td>
                                <td>Date of Birth</td>
                                <td>ID Type</td>
                                <td>ID Number</td>
                                <td>Phone Number</td>
                                <td>Email</td>
                                <td>Address</td>
                                <td>Modified By</td>
                                <td>Modified Date</td>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.personModel.PersonHistories)
                            {
                                <tr>
                                    <td>@item.personID</td>
                                    <td>@item.personFirstName</td>
                                    <td>@item.personFatherName</td>
                                    <td>@item.personLastName</td>
                                    <td>@item.personDoB.ToString("MMM dd, yyyy")</td>
                                    <td>@item.personIDType</td>
                                    <td>@item.personIDNumber</td>
                                    <td>@item.personPhoneNumber</td>
                                    <td>@item.personEmailAddress</td>
                                    <td>@(item.addressModel?.addressFormatted ?? "N/A")</td>
                                    <td>@item.modifiedBy</td>
                                    <td>@item.modifiedDate</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
<script src="~/js/highlightChange.js"></script>


