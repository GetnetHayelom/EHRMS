@page
@model PIS2.Pages.Person.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Person View</h1>

<div>
    <div><h4 class="fw-bold">Person Details</h4></div>
    
    <hr />
    <div class="d-flex flex-column mt-2 mb-1 p-2">
        <div class="d-flex">
            <div class="d-flex flex-column justify-content-center align-items-center col-4 print-full-width">
                @{
                    var imagePath = $"~/images/{Model.personModel.personID}.jpg";
                    if (!Model.PhotoExists)
                    {
                        imagePath = Model.personModel.personGender == Models.Gender.Female ? "~/images/female-default.png" : "~/images/male-default.png";
                    }
                }
                <img src="@Url.Content(imagePath)" class="rounded-circle mb-4" style="width: 300px; height: 300px; object-fit: cover;" />
                <h4 class="fw-bold"><u>@Model.personModel.personFullName</u></h4>
            </div>
            <div class="d-flex d-print-block col-8">
                <div class="col-6 print-full-width">
                    <h4 class="fw-bold"><u>Personal Info</u></h4>
                    <dl>                   
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Date of Birth:
                            </dt>
                            <dd class="">
                                <u>@Model.personModel.personDoB.ToString("MMM dd, yyyy")</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Gender:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personGender)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Provided ID:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personIDType)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                ID Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personIDNumber)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Record Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personRecordNumber)</u>
                            </dd>
                        </div>
                
                    </dl>
                </div>
        
                <div class="col-6 print-full-width">
                    <h4 class="fw-bold"><u>Contact & Address Info</u></h4>
                    <dl>
                        <div class="d-flex me-2">
                            <dt class="">
                                Phone Number:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personPhoneNumber)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Email:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.personEmailAddress)</u>
                            </dd>
                        </div>
                        <div class="d-flex me-2">
                            <dt class=" me-2">
                                Address:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.personModel.addressModel.addressFormatted)</u>
                            </dd>
                        </div>
                
                    </dl>
                </div>
            </div>
        </div>
    </div>

</div>
    
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.personModel.personID" class="btn btn-success m-2 d-print-none">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary me-2 d-print-none">Back to List</a>
    @if (Model.isPersonActiveEmployee)
    {
        <a asp-page="/Termination/Create" asp-route-item-id="@Model.personModel.personID" class="btn btn-danger m-2 d-print-none">Terminate Employment</a>
        <a asp-page="/Employment/Details" asp-route-item-id="@Model.personModel.personID" class="btn btn-info m-2 d-print-none">Employment Info</a>
    }
    else
    {
        <a asp-page="/Employment/Create" asp-route-item-id="@Model.personModel.personID" class="btn btn-primary m-2 d-print-none">Add To employment</a>
    }
    @await Html.PartialAsync("print")
</div>
<div class="">
    <h4 class="fw-bold">Person Record History</h4>
    <table class="table table-striped table-hover">
        <thead class="bg-info text-white">
            <tr>
                <td>Record ID</td>
                <td>First Name</td>
                <td>Fathers Name</td>
                <td>Last Name</td>
                <td>Date of Birth</td>
                <td>ID Type</td>
                <td>ID Number</td>
                <td>Phone Number</td>
                <td>Email</td>
                <td>Address</td>
            </tr>
        </thead>
        <tbody>
            @if (Model.personModel.PersonHistories.Any()){
            @foreach(var item in Model.personModel.PersonHistories)
            {
                <tr>
                    <td>@item.personID</td>
                    <td>@item.personFirstName</td>
                    <td>@item.personFatherName</td>
                    <td>@item.personLastName</td>
                    <td>@item.personDoB.ToString("MMM dd, yyyy")</td>
                    <td>@item.personIDType</td>
                    <td>@item.personIDNumber</td>
                    <td>@item.personPhoneNumber</td>
                    <td>@item.personEmailAddress</td>
                    <td>@item.addressModel.addressFormatted</td>
                </tr>
            }}
        </tbody>
    </table>
</div>
