@page
@using PIS2.Enums
@model PIS2.Pages.Person.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Person</h2>

<h6 class="fw-bold text-secondary">Add New Person Record</h6>
<hr />
<div class="row">
    <div>
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="d-flex">
                <div class="col-md-4 col-sm-12 me-4 card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="fw-bold">Personal Info.</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group col-">
                            <label asp-for="personModel.personFirstName" class="control-label">First Name</label>
                            <input asp-for="personModel.personFirstName" class="form-control" />
                            <span asp-validation-for="personModel.personFirstName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personFatherName" class="control-label">Fathers Name</label>
                            <input asp-for="personModel.personFatherName" class="form-control" />
                            <span asp-validation-for="personModel.personFatherName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personLastName" class="control-label">Last Name</label>
                            <input asp-for="personModel.personLastName" class="form-control" />
                            <span asp-validation-for="personModel.personLastName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personDoB" class="control-label">Date of Birth</label>
                            <input asp-for="personModel.personDoB" class="form-control" type="date" />
                            <span asp-validation-for="personModel.personDoB" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personGender" class="control-label">Gender</label>
                            <select asp-for="personModel.personGender" class="form-control" asp-items="Html.GetEnumSelectList<Gender>()"></select>
                            <span asp-validation-for="personModel.personGender" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personIDType" class="control-label">Provided ID</label>
                            <input asp-for="personModel.personIDType" class="form-control" />
                            <span asp-validation-for="personModel.personIDType" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="personModel.personIDNumber" class="control-label">ID Number</label>
                            <input asp-for="personModel.personIDNumber" class="form-control" />
                            <span asp-validation-for="personModel.personIDNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="personModel.personRecordNumber" class="control-label">Record Number</label>
                            <input asp-for="personModel.personRecordNumber" class="form-control" />
                            <span asp-validation-for="personModel.personRecordNumber" class="text-danger"></span>
                        </div>
                    </div>
                    
            
                    
                </div>
                <div class="col-md-5 col-sm-12 me-4 card shadow-sm">
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h5 class="fw-bold">Contact Info.</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label asp-for="personModel.personPhoneNumber" class="control-label">Phone Number</label>
                                <input asp-for="personModel.personPhoneNumber" class="form-control" />
                                <span asp-validation-for="personModel.personPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="personModel.personEmailAddress" class="control-label">Email</label>
                                <input asp-for="personModel.personEmailAddress" class="form-control" />
                                <span asp-validation-for="personModel.personEmailAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card shadow-sm mt-4">
                        <div class="card-header bg-dark text-white">
                            <h5 class="fw-bold">Address</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <span class="text-danger">*</span>
                                <label asp-for="addressModel.addressCountry" class="control-label">Country</label>
                                <select asp-for="addressModel.addressCountry" class="form-control" asp-items="Html.GetEnumSelectList<Country>()"></select>
                                <span asp-validation-for="addressModel.addressCountry" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Region</label>
                                <input class="form-control" id="regionInput" list="regionList" asp-for="addressModel.addressRegion" />
                                <datalist id="regionList"></datalist>
                            </div>

                            <div class="form-group">
                                <label>Zone</label>
                                <input class="form-control" id="zoneInput" list="zoneList" asp-for="addressModel.addressZone" />
                                <datalist id="zoneList"></datalist>
                            </div>

                            <div class="form-group">
                                <label>Woreda</label>
                                <input class="form-control" id="woredaInput" list="woredaList" asp-for="addressModel.addressWoreda" />
                                <datalist id="woredaList"></datalist>
                            </div>

                            <div class="form-group">
                                <label>Tabya</label>
                                <input class="form-control" id="tabyaInput" list="tabyaList" asp-for="addressModel.addressTabya" />
                                <datalist id="tabyaList"></datalist>
                            </div>

                        </div>
                    </div>
                   
                </div>
                
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        <h5 class="fw-bold">Upload Person Photo:</h5>
                    </div>
                    <div class="card-body">
                        <input type="file" id="imageUpload" name="Photo" accept="image/jpeg" onchange="previewImage(event)" />
                        <img id="preview" style="max-width:200px; display:none; margin-top:10px;" />
                    </div>
                    
                    
                </div>             
        
            </div>
            <div class="form-group mt-2 d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(event) {
            const reader = new FileReader();
            reader.onload = function () {
                const img = document.getElementById('preview');
                img.src = reader.result;
                img.style.display = 'block';
            };
            reader.readAsDataURL(event.target.files[0]);
        }
    </script>

    <script>
        async function loadSuggestions(level, inputId, listId) {

            const term = document.getElementById(inputId).value;
            const country = document.getElementById("addressModel_addressCountry").value;
            const region = document.getElementById("regionInput").value;
            const zone = document.getElementById("zoneInput").value;
            const woreda = document.getElementById("woredaInput").value;

            const url = `?handler=AddressSuggestions
                &level=${level}
                &country=${country}
                &region=${region}
                &zone=${zone}
                &woreda=${woreda}
                &term=${term}`;

            const res = await fetch(url);
            const data = await res.json();

            const list = document.getElementById(listId);
            list.innerHTML = "";

            data.forEach(x => {
                const opt = document.createElement("option");
                opt.value = x;
                list.appendChild(opt);
            });
        }

        document.getElementById("regionInput")
            .addEventListener("input", () => loadSuggestions("region","regionInput","regionList"));

        document.getElementById("zoneInput")
            .addEventListener("input", () => loadSuggestions("zone","zoneInput","zoneList"));

        document.getElementById("woredaInput")
            .addEventListener("input", () => loadSuggestions("woreda","woredaInput","woredaList"));

        document.getElementById("tabyaInput")
            .addEventListener("input", () => loadSuggestions("tabya","tabyaInput","tabyaList"));
    </script>
    
}
