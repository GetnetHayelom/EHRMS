@page
@model PIS2.Pages.Person.IndexModel
@{
    ViewData["Title"] = "Persons";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int No = (Model.CurrentPage - 1) * Model.PageSize;
}

@await Html.PartialAsync("headerSimple", "")

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0">Persons Directory</h2>
            <small class="text-muted">Employee & personnel records</small>
        </div>

        @if (User.IsInRole("MIE\\PMS_HRCLERK"))
        {
            <a asp-page="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Person
            </a>
        }
    </div>

    <!-- Summary Cards -->
    <div class="card shadow-sm p-2 m-2">
        <div class="row g-3">

        <div class="col-xl col-md-4">
            <div class="card h-100 shadow-sm border-start border-primary border-4">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Male</small>
                        <h4 class="fw-bold">@Model.personModel.Count(p => p.personGender == Models.Gender.Male)</h4>
                    </div>
                    <i class="bi bi-gender-male fs-2 text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-4">
            <div class="card h-100 shadow-sm border-start border-danger border-4">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Female</small>
                        <h4 class="fw-bold">@Model.personModel.Count(p => p.personGender == Models.Gender.Female)</h4>
                    </div>
                    <i class="bi bi-gender-female fs-2 text-danger"></i>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-4">
            <div class="card h-100 shadow-sm border-start border-info border-4">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Total</small>
                        <h4 class="fw-bold">@Model.personModel.Count</h4>
                    </div>
                    <i class="bi bi-people fs-2 text-info"></i>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-4">
            <div class="card h-100 shadow-sm border-start border-success border-4">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Active</small>
                        <h4 class="fw-bold">@Model.Employed</h4>
                    </div>
                    <i class="bi bi-check-circle fs-2 text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-4">
            <div class="card h-100 shadow-sm border-start border-warning border-4">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small class="text-muted">Ex-Employee</small>
                        <h4 class="fw-bold">@Model.xEmployed</h4>
                    </div>
                    <i class="bi bi-person-x fs-2 text-warning"></i>
                </div>
            </div>
        </div>

    </div>
    </div>

    <!-- Tools -->
    <div class="card shadow-sm p-2 d-print-none m-2">
        <div class="d-flex justify-content-between align-items-center gap-2">
            <div><h6 class="fw-bold">Persons Catalog</h6></div>
            <div class="d-flex justify-content-end">
                <div class="me-2">@await Html.PartialAsync("filter")</div>
                <div>@await Html.PartialAsync("print")</div>
                <div class=""><excel-export table="dataTable" filename="Persons_Report_@DateTime.UtcNow:yyyyMMdd.xlsx"></excel-export></div>               
            </div>
            
        </div>
    </div>
    <!-- Table -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="dataTable">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Full Name</th>
                        <th>DOB</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>File No</th>
                        <th>Email</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.personModel)
                    {
                        No++;
                        <tr>
                            <td>@No</td>
                            <td class="fw-semibold">@item.personFullName</td>
                            <td>@item.personDoB.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-secondary">@item.personGender</span>
                            </td>
                            <td>@item.personPhoneNumber</td>
                            <td>@item.personRecordNumber</td>
                            <td>@item.personEmailAddress</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-page="./Details" asp-route-id="@item.personID" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@item.personID" class="btn btn-sm btn-outline-success" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
