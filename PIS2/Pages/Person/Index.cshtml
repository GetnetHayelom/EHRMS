@page
@model PIS2.Pages.Person.IndexModel

@{
    ViewData["Title"] = "Pereson";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int No = 0;
}

<h1 class="fw-bold">Person</h1>
@if(User.IsInRole("MIE\\PMS_HRCLERK"))
{
    <p>
        <a asp-page="Create" class="btn btn-primary d-print-none">Add New Person</a>
    </p>
}
<div class="d-flex justify-content-between">
    
    <p class="fw-bold">Male=<u>@Model.personModel.Count(p => p.personGender == Models.Gender.Male)</u></p>
    <p class="fw-bold">Female=<u>@Model.personModel.Count(p => p.personGender == Models.Gender.Female)</u></p>
    <p class="fw-bold">Total=<u>@Model.personModel.Count()</u></p>
    <p class="fw-bold">Active Employee=<u>@Model.Employed</u></p>
    <p class="fw-bold">Ex-Employee=<u>@Model.xEmployed</u></p>
    <p class="fw-bold">Others=<u>@(Model.personModel.Count() - Model.Employed - Model.xEmployed)</u></p>
</div>
<hr />
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("filter")
    @await Html.PartialAsync("print")
</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
        <th>No</th>    
        <th>
                Full Name
            </th>
            
            <th>
                Date of Birth
            </th>
            <th>
                Gender
            </th>
           
            <th>
                Phone Number
            </th>
            <th>
                File Number
            </th>
            
            <th>
                Email
            </th>
            
        </tr>
    </thead>
    <tbody>
        <div class="d-none">@(No = (Model.CurrentPage - 1) * (Model.PageSize))</div>
@foreach (var item in Model.personModel) {
            No++;
            <tr onclick="location.href='@Url.Page("Details", new {id =item.personID})'" style="cursor:pointer;">
            <td>@No</td>
            <td>
                @Html.DisplayFor(modelItem => item.personFullName)
            </td>
            <td>
                @item.personDoB.ToString("MM/dd/yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personGender)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.personPhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personRecordNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personEmailAddress)
            </td>
            
        </tr>
}
    </tbody>
</table>

