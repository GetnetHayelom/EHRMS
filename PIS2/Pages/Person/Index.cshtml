@page
@model PIS2.Pages.Person.IndexModel

@{
    ViewData["Title"] = "Pereson";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int No = 0;
}
@await Html.PartialAsync("headerSimple", "")
<div class="container-fluid mt-3">
<h1 class="fw-bold">Person</h1>
@if(User.IsInRole("MIE\\PMS_HRCLERK"))
{
    <p>
        <a asp-page="Create" class="btn btn-primary d-print-none">Add New Person</a>
    </p>
}
<!-- PERSON SUMMARY POINTS -->
<div class="d-flex gap-3 mb-4 d-print-flex flex-wrap">

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-primary border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Male</small>
                    <h3 class="fw-bold mb-0"><u>@Model.personModel.Count(p => p.personGender == Models.Gender.Male)</u></h3>
                </div>
                <div><i class="bi bi-gender-male fs-2 text-primary"></i></div>
            </div>
        </div>
    </div>

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-danger border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Female</small>
                    <h3 class="fw-bold mb-0"><u>@Model.personModel.Count(p => p.personGender == Models.Gender.Female)</u></h3>
                </div>
                <div><i class="bi bi-gender-female fs-2 text-danger"></i></div>
            </div>
        </div>
    </div>

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-info border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Total</small>
                    <h3 class="fw-bold mb-0"><u>@Model.personModel.Count()</u></h3>
                </div>
                <div><i class="bi bi-people fs-2 text-info"></i></div>
            </div>
        </div>
    </div>

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-success border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Active Employee</small>
                    <h3 class="fw-bold mb-0"><u>@Model.Employed</u></h3>
                </div>
                <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
            </div>
        </div>
    </div>

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-warning border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Ex-Employee</small>
                    <h3 class="fw-bold mb-0"><u>@Model.xEmployed</u></h3>
                </div>
                <div><i class="bi bi-person-x fs-2 text-warning"></i></div>
            </div>
        </div>
    </div>

    <div class="flex-fill">
        <div class="card shadow-sm border-start border-secondary border-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted">Others</small>
                    <h3 class="fw-bold mb-0"><u>@(Model.personModel.Count() - Model.Employed - Model.xEmployed)</u></h3>
                </div>
                <div><i class="bi bi-question-circle fs-2 text-secondary"></i></div>
            </div>
        </div>
    </div>

</div>

<hr />
<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("filter")
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Persons_Report_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
        <th>No</th>    
        <th>
                Full Name
            </th>
            
            <th>
                Date of Birth
            </th>
            <th>
                Gender
            </th>
           
            <th>
                Phone Number
            </th>
            <th>
                File Number
            </th>
            
            <th>
                Email
            </th>
            
        </tr>
    </thead>
    <tbody>
        <div class="d-none">@(No = (Model.CurrentPage - 1) * (Model.PageSize))</div>
@foreach (var item in Model.personModel) {
            No++;
            <tr onclick="location.href='@Url.Page("Details", new {id =item.personID})'" style="cursor:pointer;">
            <td>@No</td>
            <td>
                @Html.DisplayFor(modelItem => item.personFullName)
            </td>
            <td>
                @item.personDoB.ToString("MM/dd/yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personGender)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.personPhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personRecordNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personEmailAddress)
            </td>
            
        </tr>
}
    </tbody>
</table>
</div>

