@page
@model PIS2.Pages.Person.IndexModel

@{
    ViewData["Title"] = "Pereson";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int No = 0;
}

<h1 class="fw-bold">Person</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Person</a>
</p>


@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
        <th>No</th>    
        <th>
                Full Name
            </th>
            
            <th>
                Date of Birth
            </th>
            <th>
                Gender
            </th>
           
            <th>
                Phone Number
            </th>
            <th>
                File Number
            </th>
            
            <th>
                Email
            </th>
            
        </tr>
    </thead>
    <tbody>
        <div class="d-none">@(No = (Model.CurrentPage - 1) * (Model.PageSize))</div>
@foreach (var item in Model.personModel) {
            No++;
            <tr onclick="location.href='@Url.Page("Details", new {id =item.personID})'" style="cursor:pointer;">
            <td>@No</td>
            <td>
                @Html.DisplayFor(modelItem => item.personFullName)
            </td>
            <td>
                @item.personDoB.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personGender)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.personPhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personRecordNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personEmailAddress)
            </td>
            
        </tr>
}
    </tbody>
</table>

