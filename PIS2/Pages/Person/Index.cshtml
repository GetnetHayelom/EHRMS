@page
@model PIS2.Pages.Person.IndexModel

@{
    ViewData["Title"] = "Pereson";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int No = 0;
}

<h1>Person List</h1>

<p>
    <a asp-page="Create">Add New Person</a>
</p>
<div>
    <!-- Pagination Controls -->
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="./Index" asp-route-id="@(Model.CurrentPage - 1)" class="btn btn-primary">Previous</a>
    }

    <span>Page @Model.CurrentPage of @Model.TotalPages</span>

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="./Index" asp-route-id="@(Model.CurrentPage + 1)" class="btn btn-primary">Next</a>
    }
</div>

@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
        <th>No</th>    
        <th>
                Full Name
            </th>
            
            <th>
                Date of Birth
            </th>
            <th>
                Gender
            </th>
           
            <th>
                Phone Number
            </th>
            <th>
                File Number
            </th>
            
            <th>
                Email
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <div class="d-none">@(No = (Model.CurrentPage - 1) * (Model.PageSize))</div>
@foreach (var item in Model.personModel) {
            No++;
            <tr>
            <td>@No</td>
            <td>
                @Html.DisplayFor(modelItem => item.personFullName)
            </td>
            <td>
                @item.personDoB.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personGender)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.personPhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personRecordNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personEmailAddress)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.personID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.personID">Details</a> |
                <a asp-page="~/Employment/Create" asp-route-id="@item.personID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <!-- Pagination Controls -->
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="./Index" asp-route-id="@(Model.CurrentPage - 1)" class="btn btn-primary">Previous</a>
    }

    <span>Page @Model.CurrentPage of @Model.TotalPages</span>

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="./Index" asp-route-id="@(Model.CurrentPage + 1)" class="btn btn-primary">Next</a>
    }
</div>
<div>
    <!-- Page Numbers -->
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a asp-page="./Index" asp-route-id="@i" class="btn btn-sm @(i == Model.CurrentPage ? "btn-primary" : "btn-light")">
            @i
        </a>
    }
</div>
