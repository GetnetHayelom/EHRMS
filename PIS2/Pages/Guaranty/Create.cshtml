@page
@using PIS2.Enums
@model PIS2.Pages.Guaranty.CreateModel

@{
    ViewData["Title"] = "Guaranty";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}

<h2 class="fw-bold">Guaranty</h2>
<p class="text-muted">Guaranty request form</p>

<hr />
<div class="d-flex gap-4">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (User.IsInRole("HRPERSONNEL"))
            {
                
                <!-- Selector -->
                <div class="form-group">
                    <label asp-for="guarantyModel.employmentID" class="form-label fw-semibold">
                        <span class="text-danger">*</span> Employee
                    </label>
                    <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.Employee?.givenID @Model.Employee?.personModel?.personFullName"/>
                    <input type="hidden" asp-for="guarantyModel.employmentID" id="personIDHidden" value="@Model.Employee?.employmentID"/>
                    <datalist id="personList">
                        @foreach (var person in Model.Employments)
                        {
                            <option data-id="@person.Value" value="@person.Text"></option>
                        }
                    </datalist>
                    <span asp-validation-for="guarantyModel.employmentID" class="text-danger"></span>
                </div>
            }
            
            
            <div class="form-group">
                <label asp-for="guarantyModel.guarantyStartDate" class="control-label">Guaranty Start Date</label>
                <input asp-for="guarantyModel.guarantyStartDate" class="form-control mb-2" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="guarantyModel.guarantyStartDate" class="text-danger"></span>
            </div>
            @if (User.IsInRole("HRPERSONNEL"))
            {
                   <div class="form-group">
                    <label asp-for="guarantyModel.guarantyEndDate" class="control-label">Guaranty End Date</label>
                    <input asp-for="guarantyModel.guarantyEndDate" class="form-control mb-2" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="guarantyModel.guarantyEndDate" class="text-danger"></span>
                </div>
            
                <div class="form-group">
                    <label asp-for="guarantyModel.guarantyAmount" class="control-label">Guaranty Amount</label>
                    <input asp-for="guarantyModel.guarantyAmount" class="form-control mb-2" />
                    <span asp-validation-for="guarantyModel.guarantyAmount" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <label asp-for="guarantyModel.guarantyType" class="control-label">Guaranty Type</label>
                <select asp-for="guarantyModel.guarantyType" class="form-control mb-2" asp-items="Html.GetEnumSelectList<Enums.GuarantyTypes>()"></select>
                <span asp-validation-for="guarantyModel.guarantyType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="guarantyModel.guarantyFor" class="control-label">Guarantee Name</label>
                <input asp-for="guarantyModel.guarantyFor" class="form-control mb-2"/>
                <span asp-validation-for="guarantyModel.guarantyFor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="guarantyModel.guarantyBeneficiary" class="control-label">Beneficiary Name</label>
                <input asp-for="guarantyModel.guarantyBeneficiary" class="form-control mb-2" />
                <span asp-validation-for="guarantyModel.guarantyBeneficiary" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>
   
    <div class="card shadow-sm p-2 flex-fill">
        <table class="table table-striped table-hover print-full-width">
            <thead class="bg-dark text-white">
                <tr>

                    <th>
                        Guaranty Start Date
                    </th>
                    <th>
                        Guaranty End Date
                    </th>
                    <th>
                        Guaranty Amount
                    </th>
                    <th>
                        Guaranty Type
                    </th>
                    <th>
                        Guarantee
                    </th>
                    <th>
                        Beneficiary
                    </th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.GuarantyStatus)
                {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.guarantyID })'" style="cursor:pointer;" )>

                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyStartDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyEndDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyAmount)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyType)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyFor)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.guarantyBeneficiary)
                        </td>
                        @{
                            string bg_color;
                            if (item.guarantyStatus == mainStatus.Suspended)
                            {
                                bg_color = "bg-warning text-black";
                            }
                            else if (item.guarantyStatus == mainStatus.Active)
                            {
                                bg_color = "bg-success text-white";
                            }
                            else
                            {
                                bg_color = "bg-grey text-black";
                            }
                        }
                        <td class="@bg_color">
                            @Html.DisplayFor(modelItem => item.guarantyStatus)
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-page="Index">View All Guaranty</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
