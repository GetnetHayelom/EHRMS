@page
@model PIS2.Pages.Guaranty.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Guaranty</h1>

<div>
    <h4>Guaranty Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.Employment.givenID)
        </dd>
        <dt class="col-sm-2">
            Start Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyStartDate)
        </dd>
        <dt class="col-sm-2">
            End Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyEndDate)
        </dd>
        <dt class="col-sm-2">
            Amount:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyAmount)
        </dd>
        <dt class="col-sm-2">
            Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyType)
        </dd>
        <dt class="col-sm-2">
            Guarantee:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyFor)
        </dd>
        <dt class="col-sm-2">
            Beneficiary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyBeneficiary)
        </dd>
        <dt class="col-sm-2">
            Status;
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.guarantyModel.guarantyStatus)
        </dd>
    </dl>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.guarantyModel.guarantyID" class="btn btn-primary m-2">@L.T("Edit")</a>
    <a asp-page="./Delete" asp-route-id="@Model.guarantyModel.guarantyID" class="btn btn-danger m-2">Delete</a>
</div>
<a asp-page="./Index">View All Guaranty</a>