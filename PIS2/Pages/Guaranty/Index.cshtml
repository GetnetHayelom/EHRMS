@page
@model PIS2.Pages.Guaranty.IndexModel

@{
    ViewData["Title"] = "Guaranty Records";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Guaranty</h1>
<h4 class="fw-bold">Guaranty Records</h4>
<hr />
<p>
    <a asp-page="Create" class="btn btn-primary text-decoration-none text-white">Add New</a>
</p>
<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Guaranty Start Date
            </th>
            <th>
                Guaranty End Date
            </th>
            <th>
                Guaranty Amount
            </th>
            <th>
                Guaranty Type
            </th>
            <th>
                Guarantee
            </th>
            <th>
                Beneficiary
            </th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.guarantyModel) {
            <tr onclick="location.href='@Url.Page("Details", new { id = item.guarantyID })'" style="cursor:pointer;" )>
            <td>
                @Html.DisplayFor(modelItem => item.Employment.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyFor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.guarantyBeneficiary)
            </td>
                @{
                    string bg_color;
                    if (item.guarantyStatus == Models.mainStatus.Suspended)
                    {
                        bg_color = "bg-warning text-black";
                    }else if(item.guarantyStatus == Models.mainStatus.Active)
                    {
                        bg_color = "bg-success text-white";
                    }
                    else
                    {
                        bg_color = "bg-grey text-black";
                    }
                }
                <td class="@bg_color">
                @Html.DisplayFor(modelItem => item.guarantyStatus)
            </td>
            
        </tr>
}
    </tbody>
</table>
