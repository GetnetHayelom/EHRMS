@page
@using PIS2.Enums
@model PIS2.Pages.Guaranty.EditModel

@{
    ViewData["Title"] = "Edit Guaranty";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@{
    bool isReadOnly = !(Model.isSelf &&
                        Model.guarantyModel.guarantyStatus == mainStatus.Suspended);
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="fw-bold text-dark">@L.T("Edit") Guaranty</h1>
    <p class="text-muted mb-0">@L.T("Update") guaranty details for the selected employee</p>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="guarantyModel.guarantyID" />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="guarantyModel.employmentID" class="form-label fw-semibold">Employment ID</label>
                            <input asp-for="guarantyModel.employmentID" class="form-control" readonly hidden/>
                            <input class="form-control" readonly value="@Model.employmentModel.givenID"/>
                            <span asp-validation-for="guarantyModel.employmentID" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="guarantyModel.guarantyType" class="form-label fw-semibold">Guaranty Type</label>
                            <select asp-for="guarantyModel.guarantyType" class="form-control" asp-items="@Html.GetEnumSelectList<Enums.GuarantyTypes>()" readonly="@isReadOnly"></select>
                            <span asp-validation-for="guarantyModel.guarantyType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="guarantyModel.guarantyStartDate" class="form-label fw-semibold">Start</label>
                            <input asp-for="guarantyModel.guarantyStartDate" class="form-control" type="date" readonly="@isReadOnly" />
                            <span asp-validation-for="guarantyModel.guarantyStartDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="guarantyModel.guarantyEndDate" class="form-label fw-semibold">End</label>
                            <input asp-for="guarantyModel.guarantyEndDate" class="form-control" type="date" readonly="@isReadOnly" />
                            <span asp-validation-for="guarantyModel.guarantyEndDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="guarantyModel.guarantyAmount" class="form-label fw-semibold">Amount</label>
                            <input asp-for="guarantyModel.guarantyAmount" class="form-control" readonly="@isReadOnly" />
                            <span asp-validation-for="guarantyModel.guarantyAmount" class="text-danger"></span>
                        </div>
                        @if (User.IsInRole("HRPERSONNEL"))
                        {
                            <div class="col-md-6">
                                <label asp-for="guarantyModel.guarantyStatus" class="form-label fw-semibold">Status</label>
                                <select asp-for="guarantyModel.guarantyStatus"
                                        class="form-select"
                                        asp-items="@Html.GetEnumSelectList<mainStatus>()">
                                </select>
                                <span asp-validation-for="guarantyModel.guarantyStatus" class="text-danger"></span>
                            </div>
                        }
                        

                        <div class="col-12">
                            <label asp-for="guarantyModel.guarantyFor" class="form-label fw-semibold">Guaranty For</label>
                            <input asp-for="guarantyModel.guarantyFor" class="form-control" readonly="@isReadOnly" />
                            <span asp-validation-for="guarantyModel.guarantyFor" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="guarantyModel.guarantyBeneficiary" class="form-label fw-semibold">Beneficairy</label>
                            <input asp-for="guarantyModel.guarantyBeneficiary" class="form-control" readonly="@isReadOnly" />
                            <span asp-validation-for="guarantyModel.guarantyBeneficiary" class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            ← Back to List
                        </a>

                        <button type="submit" class="btn btn-primary px-4">
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
