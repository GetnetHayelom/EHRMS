@page
@model PIS2.Pages.Holiday.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Holiday Details</h1>

<div>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayName)
        </dd>
        <dt class="col-sm-2">
            Type: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayType)
        </dd>
        <dt class="col-sm-2">
            Start: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayStart)
        </dd>
        <dt class="col-sm-2">
            End: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayEnd)
        </dd>
        <dt class="col-sm-2">
            Cycle: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayCycle)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.holidayModel.holidayID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
