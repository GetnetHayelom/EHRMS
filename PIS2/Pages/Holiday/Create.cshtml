@page
@using PIS2.Enums
@model PIS2.Pages.Holiday.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Holiday</h1>
<h4 class="fw-bold">New Holiday</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="holidayModel.holidayName" class="control-label">Name</label>
                <input asp-for="holidayModel.holidayName" class="form-control" />
                <span asp-validation-for="holidayModel.holidayName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="holidayModel.holidayType" class="control-label">Type</label>
                <input asp-for="holidayModel.holidayType" class="form-control" />
                <span asp-validation-for="holidayModel.holidayType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="holidayModel.holidayStart" class="control-label">Start</label>
                <input asp-for="holidayModel.holidayStart" class="form-control" type="date" />
                <span asp-validation-for="holidayModel.holidayStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="holidayModel.holidayEnd" class="control-label">End</label>
                <input asp-for="holidayModel.holidayEnd" class="form-control" type="date" />
                <span asp-validation-for="holidayModel.holidayEnd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="holidayModel.holidayCycle" class="control-label">Cycle</label>
                <input asp-for="holidayModel.holidayCycle" class="form-control" />
                <span asp-validation-for="holidayModel.holidayCycle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="holidayModel.holidayStatus" class="control-label">Status</label>
                <select asp-for="holidayModel.holidayStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="holidayModel.holidayStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Save" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Holidays</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
