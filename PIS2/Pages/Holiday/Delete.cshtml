@page
@model PIS2.Pages.Holiday.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Delete Holiday</h1>

<h3>Are you sure you want to delete this holiday?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayName)
        </dd>
        <dt class="col-sm-2">
            Type: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayType)
        </dd>
        <dt class="col-sm-2">
            Start: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayStart)
        </dd>
        <dt class="col-sm-2">
            End: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayEnd)
        </dd>
        <dt class="col-sm-2">
            Cycle: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayCycle)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.holidayModel.holidayStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="holidayModel.holidayID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
