@page
@model PIS2.Pages.Holiday.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">Holidays</h2>

        <p class="d-print-none">
            <a asp-page="Create" class="btn btn-primary">Add New Holiday</a>
        </p>
    </div>
    <div class="d-flex justify-content-end d-print-none">
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>


<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Holiday Name
            </th>
            <th>
               Type
            </th>
            <th>
                Start
            </th>
            <th>
                End
            </th>
            <th>
                Cycle
            </th>
            <th>
                Staus
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.holidayModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.holidayName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.holidayType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.holidayStart)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.holidayEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.holidayCycle)
            </td>
            <td>
                    @if (item.holidayStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.holidayStatus)</span>

                    }
                    else if (item.holidayStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.holidayStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.holidayStatus)</span>
                    }
            </td>
               
                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.holidayID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.holidayID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">

    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
