@page
@model PIS2.Pages.LoyaltyHistory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.loyaltyHistoryModel[0].employmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.loyaltyHistoryModel[0].loyaltyModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.loyaltyHistoryModel[0].loyaltyAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.loyaltyHistoryModel[0].loyaltyHistoryStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.loyaltyHistoryModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyModel.loyaltyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.loyaltyHistoryStatus)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.loyaltyHistoryID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.loyaltyHistoryID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.loyaltyHistoryID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
