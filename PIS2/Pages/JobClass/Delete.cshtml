@page
@model PIS2.Pages.JobClass.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Classes</h1>

<h3>Are you sure you want to delete this job class?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Job Class Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassName)
        </dd>
        <dt class="col-sm-2">
            Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassDescription)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="jobClassModel.jobClassId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
