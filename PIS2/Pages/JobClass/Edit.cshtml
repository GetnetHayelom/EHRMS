@page
@model PIS2.Pages.JobClass.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Job Classes</h2>

<p class="text-muted">Update Job Class</p>
<hr />
<div class="row">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="jobClassModel.jobClassId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobClassModel.jobClassName" class="control-label">Job Class Name</label>
                <input asp-for="jobClassModel.jobClassName" class="form-control" />
                <span asp-validation-for="jobClassModel.jobClassName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobClassModel.jobClassDescription" class="control-label">Description</label>
                <input asp-for="jobClassModel.jobClassDescription" class="form-control" />
                <span asp-validation-for="jobClassModel.jobClassDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobClassModel.jobClassStatus" class="control-label">Status</label>
                <select asp-for="jobClassModel.jobClassStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="jobClassModel.jobClassStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                @await Html.PartialAsync("back")
                <input type="submit" value="Update" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div>
   
    <a asp-page="./Index">View All Job Classes</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
