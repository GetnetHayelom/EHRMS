@page
@model PIS2.Pages.JobClass.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Classes</h1>

<h4>Edit Job Class</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="jobClassModel.JobClassId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobClassModel.JobClassName" class="control-label">Job Class Name</label>
                <input asp-for="jobClassModel.JobClassName" class="form-control" />
                <span asp-validation-for="jobClassModel.JobClassName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobClassModel.JobClassDescription" class="control-label">Description</label>
                <input asp-for="jobClassModel.JobClassDescription" class="form-control" />
                <span asp-validation-for="jobClassModel.JobClassDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobClassModel.JobClasStatus" class="control-label">Status</label>
                <select asp-for="jobClassModel.JobClasStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="jobClassModel.JobClasStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
