@page
@model PIS2.Pages.JobClass.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Classes</h1>

<div>
    <h4>Job Class Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Job Class Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassName)
        </dd>
        <dt class="col-sm-2">
            Description
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassDescription)
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobClassModel.jobClassStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.jobClassModel.jobClassId">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
