@page
@using PIS2.Enums
@model PIS2.Pages.JobClass.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold mb-0">Job Classes</h2>

        <p class="text-muted mb-0">
            Job classes catalog
        </p>
    </div>
    <div class="card shadow-sm m-1">
        <div class="d-flex justify-content-end d-print-none">
            <form method="get" class="d-flex align-items-end">
                <label class="form-label fw-bold m-2">Status</label>
                <select asp-for="JobClassStatus" class="form-control m-2" asp-items="@Html.GetEnumSelectList<mainStatus>()" onchange="this.form.submit()">
                    <option value="" selected> All</option>
                </select>
            </form>
            <div class="me-2">@await Html.PartialAsync("filter")</div>
            @await Html.PartialAsync("print")
            <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
            <a asp-page="Create" class="btn btn-primary m-2"><i class=bi bi-plus-circle"></i> New Job Class</a>
        </div>
    </div>
    
</div>


<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>S/N</th>
            <th>
                Job Class Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int sn = 1;
        }
        @foreach (var item in Model.jobClassModel)
        {
            <tr>
                <td>@sn</td>
                <td>
                    @Html.DisplayFor(modelItem => item.jobClassName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.jobClassDescription)
                </td>
                <td>
                    @if (item.jobClassStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobClassStatus)</span>

                    }
                    else if (item.jobClassStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobClassStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobClassStatus)</span>
                    }
                </td>
                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.jobClassId" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.jobClassId" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>

                </td>
            </tr>
            sn++;
        }
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
