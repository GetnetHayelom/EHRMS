@page
@model PIS2.Pages.JobClass.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Classes</h1>

<p>
    <a asp-page="Create">Add New Job Class</a>
</p>
@await Html.PartialAsync("filter")
@await Html.PartialAsync("print")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Job Class Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.jobClassModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.JobClassName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobClassDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobClasStatus)
            </td>
            <td class="d-print-none">
                <a asp-page="./Edit" asp-route-id="@item.JobClassId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.JobClassId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.JobClassId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
