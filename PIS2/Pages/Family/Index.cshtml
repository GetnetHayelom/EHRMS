@page
@model PIS2.Pages.Family.IndexModel

@{
    ViewData["Title"] = "Family Relations";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
    <h1 class="fw-bold text-dark">Family and Relations</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New
    </a>
</div>
<!--CALL TO ACTION-->
<div class="card p-2 mb-2 shadow-sm">
    <div class="d-flex justify-content-end d-print-none">
        <div class="mx-2">@await Html.PartialAsync("filter")</div>
        <div class="mx-2">@await Html.PartialAsync("print")</div>
        <div class="mx-2"><excel-export table="dataTable" filename="Family_Relations_@(DateTime.UtcNow).xlsx"></excel-export></div>
    </div>
</div>
<!-- Family Table -->
<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle" id="dataTable">
        <thead class="table-dark">
            <tr>
                <th>Person Name</th>
                <th>Family/Relative</th>
                <th>Relation</th>
                <th>Modified By</th>
                <th>Modified Date</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.familyModel)
            {
                <tr>
                    <td>@item.personModel?.personFullName</td>
                    <td>@item.personModel2?.personFullName</td>
                    <td>@item.relation</td>
                    <td>@item.modifiedBy</td>
                    <td>@item.modifiedDate.ToString("MM/dd/yyyy HH:mm")</td>
                    <td class="text-center">
                        <a asp-page="./Edit" asp-route-id="@item.familyID" class="btn btn-sm btn-primary me-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-page="./Details" asp-route-id="@item.familyID" class="btn btn-sm btn-info me-1 text-white" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Delete" asp-route-id="@item.familyID" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this relation?');">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
