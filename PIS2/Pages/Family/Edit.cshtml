@page
@model PIS2.Pages.Family.EditModel

@{
    ViewData["Title"] = "Edit Family Relation";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="fw-bold text-dark">Edit Family Relation</h1>
    <p class="text-muted mb-0">Update the selected family relation details</p>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="familyModel.familyID" />

                    <!-- Person -->
                    <div class="mb-3">
                        <label asp-for="familyModel.personID" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Person
                        </label>
                        <input type="text" class="form-control" value="@Model.familyModel?.personModel?.personFullName" readonly/>
                        <input type="hidden" asp-for="familyModel.personID" id="personIDHidden" />
                        
                        <span asp-validation-for="familyModel.personID" class="text-danger"></span>
                    </div>

                    <!-- Relative -->
                    <div class="mb-3">
                        <label asp-for="familyModel.personID2" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Relative
                        </label>
                        <input type="text" class="form-control"  value="@Model.familyModel.personModel2.personFullName" list="personList2" placeholder="Type to search..." oninput="selector(this, 'personID2Hidden')" />
                        <input type="hidden" asp-for="familyModel.personID2" id="personID2Hidden" />
                        <datalist id="personList2">
                            @foreach (var person in (SelectList)ViewData["personID"])
                            {
                                <option data-id="@person.Value" value="@person.Text"></option>
                            }
                        </datalist>
                        <span asp-validation-for="familyModel.personID2" class="text-danger"></span>
                    </div>

                    <!-- Relation -->
                    <div class="mb-3">
                        <label asp-for="familyModel.relation" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Relation
                        </label>
                        <select asp-for="familyModel.relation" class="form-select" asp-items="@Html.GetEnumSelectList<Enums.familyRelation>()"></select>
                        <span asp-validation-for="familyModel.relation" class="text-danger"></span>
                    </div>

                    <!-- Modified By / Date -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="familyModel.modifiedBy" class="form-label fw-semibold">Modified By</label>
                            <input asp-for="familyModel.modifiedBy" class="form-control" readonly />
                            <span asp-validation-for="familyModel.modifiedBy" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="familyModel.modifiedDate" class="form-label fw-semibold">Modified Date</label>
                            <input asp-for="familyModel.modifiedDate" class="form-control" readonly />
                            <span asp-validation-for="familyModel.modifiedDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end mt-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary me-2">← Back to List</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Match typed text to datalist and set hidden input
        function setPersonID(input, hiddenId) {
            const value = input.value;
            const datalist = input.getAttribute('list');
            const options = document.querySelectorAll(`#${datalist} option`);
            let found = false;
            options.forEach(opt => {
                if (opt.value === value) {
                    document.getElementById(hiddenId).value = opt.dataset.id;
                    found = true;
                }
            });
            if (!found) {
                document.getElementById(hiddenId).value = '';
            }
        }
    </script>
}
