@page
@{
    ViewData["Title"] = "Transport Service Request";
}
@await Html.PartialAsync("headerSimple", "WF/HRM/32")

<div class="container p-4 bg-white">

    <!-- Title + Form Number -->
    <div class="d-flex justify-content-between">
        <div class="fw-bold"><h4 class="fw-bold">ናይ መኪና መሕተቲ ቅጥዒ (Transport Service Request Format)</h4></div>
    </div>

    <hr />

    <!-- Fields 1–6 -->
    <h6 class="fw-bold">ሽም ተጓዓዛይ/ዝቲ</h6>
    <div class="d-flex gap-3 flex-wrap d-print-flex mb-3">
        <div class="col-3">
            <label class="form-label">1</label>
            <input class="form-control" />
        </div>
        <div class="col-3">
            <label class="form-label">2</label>
            <input class="form-control" />
        </div>

        <div class="col-3">
            <label class="form-label">3</label>
            <input class="form-control" />
        </div>
        <div class="col-3">
            <label class="form-label">4</label>
            <input class="form-control" />
        </div>

        <div class="col-3">
            <label class="form-label">5</label>
            <input class="form-control" />
        </div>
        <div class="col-3">
            <label class="form-label">6</label>
            <input class="form-control" />
        </div>
    </div>

    <!-- Middle Section -->
    <div class="d-flex d-print-flex flex-wrap gap-3 mt-2">

        <div class="col-4">
            <label class="form-label">ዝኸደሉ ቦታ</label>
            <input class="form-control" />
        </div>

        <div class="col-6">
            <label class="form-label">ዋኒን</label>
            <input class="form-control" />
        </div>
        <div class="col-4">
            <label class="form-label">ዓይነት መኪና</label>
            <input class="form-control" />
        </div>
        <div class="col-6 d-flex d-print-flex gap-3">
            <div class="col-6">
                <label class="form-label">ካብ</label>
                <input class="form-control" />
            </div>

            <div class="col-6">
                <label class="form-label">ክሳብ</label>
                <input class="form-control" />
            </div>



        </div>
    </div>
  
    

    <!-- Signatures Section -->
    <div class="row mt-4">
        <div class="col-6">
            <div class="fw-bold mb-1">ፈቓዲ ሓላፊ</div>
            <div class="border-bottom border-2"></div>
            <div class="mt-1">ሽም</div>
            <input class="form-control mt-1" placeholder="Name" />
            <label class="mt-2">ፊርማን ዕለትን</label>
            <input class="form-control" />
        </div>

        <div class="col-6">
            <div class="fw-bold mb-1">ጀነራል ሰርቪስ</div>
            <div class="border-bottom border-2"></div>
            <div class="mt-1">ሽም</div>
            <input class="form-control mt-1" placeholder="Name" />
            <label class="mt-2">ፊርማን ዕለትን</label>
            <input class="form-control" />
        </div>
    </div>

    <div class="d-flex d-print-flex gap-3">
        <!-- Additional Fields -->
        <div class="col-6 mt-4">

            <div class="col-12">
                <label class="form-label">ዝተመደበት መኪና</label>
                <input class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">ቑፅሪ ሰሌዳ</label>
                <input class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">መ/መኪና ሽም</label>
                <input class="form-control" />
            </div>



        </div>

        <!-- Final Section -->
        <div class="col-6 mt-4 border-1">
            <div class="col-12">
                <label class="form-label fw-bold">ንናይ ፊልድ መኪና ጥራይ</label>

            </div>
            <div class="">
                <div class="col-12">
                    <div class="col-12">
                        <label class="form-label">መበገሲ ቦታን ዕለትን</label>
                        <input class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">ንባብ ኪ/ሜትር ኣብ መበገሲ ግዘ</label>
                        <input class="form-control" />
                    </div>
                </div>



                <div class="d-flex d-print-flex gap-3">
                    <div class="col-6">
                        <label class="form-label">ዝተመለሰሉ ዕለት</label>
                        <input type="text" class="form-control" />
                    </div>

                    <div class="col-6">
                        <label class="form-label">ምስተመለሰ ንባብ ኪ/ሜትር</label>
                        <input class="form-control" />
                    </div>
                </div>
            </div>



        </div>
    </div>
    

    <!-- Footer -->
    <div class="d-flex justify-content-between mt-4">
        <div>REVISION-05 / ISSUE-01</div>
    </div>

    <div class="mt-2 text-muted small">
        PLEASE MAKE SURE THAT THIS IS THE CORRECT ISSUE BEFORE USE
    </div>

</div>
<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("print")
    @await Html.PartialAsync("back")
</div>

