@page
@model PIS2.Pages.Forms.PISAccessModel
@{
    ViewData["Title"] = "PIS Access Privilege Request";
}
@{
    string formNo = "WF/ICT/02";
}
<partial name="headerSimple" model="formNo" />
<style>
    @@page{
        size:A4 portrait;
        margin: 1cm;
    }
    @@media print{
        /* Make sure content fits page width */
        body, html {
            width: 210mm;
            height: 297mm;
            overflow: hidden;
            font-size: 11pt;
        }
        /* Make tables compact */
        table {
            width: 100%;
            border-collapse: collapse !important;
            font-size: 10pt;
        }

        th, td {
            padding: 2px 5px !important;
            border: 1px solid #000 !important;
        }
        /* Reduce spacing */
        h2, h4, h5, p {
            margin: 4px 0;
        }
        /* Avoid page breaks inside sections */
        .card, .border, table, .row {
            page-break-inside: avoid !important;
        }
    }
</style>
<div class="container">
    <div class="card">
        <h2 class="text-center fw-bold m-0 p-0">PIS Access Privilege Requesting Form</h2>
      
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row align-items-end print-full-width">

                <div class="col-md-2">
                    <div class="d-flex align-items-center gap-1">
                        <label asp-for="EmployeeID" class="form-label text-nowrap">Empl. ID:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="EmployeeID" asp-for="EmployeeID" required placeholder="Enter ID" />
                            <button class="btn btn-outline-secondary d-print-none" type="button" id="lookupButton"
                                    onclick="fetchEmployeeData($('#EmployeeID').val(), 'EmployeeName', 'JobTitle', 'Department', '','WorkLocation')">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-1">
                        <label asp-for="EmployeeName" class="form-label text-nowrap">Employee Name:</label>
                        <input asp-for="EmployeeName" class="form-control form-control-sm flex-grow-1" id="EmployeeName" readonly>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-1">
                        <label asp-for="BusinessUnit" class="form-label text-nowrap">Department:</label>
                        <input asp-for="BusinessUnit" class="form-control form-control-sm flex-grow-1" id="Department" readonly>
                    </div>
                </div>
            </div>

            <div class="row align-items-end print-full-width">
               
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-1">
                        <label asp-for="JobTitle" class="form-label text-nowrap">Job Title:</label>
                        <input asp-for="JobTitle" class="form-control form-control-sm flex-grow-1" id="JobTitle" readonly>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-1">
                        <label asp-for="WorkLocation" class="form-label text-nowrap">Work Location:</label>
                        <input asp-for="WorkLocation" class="form-control form-control-sm flex-grow-1" id="WorkLocation" readonly>
                    </div>
                </div>
            </div>

            <div class="border p-1">
                <div class=" d-flex gap-2">
                    <p class="col-md-6">Please select (Tick) on the box below for a required access:</p>              

                    <div class="col-md-6 d-flex align-items-center">
                        <label asp-for="PISUserID" class="form-label me-2 text-nowrap">User ID:</label>
                        <input asp-for="PISUserID" class="form-control form-control-sm flex-grow-1">
                    </div>
                    
                </div>
                

                <h5 class="">Required Access Type (Group ID)</h5>
                <table class="table table-striped table-sm print-full-width">
                    <thead>
                        <tr>
                            
                            <th>Group ID</th>
                            <th>Description</th>
                            <th>Access Type</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="HRATTENDANCE">HRATTENDANCE</td><td>HR Attendance</td><td><input type="checkbox" name="LeaveUnit" value="LEAVEUNIT">Leave Unit</td><td>Attendance officer at Bu. level</td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="HRCLERK">HRCLERK</td><td>Data Entry Users</td><td><input type="checkbox" name="LeaveCompany" value="LEAVECOMAPNY">Leave Company</td><td>Attendance officer at Cpny level</td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="HRPERSONNEL_MGMT">HRPERSONNEL</td><td>HR Management</td><td><input type="checkbox" name="PersonnelUnit" value="PERSONNELUNIT">Personnel Unit</td><td>Archive & Documentation at BU level </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="HROFFICER">HROFFICER</td><td>HR Officer (Att. & Personnel)</td><td><input type="checkbox" name="PersonnelCompany" value="PERSONNELCOMPANY">Personnel Company</td><td>Archive & Documentation at Cpny level </td></tr>
                        <tr><td><input type="checkbox" name="AccessGroup" value="HRPERSONNEL_DOC">HRPERSONNEL</td><td>HR Personnel</td><td><input type="checkbox" name="AccessGroup" value="HRATTENDANCE">Officer Unit</td><td>Attendance & Archive Doc. BU level</td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="ADMIN">ADMIN</td><td>Administration</td><td><input type="checkbox" name="OfficerCompany" value="OFFICERCOMPANY">Officer Company</td><td>Attendance & Archive Doc.at Cpny level </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="FINOFFICER">FINOFFICER</td><td>Finance officer</td><td><input type="checkbox" name="FinUnit" value="FINUNIT">FIN Unit</td><td>Finance officer (pay roll) at BU level </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="TOPMGMT">TOPMGMT</td><td>Top Management</td><td><input type="checkbox" name="FinCompany" value="FINCOMPANY">FIN Company</td><td>Finance officer (pay roll) at Cpny level </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="DEPTMGR">DEPTMGR</td><td>Department Manager</td><td><input type="checkbox" name="Dentry" value="DENTRY">DENTRY</td><td>Attendance Clerk </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="SECTIONMGR">SECTIONMGR</td><td>Section manager</td><td><input type="checkbox" name="SectionMgr" value="SECTIONMGR">Sectionmgr</td><td>Section Manager </td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="USER">USER</td><td>Everyone</td><td><input type="checkbox" name="DepartmentManager" value="DEPARTMENTMANAGER">Dept Mgr</td><td>Department manager</td></tr>
                        
                        <tr><td><input type="checkbox" name="AccessGroup" value="HRMASTER">HRMASTER</td><td>Maintenance Master</td><td><input type="checkbox" name="User" value="USER">User</td><td>Every One </td></tr>
                    </tbody>
                </table>
            </div>

            <div class="border p-1">              
            
                <div class="d-flex">
                    
                    <div class="col-md-6 d-flex">
                        <label class="form-label me-4">Biometric System Required:</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="BiometricRequired" value="Yes" id="bioYes">
                            <label class="form-check-label" for="bioYes">Yes</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" asp-for="BiometricRequired" value="No" id="bioNo">
                            <label class="form-check-label" for="bioNo">No </label>
                        </div>
                        
                    </div>
                    <div class="col-md-6 d-flex align-content-center gap-1">
                        <label asp-for="BiometricUserID" class="form-label text-nowrap">User ID:</label>
                        <input asp-for="BiometricUserID" class="form-control form-control-sm">
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-center">
                @await Html.PartialAsync("print")
                @await Html.PartialAsync("back")
                <div><button type="reset" class="btn btn-outline-secondary px-4 m-2 d-print-none"><i class="bi bi-recycle me-2"></i>Reset</button></div>
                <div><a href="/Index" class="btn btn-outline-primary m-2"><i class="bi bi-house-fill me-2"></i>Home</a></div>
            </div>
            
            <h4 class="m-0 p-0">Sign-Off and Approvals</h4>

            <p class="text-muted small">I hereby would like to inform the above user has taken all the necessary trainings and important informations to enable him\her work on his own, so we request all the above access rights be given to the user.</p>
            <div class="d-flex d-print-flex gap-3">
                <div class="col-md-8 d-print-flex d-flex">
                    <label asp-for="DeptManagerName" class="text-nowrap">Name(Department Manager):</label>
                    <input asp-for="DeptManagerName" class="form-control ">
                </div>
                <div class="col-md-4 d-print-flex d-flex">
                    <label asp-for="DeptManagerSignature" class="text-nowrap">Sign:</label>
                    <input asp-for="DeptManagerSignature" class="form-control ">
                </div>
            </div>

            <p class="text-muted small">I have taken all the necessary trainings that enables me to work on my own, I request the above approved access rights.</p>
            <div class="d-print-flex d-flex gap-3">
                <div class="col-md-9 d-print-flex d-flex">
                    <label asp-for="RequestingUserName" class="form-label text-nowrap">Name (Requesting User):</label>
                    <input asp-for="RequestingUserName" class="form-control">
                </div>
                <div class="col-md-3 d-print-flex d-flex">
                    <label asp-for="RequestingUserSignature" class="form-label text-nowrap">Sign:</label>
                    <input asp-for="RequestingUserSignature" class="form-control">
                </div>
            </div>

            <hr class="m-0 p-0" />

            <h4 class="m-0 p-0">System Administration/ ICT Approval</h4>
            <div class="d-flex d-print-flex ">
                <div class="col-md-6 d-print-flex d-flex gap-3">
                    
                    <div class="">
                        <label class="text-nowrap">Checked by (DB/Sys. Admin.):</label>
                        <input type="text" class="form-control" disabled placeholder="Checked by">
                    </div>
                    <div class="">
                        <label class="text-nowrap">Sign:</label>
                        <input type="text" class="form-control" disabled placeholder="Sign">
                    </div>
                    
                </div>
                <div class="col-md-6 d-print-flex d-flex gap-3">
                    <div class="">
                        <label class="text-nowrap">Approved by (ICT Manager):</label>
                        <input type="text" class="form-control" disabled placeholder="Approved by">
                    </div>
                    <div class="">
                        <label class="text-nowrap">Sign:</label>
                        <input type="text" class="form-control" disabled placeholder="Sign:">
                    </div>
                    
                </div>
            </div>

            <hr />

            <h4 class="text-secondary">Termination (For ICT Use)</h4>
            <div class="row border bg-light">
                <div class="col-md-6 d-flex d-print-flex">
                    <label for="terminationDate" class="text-nowrap">Termination Date:</label>
                    <input type="text" class="form-control" id="terminationDate" disabled value="Termination Date:">
                </div>
                <div class="col-md-6 d-flex d-print-flex">
                    <label for="terminationReason" class="text-nowrap">Reason for Termination:</label>
                    <input type="text" class="form-control" id="terminationReason" disabled value="Reason for Termination:">
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/employeeLookup.js"></script>
}
