@page
@model PIS2.Pages.TrainingSessionAttendance.CreateModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Record Attendance / Result</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Training Session</label>
                                <select asp-for="Attendance.trainingSessionID" asp-items="Model.SessionList" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Employee</label>
                                <select asp-for="Attendance.employmentID" asp-items="Model.EmployeeList" class="form-select"></select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Result Status</label>
                                <select asp-for="Attendance.result" asp-items="Html.GetEnumSelectList<Models.trainingResult>()" class="form-select"></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Final Score</label>
                                <input asp-for="Attendance.score" class="form-control" type="number" step="0.01" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Completion Date</label>
                                <input asp-for="Attendance.completionDate" class="form-control" type="date" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Certificate Number</label>
                                <input asp-for="Attendance.certificateNumber" class="form-control" placeholder="CERT-12345" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Certificate Expiry</label>
                                <input asp-for="Attendance.certificateExpiryDate" class="form-control" type="date" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Internal Remarks</label>
                                <textarea asp-for="Attendance.remarks" class="form-control" rows="2"></textarea>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-light">Back to List</a>
                            <button type="submit" class="btn btn-primary px-4">Save Attendance</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>