@page 
@using PIS2.Enums
@model PIS2.Pages.Structure.IndexModel
@await Html.PartialAsync("headerSimple", "")

<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold m-0">Structure and Job Maping</h2>
        <p class="text-muted m-0">Company structures and job maping catalog</p>
    </div>
    @if(User.IsInRole("HRADMIN"))
    {
        <p><a asp-page="Create" class="btn btn-primary d-print-none"><i class="bi bi-plus-circle me-2"></i> New Structure</a></p>
    }
</div>
    

<!-- =======================
     SUMMARY CARDS
     ======================= -->
@{
    var totalRequired = Model.Structures.Sum(s => s.RequiredNumber) ?? 0;
    var totalActive = Model.Structures.Sum(s => s.ActivePlacements) ?? 0;
    var totalGap = totalActive - totalRequired;
    var percActive = (totalActive * 100) / totalRequired;
    string gapColor = totalGap < 0 ? "danger" : totalGap > 0 ? "warning" : "success";
}
<div class="card shadow-sm mb-4 p-2">
    <div class="d-flex gap-3 d-print-flex">

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-info border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Companies</small>
                            <h3 class="fw-bold mb-0">@Model.Structures.Select(s => s.CompanyID).Distinct().Count()</h3>
                        </div>
                        <div><i class="bi bi-building fs-2 text-info"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-primary border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Positions</small>
                            <h3 class="fw-bold mb-0">@Model.Structures.Count()</h3>
                        </div>
                        <div><i class="bi bi-briefcase fs-2 text-primary"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-warning border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Required</small>
                            <h3 class="fw-bold mb-0">@totalRequired</h3>
                        </div>
                        <div><i class="bi bi-list-check fs-2 text-warning"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-success border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Active</small>
                            <h3 class="fw-bold mb-0">@totalActive<span class="fw-light small">(@percActive%)</span></h3>
                        </div>
                        <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-@gapColor border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Overall Gap</small>
                            <h3 class="fw-bold mb-0">@totalGap</h3>
                        </div>
                        <div><i class="bi bi-exclamation-triangle fs-2 text-@gapColor"></i></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="d-flex gap-4 mb-2 flex-wrap card p-2">

    <form method="GET" class="d-flex gap-3 align-items-end flex-wrap ">

        <!-- Company -->
        <div class="flex-fill d-flex flex-column">
            <label for="filter-company" class="form-label fw-bold">Company:</label>
            <select class="form-select mb-2" id="filter-company" name="CompanyID">
                <option value="">All</option>
                @foreach (var company in Model.Companies)
                {
                    <option value="@company.companyID">@company.companyName</option>
                }
            </select>
        </div>

        <!-- Department -->
        <div class="flex-fill d-flex flex-column">
            <label for="filter-department" class="form-label fw-bold">Department:</label>
            <select class="form-select mb-2" id="filter-department" name="DepartmentID">
                <option value="">All</option>
            </select>
        </div>

        <!-- Status -->
        <div class="flex-fill d-flex flex-column">
            <label for="filter-status" class="form-label fw-bold">Status:</label>
            <select class="form-select mb-2" id="filter-status" name="StatusID"
                    asp-items="@Html.GetEnumSelectList<mainStatus>()">
                <option value="">All</option>
            </select>
        </div>

        <!-- Buttons -->
        <div class="flex-fill d-flex align-items-end gap-2 d-print-none">
            <button type="submit" class="btn btn-primary d-print-none m-2">Load</button>
            @await Html.PartialAsync("print")
            <excel-export table="dataTable" filename="StructureReport_@(DateTime.Today).xlsx"></excel-export>
        </div>

    </form>

    <!-- Partial filter box -->
    <div class="px-4">
        @await Html.PartialAsync("filter")
    </div>

</div>

<table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>S/no</th>
            <th>Company</th>
            <th>Job Title\Position</th>
            <th>Required</th>
            <th>Active Placement</th>
            <th>Gap</th>
            <th>Status</th>   
        </tr>
    </thead>
    <tbody>
        @{
            int companyIndex = 1;
        }
        @foreach (var companyGroup in Model.Structures.GroupBy(s => s.CompanyName))
        {
            <tr class="table-primary">
                <td class="fw-bold">@companyIndex</td>
                <td colspan="2"><strong>@companyGroup.Key</strong></td>
                <td><strong>@companyGroup.Sum(s => s.RequiredNumber)</strong></td>
                <td><strong>@companyGroup.Sum(s => s.ActivePlacements)</strong></td>
                @{
                    int gap = companyGroup.Sum(s => s.ActivePlacements) - companyGroup.Sum(s => s.RequiredNumber) ?? 0;
                }
                <td class="text-white @(gap < 0? "bg-danger" : @gap > 0? "bg-warning" : "bg-success")">
                    <strong class="fw-bold">@gap</strong>
                </td>
                <td></td>
            </tr>
            int departmentIndex = 1;
            @foreach (var departmentGroup in companyGroup.GroupBy(s => s.DepartmentName))
            {
                <tr class="table-secondary">
                    <td>@companyIndex.@departmentIndex</td>
                    <td colspan="2"><strong>@departmentGroup.Key</strong>
                        @if(User.IsInRole("HRADMIN"))
                        { 
                            <a href="/Structure/Create?id=@departmentGroup.First().DepartmentID" class="d-print-none"><i class="bi bi-plus-circle"></i>Add Structure</a>
                        }
                    </td>
                    <td><strong>@departmentGroup.Sum(s => s.RequiredNumber)</strong></td>
                    <td><strong>@departmentGroup.Sum(s => s.ActivePlacements)</strong></td>
                    <td>
                        @if (departmentGroup.Sum(s => s.RequiredNumber) > departmentGroup.Sum(s => s.ActivePlacements))
                        {
                            <strong class="badge bg-danger">@(departmentGroup.Sum(s => s.ActivePlacements) - departmentGroup.Sum(s => s.RequiredNumber))</strong>
                        }
                        else if (departmentGroup.Sum(s => s.RequiredNumber) < departmentGroup.Sum(s => s.ActivePlacements))
                        {
                            <strong class="badge bg-warning">+@(departmentGroup.Sum(s => s.ActivePlacements) - departmentGroup.Sum(s => s.RequiredNumber))</strong>
                        }
                        else
                        {
                            <strong class="badge bg-success">0</strong>
                        }
                    </td>
                    <td></td>
                </tr>
                @foreach (var item in departmentGroup)
                {
                    <tr>
                        <td></td>
                        <td></td>
                        <td onclick="location.href='@Url.Page("Edit", new { id = item.StructureID })'" style="cursor:pointer;">@item.JobTitle</td>

                        <td>@item.RequiredNumber</td>
                        <td>@item.ActivePlacements</td>
                        <td>
                            @if(item.RequiredNumber > item.ActivePlacements)
                            {
                                <strong class="badge bg-danger">@(item.ActivePlacements - item.RequiredNumber)</strong>
                            }
                            else if (item.RequiredNumber < item.ActivePlacements)
                            {
                                <strong class="badge bg-warning">+@(item.ActivePlacements - item.RequiredNumber)</strong>
                            }
                            else
                            {
                                <strong class="badge bg-success">0</strong>
                            }
                        </td>
                         <td>
                            @if ((mainStatus)item.StructureStatus == mainStatus.Active)
                            {
                                <strong class="badge bg-success">@((mainStatus)item.StructureStatus)</strong>
                            }
                            else
                            {
                                <strong class="badge bg-secondary">@((mainStatus)item.StructureStatus)</strong>
                            }
                        </td >
                        
                    </tr>
                }
                departmentIndex++;
            }
            companyIndex++;
        }
    </tbody>
    <tfoot class="bg-secondary fw-bold">
        <tr>
            <td colspan="3">Total Required Man-power</td>
            <td>@Model.Structures.Sum(s => s.RequiredNumber)</td>
            <td>@Model.Structures.Sum(s => s.ActivePlacements)</td>
            <td>@(Model.Structures.Sum(s => s.ActivePlacements) -Model.Structures.Sum(s => s.RequiredNumber))</td>
            <td></td>
        </tr>
    </tfoot>
</table>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>
