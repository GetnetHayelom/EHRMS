@page
@model PIS2.Pages.Budget.LineCreateModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add Department Allocation</h4>
                    <small>Adding to Plan: @Model.ParentPlan?.BudgetName</small>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="BudgetLine.BudgetPlanID" />

                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">Select Sub-Account / Department</label>
                            <select asp-for="BudgetLine.subAccountID" class="form-control form-control-lg" asp-items="ViewBag.subAccountID">
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="BudgetLine.subAccountID" class="text-danger"></span>
                            <small class="text-muted">Only departments not already in this budget plan are shown.</small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">Allocated Amount</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light font-weight-bold">$</span>
                                </div>
                                <input asp-for="BudgetLine.AllocatedAmount" class="form-control form-control-lg" type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="BudgetLine.AllocatedAmount" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="BudgetLine.Notes" class="control-label font-weight-bold"></label>
                            <textarea asp-for="BudgetLine.Notes" class="form-control" rows="3" placeholder="Justification for this budget allocation..."></textarea>
                            <span asp-validation-for="BudgetLine.Notes" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/Account/Budgeting/Details?id=@Model.BudgetLine.BudgetPlanID" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="fas fa-save"></i>@L.T("Save") Allocation
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-3 text-center">
                <p class="text-muted small">
                    Note: Once saved, this line will appear in the <strong>Performance</strong> and <strong>Entries</strong> tabs of the main Budget Plan.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}