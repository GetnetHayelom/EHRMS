@page "{id:int}"
@model PIS2.Pages.Budget.DetailsModel
@{
}
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h2>@Model.BudgetPlan.BudgetName</h2>
            <span class="badge @(Model.BudgetPlan.Status == Enums.BudgetStatus.ACTIVE ? "badge-success" : "badge-secondary")">
                @Model.BudgetPlan.Status
            </span>
        </div>
        <div class="btn-group align-items-end m-2">
            @if (Model.BudgetPlan.Status == Enums.BudgetStatus.HOLD && User.IsInRole("MIE\\PMS_HRMANAGER"))
            {
               
                    <form method="post" asp-page-handler="Approve">
                        <input type="hidden" asp-for="BudgetPlan.BudgetPlanID" />
                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle me-2"></i>Approve</button>
                    </form>
                    <form method="post" asp-page-handler="Decline">
                        <input type="hidden" asp-for="BudgetPlan.BudgetPlanID" />
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-2"></i>Decline</button>
                    </form>
                

            }
            else if (Model.BudgetPlan.Status == Enums.BudgetStatus.APPROVED && User.IsInRole("MIE\\PMS_HRMANAGER"))
            {
                if (Model.BudgetPlan.StartDate <= DateTime.Now)
                {
                    <form method="post" asp-page-handler="Activate">
                        <input type="hidden" asp-for="BudgetPlan.BudgetPlanID" />
                        <button type="submit" class="btn btn-success"><i class="bi bi-activity me-2"></i>Activate</button>
                    </form>
                }
            }
            else if (Model.BudgetPlan.Status == Enums.BudgetStatus.ACTIVE && User.IsInRole("MIE\\PMS_HRMANAGER"))
            {
                if (Model.BudgetPlan.EndDate <= DateTime.Now)
                {
                    <form method="post" asp-page-handler="Close">
                        <input type="hidden" asp-for="BudgetPlan.BudgetPlanID" />
                        <button type="submit" class="btn btn-secondary"><i class="bi bi-check-circle me-2"></i>Close</button>
                    </form>
                }

            }
            <a asp-page="./Index" asp-route-id="@Model.BudgetPlan.BudgetPlanID" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
            <a asp-page="./Edit" asp-route-id="@Model.BudgetPlan.BudgetPlanID" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Edit Plan</a>
            @if ((Model.BudgetPlan.BudgetLines == null || !Model.BudgetPlan.BudgetLines.Any()) && Model.BudgetPlan.Status == Enums.BudgetStatus.APPROVED) 
            {
                <form method="POST" asp-page-handler="Initialize">
                    <input value="@Model.BudgetPlan.BudgetPlanID" asp-for="BudgetPlan.BudgetPlanID" readonly hidden />
                    <button class="btn btn-warning text-dark" type="submit">Initialize</button>
                </form>
            }
        </div>
    </div>
    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between"> 
                        <h6 class="text-uppercase text-white small">PLANNED</h6>
                        <h6 class="small text-uppercase text-white small">BUDGETED</h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h2 class="mb-0 text-white">@Model.BudgetPlan.TotalAmount?.ToString("N0")</h2>
                        <h2 class="mb-0 text-white small">@Model.Performance.Sum(p => p.Budgeted).ToString("N0")</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning">
                <div class="card-body">
                    <h6 class="text-uppercase text-dark small">Actuals</h6>
                    <h2 class="mb-0 text-dark">@Model.Performance.Sum(p => p.ActualSpent).ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger">
                <div class="card-body">
                    <h6 class="text-uppercase text-white small">UnAllocated</h6>
                    <h2 class="mb-0 text-white">@Model.BudgetPlan.UnAllocated?.ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm @(Model.Performance.Sum(p => p.Remaining) < 0 ? "bg-danger" : "bg-success") text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h6 class="text-uppercase small">Available Balance</h6>
                        <h6 class="text-uppercase small">Utilization Rate</h6>
                    </div>
                        
                    
                    <div class="d-flex justify-content-between">
                        <h2 class="mb-0">@Model.Performance.Sum(p => p.Remaining).ToString("N0")</h2>
                        <h2 class="mb-0 small">@Model.Performance?.FirstOrDefault()?.UtilizationRate.ToString("N0")</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="budgetTab" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="performance-tab" data-bs-toggle="tab" data-bs-target="#performance">Performance (Actual vs Budget)</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="entries-tab" data-bs-toggle="tab" data-bs-target="#entries">Edit Budget Entries</a>
        </li>
    </ul>

    <div class="tab-content border-left border-right border-bottom p-4 bg-white" id="budgetTabContent">
        
        <div class="tab-pane fade show active" id="performance">
            <div class="d-flex justify-content-end d-print-none">
                <div class="m-2">
                    <input type="text" data-target="budgetPerformance" placeholder="finder..." class="searchBox form-control d-print-none" oninput="CustomFilter(this)">
                </div>
                <div class="mx-2">@await Html.PartialAsync("print")</div>
                <div class="mx-2"><excel-export table="budgetPerformance" filename="Budget_Plan_@(DateTime.UtcNow).xlsx"></excel-export></div>
            </div>
            <table class="table table-hover" id="budgetPerformance">
                <thead class="thead-light">
                    <tr>
                        <th>Department</th>
                        <th class="text-right">Budgeted</th>
                        <th class="text-right">Actual Spent</th>
                        <th class="text-center">Utilization</th>
                        <th class="text-right">Remaining</th>
                        <th class="d-print-none text-end px-2">Actions </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Performance)
                    {
                        <tr>
                            <td><strong>@item.SubAccountNumber</strong> - @item.DepartmentName</td>
                            <td class="text-right">@item.Budgeted.ToString("N2")</td>
                            <td class="text-right text-info">@item.ActualSpent.ToString("N2")</td>
                            <td class="align-middle">
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar @(item.UtilizationRate > 100 ? "bg-danger" : "bg-success")" 
                                         style="width: @(item.UtilizationRate > 100 ? 100 : item.UtilizationRate)%">
                                    </div>
                                </div>
                                <small class="text-center d-block">@item.UtilizationRate.ToString("N1")%</small>
                            </td>
                            <td class="text-right @(item.Remaining < 0 ? "text-danger" : "")">
                                @item.Remaining.ToString("N2")
                            </td>
                            <td class="d-print-none text-end px-2">
                                <a asp-page="./LineDetails" asp-route-id="@item.BudgetLineID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./LineEdit" asp-route-id="@item.BudgetLineID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.BudgetPlan.BudgetLines == null || !Model.BudgetPlan.BudgetLines.Any())
            {
                <p class="small text-muted mt-3 text-center">
                    * Clicking "Initialize" will automatically create line entries for all active departments.
                </p>
            }
        </div>

        <div class="tab-pane fade" id="entries">
            @if (Model.BudgetPlan.BudgetLines == null || !Model.BudgetPlan.BudgetLines.Any())
            {
                <p class="small text-muted mt-3 text-center">
                    * Clicking "Initialize" will automatically create line entries for all active departments.
                </p>
                <a class="btn btn-primary" asp-page="LineCreate" asp-route-id="@Model.BudgetPlan.BudgetPlanID"><i class="bi bi-plus-circle me-2">Add Entry</i></a>
            }else
            {
                <div class="m-2">
                    <input type="text" id="searchBox1" data-target="entryTable" placeholder="finder..." class="searchBox form-control d-print-none" oninput="CustomFilter(this)">
                </div>
                <form method="post" asp-page-handler="UpdateLines">
                    <input type="hidden" asp-for="BudgetPlan.BudgetPlanID" />
 
                    <table class="table table-sm" id="entryTable">
                        <thead>
                            <tr>
                                <th>Sub-Account</th>
                                <th style="width: 200px;">Allocated Amount</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.BudgetPlan.BudgetLines.Count; i++)
                            {
                                var line = Model.BudgetPlan.BudgetLines.ElementAt(i);
                                <tr>
                                    <td>
                                        @line.SubAccount.subAccountName - @line.SubAccount.subAccountDescription
                                        <input type="hidden" name="updatedLines[@i].BudgetLineID" value="@line.BudgetLineID" />
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                                            <input type="number" step="0.01" name="updatedLines[@i].AllocatedAmount" 
                                                   value="@line.AllocatedAmount" class="form-control" />
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" name="updatedLines[@i].Notes" value="@line.Notes" class="form-control" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-success">Save Budget Changes</button>
                </form>
            }
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".searchBox").forEach(input => {
        if (input.value) {
                CustomFilter(input);
            }
        });
    });

    let timeout;
    document.addEventListener("input", function (e) {
        if (e.target.classList.contains("searchBox")) {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                CustomFilter(e.target);
            }, 200);
        }
    });
</script>