@page "{id:int}"
@model PIS2.Pages.Budget.LineDetailsModel
<h2 class="fw-bold mb-0">Budget Entry</h2>
<p class="text-muted mb-0">Budget entry line details #@Model.BudgetLine.BudgetLineID</p>
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h4 class="m-2">Budget Line Detail</h4>
                <h6 class="text-muted m-2">@Model.BudgetLine.BudgetPlan?.BudgetName</h6>
            </div>
            
            <hr />
            <dl class="row mt-4">
                <dt class="col-sm-3">Budget Plan</dt>
                <dd class="col-sm-9">@Model.BudgetLine?.BudgetPlan?.BudgetName</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.BudgetLine?.SubAccount.subAccountName (@Model.BudgetLine?.SubAccount.subAccountNumber)</dd>

                <dt class="col-sm-3">Total Allocated</dt>
                <dd class="col-sm-9 font-weight-bold text-success h4">@Model.BudgetLine?.AllocatedAmount.ToString("C2")</dd>

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.BudgetLine?.Notes</dd>

                <dt class="col-sm-3 text-muted small">Last Modified</dt>
                <dd class="col-sm-9 text-muted small">@Model.BudgetLine?.modifiedDate.ToString("g") by @Model.BudgetLine?.modifiedBy</dd>
            </dl>
            <div class="mt-3 d-flex justify-content-end gap-2">
                <a asp-page="./LineEdit" asp-route-id="@Model.BudgetLine?.BudgetLineID" class="btn btn-primary">Edit This Line</a>
                <a href="/Budget/Details" asp-route-id="@Model.BudgetLine?.BudgetPlanID" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Plan</a>
            </div>
        </div>
    </div>
</div>