@page
@model PIS2.Pages.Budget.CreateModel
@{
}
<div class="d-flex justify-content-between align-items-end">
    <h2 class="fw-bold mb-0">Budget Plan</h2>
    <p class="text-muted mb-0">Create new budget plan</p>
</div>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">Fill Form For New Budget Plan</h4>
                </div>
                <div class="card-body">
                    <form method="post" id="createForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="BudgetPlan.BudgetName" class="control-label font-weight-bold">Plan Name</label>
                            <input asp-for="BudgetPlan.BudgetName" class="form-control" placeholder="e.g. FY2026 Operations Budget" />
                            <span asp-validation-for="BudgetPlan.BudgetName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.StartDate" class="control-label font-weight-bold">Start Date</label>
                                <input asp-for="BudgetPlan.StartDate" type="date" class="form-control" />
                                <span asp-validation-for="BudgetPlan.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.EndDate" class="control-label font-weight-bold">End Date</label>
                                <input asp-for="BudgetPlan.EndDate" type="date" class="form-control" />
                                <span asp-validation-for="BudgetPlan.EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.Status" class="control-label font-weight-bold">Initial Status</label>
                                <select asp-for="BudgetPlan.Status" asp-items="Model.StatusList" class="form-control" readonly></select>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.BudgetPeriod" class="control-label font-weight-bold">Period Label</label>
                                <input asp-for="BudgetPlan.BudgetPeriod" class="form-control" placeholder="e.g. Q1, Annual" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.TotalAmount" class="control-label font-weight-bold">Planned Ammount</label>
                                <input asp-for="BudgetPlan.TotalAmount" class="form-control" />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="BudgetPlan.FiscalYear" class="control-label font-weight-bold">Fiscal Year</label>
                                <input asp-for="BudgetPlan.FiscalYear" class="form-control"/>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="BudgetPlan.Description" class="control-label font-weight-bold">Description / Objectives</label>
                            <textarea asp-for="BudgetPlan.Description" class="form-control" rows="3"></textarea>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-outline-danger">Reset</button>
                            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
                            <button type="submit" class="btn btn-success">Save &raquo;</button>
                        </div>
                    </form>
                </div>
                
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}