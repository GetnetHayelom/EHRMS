@page
@model PIS2.Pages.delegation.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-0">Delegations</h2>
<p class="text-muted mb-0">New Delegation form</p>
<hr />
<div class="row g-2">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post" class="ajax-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!-- Selector -->
            <div class="mb-3">
                <label asp-for="delegationModel.delegationFrom" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Delegator
                </label>
                <input type="text" class="form-control" list="personList1" placeholder="Type to search..." oninput="selector(this, 'delegateFrom')" value="@Model.delegationModel?.FromEmployment?.personModel?.personFullName" />
                <input type="hidden" asp-for="delegationModel.delegationFrom" id="delegateFrom" value="@Model.delegationModel?.delegationFrom" required />
                <datalist id="personList1">
                    @foreach (var person in Model.Employments)
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="delegationModel.delegationFrom" class="text-danger"></span>
            </div>

            <!-- Selector -->
            <div class="mb-3">
                <label asp-for="delegationModel.delegationTo" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Delegatee
                </label>
                <input type="text" class="form-control" list="personList2" placeholder="Type to search..." oninput="selector(this, 'delegateTo')" />
                <input type="hidden" asp-for="delegationModel.delegationTo" id="delegateTo" required/>
                <datalist id="personList2">
                    @foreach (var person in Model.Employments)
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="delegationModel.delegationTo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="delegationModel.delegationStartDate" class="control-label">Start</label>
                <input asp-for="delegationModel.delegationStartDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date"/>
                <span asp-validation-for="delegationModel.delegationStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="delegationModel.delegationEndDate" class="control-label">End</label>
                <input asp-for="delegationModel.delegationEndDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date" />
                <span asp-validation-for="delegationModel.delegationEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="delegationModel.delegationScope" class="control-label">Scope</label>
                <select asp-for="delegationModel.delegationScope" class="form-control" asp-items="@Html.GetEnumSelectList<Models.delegationScopes>()"></select>
                <span asp-validation-for="delegationModel.delegationScope" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>

    <div class="card shadow-sm p-2 col-md-8">
        <h6 class="fw-bold">My Delegations</h6>
        <table class="table table-striped table-hover" id="dataTable">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>
                        Deligator
                    </th>
                    <th>
                        Deligate
                    </th>
                    <th>
                        Duration
                    </th>

                    <th>
                        Scope
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Last Modified
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.myDelegations.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No delegations found.
                        </td>
                    </tr>
                }
                @{
                    int index = 1;
                }
                @foreach (var item in Model.myDelegations)
                {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.delegationID })'" style="cursor:pointer;">
                        <td>@(index++)</td>
                        <td>
                            <div>
                                @item.FromEmployment?.givenID
                                <p class="text-muted">@item.FromEmployment?.personModel?.personFullName</p>
                            </div>

                        </td>
                        <td>
                            <div>
                                @item.ToEmployment?.givenID
                                <p class="text-muted">@item.ToEmployment?.personModel?.personFullName</p>
                            </div>

                        </td>
                        <td>
                            @item.delegationStartDate.ToString("MM/dd/yyyy") - @item.delegationEndDate.ToString("MM/dd/yyyy")
                        </td>

                        <td>
                            @item.delegationScope.ToString()
                        </td>
                        <td>

                            @if (item.delegationStatus == Models.mainStatus.Active)
                            {
                                <span class="badge bg-success">@Html.DisplayFor(modelItem => item.delegationStatus)</span>

                            }
                            else if (item.delegationStatus == Models.mainStatus.Suspended)
                            {
                                <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.delegationStatus)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.delegationStatus)</span>
                            }
                        </td>
                        <td>
                            <div>
                                @item.modifiedBy
                                <p class="text-muted">@item.modifiedDate</p>
                            </div>

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-page="Index">View All Delegations</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

