@page
@model PIS2.Pages.delegation.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Delegation</h1>

<h3 class="fw-bold">Are you sure you want to delete this?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Delegate By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.FromEmployment.givenID)
        </dd>
        <dt class="col-sm-2">
            Delegate To:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.ToEmployment.givenID)
        </dd>
        <dt class="col-sm-2">
            Start:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.delegationStartDate)
        </dd>
        <dt class="col-sm-2">
            End:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.delegationEndDate)
        </dd>
        <dt class="col-sm-2">
            Scope:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.delegationScope)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.delegationStatus)
        </dd>
        <dt class="col-sm-2">
            Modified Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.modifiedDate)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.delegationModel.modifiedBy)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="delegationModel.delegationID" />
        <input type="submit" value="Delete" class="btn btn-danger m-2" />
        
    </form>
    <a asp-page="./Index">View All delegation</a>
</div>
