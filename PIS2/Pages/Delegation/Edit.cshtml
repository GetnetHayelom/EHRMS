@page
@using PIS2.Enums
@model PIS2.Pages.delegation.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Delegation</h2>

<h6 class="text-muted">@L.T("Update") Delegation</h6>
<hr />
<div class="row">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post" class="ajax-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="delegationModel.delegationID" />
            <div class="form-group">
                <label class="control-label fw-bold">Delegator:</label>
                <h6>@Model.delegationModel.FromEmployment?.personModel?.personFullName</h6>      
            </div>
            <div class="form-group">
                <label class="control-label fw-bold">Delegatee</label>
                <h6>@Model.delegationModel.ToEmployment?.personModel?.personFullName</h6>   
            </div>
            <div class="form-group">
                <label class="control-label fw-bold">Scope</label>
                <h6>@Model.delegationModel.delegationScope</h6>
            </div>
            
            <div class="form-group">
                <label asp-for="delegationModel.delegationStartDate" class="control-label">From</label>
                <input asp-for="delegationModel.delegationStartDate" class="form-control" readonly="@(Model.delegationModel.delegationStartDate < DateTime.Now ? "readonly" : null)" />
                <span asp-validation-for="delegationModel.delegationStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="delegationModel.delegationEndDate" class="control-label">To</label>
                <input asp-for="delegationModel.delegationEndDate" class="form-control" />
                <span asp-validation-for="delegationModel.delegationEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="delegationModel.delegationStatus" class="control-label">Status</label>
                <select asp-for="delegationModel.delegationStatus" class="form-control" asp-items="@Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="delegationModel.delegationStatus" class="text-danger"></span>
            </div>
            
            
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View Delegations</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
