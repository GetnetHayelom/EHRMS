@using PIS2.Enums
@model List<PIS2.Models.accessModel>

<table class="table table-bordered table-striped">
    <thead class="bg-secondary text-white">
        <tr>
            <th>User Group</th>
            <th>Company</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var access in Model)
            {
                <tr>
                    <td>@(access.Role?.Name?.ToString() ?? "N/A")</td>
                    <td>@(access.CompanyModel?.companyName ?? "All Companies")</td>
                    <td>@(access.accessStatus.ToString() ?? "Active")</td>
                    <td class="text-center">
                        @{
                            var stat = access.accessStatus == mainStatus.Active ? "Disable" : "Enable";
                        }
                        <button type="button" class="btn btn-sm btn-@(stat == "Disable" ? "warning" : "primary") me-1" onclick="updateAccess(@access.accessID)">
                            @stat
                        </button>
                        
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No access entries found.</td>
            </tr>
        }
    </tbody>
</table>

