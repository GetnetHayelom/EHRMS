@page
@model PIS2.Pages.Report.LeaveReportModel
@{
}
<div class="d-flex justify-content-between">


    <h4 class="fw-bold"><span id="filteredCount"></span> of @Model.totalCount</h4>
    <h4 class="fw-bold">Unposted @Model.CountUnposted</h4>
    <div class="d-inline-flex">
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("print")
    </div>
</div>

<div class="row m-2">
    <div class="col-3">
        <label for="filter-status">Status:</label>
        <select class="form-select" aria-label="Default select example" id="filter-status" onchange="filterLeaves()" asp-items="Html.GetEnumSelectList<Enums.leaveStatus>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-3">
        <label for="filter-type">Type:</label>
        <select class="form-select" aria-label="Default select example" id="filter-type" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var leaveType in Model.LeaveTypes)
            {
                <option value="@leaveType.leaveTypeID">@leaveType.leaveTypeName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-company">Company:</label>
        <select class="form-select" aria-label="Default select example" id="filter-company" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.companyID">@company.companyName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-department">Department:</label>
        <select class="form-select" aria-label="Default select example" id="filter-department" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var department in Model.Departments)
            {
                <option value="@department.departmentID">@department.departmentName</option>
            }
        </select>
    </div>
    

    <div class="col-3">
        <label for="dateStart">Date of Start From:</label>
        <input class="form-control" type="date" id="dateStart" onchange="filterLeaves()" />
    </div>
    <div class="col-3">
        <label for="dateEnd">Date of End Upto:</label>
        <input class="form-control" type="date" id="dateEnd" onchange="filterLeaves()" />
    </div>
</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>Leave No</th>
            <th>
                Employee ID
            </th>
            <th>
                Date
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Days
            </th>
            <th>
                Type
            </th>
            <th>
                Status
            </th>

        </tr>
    </thead>
    <tbody id="table-body">
    </tbody>
</table>
<script>
    window.onload = filterLeaves();
    function filterLeaves() {

        var department = document.getElementById("filter-department").value;
        var leaveStatus = document.getElementById("filter-status").value;
        var leaveType = document.getElementById("filter-type").value;

        var company = document.getElementById("filter-company").value;
        var dateStart = document.getElementById("dateStart").value;
        var dateEnd = document.getElementById("dateEnd").value;

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        leaveStatus = (!leaveStatus || leaveStatus === "") ? null : leaveStatus;
        leaveType = (!leaveType || leaveType === "") ? null : leaveType;

        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;

        // Build the URL with multiple filters
        const url = `/Report/LeaveReport?handler=Filter&department=${encodeURIComponent(department)}&leaveStatus=${encodeURIComponent(leaveStatus)}&leaveType=${encodeURIComponent(leaveType)}&company=${encodeURIComponent(company)}&dateStart=${encodeURIComponent(dateStart)}&dateEnd=${encodeURIComponent(dateEnd)}`;

        fetch(url)
            //.then(response => response.text())
            .then(response => response.json())
            .then(data => {
                console.log("Received Data:", data); // Debug output
                document.getElementById('table-body').innerHTML = data.tableHtml;
                document.getElementById('filteredCount').innerHTML = data.filteredCount;
                updateRowCount("countID");
            })
            .catch(error => console.error('Error:', error));
    }

</script>
