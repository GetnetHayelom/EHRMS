@model string
<div class="d-none d-print-flex align-items-center justify-content-between print-full-width">
    <!-- Left Logo -->
    <div style="width: 15%; text-align: left;">
        <img src="/assets/logo_full.png" alt="Logo" style="width: 100%; max-height: 60px;">       
    </div>

    <!-- Centered Company Info -->
    <div style="width: 70%; text-align: center;" class="flex-grow-1">
        <h3 style="margin: 0;" class="fw-bold">Company Name1 <small>Suffix1</small></h3>
        <h2 style="margin: 0;" class="fw-bold">Company Name2 <small>Suffix2</small></h2>       
    </div>

    <!-- Right Logo -->
    <div style="width: 15%; text-align: right;">
        <img src="/assets/logo_full.png" alt="Logo" style="width: 100%; max-height: 60px;">        
    </div>    
</div>


<div class="d-none d-print-flex justify-content-between print-full-width">
    <p style="margin: 0;"><span class="fw-bold">Form No:</span><u>@Model</u></p>
    <p style="margin: 0;"><span class="fw-bold">Date:</span><u>@DateTime.Now.ToString("dd/MM/yyyy")</u></p></div>

<hr class="d-none d-print-block border border-dark border-4 " />