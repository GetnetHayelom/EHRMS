<div class="d-none d-print-flex align-items-center justify-content-between mb-2 w-100">
    <!-- Left Logo -->
    <div style="width: 15%; text-align: left;">
        <img src="/assets/mie_logo.png" alt="Logo" style="width: 100%; max-height: 60px;">
       
    </div>

    <!-- Centered Company Info -->
    <div style="width: 70%; text-align: center;">
        <h3 style="margin: 0;" class="fw-bold">መስፍን ብረታ ብረትና ኢንጂነሪንግ ሓ/የተ/የግ/ማህበር</h3>
        <h2 style="margin: 0;" class="fw-bold">Mefin Metals & Engineering PLC</h2>
        
    </div>

    <!-- Right Logo -->
    <div style="width: 15%; text-align: right;">
        <img src="/assets/mie_logo.png" alt="Logo" style="width: 100%; max-height: 60px;">
        <p style="margin: 0;" class="fw-bold">Date:</p>
        <p style="margin: 0;">@DateTime.Now.ToString("MMM dd, yyyy")</p>
    </div>
    <hr class="border-5 border-dark" />

</div>