    <!--MESSAGE ALERT-->
    @if (TempData["message"] is ValueTuple<string, string> message)
    {
        var type = message.Item1;
        var text = message.Item2;

        var bgClass = type == "Success" ? "bg-success" : "bg-danger";
        var icon = type == "Success" ? "✔" : "⚠";

        <div class="toast-container position-fixed top-50 start-50 translate-middle" style="z-index: 1100;">
            <div id="actionToast1" class="toast text-white @bgClass border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">

                <div class="toast-header text-white @bgClass border-0">
                    <strong class="me-auto">@icon @type</strong>
                    <small>System</small>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                </div>

                <div class="toast-body fw-semibold">
                    @text
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var toastEl = document.getElementById('actionToast1');
                if (toastEl) {
                    new bootstrap.Toast(toastEl).show();
                }
            });
        </script>
    }


    <!--AJAX MESSAGE ALERT-->
    <div class="toast-container position-fixed top-50 start-50 translate-middle d-none" style="z-index:1100;">
        <div id="actionToast" class="toast text-white border-0 shadow" data-bs-delay="4000">
            <div class="toast-header text-white border-0">
                <strong class="me-auto" id="toastTitle"></strong>
                <small>System</small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body fw-semibold" id="toastBody"></div>
        </div>
    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" src="~/lib/jquery/dist/jquery.dataTables.min.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/funcs.js"></script>
    <script src="~/js/print.js"></script>
    <script src="~/js/site.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/lib/xlsx/xlsx.full.min.js"></script>

    <!--LOADER CONTROLLER-->
    <script>
        const hideLoader = () => document.getElementById("loader").style.display = "none";
        const showLoader = () => document.getElementById("loader").style.display = "flex";

        window.addEventListener("load", hideLoader);
        window.addEventListener("beforeunload", showLoader);

        $(document).ajaxStart(showLoader).ajaxStop(hideLoader);

        // Auto-show toast if exists
        const tEl = document.getElementById('actionToast');
        if (tEl) new bootstrap.Toast(tEl).show();
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 1. Identify current URL
            const currentPath = window.location.pathname;

            // 2. Find the active link
            const activeLink = document.querySelector(`.sidebar .nav-link[href="${currentPath}"]`);

            if (activeLink) {
                // Add active styling
                activeLink.classList.add('text-white', 'fw-bold');

                // 3. Find the parent collapse and ensure it has 'show'
                const parentCollapse = activeLink.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');

                    // Update the chevron/aria-expanded state of the toggle button
                    const toggleBtn = document.querySelector(`[href="#${parentCollapse.id}"]`);
                    if (toggleBtn) {
                        toggleBtn.setAttribute('aria-expanded', 'true');
                    }
                }
            }
        });

        // Optional: Prevent menus from closing when clicked if you want them TRULY permanent
        $('.sidebar .nav-link[data-bs-toggle="collapse"]').on('click', function(e) {
            // Uncomment the line below if you want to DISABLE clicking to close
            // e.preventDefault(); e.stopPropagation();
        });
    </script>
    <!--FILTER CUSTOM-->
    <script>
        document.addEventListener("input", function (e) {
        // 1. Check if the element that triggered the event has the 'searchBox' class
            if (e.target.classList.contains("searchBox")) {
                let input = e.target.value.toLowerCase();

                // 2. Get the target table ID from the data-target attribute
                let targetSelector = e.target.getAttribute("data-target");
                if (!targetSelector) return;

                // 3. Find the rows within that specific table
                let table = document.querySelector(targetSelector);
                if (!table) return;

                let rows = table.querySelectorAll("tbody tr");

                // 4. Filter the rows
                rows.forEach(row => {
                    let text = row.textContent.toLowerCase();
                    row.style.display = text.includes(input) ? "" : "none";
                });
            }
        });
    </script>

    <!--SUBMIT FORM-->
    <script>
        $(document).on("submit", "form.ajax-form", function (e) {
            e.preventDefault(); // stop normal submit

            const form = $(this);
            const url = form.attr("action");
            const method = form.attr("method") || "POST";

            $.ajax({
                url: url,
                type: method,
                data: form.serialize(),

                success: function (response) {
                    // handled globally (the toast handler)
                },

                error: function (xhr) {
                    console.error("Error:", xhr.responseText);
                }
            });
        });
    </script>

    <!--JSON RESPONSE HANDLER-->
    <script id="r6qavz">
        $(document).ajaxSuccess(function (event, xhr, settings) {
            try {
                var response = xhr.responseJSON;

                if (response) {
                    console.log("Global JSON handler:", response);
                    if(Object.prototype.hasOwnProperty.call(response, "success"))
                    {
                        showToast(response.success, response.message);
                    }                   
                }
            } catch (e) {
                console.log("Not JSON response");
            }
        });

        $(document).ajaxError(function (event, xhr) {
            console.error("AJAX error:", xhr.responseText);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>