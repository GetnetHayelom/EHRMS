<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MMEC-HRMS</title>

    <link href="~/lib/quill/quill.snow.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/icons/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PIS2.styles.css" asp-append-version="true" />
    <script src="~/js/chart.umd.js"></script>
    <script src="~/lib/quill/quill.min.js"></script>
    <script src="~/js/quill-editor.js"></script>
    <style>
        :root {
            --sb-bg: #1e293b; /* Slate 800 */
            --sb-width: 280px;
            --accent: #38bdf8;
            --text-muted: #94a3b8;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
        }

        /* Modern Loader */
        #loader {
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        /* Professional Sidebar */
        .sidebar {
            width: var(--sb-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: var(--sb-bg);
            color: white;
            z-index: 1000;
            overflow-y: auto;
            transition: all 0.3s;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-brand {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--accent);
            text-decoration: none;
        }

        .nav-group-title {
            padding: 1.25rem 1.5rem 0.5rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1rem;
            color: var(--text-muted);
        }

        aside .nav-link {
            color: #cbd5e1;
            padding: 0.7rem 1.5rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: 0.2s;
        }

        .nav-link:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .nav-link i {
            font-size: 1.1rem;
            color: var(--text-muted);
        }

        .submenu {
            background: rgba(0,0,0,0.2);
            padding-bottom: 0.5rem;
        }

        .submenu .nav-link {
            padding-left: 3.5rem;
            font-size: 0.8rem;
        }

        /* Layout Main */
        .main-content {
            margin-left: var(--sb-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            height: 64px;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .page-body {
            padding: 2rem;
            flex: 1;
        }

        footer {
            padding: 1rem 2rem;
            background: white;
            border-top: 1px solid #e2e8f0;
            font-size: 0.8rem;
        }

        @@media (max-width: 992px) {
            .page-body {
                padding: 0rem;
                flex: 1;
            }
            .sidebar
            {
                transform: translateX(-100%);
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            }
            /* Logo Styling */
            .sidebar-header {
                border-bottom: 1px solid rgba(255,255,255,0.05);
                background: rgba(0, 0, 0, 0.1); /* Subtle contrast for logo area */
            }

            .main-logo {
                filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
                transition: transform 0.3s ease;
            }

            .sidebar-brand:hover .main-logo {
                transform: scale(1.05);
            }

            /* Sidebar Scrollbar Styling (Modern Thin Look) */
            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: var(--sb-bg);
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: #475569;
                border-radius: 10px;
            }

            /* Brand Text spacing */
            .brand-text {
                letter-spacing: 2px;
            }

            /* Ensure Nav Items have space if menus are always open */
            .nav-link i {
                width: 20px; /* Fixed width for icons to keep text aligned */
                text-align: center;
            }
        }
    </style>
</head>
<body>


