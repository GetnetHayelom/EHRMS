@model PIS2.Models.personModel
@{
}
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="card-title fw-bold m-0"><i class="bi bi-person-badge me-2"></i>Personal Info</h5>
    </div>

    <div class="card-body pt-0">
        <div class="text-center mb-3">
            <div class="avatar-lg bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2">
                <img src="/images/@(Model.personID).jpg" class="rounded-circle border shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture"
                     onerror="this.onerror=null; this.src='/images/@(Model.personGender == Models.Gender.Female ? "female-default.png" : "male-default.png")';">
            </div>
            <h5 class="fw-bold mb-0">
                <a href="@Url.Page("/Person/Details", new { id = Model.personID })" class="text-decoration-none">
                    @Model.personFullName
                </a>
            </h5>
            @if (Model.Employments?.Any() == true)
            {
                <a href="/Employment/Details?id=@(Model.Employments?.FirstOrDefault(e => e.employmentStatus == Models.mainStatus.Active)?.employmentID)">
                    <span class="badge @(Model.Employments.Any(e => e.employmentStatus == Models.mainStatus.Active) ? "bg-success" : "bg-danger") rounded-pill">
                        @(Model.Employments?.OrderByDescending(e => e.employmentDate).FirstOrDefault()?.employmentStatus.ToString() ?? "Not Employed")
                    </span>
                </a>
            }
            
            
        </div>

        <!--PERSON INFORMATION-->
        <ul class="list-group list-group-flush small">
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Phone:</span>
                <span class="fw-bold">@Model.personPhoneNumber</span>
            </li>
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Email:</span>
                <span class="fw-bold text-truncate ms-2">@Model.personEmailAddress</span>
            </li>
            <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">DOB:</span>
                <span class="fw-bold">@Model.personDoB.ToString("MMM dd, yyyy")</span>
            </li>
            <li class="list-group-item px-0 border-0">
                <span class="text-muted d-block mb-1">Address:</span>
                <span class="fw-bold small text-muted">@Model.addressModel?.addressFormatted</span>
            </li>
        </ul>
    </div>
</div>