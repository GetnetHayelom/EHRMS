
@model List<PIS2.Views.ExpiringLeaveDto>

<!--SUMMARY POINTS-->
<div class="card p-2 mb-4 shadow-sm">
    <div class="d-flex gap-3 d-print-flex">
        <div class="flex-fill">
            <div class="card shadow-sm border-start border-info border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Employees</small>
                            <h3 class="fw-bold mb-0"><u id="">@(Model.Count().ToString("N0"))</u></h3>
                        </div>
                        <div><i class="bi bi-file-text fs-2 text-info"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-primary border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Days per Employee</small>
                            <h3 class="fw-bold mb-0"><u id="">@(Model.Average(e => e.days).ToString("N2"))</u></h3>
                        </div>
                        <div><i class="bi bi-calendar fs-2 text-primary"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-warning border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total Days</small>
                            <h3 class="fw-bold mb-0"><u >@(Model.Sum(e => e.days).ToString("N2"))</u></h3>
                        </div>
                        <div><i class="bi bi-exclamation-circle fs-2 text-warning"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-success border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Max</small>
                            <h3 class="fw-bold mb-0"><u >@(Model.Max(e => e.days).ToString("N2"))</u></h3>
                        </div>
                        <div><i class="bi bi-people fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-danger border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Meadian</small>
                            <h3 class="fw-bold mb-0"><u >@(((Model.Max(e =>e.days) + Model.Min(e => e.days))/2).ToString("N2"))</u></h3>
                        </div>
                        <div><i class="bi bi-clock fs-2 text-danger"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-success border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Cost</small>
                            <h3 class="fw-bold mb-0"><u >@(Model.Sum(e => e.Cost)?.ToString("N2"))</u></h3>
                        </div>
                        <div><i class="bi bi-currency-dollar fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<table class="table table-striped table-hover" id="expireTable">
    <thead class="table-dark">
        <tr>
            <th>S/No</th>
            <th>Emp.ID</th>
            <th>Full Name</th>
            <th>Gender</th>
            <th>Department</th>
            <th>Days</th>
            <th>Expire Date</th>
            <th class="d-print-none text-end px-2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            int expIndex = 1;
        }
        @foreach (var exp in Model.OrderBy(e => e.CompanyName).GroupBy(e => e.CompanyName))
        {
            <tr><th colspan="8">@exp.Key (@exp.Count())</th></tr>
            @foreach (var e in exp.OrderBy(e => e.DepartmentName).ThenBy(e => e.givenID))
            {
                <tr>
                    <td>@expIndex</td>
                    <td>@e.givenID</td>
                    <td>@e.FullName</td>
                    <td>@e.Gender</td>
                    <td>@e.DepartmentName</td>
                    <td>@e.days</td>
                    <td>@e.expDate.ToString("MM/dd/yy")</td>
                    <td class="d-print-none text-end px-2">
                        <a asp-page="/Leave/Create" asp-route-id="@e.employmentID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
                expIndex++;
            }

        }

    </tbody>
</table>