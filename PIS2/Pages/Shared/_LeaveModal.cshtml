
@model PIS2.Pages.Department.DetailsModel

<div class="modal fade" id="LeaveModal" tabindex="-1" aria-labelledby="LeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="LeaveModalLabel">Active Leaves</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-hover">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Leave No</th>
                            <th>Employee ID</th>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.leaveModel)
                        {
                            <tr>
                                <td><a asp-page="/Leave/Details" asp-route-id="@item.leaveID">@item.leaveID</a></td>
                                <td>@item.employmentModel.givenID</td>
                                <td>@item.leaveReaquestDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.leaveStartDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.leaveEndDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.leaveDays</td>
                                <td>@item.leaveTypeModel.leaveTypeName</td>
                                <td>@item.leaveStatus</td>
                                <td class="d-flex justify-content-between flex-grow-1">
                                    @if (item.leaveStatus == Models.leaveStatus.Posted)
                                    {
                                        <p>Leave is approved; No further action.</p>
                                    }
                                    else
                                    {
                                        <div class="btn-group w-100" role="group">
                                            <input type="radio" class="btn-check approval-radio"
                                                   name="approvalStatus_@item.leaveID"
                                                   id="approve_@item.leaveID"
                                                   value="approve"
                                                   data-id="@item.leaveID"
                                                   data-action="1"
                                                   data-type="1">
                                            <label class="btn btn-outline-success rounded-circle d-flex align-items-center justify-content-center"
                                                   style="width:40px; height:40px;"
                                                   for="approve_@item.leaveID">
                                                <i class="fas fa-check"></i>
                                            </label>

                                            <input type="radio" class="btn-check approval-radio"
                                                   name="approvalStatus_@item.leaveID"
                                                   id="reject_@item.leaveID"
                                                   value="reject"
                                                   data-id="@item.leaveID"
                                                   data-action="2"
                                                   data-type="1">
                                            <label class="btn btn-outline-danger rounded-circle d-flex align-items-center justify-content-center text-white"
                                                   style="width:40px; height:40px;"
                                                   for="reject_@item.leaveID">
                                                <i class="fas fa-times"></i>
                                            </label>
                                        </div>

                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a asp-page="./Details" asp-route-id="@Model.departmentModel.departmentID" class="btn btn-secondary">Close</a>
                
            </div>
        </div>
    </div>
</div>
