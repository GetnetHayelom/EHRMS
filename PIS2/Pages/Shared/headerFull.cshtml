
@{
    Layout = null;
    var refNo = ViewData["RefNo"] as string;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Printable Letter</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/icons/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PIS2.styles.css" asp-append-version="true" />
    <style>
        @@media print {

            body {
                margin: 0;
                font-family: Arial, sans-serif;
                font-size: 13px;
            }

            ul {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                height: 100%;
            }
            nav, button {
                display: none !important;
            }

            .d-print-flex {
                display: flex !important;
            }

            .print-footer {
                position: fixed;
                bottom: 15mm; /* align with page margin */
                left: 0;
                width: 100%;
                font-size: 11px;
                text-align: center;
            } 

            @@page {
                size: A4;
                margin: 15mm 15mm 30mm 15mm;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow mb-3 d-print-none">
            <div class="container">
                <a class="navbar-brand text-white" asp-area="" asp-page="/Index"><b>Mesfin-HRMS</b></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item ">
                            <a class="nav-link text-white" asp-area="" asp-page="/Index" style="">Home</a>
                        </li>
                        @if (User.IsInRole("HRADMIN"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">System Setup</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/Address/Index">Addresses</a>
                                    <a class="dropdown-item" asp-page="/EducationLevel/Index">Education Levels</a>
                                    <a class="dropdown-item" asp-page="/Holiday/Index">Holidays</a>
                                    <a class="dropdown-item" asp-page="/Overtime/Index">Overtime</a>
                                    <a class="dropdown-item" asp-page="/JobCategory/Index">Job Categories</a>
                                    <a class="dropdown-item" asp-page="/JobClass/Index">Job Classes</a>
                                    <a class="dropdown-item" asp-page="/TaxRate/Index">Tax Rates</a>
                                </div>
                            </li>


                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">Company Setup</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/WorkSite/Index">Worksites</a>
                                    <a class="dropdown-item" asp-page="/Shift/Index">Shift</a>
                                    <a class="dropdown-item" asp-page="/Account/Index">Accounts</a>
                                    <a class="dropdown-item" asp-page="/SubAccount/Index">Sub-Accounts</a>
                                    <a class="dropdown-item" asp-page="/Company/Index">Companies</a>
                                    <a class="dropdown-item" asp-page="/Department/Index">Departments</a>
                                    <a class="dropdown-item" asp-page="/Structure/Index">Structure</a>
                                    <a class="dropdown-item" asp-page="/Earning/Index">Compensation & Benefits</a>
                                    <a class="dropdown-item" asp-page="/Deduction/Index">Deduction</a>
                                    <a class="dropdown-item" asp-page="/EvaluationType/Index">Evaluation</a>
                                </div>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">HR Setup</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/JobGrade/Index">Job Grades</a>
                                    <a class="dropdown-item" asp-page="/JobStep/Index">Job Step</a>
                                    <a class="dropdown-item" asp-page="/Job/Index">Jobs</a>
                                    <a class="dropdown-item" asp-page="/EmploymentType/Index">Employment Types</a>
                                    <a class="dropdown-item" asp-page="/Overtime/Index">Overtime Setup</a>
                                    <a class="dropdown-item" asp-page="/Break/Index">Breaks</a>
                                    <a class="dropdown-item" asp-page="/LeaveType/Index">Leave Setup</a>
                                    <a class="dropdown-item" asp-page="/Allowance/Index">Allowance Setup</a>
                                    <a class="dropdown-item" asp-page="/EmploymentMethod/Index">Employment Methods</a>
                                    <a class="dropdown-item" asp-page="/PenaltyType/Create">Penalty Setup</a>
                                    <a class="dropdown-item" asp-page="/Earning/Create">Earning Types</a>
                                    <a class="dropdown-item" asp-page="/Deduction/Create">Deduction Types</a>
                                    <a class="dropdown-item" asp-page="/Loyalty/Index">Loyalty Setup</a>
                                    <a class="dropdown-item" asp-page="/LetterType/Index">Letter Types</a>
                                </div>
                            </li>
                        }
                        @if (User.IsInRole("HRPERSONNEL"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">HR Personnel</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/Person/Index">Person</a>
                                    <a class="dropdown-item" asp-page="/Employment/Index">Employments</a>
                                    <a class="dropdown-item" asp-page="/JobPlacement/Index">Job Placements</a>
                                    <a class="dropdown-item" asp-page="/AllowanceAssignment/Create">Allowance Assignment</a>
                                    <a class="dropdown-item" asp-page="/Leave/Index">Leave Requests</a>
                                    <a class="dropdown-item" asp-page="/Absentism/Create">Absenteeism</a>
                                    <a class="dropdown-item" asp-page="/OvertimeRecord/Index">Overtime Records</a>
                                    <a class="dropdown-item" asp-page="/EmployeeService/Index">Earnings</a>
                                    <a class="dropdown-item" asp-page="/Penalty/Create">Penalties</a>
                                    <a class="dropdown-item" asp-page="/BankInfo/Index">Bank Information</a>
                                    <a class="dropdown-item" asp-page="/Notice/Index">Notice Board</a>
                                    <a class="dropdown-item" asp-page="/Prohibition/Create">Prohibition</a>
                                    <a class="dropdown-item" asp-page="/Experience/Index">Experience</a>
                                    <a class="dropdown-item" asp-page="/ServiceRequest/Index">Employee Requests</a>
                                    <a class="dropdown-item" asp-page="/Letter/Index">Letter & Correspondance</a>
                                    <a class="dropdown-item" asp-page="/Delegation/Index">Delegations</a>
                                </div>
                            </li>
                        }
                        @if (User.IsInRole("HRMANAGER") || User.IsInRole("HRPERSONNEL"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">Talent Aquisition</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">

                                    <a class="dropdown-item" asp-page="/Employment/Create">New Employment</a>

                                    <a class="dropdown-item" asp-page="/JobRequirement/Index">Employment Requests</a>
                                    <a class="dropdown-item" asp-page="/Vacancy/Index">Vacancy</a>
                                    <a class="dropdown-item" asp-page="/Applications/Index">Applicants</a>
                                    <a class="dropdown-item" asp-page="/JobReqCost/Index">Aquisition Cost</a>

                                </div>
                            </li>
                        }
                        @if (User.IsInRole("HRMANAGER") || User.IsInRole("HRPERSONNEL"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">Training</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">

                                    <a class="dropdown-item" asp-page="/Training/TrainingCenter">Training Center</a>

                                    <a class="dropdown-item" asp-page="/Training/Index">Training Catalog</a>
                                    <a class="dropdown-item" asp-page="/TrainingSession/Index">Sessions</a>


                                </div>
                            </li>
                        }
                        @if (User.IsInRole("ADMIN"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" role="button" data-bs-toggle="dropdown">Sys Admin</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-page="/Users/Index">Users</a>
                                    <a class="dropdown-item" asp-page="/SysAdmin/BackupDatabase">Backup</a>
                                    <a class="dropdown-item" asp-page="/SysAdmin/RestoreDatabase">Restore</a>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole("HRMANAGER"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/HRClerk/Index">HR Dashboard</a>
                            </li>
                        }

                        @if (User.IsInRole("HRPERSONNEL") || User.IsInRole("HRMANAGER") || User.IsInRole("MANAGEMENT"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">Reporting</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/Management/Index">Management</a>
                                    <a class="dropdown-item" asp-page="/Report/LeaveReport">Leave and Attendance</a>
                                    <a class="dropdown-item" asp-page="/Report/OvertimeRecordReport">Overtime</a>
                                    <a class="dropdown-item" asp-page="/Report/AllowanceAssignmentReport">Allowance</a>
                                    <a class="dropdown-item" asp-page="/Report/EmploymentReport">Employment</a>
                                    <a class="dropdown-item" asp-page="/Termination/Index">Termination</a>
                                    <a class="dropdown-item" asp-page="/Report/JobPlacementReport">Job Placements</a>
                                    <a class="dropdown-item" asp-page="/PersonEducationLevel/Index">Training & Certification</a>
                                    <a class="dropdown-item" asp-page="/Structure/Index">Structure and Job Maping</a>
                                    <a class="dropdown-item" asp-page="/Report/PenaltyReport">Penalties</a>
                                    <a class="dropdown-item" asp-page="/Report/CostAnalysisReport">Cost Analytics</a>
                                    <a class="dropdown-item" asp-page="/Report/EvaluationReport">Performance Analytics</a>
                                </div>
                            </li>
                        }
                        @if (User.IsInRole("MANAGEMENT"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Department/Details">Department</a>
                            </li>
                        }
                        @if (User.IsInRole("HRMANAGER") || User.IsInRole("HRMANAGER") || User.IsInRole("PAYROLL") || User.IsInRole("FINANCE"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" asp-area="" role="button" data-bs-toggle="dropdown">Payroll</a>
                                <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <a class="dropdown-item" asp-page="/Payroll/Index">Payrolls</a>
                                    <a class="dropdown-item" asp-page="/EarningRecord/Create">Add Earning</a>
                                    <a class="dropdown-item" asp-page="/DeductionRecord/Create">Add Deduction</a>
                                    <a class="dropdown-item" asp-page="/Benefits/Index">Other Payments</a>
                                </div>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Privacy">Help</a>
                        </li>
                    </ul>
                    <p class="nav navbar-text text-white">Hello, @User.Identity?.Name!</p>
                </div>
            </div>
        </nav>
    </header>

    <div class="d-print-flex container print-full-width">
        <main role="main" class="pb-3">
            <!-- HEADER -->
            <div class="d-none d-print-block">
                <div class="d-flex d-print-flex align-items-center justify-content-between mb-2">

                    <div style="width:15%;">
                        <img src="/assets/logo_full.png" style="width:100%; max-height:80px;" />
                    </div>

                    <div style="width:70%; text-align:center;">
                        <h3 style="margin:0;" class="fw-bold">
                            Company Name1  <small>Prefix1</small>
                        </h3>
                        <h2 style="margin:0;" class="fw-bold">
                            Company Name2 <small>Prefix2</small>
                        </h2>

                        <div class="d-print-flex d-flex justify-content-around">
                            <div style="width:50%;">
                                <p style="margin:0;">Address Head Office</p>
                                <p style="margin:0;">Tel: 00000</p>
                                <p style="margin:0;">P.O.Box 000 | info@company.com</p>
                            </div>
                            <div style="width:50%;">
                                <p style="margin:0;">Address2</p>
                                <p style="margin:0;">Tel: 00000</p>
                                <p style="margin:0;">P.O.Box 000 | info@company.com</p>
                            </div>
                        </div>

                        <p style="margin:0;">Website: www.company.com</p>
                    </div>

                    <div style="width:15%; text-align:right;">
                        <img src="/assets/logo_full.png" style="width:100%; max-height:80px;" />
                    </div>
                </div>

                <!-- DATE -->
                <div class="d-flex d-print-flex justify-content-end">
                    <p style="margin:0;">
                        <strong>Date:</strong>
                        <u>@DateTime.Now.ToString("dd/MM/yyyy")</u>
                    </p>
                </div>
                <div class="d-flex d-print-flex justify-content-end">
                    <p style="margin:0;"><strong>Ref.No:</strong> 
                        <u>@(string.IsNullOrEmpty(refNo) ? "_________" : refNo)</u>
                    </p>
                </div>
                <hr class="d-block d-print-block border border-dark border-4" />
            </div>
            
        
            <!-- BODY -->
           
            <div class="d-flex d-print-flex container print-full-width" style="padding-bottom:35mm">
                <!--LEFT SIDE-->
                <div style="width:20%; border-right:1px solid #000; padding-right:10px;" class="d-none d-print-block">
                    <h6 class="fw-bold">Main Products & Services</h6>
                    <ul class="h-100 d-flex flex-column justify-content-evenly">
                        <li class="mt-4"><strong>Product\Service1</strong></li>
                        <li class="mt-4"><strong>Product\Service2</strong></li>
                        <li class="mt-4"><strong>Product\Service3</strong></li>
                        <li class="mt-4"><strong>Product\Service4</strong></li>
                        <li class="mt-4"><strong>Product\Service5</strong></li>
                    </ul>
                </div>
                <!--LETTER BODY-->
                <div style="width:80%; padding-left:15px; margin-top:20px;">
                    @RenderSection("LetterBody", required: true)
                </div>

            </div>
            
        </main>
    </div>
    <div style="position:fixed; bottom:0;" class="d-none print-footer print-full-width w-100">
        <hr class="d-block d-print-block border border-dark border-2 bg-dark" />
        <div class="d-flex d-print-flex justify-content-center">
            ISO 9001:2000 QMS Certified By BSI – Certificate No. 000000
        </div>
    </div>

</body>
<!-- FOOTER -->


</html>
