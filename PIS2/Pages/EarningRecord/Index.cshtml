@page
@model PIS2.Pages.EarningRecord.IndexModel
@{
    ViewData["Title"] = "Earnings";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Earning Records</h3>
        <a class="btn btn-primary" asp-page="Create">+ Add Earning</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>S/N</th>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Type</th>
                        <th>Iteration</th>
                        <th>Amount</th>
                        <th>Is %</th>
                        <th>Base</th>
                        <th>Status</th>
                        <th style="width:130px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sn = 1;
                    }
                    @foreach (var item in Model.Earnings)
                {
                    <tr>
                        <td>@sn</td>
                        <td>@item.EmploymentModel?.givenID</td>
                        <td>@item.EmploymentModel?.personModel?.personFullName</td>
                        <td>@item.earningType?.earningTypeName</td>
                        <td>@item.earningIteration</td>
                        <td>@item.earningAmount</td>
                        <td>@(item.IsPercentage ? "Yes" : "No")</td>
                        <td>@item.earningBase</td>
                        <td>@item.earningStatus</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@item.earningID" class="btn btn-sm btn-warning">Edit</a>
                        </td>
                        </tr>
                        sn++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
