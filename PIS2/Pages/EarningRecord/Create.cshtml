@page
@model PIS2.Pages.EarningRecord.CreateModel

@{
    ViewData["Title"] = "Create Earning";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<h2 class="fw-bold">Employee Earning</h2>
<div class="container mt-4">

    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Earning</h4>
        </div>

        <div class="card-body">

            <!-- 🔍 SEARCH EMPLOYEE FIRST -->
            <div class="mb-4">
                <label class="form-label"><b>Search Employee by GivenID</b></label>
                <div class="input-group">
                    <input id="employeeLookupInput" type="text" class="form-control" placeholder="Enter Given ID..." />
                    <button type="button" id="employeeLookupBtn" class="btn btn-primary">Search</button>
                </div>
                <small class="text-muted">Employee selection is required before creating an earning.</small>
            </div>

            <!-- ❌ NOT FOUND -->
            <div id="notFoundMessage" class="alert alert-danger d-none">
                No employee found with the provided ID.
            </div>

            <!-- ✅ EMPLOYEE INFO CARD -->
            <div id="employeeCard" class="card border-info shadow-sm mb-4 d-none">
                <div class="card-body">
                    <h5 class="card-title" id="empName"></h5>
                    <p class="card-text mb-1"><b>Job:</b> <span id="empJob"></span></p>
                    <p class="card-text mb-1"><b>Department:</b> <span id="empDept"></span></p>
                    <p class="card-text mb-1"><b>Company:</b> <span id="empCompany"></span></p>
                </div>
            </div>

            <!-- 📝 CREATE FORM (Hidden until employee found) -->
            <form id="earningForm" method="post" class="d-none">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Earning.employmentID" id="employmentID" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Earning Type</label>
                        <select asp-for="Earning.earningTypeId" class="form-select" asp-items="Model.EarningTypes"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Iteration (Months)</label>
                        <input asp-for="Earning.earningIteration" type="number" min="1" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Is Percentage?</label>
                        <select asp-for="Earning.IsPercentage" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No (Fixed)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Earning Base</label>
                        <select asp-for="Earning.earningBase" class="form-select">
                            @foreach (var baseVal in Enum.GetValues(typeof(Models.deductionBase)))
                            {
                                <option value="@baseVal">@baseVal</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input asp-for="Earning.earningAmount" type="number" step="0.01" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="Earning.earningStatus" class="form-select">
                            @foreach (var st in Enum.GetValues(typeof(Models.mainStatus)))
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Earning</button>
                </div>
            </form>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        async function loadForm(empID){
            const res = await fetch(`/api/core/EmployeeLookup/${empId}`);
            const data = await res.json();

            const notFound = document.getElementById("notFoundMessage");
            const card = document.getElementById("employeeCard");
            const form = document.getElementById("earningForm");

            if (!data || !data.isFound) {
                notFound.classList.remove("d-none");
                card.classList.add("d-none");
                form.classList.add("d-none");
                return;
            }

            // Hide error
            notFound.classList.add("d-none");

            // Fill Card
            document.getElementById("empName").textContent = data.employeeName;
            document.getElementById("empJob").textContent = data.jobTitle;
            document.getElementById("empDept").textContent = data.department;
            document.getElementById("empCompany").textContent = data.company;
            document.getElementById("employeeInput").textContent = data.employmentID;
            // Set employment id for form
            document.getElementById("employmentID").value = data.employmentID;

            // Reveal card + form
            card.classList.remove("d-none");
            form.classList.remove("d-none");
        }
        document.getElementById("employeeLookupBtn").addEventListener("click", async () => {

            const empId = document.getElementById("employeeLookupInput").value.trim();
            if (!empId) return;

            loadForm(empID);
            
        });
    </script>
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            const autoID = "@ViewData["GivenID"]";

            if (autoID && autoID !== "") {
                loadForm(autoID);
            }
        });
    </script>
}
