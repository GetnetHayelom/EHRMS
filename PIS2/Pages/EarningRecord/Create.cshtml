@page
@using PIS2.Enums
@model PIS2.Pages.EarningRecord.CreateModel

@{
    ViewData["Title"] = "Create Earning";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<h2 class="fw-bold">Compensation & Benefits</h2>
<div class="container mt-4">

    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h6 class="fw-bold mb-0">Add New Earning</h6>
        </div>

        <div class="card-body">

            <!-- 🔍 SEARCH EMPLOYEE FIRST -->
            <div class="mb-4 col-md-4">
                <label class="form-label">Enter Employee ID</label>
                <div class="input-group col-md-4">
                    <input id="employeeInput" type="text" class="form-control" placeholder="Enter employee givenID">
                    <button id="searchEmployeeBtn" type="button" class="btn btn-primary">Search</button>
                </div>

                <div id="employeeNotFound" class="alert alert-danger mt-3 d-none">
                    Employee not found.
                </div>

                <div id="employeeInfo" class="alert alert-info mt-3 d-none">
                    <strong>Name:</strong> <span id="empName"></span><br />
                    <strong>Job Title:</strong> <span id="empJob"></span><br />
                    <strong>Department:</strong> <span id="empDept"></span><br />
                    <strong>Company:</strong> <span id="empCompany"></span>
                </div>
            </div>
           
           
            <!-- ❌ NOT FOUND -->
            <div id="notFoundMessage" class="alert alert-danger d-none">
                No employee found with the provided ID.
            </div>

            <!-- ✅ EMPLOYEE INFO CARD -->
            <div id="employeeCard" class="card border-info shadow-sm mb-4 d-none">
                <div class="card-body">
                    <h5 class="card-title" id="empName"></h5>
                    <p class="card-text mb-1"><b>Job:</b> <span id="empJob"></span></p>
                    <p class="card-text mb-1"><b>Department:</b> <span id="empDept"></span></p>
                    <p class="card-text mb-1"><b>Company:</b> <span id="empCompany"></span></p>
                </div>
            </div>

            <!-- 📝 CREATE FORM (Hidden until employee found) -->
            <form id="earningForm" method="post" class="d-none">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Earning.employmentID" id="hiddenEmploymentID"/>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Earning Type</label>
                        <select asp-for="Earning.earningTypeID" class="form-select" id="earningTypeSelect" onchange="togglePayroll()">
                            <option value="">--Select Type--</option>
                            @foreach (var et in Model.EarningTypes)  // your actual earning types list
                            {
                                <option value="@et.earningTypeID" data-ispayroll="@et.isPayroll">
                                    @et.earningTypeName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input asp-for="Earning.earningAmount" type="number" step="0.01" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="Earning.earningStatus" class="form-select">
                            @foreach (var st in Enum.GetValues(typeof(mainStatus)))
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row g-3 mt-2" id="payrollRelated" style="display:none;">
                    <div class="col-md-4">
                        <label class="form-label">Iteration (Months)</label>
                        <input asp-for="Earning.earningIteration" type="number" min="1" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Is Percentage?</label>
                        <select asp-for="Earning.IsPercentage" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No (Fixed)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Earning Base</label>
                        <select asp-for="Earning.earningBase" class="form-select">
                            @foreach (var baseVal in Enum.GetValues(typeof(Enums.deductionBase)))
                            {
                                <option value="@baseVal">@baseVal</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Earning</button>
                </div>
            </form>

        </div>
    </div>
</div>


<script>
    async function loadForm(empId){
        const response = await fetch(`/api/core/EmployeeLookup/${empId}`);
        const data = await response.json();

        const notFoundDiv = document.getElementById("employeeNotFound");
        const infoDiv = document.getElementById("employeeInfo");
        const form = document.getElementById("earningForm");

        if (!data.isFound) {
            notFoundDiv.classList.remove("d-none");
            infoDiv.classList.add("d-none");
            form.classList.add("d-none");
            return;
        }

        // Hide Not Found
        notFoundDiv.classList.add("d-none");

        // Fill Employee Info
        document.getElementById("empName").innerText = data.employeeName;
        document.getElementById("empJob").innerText = data.jobTitle;
        document.getElementById("empDept").innerText = data.department;
        document.getElementById("empCompany").innerText = data.company;
        document.getElementById("employeeInput").innerText = empId;

        infoDiv.classList.remove("d-none");

        // Assign employmentID to hidden field
        document.getElementById("hiddenEmploymentID").value = data.employmentID;

        // Show main form
        form.classList.remove("d-none");
       
    }

    document.getElementById("searchEmployeeBtn").addEventListener("click", async function () {
        const empId = document.getElementById("employeeInput").value.trim();
        if (!empId) return;

        loadForm(empId);
    });

    function togglePayroll()
    {
        const select = document.getElementById("earningTypeSelect");
        const selected = select.options[select.selectedIndex];
        const isPayroll = selected.dataset.ispayroll === "true";

        const payrollDiv = document.getElementById("payrollRelated");

        payrollDiv.style.display = isPayroll ? "flex" : "none";
    }
</script>
<script>
    window.addEventListener("DOMContentLoaded", function () {
        const autoID = "@ViewData["GivenID"]";

        if (autoID && autoID !== "") {
            loadForm(autoID);
        }
    });
</script>