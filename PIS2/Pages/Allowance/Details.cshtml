@page
@model PIS2.Pages.Allowance.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Allowances</h1>

<div>
    <h4>Allowance Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Allowance Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceName)
        </dd>
        <dt class="col-sm-2">
           Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceDescription)
        </dd>
        <dt class="col-sm-2">
            Amount:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceAmount)
        </dd>
        <dt class="col-sm-2">
            Taxable:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceTaxable)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.allowanceModel.allowanceID">@L.T("Edit")</a> |
    <a asp-page="./Index">Back to List</a>
</div>
