@page
@model PIS2.Pages.Allowance.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Allowances Types</h1>

<p>
    <a asp-page="Create" class="btn btn-primary d-print-none">Add New Allowance</a>
</p>
<!-- SUMMARY CARDS -->
<div class="d-flex gap-3 mb-4 d-print-none flex-wrap">

    <!-- Active -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-success border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Active Allowance Types</small>
                        <h3 class="fw-bold mb-0">@Model.ActiveCount</h3>
                    </div>
                    <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Suspended -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-warning border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Suspended</small>
                        <h3 class="fw-bold mb-0">@Model.SuspendedCount</h3>
                    </div>
                    <div><i class="bi bi-pause-circle fs-2 text-warning"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Disabled -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-secondary border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Disabled</small>
                        <h3 class="fw-bold mb-0">@Model.DisabledCount</h3>
                    </div>
                    <div><i class="bi bi-x-circle fs-2 text-secondary"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-primary border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Allowance Types</small>
                        <h3 class="fw-bold mb-0">@Model.TotalCount</h3>
                    </div>
                    <div><i class="bi bi-collection fs-2 text-primary"></i></div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- SECOND ROW — TAXABLE / NON-TAXABLE / TOTAL AMOUNT -->
<div class="d-flex gap-3 mb-4 flex-wrap">

    <!-- Taxable -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-info border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Taxable Allowances</small>
                        <h3 class="fw-bold mb-0">@Model.TaxableCount</h3>
                    </div>
                    <div><i class="bi bi-cash-coin fs-2 text-info"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Non-taxable -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-success border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Non-Taxable</small>
                        <h3 class="fw-bold mb-0">@Model.NonTaxableCount</h3>
                    </div>
                    <div><i class="bi bi-shield-check fs-2 text-success"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total allowance amount -->
    <div class="flex-fill">
        <div class="card shadow-sm border-start border-dark border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Total Allowance Amount</small>
                        <h3 class="fw-bold mb-0">@Model.TotalAllowanceAmount.ToString("N2") / Birr</h3>
                    </div>
                    <div><i class="bi bi-wallet2 fs-2 text-dark"></i></div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="d-flex justify-content-end d-print-none">
    <div class="me-2">
        @await Html.PartialAsync("filter")
    </div>
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Allowance_Types_@(DateTime.UtcNow).xlsx"></excel-export>
</div>

<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <td>S/No</td>
            <th>
                Allowance Name
            </th>
            <th>
                Description
            </th>
            <th>
                Duration
            </th>
            <th>
                Amount
            </th>
            <th>
                Taxable
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody id="table-body">
        @{int sn=1;}
        @foreach (var item in Model.allowanceModel)
        {
            <tr>
                <td>@sn</td>
                
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceDescription)
                </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.allowanceDuration)
                    </td>
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceTaxable)
                </td>
                <td>
                    @if (item.allowanceStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.allowanceStatus)</span>

                    }
                    else if (item.allowanceStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.allowanceStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.allowanceStatus)</span>
                    }
                </td>
                 <td class="d-print-none">   @if(User.IsInRole("MIE\\PMS_HRADMIN"))
                    {
                       <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.allowanceID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.allowanceID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    }

                </td>
            </tr>
            sn++;
        }
    </tbody>
</table>

<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Allowance_Types_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
