@page
@model PIS2.Pages.Allowance.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Allowances</h1>

<h3>Are you sure you want to delete this allowance?</h3>
<div>
   
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Allowance Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceName)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceDescription)
        </dd>
        <dt class="col-sm-2">
            Amount:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceAmount)
        </dd>
        <dt class="col-sm-2">
            Taxable: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceTaxable)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.allowanceModel.allowanceStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="allowanceModel.allowanceID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
