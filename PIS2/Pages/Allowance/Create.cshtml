@page
@using PIS2.Enums
@model PIS2.Pages.Allowance.CreateModel

@{
    ViewData["Title"] = "New Allowance Type";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Allowance Setup</h1>

<h4 class="fw-bold">Add New Allowance Type</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="allowanceModel.allowanceName" class="control-label">Allowance Name</label>
                <input asp-for="allowanceModel.allowanceName" class="form-control" />
                <span asp-validation-for="allowanceModel.allowanceName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="allowanceModel.allowanceDescription" class="control-label">Description</label>
                <input asp-for="allowanceModel.allowanceDescription" class="form-control" />
                <span asp-validation-for="allowanceModel.allowanceDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="allowanceModel.allowanceAmount" class="control-label">Amount</label>
                <input asp-for="allowanceModel.allowanceAmount" class="form-control" />
                <span asp-validation-for="allowanceModel.allowanceAmount" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">Taxable: 
                    <input class="form-check-input m-2" asp-for="allowanceModel.allowanceTaxable" />
                </label>
            </div>
            <div class="form-group">
                <label asp-for="allowanceModel.allowanceDuration" class="control-label">Status</label>
                <select asp-for="allowanceModel.allowanceDuration" class="form-control" asp-items="Html.GetEnumSelectList<Enums.allowanceDuration>()"></select>
                <span asp-validation-for="allowanceModel.allowanceDuration" class="text-danger"></span>
            </div>
            <!-- Selector -->
            <div class="form-group">
                <label asp-for="allowanceModel.earningTypeID" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Earning Type
                </label>
                <input type="text" class="form-control" list="earningTypeList" placeholder="Type to search..." oninput="selector(this, 'earningTypeIDHidden')" />
                <input type="hidden" asp-for="allowanceModel.earningTypeID" id="earningTypeIDHidden" />
                <datalist id="earningTypeList">
                    @foreach (var earningType in Model.EarningType)
                    {
                        <option data-id="@earningType.Value" value="@earningType.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="allowanceModel.earningTypeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="allowanceModel.allowanceStatus" class="control-label">Status</label>
                <select asp-for="allowanceModel.allowanceStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="allowanceModel.allowanceStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div class="">
    <a asp-page="Index" class="">View All Allowance Types</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
