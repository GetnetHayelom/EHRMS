@page
@model PIS2.Pages.Account.GeneralLedgerModel

@{ ViewData["Title"] = "General Ledger"; }

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h5 class="m-0">General Ledger Entries</h5>
    </div>
    <div class="card-body p-0">
        @foreach (var entry in Model.Entries)
        {
            <div class="entry-block border-bottom p-3">
                <div class="d-flex justify-content-between mb-2">
                    <strong>@entry.EntryDate.ToShortDateString() | @entry.Reference</strong>
                    <span class="text-muted small">Modified by: @entry.modifiedBy</span>
                </div>
                <p class="text-secondary small mb-2">@entry.Description</p>
                
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr class="bg-light">
                            <th style="width: 40%">Account</th>
                            <th style="width: 30%">Sub-Account</th>
                            <th class="text-right" style="width: 15%">Debit</th>
                            <th class="text-right" style="width: 15%">Credit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in entry.Lines)
                        {
                            <tr>
                                <td>@line.Account?.accountNumber - @line.Account?.accountName</td>
                                <td>@(line.SubAccount?.subAccountName ?? "---")</td>
                                <td class="text-right">@(line.Debit > 0 ? line.Debit.ToString("N2") : "")</td>
                                <td class="text-right">@(line.Credit > 0 ? line.Credit.ToString("N2") : "")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold">
                            <td colspan="2" class="text-right">Totals:</td>
                            <td class="text-right">@entry.Lines.Sum(l => l.Debit).ToString("N2")</td>
                            <td class="text-right">@entry.Lines.Sum(l => l.Credit).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .entry-block:nth-child(even) { background-color: #fcfcfc; }
    .table-sm { font-size: 0.875rem; }
</style>