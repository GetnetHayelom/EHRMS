@page
@model PIS2.Pages.Account.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Accounts</h1>

<h3>Are you sure you want to delete this account?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Account Number:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountNumber)
        </dd>
        <dt class="col-sm-2">
            Account Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountName)
        </dd>
        <dt class="col-sm-2">
            Description: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="accountModel.accountID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
