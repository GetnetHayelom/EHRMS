@page
@using PIS2.Enums
@model PIS2.Pages.Penalty.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-print-none">
    <h1 class="fw-bold">Penalty</h1>

    <h4 class="fw-bold">New Penalty Record</h4>
</div>
<hr />
<div class="row print-full-width">
    <!-- Left Column -->
    <div class="col-md-4 d-print-none">
        <!-- Search Employee Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light fw-bold">
                Look up by Employee ID
            </div>

            <div class="card-body">
                <form method="get" class="d-flex">
                    <input id="givenID" name="searchID" type="text"
                           class="form-control me-2"
                           asp-for="@Model.Employment.givenID"
                           placeholder="Enter Employee ID"
                           list="givenIDList" />
                    <button type="submit" class="btn btn-primary">View</button>
                </form>

                <div class="mt-3">
                    @if (Model.Employment != null && Model.Employment.employmentID != 0)
                    {
                        <h5 class="fw-bold text-success">
                            @Model.Employment?.personModel?.personFullName
                        </h5>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-2" role="alert">
                            @successMessage
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- Penalty Form / Employee Status Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                @if (Model.Employment == null || Model.Employment.employmentID == 0)
                {
                    <div class="bg-info text-white p-3 rounded">
                        <h5>Select an Employee to Procceed</h5>
                    </div>
                }
                else if (Model.Employment?.employmentStatus == mainStatus.Inactive)
                {
                    <div class="bg-danger text-white p-3 rounded">
                        <h5>Employee is Inactive</h5>
                    </div>
                }
                else if (Model.Employment?.employmentStatus == mainStatus.Active)
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="penaltyModel.employmentID" value="@Model.Employment.employmentID" type="hidden" />
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyIssueDate" class="control-label">Issue Date</label>
                            <input asp-for="penaltyModel.penaltyIssueDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" type="date" />
                            <span asp-validation-for="penaltyModel.penaltyIssueDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyReason" class="control-label">Reason</label>
                            <input asp-for="penaltyModel.penaltyReason" class="form-control" />
                            <span asp-validation-for="penaltyModel.penaltyReason" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyReference" class="control-label">Reference</label>
                            <input asp-for="penaltyModel.penaltyReference" class="form-control" />
                            <span asp-validation-for="penaltyModel.penaltyReference" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyTypeID" class="control-label">Penalty Type</label>
                            <select asp-for="penaltyModel.penaltyTypeID" class="form-control" asp-items="Model.PenaltyTypes" id="penaltyType"></select>
                        </div>
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyStartDate" class="control-label">Start Date</label>
                            <input asp-for="penaltyModel.penaltyStartDate" class="form-control" type="date" placeholder="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="penaltyModel.penaltyStartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="penaltyModel.penaltyEndDate" class="control-label">End Date</label>
                            <input asp-for="penaltyModel.penaltyEndDate" class="form-control" type="date" placeholder="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="penaltyModel.penaltyEndDate" class="text-danger"></span>
                        </div>

                        <div class="form-group d-flex justify-content-end">
                            <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
                        </div>
                    </form>
                }
                else
                {
                    <div class="bg-danger p-4 text-white"><h4>Employee Is Not Active</h4></div>
                }
             </div>
        </div>
    </div>
    <!-- Right Column -->
    <div class="col-md-8 print-full-width">
        @if (Model.Penalties != null && Model.Penalties.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Employee Penalty History</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <div><strong>Employee ID:</strong> <u>@Model.Employment?.givenID</u></div>
                        <div><strong>Name:</strong> <u>@Model.Employment?.personModel?.personFullName</u></div>
                    </div>

                    <table class="table table-striped table-hover align-middle print-full-width">
                        <thead class="table-dark">
                            <tr>
                                <th>Issue Date</th>
                                <th>Type</th>
                                <th>Reason</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Status</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prob in Model.Penalties.OrderByDescending(p => p.penaltyIssueDate))
                            {
                                <tr onclick="location.href='@Url.Page("Details", new { id = prob.penaltyID })'"
                                    style="cursor:pointer;">
                                    <td>@prob.penaltyIssueDate.ToString("MM/dd/yyyy")</td>
                                    <td>@prob.penaltyTypeModel?.penaltyName</td>
                                    <td>@prob.penaltyReason</td>
                                    <td>@prob.penaltyStartDate?.ToString("MM/dd/yyyy")</td>
                                    <td>@prob.penaltyEndDate?.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        @if (prob.penaltyStatus == Enums.penaltyStatus.Post)
                                        {
                                            <span class="badge bg-success">@prob.penaltyStatus</span>
                                        }
                                        else if (prob.penaltyStatus == Enums.penaltyStatus.Complete)
                                        {
                                            <span class="badge bg-secondary">@prob.penaltyStatus</span>
                                        }
                                        else if (prob.penaltyStatus == Enums.penaltyStatus.Void)
                                        {
                                            <span class="badge bg-danger">@prob.penaltyStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@prob.penaltyStatus</span>
                                        }
                                    </td>
                                   
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-end">
                        @await Html.PartialAsync("print")
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<div class="d-print-none">
    <a asp-page="Index">View All Penalties</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
