@page
@model PIS2.Pages.Penalty.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}

<h1 class="fw-bold">Penalty</h1>

<h4 class="fw-bold">New Penalty Record</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="">
            <!--form for searching using ID -->
            <label for="employeeID" class="fw-bold">Look up by Empolyee ID: </label>
            <form method="get" class="d-flex col-md-8">
                <input id="givenID" name="givenID" type="text" class="form-control mb-1 me-2" asp-for="@Model.Employment.givenID" list="givenIDList">
                <datalist id="givenIDList">
                    @if (Model.Employments != null)
                    {
                        @foreach (var item in Model.Employments)
                        {
                            <option value="@item.employmentID">@item.givenID</option>
                        }
                    }

                </datalist>
                <button type="submit" class="btn btn-primary mb-1">View</button>

            </form>
            @if (Model.Person != null)
            {
                <div>
                    <h2 class="fw-bold">@Model.Person.personFullName</h2>
                </div>
            }
            else
            {
                <div class="alert alert-danger d-print-none" role="alert">
                    @successMessage
                </div>
            }

        </div>
        <div class="col-md-8">
            @if (Model.Employment != null && Model.Employment.employmentID == 0)
            {
                <div class="bg-info p-4 text-white"><h4>Select Employee</h4></div>
            }
            else if (Model.Employment != null && Model.Employment.employmentStatus == Models.mainStatus.Inactive)
            {
                <div class="bg-danger p-4 text-white"><h4>Employee Is Inactive</h4></div>
            }
            else if (Model.Employment != null && Model.Employment.employmentStatus == Models.mainStatus.Active)
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="penaltyModel.employmentID" value="@Model.Employment.employmentID" type="hidden" />
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyIssueDate" class="control-label">Issue Date</label>
                        <input asp-for="penaltyModel.penaltyIssueDate" class="form-control" type="date" />
                        <span asp-validation-for="penaltyModel.penaltyIssueDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyReason" class="control-label">Reason</label>
                        <input asp-for="penaltyModel.penaltyReason" class="form-control" />
                        <span asp-validation-for="penaltyModel.penaltyReason" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyReference" class="control-label">Reference</label>
                        <input asp-for="penaltyModel.penaltyReference" class="form-control" />
                        <span asp-validation-for="penaltyModel.penaltyReference" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyTypeID" class="control-label">Penalty Type</label>
                        <select asp-for="penaltyModel.penaltyTypeID" class="form-control" asp-items="ViewBag.penaltyTypeID" id="penaltyType"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyStartDate" class="control-label">Start Date</label>
                        <input asp-for="penaltyModel.penaltyStartDate" class="form-control" type="date" />
                        <span asp-validation-for="penaltyModel.penaltyStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyEndDate" class="control-label">End Date</label>
                        <input asp-for="penaltyModel.penaltyEndDate" class="form-control" type="date" />
                        <span asp-validation-for="penaltyModel.penaltyEndDate" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="penaltyModel.penaltyStatus" class="control-label">Status</label>
                        <select asp-for="penaltyModel.penaltyStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Models.penaltyStatus>()"></select>
                        <span asp-validation-for="penaltyModel.penaltyStatus" class="text-danger"></span>
                    </div>

                    <div class="form-group d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-success m-2" />
                    </div>
                </form>
            }
            else
            {
                <div class="bg-danger p-4 text-white"><h4>Employee Is Not Active</h4></div>
            }
        </div>
    </div>
</div>
<div>
    <a asp-page="Index">View All Penalties</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
