@page
@model PIS2.Pages.Penalty.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].employmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].penaltyIssueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].penaltyReason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].penaltyStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].penaltyTypeModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.penaltyModel[0].modifiedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.penaltyModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyIssueDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyReason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.penaltyTypeModel.penaltyTypeID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.penaltyID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.penaltyID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.penaltyID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
