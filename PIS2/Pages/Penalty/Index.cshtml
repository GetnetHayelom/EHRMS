@page
@model PIS2.Pages.Penalty.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Penalty</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Penalty Record</a>
</p>
<hr />
@await Html.PartialAsync("filter")
<table class="table table-bordered table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Issue Date
            </th>
            <th>
                Reason
            </th>
            <th>
                Status
            </th>
            <th>
                Type
            </th>
            <th>
                Modified By
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.penaltyModel) 
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyIssueDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyReason)
                </td>
                <td>
                    @{
                        var badgeClass = item.penaltyStatus switch
                        {
                            PIS2.Models.penaltyStatus.Complete => "bg-success",
                            PIS2.Models.penaltyStatus.Pending => "bg-warning",
                            PIS2.Models.penaltyStatus.Hold => "bg-secondary",
                            PIS2.Models.penaltyStatus.Void => "bg-danger",
                            _ => "bg-primary"
                        };
                    }
                    <span class="badge rounded-pill @badgeClass" style="min-width: 80px;">
                        @item.penaltyStatus
                    </span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.penaltyTypeModel.penaltyTypeID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.modifiedBy)
                </td>
                <td>
               
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.penaltyID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.penaltyID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                </td>
            </tr>
        }
    </tbody>
</table>

