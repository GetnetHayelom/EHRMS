@page
@model PIS2.Pages.Penalty.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Penalty</h1>

<h4 class="fw-bold">Update Penalty</h4>
<hr />
<div class="d-flex gap-3">
    <div class="col-md-4 card shadow-sm m-2 p-2">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="penaltyModel.penaltyID" />
            <div class="form-group">
                <label  class="control-label">Employee ID</label>
                <input class="form-control" value="@Model.penaltyModel.employmentModel?.givenID" readonly />
                <span asp-validation-for="penaltyModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label  class="control-label">Name</label>
                <input class="form-control" type="text" value="@Model.penaltyModel.employmentModel?.personModel?.personFullName" readonly/>
                
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyIssueDate" class="control-label">Issue Date</label>
                <input asp-for="penaltyModel.penaltyIssueDate" class="form-control" type="date" />
                <span asp-validation-for="penaltyModel.penaltyIssueDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyReason" class="control-label">Reason</label>
                <input asp-for="penaltyModel.penaltyReason" class="form-control" />
                <span asp-validation-for="penaltyModel.penaltyReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyReference" class="control-label">Reference</label>
                <input asp-for="penaltyModel.penaltyReference" class="form-control" />
                <span asp-validation-for="penaltyModel.penaltyReference" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyStartDate" class="control-label">Start Date</label>
                <input asp-for="penaltyModel.penaltyStartDate" class="form-control" type="date" />
                <span asp-validation-for="penaltyModel.penaltyStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyEndDate" class="control-label">End Date</label>
                <input asp-for="penaltyModel.penaltyEndDate" class="form-control" type="date" />
                <span asp-validation-for="penaltyModel.penaltyEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyTypeID" class="control-label">Penalty Type</label>
                <select asp-for="penaltyModel.penaltyTypeID" class="form-control" asp-items="ViewBag.penaltyTypeID"></select>
            </div>
            <div class="form-group">
                <label asp-for="penaltyModel.penaltyStatus" class="control-label">Status</label>
                <select asp-for="penaltyModel.penaltyStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Models.penaltyStatus>()"></select>
                <span asp-validation-for="penaltyModel.penaltyStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    <div class="col-md-8 card shadow-sm m-2 p-2">
        <h4 class="fw-bold">Penalty History</h4>
        <table class="table table-hover table-striped">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Date</th>
                    <th>Modified By</th>
                    <th>Status</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.penaltyHistory)
                {
                    <tr>
                        <td>@item.modifiedDate</td>
                        <td>@item.modifiedBy</td>
                        <td>
                            @if (item.penaltyStatus == Models.penaltyStatus.Post)
                            {
                                <span class="badge bg-success">@item.penaltyStatus</span>
                            }
                            else if (item.penaltyStatus == Models.penaltyStatus.Complete)
                            {
                                <span class="badge bg-secondary">@item.penaltyStatus</span>
                            }
                            else if (item.penaltyStatus == Models.penaltyStatus.Void)
                            {
                                <span class="badge bg-danger">@item.penaltyStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.penaltyStatus</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Penalties</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
