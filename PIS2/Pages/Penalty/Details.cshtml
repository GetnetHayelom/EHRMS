@page
@model PIS2.Pages.Penalty.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Penalty</h1>

<div>
    <h4 class="fw-bold">Penalty Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Full Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.employmentModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            Date Issued:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.penaltyIssueDate)
        </dd>
        <dt class="col-sm-2">
            Reason:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.penaltyReason)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.penaltyStatus)
        </dd>
        <dt class="col-sm-2">
            Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.penaltyTypeModel.penaltyTypeID)
        </dd>
        <dt class="col-sm-2">
            Modified By;
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.penaltyModel.modifiedBy)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.penaltyModel.penaltyID" class="btn btn-primary m-2">Edit</a>    
</div>
<a asp-page="./Index">View All Penalties</a>