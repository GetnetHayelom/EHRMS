@page
@using PIS2.Enums
@model PIS2.Pages.LeaveType.CreateModel

@{
    ViewData["Title"] = "New Leave Type";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Leave and Absence Types</h2>

<h6 class="fw-bold text-muted">Fill new leave/absenteeism type properties to ceate new type</h6>
<hr />
<div class="">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="leaveTypeModel.leaveTypeName" class="control-label">Name</label>
                <input asp-for="leaveTypeModel.leaveTypeName" class="form-control" />
                <span asp-validation-for="leaveTypeModel.leaveTypeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveTypeModel.leaveTypeImpact" class="control-label">Impact</label>
                <select asp-for="leaveTypeModel.leaveTypeImpact" class="form-control" asp-items="Html.GetEnumSelectList<leaveTypeImpact>()"></select>
                <span asp-validation-for="leaveTypeModel.leaveTypeImpact" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveTypeModel.leaveAvailability" class="control-label">Availabilty</label>
                <select asp-for="leaveTypeModel.leaveAvailability" class="form-control">
                    <option value="Everyone">Everyone</option>
                    <option value="HR">HR</option>
                    <option value="Clinic">Clinic</option>
                    <option value="Management">Management</option>
                </select>
                <span asp-validation-for="leaveTypeModel.leaveAvailability" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveTypeModel.leaveGroup" class="control-label">Group</label>
                <select asp-for="leaveTypeModel.leaveGroup" class="form-control" asp-items="Html.GetEnumSelectList<Enums.leaveGroup>()"></select>
                <span asp-validation-for="leaveTypeModel.leaveGroup" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveTypeModel.leaveTypeStatus" class="control-label">Status</label>
                <select asp-for="leaveTypeModel.leaveTypeStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="leaveTypeModel.leaveTypeStatus" class="text-danger"></span>
            </div>
            <div class="form-group form-check m-2">
                <label class="form-check-label">
                    On-Job<input class="form-check-input" asp-for="leaveTypeModel.leaveJob" />
                </label>
            </div>
            <div class="form-group form-check m-2">
                <label class="form-check-label">
                    Legal<input class="form-check-input" asp-for="leaveTypeModel.leaveLegality" />
                </label>
            </div>
            <div class="d-flex justify-content-end m-2">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Types</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
