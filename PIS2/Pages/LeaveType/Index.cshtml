@page
@model PIS2.Pages.LeaveType.IndexModel
@{
    ViewData["Title"] = "Leave Types";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Leave Types</h3>
            <small class="text-muted d-print-none">Manage leave categories and policies</small>
        </div>

        <a asp-page="Create" class="btn btn-primary d-print-none">
            <i class="bi bi-plus-circle me-1"></i> Add Leave Type
        </a>
    </div>

    <!-- KPI ROW -->
    <div class="d-flex gap-3 mb-3">

        @{
            var cards = new[]
            {
                ("Active", Model.ActiveTypes, "success", "check-circle"),
                ("Suspended", Model.SuspendedTypes, "warning", "pause-circle"),
                ("Disabled", Model.DisabledTypes, "secondary", "x-circle"),
                ("Total", Model.TotalTypes, "primary", "collection")
                };
        }

        @foreach (var c in cards)
        {
            <div class="flex-fill">
                <div class="card shadow-sm border-start border-@c.Item3 border-1 h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">@c.Item1</small>
                            <h3 class="fw-bold mb-0">@c.Item2</h3>
                        </div>
                        <i class="bi bi-@c.Item4 fs-2 text-@c.Item3"></i>
                    </div>
                </div>
            </div>
        }

    </div>

    <!-- CATEGORY CARDS -->
    <div class="d-flex gap-3 mb-4">
        <div class="flex-fill">
            <div class="card shadow-sm border-start border-info border-2">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small>Annual Leave</small>
                        <h3 class="fw-bold">@Model.AnnualLeaveCount</h3>
                    </div>
                    <i class="bi bi-calendar-event fs-2 text-info"></i>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-success border-2">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small>Allowed Leave</small>
                        <h3 class="fw-bold">@Model.AllowedLeaveCount</h3>
                    </div>
                    <i class="bi bi-check2-square fs-2 text-success"></i>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-danger border-2">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <small>Absenteeism</small>
                        <h3 class="fw-bold">@Model.AbsentismCount</h3>
                    </div>
                    <i class="bi bi-exclamation-octagon fs-2 text-danger"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER PANEL -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="d-flex g-3 align-items-end">

                <div class="flex-fill">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="StatusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All</option>
                        @foreach (var s in Enum.GetValues(typeof(Models.mainStatus)))
                        {
                            <option value="@s" selected="@(Model.StatusFilter == (Models.mainStatus)s)">
                                @s
                            </option>
                        }
                    </select>
                </div>

                <div class="flex-fill">
                    <label class="form-label fw-semibold">Leave Group</label>
                    <select name="GroupFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All</option>
                        @foreach (var g in Enum.GetValues(typeof(Models.leaveGroup)))
                        {
                            <option value="@g" selected="@(Model.GroupFilter == (Models.leaveGroup)g)">
                                @g
                            </option>
                        }
                    </select>
                </div>

                <div class="flex-fill">
                    <label class="form-label fw-semibold">Impact</label>
                    <select name="ImpactFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All</option>
                        @foreach (var i in Enum.GetValues(typeof(Models.leaveTypeImpact)))
                        {
                            <option value="@i" selected="@(Model.ImpactFilter == (Models.leaveTypeImpact)i)">
                                @i
                            </option>
                        }
                    </select>
                </div>

                <div class="flex-fill">
                    <label class="form-label fw-semibold">Availability</label>
                    <select name="AvailabilityFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All</option>
                        @foreach (var i in Model.leaveAvailabilty)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

            </form>
        </div>
    </div>

    <!-- ACTION BAR -->
    <div class="d-flex justify-content-end ">
        <div class="flex-fill m-2">
            @await Html.PartialAsync("filter")
        </div>
            <div class="m-2">
                @await Html.PartialAsync("print")
            </div>
        <div class="m-2 d-print-none"><excel-export table="dataTable" filename="Leave_Types_@(DateTime.UtcNow).xlsx"></excel-export></div>
    </div>

    <!-- DATA TABLE -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 print-full-width" id="dataTable">

                <thead class="table-dark">
                    <tr>
                        <th>Group</th>
                        <th>Name</th>
                        <th>Impact</th>
                        <th>Availability</th>
                        <th>On Job</th>
                        <th>Status</th>
                        <th class="text-end d-print-none">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var grp in Model.leaveTypeModel.GroupBy(l => l.leaveGroup))
                    {
                        <tr class="table-primary fw-semibold">
                            <td colspan="7" class="fw-bold">@grp.Key</td>
                        </tr>

                        @foreach (var item in grp)
                        {
                            <tr>
                                <td></td>
                                <td>@item.leaveTypeName</td>
                                <td>@item.leaveTypeImpact</td>
                                <td>@item.leaveAvailability</td>
                                <td>
                                    @if (item.leaveJob)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i></span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i></span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@(item.leaveTypeStatus == Models.mainStatus.Active ? "success" :
                                                                                   item.leaveTypeStatus == Models.mainStatus.Suspended ? "warning" : "secondary")">
                                @item.leaveTypeStatus
                            </span>
                        </td>
                        <td class="text-end d-print-none">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="./Details" asp-route-id="@item.leaveTypeID" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.leaveTypeID" class="btn btn-outline-success">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                                        }
                    }

                </tbody>
            </table>
        </div>
    </div>

</div>
