@page
@model PIS2.Pages.Break.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>breakModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="breakModel.breakID" />
            <div class="form-group">
                <label asp-for="breakModel.shiftID" class="control-label"></label>
                <select asp-for="breakModel.shiftID" class="form-control" asp-items="ViewBag.shiftID"></select>
                <span asp-validation-for="breakModel.shiftID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="breakModel.breakStart" class="control-label"></label>
                <input asp-for="breakModel.breakStart" class="form-control" type="time"/>
                <span asp-validation-for="breakModel.breakStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="breakModel.breakEnd" class="control-label"></label>
                <input asp-for="breakModel.breakEnd" class="form-control" type="time"/>
                <span asp-validation-for="breakModel.breakEnd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="breakModel.breakName" class="control-label"></label>
                <input asp-for="breakModel.breakName" class="form-control" />
                <span asp-validation-for="breakModel.breakName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="breakModel.breakStatus" class="control-label"></label>
                <select asp-for="breakModel.breakStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="breakModel.breakStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
