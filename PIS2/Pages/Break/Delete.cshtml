@page
@model PIS2.Pages.Break.DeleteModel

@{
    ViewData["Title"] = "Delete Break";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Breaks</h1>

<h3>Are you sure you want to delete this break?</h3>
<div>
   
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.breakModel.breakName)
        </dd>
        <dt class="col-sm-2">
            Shift:
        </dt>
        <dd class="col-sm-10">
            @Model.breakModel.shiftModel.shiftName
        </dd>
        <dt class="col-sm-2">
            Start Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.breakModel.breakStart).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            End Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.breakModel.breakEnd).ToString("hh:mm tt")
        </dd>

        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.breakModel.breakStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="breakModel.breakID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
