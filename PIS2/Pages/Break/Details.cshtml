@page
@model PIS2.Pages.Break.DetailsModel

@{
    ViewData["Title"] = "Break Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Breaks</h1>

<div>
    <h4>Break Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.breakModel.breakName)
        </dd>
        <dt class="col-sm-2">
            Shift:
        </dt>
        <dd class="col-sm-10">
            @Model.breakModel.shiftModel.shiftName
        </dd>
        <dt class="col-sm-2">
            Start Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.breakModel.breakStart).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            End Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.breakModel.breakEnd).ToString("hh:mm tt")
        </dd>

        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.breakModel.breakStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.breakModel.breakID">@L.T("Edit")</a> |
    <a asp-page="./Index">Back to List</a>
</div>
