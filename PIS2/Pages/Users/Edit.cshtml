@page
@model PIS2.Pages.Users.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Users</h1>

<h4 class="fw-bold">Update User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="userModel.userID" />
            <div class="form-group">
                <label asp-for="userModel.personModel.personFullName" class="control-label">Full Name</label>
                <input asp-for="userModel.personModel.personFullName" class="form-control" readonly></input>
                <span asp-validation-for="userModel.personModel.personFullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="userModel.userName" class="control-label">User Name</label>
                <input asp-for="userModel.userName" class="form-control" />
                <span asp-validation-for="userModel.userName" class="text-danger"></span>
            </div>           
            <div class="form-group">
                <label asp-for="userModel.userStatus" class="control-label">Status</label>
                <select asp-for="userModel.userStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="userModel.userStatus" class="text-danger"></span>
            </div>
            
            
            <div class="form-group d-flex justify-content-end">
                <a asp-page="Delete" asp-route-id="@Model.userModel.userID" class="btn btn-danger m-2" >Delete</a>
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <h4 class="fw-bold">User Record History</h4>
        <table class="table table-striped table-hover">
            <thead class="bg-info text-white">
                <tr>
                    <th>User Name</th>
                    <th>Status</th>
                    <th>Modified By</th>
                    <th>Modified Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.userHistory)
                {
                    <tr>
                        <td>@item.userName</td>
                        <td>@item.userStatus</td>
                        <td>@item.modifiedBy</td>
                        <td>@item.modifiedDate</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Users</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
