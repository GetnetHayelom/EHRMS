@page
@model PIS2.Pages.Users.EditModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using PIS2.Enums
@using PIS2.Models

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<form id="tokenForm">
    @Html.AntiForgeryToken()
</form>
<h2 class="fw-bold mb-4">User</h2>
<h6 class="text-muted">@L.T("Update") User Info & Access</h6>
<div class="row">
    <!-- Left Column: User Details -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white fw-bold">User Information</div>
            <div class="card-body" id="UserFormContainer">
                <form method="post" id="userForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="userModel.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <h6 class="">@Model.userModel?.personModel?.personFullName </h6>
                    </div>

                    <div class="mb-3">
                        <label asp-for="userModel.UserName" class="form-label">User Name <span class="text-danger">*</span></label>
                        <input asp-for="userModel.UserName" class="form-control" id="userName"/>
                        <span asp-validation-for="userModel.UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="userModel.userStatus" class="form-label">Status</label>
                        <select asp-for="userModel.userStatus" class="form-select" asp-items="Html.GetEnumSelectList<mainStatus>()" id="userStatus"></select>
                        <span asp-validation-for="userModel.userStatus" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a asp-page="Index" class="btn btn-secondary me-2">Cancel</a>
                        @if (User.IsInRole("ADMIN"))
                        {
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#resetPasswordModal">

                                <i class="bi bi-key-fill me-2"></i>
                                Reset Password

                            </button>
                        }
                        <button type="button" class="btn btn-success" onclick="UpdateUser()">@L.T("Save")</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- User Record History -->
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white fw-bold">User Record History</div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>User Name</th>
                            <th>Status</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.userHistory ?? new List<userHistoryModel>())
                        {
                            <tr>
                                <td>@item.userName</td>
                                <td>@item.userStatus</td>
                                <td>@item.modifiedBy</td>
                                <td>@item.modifiedDate.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Right Column: Access Management -->
    <div class="col-md-7">
        <!-- Access Management -->
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                User Accesses
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#accessFormContainer" aria-expanded="false">
                    + Add Access
                </button>
            </div>
            <div class="card-body">
                <div id="accessSection">
                    @await Html.PartialAsync("_AccessTable", Model.UserAccesses ?? new List<accessModel>())
                </div>

                <!-- Add/Edit Access Form -->
                <div class="collapse mt-3" id="accessFormContainer">
                    <div class="card card-body bg-light">
                        <form id="accessForm" method="POST">
                            @Html.AntiForgeryToken()
                            
                            <input type="hidden" asp-for="AccessInput.userID" value="@Model.userModel.Id" />

                            <div class="mb-3">
                                <label class="form-label">Role</label>
                                
                                <select asp-for="AccessInput.roleID" id="userGroups" asp-items="Model.RolesList" class="form-select">
                                    <option value="">-- Select Role --</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Company</label>
                                <select id="companyID" asp-for="AccessInput.companyID" class="form-select">
                                    <option value="">All Companies</option>
                                    @foreach (var c in Model.CompanySelectList ?? new List<companyModel>())
                                    {
                                        <option value="@c.companyID">@c.companyName</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select id="accessStatus" asp-for="AccessInput.accessStatus" class="form-select" asp-items="@Html.GetEnumSelectList<mainStatus>()">
                                    
                                </select>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-success" id="btnSaveAccess" onclick="SaveAccess()">@L.T("Save") Access</button>
                                <button type="button" class="btn btn-secondary ms-2" id="btnCancelAccess">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (User.IsInRole("ADMIN"))
{
    <div class="modal fade"
         id="resetPasswordModal"
         tabindex="-1"
         aria-labelledby="resetPasswordModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-warning">

                    <h5 class="modal-title"
                        id="resetPasswordModalLabel">

                        <i class="bi bi-key-fill me-2"></i>
                        Reset Password

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        <strong>Are you sure?</strong>

                        <br />

                        This will reset this user's password to:

                        <br />

                        <strong>123456.aA</strong>

                        <br /><br />

                        The user will be required to change
                        the password when they log in.

                    </div>

                    <p class="mb-0">
                        The user's current password will no longer work.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form method="post"
                          asp-page-handler="ResetPassword"
                          asp-route-id="@Model.userModel.Id">

                        <button type="submit"
                                class="btn btn-warning">

                            <i class="bi bi-key-fill me-1"></i>

                            Yes, Reset Password

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function SaveAccess(){

        var accessData =  $('#accessForm').serialize();

            $.ajax({
                url: '@Url.Page("Edit", "SaveAccess")', // Razor Page handler
                type: 'POST',
                data: accessData,
                success: function (response) {
                    if (response.success) {
                        alert(response.message); // show success message

                        // Redirect after success
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        }
                    } else {
                        alert(response.message); // show error
                    }
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                }
            });        
        }
        
        function UpdateUser(){
   
            // Gather form data (including the hidden userID)
            var formData = $('#userForm').serialize();
 
            $.ajax({
                url: '@Url.Page("Edit")', // same page
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        alert(response.message); // show success message

                        // Redirect after success
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        }
                    } else {
                        alert(response.message); // show error
                    }
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                }
        
            });

        }
        // Cancel button
        $('#btnCancelAccess').click(function () {
            resetAccessForm();
            $('#accessFormContainer').collapse('hide');
        });

        // Reset form
        function resetAccessForm() {
            $('#accessForm')[0].reset();
            $('#accessID').val(0);
        }

        

    </script>

 <script>
     function updateAccess(accessID){
        const token = $('input[name="__RequestVerificationToken"]').val();
        $.ajax({
             url:"@Url.Page("Edit", "UpdateAccess")",
             type:"POST",
             data:{
                 accessID : accessID,
                __RequestVerificationToken: token
             },
             success: function (response) {
                 if (response.success) {
                     alert(response.message);
                     // Redirect after success
                    if (response.redirectUrl) {
                        window.location.href = response.redirectUrl;
                    }
                } else {
                    alert(response.message); // show error
                }
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }

        });
     }
 </script>
