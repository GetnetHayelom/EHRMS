@page
@model PIS2.Pages.Users.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Users</h1>

<h3 class="fw-bold">Are you sure you want to delete this?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            User Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.userName)
        </dd>
        <dt class="col-sm-2">
            Full Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.userStatus)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.modifiedBy)
        </dd>
        <dt class="col-sm-2">
            Modified Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.modifiedDate)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="userModel.userID" />
        
        <input type="submit" value="Delete" class="btn btn-danger m-2" />
        
    </form>
    <a asp-page="./Index">View All Users</a>
</div>
