@page
@model PIS2.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Users</h1>
<h4 class ="fw-bold">User Details</h4>
<hr />
<div class="d-flex">
   
    <dl class="row col-md-4">
        <dt class="col-sm-2">
            User Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.userName)
        </dd>
        <dt class="col-sm-2">
            Full Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.userStatus)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.modifiedBy)
        </dd>
        <dt class="col-sm-2">
            Modified Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.userModel.modifiedDate)
        </dd>
    </dl>

    @if (Model.userHistory != null && Model.userHistory.Any())
    {
        <div class="col-md-6">
            <h4 class="fw-bold">User Record History</h4>
            <table class="table table-striped table-hover">
                <thead class="bg-info text-white">
                    <tr>
                        <th>User Name</th>
                        <th>Status</th>
                        <th>Modified By</th>
                        <th>Modified Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.userHistory)
                    {
                        <tr>
                            <td>@item.userName</td>
                            <td>@item.userStatus</td>
                            <td>@item.modifiedBy</td>
                            <td>@item.modifiedDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.userModel.userID" class="btn btn-success m-2">Edit</a>
    
</div>
<a asp-page="./Index">View All Users</a>