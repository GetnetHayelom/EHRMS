@page
@model PIS2.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Users</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New User</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                User Name
            </th>
            <th>
                Full Name
            </th>
            <th>
                Status
            </th>
            <th>
                Modified By
            </th>
            <th>
                Modified Date
            </th>
            
        </tr>
    </thead>
    <tbody id="dataTable">
@foreach (var item in Model.userModel) {
        <tr onclick="location.href='@Url.Page("Details", new {id = item.userID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.userName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personModel.personFullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.userStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            
        </tr>
}
    </tbody>
</table>
