@page
@using PIS2.Enums
@model PIS2.Pages.Users.IndexModel

@{
    ViewData["Title"] = "Users";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0 text-dark">Users</h1>
            <p class="text-muted">List of all registered system users</p>
        </div>
        <a asp-page="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Add New User
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            @await Html.PartialAsync("filter")
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-dark text-white rounded-top-4 d-flex justify-content-between align-items-center">
            <span class="fw-semibold">User List</span>
            <span class="text-light small">
                Total Users: <strong>@Model.userModel.Count()</strong>
            </span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-secondary">
                        <th>User Name</th>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th>Modified By</th>
                        <th>Modified Date</th>
                    </tr>
                </thead>
                <tbody id="dataTable">
                    @if (Model.userModel != null && Model.userModel.Any())
                    {
                        @foreach (var item in Model.userModel)
                        {
                            <tr class="table-row-hover"
                                onclick="location.href='@Url.Page("Details", new { id = item.userID })'"
                                style="cursor: pointer;">
                                <td class="fw-semibold">@item.userName</td>
                                <td>@item.personModel?.personFullName</td>
                                <td>
                                    @if (item.userStatus == mainStatus.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>@item.modifiedBy</td>
                                <td>@item.modifiedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-exclamation-circle"></i> No users found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .table-row-hover:hover {
        background-color: #f8f9fa !important;
        transition: background-color 0.2s ease-in-out;
    }
</style>
