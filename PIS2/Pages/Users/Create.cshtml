@page
@model PIS2.Pages.Users.CreateModel

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Users</h2>
            <p class="text-muted">Create a new user account</p>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-people"></i> View All Users
        </a>
    </div>

    

    <!-- Create Form -->
    <div class="card border-0 shadow-sm rounded-4 col-md-6">
        <div class="card-header bg-primary text-white fw-semibold rounded-top-4">
            <i class="bi bi-person-plus-fill"></i> New User Information
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Selector -->
                <div class="mb-3">
                    <label asp-for="userModel.personID" class="form-label fw-semibold">
                        <span class="text-danger">*</span> Person
                    </label>
                    <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" />
                    <input type="hidden" asp-for="userModel.personID" id="personIDHidden" />
                    <datalist id="personList">
                        @foreach (var person in Model.PersonsList)
                        {
                            <option data-id="@person.Value" value="@person.Text"></option>
                        }
                    </datalist>
                    <span asp-validation-for="userModel.personID" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="userModel.userName" class="form-label fw-semibold">User Name <span class="text-danger">*</span></label>
                    <input asp-for="userModel.userName" class="form-control" placeholder="Enter username..." />
                    <span asp-validation-for="userModel.userName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="userModel.userStatus" class="form-label fw-semibold">Status</label>
                    <select asp-for="userModel.userStatus" class="form-select" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                    <span asp-validation-for="userModel.userStatus" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success shadow-sm px-4">
                        <i class="bi bi-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    function fetchEmployeeData(empID) {
        if (!empID) {
            alert("Please enter an Employee ID.");
            return;
        }

        $.ajax({
            url: '@Url.Page("Create", "FetchEmp")',
            type: 'GET',
            data: { givenID: empID },
            success: function (response) {
                if (response.success) {
                    $('#personID').val(response.message).trigger('change');
                } else {
                    alert(response.message);
                }
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card-header i {
        margin-right: 6px;
    }
</style>
