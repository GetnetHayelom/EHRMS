@page
@model PIS2.Pages.Users.CreateModel

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0 text-dark">Users</h1>
            <p class="text-muted">Create a new user account</p>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-people"></i> View All Users
        </a>
    </div>

    <!-- Search Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 col-md-4">
        <div class="card-header bg-light fw-semibold rounded-top-4">
            <i class="bi bi-search"></i> Search by Employee ID
        </div>
        <div class="card-body">
            <div class="input-group">
                <input type="text" class="form-control" id="EmployeeID" name="givenID"
                       required placeholder="Enter Employee ID..." />
                <button class="btn btn-outline-primary" type="button" id="lookupButton"
                        onclick="fetchEmployeeData($('#EmployeeID').val())">
                    <i class="bi bi-search"></i> Lookup
                </button>
            </div>
            
            <form method="post" id="SearchID" class="input-group">
                
            </form>
        </div>
    </div>

    <!-- Create Form -->
    <div class="card border-0 shadow-sm rounded-4 col-md-6">
        <div class="card-header bg-primary text-white fw-semibold rounded-top-4">
            <i class="bi bi-person-plus-fill"></i> New User Information
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="userModel.personID" class="form-label fw-semibold">Full Name</label>
                    <select asp-for="userModel.personID" class="form-select select2" asp-items="ViewBag.personID" id="personID">
                        <option value="">-- Select a Person --</option>
                    </select>
                    <span asp-validation-for="userModel.personID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="userModel.userName" class="form-label fw-semibold">User Name <span class="text-danger">*</span></label>
                    <input asp-for="userModel.userName" class="form-control" placeholder="Enter username..." />
                    <span asp-validation-for="userModel.userName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="userModel.userStatus" class="form-label fw-semibold">Status</label>
                    <select asp-for="userModel.userStatus" class="form-select" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                    <span asp-validation-for="userModel.userStatus" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-success shadow-sm px-4">
                        <i class="bi bi-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    function fetchEmployeeData(empID) {
        if (!empID) {
            alert("Please enter an Employee ID.");
            return;
        }

        $.ajax({
            url: '@Url.Page("Create", "FetchEmp")',
            type: 'GET',
            data: { givenID: empID },
            success: function (response) {
                if (response.success) {
                    $('#personID').val(response.message).trigger('change');
                } else {
                    alert(response.message);
                }
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        });
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card-header i {
        margin-right: 6px;
    }
</style>
