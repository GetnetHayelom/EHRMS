@page
@model PIS2.Pages.Users.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Users</h1>

<h4 class="fw-bold">New User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <!-- Search by Employee ID -->
        <form method="post" id="SearchID" class="input-group mb-3">
            <div class="input-group">
                <input type="text" class="form-control" id="EmployeeID" required placeholder="Enter ID" name="givenID" />
                <button class="btn btn-outline-secondary d-print-none" type="button" id="lookupButton"
                        onclick="fetchEmployeeData($('#EmployeeID').val())">
                    <i class="bi bi-search"></i>
                </button>
            </div>

        </form>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="userModel.personID" class="control-label">Full Name</label>
                <select asp-for="userModel.personID" class="form-control select2" asp-items="ViewBag.personID" id="personID">
                    <option value="">-- Select a Person --</option>
                </select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="userModel.userName" class="control-label">User Name</label>
                <input asp-for="userModel.userName" class="form-control" />
                <span asp-validation-for="userModel.userName" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="userModel.userStatus" class="control-label">Status</label>
                <select asp-for="userModel.userStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="userModel.userStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View All Users</a>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    function fetchEmployeeData(empID){

        $.ajax({
            url:'@Url.Page("Create", "FetchEmp")',
            type:'Get',
            data:{
                givenID: empID
            },
            success:function(response){
                if(response.success){
                    $('#personID').val(response.message);
                }else{
                    alert(response.message);
                }
               
            },
            error: function (xhr) {
                alert("Error: " + xhr.responseText);
            }
        })
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
