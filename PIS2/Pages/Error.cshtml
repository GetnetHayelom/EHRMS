@page
@model ErrorModel
@{
    ViewData["Title"] = "Oops! Something went wrong";
}

<div class="container text-center py-5">
    <div class="card shadow-lg border-0 p-4">
        <h1 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> An error occurred</h1>
        <p class="lead mt-3">We’re sorry, but something went wrong on our end.</p>
        <p>Please try again later or contact support if the problem persists.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted">
                <strong>Request ID:</strong> @Model.RequestId
            </p>
        }

        <a href="/" class="btn btn-primary mt-3">Return Home</a>
    </div>
</div>