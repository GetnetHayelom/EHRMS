@page
@model PIS2.Pages.ShiftAssignment.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Shift Assignments</h1>
<div class="card p-2 mb-2 shadow-sm">
    <div class="d-flex justify-content-end d-print-none">
        <div class="mx-2">@await Html.PartialAsync("filter")</div>
        <div class="mx-2">@await Html.PartialAsync("print")</div>
        <div class="mx-2"><excel-export table="dataTable" filename="Department_Annual_Leave_Summary_@(DateTime.UtcNow).xlsx"></excel-export></div>
    </div>
</div>
<table class="table table-hover table-striped" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                EmploymentID
            </th>
            <th>
                Full Name
            </th>
            <th>
                Date Assigned
            </th>
            <th>
                Assigned By
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shift in Model.shiftAssignmentModel.GroupBy(s => s.shiftID)) 
        {
            <tr class="table-primary">
                <th class="fw-bold">@shift.FirstOrDefault()?.shiftModel?.shiftName</th>
                <th class="fw-bold">@shift.Count()</th>
                <th colspan="3"></th>
            </tr>
            @foreach (var item in shift)
            {
                <tr>
           
                    <td>
                        @item.EmploymentModel?.givenID
                    </td>
                    <td>
                        @item.EmploymentModel?.personModel?.personFullName
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.modifiedDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.modifiedBy)
                    </td>
                    <td>
                    <div class="btn-group d-print-none" role="group">
                        <a asp-page="./Details" asp-route-id="@item.shiftAssignmentID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.shiftAssignmentID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                    </td>
                </tr>
            }
                
        }
    </tbody>
</table>
