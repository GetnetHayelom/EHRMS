@page
@model PIS2.Pages.JobReqCost.DetailsModel

<h2>Job Request Cost Details</h2>

<dl class="row">
    <dt class="col-sm-3">Vacancy</dt>
    <dd class="col-sm-9">@Model.JobReqCost.VacancyModel?.VacancyTitle</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.JobReqCost.jobReqStatus</dd>

    <dt class="col-sm-3">Reason</dt>
    <dd class="col-sm-9">@Model.JobReqCost.jobReqCostReason</dd>

    <dt class="col-sm-3">Estimated</dt>
    <dd class="col-sm-9">@Model.JobReqCost.jobReqCostEstimate</dd>

    <dt class="col-sm-3">Actual</dt>
    <dd class="col-sm-9">@Model.JobReqCost.jobReqCostActual</dd>

    <dt class="col-sm-3">Reference</dt>
    <dd class="col-sm-9">@Model.JobReqCost.jobReqCostReference</dd>
</dl>

<a asp-page="Edit" asp-route-id="@Model.JobReqCost.jobReqCostID" class="btn btn-warning">@L.T("Edit")</a>
<a asp-page="Index" class="btn btn-secondary">Back</a>
