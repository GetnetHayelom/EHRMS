@page
@model PIS2.Pages.JobReqCost.CreateModel

<h2 class="fw-bold">Job Request Cost</h2>
<h4 class="fw-bold">New Cost</h4>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Vacancy</label>
        <select asp-for="JobReqCost.VacancyID" asp-items="Model.VacancyList" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label>Reason</label>
        <textarea asp-for="JobReqCost.jobReqCostReason" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Estimated Cost</label>
        <input asp-for="JobReqCost.jobReqCostEstimate" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Actual Cost</label>
        <input asp-for="JobReqCost.jobReqCostActual" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Reference Cost</label>
        <input asp-for="JobReqCost.jobReqCostReference" class="form-control" />
    </div>

    <button class="btn btn-success">@L.T("Save")</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
