@page
@model PIS2.Pages.EmploymentMethod.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.employmentMethodModel[0].employmentMethodName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.employmentMethodModel[0].employmentMethodDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.employmentMethodModel[0].employmentMethodStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.employmentMethodModel[0].modifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.employmentMethodModel[0].modifiedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.employmentMethodModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentMethodName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentMethodDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentMethodStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.employmentMethodID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.employmentMethodID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.employmentMethodID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
