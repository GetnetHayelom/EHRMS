@page
@using PIS2.Enums
@model PIS2.Pages.EmploymentMethod.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employment Method</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Employment Method</a>
</p>
<table class="table">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Method Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>
                Date Modified
            </th>
            <th>
                Modified By
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.employmentMethodModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentMethodName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentMethodDescription)
            </td>
            <td>
                    @if (item.employmentMethodStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.employmentMethodStatus)</span>

                    }
                    else if (item.employmentMethodStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.employmentMethodStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.employmentMethodStatus)</span>
                    }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.employmentMethodID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.employmentMethodID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                
            </td>
        </tr>
}
    </tbody>
</table>
