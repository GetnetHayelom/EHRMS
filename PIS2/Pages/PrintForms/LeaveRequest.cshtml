@page
@model PIS2.Pages.PrintForms.LeaveRequestModel
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Printable Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .page {
            width: 21cm;
            height: 29.7cm;
            margin: 0 auto;
            padding: 1cm;
            border: 1px solid #ccc;
            box-sizing: border-box;
            background: #fff;
        }
        header, footer {
            text-align: center;
            position: relative;
        }
        header {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 1cm;
        }
        footer {
            font-size: 12px;
            margin-top: 2cm;
            border-top: 1px solid #ccc;
            padding-top: 0.5cm;
        }
        .form-section {
            margin-bottom: 1cm;
        }
        label {
            display: block;
            margin-bottom: 0.2cm;
            font-weight: bold;
        }
        .form-field {
            margin-bottom: 0.8cm;
        }
        input[type="text"], input[type="date"], input[type="number"] {
            width: 100%;
            padding: 0.5cm;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .button-row {
            text-align: center;
            margin-top: 1cm;
        }
        .print-button {
            padding: 0.5cm 2cm;
            font-size: 16px;
            background-color: #007BFF;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .print-button:hover {
            background-color: #0056b3;
        }
        @@media print {
            .print-button {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <header>
            Leave Application Form
        </header>
        
        <div class="form-section">
            <div class="form-field">
                <label for="name">Name:</label>
                <input type="text" id="name" value="@Model.Name" readonly>
            </div>
            <div class="form-field">
                <label for="position">Position:</label>
                <input type="text" id="position" value="@Model.Position" readonly>
            </div>
        </div>

        <div class="form-section">
            <h4>Leave Details</h4>
            <div class="form-field">
                <label for="startDate">Leave Start Date:</label>
                <input type="date" id="startDate" value="@Model.LeaveStartDate.ToString("yyyy-MM-dd")" readonly>
            </div>
            <div class="form-field">
                <label for="endDate">Leave End Date:</label>
                <input type="date" id="endDate" value="@Model.LeaveEndDate.ToString("yyyy-MM-dd")" readonly>
            </div>
            <div class="form-field">
                <label for="days">Number of Days:</label>
                <input type="number" id="days" value="@Model.LeaveDays" readonly>
            </div>
            <div class="form-field">
                <label for="reason">Reason:</label>
                <input type="text" id="reason" value="@Model.Reason" readonly>
            </div>
        </div>

        <div class="button-row">
            <button class="print-button" onclick="window.print()">Print Form</button>
        </div>

        <footer>
            <p>Generated by the Leave Management System</p>
        </footer>
    </div>
</body>
</html>

