@page
@model PIS2.Pages.Exprience.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Experiences</h1>

<div>
    <h4 class="fw-bold">Experience Detail</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Full Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            From:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.experienceStartDate)
        </dd>
        <dt class="col-sm-2">
            To:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.experienceEndDate)
        </dd>
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.jobTitle)
        </dd>
        <dt class="col-sm-2">
            Company:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.jobDepartment)
        </dd>
    </dl>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.experienceModel.experienceID" class="btn btn-primary m-2">Edit</a> 
    <a asp-page="./Delete" asp-route-id="@Model.experienceModel.experienceID" class="btn btn-danger m-2">Delete</a>
    
</div>
<a asp-page="./Index">View All Experiences</a>
