@page
@model PIS2.Pages.Exprience.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Experience</h1>

<h3 class="fw-bold">Are you sure you want to delete this experience record?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.personID)
        </dd>
        <div class="d-flex">
            <dt class="col-sm-2">
                From:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.experienceModel.experienceStartDate)
            </dd>
            <dt class="col-sm-2">
                To:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.experienceModel.experienceEndDate)
            </dd>
        </div>
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.experienceModel.jobTitle)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="experienceModel.experienceID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="/Person/Edit/?id=@Model.experienceModel.experienceID" >Back to Employee View</a>
    </form>
</div>
