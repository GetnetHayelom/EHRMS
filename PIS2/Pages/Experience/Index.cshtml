@page
@using PIS2.Enums
@model PIS2.Pages.Exprience.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")

<div class="d-flex justify-content-between mb-2 align-items-end">
    <div>
        <h2 class="fw-bold mb-0">Exprience Records</h2>
        <p class="text-muted mb-0">
            View persons experience records
        </p>
    </div>
    <a asp-page="Create" class="btn btn-primary d-print-none m-2"><i class="bi bi-plus-circle me-2"></i>New Experience</a>
</div>
<div class="card m-2 p-2 d-flex justify-content-around d-print-none">
    <div class="d-flex justify-content-between mb-3 align-items-end">
        <form method="get" class="d-flex gap-4 align-items-end">
            <!-- Employment Status Filter -->
            <div>
                <label class="me-2 fw-bold">Experience Type:</label>
                <input type="radio" name="EmploymentFilter" value="" @(Model.ExperienceTypeFilter == null ? "checked" : "") onchange="this.form.submit()" /> All
                @foreach (var type in Enum.GetValues<Enums.Ex_In>())
                {
                    <input type="radio" name="EmploymentFilter" value="@type" @(Model.ExperienceTypeFilter == type ? "checked" : "") onchange="this.form.submit()" />
                    @type
                }
            </div>

            <!-- Gender Filter -->
            <div>
                <label class="me-2 fw-bold">Gender:</label>
                <input type="radio" name="GenderFilter" value="" @(Model.GenderFilter == null ? "checked" : "") onchange="this.form.submit()" /> All
                @foreach (var g in Enum.GetValues<Gender>())
                {
                    <input type="radio" name="GenderFilter" value="@g" @(Model.GenderFilter == g ? "checked" : "") onchange="this.form.submit()" />
                    @g
                }
            </div>

        </form>
        <div class="d-flex justify-content-end d-print-none align-items-end">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
            <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
        </div>
    </div>
    
    

</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>S/No</th>
            <th>
                Full Name
            </th>
            <th>
                Employment ID
            </th>
            <th>
                Experience Type
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Job Title
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        <!--EMPTY TABLE-->
        @if (Model.experienceModel == null || !Model.experienceModel.Any())
        {
            <tr>
                
                <td colspan="10" class="text-center text-muted">
                    No experience record found.
                </td>
            </tr>
        }
        @{
            int index = 1;
        }
        @foreach (var persons in Model.experienceModel.OrderBy(e => e.FullName).GroupBy(e => e.personID)) 
        {
            <tr class="table-primary" data-id="@index">
                <th>@index</th>
                <th colspan="6">@persons?.FirstOrDefault()?.FullName</th>
                <th>
                    @if(persons.Any(p => p.experienceType == Enums.Ex_In.Internal))
                    {
                        <a class="btn btn-outline-primary" role="button" href="/Experience/_OfficialPrint?id=@persons.FirstOrDefault().personID">Preview</a>
                    }
                    
                </th>
            </tr>
            int index1 = 1;
            @foreach (var item in persons)
            {
            <tr data-parent="@index">
                <td>
                    <p class="text-muted m-0">@index.@index1</p>
                </td>
                <td></td>
                <td>
                    <a href="/Employment/Details?id=@item.employmentID">@item.givenID</a>
             
                </td>
                <td>
                    @if (item.experienceType == Enums.Ex_In.Internal)
                    {
                        <span class="badge bg-success">Internal</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">External</span>
                    }
                </td>
                <td>
                    @item.experienceStartDate?.ToString("MM/dd/yyyy")
                </td>
                <td>
                    @item.experienceEndDate?.ToString("MM/dd/yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.jobTitle)
                </td>

                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.experienceID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.experienceID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>
             index1++;  
            }
            index++;
        }
    </tbody>
</table>
