@page
@model PIS2.Pages.Exprience.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")

<h1 class="fw-bold">Exprience Records</h1>

<p class="d-print-none">
    <a asp-page="Create" class="btn btn-primary">New Experience</a>
</p>
<div class="card m-2 p-2 d-flex justify-content-around d-print-none">
    <form method="get" class="mb-3 d-flex gap-4 p-2">
        <!-- Employment Status Filter -->
        <div>
            <label class="me-2 fw-bold">Employment Status:</label>
            <input type="radio" name="EmploymentFilter" value="" @(Model.EmploymentFilter == null ? "checked" : "") onchange="this.form.submit()" /> All
            @foreach (var status in Enum.GetValues<Models.mainStatus>())
            {
                <input type="radio" name="EmploymentFilter" value="@status" @(Model.EmploymentFilter == status ? "checked" : "") onchange="this.form.submit()" /> 
                @status
            }
        </div>

        <!-- Gender Filter -->
        <div>
            <label class="me-2 fw-bold">Gender:</label>
            <input type="radio" name="GenderFilter" value="" @(Model.GenderFilter == null ? "checked" : "") onchange="this.form.submit()" /> All
            @foreach (var g in Enum.GetValues<Models.Gender>())
            {
                <input type="radio" name="GenderFilter" value="@g" @(Model.GenderFilter == g ? "checked" : "") onchange="this.form.submit()" /> 
                @g
            }
        </div>
    </form>
    <div class ="d-flex justify-content-end d-print-none">
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
    

</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Full Name
            </th>
            <th>
                Employment ID
            </th>
            <th>
                Employment Status
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Job Title
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var persons in Model.experienceModel.OrderBy(e => e.personModel?.personFullName).GroupBy(e => e.personID)) 
        {
            <tr class="table-primary">
                <th colspan="7">@persons?.FirstOrDefault()?.personModel?.personFullName</th>
            </tr>
            @foreach (var item in persons)
            {
            <tr>
                <td>
                    
                </td>
                <td>
                    @if (item.personModel?.Employments?.Any() ==true)
                    {
                        foreach(var emps in item.personModel.Employments)
                        {
                            <a href="/Employment/Details?id=@emps.employmentID">@emps.givenID</a>
                        }
                    }
                    else
                    {
                        <p>-</p>
                    }

                </td>
                <td>
                    @if (item.personModel?.Employments?.Any(e => e.employmentStatus == Models.mainStatus.Active) == true)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive/Suspended</span>
                        
                    }
                </td>
                <td>
                    @item.experienceStartDate.ToString("MM/dd/yyyy")
                </td>
                <td>
                    @item.experienceEndDate.ToString("MM/dd/yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.jobTitle)
                </td>

                <td class="d-print-none">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.experienceID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.experienceID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
