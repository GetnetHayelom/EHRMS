@page
@model PIS2.Pages.JopPlacementHistory.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Placement</h1>

<h4 class="fw-bold">Add Old Job Placement</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.employmentID" class="control-label">Employee ID</label>
                <select asp-for="jobPlacementModel.employmentID" class ="form-control" asp-items="ViewBag.employmentID"></select>
            </div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.departmentID" class="control-label">Department</label>
                <select asp-for="jobPlacementModel.departmentID" class ="form-control" asp-items="ViewBag.departmentID"></select>
            </div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.jobID" class="control-label">Job Title</label>
                <select asp-for="jobPlacementModel.jobID" class ="form-control" asp-items="ViewBag.jobID"></select>
            </div>
            
            
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobPlacementModel.jobPlacementSalary" class="control-label"></label>
                <input asp-for="jobPlacementModel.jobPlacementSalary" class="form-control" />
                <span asp-validation-for="jobPlacementModel.jobPlacementSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label  class="control-label"></label>
                <input  class="form-control" />
                <span asp-validation-for="JobGrade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobStep" class="control-label"></label>
                <input asp-for="JobStep" class="form-control" />
                <span asp-validation-for="JobStep" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.jobPlacementDate" class="control-label"></label>
                <input asp-for="jobPlacementModel.jobPlacementDate" class="form-control" />
                <span asp-validation-for="jobPlacementModel.jobPlacementDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="jobPlacementModel.jobPlacementReference" class="control-label"></label>
                <input asp-for="jobPlacementModel.jobPlacementReference" class="form-control" />
                <span asp-validation-for="jobPlacementModel.jobPlacementReference" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.jobPlacementReason" class="control-label"></label>
                <input asp-for="jobPlacementModel.jobPlacementReason" class="form-control" />
                <span asp-validation-for="jobPlacementModel.jobPlacementReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobPlacementModel.modifiedBy" class="control-label"></label>
                <input asp-for="jobPlacementModel.modifiedBy" class="form-control" />
                <span asp-validation-for="jobPlacementModel.modifiedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
