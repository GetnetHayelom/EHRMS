@page
@model PIS2.Pages.JopPlacementHistory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].employmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].departmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobModel)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobPlacementSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobStepID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobPlacementDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobPlacementStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobPlacementReference)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].jobPlacementReason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.jobPlacementModel[0].modifiedBy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.jobPlacementModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.departmentModel.departmentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobModel.jobID)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementSalary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobStepID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementReference)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementReason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.jobPlacementID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.jobPlacementID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.jobPlacementID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
