@page
@model PIS2.Pages.JobStep.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Steps</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Job Step</a>
</p>
<hr />
<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Job Step Name
            </th>
            <th>
                Job Step Garde
            </th>
            <th>Job Step Number</th>
            <th>
                Job Step Salary
            </th>
            <th>
                Job Step Status
            </th>
            <th>
                Modified By
            </th>
            
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.jobStepModel) {
        <tr onclick="location.href='@Url.Page("Details", new {id = item.jobStepID})'" style="cursor:pointer">
            <td>
                @Html.DisplayFor(modelItem => item.jobStepName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobGradeModel.jobGradeID)
            </td>
             <td>
                 @Html.DisplayFor(modelItem => item.jobStepNumber)
            </td> 
            <td>
                @Html.DisplayFor(modelItem => item.jobStepSalary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobStepStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
           
        </tr>
    }
    </tbody>
</table>
