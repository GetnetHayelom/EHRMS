@page
@using PIS2.Enums
@model PIS2.Pages.JobStep.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Steps</h1>

<h4 class="fw-bold">Update Job Step</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="jobStepModel.jobStepID" />
            <div class="form-group">
                <label asp-for="jobStepModel.jobStepName" class="control-label">Step Name</label>
                <input asp-for="jobStepModel.jobStepName" class="form-control" />
                <span asp-validation-for="jobStepModel.jobStepName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobStepModel.jobGradeID" class="control-label">Grade</label>
                <select asp-for="jobStepModel.jobGradeID" class="form-control" asp-items="ViewBag.jobGradeID"></select>
                <span asp-validation-for="jobStepModel.jobGradeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobStepModel.jobStepSalary" class="control-label">Salary</label>
                <input asp-for="jobStepModel.jobStepSalary" class="form-control" />
                <span asp-validation-for="jobStepModel.jobStepSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="jobStepModel.jobStepStatus" class="control-label">Status</label>
                <select asp-for="jobStepModel.jobStepStatus" class="form-control" asp-items="@Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="jobStepModel.jobStepStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Update" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Job Steps</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
