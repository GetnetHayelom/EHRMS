@page
@model PIS2.Pages.AllowanceAssignment.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}



<div class="d-flex justify-content-between">
    <div>
        <h1 class="fw-bold flex-grow">Allowance Assignments</h1>
        <h4 class="fw-bold">@Model.Company</h4>
    </div>
    
    <div>
        <a asp-page="Create" class="btn btn-primary m-2">New Allowance Assignment</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#rawView">List View</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#groupDepView">Department View</a>
    </div>
        
</div>
<div class="d-flex justify-content-between">
    <p class="fw-bold">Total No of Allowance:<u>@Model.allowanceCount</u></p>
    <p class="fw-bold">Total Sum of Allowance:<u>@Math.Round(Model.allowanceSum, 2).ToString("N2")</u></p>
</div>
<hr />
<div id="parentDiv">
    <!--List View-->
    <div id="rawView" class="show" data-bs-parent="#parentDiv">
        @await Html.PartialAsync("filter")
        <table class="table table-striped table-hover" id="dataTable">
            <thead class="bg-dark text-white">
                <tr>
                    <th>
                        Employment ID
                    </th>
                    <th>Employee Name</th>
                    <th>
                        Allowance Type
                    </th>
                    <th>
                        Allowance Amount
                    </th>
                    <th>
                        Allowance Assignment Date
                    </th>
                    <th>
                        Allowance Status
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.allowanceAssignmentModel) {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.allowanceAssignmentID})'" style="cursor:pointer">
                        <td>
                            @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                        </td>
                        <td>
                            @item.employmentModel.personModel.personFullName
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.allowanceModel.allowanceName)
                        </td>
                        <td>
                            @item.allowanceAssignmentAmount
                        </td>
                        <td>
                            @item.allowanceAssignmentDate.Value.ToString("yyyy-MM-dd")
                        </td>@{
                            string bg_color;
                            if (item.allowanceStatus == Models.mainStatus.Suspended)
                            {
                                bg_color = "bg-warning text-black";
                            }
                            else if (item.allowanceStatus == Models.mainStatus.Active)
                            {
                                bg_color = "bg-success text-white";
                            }
                            else
                            {
                                bg_color = "bg-grey text-black";
                            }
                        }
                        <td class="@bg_color">
                            @Html.DisplayFor(modelItem => item.allowanceStatus)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-flex justify-content-end">
            @await Html.PartialAsync("print")
        </div>

    </div>
    <!--Group View-->
    <div id="groupDepView" class="show" data-bs-parent="#parentDiv">
        <table class="table table-striped table-hover">
            <thead class="bg-info text-white">
                <tr>
                    <th>S/No</th>
                    <th>Department</th>
                    <th>Number of Allowance</th>
                    <th>Total Allowance</th>
                </tr>
            </thead>
            <tbody id="departmentsAccordion">
                @{
                    int index = 0;
                    int rowCounter = 1;
                }
                @foreach (var dep in Model.GroupedAllowance)
                {
                    var collapseId = $"collapse{index}";
                    <tr class="" data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        style="cursor:pointer;">
                        <td>@rowCounter</td>
                        <td>
                            @dep.Name
                           
                        </td>
                        <td>
                            @dep.Count

                        </td>
                        <td>
                            @Math.Round(dep.Sum, 2).ToString("N2")

                        </td>

                    </tr>

                    <tr>
                        <td colspan="6" class="p-0">
                            <div id="@collapseId" class="accordion-collapse collapse"
                                 data-bs-parent="#departmentsAccordion">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-dark text-white">
                                        <tr>
                                            <th>
                                                Employment ID
                                            </th>
                                            <th>Employee Name</th>
                                            <th>
                                                Allowance Type
                                            </th>
                                            <th>
                                                Allowance Amount
                                            </th>
                                            <th>
                                                Allowance Assignment Date
                                            </th>
                                            <th>
                                                Allowance Status
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in dep.Records)
                                        {
                                            <tr onclick="location.href='@Url.Page("Details", new { id = item.allowanceAssignmentID})'" style="cursor:pointer">
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                                                </td>
                                                <td>
                                                    @item.employmentModel.personModel.personFullName
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.allowanceModel.allowanceName)
                                                </td>
                                                <td>
                                                    @item.allowanceAssignmentAmount
                                                </td>
                                                <td>
                                                    @item.allowanceAssignmentDate.Value.ToString("yyyy-MM-dd")
                                                </td>@{
                                                    string bg_color;
                                                    if (item.allowanceStatus == Models.mainStatus.Suspended)
                                                    {
                                                        bg_color = "bg-warning text-black";
                                                    }
                                                    else if (item.allowanceStatus == Models.mainStatus.Active)
                                                    {
                                                        bg_color = "bg-success text-white";
                                                    }
                                                    else
                                                    {
                                                        bg_color = "bg-grey text-black";
                                                    }
                                                }
                                                <td class="@bg_color">
                                                    @Html.DisplayFor(modelItem => item.allowanceStatus)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    index++;
                    rowCounter++;
                }
            </tbody>
        </table>
    </<div>
</div>
<div class="d-flex justify-content-end">
   @await Html.PartialAsync("print")
</div>