@page
@model PIS2.Pages.AllowanceAssignment.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
    @await Html.PartialAsync("filter")
</p>
<table class="table" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentModel[0].allowanceModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentModel[0].allowanceAssignmentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentModel[0].employmentModel)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.allowanceAssignmentModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.allowanceModel.allowanceName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.allowanceAssignmentDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.allowanceAssignmentID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.allowanceAssignmentID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.allowanceAssignmentID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
