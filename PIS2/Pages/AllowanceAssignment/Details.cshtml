@page
@using PIS2.Enums
@model PIS2.Pages.AllowanceAssignment.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="fw-bold mb-0">Allowance Assignments</h2>
<p class="text-muted mb-0">Allowance Assignment Details #@Model.allowanceAssignmentModel.allowanceAssignmentID</p>
<hr class="m-2"/>
<div>
    <div class="d-flex gap-2">
        <div class="col-md-5 card shadow-sm p-4 print-full-width mb-4">
            <dl class="row">
                <dt class="">
                    Employment ID:
                </dt>
                <dd class="me-4">
                    <u>@Html.DisplayFor(model => model.allowanceAssignmentModel.employmentModel.givenID)</u>
                </dd>
                <dt class="">
                    Employee Name:
                </dt>
                <dd class=" me-4">
                    <u> @Html.DisplayFor(model => model.allowanceAssignmentModel.employmentModel.personModel.personFullName)</u>
                </dd>
                <dt class="">
                    Allowance Type:
                </dt>
                <dd class=" me-4">
                    <u>@Html.DisplayFor(model => model.allowanceAssignmentModel.allowanceModel.allowanceName)</u>
                </dd>
                <dt class="">
                    Allowance Amount:
                </dt>
                <dd class=" me-4">
                    <u>@Html.DisplayFor(model => model.allowanceAssignmentModel.allowanceAssignmentAmount)</u>
                </dd>
                <dt class="">
                    Allowance Date:
                </dt>
                <dd class=" me-4">
                    <u>@Model.allowanceAssignmentModel.allowanceAssignmentDate</u>
                </dd>
                <dt class="">
                    Allowance Duration:
                </dt>
                <dd class=" me-4">
                    <u>@Html.DisplayFor(model => model.allowanceAssignmentModel.allowanceModel.allowanceDuration)</u>
                </dd>
                @if(Model.allowanceAssignmentModel.allowanceModel.allowanceDuration == Enums.allowanceDuration.Limited)
                {
                    <dt class="">Allowance End Date</dt>
                    <dd class=" me-4">
                        <u>@Model.allowanceAssignmentModel.allowanceAssignmentEndDate</u>
                    </dd>
                }
            </dl>
            
        </div>
        <div class="flex-grow-1 print-full-width">
            <h4 class="fw-bold">Allowance Assignment History</h4>
            <table class="table table-bordered table-striped table-hover print-full-width">
                <thead class="bg-info text-white">
                    <tr>
                        <td>Allowance Status</td>
                        <td>Allowance Amount</td>
                        <td>Modified Date</td>
                        <td>Modified By</td>
                        
                    </tr>
                </thead>
                <tbody>
                    @if (Model.allowanceAssignmentModel.AllowanceAssignmentHistories.Any())
                    {
                        foreach(var item in Model.allowanceAssignmentModel.AllowanceAssignmentHistories)
                        {
                            <tr>
                                <td>@item.allowanceAssignmentHistoryStatus</td>
                                <td>@item.allowanceAssignmentAmount</td>
                                <td>@item.modifiedDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.modifiedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div>
                @if (Model.allowanceAssignments.Any())
                {
                    <h4 class="fw-bold">Other Allowance Assignments</h4>
                
                    <table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
                        <thead class="bg-info text-white">
                            <tr>
                                <th>
                                    Allowance Type
                                </th>
                                <th>
                                    Allowance Amount
                                </th>
                                <th>
                                    Allowance Assignment Date
                                </th>
                                <th>
                                    Allowance Status
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.allowanceAssignments)
                            {
                                <tr onclick="location.href='@Url.Page("Details", new { id = item.allowanceAssignmentID})'" style="cursor:pointer">
                                
                                    <td>
                                        @Html.DisplayFor(modelItem => item.allowanceModel.allowanceName)
                                    </td>
                                    <td>
                                        @item.allowanceAssignmentAmount
                                    </td>
                                    <td>
                                        @item.allowanceAssignmentDate
                                    </td>@{
                                        string bg_color;
                                        if (item.allowanceStatus == mainStatus.Suspended)
                                        {
                                            bg_color = "bg-warning text-black";
                                        }
                                        else if (item.allowanceStatus == mainStatus.Active)
                                        {
                                            bg_color = "bg-success text-white";
                                        }
                                        else
                                        {
                                            bg_color = "bg-grey text-black";
                                        }
                                    }
                                    <td class="@bg_color">
                                        @Html.DisplayFor(modelItem => item.allowanceStatus)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end d-print-none align-items-end">
        <a asp-page="/EmployeeService/Earning" asp-route-id="@Model.allowanceAssignmentModel.employmentID" class="btn btn-outline-primary m-2">View All Earning</a>
        <a asp-page="./Index" class="btn btn-outline-secondary m-2"><i class="bi bi-arrow-left me-2"></i>Back to catalog</a>
        @await Html.PartialAsync("print")
        <a asp-page="./Edit" asp-route-id="@Model.allowanceAssignmentModel.allowanceAssignmentID" class="btn btn-primary m-2 d-print-none"><i class="bi bi-pencil-square me-2"></i>Edit</a>
    </div>
</div>

