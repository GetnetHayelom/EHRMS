@page
@using PIS2.Enums
@model PIS2.Pages.AllowanceAssignment.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}

<h1 class="fw-bold">Allowance Assignment</h1>
<h6 class="fw-bold text-muted">New Allowance Assignment</h6>
<hr />
<div class="d-flex gap-4">
    <div class="card shadow-sm p-2 col-md-4 d-print-none">
        <div class="mt-2">
            <!--form for searching using ID -->
            <label for="employeeID" class="fw-bold">Look up by Empolyee ID: </label>
            <form method="get" class="d-flex">
                <input id="givenID" name="searchID" type="text" class="form-control mb-1 me-2" asp-for="@Model.Employment.givenID" list="givenIDList">
                <datalist id="givenIDList">
                    @if (Model.Employments != null)
                    {
                        @foreach (var item in Model.Employments)
                        {
                            <option value="@item.employmentID">@item.givenID</option>
                        }
                    }

                </datalist>
                <button type="submit" class="btn btn-primary mb-1">View</button>

            </form>
            @if(Model.Employment == null)
            {
                <div class="alert alert-danger d-print-none" role="alert">
                    @successMessage
                </div>
            }
            else
            {
                <div>
                    <h4 class="fw-bold">@Model.Employment.personModel?.personFullName</h4>
                </div>
            }

        </div>
        <div class="">
            @if (Model.Employment?.employmentID == 0)
            {
                <div class="bg-info p-4 text-white"><h4>Select Employee</h4></div>
            }
            else if (Model.Employment != null && Model.Employment.employmentStatus == mainStatus.Inactive)
            {
                <div class="bg-danger p-4 text-white"><h4>Employee Is Inactive</h4></div>
            }
            else if (Model.Employment != null && Model.Employment.employmentStatus == mainStatus.Active)
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="allowanceAssignmentModel.employmentID" value="@Model.Employment.employmentID" type="hidden" />
                    
                    <div class="form-group">
                        <span class="text-danger">*</span>
                        <label asp-for="allowanceAssignmentModel.allowanceID" class="control-label">Allowance Type</label>
                        <select asp-for="allowanceAssignmentModel.allowanceID" class ="form-control" asp-items="ViewBag.allowanceID" id="allowanceType"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="allowanceAssignmentModel.allowanceAssignmentDate" class="control-label">Allowance Start Date</label>
                        <input asp-for="allowanceAssignmentModel.allowanceAssignmentDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-dd-MM")"/>
                        <span asp-validation-for="allowanceAssignmentModel.allowanceAssignmentDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <span class="text-danger">*</span>
                        <label asp-for="allowanceAssignmentModel.allowanceAssignmentAmount" class="control-label">Allowance Amount</label>
                        <input asp-for="allowanceAssignmentModel.allowanceAssignmentAmount" class="form-control"></input>
                    </div>
                    <div class="form-group" id="endDate1">
                        <label asp-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="control-label">Allowance End Date</label>
                        <input asp-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="form-control" type="date" />
                        <span asp-validation-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="text-danger"></span>
                    </div>

                    <div class="form-group d-flex justify-content-end">
                        <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
                    </div>
                </form> 
            }
        </div>
    </div>
    <div class="flex-fill card shadow-sm p-2">
        <h4 class="fw-bold">Allowance Assignment History and Status</h4>
        @if (Model.Employment != null && Model.Employment.employmentID != 0 && Model.AllowanceAssignments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>S/N</th>
                        <th>Assignment Type</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>End Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{int index=0;}
                    @foreach(var item in Model.AllowanceAssignments)
                    {
                        index++;
                        <tr onclick="location.href='@Url.Page("Details", new{id = item.allowanceAssignmentID})'" style="cursor:pointer;">
                            <td>@index</td>
                            <td>@item.allowanceModel.allowanceName</td>
                            <td>@item.allowanceAssignmentDate</td>
                            <td>@item.allowanceAssignmentAmount</td>
                            <td>@item.allowanceAssignmentEndDate</td>
                            @{
                                string bg_color;
                                if (item.allowanceStatus == mainStatus.Suspended)
                                {
                                    bg_color = "badge bg-warning";
                                }
                                else if (item.allowanceStatus == mainStatus.Active)
                                {
                                    bg_color = "badge bg-success";
                                }
                                else
                                {
                                    bg_color = "badge bg-grey";
                                }
                            }
                            <td>
                                <span class="@bg_color">@Html.DisplayFor(modelItem => item.allowanceStatus)</span>
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="">
                <h6> No Allowance Assignemt Record Found!</h6>
            </div>
        }
    
    </div>
</div>

<div>
    <a asp-page="Index">View All Allowance Assignments</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}    
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const select = document.getElementById("allowanceType");
        const dateControl = document.getElementById("endDate");

        function toggleDateControl() {
            const selected = select.options[select.selectedIndex];
            const duration = selected.getAttribute("allowanceDuration");

            if (duration && duration == 1) {
                Console.log(duration);
                dateControl.style.display = "block";
            } else {
                dateControl.style.display = "none";
                Console.log(duration);
            }
        }

        select.addEventListener("change", toggleDateControl);

        // Run once on load in case editing existing record
        toggleDateControl();
    });
</script>
