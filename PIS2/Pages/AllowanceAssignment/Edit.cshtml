@page
@model PIS2.Pages.AllowanceAssignment.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Allowance Assignment</h1>

<h4 class="fw-bold">Update Allowance Assignment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="allowanceAssignmentModel.allowanceAssignmentID" />
            <input asp-for="allowanceAssignmentModel.employmentID" class="form-control" type="hidden"></input>
            <input asp-for="allowanceAssignmentModel.allowanceID" class="form-control" type="hidden"></input>
            <div class="form-group m-2 d-flex justify-content-around">
                <label class="control-label text-decoration-underline">Employee ID: <span class="fw-bold>"><u>@Model.allowanceAssignmentModel.employmentModel.givenID</u></span></label>
                <label class="control-label text-decoration-underline">Allowance Type: <span><u>@Model.allowanceAssignmentModel.allowanceModel.allowanceName</u></span></label>
            </div>
            <div class="form-group m-2">        
                
            </div>
            <div class="form-group">
                <label asp-for="allowanceAssignmentModel.allowanceAssignmentDate" class="control-label">Allowance Date</label>
                <input asp-for="allowanceAssignmentModel.allowanceAssignmentDate" class="form-control" type="date"/>
                <span asp-validation-for="allowanceAssignmentModel.allowanceAssignmentDate" class="text-danger"></span>
            </div>
            @if (Model.allowanceAssignmentModel.allowanceModel != null)
            {
                <div class="form-group">
                    <label asp-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="control-label">Allowance End Date</label>
                    <input asp-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="form-control" type="date" />
                    <span asp-validation-for="allowanceAssignmentModel.allowanceAssignmentEndDate" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="allowanceAssignmentModel.allowanceStatus" class="control-label">Status</label>
                <select asp-for="allowanceAssignmentModel.allowanceStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="allowanceAssignmentModel.allowanceStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="allowanceAssignmentModel.allowanceAssignmentAmount" class="control-label">Allowance Amount</label>
                <input asp-for="allowanceAssignmentModel.allowanceAssignmentAmount" class="form-control" type="number" />
                <span asp-validation-for="allowanceAssignmentModel.allowanceAssignmentAmount" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <a asp-page="./Create" asp-route-id="@Model.allowanceAssignmentModel.employmentID" class="btn btn-success m-2"> New Allowance</a>
                <input type="submit" value="Save" class="btn btn-primary m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Allowance Assignments</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
