@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    var successMessage = TempData["SuccessMessage"] as string;
  
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}


<div class="text-center d-print-none">
    <h1 class="display-4 fw-bold"><b>Welcome</b></h1>
</div>
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success d-print-none" role="alert">
        @successMessage
    </div>
}

<div class="row mt-1 d-flex justify-content-center">
    <!--Person Section-->
    <div class="col-md-3 d-print-none">
        <h4 class="fw-bold">Look Up</h4>
        <hr />

        <!--row for Search control-->
        <div class="row mt-2">
            <!--form for searching using ID --> 
            <label for="employeeID">Look up by Empolyee ID:</label>
            <form method="post" asp-page-handler="SearchID" class="d-flex">
                <input id="givenID" name="searchID" type="text" class="form-control mb-1 me-2" asp-for="@Model.Employment.givenID" list="givenIDList">
                <datalist id="givenIDList">
                    @foreach (var item in Model.Employments)
                    {
                        <option value="@item.givenID"></option>
                    }
                </datalist>
                <button type="submit" class="btn btn-primary mb-1">View</button>
                
            </form>
            <!--form for searching using name-->
            <label for="employeeName">Look up by Name:</label>
            <form method="post" asp-page-handler="SearchName" class="d-flex">
                <input id="employeeName" name="searchName" type="text" class="form-control mb-1 me-2" asp-for="@Model.Person.personFullName" list="namesList">
                <datalist id="namesList">
                    @foreach (var item in Model.People)
                    {
                        <option value="@item.personFullName">@item.personFullName</option>
                    }
                </datalist>
                <button type="submit" class="btn btn-primary mb-1">View</button>
               
            </form>
        </div>
        <!--row for person details -->
        @if (Model.Person != null)
        {
            <!--row for person remaining Details -->
            <div class="d-flex flex-column mt-2 border-primary border rounded mb-1 p-2">
                <div class="d-flex flex-column justify-content-center">

                    <div class="d-flex justify-content-center">
                        @{
                            var imagePath = $"~/images/{Model.Person.personID}.jpg";
                            if (!Model.PhotoExists)
                            {
                                imagePath = Model.Person.personGender == Models.Gender.Female? "~/images/female-default.png" : "~/images/male-default.png";
                            }

                        }
                        <img src="@Url.Content(imagePath)" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;" />
                    </div>
                    
                </div>
                <dl class="row">
                    <div class="row">
                        <dt class="me-2">
                            Full Name: 
                        </dt>
                        @if (Model.Employment != null)
                        {
                            @if(User.IsInRole("MIE\\PMS_HRCLERK")){
                                <dd class="" onclick="location.href='@Url.Page("/Employment/Edit", new { id = Model.Employment.employmentID })'" style="cursor:pointer;">
                                    <u>@Html.DisplayFor(model => model.Person.personFullName)</u>
                                </dd>
                            }
                            else
                            {
                                <dd class="" onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.Employment.employmentID })'" style="cursor:pointer;">
                                    <u>@Html.DisplayFor(model => model.Person.personFullName)</u>
                                </dd>
                            }
                            
                        }
                        else
                        {
                            <dd class="" onclick="location.href='@Url.Page("/Person/Details", new { id = Model.Person.personID })'" style="cursor:pointer;">
                                <u>@Html.DisplayFor(model => model.Person.personFullName)</u>
                            </dd>
                        }
                    </div>
                    <div class="d-flex">
                        <dt class="me-2">
                            Gender:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Person.personGender)</u>
                        </dd>
                    </div>
                    <div class="d-flex">
                        <dt class="me-2">
                            Phone:
                        </dt>
                    
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Person.personPhoneNumber)</u>
                        </dd>
                    </div>
                    <div class="row">
                        <dt class="me-2">
                            Address:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Person.addressModel.addressFormatted)</u>
                        </dd>
                    </div>
                    <div class="row">
                        <dt class="me-2">
                            Email:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Person.personEmailAddress)</u>
                        </dd>
                    </div>
                    @if(Model.PersonEmployments != null)
                    {
                        <div class="row">
                            <dt class="me-2">
                                Job Title:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.JobPlacement.jobModel.jobTitle)</u>
                            </dd>
                        </div>
                        <div class="row">
                            <dt class="me-2">
                                Department:
                            </dt>
                            <dd class="">
                                <u>@Html.DisplayFor(model => model.JobPlacement.departmentModel.departmentName)</u>
                            </dd>
                        </div>
                    }
                </dl>
                <a class="" onclick="location.href='@Url.Page("/Person/Details", new { id = Model.Person.personID })'" style="cursor:pointer;">
                    <u>View Person Details</u>
                </a>
                <hr/>
               
            </div>
        }
        else
        {
            <p>No Person Selected</p>            
        }
    </div>
<!-- right side column -->
    @if(Model.Person !=null && Model.PersonEmployments != null && Model.Employment != null)
    {
        <div class="col-md-9 d-print-flex print-full-width">
            <!--top buttons -->
            <div class="mt-1 d-flex justify-content-lg-between bg-primary text-white d-print-none">
                @if(Model.Employment.employmentStatus == Models.mainStatus.Active)
                {
                    <!--Leave Request button-->
                    @if (Model.IsLeaveAllow)
                    {
                        <a role="button" class="text-white nav-link flex-grow-1" asp-page="/Leave/Create" asp-route-id="@Model.Employment.employmentID">Leave Request</a>
                    }

                    <!--Ovetime Button-->
                    @if (Model.IsOvertimeAllow)
                    {
                        <a role="button" class="text-white nav-link flex-grow-1" asp-page="/OvertimeRecord/Create" asp-route-id="@Model.Employment.employmentID">Overtime Record</a>
                    }
                    
                }
                
                <!--leave report-->
                @if(Model.Leaves!=null && Model.Leaves.Any())
                {                  
                    <a role="button" class="text-white nav-link flex-grow-1" id="leaveHistory" data-bs-toggle="collapse" data-bs-target="#leaveHistoryView" onclick="closeOtherCollapses('#collapseOne')">Leave History</a>                
                    <a role="button" class="text-white nav-link flex-grow-1" id="leaveAggrigate" data-bs-toggle="collapse" data-bs-target="#leaveAggrigate" onclick="closeOtherCollapses('#collapseOne')">Leave Summary</a>
                    <a role="button" class="text-white nav-link flex-grow-1" id="overtimeHistory" data-bs-toggle="collapse" data-bs-target="#overtimeHistoryView" onclick="closeOtherCollapses('#collapseOne')">Overtime History</a>
                    <a role="button" class="text-white nav-link flex-grow-1" id="adjustment" data-bs-toggle="collapse" data-bs-target="#employmentHistoryView" onclick="closeOtherCollapses('#employmentHistoryView')">Employment History</a>
                }
                
            </div>
            <!--row for views-->
            <div class="row mt-1 d-flex justify-content-center">
                <!--leave Aggrigate-->
                <div class="row collapse border-primary rounded" id="leaveAggrigate">
                @if (1 == 1)
                {
                        <div class="d-flex flex-wrap justify-content-between">
                            <div class="col-md-4">
                                <h2 class="fw-bold">Leave Summary</h2>
                                <h6 class="fw-bold" onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.Employment.employmentID })'" style="cursor:pointer;">Employee Name: <u class="fw-normal">@Model.Person.personFullName</u></h6>
                                <h6 class="fw-bold">Employee ID: <u class="fw-normal"> @Model.Employment.givenID</u></h6>
                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6 class="fw-bold">Allowed Leave:</h6>
                                @if (Model.Employment.employmentStatus == Models.mainStatus.Active)
                                {
                                    <h2 class="text-success fw-bold"><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
                                }
                                else
                                {
                                    <h2 class="text-danger fw-bold"><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
                                }

                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6 class="fw-bold">Total Leave<u></u></h6>
                                <h2 class="text-success fw-bold">@Model.LeaveDetail.TotalLeave</h2>
                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6 class="fw-bold">Last Increment: <u></u></h6>
                                <h2 class="text-success fw-bold">@Model.LeaveDetail.LastAccrualIncrement</h2>
                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6 class="fw-bold">Leave Value: <u></u></h6>
                                <h2 class="text-success fw-bold">@Model.LeaveDetail.leaveCost.ToString("N2")<span class="fs-6">Br</span></h2>
                            </div>
                        </div>
                        
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr class="bg-dark text-white">
                                <th>Year</th>
                                <th>Starting Balance</th>
                                <th>Increments</th>
                                <th>Used Leave</th>
                                <th>Ending Balance</th>
                                <th>Year Balance</th>
                                <th>Cost</th>
                            
                            </tr>

                        </thead>
                        <tbody>
                            @foreach(var item in Model.LeaveDetail.AnnualLeaveHistory)
                            {
                                <tr>
                                    <td>@item.startDate.ToString("MMM dd, yyyy") - @item.endDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.startingLeaveAmount</td>
                                    <td>@item.accruedLeaveAmount</td>
                                    <td>@item.usedLeaveAmount</td>
                                    <td>@item.remainingLeaveAmount</td>
                                    <td>@item.rollOverLeave</td>
                                        <td>@item.remainingLeaveCost.ToString("N2")<span class="small">Br</span></td>
                                </tr>
                            }
                        
                        </tbody>
                    </table>
                        @await Html.PartialAsync("print")
                }else{
                    <div class="alert"><p>No leave record found.</p></div>
                    }
                </div>
      
                <!--Overtime History-->
                <div class="col-md-12 collapse border-primary rounded @(TempData["KeepOvetimeHistory"] != null ? "show" : "")" id="overtimeHistoryView">

                    @if (Model.Employment == null)
                    {
                        <p>@Model.Person.personFullName is not an emplyee.</p>
                    }
                    else
                    {
                        <div class="modal-header">
                            <h3 class="fw-bold">Overtime History</h3>
                        </div>
                        <div class="modal-body">
                            <h6 class="fw-bold" onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.Employment.employmentID })'" style="cursor:pointer;">Employee Name: <u class="fw-normal">@Model.Person.personFullName</u> </h6>
                            <h6 class="fw-bold">Employee ID: <u class="fw-normal"> @Model.Employment.givenID</u> </h6>
                            @if (Model.Overtimes == null)
                            {
                                <p>No overtime history for the selected employment. @Model.Employment.givenID</p>
                            }
                            else
                            {
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr class="bg-dark text-white">

                                            <th>
                                                Request Date
                                            </th>
                                            <th>
                                                Start Date
                                            </th>
                                            <th>
                                                End Date
                                            </th>
                                            <th>
                                                Number of Hours
                                            </th>
                                            <th>
                                                Overtime Type
                                            </th>
                                            <th>
                                                Overtime Status
                                            </th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.Overtimes)
                                        {
                                            <tr onclick="location.href='@Url.Page("/OvertimeRecord/Details", new { id = item.overtimeRecordID })'" style="cursor:pointer;">

                                                <td>
                                                    @item.overtimeRecordDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.overtimeRecordStartTime
                                                </td>
                                                <td>
                                                    @item.overtimeRecordEndTime
                                                </td>
                                                <td>
                                                   @item.TimeElapsed 
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.overtimeModel.overtimeName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.overtimeRecordStatus)
                                                </td>

                                            </tr>
                                        }


                                    </tbody>
                                </table>
                            }



                        </div>
                        <div class="modal-footer">
                            @await Html.PartialAsync("print")
                        </div>
                    }

                </div>
                <!--Leave History-->
                <div class="col-md-12 collapse border-primary rounded @(TempData["KeepLeaveHistory"] != null ? "show" : "")" id="leaveHistoryView">

                    @if (Model.Employment == null)
                    {
                        <p>@Model.Person.personFullName is not an active employee.</p>
                    }
                    else{
                        <div class="modal-header">
                            <h3 class="fw-bold">Leave History</h3>
                        </div>
                        <div class="modal-body">
                            <h6 class="fw-bold" onclick="location.href='@Url.Page("/Employment/Details", new { id = Model.Employment.employmentID })'" style="cursor:pointer;">Employee Name: <u class="fw-normal">@Model.Person.personFullName</u> </h6>
                            <h6 class="fw-bold">Employee ID: <u class="fw-normal"> @Model.Employment.givenID</u> </h6>
                            @if (Model.Leaves == null)
                            {
                                <p>No leave history for the selected employment. @Model.Employment.givenID</p>
                            }
                            else
                            {
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr class="bg-dark text-white">
                                            <th>
                                                Voucher Number
                                            </th>
                                            <th>
                                                Request Date
                                            </th>
                                            <th>
                                                Start Date
                                            </th>
                                            <th>
                                                End Date
                                            </th>
                                            <th>
                                                Number of Days
                                            </th>
                                            <th>
                                                Leave Type
                                            </th>
                                            <th>
                                                Leave Status
                                            </th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.Leaves)
                                        {
                                            <tr onclick="location.href='@Url.Page("/Leave/Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                                <td>
                                                    <a asp-page="/Leave/Details" asp-route-id="@item.leaveID" class="text-decoration-none text-dark">
                                                        @item.leaveID
                                                    </a>
                                                </td>
                                                <td>
                                                    @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveStartDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveEndDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveDays)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveStatus)
                                                </td>

                                            </tr>
                                        }


                                    </tbody>
                                </table>
                            }

                        </div>
                        <div class="modal-footer">
                            @await Html.PartialAsync("print")
                        </div>   
                    }
                        
                </div>
                <!--Employment History -->
                <div class="col-md-12 collapse border-primary rounded @(TempData["KeepCollapseOpen"] != null ? "show" : "")" id="employmentHistoryView">
                    
                    <div class="modal-header d-flex justify-content-around">
                        <h3 class="fw-bold">Employment History</h3>
                        @if (Model.isSelf && Model.PersonEmployments.FirstOrDefault(pe => pe.employmentStatus == Models.mainStatus.Active) != null)
                        {
                            
                            <button class="form-control btn btn-primary m-2 d-print-none" id="btnExprience" asp-page-handler="HandleRequest">Request Official Exprience</button>

                            <input type="hidden" id="antiForgeryToken" value="@tokens.RequestToken" />
                            <a class="form-control btn btn-primary m-2 d-print-none" id="btnTermination" asp-page="/Termination/Create"
                               asp-route-id="@Model.PersonEmployments.FirstOrDefault(pe => pe.employmentStatus == Models.mainStatus.Active).employmentID">Request Termination</a>
                            @if (Model.IsGuarantyAllow)
                            {
                                <a href="/Guaranty/Create" class="form-control btn btn-primary m-2 d-print-none" id="btnGuarantee">Request Guaranty</a>
                            }
                                                       
                        }
                        
                    </div>
                    <div class="modal-body">
                        @if (Model.PersonEmployments != null)
                        {
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr class="bg-dark text-white">
                                        <th>
                                            Given ID
                                        </th>
                                        <th>
                                            Full Name
                                        </th>
                                        <th>
                                            Emplyment Date
                                        </th>
                                        <th>
                                            Employment Status
                                        </th>
                                        <th>
                                            Employment Reference
                                        </th>
                                    
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PersonEmployments)
                                    {
                                        <tr onclick="location.href='@Url.Page("/Employment/Details", new {id = item.employmentID})'" style="cursor:pointer">
                                            <td>
                                                @Html.DisplayFor(modelItem => item.givenID)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.personModel.personFullName)
                                            </td>
                                            <td>
                                                @item.employmentDate.ToString("MMM dd, yyyy")
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.employmentStatus)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.employmentReference)
                                            </td>
                                        
                                        </tr>

                                        <table class="table table-striped table-hover">
                                            <h4 class="fw-bold">Job Placements</h4>
                                            <thead>
                                                <tr class="bg-dark text-white">                                                    
                                                    <th>
                                                        Department
                                                    </th>
                                                    <th>
                                                        Job Title
                                                    </th>
                                                    
                                                    <th>
                                                        Salary
                                                    </th>
                                                    <th>
                                                        Date
                                                    </th>
                                                    <th>
                                                        Grade
                                                    </th>
                                                    <th>
                                                        Step
                                                    </th>
                                                    <th>
                                                        Status
                                                    </th>
                                                    
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var jp in item.JobPlacements.OrderBy(j => j.jobPlacementDate))
                                                {
                                                    <tr onclick="location.href='@Url.Page("/JobPlacement/Details", new {id = jp.jobPlacementID})'" style="cursor:pointer">
                                                        
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.departmentModel.departmentName)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobModel.jobTitle)
                                                        </td>
                                                        
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobPlacementSalary)
                                                        </td>
                                                        <td>
                                                            @jp.jobPlacementDate.ToString("MMM dd, yyyy")
                                                        </td>
                                                        <td>
                                                            @jp.jobModel?.jobGradeModel?.jobGradeName
                                                        </td>
                                                        <td>
                                                            @jp.jobStepModel?.jobStepName
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobPlacementStatus)
                                                        </td>
                                                        
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No employment records.</p>
                        }

                    </div>
                    <div class="modal-footer">
                            @await Html.PartialAsync("print")
                    </div>
                        
                </div>

               
            </div>
        </div>
    }
    
</div>



   
   


<!--Toggle Collapse-->
<script>
    function closeOtherCollapses(targetId) {
        // Find all collapsible elements
        const collapsibles = document.querySelectorAll('.collapse');

        // Loop through each collapse element
        collapsibles.forEach(collapse => {
            // If it's not the target, hide it
            if (collapse.id !== targetId.substring(1)) {
                const bsCollapse = bootstrap.Collapse.getInstance(collapse);
                if (bsCollapse) {
                    bsCollapse.hide();
                }
            }
        });
    }

</script>
<script>
    document.getElementById("btnExprience").addEventListener("click", async () => {
        const requestType = "Experience"; // or any dynamic value

        try {
            const response = await fetch(/Index?handler=HandleRequest", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ requestType: requestType })
            });

            if (!response.ok) {
                throw new Error(`HTTP error ${response.status}`);
            }

            const result = await response.json();

            if (result.success) {
                alert("Request submitted successfully!");
            } else {
                alert("Request failed: " + (result.message || "Unknown error"));
            }
        } catch (error) {
            console.error("Error during request:", error);
            alert("An error occurred. Please try again later.");
        }
    });
</script>






