<!--Toggle Collapse-->
<script>
    function closeOtherCollapses(targetId) {
        // Find all collapsible elements
        const collapsibles = document.querySelectorAll('.collapse');

        // Loop through each collapse element
        collapsibles.forEach(collapse => {
            // If it's not the target, hide it
            if (collapse.id !== targetId.substring(1)) {
                const bsCollapse = bootstrap.Collapse.getInstance(collapse);
                if (bsCollapse) {
                    bsCollapse.hide();
                }
            }
        });
    }

</script>
<script>
    document.getElementById("btnExprience").addEventListener("click", async () => {
        const requestType = "Experience"; // or any dynamic value

        try {
            const response = await fetch("/Index?handler=HandleRequest", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ requestType: requestType })
            });

            if (!response.ok) {
                throw new Error(`HTTP error ${response.status}`);
            }

            const result = await response.json();

            if (result.success) {
                alert("Request submitted successfully!");
            } else {
                alert("Request failed: " + (result.message || "Unknown error"));
            }
        } catch (error) {
            console.error("Error during request:", error);
            alert("An error occurred. Please try again later.");
        }
    });
</script>






