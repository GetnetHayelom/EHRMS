@page
@using PIS2.Enums
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    var successMessage = TempData["SuccessMessage"] as string;
}
@Html.AntiForgeryToken()

<!--PAGE TITLE-->
<div class="bg-light border rounded p-4 mb-4 d-print-none">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="fw-bold mb-1">Employee Self-Service Portal</h1>
            <p class="text-muted mb-0">
                Access your employment records, leave, overtime, and company services in one place.
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            @if (Model.isSelf)
            {
                <a asp-page="/Person/Details" asp-route-id="@Model.Person.personID">
                    <span class="badge bg-primary fs-6 px-3 py-2">
                        My Records
                    </span>
                </a>  
            }
            
        </div>
    </div>
</div>

<!--ACTIONS SECTION -->
@if (Model.Person != null && Model.Employment != null)
{
    <!--TOP BUTTONS -->
    <div class="card shadow-sm border-0 mb-3 d-print-none">
        <div class="card-body p-0">
            <ul class="nav nav-pills gap-2 d-flex w-100" id="employmentTab" role="tablist">
                <li class="nav-item flex-fill" role="presentation">
                    <a role="button" class="btn btn-outline-primary rounded-0 border-0 active w-100" data-bs-toggle="tab" data-bs-target="#home"><i class="bi bi-house"></i>Home</a>
                </li>               

                <!--leave report-->
                @if (Model.Leaves != null && Model.Leaves.Any() && (Model.isSelf || User.IsInRole("MIE\\PMS_HRCLERK")))
                {
                    <li class="nav-item flex-fill" role="presentation">
                        <a role="button" class="btn btn-outline-primary rounded-0 border-0 w-100" data-bs-toggle="tab" data-bs-target="#leaveAggrigate"><i class="bi bi-pie-chart"></i>Leave Summary</a>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <a role="button" class="btn btn-outline-primary rounded-0 border-0 w-100" data-bs-toggle="tab" data-bs-target="#overtimeHistoryView"><i class="bi bi-stopwatch"></i>OT History</a>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <a role="button" class="btn btn-outline-primary rounded-0 border-0 w-100" data-bs-toggle="tab" data-bs-target="#employmentHistoryView"><i class="bi bi-person-lines-fill me-1"></i>My Employment</a>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <a role="button" class="btn btn-outline-primary rounded-0 border-0 w-100" data-bs-toggle="tab" data-bs-target="#evaluationHistoryView"><i class="bi bi-star me-1"></i>Evaluations</a>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <a role="button" class="btn btn-outline-primary rounded-0 border-0 w-100" data-bs-toggle="tab" data-bs-target="#serviceRequestsView"><i class="bi-chat-square-text me-1"></i>My Requests</a>
                    </li>
                }

                @if (Model.Employment.employmentStatus == mainStatus.Active)
                {
                    <!--Leave Request button-->
                    @if (Model.IsLeaveAllow)
                    {
                        <li class="nav-item flex-fill">
                            <a role="button" class="btn btn-outline-primary rounded-0 border-0 text-decoration-underline w-100" asp-page="/Leave/Create" asp-route-id="@Model.Employment.employmentID"><i class="bi bi-calendar-plus"></i>Leave Request</a>
                        </li>
                    }

                    <!--Ovetime Button-->
                    @if (Model.IsOvertimeAllow)
                    {
                        <li class="nav-item flex-fill">
                            <a role="button" class="btn btn-outline-primary rounded-0 border-0 text-decoration-underline w-100" asp-page="/OvertimeRecord/Create" asp-route-id="@Model.Employment.employmentID"><i class="bi bi-clock-history"></i>OT Record</a>
                        </li>
                    }

                }

            </ul>
        </div>
    </div>
}
<!--MAIN BODY-->
<div class="row mt-1 d-flex justify-content-center">
    <!--PERSON DETAILS SECTION-->
    <div class="col-md-3 d-print-none">
        <div class="card shadow-sm border-0 mb-3 position-sticky" style="top: 1rem;">
            <div class="card-header bg-primary text-white text-center py-2">
                <h5 class="fw-bold mb-0">Employee Lookup</h5>
            </div>
            <div class="card-body">
                <!-- Search Controls -->
                <h6 class="fw-semibold mb-2 text-secondary"><i class="bi bi-search me-1"></i>Find Employee</h6>
                <hr class="mt-0" />

                <!-- Search by Employee ID -->
                <form method="post" asp-page-handler="SearchID" class="input-group mb-3">
                    <input id="givenID" name="searchID" type="text" class="form-control" placeholder="Search by Employee ID"
                           asp-for="@Model.Employment.givenID" list="givenIDList">
                    <datalist id="givenIDList">
                        @foreach (var item in Model.Employments)
                        {
                            <option value="@item.givenID"></option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-primary">View</button>
                </form>

                <!-- Search by Name -->
                <form method="post" asp-page-handler="SearchName" class="input-group mb-3">
                    <input id="employeeName" name="searchName" type="text" class="form-control" placeholder="Search by Name"
                           asp-for="@Model.Person.personFullName" list="namesList">
                    <datalist id="namesList">
                        @foreach (var item in Model.People)
                        {
                            <option value="@item.personFullName">@item.personFullName</option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-primary">View</button>
                </form>

                <!-- Person Details -->
                @if (Model.Person != null && Model.Person?.personID != 0)
                {
                    <div class="card mt-3 border-0 shadow-sm">
                        <div class="card-body text-center p-3">

                            <img src="/api/attachments/viewprofile/@Model?.Person?.personID" class="rounded-circle border shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture"
                                 onerror="this.onerror=null; this.src='/images/@(Model.Person.personGender == Gender.Female ? "female-default.png" : "male-default.png")';">
                            
                            <h6 class="fw-bold mb-1 text-primary">
                                @if (Model.Employment != null)
                                {
                                    if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                    {
                                        <a href="/Employment/Edit?id=@Model.Employment.employmentID"
                                              style="cursor:pointer; text-decoration:underline;">
                                            @Html.DisplayFor(model => model.Person.personFullName)
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Employment/Details?id=@Model.Employment.employmentID"
                                              style="cursor:pointer; text-decoration:underline;">
                                            @Html.DisplayFor(model => model.Person.personFullName)
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a href="/Person/Details?id=@Model.Person.personID"
                                          style="cursor:pointer; text-decoration:underline;">
                                        @Html.DisplayFor(model => model.Person.personFullName)
                                    </a>
                                }
                            </h6>

                            <p class="mb-1 small text-muted">
                                <strong>Gender:</strong> @Html.DisplayFor(m => m.Person.personGender)
                            </p>
                            <p class="mb-1 small text-muted">
                                <strong>Phone:</strong> @Html.DisplayFor(m => m.Person.personPhoneNumber)
                            </p>
                            <p class="mb-1 small text-muted">
                                <strong>Address:</strong> @Html.DisplayFor(m => m.Person.addressModel.addressFormatted)
                            </p>
                            <p class="mb-2 small text-muted">
                                <strong>Email:</strong> @Html.DisplayFor(m => m.Person.personEmailAddress)
                            </p>

                            @if (Model.PersonEmployments != null)
                            {
                                <hr class="my-2" />
                                <p class="mb-1 small text-muted">
                                    <strong>Job Title:</strong> @Html.DisplayFor(m => m.JobPlacement.jobModel.jobTitle)
                                </p>
                                <p class="mb-1 small text-muted">
                                    <strong>Department:</strong> @Html.DisplayFor(m => m.JobPlacement.departmentModel.departmentName)
                                </p>
                            }

                            <a class="d-block mt-2 small fw-semibold text-decoration-underline text-primary"
                               href="/Person/Details?id=@Model.Person.personID"
                               style="cursor:pointer;">
                                View Full Details
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mt-3 text-center py-3">
                        <p class="mb-0 text-muted">No employee selected.</p>
                    </div>
                }
            
            </div>
        </div>
    </div>

    <div class="col-md-9 d-print-flex print-full-width">
        
            <!--ROW FOR VIEWS-->
            <div class="tab-content row mt-1 d-flex justify-content-center">
                <!--HOME-->
                <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="details-tab">
                    <!--COMPANY HUB-->
                    <div class="card shadow-sm border-0 mb-4">
                        <!--NOTICE BOARD-->
                        <div class="card-header bg-warning-subtle">
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-megaphone-fill text-warning me-2"></i> <span class="text-warning"> Notice Board</span>
                            </h5>
                        </div>
                        <div class="card-header bg-warning-subtle">
                            <partial name="_NoticeCarousel" model="Model.ActiveNoticesForCarousel" />
                        </div>
                    </div>
                    <!--FORMS-->
                    <style>
                        /* CSS for the professional hover effect */
                        .card-hover {
                            transition: transform 0.2s, box-shadow 0.2s;
                        }

                            .card-hover:hover {
                                transform: translateY(-5px); /* Lift card slightly */
                                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; /* Enhanced shadow on hover */
                            }
                    </style>
                    <div class="card shadow-sm border-0 mb-4">

                        <div class="card-header p-4 border rounded shadow-sm bg-white d-print-none">
                            <h2 class="fw-bold mb-3 text-center text-dark"><i class="bi bi-file-earmark-text fs-3 text-primary mb-2"></i>Company Forms & Requests</h2>
                            <p class="text-center text-muted">Select a form below to initiate a request and fill forms.</p>
                        </div>
                        <div class="card-body">
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Request authorization to move goods from a site.</p>
                                            <h5 class="fw-bold text-primary mb-0">
                                                <a href="@Url.Page("/Forms/GoodsGatePass")" class="text-primary text-decoration-underline">Goods Gate Pass</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Form for transferring fixed assets between locations.</p>
                                            <h5 class="fw-bold text-success mb-0">
                                                <a href="@Url.Page("/Forms/GoodsTransfer")" class="text-success text-decoration-underline">Goods Transfer</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Request Windows, Internet, or Company Email access.</p>
                                            <h5 class="fw-bold text-danger mb-0">
                                                <a href="@Url.Page("/Forms/GeneralUserAccess")" class="text-info text-decoration-underline">General User Access</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Request login credentials for the PIS system.</p>
                                            <h5 class="fw-bold text-primary mb-0">
                                                <a href="@Url.Page("/Forms/PISAccess")" class="text-danger text-decoration-underline">PIS Access</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Specific access request form for the SL system.</p>
                                            <h5 class="fw-bold text-success mb-0">
                                                <a href="@Url.Page("/Forms/SLAccess")" class="text-success text-decoration-underline">SL Access</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Template and format for official interoffice correspondence.</p>
                                            <h5 class="fw-bold text-danger mb-0">
                                                <a href="@Url.Page("/Forms/InterOffice")" class="text-info text-decoration-underline">Interoffice Memo</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Submit a formal report for sick leave or absence.</p>
                                            <h5 class="fw-bold text-info mb-0">
                                                <a href="@Url.Page("/Forms/SickReport")" class="text-danger text-decoration-underline">Sick Report</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card text-center border-0 shadow-sm h-100 card-hover">
                                        <div class="card-body p-4">
                                            <p class="text-secondary small mb-2">Transport request form</p>
                                            <h5 class="fw-bold text-info mb-0">
                                                <a href="@Url.Page("/Forms/Transport")" class="text-warning text-decoration-underline">Transport Request</a>
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.isSelf || User.IsInRole("MIE\\PMS_HRCLERK"))
                {
                    @if (Model.Leaves != null && Model.Leaves.Any())
                    {
                        <div class="tab-pane fade border-primary rounded" role="tabpanel" aria-labelledby="leave-tab" id="leaveAggrigate">
                            <h4 class="fw-bold">My Leaves & Attendance</h4>
                            <ul class="nav nav-pills gap-2" id="employmentTab" role="tablist">
                                <li class="vav-item" role="presentation">
                                    <a role="button" class="btn btn-outline-primary flex-fill rounded-0 border-0 active" data-bs-toggle="tab" data-bs-target="#leaveSummary"><i class="bi bi-pie-chart"></i>Summary</a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a role="button" class="btn btn-outline-primary flex-fill rounded-0 border-0" data-bs-toggle="tab" data-bs-target="#leaveHistoryView"><i class="bi bi-list-check"></i>Detail</a>
                                </li>
                            </ul>
                            <div class="tab-content row mt-1 d-flex justify-content-center">
                                <!--LEAVE SUMMARY-->
                                <div class="tab-pane fade show active border-primary rounded" role="tabpanel" aria-labelledby="leave-tab" id="leaveSummary">
                                    <div class="card shadow-sm border-0">
                                        <div class="card-body">
                                            
                                            @if (Model.Employment.Leaves != null)
                                            {
                                                @await Html.PartialAsync("Employment/_LeaveSummaryPartial", Model.LeaveDetail)
                                            }
                                            else
                                            {
                                                <p class="text-muted">No leave records found.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <!--LEAVE HISTORY-->
                                <div class="tab-pane fade row border-primary rounded" role="tabpanel" id="leaveHistoryView">
                                    <div class="card shadow-sm border-0">
                                        <div class="card-body">
                                            <h5 class="fw-bold mb-3">Leave History</h5>
                                            @if (Model.Employment == null)
                                            {
                                                <p>@Model.Person.personFullName is not an active employee.</p>
                                            }
                                            else
                                            {
                                                @await Html.PartialAsync("Employment/_LeaveHistoryPartial", Model.Leaves)
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                
                    <!--OVERTIME HISTORY-->
                    <div class="tab-pane fade border-primary rounded" role="tabpanel" id="overtimeHistoryView">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="fw-bold mb-3">Overtime Records</h5>
                                @if (Model.Employment == null)
                                {
                                    <p>@Model.Person.personFullName is not an emplyee.</p>
                                }
                                else
                                {
                                    @await Html.PartialAsync("Employment/_OvertimeHistoryPartial", Model.Overtimes)
                                }

                            </div>
                        </div>
                    </div>
                
                    <!--EMPLOYMENT HISTORY -->
                    <div class="tab-pane fade row border-primary rounded" role="tabpanel" id="employmentHistoryView">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-white border-bottom">
                                <h3 class="fw-bold col-md-6">Employment History</h3>
                                @if (Model.isSelf && Model.Employment?.employmentStatus == mainStatus.Active)
                                {
                                
                                <div class="d-flex p-2 m-2">
                                    @foreach(var req in Model.RequestTypes)
                                    {
                                    <button type="button" class="form-control btn btn-primary m-2 d-print-none" id="@req.serviceRequestTypeID" data-request-type="@req.serviceRequestTypeID" onclick="requestService(this)">
                                            @req.serviceRequestTypeName
                                    </button>
                                    }
                                    
                                    </div>
                                }
                        
                            </div>
                            <div class="card-body">
                                @if (Model.PersonEmployments != null)
                                {
                                    <table class="table table-sm table-striped table-hover">
                                        <thead>
                                            <tr class="bg-dark text-white">
                                                <th>
                                                    Given ID
                                                </th>
                                                <th>
                                                    Full Name
                                                </th>
                                                <th>
                                                    Emplyment Date
                                                </th>
                                                <th>
                                                    Employment Status
                                                </th>
                                                <th colspan ="3">
                                                    Employment Reference
                                                </th>
                                            
                                    
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.PersonEmployments)
                                            {
                                                <tr onclick="location.href='@Url.Page("/Employment/Details", new {id = item.employmentID})'" style="cursor:pointer">
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.givenID)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.personModel.personFullName)
                                                    </td>
                                                    <td>
                                                        @item.employmentDate.ToString("MM/dd/yyyy")
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.employmentStatus)
                                                    </td>
                                                    <td colspan="3">
                                                        @Html.DisplayFor(modelItem => item.employmentReference)
                                                    </td>

                                                </tr>
                                                <tr>
                                                    <td col-span="8"><h4 class="fw-bold">Job Placements</h4></td>
                                                </tr>
                                             
                                                <tr class="bg-dark text-white">                                                    
                                                        <th>
                                                            Department
                                                        </th>
                                                        <th>
                                                            Job Title
                                                        </th>
                                                    
                                                        <th>
                                                            Salary
                                                        </th>
                                                        <th>
                                                            Date
                                                        </th>
                                                        <th>
                                                            Grade
                                                        </th>
                                                        <th>
                                                            Step
                                                        </th>
                                                        <th>
                                                            Status
                                                        </th>
                                                    
                                                    </tr>
                                                
                                                @foreach (var jp in item.JobPlacements.OrderBy(j => j.jobPlacementDate))
                                                        {
                                                            <tr onclick="location.href='@Url.Page("/JobPlacement/Details", new {id = jp.jobPlacementID})'" style="cursor:pointer">
                                                        
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => jp.departmentModel.departmentName)
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => jp.jobModel.jobTitle)
                                                                </td>
                                                        
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => jp.jobPlacementSalary)
                                                                </td>
                                                                <td>
                                                                    @jp.jobPlacementDate.ToString("MM/dd/yyyy")
                                                                </td>
                                                                <td>
                                                                    @jp.jobModel?.jobGradeModel?.jobGradeName
                                                                </td>
                                                                <td>
                                                                    @jp.jobStepModel?.jobStepName
                                                                </td>
                                                                <td>
                                                                    @Html.DisplayFor(modelItem => jp.jobPlacementStatus)
                                                                </td>
                                                        
                                                            </tr>
                                                        }
                                               
                                           
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p>No employment records.</p>
                                }

                            </div>
                            <div class="card-footer">
                                @await Html.PartialAsync("print")
                            </div>
                        </div>
                    </div>
                    <!--EVALUATION HISTORY-->
                    <div class="tab-pane fade" id="evaluationHistoryView" role="tabpanel" aria-labelledby="eval-tab">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Evaluation Records</h5>
                            @if (Model.EvalReport != null)
                            {
                                @foreach (var eval in Model.EvalReport)
                                {
                                    @await Html.PartialAsync("Employment/_EvaluationPartial", eval)
                                }

                            }
                            else
                            {
                                <p class="text-muted">No evaluation records found.</p>
                            }
                        </div>
                    </div>
                </div>

                    <!--SERVICE REQUESTS-->
                    <div class="tab-pane fade" id="serviceRequestsView" role="tabpanel" aria-labelledby="req-tab">
                        <div class="card shadow-sm p-2">
                            @if (Model.Requests.Any())
                            {
                                <h4 class="fw-bold">Requested Services Status</h4>
                                <table class="table table-striped table-hover">
                                    <thead class="bg-dark text-white">
                                        <tr>
                                            <th>S/No</th>
                                            <th>Requested Service</th>
                                            <th>Requested Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int index = 0;
                                            string bg = "";
                                        }
                                        @foreach (var req in Model.Requests)
                                        {
                                            bg = req.serviceRequestStatus switch
                                                {
                                                Enums.ServiceRequestStatus.Hold => "bg-warning",
                                                Enums.ServiceRequestStatus.Reviewed => "bg-success",
                                                Enums.ServiceRequestStatus.Completed => "bg-secondary",
                                                _ => "bg-danger"
                                                };

                                            index++;
                                            <tr>
                                                <td>@index</td>
                                                <td>@req.ServiceRequestType?.serviceRequestTypeName</td>
                                                <td>@req.serviceRequestDate</td>
                                                <td><span class="badge @bg">@req.serviceRequestStatus</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            }
                            else
                            {
                                <h6 class="text-muted">No Service Request History</h6>
                            }
                        </div>
                    </div>
                }
                
            </div>
        
    </div>

</div>

<script>
   
    let requestInProgress = false;

    async function requestService(button) {
    if (requestInProgress) return;

    const requestType = button.dataset.requestType;
    if (!requestType) {
        showToast("Error", "Invalid request type");
        return;
    }

    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const token = tokenInput?.value;
    if (!token) {
        showToast("Error", "Security token missing");
        return;
    }

    requestInProgress = true;

    try {
        const response = await fetch("/Index?handler=HandleRequest", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ requestType })
        });

        if (!response.ok) throw new Error("Request failed");

        const result = await response.json();

        if (result.success) {
            showToast("Success", "Request submitted successfully");
            if (result.redirect) {
                window.location = result.redirect;
            }
        } else {
            showToast("Error", result.message ?? "Request failed");
        }
    } catch (error) {
        console.error(error);
        showToast("Error", "Unexpected error occurred");
    } finally {
        requestInProgress = false;
    }
}


</script>








