@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    var successMessage = TempData["SuccessMessage"] as string;
  
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
</div>
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
<div class="row mt-1 d-flex justify-content-center">

    <div class="col-md-3"><!--Person Section-->
    <!--row for Search control-->
        <div class="row mt-2">
            <!--form for searching using ID --> 
            <label for="employeeID">Look up by Empolyee ID:</label>
            <form method="post" asp-page-handler="SearchID" class="d-flex">
     
                    <input id="givenID" name="searchID" type="text" class="form-control mb-1" asp-for="@Model.Employment.givenID" list="givenIDList">
                    <datalist id="givenIDList">
                        @foreach (var item in Model.Employments)
                        {
                            <option value="@item.givenID"></option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-success mb-1">View</button>
                
            </form>
            <!--form for searching using name-->
            <label for="employeeName">Look up by Name:</label>
            <form method="post" asp-page-handler="SearchName" class="d-flex">
                <input id="employeeName" name="searchName" type="text" class="form-control mb-1" asp-for="@Model.Person.personFullName" list="namesList">
                    <datalist id="namesList">
                        @foreach (var item in Model.People)
                        {
                            <option value="@item.personFullName">@item.personFullName</option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-success mb-1">View</button>
               
            </form>
        </div>
        <!--row for person details -->
        @if (Model.Person != null)
        {
            <!--row for person remaining Details -->
            <div class="row mt-2 border-primary rounded mb-1 bg-danger text-white">

                <h4>Peresonal Information</h4>
                <hr />
                @if (Model.PersonEmployments != null && Model.PersonEmployments.Count > 0)
                {
                    <div class="col-md-12 mb-1 d-flex justify-content-center">
                        <button type="button" class="btn btn-primary btn-block  w-100 btn-lg" id="adjustment" data-bs-toggle="collapse" data-bs-target="#employmentHistoryView" onclick="closeOtherCollapses('#collapseOne')">Employment History</button>
                    </div>
                }
                <img src ="~/assets/blank_profile.jpg" class-="rounded-circle" width="100" height="100"/>
                <dl class="row">

                    <dt class="col-sm-5">
                        Full Name: 
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personFullName)</u>
                    </dd>
                    <dt class="col-sm-5">
                        DoB:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Model.Person.personDoB.ToString("MMM dd, yyyy")</u>
                    </dd>
                    
                    <dt class="col-sm-5">
                        Gender:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personGender)</u>
                    </dd>
                    
                    <dt class="col-sm-5">
                        Id Type:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personIDType)</u>
                    </dd>
                    
                    <dt class="col-sm-5">
                        Id Number:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personIDNumber)</u>
                    </dd>
                    <dt class="col-sm-5">
                        Phone:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personPhoneNumber)</u>
                    </dd>
                    <dt class="col-sm-5">
                        Record Number:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personRecordNumber)</u>
                    </dd>
                    <dt class="col-sm-5">
                        Address:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.addressModel.addressFormatted)</u>
                    </dd>
                    <dt class="col-sm-5">
                        Email:
                    </dt>
                    <dd class="col-sm-7">
                        <u>@Html.DisplayFor(model => model.Person.personEmailAddress)</u>
                    </dd>
                </dl>
                <hr/>
               
            </div>
        }
        else
        {
            <p>No Person Selected</p>            
        }
    </div>
<!-- right side column -->
    @if(Model.Person !=null && Model.PersonEmployments != null && Model.Employment != null)
    {
        <div class="col-md-9">
            <!--top buttons -->
            <div class="mt-1 d-flex justify-content-lg-between bg-primary text-white">
                @if(Model.Employment.employmentStatus == Models.mainStatus.Active)
                {
                    <!--Leave Request button-->
                <a role="button" class="text-white nav-link flex-grow-1" id="leaveRequest" data-bs-toggle="collapse" data-bs-target="#leaveRequestView" onclick="closeOtherCollapses('#collapseOne')">Leave Request</a>
                          
                <!--Ovetime Button-->
                <a role="button" class="text-white nav-link flex-grow-1" id="Overtime" data-bs-toggle="collapse" data-bs-target="#overtimeView" onclick="closeOtherCollapses('#collapseOne')">Overtime</a>
               
                }
                
                <!--leave report-->
                @if(Model.Leaves!=null && Model.Leaves.Any())
                {                  
                    <a role="button" class="text-white nav-link flex-grow-1" id="leaveHistory" data-bs-toggle="collapse" data-bs-target="#leaveHistoryView" onclick="closeOtherCollapses('#collapseOne')">Leave History</a>
                
                    <a role="button" class="text-white nav-link flex-grow-1" id="leaveAggrigate" data-bs-toggle="collapse" data-bs-target="#leaveAggrigate" onclick="closeOtherCollapses('#collapseOne')">Leave Summary</a>
                    <a role="button" class="text-white nav-link flex-grow-1" id="overtimeHistory" data-bs-toggle="collapse" data-bs-target="#overtimeHistoryView" onclick="closeOtherCollapses('#collapseOne')">Overtime History</a>
                    
                }
                
            </div>
            <!--row for views-->
        <div class="row mt-1 d-flex justify-content-center">
                <!--leave Aggrigate-->
                <div class="row collapse border-primary rounded" id="leaveAggrigate">
                @if (1 == 1)
                {
                        <div class="d-flex flex-wrap justify-content-between">
                            <div class="col-md-6">
                                <h1>Leave Summary</h1>
                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6>Allowed Leave:</h6>
                                @if (Model.Employment.employmentStatus == Models.mainStatus.Active)
                                {
                                    <h2 class="text-success"><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
                                }
                                else
                                {
                                    <h2 class="text-danger"><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
                                }

                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6>Total Leave<u></u></h6>
                                <h2 class="text-success">@Model.LeaveDetail.TotalLeave</h2>
                            </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center">
                                <h6>Last Increment: <u></u></h6>
                                <h2 class="text-success rounded-circle border-success">@Model.LeaveDetail.LastAccrualIncrement</h2>
                            </div>
                        </div>
                        
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr class="bg-dark text-white">
                                <th>Year</th>
                                <th>Starting Balance</th>
                                <th>Increments</th>
                                <th>Used Leave</th>
                                <th>Available Balance</th>
                                    <th>Current Year Balance</th>
                            
                            </tr>

                        </thead>
                        <tbody>
                            @foreach(var item in Model.LeaveDetail.AnnualLeaveHistory)
                            {
                                <tr>
                                    <td>@item.startDate.ToString("MMM dd, yyyy") - @item.endDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.startingLeaveAmount</td>
                                    <td>@item.accruedLeaveAmount</td>
                                    <td>@item.usedLeaveAmount</td>
                                    <td>@item.remainingLeaveAmount</td>
                                        <td>@item.rollOverLeave</td>
                                </tr>
                            }
                        
                        </tbody>
                    </table>
                        <button class="btn-primary d-print-none" onclick="printDiv('leaveAggrigate')">Print Summary</button>
                }else{
                    <div class="alert"><p>No leave record found.</p></div>
                    }
                </div>
            <!--Leave request-->
            <div class="col-md-8 collapse border-primary rounded @(TempData["KeepLeaveRequest"] != null ? "show" : "")" id="leaveRequestView">
                @if (Model.Employment == null)
                {
                    <p>@Model.Person.personFullName is not an emplyee.</p>
                }
                else
                {
                    <div class="bg-success text-white rounded-2 d-flex flex-wrap justify-content-between">
                    
                    <div class="col-md-6">
                        <h3>Leave Request Form</h3>
                    </div>
                        <div class="col-md-2 d-flex flex-column justify-content-center align-items-center border-start">
                            <h6>Allowed Leave:</h6>
                            <h2><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
                        </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center border-start">
                            <h6>Total Leave<u></u></h6>
                            <h2>@Model.LeaveDetail.TotalLeave</h2>
                        </div>
                            <div class="col-md-2 d-flex flex-column justify-content-center align-items-center border-start">
                            <h6 class="align-items-center">Last Increment: <u></u></h6>
                            <h2>@Model.LeaveDetail.LastAccrualIncrement</h2>
                        </div>
                    </div>
                    <div class="modal-body">
                        <form method="post" asp-page-handler="CreateLeave">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <p>Employee Name:<u><b>@Model.Person.personFullName</b></u>  Employee Id: <u><b>@Model.Employment.givenID</b></u></p>
                            <div class="form-group d-flex">
                                <input type="hidden" asp-for="personID" Value = "@Model.Person.personID"/>
                                <input type="hidden" asp-for="employmentID" class="form-control" value="@Model.Employment.employmentID"/>
                                <span asp-validation-for="employmentID" class="text-danger"></span>
                            </div>
                            <div class="d-flex flex-wrap justify-content-between">
                           
                                <div class="form-group m-1 col-md-5">
                                    <label asp-for="Leave.leaveStartDate" class="control-label me-2">Start Date:</label>
                                    <input asp-for="Leave.leaveStartDate" class="form-control flex-grow-1 col-md-6" type="date" />
                                    <span asp-validation-for="Leave.leaveStartDate" class="text-danger"></span>
                                </div>
                                    <div class="form-group m-1 col-md-5">
                                    <label asp-for="Leave.leaveEndDate" class="control-label">End Date:</label>
                                    <input asp-for="Leave.leaveEndDate" class="form-control col-md-6" type="date" />
                                    <span asp-validation-for="Leave.leaveEndDate" class="text-danger"></span>
                                </div>
                                    <div class="form-group m-1 col-md-5">
                                    <label asp-for="Leave.leaveDays"class="control-label">Number of Days:</label>
                                        <input asp-for="Leave.leaveDays" class="form-control col-md-6" type="number" step="0.5" />
                                    <span asp-validation-for="Leave.leaveDays" class="text-danger"></span>
                                </div>
                                    <div class="form-group m-1 col-md-5">
                                    <label asp-for="Leave.leaveTypeID" class="control-label">Leave Type:</label>
                                    <select asp-for="Leave.leaveTypeID" class="form-control" asp-items="ViewBag.leaveTypeID"></select>
                                    <span asp-validation-for="Leave.leaveTypeID" class="text-danger"></span>
                                </div>
                                
                            </div>
                            @await Html.PartialAsync("signature")
                            
                            <!-- Display Leave ID and Print Button on Success -->
                            @if (TempData["LeaveID"] != null)
                            {
                                
                                        <p>Voucher ID:<u><b>@TempData["LeaveID"]</b></u></p>
                                    <hr />

                                    <div class="mt-3 d-flex flex-wrap justify-content-end d-print-none">
                                        <button type="button" class="btn btn-primary btn-md btn-block w-50 m-1" onclick="printDiv('leaveRequestView')">Print Leave Voucher</button>
                                        <button typr="button" class="btn btn-primary btn-md btn-block w-50 m-1">Request New Leave</button>
                                    </div>

                                }
                                else
                                {
                                    <div class="modal-footer d-print-none">
                                <button type="submit" class="btn btn-success">Save</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                                }

                            
                        </form>
                        </div>
                }                      
            </div>
            <!--Overtime-->
            <div class="col-md-8 collapse border-primary rounded @(TempData["KeepOvertime"] != null ? "show" : "")" id="overtimeView">
                <div class="modal-header">
                    <h5>Overtime Record</h5>
                </div>
                <div class="modal-body">
                <form method="post" asp-page-handler="CreateOvertimeRecord">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group d-flex">
                        <input type="hidden" asp-for="personID" Value="@Model.Person.personID" />
                        <input type="hidden" asp-for="overtimeRecordModel.employmentID" class="form-control" value="@Model.Employment.employmentID" />
                        <span asp-validation-for="employmentID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="overtimeRecordModel.employmentID" class="control-label">Employee ID</label>
                        <select asp-for="Employment.employmentID" class="form-control" asp-items="ViewBag.employmentID"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="overtimeRecordModel.overtimeID" class="control-label">Overtime Type</label>
                        <select asp-for="overtimeRecordModel.overtimeID" class="form-control" asp-items="ViewBag.overtimeID"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="overtimeRecordModel.overtimeRecordDate" class="control-label">Date</label>
                        <input asp-for="overtimeRecordModel.overtimeRecordDate" class="form-control" type="date"/>
                        <span asp-validation-for="overtimeRecordModel.overtimeRecordDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="overtimeRecordModel.overtimeRecordStartTime" class="control-label">Start</label>
                        <input asp-for="overtimeRecordModel.overtimeRecordStartTime" class="form-control" type="time" />
                        <span asp-validation-for="overtimeRecordModel.overtimeRecordStartTime" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="overtimeRecordModel.overtimeRecordEndTime" class="control-label">End</label>
                        <input asp-for="overtimeRecordModel.overtimeRecordEndTime" class="form-control" type="time" />
                        <span asp-validation-for="overtimeRecordModel.overtimeRecordEndTime" class="text-danger"></span>
                    </div>
                    @await Html.PartialAsync("signature")
                    <!-- Display Leave ID and Print Button on Success -->
                    @if (TempData["OvertimeID"] != null)
                    {
                        <div class="mt-3">
                            <p>Leave Voucher ID: @TempData["OvertimeID"]</p>
                            <button type="button" class="btn btn-primary btn-lg btn-block w-100 d-print-none" onclick="printDiv('overtimeView')">Preview Overtime Voucher</button>
                        </div>

                    }

                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-primary d-print-none" />
                        <button type="button" class="btn btn-secondary d-print-none">Close</button>
                    </div>
                </form>
                </div>
                        
        </div>
            <!--Overtime History-->
            <div class="col-md-12 collapse border-primary rounded @(TempData["KeepOvetimeHistory"] != null ? "show" : "")" id="overtimeHistoryView">

                    @if (Model.Employment == null)
                    {
                        <p>@Model.Person.personFullName is not an emplyee.</p>
                    }
                    else
                    {
                        <div class="modal-header">
                            <h3>Overtime History</h3>
                        </div>
                        <div class="modal-body">
                            <h6>Employee Name: <b><u>@Model.Person.personFullName</u></b> </h6>
                            <h6>Employee ID: <b><u> @Model.Employment.givenID</u></b> </h6>
                            @if (Model.Overtimes == null)
                            {
                                <p>No overtime history for the selected employment. @Model.Employment.givenID</p>
                            }
                            else
                            {
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr class="bg-dark text-white">

                                            <th>
                                                Request Date
                                            </th>
                                            <th>
                                                Start Date
                                            </th>
                                            <th>
                                                End Date
                                            </th>
                                            <th>
                                                Number of Hours
                                            </th>
                                            <th>
                                                Overtime Type
                                            </th>
                                            <th>
                                                Overtime Status
                                            </th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.Overtimes)
                                        {
                                            <tr>

                                                <td>
                                                    @item.overtimeRecordDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.overtimeRecordStartTime
                                                </td>
                                                <td>
                                                    @item.overtimeRecordEndTime
                                                </td>
                                                <td>
                                                    
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.overtimeModel.overtimeName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.overtimeRecordStatus)
                                                </td>

                                            </tr>
                                        }


                                    </tbody>
                                </table>
                            }



                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary d-print-none" onclick="printDiv('overtimeHistoryView')">Print</button>
                            <button type="button" class="btn btn-secondary d-print-none" data-bs-dismiss="modal">Close</button>
                        </div>
                    }

                </div>
            <!--Leave History-->
            <div class="col-md-12 collapse border-primary rounded @(TempData["KeepLeaveHistory"] != null ? "show" : "")" id="leaveHistoryView">

                    @if (Model.Employment == null)
                    {
                        <p>@Model.Person.personFullName is not an emplyee.</p>
                    }
                    else{
                        <div class="modal-header">
                            <h3>Leave History</h3>
                        </div>
                        <div class="modal-body">
                            <h6>Employee Name: <b><u>@Model.Person.personFullName</u></b> </h6>
                            <h6>Employee ID: <b><u> @Model.Employment.givenID</u></b> </h6>
                            @if (Model.Leaves == null)
                            {
                                <p>No leave history for the selected employment. @Model.Employment.givenID</p>
                            }
                            else
                            {
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr class="bg-dark text-white">

                                            <th>
                                                Request Date
                                            </th>
                                            <th>
                                                Start Date
                                            </th>
                                            <th>
                                                End Date
                                            </th>
                                            <th>
                                                Number of Days
                                            </th>
                                            <th>
                                                Leave Type
                                            </th>
                                            <th>
                                                Leave Status
                                            </th>

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.Leaves)
                                        {
                                            <tr>

                                                <td>
                                                    @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveStartDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveEndDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveDays)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveStatus)
                                                </td>

                                            </tr>
                                        }


                                    </tbody>
                                </table>
                            }



                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary d-print-none" onclick="printDiv('leaveHistoryView')">Print</button>
                        <button type="button" class="btn btn-secondary d-print-none" data-bs-dismiss="modal">Close</button>
                    </div>   
                    }
                        
             </div>
            <!--Employment History -->
            <div class="col-md-12 collapse border-primary rounded @(TempData["KeepCollapseOpen"] != null ? "show" : "")" id="employmentHistoryView">
                    
                <div class="modal-header">
                    <h5>Employment History</h5>
                </div>
                <div class="modal-body">
                    @if (Model.PersonEmployments != null)
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr class="bg-dark text-white">
                                    <th>
                                        Given ID
                                    </th>
                                    <th>
                                        Full Name
                                    </th>
                                    <th>
                                        Emplyment Date
                                    </th>
                                    <th>
                                        Employment Status
                                    </th>
                                    <th>
                                        Employment Reference
                                    </th>
                                    <th>
                                        Working Hours Per Week
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PersonEmployments)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.givenID)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.personModel.personFullName)
                                        </td>
                                        <td>
                                            @item.employmentDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.employmentStatus)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.employmentReference)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.workingHoursPerWeek)
                                        </td>
                                        <td>
                                        </td>
                                    </tr>
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr class="bg-dark text-white">
                                                    
                                                    <th>
                                                        Department
                                                    </th>
                                                    <th>
                                                        Job Title
                                                    </th>
                                                    
                                                    <th>
                                                        Salary
                                                    </th>
                                                    <th>
                                                        Date
                                                    </th>
                                                    <th>
                                                        Status
                                                    </th>
                                                    
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var jp in item.JobPlacements)
                                                {
                                                    <tr>
                                                        
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.departmentModel.departmentName)
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobModel.jobTitle)
                                                        </td>
                                                        
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobPlacementSalary)
                                                        </td>
                                                        <td>
                                                            @jp.jobPlacementDate.ToString("MMM dd, yyyy")
                                                        </td>
                                                        <td>
                                                            @Html.DisplayFor(modelItem => jp.jobPlacementStatus)
                                                        </td>
                                                        
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No employment records.</p>
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary">Print</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="collapse">Close</button>
                </div>
                        
            </div>
        </div>
    </div>
    }
    
</div>


<!--main body row, encloses person details and leave report -->
@if (Model.Person != null && Model.PersonEmployments != null && Model.Employment != null)
{
    <!--leave request view -->
    <div class="modal" tabindex="-1" role="dialog" id="leaveRequestModal">
        <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
