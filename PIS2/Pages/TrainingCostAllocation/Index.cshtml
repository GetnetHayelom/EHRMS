@page
@model PIS2.Pages.TrainingCostAllocation.IndexModel
@{
    ViewData["Title"] = "Cost Allocation";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Training Cost Distribution</h1>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm"><i class="fas fa-file-export me-1"></i> Export</button>
            <a asp-page="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus me-1"></i> New Allocation
            </a>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Training Program</th>
                        <th>Session Date</th>
                        <th class="text-end">Allocated Cost</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Allocations)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.Attendance?.EmploymentModel?.personModel?.personFullName</div>
                                <small class="text-muted">ID: @item.Attendance?.employmentID</small>
                            </td>
                            <td>@item.Attendance?.TrainingSession?.Training?.trainingTitle</td>
                            <td>@(item.Attendance?.TrainingSession?.startDate.ToShortDateString() ?? "-")</td>
                            <td class="text-end fw-bold text-dark">
                                @item.allocatedCost.ToString("C")
                            </td>
                            <td class="text-end px-4">
                                <a asp-page="./Edit" asp-route-id="@item.trainingCostAllocationID" class="btn btn-sm btn-light">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end">Total Allocated:</td>
                        <td class="text-end">@Model.TotalCost.ToString("C")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>