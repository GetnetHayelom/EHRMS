@page
@model PIS2.Pages.Report.OvertimeReceordReportModel

@{
    ViewData["Title"] = "Overtime Records";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")
<!--PAGE HEADER-->
<div class="d-flex justify-content-between">
    <h2 class="fw-bold">Overtime Report</h2>
    <!--TABS CONTROL-->
    <div class="d-flex d-print-none">
        <ul class="nav nav-tabs nav-pills">

            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#summaryView">Overtime Summary</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#customOvertimeReport">Custom Overtime Report</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dashboardView">Overtime Analysis</button>
            </li>
            <li>@await Html.PartialAsync("print")</li>
        </ul>

    </div>
</div>
<hr />

<div class="tab-content">
    <!--ALL OVERTIME SUMMARY REPORT VIEW DEFAULT ON GET HANDLER-->
    <div class="tab-pane fade show active" id="summaryView">
        <h4 class="fw-bold">Summary Report</h4>

        <!--SUMMARY POINTS-->
        <div class="card shadow-sm p-2">
            <div class="d-flex gap-3 mb-4 d-print-flex flex-wrap">

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-info border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total Overtime (Records)</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.TotalRecords1.ToString("N0")</u></h4>
                                </div>
                                <div><i class="bi bi-journal-check fs-2 text-info"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total Overtime (Days)</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.TotalDays1.ToString("N0")</u></h4>
                                </div>
                                <div><i class="bi bi-calendar fs-2 text-primary"></i></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Involved Employees</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.InvolvedEmployees1.ToString("N0")</u></h4>
                                </div>
                                <div><i class="bi bi-cash fs-2 text-warning"></i></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total Overtime Cost</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.TotalCost1.ToString("N0")</u></h4>
                                </div>
                                <div><i class="bi bi-cash fs-2 text-warning"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-success border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Days Per Employee</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.DaysPerEmployees1.ToString("N0")</u></h4>
                                </div>
                                <div><i class="bi bi-calendar-day fs-2 text-success"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-danger border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Cost Per Employee</small>
                                    <h4 class="fw-bold mb-0"><u>@Model.CostPerEmployees1.ToString("N2")</u></h4>
                                </div>
