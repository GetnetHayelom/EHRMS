                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Overtime (Records)</small>
                                <h4 class="fw-bold mb-0"><u id="TotalRecords">@Model.TotalRecords.ToString("N0")</u></h4>
                            </div>
