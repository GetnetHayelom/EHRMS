<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>


<script>


    $(document).ready(function () {


        $('button[data-bs-target="#customOvertimeReport"]')
        .on('shown.bs.tab', function () {
            const today = new Date();
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(today.getFullYear() - 1);

            $("#dateStart").val(formatDate(oneYearAgo));
            $("#dateEnd").val(formatDate(today));

            filterOvertime();

        });
    });

    function setDefaultAbsentismDates() {
        const today = new Date();
        const oneYearAgo = new Date();
        oneYearAgo.setFullYear(today.getFullYear() - 1);

        $("#dateStart-absentism").val(formatDate(oneYearAgo));
        $("#dateEnd-absentism").val(formatDate(today));
    }

    function formatDate(date) {
        return date.toISOString().split("T")[0]; // yyyy-MM-dd
    }

    function qp(v) {
        return v == null ? '' : encodeURIComponent(v);
    }


    let monthlyChartInstance =null;
    function filterOvertime() {
        var department = $("#filter-department").val();
        var overtimeStatus = $("#filter-status").val();
        var overtimeType = $("#filter-type").val();
        var company = $("#filter-company").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();
        var empID = $("#empID").val();

        
        // Normalize empty values to null
        department = (!department || department === "") ? null : department;
        overtimeStatus = (!overtimeStatus || overtimeStatus === "") ? null : overtimeStatus;
        overtimeType = (!overtimeType || overtimeType === "") ? null : overtimeType;
            company = (!company || company === "") ? null : company;
            dateStart = dateStart ? new Date(dateStart).toISOString() : null;
            dateEnd = dateEnd ? new Date(dateEnd).toISOString() : null;

        

        // Build the URL with filters
        var url = `/Report/OvertimeRecordReport?handler=Filter` +
            `&department=${encodeURIComponent(department)}` +
            `&overtimeStatus=${encodeURIComponent(overtimeStatus)}` +
            `&overtimeType=${encodeURIComponent(overtimeType)}` +
            `&company=${encodeURIComponent(company)}` +
            `&dateStart=${encodeURIComponent(dateStart)}` +
            `&dateEnd=${encodeURIComponent(dateEnd)}`;

        
        // jQuery AJAX
        $.getJSON(url, function (data) {
            
            $("#table-body").html(data.tableHtml);
            $("#TotalRecords").text(parseFloat(data.totalRecords).toFixed(2));
            $("#TotalHours").text(parseFloat(data.totalHours).toFixed(2) + " Hrs");
            $("#TotalDays").text(parseFloat(data.totalDays).toFixed(2) + " Days");
            $("#InvolvedEmployees").text(parseFloat(data.involvedEmployees).toFixed(2));
            $("#TotalCost").text(parseFloat(data.totalCost).toFixed(2));
            $("#DaysPerEmployees").text(parseFloat(data.daysPerEmployees).toFixed(2) + " Days");
            $("#CostPerEmployees").text(parseFloat(data.costPerEmployees).toFixed(2));

            
            // MONTHLY CHART
            const monthlyCtx = document.getElementById('monthlyChart').getContext('2d');

            // Map the data
            const labels = data.monthlySummary.map(m => m.period);
            const overtimeCounts = data.monthlySummary.map(m => m.overtimeCount);
            const totalCosts = data.monthlySummary.map(m => m.totalCost);

            // Destroy previous chart instance if exists
            if (monthlyChartInstance) {
                monthlyChartInstance.destroy();
            }

            monthlyChartInstance = new Chart(monthlyCtx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Overtime Count',
                            data: overtimeCounts,
                            borderColor: 'rgba(54, 162, 235, 1)',
                            backgroundColor: 'rgba(54, 162, 235, 0.8)',
                            yAxisID: 'yCount',
                            tension: 0.4

                        },
                        {
                            label: 'Total Cost',
                            data: totalCosts,
                            borderColor: 'rgba(255, 206, 86, 1)',
                            backgroundColor: 'rgba(255, 206, 86, 0.8)',
                            yAxisID: 'yCost',
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    stacked: false,
                    plugins: {
                        tooltip: { mode: 'index', intersect: false },
                        legend: { position: 'top' }
                    },
                    scales: {
                        yCount: {
                            type: 'linear',
                            position: 'left',
                            ticks: {
                                stepSize: Math.max(1, Math.ceil(Math.max(...overtimeCounts, 1) / 10))
                            },
                            title: { display: true, text: 'Overtime Count' }
                        },
                        yCost: {
                            type: 'linear',
                            position: 'right',
                            ticks: {
                                stepSize: Math.ceil(Math.max(...totalCosts) / 10),
                                callback: function(value) {
                                    if (value >= 1000) return (value / 1000) + 'k';
                                    return value;
                                }
                            },
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Total Cost' }
                        },
                        x: { title: { display: true, text: 'Period' } }
                    }
                }
            });
            //MONTHLY CHART END
            updateRowCount("countID");
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error("Error:", textStatus, errorThrown);
        });
    }
    

 
</script>
<script>
    $(document).on("click", ".dept-row", function () {
        var deptId = $(this).data("deptid");
        var overtimeStatus = $("#filter-status").val();
        var overtimeType = $("#filter-type").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();
        var empID = $("#empID").val();

        var $row = $(this);

        // Prevent duplicate loading
        if ($row.hasClass("loaded")) return;
        $row.addClass("loaded");

        $.get(`/Report/OvertimeRecordReport?handler=DepartmentDetails&deptId=${deptId}&overtimeStatus=${overtimeStatus}&overtimeType=${overtimeType}&dateStart=${dateStart}&dateEnd=${dateEnd}&empID=${empID}`, function (data) {
            // Insert after the department row
            $row.after(data.tableHtml);
        });
    });
</script>


@section Scripts {
    
    <script>
        

        // DASHBOARD CHARTS
        function createBarChart(canvasId, labels, data, labelText, color) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: labelText,
                        data: data,
                        backgroundColor: color
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            ticks: {
                                // make tick values readable
                                callback: function(value) {
                                    if (value >= 1000) return (value / 1000) + 'k';
                                    if (value >= 10000) return (value / 10000) + 'k';
                                    return value;
                                },
                                stepSize: Math.ceil(Math.max(...data) / 10)
                            }
                        }
                    }
                }
