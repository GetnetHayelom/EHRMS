                            </div>
                            <div><i class="bi bi-currency-dollar fs-2 text-secondary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <!--FILTER CONTROLS-->
        <div class="card shadow-sm p-2 m-2">
            <div class="d-flex m-2 flex-wrap">
                <div class="flex-fill d-print-flex p-3">
                    <label for="filter-company">Company:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-company">
                        <option value="">All</option>
                        @foreach (var company in Model.Companies)
                        {
