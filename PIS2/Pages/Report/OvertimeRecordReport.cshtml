                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Overtime</small>
                                <h4 class="fw-bold mb-0"><u id="TotalHours">@Model.TotalHours.ToString("N0") Hrs</u></h4>
                                <small><u id="TotalDays">@Model.TotalDays.ToString("N0") Days</u></small>
                            </div>
                            <div><i class="bi bi-clock-history fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Overtime Cost</small>
                                <h4 class="fw-bold mb-0"><u id="TotalCost">@Model.TotalCost.ToString("N2")</u></h4>
                            </div>
                            <div><i class="bi bi-cash fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">No. of Employees</small>
                                <h4 class="fw-bold mb-0"><u id="InvolvedEmployees">@Model.InvolvedEmployees.ToString("N0")</u></h4>
                            </div>
                            <div><i class="bi bi-people fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Days Per Employee</small>
                                <h4 class="fw-bold mb-0"><u id="DaysPerEmployees">@Model.DaysPerEmployees.ToString("N2")</u></h4>
                            </div>
                            <div><i class="bi bi-calendar-day fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-secondary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
