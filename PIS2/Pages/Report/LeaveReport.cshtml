<script>
        // Global chart instances
    let trendChartInstance = null;
    let typeChartInstance = null;
    function filterLeaves() {
        var department = $("#filter-department").val();
        var leaveStatus = $("#filter-status").val();
        var leaveType = $("#filter-type").val();
        var leaveGroup = $("#filter-group").val();
        var company = $("#filter-company").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();
        var empEp = $("#filter-ep-custom").val();
        

        // Normalize empty values to null
        department = (!department || department === "") ? null : department;
        leaveStatus = (!leaveStatus || leaveStatus === "") ? null : leaveStatus;
        leaveGroup = (!leaveGroup || leaveGroup === "") ? null : leaveGroup;
        leaveType = (!leaveType || leaveType === "") ? null : leaveType;
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : new Date(dateEnd).toISOString();
        empEp = (!empEp || empEp === "") ? "" : empEp;
        

        // Build the URL with filters
        var url = `/Report/LeaveReport?handler=Filter` +
            `&department=${encodeURIComponent(department)}` +
            `&leaveStatus=${encodeURIComponent(leaveStatus)}` +
            `&leaveGroup=${encodeURIComponent(leaveGroup)}` +
            `&leaveType=${encodeURIComponent(leaveType)}` +
            `&company=${encodeURIComponent(company)}` +
            `&dateStart=${encodeURIComponent(dateStart)}` +
            `&dateEnd=${encodeURIComponent(dateEnd)}`+
            `&empEp=${encodeURIComponent(empEp)}`;

        // jQuery AJAX
        $.getJSON(url, function (data) {
            //console.log("Received Data:", data);

            $("#table-body").html(data.tableHtml);
            $("#totalRecords").text(data.totalCount);
            $("#totalDays1").text(data.totalDays);
            $("#totalUnposted").text(data.countUnposted);
            $("#recordsPerEmployee").text(data.recordsPerEmployee);
            $("#daysPerEmployee").text(parseFloat(data.daysPerEmployee).toFixed(2));
            $("#totalCost_custom").text(parseFloat(data.totalCost).toFixed(2))
            // TREND CHART (Line Chart)
            const trendCtx = document.getElementById('leaveTrendChart').getContext('2d');

            if (trendChartInstance) {
                trendChartInstance.destroy();
            }

            // --- Trend Chart (Line) ---
            trendChartInstance = new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: data.flexibleSummary.map(m => m.period),
                    datasets: [{
                        label: 'Leave Occurrences',
                        data: data.flexibleSummary.map(m => m.count),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4, // Smooth curves
                        pointRadius: 4,
                        pointBackgroundColor: '#0d6efd'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }, // Hide legend for a cleaner "pro" look
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 },
                            grid: { borderDash: [5, 5] } // Dotted grid lines
                        },
                        x: {
                            grid: { display: false } // Cleaner look
                        }
                    }
                }
            });

        

            // 3. TYPE CHART (Pie/Doughnut Chart)
            const typeCtx = document.getElementById('leaveTypeChart').getContext('2d');
            if (typeChartInstance) typeChartInstance.destroy();

            typeChartInstance = new Chart(typeCtx, {
                type: 'doughnut',
                data: {
                    labels: data.typeSummary.map(t => t.typeName),
                    datasets: [{
                        data: data.typeSummary.map(t => t.count),
                        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6610f2', '#6f42c1']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            updateRowCount("countID");
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error("Error:", textStatus, errorThrown);
        });
    }

    // Optional: call filterLeaves on page load
    // $(document).ready(filterLeaves);
</script>
<script>
    let annualCustomLoaded = false;
    let annualLeaveLoaded = false;
    let charts = { trend: null, dept: null, type: null };
    let cachedData = null;

    $(document).ready(function () {

        $("#absentismForm").on("submit", function (e) {
            e.preventDefault(); // prevent normal form submission
            loadAbsentismData($(this));
        });

        $('button[data-bs-target="#absentismView"]')
        .on('shown.bs.tab', function () {

            if (!annualLeaveLoaded) {
                setDefaultAbsentismDates();
                loadAbsentismData($("#absentismForm"));
                annualLeaveLoaded = true;
            }
        });

        $('button[data-bs-target="#detailLeaveView"]')
        .on('shown.bs.tab', function () {
            const today = new Date();
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(today.getFullYear() - 1);

            $("#dateStart").val(formatDate(oneYearAgo));
            $("#dateEnd").val(formatDate(today));

            filterLeaves();

        });
    });

    function loadAbsentismData($form) {

        $.ajax({
            url: "@Url.Page(null, null, new { handler = "Absentism" })", // OnGetAbsentism
            type: "GET",
            data: $form.serialize(),
            success: function (response) {
 
                if (response) {
                    cachedData = response;
                    $("#leaveTableBody").html(response.tableHtml);
                    $("#employees").text(response.employees);
                    $("#totalDays").text(response.totalDays);
                    $("#perEmployee").text(response.perEmployee);
                    $("#countAbsentism").text(response.countAbsenteesm);
                    $("#absentismRate").text(response.absenteesmRate + '%');
                    $("#absentismCost").text(response.absenteesmCost);
                        renderCharts();
                    if ($('#analyticsView').hasClass('active')) {
                        
                    }
                }
            },
            error: function (xhr) {
                
                alert("Error loading absenteeism data: " + xhr.responseText);
            }
        });
    }

    
    function setDefaultAbsentismDates() {
        const today = new Date();
        const oneYearAgo = new Date();
        oneYearAgo.setFullYear(today.getFullYear() - 1);

        $("#dateStart-absentism").val(formatDate(oneYearAgo));
        $("#dateEnd-absentism").val(formatDate(today));
    }

    function renderCharts() {
        if (!cachedData) return;

        // --- Trend Chart (Line) ---
        renderSingleChart('trend', 'line', 'trendChart', cachedData.trendData, '#0d6efd', 'Days');

        // --- Department Chart (Bar) ---
        renderSingleChart('dept', 'bar', 'deptChart', cachedData.deptData, '#198754', 'Days');

        // --- Type Chart (Pie) ---
        renderSingleChart('type', 'pie', 'typeChart', cachedData.typeData, ['#ffc107', '#fd7e14', '#dc3545', '#6f42c1']);
    }

    function formatDate(date) {
        return date.toISOString().split("T")[0]; // yyyy-MM-dd
    }

    function renderSingleChart(key, type, elementId, data, color, label) {
        const ctx = document.getElementById(elementId).getContext('2d');

        // Destroy previous instance to make it dynamic
        if (charts[key]) charts[key].destroy();

        charts[key] = new Chart(ctx, {
        type: type,
        data: {
            labels: data.map(d => d.label),
            datasets: [{
                label: label || 'Total',
                data: data.map(d => d.value),
                backgroundColor: type === 'line' ?'rgba(13, 110, 253, 0.1)':color,
                borderColor: Array.isArray(color) ? '#fff' : color,
                fill: type === 'line' ? true : false,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#0d6efd'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: type === 'pie' } },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 },
                    grid: { borderDash: [5, 5] } // Dotted grid lines
                },
                x: {
                    grid: { display: false } // Cleaner look
                }
            }
        }
    });
    }

</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rawData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AnnualLeaveSummaries));

        // Extract values for the stepSize calculation
        const PayableCosts = rawData.map(d => d.PayableLeave);

        const ctx = document.getElementById('leaveSummaryChart').getContext('2d');

        new Chart(ctx, {
            data: {
                labels: rawData.map(d => d.Company),
                datasets: [
                    {
                        type: 'bar',
                        label: 'Total Allowed Leave (Days)',
                        data: rawData.map(d => d.AllowedLeave),
                        backgroundColor: '#0d6efd',
                        yAxisID: 'yDays', // Link to Days axis
                        order: 2
                    },
                    {
                        type: 'bar',
                        label: 'Remaining Balance (Days)',
                        data: rawData.map(d => d.LeaveBalance),
                        backgroundColor: '#6c757d', // Grey
                        yAxisID: 'yDays', // Link to Days axis
                        order: 2
                    },
                    {
                        type: 'line', // Line chart for Cost stands out better
                        label: 'Payable Leave (Cost)',
                        data: PayableCosts,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4, // Smooth curves
                        pointRadius: 4,
                        pointBackgroundColor: '#0d6efd',
                        yAxisID: 'yCost', // Link to Cost axis
                        order: 1 // Draw line on top of bars
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                scales: {
                    yDays: {
                        beginAtZero: true,
                        type: 'linear',
                        position: 'right',
                        title: { display: true, text: 'Number of Days' }
                    },
                    yCost: {
                        beginAtZero: true,
                        type: 'linear',
                        position: 'left',
                        title: { display: true, text: 'Total Cost ($)' },
                        ticks: {
                            // Your custom tick logic
                            stepSize: Math.ceil(Math.max(...PayableCosts) / 10) || 1000,
                            callback: function(value) {
                                if (value >= 1000) return (value / 1000).toFixed(0) + 'k';
                                return value;
                            }
                        },
                        // This prevents the cost grid lines from cluttering the days grid lines
                        grid: { drawOnChartArea: false }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) { label += ': '; }
                                if (context.datasetIndex === 2) {
                                    label += '$' + context.parsed.y.toLocaleString();
                                } else {
                                    label += context.parsed.y + ' Days';
                                }
                                return label;
                            }
                        }
                    }
                }
            }
        });
    });
</script>