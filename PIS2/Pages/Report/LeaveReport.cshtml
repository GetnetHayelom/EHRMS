@page
@model PIS2.Pages.Report.LeaveReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Leaves and Attendance</h1>
<div class="d-flex justify-content-between">

    
    <h4 class="fw-bold"><span id="filteredCount"></span> of @Model.totalCount</h4>
    <h4 class="fw-bold">Unposted @Model.CountUnposted</h4>
    <div class="d-inline-flex">
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("print")
    </div>
</div>
<hr />
<div class="row">
    <div class="col-3">
        <label for="filter-status">Status:</label>
        <select class="form-select" aria-label="Default select example" id="filter-status" onchange="filterLeaves()" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-3">
        <label for="filter-type">Type:</label>
        <select class="form-select" aria-label="Default select example" id="filter-type" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var leaveType in Model.LeaveTypes)
            {
                <option value="@leaveType.leaveTypeID">@leaveType.leaveTypeName</option>
            }
        </select>
    </div>

    <div class="col-3">
        <label for="filter-department">Department:</label>
        <select class="form-select" aria-label="Default select example" id="filter-department" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var department in Model.Departments)
            {
                <option value="@department.departmentID">@department.departmentName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-company">Company:</label>
        <select class="form-select" aria-label="Default select example" id="filter-company" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.companyID">@company.companyName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-workLoc">Work Location:</label>
        <select class="form-select" aria-label="Default select example" id="filter-workLoc" onchange="filterLeaves()">
            <option value="">All</option>
            @foreach (var workLocation in Model.WorkLocations)
            {
                <option value="@workLocation.workSiteID">@workLocation.workSiteName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="dateStart">Date of Start From:</label>
        <input class="form-control" type="date" id="dateStart" onchange="filterLeaves()" />
    </div>
    <div class="col-3">
        <label for="dateEnd">Date of End Upto:</label>
        <input class="form-control" type="date" id="dateEnd" onchange="filterLeaves()" />
    </div>
</div>


<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>Leave No</th>
            <th>
                Employee ID
            </th>
            <th>Name</th>
            <th>
               Date
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Days
            </th>
            <th>
                Type
            </th>
            <th>
                Status
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody id="table-body">
        @foreach (var item in Model.leaveModel) {
            <tr>
                <td onclick="location.href='@Url.Page("/Leave/Details", new { id = item.leaveID })'" style="cursor:pointer;">
                    @item.leaveID
                </td>
                <td onclick="location.href='@Url.Page("/Employment/Details", new { id = item.leaveID })'" style="cursor:pointer;">
                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                </td>
                <td onclick="location.href='@Url.Page("/Employment/Details", new { id = item.leaveID })'" style="cursor:pointer;">
                    @item.employmentModel.personModel.personFullName
                </td>
                <td>
                        @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                        @item.leaveStartDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                        @item.leaveEndDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                        @Html.DisplayFor(modelItem => item.leaveDays)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                </td>
                    @if(@item.leaveStatus == Models.leaveStatus.Approved)
                    {
                        <td>
                            <p class="border-success p-1">@Html.DisplayFor(modelItem => item.leaveStatus)</p>
                        </td>
                    }
                    else
                    {
                        <td>
                            @Html.DisplayFor(modelItem => item.leaveStatus)
                        </td>
                    }
                
                    <td class="d-flex flex-grow-1">
                    @if(item.leaveStatus == Models.leaveStatus.Posted)
                    {
                        <p class="bg-info">Leave is posted.</p>
                    }
                    else{
                        <form method="post" asp-page-handler="Approve">
                            <input asp-for="@item.leaveID" name="leaveId" type="hidden"></input>
                            <button type="submit" class="btn btn-success post-button" data-id="@item.leaveID">Post Leave</button>
                        </form>                        
                    }
                   
                
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    window.onload = filterLeaves();
    function filterLeaves() {

        var department = document.getElementById("filter-department").value;
        var leaveStatus = document.getElementById("filter-status").value;
        var leaveType = document.getElementById("filter-type").value;
        var workLoc = document.getElementById("filter-workLoc").value;
        var company = document.getElementById("filter-company").value;
        var dateStart = document.getElementById("dateStart").value;
        var dateEnd = document.getElementById("dateEnd").value;

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        leaveStatus = (!leaveStatus || leaveStatus === "") ? null : leaveStatus;
        leaveType = (!leaveType || leaveType === "") ? null : leaveType;
        workLoc = (!workLoc || workLoc === "") ? null : workLoc;
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;

        // Build the URL with multiple filters
        const url = `/Report/LeaveReport?handler=Filter&department=${encodeURIComponent(department)}&leaveStatus=${encodeURIComponent(leaveStatus)}&leaveType=${encodeURIComponent(leaveType)}&company=${encodeURIComponent(company)}&workLoc=${encodeURIComponent(workLoc)}&dateStart=${encodeURIComponent(dateStart)}&dateEnd=${encodeURIComponent(dateEnd)}`;

        fetch(url)
            //.then(response => response.text())
            .then(response => response.json())
            .then(data => {
                console.log("Received Data:", data); // Debug output
                document.getElementById('table-body').innerHTML = data.tableHtml;
                document.getElementById('filteredCount').innerHTML = data.filteredCount;
                updateRowCount("countID");
            })
            .catch(error => console.error('Error:', error));
    }
    
</script>
