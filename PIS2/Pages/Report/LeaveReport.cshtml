@page
@model PIS2.Pages.Report.LeaveReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")
<!--HEADER PART-->
<div class="d-flex justify-content-between">
    <h2 class="fw-bold">Attendance and Leave Report</h2>
    <!--TAB CONTROLS-->
    <div class="d-flex d-print-none">
        <ul class="nav nav-tabs">
           
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#annualLeaveView">Annual Leave Summary</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#absentismView">Absenteeism</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detailLeaveView">Custom Attendance Report</button>
            </li>
            <li>@await Html.PartialAsync("print")</li>
        </ul>

    </div>
</div>
<hr />
<!--BODY PART-->
<div class="tab-content mt-3">
    <!--LEAVE BALANCE REPORT-->
    <div class="tab-pane fade show active" id="annualLeaveView">
        <!--SUMMARY POINTS-->
        <div class="card p-2 m-2 shadow-sm">
            <div class="d-flex gap-3 mb-4 d-print-flex">

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-info border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Offered Leave</small>
                                    <h3 class="fw-bold mb-0"><u>@Model.AnnualLeaveSummaries.Sum(als => als.LeaveBalance).ToString("N2") (Days)</u></h3>
                                </div>
                                <div><i class="bi bi-tags fs-2 text-info"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Allowed Leave (Days)</small>
                                    <h3 class="fw-bold mb-0"><u>@Model.AnnualLeaveSummaries.Sum(als => als.AllowedLeave).ToString("N2") (Days)</u></h3>
                                </div>
                                <div><i class="bi bi-check fs-2 text-primary"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-warning border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Allowed Leave Cost</small>
                                    <h3 class="fw-bold mb-0"><u>@Math.Round(Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave), 2).ToString("N2") Br</u></h3>
                                </div>
                                <div><i class="bi bi-cash-stack fs-2 text-warning"></i></div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
        <!--SUMMARY GRAPH-->
        <div class="card shadow-sm p-3">
            <h4 class="fw-bold">Leave Liability: Allowed vs. Balance</h4>
            <div style="height: 400px;">
                <canvas id="leaveSummaryChart"></canvas>
            </div>
        </div>
        <!--DETAILS TABLE-->
        <h4 class="fw-bold">Annual Leave Summary Details</h4>
        <table class="table table-bordered table-striped table-hover print-full-width">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th colspan="2">Company</th>
                    <th>LeaveBalance</th>
                    <th>Allowed Leave</th>
                    <th>Payable</th>
                    <th>Share</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @if (Model.AnnualLeaveSummaries?.Any() != null)
                {
                    @foreach (var item in Model.AnnualLeaveSummaries)
                    {
                        var collapseId = $"collapse{index}";
                        <tr class="fw-bold table-secondary">
                            <td>@index</td>
                            <td colspan="2">
                                <div class="d-flex justify-content-between">
                                    <span data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">@item.Company</span>
                                    <a style="cursor:pointer;" class="text-sm-end"
                                       onclick=" location.href='@Url.Page("/Management/AnnualLeaveCompanySummary", new { id = item.CompanyID })' ">Details</a>
                                </div>
                            </td>


                            <td>@item.LeaveBalance.ToString("N2")</td>
                            <td>@item.AllowedLeave.ToString("N2")</td>
                            <td>@item.PayableLeave.ToString("N2")</td>
                            <td>@((item.PayableLeave * 100 / Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave)).ToString("N2"))%</td>
                        </tr>
                        int index2 = 1;

                        @if (item.DepartmentList != null && item.DepartmentList.Any())
                        {
                            @foreach (var item2 in item.DepartmentList)
                            {
                                <tr class="accordion-collapse collapse" id="@collapseId" style="cursor:pointer;"
                                    onclick=" location.href='@Url.Page("/Management/AnnualLeaveDepartmentSummary", new { id = item2.DepartmentID })' ">
                                    <td>@index.@index2</td>
                                    <td colspan="2">@item2.Department</td>
                                    <td>@item2.LeaveBalance.ToString("N2")</td>
                                    <td>@item2.AllowedLeave.ToString("N2")</td>
                                    <td>@item2.PayableLeave.ToString("N2")</td>
                                    <td>@((item2.PayableLeave *100/item.PayableLeave).ToString("N2"))%</td>
                                </tr>
                                index2++;
                            }
                        }

                        index++;
                    }
                    <tr class="bg-info text-white fw-bold">
                        <td colspan="3">Total</td>
                        <td>@Model.AnnualLeaveSummaries.Sum(als => als.LeaveBalance).ToString("N2") (Days)</td>
                        <td>@Model.AnnualLeaveSummaries.Sum(als => als.AllowedLeave).ToString("N2") (Days)</td>
                        <td>@Math.Round(Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave), 2).ToString("N2") Br</td>
                        <td></td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

    <!--ABSENTEEISM REPORT-->
    <div class="tab-pane fade" id="absentismView">
        <h4 class="fw-bold">Absenteesm Summary</h4>

        <!--SUMMARY POINTS-->
        <div class="d-flex gap-3 mb-4 d-print-flex">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Employees</small>
                                <h3 class="fw-bold mb-0"><u id="employees"></u></h3>
                            </div>
                            <div><i class="bi bi-people fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total (Days)</small>
                                <h3 class="fw-bold mb-0"><u id="totalDays"></u></h3>
                            </div>
                            <div><i class="bi bi-calendar-x fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Avg (Per Employee)</small>
                                <h3 class="fw-bold mb-0"><u id="perEmployee"></u></h3>
                            </div>
                            <div><i class="bi bi-calculator fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Absence Records (Count)</small>
                                <h3 class="fw-bold mb-0"><u id="countAbsentism"></u></h3>
                            </div>
                            <div><i class="bi bi-card-list fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Absenteeism Rate</small>
                                <h3 class="fw-bold mb-0"><u id="absentismRate"></u></h3>
                            </div>
                            <div><i class="bi bi-speedometer2 fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Cost</small>
                                <h3 class="fw-bold mb-0"><u id="absentismCost"></u></h3>
                            </div>
                            <div><i class="bi bi-currency-dollar fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <hr />
        <!--ABSENTISM FILTER CONTROLS-->
        <div>
            <div class="card-header bg-white border-0 pt-3">
                <div class="d-flex align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-secondary">
                        <i class="bi bi-sliders me-2"></i>Filter Reports
                    </h5>
                </div>
            </div>
            <div class="card p-3 mb-2">
                <form id="absentismForm" class="d-flex flex-wrap d-print-none gap-3">
                    <div class="col-3">
                        <div class="form-floating">

                            <select class="form-select" aria-label="Default select company" name="CompanyID" asp-for="CompanyID">
                                <option value="0">All</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.companyID">@company.companyName</option>
                                }
                            </select>
                            <label for="CompanyID">Company:</label>
                        </div>

                    </div>
                    <div class="col-3">
                        <div class="form-floating">

                            <select class="form-select" aria-label="Default select leave type" name="LeaveTypeID" asp-for="LeaveTypeID">
                                <option value="0">All</option>
                                @foreach (var leave in Model.LeaveTypes)
                                {
                                    <option value="@leave.leaveTypeID">@leave.leaveTypeName</option>
                                }
                            </select>
                            <label for="LeaveTypeID">Type/Reason:</label>
                        </div>

                    </div>
                    <div class="col-3">
                        <div class="form-floating">

                            <select class="form-select" asp-for="LeaveGroup" asp-items="@Html.GetEnumSelectList<Models.leaveGroup>()">
                                <option value="" selected>All</option>
                            </select>
                            <label for="LeaveGroup">Group:</label>
                        </div>


                    </div>
                    <div class="col-3">
                        <div class="form-floating">

                            <select class="form-select" aria-label="Default select leave legality" name="Legality" asp-for="Legality">
                                <option value="">All</option>
                                <option value="true">Legal</option>
                                <option value="false">Illegal</option>
                            </select>
                            <label for="Legality">Legality:</label>
                        </div>

                    </div>
                    <div class="col-3">
                        <div class="form-floating">

                            <input class="form-control" type="date" id="dateStart-absentism" asp-for="StartDate" name="StartDate" value="@Model.SDate?.ToString("yyyy-MM-dd")" />
                            <label for="dateStart">Date of Start From:</label>
                        </div>

                    </div>
                    <div class="col-3 d-print-none">
                        <div class="form-floating">

                            <input class="form-control" type="date" id="dateEnd-absentism" name="EndDate" asp-for="EndDate" value="@Model.EDate?.ToString("yyyy-MM-dd")" />
                            <label for="dateEnd">Date of End Upto:</label>
                        </div>

                    </div>
                    <div class="col-md-3">

                        <div class="form-floating">
                            <input class="form-control" type="text" id="filter-ep-absent" name="EmpEp" />
                            <label for="filter-ep-absent">Employee ID</label>
                        </div>
                    </div>
                    <div class="d-flex align-items-end">
                        <button type="submit" value="Filter" class="btn btn-primary m-2">Load</button>
                    </div>

                </form>
            </div>
        </div>
        
        
        <div class="d-none d-print-flex justify-content-between">
            <h6 class="fw-bold m-2">Company: <u>@Model.companyName</u></h6>
            <div class="d-flex">
                <h6 class="fw-bold m-2">From: <u>@Model.SDate?.ToString("MM/dd/yyyy")</u></h6>
                <h6 class="fw-bold m-2">To: <u>@Model.EDate?.ToString("MM/dd/yyyy")</u></h6>
            </div>
            
        </div>
        <!--End type of filtering section-->
        <!--ABSENTEESM TAB CONTROLS-->
        <ul class="nav nav-tabs mt-4" id="absentismTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="analytics-tab-btn" data-bs-toggle="tab" data-bs-target="#analyticsView" type="button">Analytics Dashboard</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detailAbsentView" type="button">Details Table</button>
            </li>
            
        </ul>

        <!--ABSENTEESM TAB CONTAINER-->
        <div class="tab-content border-start border-end border-bottom p-3">
            <!--ABSENTEESM CHARTS-->
            <div class="tab-pane fade show active d-print-flex" id="analyticsView">
                <div class="row">
                    <div class="col-12 mb-4">
                        <div class="card shadow-sm p-3">
                            <h6 class="fw-bold">Absence Trend Over Time</h6>
                            <canvas id="trendChart" style="max-height: 250px;"></canvas>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="card shadow-sm p-3">
                            <h6 class="fw-bold">Absence by Department</h6>
                            <canvas id="deptChart" style="max-height: 300px;"></canvas>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card shadow-sm p-3">
                            <h6 class="fw-bold">Reason Breakdown</h6>
                            <canvas id="typeChart" style="max-height: 300px;"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            
            <!--ABSENTEESM DETAIL VIEW-->
            <div class="tab-pane fade" id="detailAbsentView" role="tabpanel">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th colspan="3">Company</th>
                            <th>Total Employees</th>
                            <th>Total Absence Days</th>
                            <th>Absence Rate</th>
                        </tr>
                    </thead>
                    <tbody id="leaveTableBody"></tbody>
                </table>
            </div>

            
        </div>
  
    </div>
    
    <!--CUSTOM LEAVE REPORTS-->
    <div class="tab-pane fade" id="detailLeaveView">
        <div class="d-flex justify-content-between">
            <h4 class="fw-bold">Custom Report</h4>
            
        </div>
                
         <!--SUMMARY POINTS-->   
        <div class="d-flex gap-3 mb-4 d-print-flex">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Records</small>
                                <h3 class="fw-bold mb-0"><u id="totalRecords">@Model.totalCount.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-file-text fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total In Days</small>
                                <h3 class="fw-bold mb-0"><u id="totalDays1">@Model.totalDays.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-calendar fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Unposted</small>
                                <h3 class="fw-bold mb-0"><u id="totalUnposted">@Model.CountUnposted.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-exclamation-circle fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Records/Employee</small>
                                <h3 class="fw-bold mb-0"><u id="recordsPerEmployee">@Model.recordsPerEmployee.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-people fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Days/Employee</small>
                                <h3 class="fw-bold mb-0"><u id="daysPerEmployee">@Model.daysPerEmployee.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-clock fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Cost</small>
                                <h3 class="fw-bold mb-0"><u id="totalCost_custom">@Model.totalCost.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-currency-dollar fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>

        <!--FILTER CONTROLS-->
        <div class="card-header bg-white border-0 pt-3">
            <div class="d-flex align-items-center">
                <h5 class="card-title mb-0 fw-bold text-secondary">
                    <i class="bi bi-sliders me-2"></i>Filter Reports
                </h5>
            </div>
        </div>
        <div class="card shadow-sm border-light mb-4 d-print-none">
            
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-company">
                                <option value="">All</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.companyID">@company.companyName</option>
                                }
                            </select>
                            <label for="filter-company">Company</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-department">
                                <option value="">All</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.departmentID">@department.departmentName</option>
                                }
                            </select>
                            <label for="filter-department">Department</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-group" asp-items="Html.GetEnumSelectList<Models.leaveGroup>()">
                                <option value="">All</option>
                            </select>
                            <label for="filter-group">Leave Group</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-status" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()">
                                <option value="">All</option>
                            </select>
                            <label for="filter-status">Status</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-type">
                                <option value="">All</option>
                                @foreach (var leaveType in Model.LeaveTypes)
                                {
                                    <option value="@leaveType.leaveTypeID">@leaveType.leaveTypeName</option>
                                }
                            </select>
                            <label for="filter-type">Leave Type</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" type="date" id="dateStart" />
                            <label for="dateStart">Start From</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" type="date" id="dateEnd" />
                            <label for="dateEnd">End Upto</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <input class="form-control" type="text" id="filter-ep-custom" />
                            <label for="filter-ep-custom">Employee ID</label>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-center justify-content-end gap-2">
                        <button onclick="filterLeaves()" class="btn btn-primary btn-lg w-100 py-3 shadow-sm">
                            <i class="bi bi-search me-2"></i>Load Data
                        </button>
                    </div>
                </div>
                
            </div>
        </div>

        <!--TAB SELECTORS-->
        <ul class="nav nav-tabs mb-3 d-print-none" id="reportTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="chart-tab" data-bs-toggle="tab" data-bs-target="#chartPane" type="button">Analytics Graphs</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="table-tab" data-bs-toggle="tab" data-bs-target="#tablePane" type="button">Data Table</button>
            </li>
            
        </ul>

        <!--TAB BODY-->
        <div class="tab-content" id="reportTabsContent">
            <!--DERAILS TAB-->
            <div class="tab-pane fade" id="tablePane" role="tabpanel">
                <div class="card p-2 mb-2 shadow-sm">
                    <div class="d-flex justify-content-end d-print-none">
                        <div class="mx-2">@await Html.PartialAsync("filter")</div>
                        <div class="mx-2">@await Html.PartialAsync("print")</div>
                        <div class="mx-2"><excel-export table="dataTable" filename="Department_Annual_Leave_Summary_@(DateTime.UtcNow).xlsx"></excel-export></div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped table-hover print-full-width" id="dataTable">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>Leave No</th>
                                <th>Employee ID</th>
                                <th>Date</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Days</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Value/Cost</th>
                            </tr>
