@page
@model PIS2.Pages.Report.LeaveReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Absentism Summary Report</h1>

<hr />
<div class="d-flex justify-content-between">
    <h6 class="fw-bold m-2">Total Employee =<u>@Model.Leaves.Sum(l => l.EmployeeTotal)</u> </h6>
    <h6 class="fw-bold m-2">Total Absences (Days) =<u>@Math.Round((decimal)Model.Leaves.Sum(l => l.CompanySum), 2).ToString("N2")</u> Avg(Per Employee)=@Math.Round((decimal)Model.Leaves.Sum(l => l.CompanySum) / Model.Leaves.Sum(l => l.EmployeeTotal), 2) </h6>
    <h6 class="fw-bold m-2">Total Absences (Count) =<u>@Model.Leaves.Sum(l => l.CompanyTotal).ToString("N2")</u> </h6>
    <h6 class="fw-bold m-2"> Absentism Rate= <u>@(Math.Round((decimal)(Model.Leaves.Sum(l => l.CompanySum) / (Model.Leaves.Sum(l => l.EmployeeTotal) * Model.Leaves.First().WorkingDays)) * 100, 2)) %</u></h6>

</div>
<hr />
<div class="d-flex justify-content-between m-2">
    <div class="col-3">
        <label for="filter-company">Company:</label>
        <select class="form-select" aria-label="Default select company" id="filter-company" name="Company">
            <option value="">All</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.companyID">@company.companyName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="dateStart">Date of Start From:</label>
        <input class="form-control" type="date" id="dateStart" name="startDate" value="@Model.Leaves.Max(l => l.StartDate).ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-3 d-print-none">
        <label for="dateEnd">Date of End Upto:</label>
        <input class="form-control" type="date" id="dateEnd" name="endDate" value="@Model.Leaves.Max(l => l.EndDate).ToString("yyyy-MM-dd")" />
    </div>
    <div class="d-flex justify-content-end m-2">@await Html.PartialAsync("print")</div>
    
</div>
<table class="table table-bordered table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th colspan="3">Company</th>
            <th>Total Employees</th>
            <th>Total Absence Days</th>
            <th>Absence Rate</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var company in Model.Leaves)
        {
            <tr class="table-primary" id="@company.CompanyID">
                <td colspan="3"><h5 class="fw-bold">@company.CompanyName</h5></td>
                <td><h5 class="fw-bold">@company.EmployeeTotal</h5></td>
                <td><h5 class="fw-bold">@Math.Round((decimal)company.CompanySum, 2).ToString("N2")</h5></td>
                <td><h5 class="fw-bold">@Math.Round((decimal)(company.CompanySum/(company.EmployeeTotal* company.WorkingDays))*100, 2) %</h5></td>
            </tr>
            <tr><td></td><td colspan="3" class="text-secondary fw-bold">Top 3 Absentism Reasons By Department</td>   </tr>
            @foreach (var dept in company.Departments)
            {
                <tr class="table-secondary">
                    <td></td>
                   
                    <td class="fw-bold" colspan="2">@dept.DepartmentName</td>
                    <td class="fw-bold">@dept.EmployeeTotal</td>
                    <td class="fw-bold">@Math.Round((decimal)dept.DepartmentSum, 2)</td>
                    <td class="fw-bold">@Math.Round((decimal)(dept.DepartmentSum / (@dept.EmployeeTotal*company.WorkingDays)) * 100, 2) %</td>
                </tr>
                
                @foreach (var type in dept.LeaveTypes)
                {
                    
                    <tr>
                        <td colspan="2"></td>

                        <td colspan="2">@type.LeaveType</td>
                        <td>@Math.Round((decimal)@type.LeaveTypeSum, 2)<u>(@Math.Round((decimal)(type.LeaveTypeSum / dept.DepartmentSum) * 100, 2) %)</u></td>
                        <td></td>
                    </tr>
                }
        
            }
    
        }
    </tbody>
</table>

