@page
@model PIS2.Pages.Report.LeaveReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between">
    <h2 class="fw-bold">Attendance and Leave Report</h2>
    <div class="d-flex d-print-none">
        <ul class="nav nav-tabs">
           
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#annualLeaveView">Annual Leave Summary</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#absentismView">Absenteeism</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#detailLeaveView">Custom Attendance Report</button>
            </li>
            <li>@await Html.PartialAsync("print")</li>
        </ul>

    </div>
</div>
<hr />
<div class="tab-content mt-3">
    <!--LEAVE BALANCE REPORT-->
    <div class="tab-pane fade show active" id="annualLeaveView">
        <h4 class="fw-bold">Annual Leave Summary</h4>
        <table class="table table-bordered table-striped table-hover print-full-width">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th colspan="2">Company</th>
                    <th>LeaveBalance</th>
                    <th>Allowed Leave</th>
                    <th>Payable</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @if (Model.AnnualLeaveSummaries?.Any() != null)
                {
                    @foreach (var item in Model.AnnualLeaveSummaries)
                    {
                        var collapseId = $"collapse{index}";
                        <tr class="fw-bold bg-secondary">
                            <td>@index</td>
                            <td colspan="2">
                                <div class="d-flex justify-content-between">
                                    <span data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">@item.Company</span>
                                    <a style="cursor:pointer;"
                                       onclick=" location.href='@Url.Page("/Management/AnnualLeaveCompanySummary", new { id = item.CompanyID })' ">View more</a>
                                </div>
                            </td>


                            <td>@item.LeaveBalance.ToString("N2")</td>
                            <td>@item.AllowedLeave.ToString("N2")</td>
                            <td>@Math.Round(item.PayableLeave, 2).ToString("N2")</td>
                        </tr>
                        int index2 = 1;

                        @if (item.DepartmentList != null && item.DepartmentList.Any())
                        {
                            @foreach (var item2 in item.DepartmentList)
                            {
                                <tr class="accordion-collapse collapse show" id="@collapseId" style="cursor:pointer;"
                                    onclick=" location.href='@Url.Page("/Management/AnnualLeaveDepartmentSummary", new { id = item2.DepartmentID })' ">
                                    <td>@index.@index2</td>
                                    <td colspan="2">@item2.Department</td>
                                    <td>@item2.LeaveBalance.ToString("N2")</td>
                                    <td>@item2.AllowedLeave.ToString("N2")</td>
                                    <td>@Math.Round(item2.PayableLeave, 2).ToString("N2")</td>
                                </tr>
                                index2++;
                            }
                        }

                        index++;
                    }
                    <tr class="bg-info text-white fw-bold">
                        <td colspan="3">Total</td>
                        <td>@Model.AnnualLeaveSummaries.Sum(als => als.LeaveBalance).ToString("N2") (Days)</td>
                        <td>@Model.AnnualLeaveSummaries.Sum(als => als.AllowedLeave).ToString("N2") (Days)</td>
                        <td>@Math.Round(Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave), 2).ToString("N2") Br</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

    <!--ABSENTEEISM REPORT-->
    <div class="tab-pane fade" id="absentismView">
        <h4 class="fw-bold">Absentism Summary</h4>

        <!--SUMMARY POINTS-->
        <div class="d-flex gap-3 mb-4 d-print-flex">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Employees</small>
                                <h3 class="fw-bold mb-0"><u id="employees"></u></h3>
                            </div>
                            <div><i class="bi bi-people fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Absence (Days)</small>
                                <h3 class="fw-bold mb-0"><u id="totalDays"></u></h3>
                            </div>
                            <div><i class="bi bi-calendar-x fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Avg (Per Employee)</small>
                                <h3 class="fw-bold mb-0"><u id="perEmployee"></u></h3>
                            </div>
                            <div><i class="bi bi-calculator fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Absence Records (Count)</small>
                                <h3 class="fw-bold mb-0"><u id="countAbsentism"></u></h3>
                            </div>
                            <div><i class="bi bi-card-list fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Absenteeism Rate</small>
                                <h3 class="fw-bold mb-0"><u id="absentismRate"></u></h3>
                            </div>
                            <div><i class="bi bi-speedometer2 fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <hr />
        <!--ABSENTISM FILTER CONTROLS-->
        <div class="card p-3 mb-2">
            <form id="absentismForm" class="d-flex flex-wrap m-2 d-print-none gap-3">
                <div class="col-3">
                    <label for="CompanyID">Company:</label>
                    <select class="form-select" aria-label="Default select company" name="CompanyID" asp-for="CompanyID">
                        <option value="0">All</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.companyID">@company.companyName</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <label for="LeaveTypeID">Type/Reason:</label>
                    <select class="form-select" aria-label="Default select leave type" name="LeaveTypeID" asp-for="LeaveTypeID">
                        <option value="0">All</option>
                        @foreach (var leave in Model.LeaveTypes)
                        {
                            <option value="@leave.leaveTypeID">@leave.leaveTypeName</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <label for="LeaveGroup">Group:</label>
                    <select class="form-select" aria-label="Default select leave group" name="LeaveGroup" asp-for="LeaveGroup" asp-items="@Html.GetEnumSelectList<Models.leaveGroup>()">
                        <option value="" selected>All</option>
                    </select>
                </div>
                <div class="col-3">
                    <label for="Legality">Legality:</label>
                    <select class="form-select" aria-label="Default select leave legality" name="Legality" asp-for="Legality">
                        <option value="">All</option>
                        <option value="true">Legal</option>
                        <option value="false">Illegal</option>
                    </select>
                </div>
                <div class="col-3">
                    <label for="dateStart">Date of Start From:</label>
                    <input class="form-control" type="date" id="dateStart-absentism" asp-for="StartDate" name="StartDate" value="@Model.SDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-3 d-print-none">
                    <label for="dateEnd">Date of End Upto:</label>
                    <input class="form-control" type="date" id="dateEnd-absentism" name="EndDate" asp-for="EndDate" value="@Model.EDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="d-flex align-items-end">
                    <button type="submit" value="Filter" class="btn btn-primary m-2">Load</button>
                </div>

            </form>
        </div>
        
        <div class="d-none d-print-flex justify-content-between">
            <h6 class="fw-bold m-2">Company: <u>@Model.companyName</u></h6>
            <div class="d-flex">
                <h6 class="fw-bold m-2">From: <u>@Model.SDate?.ToString("MM/dd/yyyy")</u></h6>
                <h6 class="fw-bold m-2">To: <u>@Model.EDate?.ToString("MM/dd/yyyy")</u></h6>
            </div>
            
        </div>
        <!--End type of filtering section-->

        <!--Leave Absence Rate Table-->
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th colspan="3">Company</th>
                    <th>Total Employees</th>
                    <th>Total Absence Days</th>
                    <th>Absence Rate</th>
                </tr>
            </thead>
            <tbody id="leaveTableBody">
               
            </tbody>
        </table>
    </div>

    
    <!--CUSTOM LEAVE REPORTS-->
    <div class="tab-pane fade" id="detailLeaveView">
        <div class="d-flex justify-content-between">
            <h4 class="fw-bold">Custom Report</h4>
            <div>@await Html.PartialAsync("filter")</div>
        </div>
        
        
         <!--SUMMARY POINTS-->   
        <div class="d-flex gap-3 mb-4 d-print-flex">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Records</small>
                                <h3 class="fw-bold mb-0"><u id="totalRecords">@Model.totalCount.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-file-text fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Records In Days</small>
                                <h3 class="fw-bold mb-0"><u id="totalDays1">@Model.totalDays.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-calendar fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Records Unposted</small>
                                <h3 class="fw-bold mb-0"><u id="totalUnposted">@Model.CountUnposted.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-exclamation-circle fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Records Per Employee</small>
                                <h3 class="fw-bold mb-0"><u id="recordsPerEmployee">@Model.recordsPerEmployee.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-people fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Days Per Employee</small>
                                <h3 class="fw-bold mb-0"><u id="daysPerEmployee">@Model.daysPerEmployee.ToString("N2")</u></h3>
                            </div>
                            <div><i class="bi bi-clock fs-2 text-danger"></i></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>


        
        <!--FILTER CONTROLS-->
        <div class="d-flex m-2 justify-content-between flex-wrap">
            <div class="col-3 m-2 d-print-flex">
                <label for="filter-company">Company:</label>
                <select class="form-select" aria-label="Default select example" id="filter-company">
                    <option value="">All</option>
                    @foreach (var company in Model.Companies)
                    {
                        <option value="@company.companyID">@company.companyName</option>
                    }
                </select>
            </div>
            <div class="col-3 m-2 d-print-flex">
                <label for="filter-department">Department:</label>
                <select class="form-select" aria-label="Default select example" id="filter-department">
                    <option value="">All</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.departmentID">@department.departmentName</option>
                    }
                </select>
            </div>
            <div class="col-3">
                <label for="LeaveGroup">Group:</label>
                <select class="form-select" aria-label="Default select leave group" id="filter-group" asp-for="LeaveGroup" asp-items="@Html.GetEnumSelectList<Models.leaveGroup>()">
                    <option value="0">All</option>
                </select>
            </div>
            <div class="col-3 m-2 d-print-flex">
                <label for="filter-type">Type:</label>
                <select class="form-select" aria-label="Default select example" id="filter-type">
                    <option value="">All</option>
                    @foreach (var leaveType in Model.LeaveTypes)
                    {
                        <option value="@leaveType.leaveTypeID">@leaveType.leaveTypeName</option>
                    }
                </select>
            </div>
            <div class="col-3 m-2 d-print-flex">
                <label for="filter-status">Status:</label>
                <select class="form-select" aria-label="Default select example" id="filter-status" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()">
                    <option value="">All</option>
                </select>
            </div>
            
            <div class="col-3 m-2 d-print-flex">
                <label for="dateStart">Date of Start From:</label>
                <input class="form-control" type="date" id="dateStart" />
            </div>
            <div class="col-3 m-2 d-print-flex">
                <label for="dateEnd">Date of End Upto:</label>
                <input class="form-control" type="date" id="dateEnd" />
            </div>
            <div class="col-3 m-2 d-print-flex">
                <label>EmpID:</label>
                <input class="form-control" type="text" id="empID" placeholder="Enter employee id for single employer."/>
            </div>
            <div class="d-flex align-items-end">
                <button onclick="filterLeaves()" class="btn btn-primary d-print-none">Load</button>
            </div>
        </div>

        <!--TABLE-->
        <table class="table table-striped table-hover print-full-width" id="dataTable">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Leave No</th>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Date
                    </th>
                    <th>
                        From
                    </th>
                    <th>
                        To
                    </th>
                    <th>
                        Days
                    </th>
                    <th>
                        Type
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Value/Cost
                    </th>
                </tr>
            </thead>
            <tbody id="table-body">
                
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("print", null)
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>

<script>
    function filterLeaves() {
        var department = $("#filter-department").val();
        var leaveStatus = $("#filter-status").val();
        var leaveType = $("#filter-type").val();
        var leaveGroup = $("#filter-group").val();
        var company = $("#filter-company").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();
        var empID = $("#empID").val();

        // Normalize empty values to null
        department = (!department || department === "") ? null : department;
        leaveStatus = (!leaveStatus || leaveStatus === "") ? null : leaveStatus;
        leaveGroup = (!leaveGroup || leaveGroup === "") ? null : leaveGroup;
        leaveType = (!leaveType || leaveType === "") ? null : leaveType;
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;
        empID = (!empID || empID === "") ? null : empID;

        // Build the URL with filters
        var url = `/Report/LeaveReport?handler=Filter` +
            `&department=${encodeURIComponent(department)}` +
            `&leaveStatus=${encodeURIComponent(leaveStatus)}` +
            `&leaveGroup=${encodeURIComponent(leaveGroup)}` +
            `&leaveType=${encodeURIComponent(leaveType)}` +
            `&company=${encodeURIComponent(company)}` +
            `&dateStart=${encodeURIComponent(dateStart)}` +
            `&dateEnd=${encodeURIComponent(dateEnd)}` +
            `&empID=${encodeURIComponent(empID)}`;

        // jQuery AJAX
        $.getJSON(url, function (data) {
            //console.log("Received Data:", data);

            $("#table-body").html(data.tableHtml);
            $("#totalRecords").text(data.totalCount);
            $("#totalDays1").text(data.totalDays);
            $("#totalUnposted").text(data.countUnposted);
            $("#recordsPerEmployee").text(data.recordsPerEmployee);
            $("#daysPerEmployee").text(parseFloat(data.daysPerEmployee).toFixed(2));

            updateRowCount("countID");
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error("Error:", textStatus, errorThrown);
        });
    }

    // Optional: call filterLeaves on page load
    // $(document).ready(filterLeaves);
</script>
<script>
    $(document).ready(function () {
        $("#absentismForm").on("submit", function (e) {
            e.preventDefault(); // prevent normal form submission
            showLoader();

            $.ajax({
                url: "@Url.Page(null, null, new { handler = "Absentism" })", // maps to OnGetAbsentism
                type: "GET",
                data: $(this).serialize(),
                success: function (response) {
                    hideLoader();
                    if (response) {
                        $("#leaveTableBody").html(response.tableHtml);
                        $("#employees").text(response.employees);
                        $("#totalDays").text(response.totalDays);
                        $("#perEmployee").text(response.perEmployee);
                        $("#countAbsentism").text(response.countAbsentism);
                        $("#absentismRate").text(response.apnentismRate);
                    }
                },
                error: function (xhr) {
                    hideLoader();
                    alert("Error loading absenteeism data: " + xhr.responseText);
                }
            });
        });
    });

    function showLoader() {
        $("#absentismResult").html('<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>');
    }

    function hideLoader() {
        // optional cleanup if you use a loader overlay
    }
</script>

