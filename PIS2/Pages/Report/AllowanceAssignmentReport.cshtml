@page
@model PIS2.Pages.Report.AllowanceAssignmentReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Allowance Assignments</h1>
<h4 class="fw-bold"><span id="filteredCount"></span> of @Model.totalCount</h4>
<hr />
<div class="row m-2">
    @if (Model.allowanceAssignmentModel != null)
    {

        <div class="col-3">
            <label for="filter-status">Filter Status:</label>
            <select class="form-select" aria-label="Default select example" id="filter-status" onchange="filterAllowance()" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                <option value="">All</option>
            </select>
        </div>
        <div class="col-3">
            <label for="filter-empType">Filter Employment Type:</label>
            <select class="form-select" aria-label="Default select example" id="filter-empType" onchange="filterAllowance()">
                <option value="">All</option>
                @foreach (var empType in Model.EmploymentTypes)
                {
                    <option value="@empType.employmentTypeID">@empType.employmentTypeName</option>
                }
            </select>
        </div>
        <div class="col-3">
            <label for="filter-job">Filter Job:</label>
            <select class="form-select" aria-label="Default select example" id="filter-job" onchange="filterAllowance()">
                <option value="">All</option>
                @foreach (var jobTitle in Model.JobTitles)
                {
                    <option value="@jobTitle.jobID">@jobTitle.jobTitle</option>
                }
            </select>
        </div>
        <div class="col-3">
            <label for="filter-department">Filter Department:</label>
            <select class="form-select" aria-label="Default select example" id="filter-department" onchange="filterAllowance()">
                <option value="">All</option>
                @foreach (var department in Model.Departments)
                {
                    <option value="@department.departmentID">@department.departmentName</option>
                }
            </select>
        </div>
        <div class="col-3">
            <label for="filter-company">Filter Company:</label>
            <select class="form-select" aria-label="Default select example" id="filter-company" onchange="filterAllowance()">
                <option value="">All</option>
                @foreach (var company in Model.Companies)
                {
                    <option value="@company.companyID">@company.companyName</option>
                }
            </select>
        </div>
        
        <div class="col-3">
            <label for="dateStart">Date of Employment From:</label>
            <input class="form-control" type="date" id="dateStart" onchange="filterAllowance()" />
        </div>
        <div class="col-3">
            <label for="dateEnd">Date of Employment Upto:</label>
            <input class="form-control" type="date" id="dateEnd" onchange="filterAllowance()" />
        </div>
    }
</div>
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employment ID
            </th>
            <th>Employee Name</th>
            <th>
                Allowance Type
            </th>
            <th>
                Allowance Amount
            </th>
            <th>
                Allowance Assignment Date
            </th>
            <th>
                Modified By
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.allowanceAssignmentModel) {
            <tr onclick="location.href='@Url.Page("/AllowanceAssignment/Details", new { id = item.allowanceAssignmentID})'" style="cursor:pointer">
                <td>
                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                </td>
                <td>
                    @item.employmentModel.personModel.personFullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceModel.allowanceName)
                </td>
                <td>
                    @item.allowanceAssignmentAmount
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.allowanceAssignmentDate)
                </td>@{
                    string bg_color;
                    if (item.allowanceStatus == Models.mainStatus.Suspended)
                    {
                        bg_color = "bg-warning text-black";
                    }
                    else if (item.allowanceStatus == Models.mainStatus.Active)
                    {
                        bg_color = "bg-success text-white";
                    }
                    else
                    {
                        bg_color = "bg-grey text-black";
                    }
                }
                <td class="@bg_color">
                    @Html.DisplayFor(modelItem => item.modifiedBy)
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("print")
</div>

<!-- JavaScript for Filtering -->
<script>
    window.onload = filterAllowance();
    function filterAllowance() {

        var department = document.getElementById("filter-department").value;
        var allowanceStatus = document.getElementById("filter-status").value;
        var jobTitle = document.getElementById("filter-job").value;
        var empType = document.getElementById("filter-empType").value;

        var company = document.getElementById("filter-company").value;
        var dateStart = document.getElementById("dateStart").value;
        var dateEnd = document.getElementById("dateEnd").value;

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        allowanceStatus = (!allowanceStatus || allowanceStatus === "") ? null : allowanceStatus;
        jobTitle = (!jobTitle || jobTitle === "") ? null : jobTitle;
        empType = (!empType || empType === "") ? null : empType;
        
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;

        // Build the URL with multiple filters
        const url = `/Report/AllowanceAssignmentReport?handler=Filter&department=${encodeURIComponent(department)}&jobTitle=${encodeURIComponent(jobTitle)}&empStatus=${encodeURIComponent(allowanceStatus)}&empType=${encodeURIComponent(empType)}&company=${encodeURIComponent(company)}&workLoc=${encodeURIComponent(workLoc)}&dateStart=${encodeURIComponent(dateStart)}&dateEnd=${encodeURIComponent(dateEnd)}`;

        fetch(url)
            //.then(response => response.text())
            .then(response => response.json())
            .then(data => {
                document.getElementById('filteredCount').innerHTML = data.filteredCount;
                document.getElementById('table-body').innerHTML = data.tableHtml;
                const selector = document.getElementById('filter-department');
                document.getElementById('filter-department').innerHTML =
                    '<option value="">All</option>'
                data.departs.forEach(function (item) {
                    const option = document.createElement('option');
                    option.value = item.id;
                    option.textContent = item.name;
                    selector.appendChild(option);
                });
                updateRowCount("countID");
            })
            .catch(error => console.error('Error:', error));
    }
    enableTableSorting("dataTable");
</script>
