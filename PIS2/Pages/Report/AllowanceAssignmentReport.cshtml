@page
@model PIS2.Pages.Report.AllowanceAssignmentReportModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple","")
<h1 class="fw-bold">Allowance Assignments</h1>

<hr />
<div class="row m-2">
    @if (Model.allowanceAssignmentModel != null)
    {
        <!-- SUMMARY POINTS -->
        <div class="card shadow-sm p-2 mb-4 ">
            <div class="d-flex gap-3 mb-4 d-print-flex flex-wrap">
                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-info border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total Allowances (Records)</small>
                                    <h4 class="fw-bold mb-0"><u id="TotalRecords"></u>@Model.GrandCount.ToString("N2")</h4>
                                </div>
                                <div><i class="bi bi-journal-check fs-2 text-info"></i></div>
                            </div>
                        </div>
                    </div>
                </div> <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted">Total Sum</small> <h4 class="fw-bold mb-0"><u id="TotalSum"></u>@Model.GrandSum.ToString("N2")</h4>
                                </div>
                                <div><i class="bi bi-currency-dollar fs-2 text-primary"></i></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-success border-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div> <small class="text-muted">Employees</small> <h4 class="fw-bold mb-0"><u id="Employees"></u>@Model.Employees.ToString("N2")</h4> </div>
                                <div><i class="bi bi-people fs-2 text-success"></i></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        <!--FILTER CONTROLLS-->
        <div class="card shadow-sm p-2 mb-4 ">
            <div class="d-flex d-print-flex flex-wrap gap-4">
                <div class="flex-fill">
                    <label for="filter-company">Company:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-company">
                        <option value="">All</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.companyID">@company.companyName</option>
                        }
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-department">Department:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-department">
                        <option value="">All</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.departmentID">@department.departmentName</option>
                        }
                    </select>
                </div>

                <div class="flex-fill">
                    <label for="filter-status">Status:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-status" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-empType">Allowance Type:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-type">
                        <option value="">All</option>
                        @foreach (var Atypes in Model.AllowanceTypes)
                        {
                            <option value="@Atypes.allowanceID">@Atypes.allowanceName</option>
                        }
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-empType">Job Class:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-jobClass">
                        <option value="">All</option>
                        @foreach (var jcalss in Model.JobClasses)
                        {
                            <option value="@jcalss.JobClassId">@jcalss.JobClassName</option>
                        }
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-empType">Job Title:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-jobTitle">
                        <option value="">All</option>
                        @foreach (var jtitle in Model.JobTitles)
                        {
                            <option value="@jtitle.jobID">@jtitle.jobTitle</option>
                        }
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-empType">Allowance Duration:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-duration" asp-items="Html.GetEnumSelectList<Models.allowanceDuration>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="flex-fill">
                    <label for="filter-empType">Employment Position:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-positions" asp-items="Html.GetEnumSelectList<Models.EmploymentPositions>()">
                        <option value="">All</option>
                    </select>
                </div>


                <div class="flex-fill">
                    <label for="dateStart">Assigned From:</label>
                    <input class="form-control" type="date" id="dateStart" />
                </div>
                <div class="flex-fill">
                    <label for="dateEnd">Assigned Up To:</label>
                    <input class="form-control" type="date" id="dateEnd" />
                </div>
                <div class="flex-fill">
                    <div class="d-flex justify-content-end d-print-none">
                        <excel-export table="dataTable" filename="Allowance_@(DateTime.Now).xlsx"></excel-export>
                        <button id="toggle-allowances" class="btn btn-info m-2 text-white">
                            Toggle Rows
                        </button>

                        <button onclick="filterAllowance()" class="btn btn-primary m-2">Load</button>
                        @await Html.PartialAsync("print")
                    </div>
                </div>
            </div>
        </div>      
    }
</div>
<table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employment ID
            </th>
            
            <th>
                Allowance Type
            </th>
            <th>
                Allowance Amount
            </th>
            <th>
                Allowance Assignment Date
            </th>
            <th>
                Allowance Status
            </th>
        </tr>
    </thead>
    <tbody id="table-body">
        @foreach (var item in Model.allowanceAssignmentModel.GroupBy(c => c.CompanyID)) {
            <tr class="table-primary fw-bold bg-secondary">
                <td colspan="2">@item.FirstOrDefault()?.CompanyName
                (Total: @item.Count())</td>
                <td colspan='3'>@item.Sum(c => c.AllowanceAmount)</td>
            </tr>
            @foreach (var item2 in item.GroupBy(c => c.DepartmentID))
            {
                <tr class="table-secondary fw-bold bg-secondary">
                    <td colspan="2">
                        @item2.FirstOrDefault()?.DepartmentName
                        (Total: @item2.Count())
                    </td>
                    <td colspan='3'>@item2.Sum(c => c.AllowanceAmount)</td>
                </tr>
                @foreach (var item3 in item2)
                {
                    <tr onclick="location.href='@Url.Page("/AllowanceAssignment/Details", new { id = item3.AllowanceID})'" style="cursor:pointer" class="allowance-row">
                        <td>
                            @Html.DisplayFor(modelItem => item3.EmployeeID)
                        </td>
            
                        <td>
                            @Html.DisplayFor(modelItem => item3.AllowanceTypeName)
                        </td>
                        <td>
                            @item3.AllowanceAmount
                        </td>
                        <td>
                            @item3.AllowanceStart.ToString("MM/dd/yyyy")
                        </td>@{
                            string bg_color;
                            if (item3.AllowanceStatus == Models.mainStatus.Suspended)
                            {
                                bg_color = "bg-warning text-black";
                            }
                            else if (item3.AllowanceStatus == Models.mainStatus.Active)
                            {
                                bg_color = "bg-success text-white";
                            }
                            else
                            {
                                bg_color = "bg-grey text-black";
                            }
                        }
                        <td class="@bg_color">
                            @Html.DisplayFor(modelItem => item3.AllowanceStatus)
                        </td>
                    </tr>
                }
            }
            
            
        }
    </tbody>
</table>
<div class="d-flex justify-content-end">
    <excel-export table="dataTable" filename="Allowance_@(DateTime.Now).xlsx"></excel-export>
    @await Html.PartialAsync("print")
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>

<!-- JavaScript for Filtering -->
<script>
    function filterAllowance() {
        var department = $("#filter-department").val();
        var allowanceStatus = $("#filter-status").val();
        var allowanceType = $("#filter-type").val();
        var allowanceDuration = $("#filter-duration").val();
        var jobTitle = $("#filter-jobTitle").val();
        var jobClass = $("#filter-jobClass").val();
        var position = $("#filter-positions").val();
        var company = $("#filter-company").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        allowanceStatus = (!allowanceStatus || allowanceStatus === "") ? null : allowanceStatus;
        jobTitle = (!jobTitle || jobTitle === "") ? null : jobTitle;
        jobClass = (!jobClass || jobClass === "") ? null : jobClass;
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;

        // Build the URL with multiple filters
        var url = `/Report/AllowanceAssignmentReport?handler=Filter`+
                    `&department=${encodeURIComponent(department)}`+
                    `&allowanceStatus=${encodeURIComponent(allowanceStatus)}`+
                    `&allowanceType=${encodeURIComponent(allowanceType)}`+
                    `&jobTitle=${encodeURIComponent(jobTitle)}`+
                    `&jobClass=${encodeURIComponent(jobClass)}`+
                    `&position=${encodeURIComponent(position)}`+
                    `&company=${encodeURIComponent(company)}`+
                    `&dateStart=${encodeURIComponent(dateStart)}`+
                    `&dateEnd=${encodeURIComponent(dateEnd)}`+
                    `&allowanceDuration=${encodeURIComponent(allowanceDuration)}`;

        $.getJSON(url, function (data) {
            $("#TotalRecords").text(data.totalRecords + " of ");
            $("#table-body").html(data.tableHtml);
            $("#TotalSum").text(data.totalSum + " of ");
            $("#Employees").text(data.employees + " of ");


        }).fail(function (xhr, status, error) {
            console.error("Error:", error);
        });
    }

</script>
<script> 
    $(document).on("click", "#toggle-allowances", function () {
        $(".allowance-row").toggle();  // Show/hide rows
    });
</script>
