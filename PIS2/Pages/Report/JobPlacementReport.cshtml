@page
@using PIS2.Enums
@model PIS2.Pages.Report.JobPlacementReportModel
@{
    ViewData["Title"] = "Job Placements";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="fw-bold mb-0">Job Placements</h2>
<p class="text-muted mb-3">Overall job placements report</p>
<div class="mt-3">
    
    <!-- Summary cards -->
    <div class="card shadow-sm mb-4 p-4">
        <div class="d-flex d-print-flex gap-3 mb-4 d-print-flex flex-wrap" id="summaryRow">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Active Placements</small>
                                <h3 id="summaryActive" class="mb-0" asp-for="active">@Model.active.ToString("N0")</h3>
                            </div>
                            <div><i class="bi bi-person-check fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Transfers This Month</small>
                                <h3 id="summaryTransfers" class="mb-0" asp-for="transfersThisMonth">@Model.transfersThisMonth.ToString("N0")</h3>
                            </div>
                            <div><i class="bi bi-arrow-left-right fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Average Salary</small>
                                <h3 id="summaryAvgSalary" class="mb-0" asp-for="avgSalary">@Model.avgSalary.ToString("N2")</h3>
                                <small class="text-muted">Min= @Model.jobPlacementModel.Min(j => j.jobPlacementSalary)- Max= @Model.jobPlacementModel.Max(j => j.jobPlacementSalary)</small>
                            </div>
                            <div><i class="bi bi-currency-dollar fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total Placements</small>
                                <h3 id="summaryTotal" class="mb-0" asp-for="total">@Model.total.ToString("N0")</h3>
                            </div>
                            <div><i class="bi bi-people fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-3 mb-4">
            <span class="fw-bold "><u>Job Grade Distribution:</u></span>

            @foreach (var item in Model.jobPlacementModel
                                        .GroupBy(j => j.jobGradeID)
                                        .Select(g => new { 
                                            Name = g.First().jobGradeName, 
                                            Count = g.Count() 
                                        })
                                        .OrderByDescending(g => g.Count))
            {
                <span class="text-muted me-3"><strong> Grade @item.Name =</strong> @item.Count</span>
            }
        </div>
        
    </div>
    

    <div class="card p-3 mb-3">
        <form method="GET" id="filterForm" class="d-flex flex-wrap gap-3 align-items-end d-print-flex">
            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="companySelect">Company</label>
                <select id="filter-company" asp-for="CompanyID" class="form-select">
                    <option value="">All</option>
                    @* fill server-side so page has initial list *@
                    @foreach (var c in Model.Companies)
                    {
                        <option value="@c.companyID">@c.companyName</option>
                    }
                </select>
            </div>

            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="departmentSelect">Department</label>
                <select id="filter-department" asp-for="DepartmentID" class="form-select">
                    <option value="">All</option>
                    @* departments will be populated client-side when company changes,
                   but include all by default if you like *@
                </select>
            </div>

            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="statusSelect">Status</label>
                <select id="statusSelect" asp-for="jStatus" class="form-select">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues(typeof(mainStatus)).Cast<mainStatus>())
                    {
                        <option value="@( (int)s )">@s</option>
                    }
                </select>
            </div>
            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="classSelect">Job Class</label>
                <select id="classSelect" asp-for="jClass" class="form-select">
                    <option value="" selected>All</option>
                    @foreach (var jc in Model.JobClasses)
                    {
                        <option value="@jc.jobClassId">@jc.jobClassName</option>
                    }
                </select>
            </div>
            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="reasonSelect">Reason</label>
                <select id="reasonSelect" asp-for="Reason" class="form-select">
                    <option value="" selected>All</option>
                    @foreach (var r in Model.Reasons)
                    {
                        <option value="@r.ToString()">@r.ToString()</option>
                    }
                </select>
            </div>
            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="categorySelect">Category</label>
                <select id="categorySelect" name="Category" class="form-select">
                    <option value="" selected>All</option>
                    @foreach (var jc in Model.JobCategories)
                    {
                        <option value="@jc.jobCategoryID">@jc.jobCategoryName</option>
                    }
                </select>
            </div>

            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="fromDate">From</label>
                <input id="fromDate" asp-for="From" class="form-control" type="date" />
            </div>

            <div class="col-auto mb-2">
                <label class="form-label fw-bold" for="toDate">To</label>
                <input id="toDate" asp-for="To" class="form-control" type="date" />
            </div>

            <div class="btn-group col-auto mb-2">
                @await Html.PartialAsync("filter")
                <button id="loadBtn" type="submit" class="btn btn-primary my-2">Load</button>
                <button id="resetBtn" type="button" class="btn btn-outline-secondary my-2" onclick="this.reset()">Reset</button>
                <excel-export table="dataTable" filename="JobPlacement_Report_@(DateTime.Now).xlsx"></excel-export>
                @await Html.PartialAsync("print")
            </div>
 
        </form>
    </div>
    <!-- Filters -->
    

    <!-- Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="dataTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee ID</th>
                            <th>Job Title</th>
                            <th>Class</th>
                            <th>Salary</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Grade & Step</th>
                            <td class="d-print-none text-end px-2">Actions</td>
                        </tr>
                    </thead>
                    <tbody id="placementsBody">
                        @* initial server render to show something on first load *@
                        @foreach (var item in Model.jobPlacementModel.GroupBy(j => j.companyID))
                        {
                            <tr class="table-group-header table-primary">
                                <td colspan="9" class="fw-bold">@((item.First().companyName) ?? "—")</td>
                            </tr>
                            foreach(var dep in item.GroupBy(i => i.departmentID))
                            {
                                <tr class="table-group-header table-secondary">
                                    <td></td>
                                    <td colspan="8" class="fw-bold">@((dep.First().departmentName) ?? "—")</td>
                                </tr>
                                foreach (var p in dep)
                                {
                                    <tr data-id="@p.jobPlacementID" style="cursor:pointer" onclick="location.href='@Url.Page("/JobPlacement/Details", new { id = p.jobPlacementID })'">
                                        <td>@p.givenID<br /><span class="text-muted small">@p.FullName</span></td>
                                        <td>@p.jobTitle</td>
                                        <td>@p.jobClassName</td>
                                        <td>@p.jobPlacementSalary.ToString("N2")</td>
                                        <td>@p.jobPlacementDate.ToString("MM/dd/yyyy")</td>
                                        <td>                                            
                                            @await Html.PartialAsync("_StatusBadges", p.jobPlacementStatus)
                                        </td>

                                        <td>@p.jobGradeName <br /><span class="text-muted small">@p.jobStepName</span></td>
                                        <td class="d-print-none text-end px-2">
                                            <div class="btn-group" role="group">
                                                <a asp-page="/JobPlacement/Details" asp-route-id="@p.jobPlacementID" class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="/Jobplacement/Edit" asp-route-id="@p.jobPlacementID" class="btn btn-sm btn-outline-success" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            </div>
                                        </td>
                                        
                                    </tr>
                                }
                            }
                            
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="d-flex d-print-none justify-content-end">
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="JobPlacement_Report_@(DateTime.Now).xlsx"></excel-export>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>
<script>
        $("#resetBtn").click(function () {
        $("#filterForm")[0].reset();
    });
    document.addEventListener('DOMContentLoaded', () => {
        const myInput = document.querySelector('#searchBox');
        if (myInput && myInput.value.trim() !== "") {
            filterTable();
        }
    });
</script>
@section Scripts {
    
}
