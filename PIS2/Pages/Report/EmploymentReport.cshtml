@page
@model PIS2.Pages.Report.EmploymentReportModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between">
    <h1 class="fw-bold flex-grow-1">Employments</h1>
    <div class="d-flex d-print-none">
        <ul class="nav nav-tabs">
            
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#departmentView">Company View</button>
            </li>
            
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#customReportView">Custom Report</button>
            </li>
            <li>@await Html.PartialAsync("print")</li>
        </ul>

    </div>
</div>
<hr />
<div class="tab-content mt-3">
    

    <div id="departmentView" class="tab-pane fade show active">
        <h5 class="fw-bold">Active Employees By Company</h5>
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>Company</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in Model.groupedView.GroupBy(g => g.CompanyID).OrderBy(i => i.Count()))
                {
                    <tr class="bg-secondary fw-bold">
                        <td>@index</td>
                        <td>@item.FirstOrDefault()?.CompanyName</td>
                        <td>@item.Where(i => i.PersonGender == Models.Gender.Male).Count()</td>
                        <td>@item.Where(i => i.PersonGender == Models.Gender.Female).Count()</td>
                        <td>@item.Count()</td>
                    </tr>
                    <tr class="fw-bold bg-light">
                        <td colspan="4"></td>
                        <td>
                            <ul>
                                @foreach (var types in item.GroupBy(ty => ty.EmploymentTypeName).OrderBy(i => i.Count()))
                                {
  
                                    <li>@types.Key = @types.Count()</li>
                                }
                            </ul>
                        </td>
                    </tr>
                    int index2 = 1;
                    @foreach (var dept in item.GroupBy(d => d.DepartmentName).OrderBy(i => i.Count()))
                    {
                        <tr class="bg-light">
                            <td>@index.@index2</td>
                            <td>@dept.FirstOrDefault()?.DepartmentName</td>
                            <td>@dept.Where(i => i.PersonGender == Models.Gender.Male).Count()</td>
                            <td>@dept.Where(i => i.PersonGender == Models.Gender.Female).Count()</td>
                            <td>@dept.Count()</td>
                        </tr>
                        index2++;
                    }
                    index++;
                }
            </tbody>

        </table>
    </div>
    <div id="customReportView" class="tab-pane fade">
        <h4 class="fw-bold">Cusrtom Report</h4>

        <!--SUMMARY POINTS-->
        <div class="d-flex justify-content-between">
            @{
                int activeEmployees = Model.employmentModel.Where(e => e.EmploymentStatus == Models.mainStatus.Active).Count();
            }
            <div class="card m-2 p-4 shadow flex-grow-1">
                <p class="small mb-1">Total Employment</p>
                <h5 class="fw-bold"><span id="filteredCount"></span> of @Model.totalCount</h5>
            </div>
            <div class="card m-2 p-4 shadow flex-grow-1">
                <p class="small mb-1">Active Employee</p>
                <h5 class="fw-bold"><span id="activeCount"></span> of @activeEmployees</h5>
            </div>

            <div class="card m-2 p-4 shadow flex-grow-1">
                <p class="small mb-1">Male</p>
                <h5 class="fw-bold"><span id="maleCount"></span> of @Model.employmentModel.Where(e => e.PersonGender == Models.Gender.Male).Count()</h5>
            </div>
            <div class="card m-2 p-4 shadow flex-grow-1">
                <p class="small mb-1">Female</p>
                <h5 class="fw-bold"><span id="femaleCount"></span> of @Model.employmentModel.Where(e => e.PersonGender == Models.Gender.Female).Count()</h5>
            </div>
            <div class="card m-2 p-4 shadow flex-grow-1">
                <p class="small mb-1">Management</p>
                <h5 class="fw-bold"><span id="managementCount"></span> of @Model.employmentModel.Where(e => e.EmploymentPosition == Models.EmploymentPositions.Management).Count()</h5>
            </div>

        </div>
        <div class="d-inline-flex justify-content-end">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>

        <!--FILTER CONTROLS-->
        <div class="row m-2">
            @if (Model.employmentModel != null)
            {
                <div class="col-3 d-print-flex">
                    <label for="filter-company">Company:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-company">
                        <option value="">All</option>
                        @foreach (var company in Model.Companies)
                        {
                            <option value="@company.companyID">@company.companyName</option>
                        }
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="filter-department">Department:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-department">
                        <option value="">All</option>
                        @foreach (var department in Model.Departments)
                        {
                            <option value="@department.departmentID">@department.departmentName</option>
                        }
                    </select>
                </div>

                <div class="col-3 d-print-flex">
                    <label for="filter-status">Status:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-status" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="filter-empType">Employment Type:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-empType">
                        <option value="">All</option>
                        @foreach (var empType in Model.EmploymentTypes)
                        {
                            <option value="@empType.employmentTypeID">@empType.employmentTypeName</option>
                        }
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="filter-status">Gender:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-gender" asp-items="Html.GetEnumSelectList<Models.Gender>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="filter-status">Position:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-position" asp-items="Html.GetEnumSelectList<Models.EmploymentPositions>()">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="filter-job">Job Tittle:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-job">
                        <option value="">All</option>
                        @foreach (var jobTitle in Model.JobTitles)
                        {
                            <option value="@jobTitle.jobID">@jobTitle.jobTitle</option>
                        }
                    </select>
                </div>

                <div class="col-3 d-print-flex">
                    <label for="filter-workLoc">Work Location:</label>
                    <select class="form-select" aria-label="Default select example" id="filter-workLoc">
                        <option value="">All</option>
                        @foreach (var workLocation in Model.WorkLocations)
                        {
                            <option value="@workLocation.workSiteID">@workLocation.workSiteName</option>
                        }
                    </select>
                </div>
                <div class="col-3 d-print-flex">
                    <label for="dateStart">Date of Employment From:</label>
                    <input class="form-control" type="date" id="dateStart" asp-for="StartDate" />
                </div>
                <div class="col-3 d-print-flex">
                    <label for="dateEnd">Date of Employment Upto:</label>
                    <input class="form-control" type="date" id="dateEnd" asp-for="EndDate" />
                </div>
                <div class="d-flex justify-content-end align-items-end">
                    <button class="btn btn-primary d-print-none" onclick="filterEmployees()">Load</button>
                </div>
            }
        </div>

        <!--TABLE-->
        <table class="table table-striped table-hover table-fixed" id="dataTable">
            <thead class="bg-dark text-white">

                <tr>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Empoyment Date
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Type
                    </th>
                    <th>
                        Job Title
                    </th>


                </tr>
            </thead>
            <tbody id="table-body">

        </table>
    </div>
    <div></div>
</div>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>

<!-- JavaScript for Filtering -->
<script>
    $(document).ready(function () {
        //filterEmployees();
        enableTableSorting("dataTable");
    });

    function filterEmployees() {
        var department = $("#filter-department").val();
        var empStatus = $("#filter-status").val();
        var jobTitle = $("#filter-job").val();
        var empType = $("#filter-empType").val();
        var workLoc = $("#filter-workLoc").val();
        var company = $("#filter-company").val();
        var dateStart = $("#dateStart").val();
        var dateEnd = $("#dateEnd").val();
        var position = $("#filter-position").val();
        var gender = $("#filter-gender").val();

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        empStatus = (!empStatus || empStatus === "") ? null : empStatus;
        jobTitle = (!jobTitle || jobTitle === "") ? null : jobTitle;
        empType = (!empType || empType === "") ? null : empType;
        workLoc = (!workLoc || workLoc === "") ? null : workLoc;
        company = (!company || company === "") ? null : company;
        dateStart = (!dateStart || dateStart === "") ? null : new Date(dateStart).toISOString();
        dateEnd = (!dateEnd || dateEnd === "") ? null : dateEnd;
        position = (!position || position === "") ? null : position;
        gender = (!gender || gender === "") ? null : gender;

        // Build the URL with multiple filters
        var url = `/Report/EmploymentReport?handler=Filter&department=${encodeURIComponent(department)}&jobTitle=${encodeURIComponent(jobTitle)}&empStatus=${encodeURIComponent(empStatus)}&empType=${encodeURIComponent(empType)}&company=${encodeURIComponent(company)}&workLoc=${encodeURIComponent(workLoc)}&dateStart=${encodeURIComponent(dateStart)}&dateEnd=${encodeURIComponent(dateEnd)}&position=${encodeURIComponent(position)}&gender=${encodeURIComponent(gender)}`;

        $.getJSON(url, function (data) {
            $("#filteredCount").html(data.filteredCount);
            $("#table-body").html(data.tableHtml);
            $("#activeCount").html(data.activeCount);
            $("#femaleCount").html(data.femaleCount);
            $("#maleCount").html(data.maleCount);
            $("#managementCount").html(data.managementCount);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error("Error:", textStatus, errorThrown);
        });
    }
</script>
