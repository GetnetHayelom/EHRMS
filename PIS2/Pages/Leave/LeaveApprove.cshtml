@page
@model PIS2.Pages.Leave.LeaveApproveModel

@{
    ViewData["Title"] = "Leave Approve";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Leave Approve</h1>

<p>
    <a asp-page="Create">Add New Leave Request</a>
    @await Html.PartialAsync("filter")
</p>
<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
        <th>Leave No</th>
            <th>
                Employee ID
            </th>
            <th>
                Date
            </th>
            <th>
                From
            </th>
            <th>
                To
            </th>
            <th>
                Days
            </th>
            <th>
                Type
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.leaveModel) {
        <tr>
           
            <td><a asp-page="./Details" asp-route-id="@item.leaveID">@item.leaveID</a></td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @item.leaveReaquestDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                    @item.leaveStartDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                    @item.leaveEndDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.leaveDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.leaveStatus)
            </td>
            <td class="d-flex justify-content-between flex-grow-1">
                    @if (item.leaveStatus == Models.leaveStatus.Posted)
                    {
                        <p>Leave is posted; No further action.</p>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Approve">
                            <input asp-for="@item.leaveID" name="leaveId" type="hidden"></input>
                            <button type="submit" class="btn btn-success post-button" data-id="@item.leaveID">Approve</button>
                        </form>
                        <form method="post" asp-page-handler="Reject">
                            <input asp-for="@item.leaveID" name="leaveId" type="hidden"></input>
                            <button type="submit" class="btn btn-danger post-button ml-4" data-id="@item.leaveID">Decline</button>
                        </form>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
