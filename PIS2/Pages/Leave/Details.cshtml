@page
@model PIS2.Pages.Leave.DetailsModel

@{
    ViewData["Title"] = "Leave Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Leave Request</h1>

<div id="leaveDetail" class="d-flex d-print-flex">   
    <div class="flex-grow-1 print-full-width">
    <h3 class="fw-bold">Leave Detail</h3>
        <hr />
        <dl class="d-flex justify-content-between  me-3">            
                <div class="flex-grow-1">
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Voucher ID:
                        </dt>
                        <dd class="me-4">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveID)</u>
                        </dd>
                        <dt class="me-2">
                            Employee ID:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.employmentModel.givenID)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Company:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Job.departmentModel.companyModel.companyName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Work Location:
                        </dt>
                        <dd class="">
                            <u>workSiteName</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Leave Type:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveTypeModel.leaveTypeName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Start Date:
                        </dt>
                        <dd class="">
                            <u> @Model.leaveModel.leaveStartDate.ToString("MMM dd, yyyy")</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Leave Days:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveDays)</u>
                        </dd>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Name:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.employmentModel.personModel.personFullName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Department:
                        </dt>
                        <dd class="">
                            <u>@Model.Job.departmentModel.departmentName</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Shift:
                        </dt>
                        <dd class="">
                            <u>shiftName</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Request Date:
                        </dt>
                        <dd class="">
                            <u>@Model.leaveModel.leaveRequestDate.ToString("MMM dd, yyyy")</u>
                        </dd>
                    </div>

                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            End Date:
                        </dt>
                        <dd class="">
                            <u>@Model.leaveModel.leaveEndDate.ToString("MMM dd, yyyy")</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Status:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveStatus)</u>
                        </dd>
                    </div>
                </div>     
        </dl>
    </div>
    
    <div class="flex-grow-1 d-print-none">
        <form method="get" class="d-print-none">
            <div class="d-flex justify-content-between">
                <h4 class="fw-bold">Leave History</h4>
                <div class="d-flex">
                    <input id="overtimeRecordID" class="form-control me-2" placeholder="Enter Leave Batch Number" name="id" />
                    <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                </div>
            </div>
        </form>
        <hr />
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-info text-white print-dark">
                    <th>Date</th>
                    <th>Status</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.leaveModel.LeaveHistories)
                {
                    <tr>
                        <td>@item.modifiedDate</td>
                        <td>@item.leaveHistoryAction</td>
                        <td>@item.modifiedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
   
</div>
<table class="table d-none d-print-block print-full-width">
    <thead>
        <tr>
            <th>Action</th>
            <th>Name</th>

            <th>Signature</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody class="print-full-width">
        <tr>
            <td>Requested By:</td>
            
            <td><u>@Html.DisplayFor(model => model.leaveModel.employmentModel.personModel.personFullName)</u></td>
            <td>______________________</td>
            <td> <u>@Model.leaveModel.leaveRequestDate.ToString("MMM dd, yyyy")</u></td>
        </tr>
        <tr>
            <td>Approved By:</td>
            @if(Model.leaveModel.leaveStatus == Models.leaveStatus.Approved)
            {
                <td>
                    <u>@Model.leaveModel.LeaveHistories.Where(lh => lh.leaveHistoryAction == Models.leaveStatus.Approved).Last().modifiedBy</u>
                </td>
                <td>______________________</td>
                <td>
                    <u>@Model.leaveModel.LeaveHistories.Where(lh => lh.leaveHistoryAction == Models.leaveStatus.Approved).Last().modifiedDate</u>
                </td>
            }
            else
            {
                <td>______________________</td>
                <td>______________________</td>
                <td>______________________</td>
            }
      
          
        </tr>
        <tr>
            <td>Posted By:</td>
            @if(Model.leaveModel.leaveStatus == Models.leaveStatus.Posted)
            {
                <td>
                    <u>@Model.leaveModel.LeaveHistories.Where(lh => lh.leaveHistoryAction == Models.leaveStatus.Posted).Last().modifiedBy</u>
                </td>
                <td>______________________</td>
                <td>
                    <u>@Model.leaveModel.LeaveHistories.Where(lh => lh.leaveHistoryAction == Models.leaveStatus.Posted).Last().modifiedDate</u>
                </td>
            }
            else
            {
            <td>______________________</td>
            <td>______________________</td>
            <td>______________________</td>
            }
        </tr>
    </tbody>
</table>

<div class="d-print-none d-flex justify-content-end">
    
    @if (User.IsInRole("MIE\\PMS_HRCLERK") && (Model.leaveModel.leaveStatus == Models.leaveStatus.Hold || Model.leaveModel.leaveStatus == Models.leaveStatus.Approved))
    {
        <form method="post">
            <input asp-for="leaveModel.leaveID" name="leaveId" type="hidden"></input>
            <button type="submit" class="btn btn-success post-button d-print-none m-2" data-id="Model.leaveID">Post</button>
        </form>
    }
    @await Html.PartialAsync("print")
</div>
