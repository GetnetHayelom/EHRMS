@page
@model PIS2.Pages.Leave.DetailsModel

@{
    ViewData["Title"] = "Leave Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Leaves</h1>

<div id="leaveDetail" class="d-flex  d-print-flex flex-wrap">
    <div class="col-md-6">
        <h4>Leave Detail</h4>
        <hr />
        <dl class="row d-print-flex print-wrap">
            <dt class="col-sm-2">
                Employee ID:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.employmentModel.givenID)
            </dd>
            <dt class="col-sm-2">
                Employee Name:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.employmentModel.personModel.personFullName)
            </dd>
            <dt class="col-sm-2">
                Request Date:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.leaveReaquestDate)
            </dd>
            <dt class="col-sm-2">
                Leave Start Date:
            </dt>
            <dd class="col-sm-10">
                @Model.leaveModel.leaveStartDate.ToString("MMM dd, yyyy")
            </dd>
            <dt class="col-sm-2">
                Leave End Date:
            </dt>
            <dd class="col-sm-10">
                @Model.leaveModel.leaveEndDate.ToString("MMM dd, yyyy")
            </dd>
            <dt class="col-sm-2">
                Leave Days:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.leaveDays)
            </dd>
            <dt class="col-sm-2">
                Leave Type:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.leaveTypeModel.leaveTypeName)
            </dd>
            <dt class="col-sm-2">
                Leave Status:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.leaveModel.leaveStatus)
            </dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h4><u>Leave History</u></h4>
        <hr />
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-dark text-white print-dark">
                    <th>Date</th>
                    <th>Status</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.leaveModel.LeaveHistories)
                {
                    <tr>
                        <td>@item.leaveHistoryDate</td>
                        <td>@item.leaveHistoryAction</td>
                        <td>@item.leaveUser</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
   
</div>
<div class="d-print-none">
    <a asp-page="./Edit" asp-route-id="@Model.leaveModel.leaveID">Edit</a> |
    <a asp-page="./Index">Back to List</a> |
    <a asp-page="#" onclick="printDiv('leaveDetail')">Print</a>
</div>
