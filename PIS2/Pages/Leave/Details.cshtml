@page
@model PIS2.Pages.Leave.DetailsModel

@{
    ViewData["Title"] = "Leave Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container mt-4">
 
    <div class="d-flex justify-content-between mb-4 border-bottom pb-2">
        <div>
            <h1 class="fw-bold mb-0">Leave Request</h1>
            <span class="text-muted">Voucher ID: #@Model.leaveModel.leaveID</span>
        </div>
        <div class="d-print-none">
            @await Html.PartialAsync("print")
        </div>
    </div>

    <div class="d-flex gap-1">
        <div class="col-lg-7 print-full-width">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold mb-0 text-primary">Leave Information</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <div class="col-sm-6 mb-3">
                            <label class="small text-uppercase text-muted fw-bold">Employee</label>
                            <p class="mb-0 fw-bold border-bottom pb-1">@Model.leaveModel?.employmentModel?.personModel?.personFullName (@Model.leaveModel?.employmentModel?.givenID)</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="small text-muted text-uppercase">Request Date</label>
                            <p class="small">@Model.leaveModel?.leaveRequestDate.ToString("MM/dd/yyyy")</p>
                        </div>
                    </div>
                    <div class="d-flex mb-3">
                        <div class="col-sm-6 mb-3">
                            <label class="small text-uppercase text-muted fw-bold">Leave Type</label>
                            <p class="mb-0 border-bottom pb-1">@Model.leaveModel?.leaveTypeModel?.leaveTypeName</p>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label class="small text-uppercase text-muted fw-bold">Status</label>
                            <div>
                                <span class="badge @(Model.leaveModel?.leaveStatus == Enums.leaveStatus.Approved ? "bg-success" : "bg-warning")">@Model.leaveModel?.leaveStatus</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-around bg-light rounded p-3 mb-3 mx-0">
                        <div class="col-md-4">
                            <label class="small text-muted d-block text-uppercase">Start Date</label>
                            <strong>@Model.leaveModel?.leaveStartDate.ToString("MM/dd/yyyy")</strong>
                        </div>
                        <div class="col-md-4 text-center">
                            <label class="small text-muted d-block text-uppercase">Days</label>
                            <span class="h5 fw-bold text-primary">@Model.leaveModel?.leaveDays</span>
                        </div>
                        <div class="col-md-4 text-end">
                            <label class="small text-muted d-block text-uppercase">End Date</label>
                            <strong>@Model.leaveModel?.leaveEndDate.ToString("MM/dd/yyyy")</strong>
                        </div>
                    </div>

                    <div class="d-flex justify-content-around">
                        <div class="col-sm-6 mb-3">
                            <label class="small text-uppercase text-muted fw-bold">Department</label>
                            <p class="mb-0 border-bottom pb-1">@Model.Job?.departmentModel?.departmentName</p>
                        </div>
                        <div class="col-sm-6">
                            <label class="small text-muted text-uppercase">Company</label>
                            <p class="small">@Model.Job?.departmentModel?.companyModel?.companyName</p>
                        </div>
                        
                        
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 d-print-none">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Quick Search</h6>
                    <form method="get">
                        <div class="input-group">
                            <input id="overtimeRecordID" class="form-control" placeholder="Leave Batch #" name="id" />
                            <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">Workflow History</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Status</th>
                                <th>By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.leaveModel.LeaveHistories)
                            {
                                <tr>
                                    <td>@item.modifiedDate.ToString("g")</td>
                                    <td><span class="badge bg-light text-dark border">@item.leaveHistoryAction</span></td>
                                    <td>@item.modifiedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="d-none print-full-width d-print-block mt-5">
        <table class="table table-bordered border-dark text-center print-full-width">
            <thead class="table-light border-dark">
                <tr>
                    <th width="25%">Action</th>
                    <th width="30%">Name</th>
                    <th width="25%">Signature</th>
                    <th width="20%">Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold text-start">Requested By:</td>
                    <td class=" text-start">@Model.leaveModel.employmentModel.personModel.personFullName</td>
                    <td class="border-bottom-2 border-dark"></td>
                    <td class=" text-start">@Model.leaveModel.leaveRequestDate.ToString("MM/dd/yyyy")</td>
                </tr>
                <tr>
                    <td class="fw-bold">Approved By:</td>
                    @if (Model.leaveModel.leaveStatus == Enums.leaveStatus.Approved)
                    {
                        var lastApproved = Model.leaveModel.LeaveHistories.LastOrDefault(lh => lh.leaveHistoryAction == Enums.leaveStatus.Approved);
                        <td class=" text-start">@(lastApproved?.modifiedBy ?? "")</td>
                        <td></td>
                        <td class=" text-start">@(lastApproved?.modifiedDate.ToString("MM/dd/yyyy") ?? "")</td>
                    }
                    else
                    {
                        <td class="border-buttom-1"></td>
                        <td></td>
                        <td></td>
                    }
                </tr>
                <tr>
                    <td class="fw-bold">Posted By:</td>
                    @if (Model.leaveModel.leaveStatus == Enums.leaveStatus.Posted)
                    {
                        var lastPosted = Model.leaveModel.LeaveHistories.LastOrDefault(lh => lh.leaveHistoryAction == Enums.leaveStatus.Posted);
                        <td class=" text-start">@(lastPosted?.modifiedBy ?? "")</td>
                        <td></td>
                        <td class=" text-start">@(lastPosted?.modifiedDate.ToString("MM/dd/yyyy") ?? "")</td>
                    }
                    else
                    {
                        <td></td>
                        <td></td>
                        <td></td>
                    }
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-print-none mt-4 d-flex justify-content-end gap-2">
        @if (User.IsInRole("HRPERSONNEL") && (Model.leaveModel.leaveStatus == Enums.leaveStatus.Hold || Model.leaveModel.leaveStatus == Enums.leaveStatus.Approved))
        {
            <form method="post">
                <input asp-for="leaveModel.leaveID" name="leaveId" type="hidden" />
                <button type="submit" class="btn btn-success px-4 shadow-sm">Post</button>
            </form>
        }
    </div>
</div>