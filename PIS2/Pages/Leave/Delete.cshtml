@page
@model PIS2.Pages.Leave.DeleteModel

@{
    ViewData["Title"] = "Delete Leave";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Leaves</h1>

<h3>Are you sure you want to delete this leave?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Request Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveRequestDate)
        </dd>
        <dt class="col-sm-2">
            Leave Start Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveStartDate)
        </dd>
        <dt class="col-sm-2">
            Leave End Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveEndDate)
        </dd>
        <dt class="col-sm-2">
            Leave Days:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveDays)
        </dd>
        <dt class="col-sm-2">
            Leave Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveTypeModel.leaveTypeID)
        </dd>
        <dt class="col-sm-2">
            Leave Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.leaveModel.leaveStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="leaveModel.leaveID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
