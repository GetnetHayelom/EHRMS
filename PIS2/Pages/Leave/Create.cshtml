@page
@model PIS2.Pages.Leave.CreateModel

@{
    ViewData["Title"] = "New Leave";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    int num = 0;
    int num2 = 0;
}

<h2 class="fw-bold m-0">Leaves</h2>
<p class="text-muted mb-0">Leave request form</p>

<hr />

<div class="d-flex">
    <div class="flex-grow-1 m-2 card shadow-sm p-2">
        <div class="">
            <form method="get" class="d-print-none">
                <div class="d-flex flex-column">
                    <h4 class="fw-bold">Leave Request</h4>
                    <div class="d-flex">
                        <input asp-for="Employment.givenID" id="givenID" class="form-control me-2" placeholder="Enter ID" name="givenID" />
                        <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                    </div>
                    <h6 class="mt-2 mb-2"><u>@Model.Person.personFullName</u></h6>
                </div>
            </form>
        </div>
        <div class="d-flex justify-content-between mt-4 mb-4">
            <div class="d-flex flex-column justify-content-center align-items-center border-start flex-grow-1 p-2">
                <h6 class="d-flex justify-content-center">Allowed Leave:</h6>
                <h2><u>@Model.LeaveDetail.AllowedLeave.ToString("0.0")</u></h2>
            </div>
            <div class="d-flex flex-column justify-content-center align-items-center border-start flex-grow-1 p-2">
                <h6>Total Leave</h6>
                <h2><u>@Model.LeaveDetail.TotalLeave</u></h2>
            </div>
            <div class="d-flex flex-column justify-content-center align-items-center border-start border-end flex-grow-1 p-2">
                <h6 class="align-items-center">Last Increment: </h6>
                <h2><u>@Model.LeaveDetail.LastAccrualIncrement</u></h2>
            </div>
        </div>
        @if(Model.Employment.employmentStatus == Models.mainStatus.Active)
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="Leave.employmentID" id="employmentID" class="form-control me-2" type="hidden" value="Employment.emoloymentID" />
                <div class="d-flex justify-content-between">
                    <div class="form-group m-1">
                        <label asp-for="Leave.leaveStartDate" class="control-label me-2">Start Date:</label>
                        <input asp-for="Leave.leaveStartDate" id="startDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Leave.leaveStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-group m-1">
                        <label asp-for="Leave.leaveEndDate" class="control-label">End Date:</label>
                        <input asp-for="Leave.leaveEndDate" id="endDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Leave.leaveEndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <div class="form-group m-1 col-3">
                        <label asp-for="Leave.leaveDays" class="control-label">No. of Days:</label>
                        <input asp-for="Leave.leaveDays" class="form-control" type="number" step="0.5" id="leaveDays"/>
                        <span asp-validation-for="Leave.leaveDays" class="text-danger"></span>
                        <span id="maxLeaveDisplay" class="text-info"></span>
                    </div>
                    <div class="form-group m-1">
                        <label asp-for="Leave.leaveTypeID" class="control-label">Leave Type</label>
                        <select asp-for="Leave.leaveTypeID" class="form-control" asp-items="ViewBag.leaveTypeID"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <input type="submit" value="Save" class="btn btn-success d-print-none" />
                </div>
            </form>
        }
        else if(Model.Employment.employmentStatus == Models.mainStatus.Inactive)
        {
            <div class="bg-danger p-4 text-white"><h4>Employee is not Active</h4></div>
        }else if(Model.EmployeeID == 0)
        {
            <div class="bg-danger p-4 text-white"><h4>Employee is not Active</h4></div>
        }

    </div>

    <div id="collapseGroup" class="flex-grow-2 m-4 card shadow-sm p-2">
        <div>
           </div>
        <!--leave Aggrigate-->
        <div class="collapse show" id="leaveAggrigate" data-bs-parent="#collapseGroup">
             <div class=" d-flex justify-content-between">
                <h5 class="fw-bold">Annual Leave Summary</h5>
                <a role="button" class="btn btn-outline-info text-decoration-none nav-link mb-2" id="leaveHistory" data-bs-toggle="collapse" data-bs-target="#leaveHistoryView" aria-expanded="false">View History</a>

            </div>
            @if (Model.LeaveDetail.AnnualLeaveHistory != null && Model.LeaveDetail.AnnualLeaveHistory.Any())
            {
            <table class="table table-striped table-hover">
                <thead>
                    <tr class="bg-dark text-white">
                        <th>No</th>
                        <th>Year</th>
                        <th>Starting Balance</th>
                        <th>Increments</th>
                        <th>Used Leave</th>
                        <th>Available Balance</th>
                        <th>Year Balance</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.LeaveDetail.AnnualLeaveHistory)
                    {
                        num++;
                        <tr>
                            <td>@num</td>
                            <td class="text-nowrap">@item.startDate.ToString("MM/dd/yyyy") - @item.endDate.ToString("MM/dd/yyyy")</td>
                            <td>@item.startingLeaveAmount</td>
                            <td>@item.accruedLeaveAmount</td>
                            <td>@item.usedLeaveAmount</td>
                            <td>@item.remainingLeaveAmount</td>
                            <td>@item.rollOverLeave</td>
                            <td>@item.remainingLeaveCost.ToString("N2")</td>
                        </tr>
                    }

                </tbody>
            </table>
            }
        </div>
        <!--Leave History-->
        <div class="col-md-12 collapse border-primary rounded" id="leaveHistoryView" data-bs-parent="#collapseGroup">
            
            @if (Model.Employment == null)
            {
                <p>@Model.Person.personFullName is not an active employee.</p>
            }
            else
            {
                <div class="d-flex justify-content-between">
                    <h5 class="fw-bold">Leave and Attendance Hitory</h5>
                    <a role="button" class="btn btn-outline-info text-decoration-none nav-link mb-2" id="leaveSummary" data-bs-toggle="collapse" data-bs-target="#leaveAggrigate" aria-expanded="true">View Summary</a>

                </div>
                <div class="modal-body">
                    <h6>Employee Name: <b><u>@Model.Person.personFullName</u></b> </h6>
                    <h6>Employee ID: <b><u> @Model.Employment.givenID</u></b> </h6>
                    @if (Model.Leaves == null)
                    {
                        <p>No leave history for the selected employment. @Model.Employment.givenID</p>
                    }
                    else
                    {
                        @await Html.PartialAsync("filter")
                        <table class="table table-striped table-hover" id="dataTable">
                            <thead>
                                <tr class="bg-dark text-white">
                                    <th>
                                        No
                                    </th>
                                    <th>
                                        Voucher Number
                                    </th>
                                    <th>
                                        Request Date
                                    </th>
                                    <th>
                                        Start Date
                                    </th>
                                    <th>
                                        End Date
                                    </th>
                                    <th>
                                        Number of Days
                                    </th>
                                    <th>
                                        Leave Type
                                    </th>
                                    <th>
                                        Leave Status
                                    </th>

                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model.Leaves)
                                {
                                    num2++;
                                    <tr onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                        <td>@num2</td>
                                        <td>
                                            <a asp-page="/Leave/Details" asp-route-id="@item.leaveID" class="text-decoration-none text-dark">
                                                @item.leaveID
                                            </a>
                                        </td>
                                        <td>
                                            @item.leaveRequestDate.ToString("MM/dd/yyyy")
                                        </td>
                                        <td>
                                            @item.leaveStartDate.ToString("MM/dd/yyyy")
                                        </td>
                                        <td>
                                            @item.leaveEndDate.ToString("MM/dd/yyyy")
                                        </td>
                                        <td>
                                            @Math.Round(item.leaveDays,2)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.leaveStatus)
                                        </td>

                                    </tr>
                                }

                            </tbody>
                        </table>
                    }

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary d-print-none" onclick="printDiv('leaveHistoryView')">Print</button>
                    <button type="button" class="btn btn-secondary d-print-none" data-bs-dismiss="modal">Close</button>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");
        const display = document.getElementById("maxLeaveDisplay");
        calculateWorkingDays();
        startDate.addEventListener("change", function () {
            // Set the min attribute of endDate to match selected startDate
            endDate.min = startDate.value;

            // Optional: auto-correct end date if it’s before the new start date
            if (endDate.value < startDate.value) {
                endDate.value = startDate.value;
            }
            calculateWorkingDays();
        });
        endDate.addEventListener("change", function () {
            // Set the min attribute of endDate to match selected startDate
            startDate.max = endDate.value;

            // Optional: auto-correct end date if it’s before the new start date
            if (endDate.value < startDate.value) {
                startDate.value = endDate.value;
            }
            calculateWorkingDays();
        });
        function calculateWorkingDays() {
            const start = startDate.value;
            const end = endDate.value;

            if (!start || !end || end < start) {
                display.textContent = "";
                return;
            }

            const formData = new URLSearchParams();
            formData.append("startDate", start);
            formData.append("endDate", end);

            fetch("/Leave/Create?handler=CalculateWorkingDays", {
                method: "POST",
                headers: {
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: formData
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Server error");
                    }
                    return response.json();
                })
                .then(data => {
                    display.textContent = `Maximum working days: ${data}`;
                    // Set max attribute on leaveDays input
                    const leaveDaysInput = document.getElementById("leaveDays");
                    leaveDaysInput.max = data;
                })
                .catch(error => {
                    console.error("Error calculating leave days:", error);
                    display.textContent = "Error calculating available days";
                });
        }

    });
</script>

