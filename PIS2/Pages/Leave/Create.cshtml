@page
@model PIS2.Pages.Leave.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>leaveModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="leaveModel.employmentID" class="control-label"></label>
                <select asp-for="leaveModel.employmentID" class ="form-control" asp-items="ViewBag.employmentID"></select>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveReaquestDate" class="control-label"></label>
                <input asp-for="leaveModel.leaveReaquestDate" class="form-control" type="date"/>
                <span asp-validation-for="leaveModel.leaveReaquestDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveStartDate" class="control-label"></label>
                <input asp-for="leaveModel.leaveStartDate" class="form-control" type="date"/>
                <span asp-validation-for="leaveModel.leaveStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveEndDate" class="control-label"></label>
                <input asp-for="leaveModel.leaveEndDate" class="form-control" type="date"/>
                <span asp-validation-for="leaveModel.leaveEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveDays" class="control-label"></label>
                <input asp-for="leaveModel.leaveDays" class="form-control"/>
                <span asp-validation-for="leaveModel.leaveDays" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveTypeID" class="control-label"></label>
                <select asp-for="leaveModel.leaveTypeID" class ="form-control" asp-items="ViewBag.leaveTypeID"></select>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveStatus" class="control-label"></label>
                <select asp-for="leaveModel.leaveStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()"></select>
                <span asp-validation-for="leaveModel.leaveStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
