@page
@model PIS2.Pages.Leave.IndexModel

@{
    ViewData["Title"] = "Leave and Attendance";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<div class="container-fluid print-full-width">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0">Leave & Attendance</h2>
            <p class="text-muted mb-0">Unposted Leaves and Attendance</p>
        </div>
        <div class="d-flex gap-2 align-items-end">
            <h5 class="fw-bold text-light bg-dark p-2 m-0 rounded">Pending Requests: @Model.CountUnposted</h5>
            <a asp-page="Create" class="btn btn-primary m-0 d-print-none"><i class="bi bi-plus-circle me-2"></i> New Record</a>
        </div>
        
    </div>
    <div class="mb-0 d-flex justify-content-between align-items-end">
        <ul class="nav nav-tabs">
            <li class="nav-item"><button class="nav-link active d-print-none" data-bs-toggle="tab" data-bs-target="#rawView">List View</button></li>
            <li class="nav-item"><button class="nav-link d-print-none" data-bs-toggle="tab" data-bs-target="#groupDepView">Department View</button></li>
            <li class="nav-item"><button class="nav-link m-1 d-print-none" data-bs-toggle="tab" data-bs-target="#groupTypeView">Types View</button></li>
            <li class="nav-item"><button class="nav-link m-1 d-print-none" data-bs-toggle="tab" data-bs-target="#toExpire">Expiration View</button></li>
        </ul>
    </div>
    <!-- Parent container -->
    <div id="parentDiv" class="tab-content print-full-width">
        <!-- LIST VIEW -->
        <div id="rawView" class="tab-pane active" data-bs-parent="#parentDiv">

            <div class="card shadow-sm m-1 p-0">
                <div class="d-flex justify-content-between align-items-end">
                    <h4 class="fw-bold text-primary">Unposted Leaves</h4>
                    <div class="d-flex justify-content-end align-items-end m-0">
                        @await Html.PartialAsync("filter")
                        @await Html.PartialAsync("back")
                        @await Html.PartialAsync("print")
                        <div class="m-2"><excel-export table="dataTable" filename="Unposted_Leave_List_@(DateTime.UtcNow).xlsx"></excel-export></div>
                    </div>
                </div>
            </div>

            <div class="table-responsive shadow-sm rounded">
                
                <table class="table table-bordered table-hover align-middle" id="dataTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Leave No</th>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="d-print-none text-center"></th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                        
                        @foreach (var item in Model.leaveModel.OrderBy(l => l.LeaveRequestDate))
                        {
                            <tr>
                                <td onclick="location.href='@Url.Page("Details", new { id = item.LeaveId })'" style="cursor:pointer;">
                                    <strong>@item.LeaveId</strong>
                                </td>
                                <td>@item.GivenID</td>
                                <td>@item.FullName</td>
                                <td>@item.LeaveRequestDate.ToString("MM/dd/yyyy")</td>
                                <td>@item.LeaveStart.ToString("MM/dd/yyyy")</td>
                                <td>@item.LeaveEnd.ToString("MM/dd/yyyy")</td>
                                <td>@item.LeaveDays</td>
                                <td>@item.LeaveType</td>
                                <td>
                                    @if (item.LeaveStatus == Enums.leaveStatus.Approved)
                                    {
                                        <span class="badge bg-success">@item.LeaveStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.LeaveStatus</span>
                                    }
                                </td>
                                <td class="text-center d-print-none">
                                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                    {
                                        <button class="btn btn-success btn-sm post-button" data-id="@item.LeaveId">Post</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- DEPARTMENT GROUP VIEW -->
        <div id="groupDepView" class="tab-pane" data-bs-parent="#parentDiv">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold mt-3 text-dark">Department Unposted Leave</h4>
                <excel-export table="departmentTable" filename="Unposted_Leave_Department_@(DateTime.Now).xlsx"></excel-export>
            </div>
            
            <div class="table-responsive shadow-sm rounded">
                
                <table class="table table-striped table-hover align-middle" id="departmentTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>Department</th>
                            <th>Requests</th>
                            <th>Sum of Days</th>
                        </tr>
                    </thead>
                    <tbody id="departmentsAccordion">
                        @{
                            int index = 1;
                        }
                        @foreach (var dep in Model.GroupedDepLeaves)
                        {
                            var collapseId = $"collapse{index}";
                            <tr class="fw-bold table-active" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                                <td>@index</td>
                                <td>@dep.DepartmentName</td>
                                <td>@dep.Count (@Math.Round((@dep.Count * 100) / @Model.CountUnposted, 2)%)</td>
                                <td>@Math.Round(dep.SumDays, 2)</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="p-0">
                                    <div id="@collapseId" class="accordion-collapse collapse bg-light" data-bs-parent="#departmentsAccordion">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-info text-white">
                                                <tr>
                                                    <th>Leave No</th>
                                                    <th>Employee ID</th>
                                                    <th>Name</th>
                                                    <th>Date</th>
                                                    <th>From</th>
                                                    <th>To</th>
                                                    <th>Days</th>
                                                    <th>Type</th>
                                                    <th>Status</th>
                                                    <th class="d-print-none text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in dep.Records)
                                                {
                                                    <tr>
                                                        <td onclick="location.href='@Url.Page("Details", new { id = item.LeaveId })'" style="cursor:pointer;">@item.LeaveId</td>
                                                        <td>@item.GivenID</td>
                                                        <td>@item.FullName</td>
                                                        <td>@item.LeaveRequestDate.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveStart.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveEnd.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveDays</td>
                                                        <td>@item.LeaveType</td>
                                                        <td>
                                                            @if (item.LeaveStatus == Enums.leaveStatus.Approved)
                                                            {
                                                                <span class="badge bg-success">@item.LeaveStatus</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">@item.LeaveStatus</span>
                                                            }
                                                        </td>
                                                        <td class="text-center d-print-none">
                                                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                            {
                                                                <button class="btn btn-success btn-sm post-button" data-id="@item.LeaveId">Post</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TYPE GROUP VIEW -->
        <div id="groupTypeView" class="tab-pane" data-bs-parent="#parentDiv">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold mt-3 text-primary">Unposted Leave By Type</h4>
                <excel-export table="typeTable" filename="Unposted_Leave_Types_@(DateTime.Now).xlsx"></excel-export>
            </div>
            
            <div class="table-responsive shadow-sm rounded">
                
                <table class="table table-striped table-hover align-middle" id="typeTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>Leave Type</th>
                            <th>Requests</th>
                            <th>Sum of Days</th>
                        </tr>
                    </thead>
                    <tbody id="typesAccordion">
                        @{
                            int index1 = 1;
                        }
                        @foreach (var dep in Model.GroupedTypeLeaves)
                        {
                            var collapseId = $"leaveType{index1}";
                            <tr class="fw-bold table-active" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                                <td>@index1</td>
                                <td>@dep.DepartmentName</td>
                                <td>@dep.Count (@Math.Round((@dep.Count * 100) / Model.CountUnposted, 2)%)</td>
                                <td>@Math.Round(dep.SumDays, 2)</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="p-0">
                                    <div id="@collapseId" class="accordion-collapse collapse bg-light" data-bs-parent="#typesAccordion">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-info text-white">
                                                <tr>
                                                    <th>Leave No</th>
                                                    <th>Employee ID</th>
                                                    <th>Name</th>
                                                    <th>Date</th>
                                                    <th>From</th>
                                                    <th>To</th>
                                                    <th>Days</th>
                                                    <th>Type</th>
                                                    <th>Status</th>
                                                    <th class="d-print-none text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in dep.Records)
                                                {
                                                    <tr>
                                                        <td onclick="location.href='@Url.Page("Details", new { id = item.LeaveId })'" style="cursor:pointer;">@item.LeaveId</td>
                                                        <td>@item.GivenID</td>
                                                        <td>@item.FullName</td>
                                                        <td>@item.LeaveRequestDate.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveStart.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveEnd.ToString("MM/dd/yyyy")</td>
                                                        <td>@item.LeaveDays</td>
                                                        <td>@item.LeaveType</td>
                                                        <td>
                                                            @if (item.LeaveStatus == Enums.leaveStatus.Approved)
                                                            {
                                                                <span class="badge bg-success">@item.LeaveStatus</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">@item.LeaveStatus</span>
                                                            }
                                                        </td>
                                                        <td class="text-center d-print-none">
                                                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                            {
                                                                <button class="btn btn-success btn-sm post-button" data-id="@item.LeaveId">Post</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            index1++;
                        }
                    </tbody>
                </table>               
            </div>
        </div>

        <!-- TO EXPIRE VIEW -->
        <div class="tab-pane fade" id="ExpiringLeaveView">
            <h4 class="fw-bold mt-3 text-primary">Expiring Leaves</h4>
            <div class="d-flex justify-content-between align-items-end">
                <div class="d-flex gap-2">
                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-ex-company" onchange="loadDepartments('#filter-ex-company', '#filter-ex-department')">
                                <option value="">All</option>
                                @foreach (var company in Model.Companies)
                                {
                                    <option value="@company.companyID">@company.companyName</option>
                                }
                            </select>
                            <label for="filter-company">Company</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filter-ex-department">
                                <option value="">All</option>
                            </select>
                            <label for="filter-department">Department</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-floating">
                            <select class="form-select" asp-items="@Html.GetEnumSelectList<Enums.EmploymentPositions>()" id="filter-ex-position">
                                <option value="">All</option>
                            </select>
                            <label class="form-control-sm">Position</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-floating">
                            <input class="form-control" type="number" step="1" id="filter-ex-years" value="2">
                            <label class="form-control-sm">Years</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="btn-group m-2">
                            <button class="btn btn-primary my-2" onclick="filterExpiredLeaves()"><i class="bi bi-filter-circle me-2"></i>Filter</button>
                            <excel-export table="typeTable" filename="Unposted_Leave_Types_@(DateTime.Now).xlsx"></excel-export>
                        </div>
                    </div>
                </div>

            </div>
            <div id="expiring_leave_table">
                @await Html.PartialAsync("_ExpiringLeaves", Model.ExpiringLeaves)
            </div>

        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        @await Html.PartialAsync("print")
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        $('.post-button').click(function (e) {
            e.preventDefault();
            const leaveId = $(this).data('id');
            const token = $('input[name="__RequestVerificationToken"]').val();
            const button = $(this);

            $.ajax({
                url: '@Url.Page("Index", "Approve")',
                type: 'POST',
                data: { leaveId, __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        button.prop('disabled', true).text('Posted');
                        alert(res.message);
                    } else alert("Error: " + res.message);
                },
                error: function (xhr, status, err) {
                    alert('Error: ' + err);
                }
            });
        });
    });
</script>
