@page
@model PIS2.Pages.Leave.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
<h1 class="fw-bold">Leave and Attendance </h1>
<h4 class="fw-bold">Unposted Leaves and Attendance </h4>
<div class="d-flex justify-content-between">
    
    <!--Unposted leaves-->
    <div class="d-flex">
        <a asp-page="Create" class="btn btn-primary m-2">Add New Overtime Record</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#rawView">List View</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#groupDepView">Department View</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#groupTypeView">Types View</a>
    </div>

    <div class="">
        <h4 class="fw-bold">Pending Requests:@Model.CountUnposted</h4>      
    </div>
    
    
</div>

<hr />
<div id="parentDiv">
    <!--List View-->
    <div id="rawView" class="show" data-bs-parent="#parentDiv">
        <div class="d-inline-flex">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>

        <table class="table table-striped table-hover" id="dataTable">
        <thead class="bg-dark text-white">
            <tr>
                <th>Leave No</th>
                <th>
                    Employee ID
                </th>
                <th>Name</th>
                <th>
                   Date
                </th>
                <th>
                    From
                </th>
                <th>
                    To
                </th>
                <th>
                    Days
                </th>
                <th>
                    Type
                </th>
                <th>
                    Status
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody id="table-body">
            @foreach (var item in Model.leaveModel) {
                <tr>
                    <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">
                        @item.leaveID
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                    </td>
                    <td>
                        @item.employmentModel.personModel.personFullName
                    </td>
                    <td>
                            @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                    </td>
                    <td>
                            @item.leaveStartDate.ToString("MMM dd, yyyy")
                    </td>
                    <td>
                            @item.leaveEndDate.ToString("MMM dd, yyyy")
                    </td>
                    <td>
                            @Html.DisplayFor(modelItem => item.leaveDays)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                    </td>
                        @if(@item.leaveStatus == Models.leaveStatus.Approved)
                        {
                            <td>
                                <p class="border-success p-1">@Html.DisplayFor(modelItem => item.leaveStatus)</p>
                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.DisplayFor(modelItem => item.leaveStatus)
                            </td>
                        }
                
                        <td class="d-flex flex-grow-1">
                        @if(User.IsInRole("MIE\\PMS_HRCLERK"))
                        {

                            <button class="btn btn-success post-button" data-id="@item.leaveID">Post</button>

                        }
                   
                
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div id="groupDepView" class="show" data-bs-parent="#parentDiv">
        <table class="table table-striped table-hover">

            <tbody id="departmentsAccordion">
                @{
                    int index = 0;
                }
                @foreach (var dep in Model.GroupedDepLeaves)
                {
                    var collapseId = $"collapse{index}";
                    <tr class="">
                        <td colspan="6">
                            <h4 class="fw-bold"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                style="cursor:pointer;">
                                @dep.DepartmentName : @dep.Count
                            </h4>

                        </td>

                    </tr>

                    <tr>
                        <td colspan="6" class="p-0">
                            <div id="@collapseId" class="accordion-collapse collapse"
                                 data-bs-parent="#departmentsAccordion">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-dark text-white">
                                        <tr>
                                            <th>Leave No</th>
                                            <th>
                                                Employee ID
                                            </th>
                                            <th>Name</th>
                                            <th>
                                                Date
                                            </th>
                                            <th>
                                                From
                                            </th>
                                            <th>
                                                To
                                            </th>
                                            <th>
                                                Days
                                            </th>
                                            <th>
                                                Type
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in dep.Records)
                                        {
                                            <tr>
                                                <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                                    @item.leaveID
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                                                </td>
                                                <td>
                                                    @item.employmentModel.personModel.personFullName
                                                </td>
                                                <td>
                                                    @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveStartDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveEndDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveDays)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                                                </td>
                                                @if (@item.leaveStatus == Models.leaveStatus.Approved)
                                                {
                                                    <td>
                                                        <p class="border-success p-1">@Html.DisplayFor(modelItem => item.leaveStatus)</p>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.leaveStatus)
                                                    </td>
                                                }

                                                <td class="d-flex flex-grow-1">
                                                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                    {

                                                        <button class="btn btn-success post-button" data-id="@item.leaveID">Post</button>

                                                    }


                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    index++;

                }
            </tbody>
        </table>
    </div>
    <div id="groupTypeView" class="show" data-bs-parent="#parentDiv">
        <table class="table table-striped table-hover">

            <tbody id="typesAccordion">
                @{
                    int index1 = 0;
                }
                @foreach (var dep in Model.GroupedTypeLeaves)
                {
                    var collapseId = $"leaveType{index1}";
                    <tr class="">
                        <td colspan="6">
                            <h4 class="fw-bold"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                style="cursor:pointer;">
                                @dep.DepartmentName : @dep.Count
                            </h4>

                        </td>

                    </tr>

                    <tr>
                        <td colspan="6" class="p-0">
                            <div id="@collapseId" class="accordion-collapse collapse"
                                 data-bs-parent="#typesAccordion">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-dark text-white">
                                        <tr>
                                            <th>Leave No</th>
                                            <th>
                                                Employee ID
                                            </th>
                                            <th>Name</th>
                                            <th>
                                                Date
                                            </th>
                                            <th>
                                                From
                                            </th>
                                            <th>
                                                To
                                            </th>
                                            <th>
                                                Days
                                            </th>
                                            <th>
                                                Type
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in dep.Records)
                                        {
                                            <tr>
                                                <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                                    @item.leaveID
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                                                </td>
                                                <td>
                                                    @item.employmentModel.personModel.personFullName
                                                </td>
                                                <td>
                                                    @item.leaveReaquestDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveStartDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @item.leaveEndDate.ToString("MMM dd, yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveDays)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
                                                </td>
                                                @if (@item.leaveStatus == Models.leaveStatus.Approved)
                                                {
                                                    <td>
                                                        <p class="border-success p-1">@Html.DisplayFor(modelItem => item.leaveStatus)</p>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.leaveStatus)
                                                    </td>
                                                }

                                                <td class="d-flex flex-grow-1">
                                                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                    {

                                                        <button class="btn btn-success post-button" data-id="@item.leaveID">Post</button>

                                                    }


                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    index1++;

                }
            </tbody>
        </table>
    </div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('.post-button').click(function (e) {
            e.preventDefault();

            var leaveId = $(this).data('id');
            var button = $(this);
            var token = $('input[name="__RequestVerificationToken"]').val(); // get CSRF token

            $.ajax({
                url: '@Url.Page("Index", "Approve")', // your Razor Page & handler
                type: 'POST',
                data: {
                    leaveId: leaveId,
                    __RequestVerificationToken: token
                },
                success: function (response) {
                    if (response.success) {
                        button.prop('disabled', true).text('Posted');
                        alert(response.message);
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert('Error: ' + error);
                }
            });
        });
    });
</script>
