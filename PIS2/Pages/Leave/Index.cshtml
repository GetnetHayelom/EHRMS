@page
@model PIS2.Pages.Leave.IndexModel

@{
    ViewData["Title"] = "Leave and Attendance";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />

<div class="container-fluid print-full-width">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold text-dark mb-0">Leave & Attendance</h1>
            <h5 class="text-secondary fw-bold">Unposted Leaves and Attendance</h5>
            <a asp-page="Create" class="btn btn-primary m-1 d-print-none">Add New Overtime Record</a>
        </div>
        <div class="">
 
            <ul class="nav nav-tabs">
                <li class="nav-item"><h5 class="fw-bold text-light bg-dark p-2 rounded">Pending Requests: @Model.CountUnposted</h5></li>
                <li class="nav-item"><button class="nav-link active d-print-none" data-bs-toggle="tab" data-bs-target="#rawView">List View</button></li>
                <li class="nav-item"><button class="nav-link d-print-none" data-bs-toggle="tab" data-bs-target="#groupDepView">Department View</button></li>
                <li class="nav-item"><button class="nav-link m-1 d-print-none" data-bs-toggle="tab" data-bs-target="#groupTypeView">Types View</button></li>
            </ul>
        </div>
    </div>

    <hr class="border border-secondary" />

    <!-- Parent container -->
    <div id="parentDiv" class="tab-content print-full-width">
        <!-- List View -->
        <div id="rawView" class="tab-pane active" data-bs-parent="#parentDiv">
            <div class="d-flex justify-content-between m-2">
                @await Html.PartialAsync("filter")
                @await Html.PartialAsync("print")
            </div>

            <div class="table-responsive shadow-sm rounded">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Leave No</th>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th class="d-print-none text-center"></th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                        @foreach (var item in Model.leaveModel)
                        {
                            <tr>
                                <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                    <strong>@item.leaveID</strong>
                                </td>
                                <td>@item.employmentModel.givenID</td>
                                <td>@item.employmentModel?.personModel?.personFullName</td>
                                <td>@item.leaveRequestDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.leaveStartDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.leaveEndDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.leaveDays</td>
                                <td>@item.leaveTypeModel.leaveTypeName</td>
                                <td>
                                    @if (item.leaveStatus == Models.leaveStatus.Approved)
                                    {
                                        <span class="badge bg-success">@item.leaveStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.leaveStatus</span>
                                    }
                                </td>
                                <td class="text-center d-print-none">
                                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                    {
                                        <button class="btn btn-success btn-sm post-button" data-id="@item.leaveID">Post</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Department Group View -->
        <div id="groupDepView" class="tab-pane" data-bs-parent="#parentDiv">
            <h4 class="fw-bold mt-3 text-primary">Department Unposted Leave</h4>
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-striped table-hover align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>Department</th>
                            <th>Requests</th>
                            <th>Sum of Days</th>
                        </tr>
                    </thead>
                    <tbody id="departmentsAccordion">
                        @{
                            int index = 1;
                        }
                        @foreach (var dep in Model.GroupedDepLeaves)
                        {
                            var collapseId = $"collapse{index}";
                            <tr class="fw-bold table-active" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                                <td>@index</td>
                                <td>@dep.DepartmentName</td>
                                <td>@dep.Count (@Math.Round((@dep.Count * 100) / @Model.CountUnposted, 2)%)</td>
                                <td>@Math.Round(dep.SumDays, 2)</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="p-0">
                                    <div id="@collapseId" class="accordion-collapse collapse bg-light" data-bs-parent="#departmentsAccordion">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-info text-white">
                                                <tr>
                                                    <th>Leave No</th>
                                                    <th>Employee ID</th>
                                                    <th>Name</th>
                                                    <th>Date</th>
                                                    <th>From</th>
                                                    <th>To</th>
                                                    <th>Days</th>
                                                    <th>Type</th>
                                                    <th>Status</th>
                                                    <th class="d-print-none text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in dep.Records)
                                                {
                                                    <tr>
                                                        <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">@item.leaveID</td>
                                                        <td>@item.employmentModel.givenID</td>
                                                        <td>@item.employmentModel.personModel.personFullName</td>
                                                        <td>@item.leaveRequestDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveStartDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveEndDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveDays</td>
                                                        <td>@item.leaveTypeModel.leaveTypeName</td>
                                                        <td>
                                                            @if (item.leaveStatus == Models.leaveStatus.Approved)
                                                            {
                                                                <span class="badge bg-success">@item.leaveStatus</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">@item.leaveStatus</span>
                                                            }
                                                        </td>
                                                        <td class="text-center d-print-none">
                                                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                            {
                                                                <button class="btn btn-success btn-sm post-button" data-id="@item.leaveID">Post</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Type Group View -->
        <div id="groupTypeView" class="tab-pane" data-bs-parent="#parentDiv">
            <h4 class="fw-bold mt-3 text-primary">Unposted Leave By Type</h4>
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-striped table-hover align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>Leave Type</th>
                            <th>Requests</th>
                            <th>Sum of Days</th>
                        </tr>
                    </thead>
                    <tbody id="typesAccordion">
                        @{
                            int index1 = 1;
                        }
                        @foreach (var dep in Model.GroupedTypeLeaves)
                        {
                            var collapseId = $"leaveType{index1}";
                            <tr class="fw-bold table-active" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                                <td>@index1</td>
                                <td>@dep.DepartmentName</td>
                                <td>@dep.Count (@Math.Round((@dep.Count * 100) / Model.CountUnposted, 2)%)</td>
                                <td>@Math.Round(dep.SumDays, 2)</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="p-0">
                                    <div id="@collapseId" class="accordion-collapse collapse bg-light" data-bs-parent="#typesAccordion">
                                        <table class="table table-hover mb-0">
                                            <thead class="bg-info text-white">
                                                <tr>
                                                    <th>Leave No</th>
                                                    <th>Employee ID</th>
                                                    <th>Name</th>
                                                    <th>Date</th>
                                                    <th>From</th>
                                                    <th>To</th>
                                                    <th>Days</th>
                                                    <th>Type</th>
                                                    <th>Status</th>
                                                    <th class="d-print-none text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in dep.Records)
                                                {
                                                    <tr>
                                                        <td onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;">@item.leaveID</td>
                                                        <td>@item.employmentModel.givenID</td>
                                                        <td>@item.employmentModel.personModel.personFullName</td>
                                                        <td>@item.leaveRequestDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveStartDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveEndDate.ToString("MMM dd, yyyy")</td>
                                                        <td>@item.leaveDays</td>
                                                        <td>@item.leaveTypeModel.leaveTypeName</td>
                                                        <td>
                                                            @if (item.leaveStatus == Models.leaveStatus.Approved)
                                                            {
                                                                <span class="badge bg-success">@item.leaveStatus</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">@item.leaveStatus</span>
                                                            }
                                                        </td>
                                                        <td class="text-center d-print-none">
                                                            @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                                                            {
                                                                <button class="btn btn-success btn-sm post-button" data-id="@item.leaveID">Post</button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            index1++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-3">
        @await Html.PartialAsync("print")
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(function () {
        $('.post-button').click(function (e) {
            e.preventDefault();
            const leaveId = $(this).data('id');
            const token = $('input[name="__RequestVerificationToken"]').val();
            const button = $(this);

            $.ajax({
                url: '@Url.Page("Index", "Approve")',
                type: 'POST',
                data: { leaveId, __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        button.prop('disabled', true).text('Posted');
                        alert(res.message);
                    } else alert("Error: " + res.message);
                },
                error: function (xhr, status, err) {
                    alert('Error: ' + err);
                }
            });
        });
    });
</script>
