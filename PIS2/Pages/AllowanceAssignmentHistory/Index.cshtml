@page
@model PIS2.Pages.AllowanceAssignmentHistory.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentHistoryModel[0].allowanceAssignmentModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentHistoryModel[0].modifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.allowanceAssignmentHistoryModel[0].allowanceAssignmentHistoryStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.allowanceAssignmentHistoryModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.allowanceAssignmentModel.allowanceAssignmentID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.allowanceAssignmentHistoryStatus)
            </td>
            <td>
