@page "{id:int}"
@model PIS2.Pages.Evaluation.DetailsModel
@{
    ViewData["Title"] = "Evaluation Details";
}

<style>
    /* Styling for the screen */
    .eval-container {
        background: #fff;
        padding: 30px;
        border-radius: 8px;
    }

    .print-only {
        display: none;
    }

    /* Calculation formatting */
    .score-box {
        border-left: 4px solid #0d6efd;
        padding-left: 15px;
    }

    /* Print Specific Styles */
    @@media print {
        .no-print {
            display: none !important;
        }

        .print-only {
            display: block !important;
        }

        body {
            background: white !important;
            font-size: 12pt;
        }

        .container-fluid {
            width: 100%;
            padding: 0;
            margin: 0;
        }

        .card {
            border: 1px solid #ddd !important;
            break-inside: avoid;
        }

        .table {
            width: 100% !important;
            border-collapse: collapse;
        }

        .badge {
            border: 1px solid #000;
            color: #000 !important;
        }

        .header-section {
            border-bottom: 2px solid #333 !important;
            margin-bottom: 20px;
        }
    }
</style>
@await Html.PartialAsync("headerSimple", "")
<div class="container py-4">
    @* Action Buttons *@
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <div class="d-print-none d-flex justify-content-end gap-2">
            @if(Model.Evaluation.modifiedBy == User.Identity.Name && Model.Evaluation.evaluationStatus == Enums.evaluationStatus.Pending)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Evaluation.evaluationID" class="btn btn-sm btn-outline-primary" title="Edit">
                    <i class="bi bi-pencil"></i>@L.T("Edit")
                </a>
            }
            <button class="btn btn-primary" onclick="window.print()">
                <i class="bi bi-printer"></i> Print Evaluation
            </button>
        </div>
        
    </div>

    <div class="eval-container shadow-sm border">
        @* Report Header *@
        <div class="header-section pb-3 mb-4 border-bottom">
            <div class="row">
                <div class="col-8">
                    <h2 class="text-uppercase fw-bold">Evaluation Report</h2>
                    <p class="text-muted">Form ID: #@Model.Evaluation.evaluationID</p>
                    <span class="badge @(Model.Evaluation.evaluationStatus == Enums.evaluationStatus.Submitted ? "bg-success" : "bg-warning text-dark")">
                        @Model.Evaluation.evaluationStatus
                    </span>
                </div>
                <div class="col-4 text-end score-box">
                    <div class="small text-muted">FINAL RATING</div>
                    <h1 class="display-5 fw-bold text-primary">@Model.GrandTotalScore.ToString("F2")%</h1>
                    <div class="text-muted small"><span>@Model.GrandWeightScore.ToString("N2")</span> / <span>@Model.GrandWeight.ToString("N2")</span></div>
                    
                </div>
            </div>
        </div>

        @* Employee Information *@
        <div class="row mb-4 bg-light p-3 rounded mx-0">
            <div class="col-md-6 border-end">
                <label class="small text-muted d-block text-uppercase">Employee Name</label>
                <h5 class="fw-bold">@Model.Evaluation.EmploymentModel?.personModel?.personFullName</h5>
                <label class="small text-muted d-block text-uppercase mt-2">Evaluation Period</label>
                <span>@Model.Evaluation.evaluationStartDate.ToString("MM/dd/yyyy") - @Model.Evaluation.evaluationEndDate.ToString("MM/dd/yyyy")</span>
            </div>
            <div class="col-md-6 ps-4">
                <label class="small text-muted d-block text-uppercase">Evaluation Name</label>
                <h5>@Model.Evaluation.evaluationName</h5>
                <label class="small text-muted d-block text-uppercase mt-2">Processed Date</label>
                <span>@Model.Evaluation.modifiedDate.ToString("g")</span>
            </div>
        </div>

        @* Performance Breakdown *@
        @foreach (var type in Model.EvaluationTypes)
        {
            var typeTasks = Model.ExistingTasks.Where(t => t.evaluationTypeID == type.evaluationTypeID).ToList();
            if (!typeTasks.Any()) continue;

            <div class="mb-5">
                <h4 class="fw-bold bg-dark text-white p-2 px-3 rounded">@type.evaluationTypeName (@type.evaluationTypeWeight%)</h4>

                @foreach (var task in typeTasks)
                {
                    <div class="card mb-3 border-secondary-subtle">
                        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-0">
                            <span class="fw-bold text-uppercase">@task.evaluationTaskName</span>
                            <span class="text-muted small">Weight: @task.evaluationTaskWeight.ToString("F1")</span>
                            
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr class="small text-center">
                                        <th class="text-start" style="width: 40%">Sub-Task</th>
                                        <th style="width: 10%">Weight</th>
                                        <th>Time</th>
                                        <th>Resource</th>
                                        <th>Perf.</th>
                                        <th class="bg-light">Average</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    
                                    @foreach (var sub in task.EvaluationSubTasks)
                                    {
                                        var val = Model.ExistingValuations.FirstOrDefault(v => v.evaluationSubTaskID == sub.evaluationSubTaskID);
                                        var rowAvg = val != null ? ((val.timeValuation + val.resourceValuation + val.performanceValuation) / 3).ToString("F2") : "-";

                                        <tr class="text-center">
                                            <td class="text-start">@sub.evaluationSubTaskName</td>
                                            <td>@sub.evaluationSubTaskWeight.ToString("F1")</td>
                                            <td>@(val?.timeValuation.ToString("F1") ?? "0.0")</td>
                                            <td>@(val?.resourceValuation.ToString("F1") ?? "0.0")</td>
                                            <td>@(val?.performanceValuation.ToString("F1") ?? "0.0")</td>
                                            <td class="fw-bold">@rowAvg</td>
                                        </tr>
                                        
                                    }
                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }

        @* Signature Area (Visible on Print) *@
        <div class="mt-5 pt-5 print-only d-print-flex d-none justify-content-around print-full-width">
            <div class="col-5 text-center">
                <div class="border-top border-dark mx-auto w-75 pt-2">Employee Signature</div>
            </div>
            <div class="col-5 text-center">
                <div class="border-top border-dark mx-auto w-75 pt-2">Evaluator Signature</div>
            </div>
        </div>
    </div>
</div>