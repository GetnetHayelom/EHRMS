@page
@model PIS2.Pages.Management.IndexModel
@{
    ViewData["Title"] = "Management Dashboard";
    var successMessage = TempData["SuccessMessage"] as string ?? string.Empty;
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end flex-wrap">
    <div>
        <h2 class="fw-bold text-primary mb-2 d-flex align-items-center">
            <i class="bi bi-speedometer2 me-2"></i>
            <span class="d-print-none text-dark mb-0">Management Dashboard</span>
            <span class="d-none d-print-block mb-0">Management Report</span>

        </h2>
        <p class="text-muted small mb-0">Real-time management dashboard</p>
    </div>

    <ul class="nav nav-pills shadow-sm rounded-3 d-print-none mb-2">
        <li class="nav-item">
            <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#dashboardView">
                <i class="bi bi-grid-1x2 me-1"></i> Dashboard
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#annualLeaveView">
                <i class="bi bi-calendar-week me-1"></i> Annual Leave
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#employmentStats">
                <i class="bi bi-bar-chart-line me-1"></i> Employment Stats
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#terminationStats">
                <i class="bi bi-person-x me-1"></i> Terminations
            </button>
        </li>
        <li class="nav-item">
            @await Html.PartialAsync("print")
        </li>
    </ul>
</div>

<div class="tab-content mt-3">
    <!-- DASHBOARD TAB -->
    <div class="tab-pane fade show active" id="dashboardView">
        <!-- SUMMARY SECTION -->
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-primary text-white fw-bold">
                        <i class="bi bi-building me-2"></i> Companies / Industries
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-success fw-semibold">Active Companies</span>
                            <span class="badge bg-success fs-5">@Model.ActiveCompanies</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-danger fw-semibold">Closed Companies</span>
                            <span class="badge bg-danger fs-6">@Model.OldCompanies</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-secondary text-white fw-bold">
                        <i class="bi bi-diagram-3 me-2"></i> Departments
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-success fw-semibold">Active Departments</span>
                            <span class="badge bg-success fs-5">@Model.ActiveDepartments</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-danger fw-semibold">Closed Departments</span>
                            <span class="badge bg-danger fs-6">@Model.OldDepartments</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-info text-white fw-bold">
                        <i class="bi bi-people-fill me-2"></i> Employment
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-success fw-semibold">Active Employees</span>
                            <span class="badge bg-success fs-5">@Model.ActiveEmployments</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-warning fw-semibold">Employees On Leave</span>
                            <span class="badge bg-warning text-dark fs-6">@Model.leaveEmployments</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-danger fw-semibold">Ex-Employees</span>
                            <span class="badge bg-danger fs-6">@Model.exEmployments</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-info fw-semibold">Total Created</span>
                            <span class="badge bg-info fs-6">@Model.Employments.Count()</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-dark text-white fw-bold">
                        <i class="bi bi-briefcase me-2"></i> Employment Types
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.EmploymentTypes)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-success fw-semibold">@item.zName</span>
                                <span class="badge bg-success fs-6">@item.zCount</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!--METRICS TREND-->
        
        <div class="d-flex justify-content-between align-items-center mt-4 bg-warning p-2">
            <div>
                <h4 class="fw-bold mb-0 text-dark">Trend Analytics</h4>
                <p class="text-muted small mb-0">Real-time summary and period comparison</p>
            </div>
            <div class="form-group form-check m-2">
                <label class="form-check-label">
                    Standard Period<input type="checkbox" id="periodType" class="form-check-input" checked/>
                </label>
            </div>
            <div class="d-flex align-items-center bg-white p-2 rounded shadow-sm border">
                
                <i class="bi bi-calendar3 me-2 text-primary"></i>
                <select id="periodFilter" class="form-select form-select-sm border-0 shadow-none" style="width: 160px; cursor: pointer;">
                    <option value="Monthly">Monthly</option>
                    <option value="Quarterly">Quarterly</option>
                    <option value="SemiAnnually">Semi-Annually</option>
                    <option value="Annually" selected>Annually</option>
                </select>
            </div>
        </div>
        <div id="summaryContainer" class="mt-3">
            @await Html.PartialAsync("_HRSummaryPartial", Model.MetricData)
        </div>

        <!-- PAYABLE SUMMARY -->
        <div class="card shadow-sm mt-3 p-2">
            <h4 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                <i class="bi bi-cash-stack me-2"></i> Liability Summary
            </h4>

            <div class="d-flex flex-wrap gap-3">
                <div class="flex-fill">
                    <div class="card shadow-sm border-start border-primary border-3 p-3 clickable" onclick="location.href='@Url.Page("/Report/JobPlacementReport")'">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="small mb-1 text-muted">Salary</p>
                                <h5 class="fw-bold text-dark mb-0">
                                    $@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Salary)), 2).ToString("N0")
                                </h5>
                            </div>
                            <i class="bi bi-cash-stack fs-2 text-primary"></i>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm p-3 border-start border-warning border-3 clickable" onclick="location.href='@Url.Page("/Report/AllowanceAssignmentReport")'">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="small mb-1 text-muted">Allowance</p>
                                <h5 class="fw-bold text-dark mb-0">
                                    $@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Allowance)), 2).ToString("N0")
                                </h5>
                            </div>
                            <i class="bi bi-wallet2 fs-2 text-warning"></i>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm p-3 border-start border-info border-3 clickable" onclick="location.href='@Url.Page("/Report/LeaveReport")'">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="small mb-1 text-muted">Anual Leave</p>
                                <h5 class="fw-bold text-dark mb-0">
                                    @Math.Round(Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave), 2).ToString("N0")
                                </h5>
                            </div>
                            <i class="bi bi-clock-history fs-2 text-info"></i>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm p-3 border-start border-danger border-3 clickable" onclick="location.href='@Url.Page("/Report/CostAnalysisReport")'">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="small mb-1 text-muted">Severance Pay</p>
                                <h5 class="fw-bold text-dark mb-0">
                                    $@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.SeverancePayable)), 2).ToString("N0")
                                </h5>
                            </div>
                            <i class="bi bi-cash fs-2 text-danger"></i>
                        </div>
                    </div>
                </div>

                <div class="flex-fill">
                    <div class="card shadow-sm p-3 border-start border-success border-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="small mb-1 text-success">Total</p>
                                <h4 class="fw-bold mb-0">
                                    $@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Salary + c.Allowance + c.Overtime + c.SeverancePayable + c.payableLeaves) + Model.AnnualLeaveSummaries.Sum(als => als.PayableLeave)), 2).ToString("N0")
                                </h4>
                            </div>
                            <i class="bi bi-clipboard-data fs-2 text-success"></i>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- CHART SECTION -->
        <div class="mt-5">
            <h4 class="fw-bold text-secondary border-bottom pb-2 mb-3">
                <i class="bi bi-pie-chart-fill me-2"></i> Employee Distribution & Metrics
            </h4>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card shadow-sm p-3">
                        <canvas id="educationLevelPieChart" height="300"></canvas>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm p-3">
                        <canvas id="workLocChart" height="300"></canvas>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm p-3">
                        <canvas id="jobCategoryChart" height="300"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="card shadow-sm p-3">
                    <canvas id="jobClassChart" height="300"></canvas>
                </div>
            </div>
        </div>
        

        <!-- COMPANY CARDS -->
        <div class="mt-5">
            <h4 class="fw-bold text-secondary border-bottom pb-2 mb-4 text-center">
                <i class="bi bi-buildings me-2"></i> Company Overview
            </h4>

            <div class="row g-4">
                @foreach (var item in Model.CompanySummaries.OrderByDescending(c => c.Employees))
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="card shadow-sm h-100 border-0 hover-shadow">
                            <div class="card-body">
                                <h5 class="fw-bold text-primary"><a href="/Management/CompanyP?id=@item.CompanyID">@item.CompanyName</a></h5>
                                <h6 class="text-muted mb-3">Manager: @(item.Manager ?? "N\\A")</h6>
                                <div class="d-flex justify-content-between text-secondary border-top pt-2">
                                    <span>Employees:</span>
                                    <strong>@item.Employees.ToString("N0")</strong>
                                </div>
                                <div class="d-flex justify-content-between text-secondary border-top pt-2">
                                    <span>Departments:</span>
                                    <strong>@item.Departments</strong>
                                </div>
                                <div class="text-end mt-3">
                                    <h5 class="fw-bold text-success">$@item.Salary.ToString("N0")</h5>
                                    <small>Total Monthly Payroll</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!--ANNUAL LEAVE SUMMARY-->
    <div class="tab-pane fade" id="annualLeaveView">
        <h4 class="fw-bold">Annual Leave Summary</h4>
        @await Html.PartialAsync("_AnnualLeaveSummary", Model.AnnualLeaveSummaries)
        
    </div>

    <!--EMPLOYMENT STATS TABLE-->
    <div class="tab-pane fade" id="employmentStats">
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold m-0">Employment Statistics & Trends</h4>
            <span class="badge bg-primary">Yearly Overview</span>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow-sm border-0 p-3" style="height:400px">
                    <canvas id="employmentHireChart" class="w-100"></canvas>
                </div>
            </div>
        </div>


        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">#</th>
                        <th>Year</th>
                        <th class="text-end">New Hires</th>
                        <th class="text-end">Terminations</th>
                        <th class="text-end">Active Staff</th>
                        <th class="text-center">Hire Rate</th>
                        <th class="text-center">Turnover</th>
                        <th class="text-center">Retention</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmploymentYearlyStats == null || !Model.EmploymentYearlyStats.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                No employment records found.
                            </td>
                        </tr>
                    }else{
                        
                        int indexStats = 1;
                        
                        foreach (var item in Model.EmploymentYearlyStats)
                        {
                            <tr>
                                <td class="text-center text-muted">@(indexStats++)</td>
                                <td class="fw-bold">@item?.Year</td>
                                <td class="text-end">@((item?.NewEmployees ?? 0).ToString("N0"))</td>
                                <td class="text-end text-danger">@((item?.TerminatedEmployees ?? 0).ToString("N0"))</td>
                                <td class="text-end fw-semibold">@((item?.ActiveEmployees ?? 0).ToString("N0"))</td>
                                <td class="text-center">@((item?.HireRatePercent ?? 0).ToString("N1"))%</td>
                                <td class="text-center">@((item?.TerminationRatePercent ?? 0).ToString("N1"))%</td>
                                <td class="text-center">
                                    <span class="badge @(100 - item?.TerminationRatePercent > 90 ? "bg-success" : "bg-info")">
                                        @((100 - (item?.TerminationRatePercent ?? 0)).ToString("N1"))%
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    
                </tbody>
                <tfoot class="table-light fw-bold border-top-2">
                    @if (Model.EmploymentYearlyStats != null && Model.EmploymentYearlyStats.Any())
                    { 
                        <tr>
                            <td colspan="2" class="text-center">AVERAGES / TOTALS</td>
                            <td class="text-end">@Model.EmploymentYearlyStats?.Sum(e => e.NewEmployees ?? 0).ToString("N0")</td>
                            <td class="text-end">@Model.EmploymentYearlyStats?.Sum(e => e.TerminatedEmployees ?? 0).ToString("N0")</td>
                            <td class="text-end">---</td>
                            <td class="text-center">@((Model.EmploymentYearlyStats?.Average(e => e.HireRatePercent ?? 0))?.ToString("N1"))%</td>
                            <td class="text-center">@((Model.EmploymentYearlyStats?.Average(e => e.TerminationRatePercent ?? 0))?.ToString("N1"))%</td>
                            <td class="text-center">@((100 - Model.EmploymentYearlyStats?.Average(e => e.TerminationRatePercent ?? 0))?.ToString("N1"))%</td>
                        </tr>
                    }
                    
                </tfoot>
            </table>
        </div>
    </div>

    <!--TERMINATION STATS-->
    <div class="tab-pane fade" id="terminationStats">
        <h4 class="fw-bold">Termination Stats (Active Companies)</h4>
        <!--TERMINATION GRAPH-->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Termination Analysis by Company</h5>
                <div style="height: 350px;">
                    <canvas id="companyTerminationChart"></canvas>
                </div>
            </div>
        </div>
        <!--DETAIL TABLE-->
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>Company</th>
                    <th>Total Employee</th>
                    <th>Terminated Employee</th>
                    <th>Active Employee</th>                   
                    <th>Turn Over Rate</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int indexDepStats = 1;
                }
                @foreach (var item in Model.DepartmentEmploymentStats?.Where(d => d.TotalEmployees >0))
                {
                    <tr class="align-middle">
                        <td>@indexDepStats</td>
                        <td>
                            <span class="fw-bold text-dark">@item?.companyName</span><br />
                        </td>
                        <td class="text-end">@item?.TotalEmployees?.ToString("N0")</td>
                        <td class="text-end text-danger">@item?.TerminatedEmployees?.ToString("N0")</td>
                        <td class="text-end fw-bold">@item?.ActiveEmployees?.ToString("N0")</td>
                        <td class="text-center">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-danger" style="width: @item?.TerminationRatePercent%"></div>
                            </div>
                            <small>@item?.TerminationRatePercent?.ToString("F1")%</small>
                        </td>
                    </tr>
                    
                    indexDepStats++;
                }

            </tbody>
            <tfoot class="fw-bold bg-secondary">
                @if (Model.DepartmentEmploymentStats.Any()) 
                {
                    <tr>

                        <td colspan="2">Summary</td>
                        <td>
                            @Model.DepartmentEmploymentStats?.Sum(eys => eys.TotalEmployees ??0).ToString("N2") (Total)
                            @((Model.DepartmentEmploymentStats?.Sum(eys => eys.TotalEmployees) / Model.DepartmentEmploymentStats?.Count())) (Avg)
                        </td>
                        <td>
                            @Model.DepartmentEmploymentStats?.Sum(eys => eys.TerminatedEmployees ?? 0).ToString("N2") (Total)
                            @((Model.DepartmentEmploymentStats?.Sum(eys => eys.TerminatedEmployees) / Model.DepartmentEmploymentStats?.Count())) (Avg)
                        </td>
                        <td>
                            @Model.DepartmentEmploymentStats?.Sum(eys => eys.ActiveEmployees ?? 0).ToString("N2") (Total)
                            @((Model.DepartmentEmploymentStats?.Sum(eys => eys.ActiveEmployees) / Model.DepartmentEmploymentStats?.Count())) (Avg)
                        </td>
                        <td>@((Model.DepartmentEmploymentStats?.Sum(eys => eys.TerminationRatePercent ?? 0) / Model.DepartmentEmploymentStats?.Count())?.ToString("N2"))% (Avg)</td>
                    </tr> 
                }
                
            </tfoot>
        </table>

    </div>

</div>
<div class="d-flex justify-content-end">@await Html.PartialAsync("print")</div>



@section Scripts {
    <style>
        .clickable:hover {
            transform: scale(1.03);
            transition: all 0.2s ease-in-out;
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
        }

        .hover-shadow:hover {
            transform: translateY(-3px);
            transition: all 0.25s ease-in-out;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }

        table thead {
            background: linear-gradient(90deg, #0d6efd, #6610f2);
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(90deg, #0d6efd, #20c997);
            color: white !important;
        }
    </style>
    <style>
        /* --- General Aesthetic Upgrades --- */
        canvas {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            padding: 15px;
            transition: transform 0.2s ease, box-shadow 0.3s ease;
        }

            canvas:hover {
                transform: scale(1.01);
                box-shadow: 0 6px 18px rgba(0,0,0,0.15);
            }

        /* Chart containers for layout */
        .chart-card {
            background: #f9fafb;
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 25px;
            transition: all 0.3s ease;
            border: 1px solid #e6e9ef;
        }

            .chart-card:hover {
                background: #ffffff;
                box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            }

        /* Titles and Nav */
        .nav-pills .nav-link.active {
            background: linear-gradient(90deg, #0d6efd, #20c997);
            color: white !important;
            box-shadow: 0 3px 10px rgba(13, 110, 253, 0.4);
        }

        table thead {
            background: linear-gradient(90deg, #0d6efd, #6610f2);
            color: white;
        }

        .clickable:hover, .hover-shadow:hover {
            transform: translateY(-3px) scale(1.03);
            transition: all 0.25s ease-in-out;
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }
    </style>

    <script>
        // Global Chart.js defaults for a consistent modern style
        Chart.defaults.font.family = "'Inter', 'Helvetica Neue', 'Arial', sans-serif";
        Chart.defaults.font.size = 13;
        Chart.defaults.color = "#333";
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.legend.labels.boxWidth = 8;
        Chart.defaults.plugins.title.font.weight = 'bold';
        Chart.defaults.plugins.title.font.size = 18;
        Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(0, 0, 0, 0.8)';
        Chart.defaults.plugins.tooltip.titleFont = { weight: 'bold', size: 14 };
        Chart.defaults.plugins.tooltip.bodyFont = { size: 13 };
        Chart.defaults.plugins.tooltip.cornerRadius = 6;
        Chart.defaults.plugins.tooltip.padding = 12;
    </script>

    <!--EDUCATION LEVEL CHART SCRIPT-->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Data from Razor
            var educationLevelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EduLevelSummary));
            var Total = @(Model.EmploymentHireRate?.Sum(el => el.zCount) ?? 0);

            // Safety check
            if (!educationLevelData || educationLevelData.length === 0) {
                console.error("No data found for Chart");
                return;
            }

            // Labels (with percentage)
            var educationLevelLabels = educationLevelData.map(function (item) {
                var percentage = Total > 0 ? Math.round((item.zCount / Total) * 100) : 0;
                return percentage + '% ' + item.zName;
            });

            // Values
            var educationLevelCounts = educationLevelData.map(function (item) {
                return item.zCount;
            });

            // Get canvas safely
            var canvas = document.getElementById("educationLevelPieChart");
            if (!canvas) return;

            var ctx = canvas.getContext('2d');

            // Create chart (same look & behavior)
            var educationLevelChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: educationLevelLabels,
                    datasets: [{
                        data: educationLevelCounts,
                        backgroundColor: [
                            '#3B82F6', '#60A5FA', '#34D399', '#10B981', '#FBBF24',
                            '#F59E0B', '#EF4444', '#EC4899', '#8B5CF6', '#6366F1',
                            '#14B8A6', '#0EA5E9', '#F472B6', '#84CC16', '#EAB308'
                        ],
                        borderColor: '#fff',
                        borderWidth: 2,
                        hoverOffset: 15,
                        hoverBorderColor: '#333'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        title: {
                            display: true,
                            text: "Education Levels",
                            color: "#111827",
                            padding: { top: 10, bottom: 25 }
                        },
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: "#374151",
                                padding: 15,
                                font: { size: 13, weight: '500' },
                                generateLabels: function (chart) {
                                    const data = chart.data;
                                    return data.labels.map(function (label, i) {
                                        const meta = chart.getDatasetMeta(0);
                                        const style = meta.controller.getStyle(i);
                                        return {
                                            text: label,
                                            fillStyle: style.backgroundColor,
                                            strokeStyle: style.borderColor,
                                            lineWidth: 2,
                                            index: i
                                        };
                                    });
                                }
                            },
                            onClick: (e, legendItem, legend) => {
                                const index = legendItem.index;
                                const chart = legend.chart;
                                chart.toggleDataVisibility(index);
                                chart.update();
                            }
                        },
                        tooltip: {
                            usePointStyle: true,
                            callbacks: {
                                label: (context) => {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    animation: {
                        duration: 1200,
                        easing: 'easeOutQuart'
                    }
                }
            });

        });
    </script>

