    <script>
        $(document).ready(function () {
            $('#periodFilter').on('change', reMetric);
            $('#periodType').on('change', reMetric);
            reMetric();
        });

        function reMetric()
        {
            const selectedPeriod = $('#periodFilter').val();
            const periodType = $('#periodType').is(':checked')? true : false;
            // Show a simple loader while fetching
            $('#summaryContainer').css('opacity', '0.5');

            $.ajax({
                url: '/api/dashboard', // Match your controller/action path
                data: { period: selectedPeriod, isOfficial: periodType },
                type: 'GET',
                success: function (result) {
                    $('#summaryContainer').html(result).css('opacity', '1');

                },
                error: function () {
                    alert("Error loading dashboard data.");
                    $('#summaryContainer').css('opacity', '1');
                }
            });
        }
    </script>
