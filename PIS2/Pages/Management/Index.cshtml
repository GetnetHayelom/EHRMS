@page
@model PIS2.Pages.Management.IndexModel
@{
    ViewData["Title"] = "Welcome";
    var successMessage = TempData["SuccessMessage"] as string ?? string.Empty;
}
<h1 class="d-flex justify-content-center">
    <b class="d-print-none">Management Dashboard</b>
    <b class="d-none d-print-block">Management Report</b>
</h1>

<div class="d-flex w-100">
    <div class="col-2 bg-dark text-white d-none d-print-none">
        <div>
        <img />
        </div>
        <div class="d-flex flex-column mt-6">
            <a role="button" class="text-white nav-link p-3" asp-page="/Company/Index" asp-asp-area="Management">Companies</a>
            <a role="button" class="text-white nav-link p-3" asp-page="/Department/Index" asp-asp-area="Management">Departments</a>
            <a role="button" class="text-white nav-link p-3" asp-page="/Employment/Index" asp-asp-area="Management">Employments</a>
            <a role="button" class="text-white nav-link p-3" asp-page="/Job/Index" asp-asp-area="Management">Jobs</a>
            <a role="button" class="text-white nav-link p-3" asp-page="/Worksite/Index" asp-asp-area="Management">Work Loactions</a>
        </div>
    </div>
    <div class="col d-flex flex-column">
    <hr />
    <!-- Summary Points -->
        <div class="d-flex">
            <div class="p-2 flex-grow-1 m-2">

                <div class="w-100 shadow">
                    <h3 class="bg-dark text-white p-2"><b>Companies\Industies</b></h3>
                    <div class="d-flex">
                        <h5 class="flex-grow-1 border border-success border-1 text-success p-1">Active Companies</h5>
                        <h2 class="bg-success text-white rounded-end p-1">@Model.ActiveCompanies</h2>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-danger border-1 text-danger p-1">Old Companies</h6>
                        <h4 class="bg-danger text-white rounded-end p-1">@Model.OldCompanies</h4>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-info border-1 text-info p-1">Companies Upto Now</h6>
                        <h4 class="bg-info text-white rounded-end p-1">@Model.Companies.Count()</h4>
                    </div>
                </div>
            </div>
            <div class="p-2 flex-grow-1 m-2 shadow">
                <div class="w-100">
                    <h3 class="bg-dark text-white p-2"><b>Departments</b></h3>
                    <div class="d-flex">
                        <h5 class="flex-grow-1 border border-success border-1 text-success p-1">Active Departments</h5>
                        <h2 class="bg-success text-white rounded-end p-1">@Model.ActiveDepartments</h2>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-danger border-1 text-danger p-1">Old Departments</h6>
                        <h4 class="bg-danger text-white rounded-end p-1">@Model.OldDepartments</h4>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-info border-1 text-info p-1">Departments Upto Now</h6>
                        <h4 class="bg-info text-white rounded-end p-1">@Model.Departments.Count()</h4>
                    </div>
                </div>
            </div>
            <div class="p-2 flex-grow-1 m-2 shadow">
                <div class="w-100">
                    <h3 class="bg-dark text-white p-2"><b>Employment</b></h3>
                    <div class="d-flex">
                        <h5 class="flex-grow-1 border border-success border-1 text-success p-1">Active Employees</h5>
                        <h2 class="bg-success text-white rounded-end p-1">@Model.ActiveEmployments</h2>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-warning border-1 text-warning p-1">Employees On Leave</h6>
                        <h4 class="bg-warning text-white rounded-end p-1">@Model.leaveEmployments</h4>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-danger border-1 text-danger p-1">Former Employees</h6>
                        <h4 class="bg-danger text-white rounded-end p-1">@Model.exEmployments</h4>
                    </div>
                    <div class="d-flex">
                        <h6 class="flex-grow-1 border border-info border-1 text-info p-1">Employments Upto Now</h6>
                        <h4 class="bg-info text-white rounded-end p-1">@Model.Employments.Count()</h4>
                    </div>
                </div>
            </div>
            <!--Employment Types-->
            <div class="p-2 flex-grow-1 m-2 shadow">
                <div class="w-100">
                    <h3 class="bg-dark text-white p-2"><b>Employment Types</b></h3>
                    @foreach (var item in Model.EmploymentTypes)
                    {
                        <div class="d-flex">
                            <h5 class="flex-grow-1 border border-success border-1 text-success p-1">@item.zName</h5>
                            <h2 class="bg-success text-white rounded-end p-1">@item.zCount</h2>
                        </div>
                
                    }
                    
                </div>
            </div>
        </div>
        <hr />
        <div class="">
            <h3 class="bg-dark text-white p-2">Current Payable</h3><hr />
            <!--Payables summary-->
            <div class="d-flex flex-grow-1 m-2 justify-content-between">
                
                <div class="card m-2 p-4 shadow flex-grow-1" onclick="location.href='@Url.Page("/Report/JobPlacementReport")'" style="cursor:pointer;">
                    <p class="small mb-1">Salary</p>
                    <h5 class="fw-bold">$@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Salary)), 2).ToString("N0")</h5>
                </div>
                
                <div class="card m-2 p-4 shadow flex-grow-1" onclick="location.href='@Url.Page("/Report/AllowanceAssignmentReport")'" style="cursor:pointer;">
                    <p class="small mb-1">Allowance</p>
                    <h5 class="fw-bold">$@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Allowance)), 2).ToString("N0")</h5>
                </div>
                <div class="card m-2 p-4 shadow flex-grow-1" onclick="location.href='@Url.Page("/Report/OvertimeRecordReport")'" style="cursor:pointer;">
                    <p class="small mb-1">Overtime</p>
                    <h5 class="fw-bold">$@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Overtime)), 2).ToString("N0")</h5>
                </div>
                <div class="card m-2 p-4 shadow flex-grow-1" onclick="location.href='@Url.Page("/Report/PayableLeaveReport")'" style="cursor:pointer;">
                    <p class="small mb-1">Payable Leave</p>
                    <h5 class="fw-bold">$@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.payableLeaves)), 2).ToString("N0")</h5>
                </div>
                <div class="card m-2 p-4 shadow flex-grow-1">
                    <p class="small mb-1">Total</p>
                    <h4 class="fw-bold">$@Math.Round((decimal)(Model.CompanySummaries.Sum(c => c.Salary + c.Allowance + c.Overtime)), 2).ToString("N0")</h4>
                </div>

           </div>
            
        </div>
       <hr />
        <!-- Charts Container1-->
        <div class="container">
            <h3 class="bg-dark text-white p-2">Employe Distribution & Metrics</h3>
            <div class="d-flex justify-content-between flex-grow-1 p-2">
                <!-- Education Levels -->
                <div class="card col p-2 m-2">
                    <canvas id="educationLevelPieChart" height="300">
                    </canvas>
                </div>
                <!-- Work Location -->
                <div class="card col p-2 m-2">
                    <canvas id="workLocChart" height="300">
                    </canvas>
                </div>
                <!-- Job Category -->
                <div class="card col p-2 m-2">
                    <canvas id="jobCategoryChart"  height="300">
                    </canvas>
                </div>
            </div>
        </div>
        <!-- Charts Container1-->
        <hr />
        <!--Charts Container2 -->
        <div class="row d-flex  justify-content-center">
            <!-- Employment Trends --> 
            <div class="p-2 m-2">
                <canvas id="employmentHireChart" class="w-100">
                </canvas>
            </div>
        </div>
        <!--COMPANY CARDS-->
        <div class="container py-5">
            <a class="text-center mb-4 text-decoration-none">
                <h2 class="bg-dark text-white p-2"><b asp-page="./Company/Index" asp-area="Management" role="button">Companies</b></h2>
            </a>
            <div class="row g-4">
                @foreach (var item in Model.CompanySummaries)
                {
                    
                    <div class="col-md-3 col-lg-3 ">
                        <div class="card h-100 shadow">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start">
                                    <a asp-page="Companyp" asp-route-id="@item.CompanyID" asp-area="Management" role="button" class="text-decoration-none">
                                        <h5 class="card-title fw-bold text-dark">@item.CompanyName</h5>
                                        <h6 class="card-subtitle mb-3 opacity-75 text-dark">Manager: @(item.Manager ?? "N\\A")</h6>
                                    </a>

                                </div>
                                <div class="d-flex justify-content-between border-top border-opacity-25 pt-3 text-primary">
                                    <div>
                                        <p class="small mb-1">Employees</p>
                                        <h3 class="fw-bold">@item.Employees.ToString("N0")</h3>
                                    </div>
                                    <div>
                                        <p class="small mb-1">Departments</p>
                                        <h3 class="fw-bold">@item.Departments</h3>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between border-top border-opacity-25 pt-3">
                                    <div class="text-warning ">
                                        <p class="small mb-1">Acc. Leaves</p>
                                        <h5 class="fw-bold">@Math.Round((decimal) item.payableLeaves, 2).ToString("N0")</h5>
                                    </div>
                                    <div class="text-danger">
                                        <p class="small mb-1">Leave Cost</p>
                                        <h5 class="fw-bold ">$@Math.Round((decimal)item.payableLeaves, 2).ToString("N0")</h5>
                                    </div>
                                </div>
                                <div class="mt-4 text-success">
                                    <h4 class="display-8 fw-bold text-end">$@(item.Salary.ToString("N0"))</h4>
                                    <p class="small text-end mb-0">Total Monthly Payroll</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="d-flex justify-content-end">@await Html.PartialAsync("print")</div>

<table class="d-none">
<thead>
<tr><th>Year</th><th>Number</th></tr></thead>
<tbody>
        @foreach (var item in Model.ActiveEmployeeRate)
        {
            <tr> <td>@item.zYear</td>
                <td>@item.zCount</td>
            </tr>}
        </tbody>
    </table>
<!--EDUCATION LEVEL CHART SCRIPT-->
<script>
    var educationLevelData = @Html.Raw(Json.Serialize(Model.EduLevelSummary));
    var Total = @Model.EduLevelSummary.Select(el => el.zCount).Sum();
    var educationLevelLabels = educationLevelData.map(function (item) {
        return Math.round((item.zCount/Total)*100) + '% ' + item.zName;
    });
    var educationLevelCategories = educationLevelData.map(item => item.educationLevelCategories);
    var educationLevelCounts = educationLevelData.map(function (item) {
        return item.zCount;
    });

    var ctx = document.getElementById('educationLevelPieChart').getContext('2d');
    var educationLevelChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: educationLevelLabels,
            datasets: [{
                data: educationLevelCounts,
                backgroundColor: [
                    '#FF6B6B', '#FF8E72', '#FFB74D', '#FFD54F', '#DCE775',
                    '#A3E635', '#4CAF50', '#81C784', '#64B5F6', '#2196F3',
                    '#1565C0', '#9575CD', '#BA68C8', '#F06292', '#EC407A'
                ],
                borderColor: '#fff',
                borderWidth: 2,
                hoverOffset: 15,
                hoverBorderColor: '#333'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '50%', // This makes it a doughnut instead of pie
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 10,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        font: {
                            size: 12,
                            family: "'Helvetica Neue', 'Helvetica', 'Arial', sans-serif"
                        },
                        generateLabels: function (chart) {
                            const data = chart.data;
                            if (data.labels.length && data.datasets.length) {
                                return data.labels.map(function (label, i) {
                                    const meta = chart.getDatasetMeta(0);
                                    const style = meta.controller.getStyle(i);

                                    return {
                                        text: label,
                                        fillStyle: style.backgroundColor,
                                        strokeStyle: style.borderColor,
                                        lineWidth: style.borderWidth,
                                        hidden: !chart.getDataVisibility(i),
                                        index: i
                                    };
                                });
                            }
                            return [];
                        }
                    },
                    onClick: function (e, legendItem, legend) {
                        const index = legendItem.index;
                        const chart = legend.chart;
                        chart.toggleDataVisibility(index);
                        chart.update();
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const label = context.label || '';
                            const value = context.raw || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = Math.round((value / total) * 100);

                            return `${label}: ${value} people (${percentage}%)`;
                        }
                    },
                    displayColors: true,
                    usePointStyle: true,
                    bodyFont: {
                        size: 14
                    },
                    padding: 12
                },
                title: {
                    display: true,
                    text: "Education Level",
                    font: {
                        size: 18,
                        weight: "bold",
                        family: "'Helvetica Neue', 'Helvetica', 'Arial', sans-serif"
                    },
                    
                    padding: {
                        top: 10,
                        bottom: 30
                    },
                    align: 'center'
                }
            },
            animation: {
                animateScale: true,
                animateRotate: true
            }
        }
    });
</script>
<!--EMPLOYMENT RATES SCRIPT-->
<script>
    var ctx = document.getElementById("employmentHireChart").getContext("2d");
    // Get the serialized data from the server
    var hireData = @Html.Raw(Json.Serialize(Model.EmploymentHireRate));
    var terminationData = @Html.Raw(Json.Serialize(Model.TerminationRate));
    var manPowerRate = @Html.Raw(Json.Serialize(Model.ActiveEmployeeRate));
    
    const allYears = [...new Set([...hireData.map(item => item.zYear), ...terminationData.map(item => item.zYear)])].sort();

    // Map hire counts to years, filling missing values with 0
    const counts = allYears.map(year => {
        const found = hireData.find(item => item.zYear === year);
        return found ? found.zCount : 0;
    });

    // Map termination counts to years, filling missing values with 0
    const tcounts = allYears.map(year => {
        const found = terminationData.find(item => item.zYear === year);
        return found ? found.zCount : 0;
    });
    //Man Power Map
    const manPower = manPowerRate.map(item => item.zCount);

    
    new Chart(ctx, {
            type: 'line',
            data: {
                labels: allYears,
                datasets: [{
                    label: 'Hires',
                    data: counts,
                    backgroundColor: 'rgba(63, 81, 181, 0.2)',
                    borderColor: 'rgba(63, 81, 181, 1)',
                    borderWidth: 3,
                    tension: 0.2,
                    pointBackgroundColor: 'rgba(63, 81, 181, 1)',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    yAxisID: 'y'
                },
                {
                    label: 'Terminations',
                    data: tcounts,
                    backgroundColor: 'rgba(229, 57, 53, 0.2)',
                    borderColor: 'rgba(229, 57, 53, 1)',
                    borderWidth: 3,
                    tension: 0.2,
                    pointBackgroundColor: 'rgba(63, 81, 181, 1)',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    yAxisID: 'y'
                },
                {
                    label: 'Active Man-power',
                    data: manPower,
                    backgroundColor: 'rgba(10, 250, 53, 0.2)',
                    borderColor: 'rgba(10, 250, 53, 1)',
                    borderWidth: 3,
                    tension: 0.2,
                    pointBackgroundColor: 'rgba(63, 81, 181, 1)',
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    yAxisID: 'y'
                }
                ]
            },
       
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: 'Employment Trends',
                        font: {
                            size: 18,
                            weight: 'bold'
                        },
                        padding: {
                            top: 10,
                            bottom: 20
                        }
                    },
                    legend: {
                        position: 'top',
                        labels: {
                            boxWidth: 12,
                            padding: 20,
                            font: {
                                size: 12
                            }
                        }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        callbacks: {
                            title: function (context) {
                                return 'Year: ' + context[0].label;
                            },
                            label: function (context) {
                            return context.dataset.label + context.parsed.y.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Year',
                            font: {
                                weight: 'bold'
                            }
                        },
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        title: {
                            display: true,
                            text: 'Amount',
                            font: {
                                weight: 'bold'
                            }
                        },
                        min: Math.max(0, Math.min(...counts) - Math.max(...counts) * 0.1),
                        ticks: {
                            callback: function (value) {
                                return value.toLocaleString();
                            }
                        }
                    }
                },
                interaction: {
                    intersect: false,
                    mode: 'nearest'
                }
            }
        });
</script>
<!--PAYABLE PIE CHART SCRIPT-->
<script>
    var ctx = document.getElementById("non").getContext("2d");
    var workSiteEmployees = @Html.Raw(Json.Serialize(Model.JobCategorySummary));
    const worksite = workSiteEmployees.map(item => item.zName);
    const employees = workSiteEmployees.map(item => item.zCount);

    new Chart(ctx, {
        type: 'pie',
        data: {
            labels: worksite,
            datasets: [{
                data: employees,
                backgroundColor: [
                    '#3f51b5', '#2196f3', '#00bcd4', '#009688',
                    '#4caf50', '#8bc34a', '#cddc39', '#ffc107'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: 'Employment Distribution by Work Location',
                    font: {
                        size: 18,
                        weight: 'bold'
                    },
                    padding: {
                        top: 10,
                        bottom: 20
                    }
                },
                legend: { position: 'bottom' },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const total = context.dataset.data.reduce((a, b) => a + b);
                            const percentage = Math.round((context.raw / total) * 100);
                            return `${context.label}: ${context.raw} (${percentage}%)`;
                        }
                    }
                }
            }
        }
    });
</script>
