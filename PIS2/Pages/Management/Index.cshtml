            console.log("Deserialized Data:", rawData);
            var labels = rawData.map(item => item.companyName);
            var terminatedCounts = rawData.map(item => item.terminatedEmployees || 0);
            var terminationRates = rawData.map(item => item.terminationRatePercent || 0);

            var companyTerminationChart = new Chart(ctx, {
