    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var ctx = document.getElementById("employmentHireChart").getContext("2d");
            // Get the serialized data from the server
            var hireData = @Html.Raw(Json.Serialize(Model.EmploymentHireRate));
            var terminationData = @Html.Raw(Json.Serialize(Model.TerminationRate));
            var manPowerRate = @Html.Raw(Json.Serialize(Model.ActiveEmployeeRate));

            const allYears = [...new Set([...hireData.map(item => item.zYear), ...terminationData.map(item => item.zYear)])].sort();

            // Map hire counts to years, filling missing values with 0
            const counts = allYears.map(year => {
                const found = hireData.find(item => item.zYear === year);
                return found ? found.zCount : 0;
            });

            // Map termination counts to years, filling missing values with 0
            const tcounts = allYears.map(year => {
                const found = terminationData.find(item => item.zYear === year);
                return found ? found.zCount : 0;
            });
            //Man Power Map
            const manPower = manPowerRate.map(item => item.zCount);


            new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: allYears,
                        datasets: [{
                            label: 'Hires',
                            data: counts,
                            backgroundColor: 'rgba(63, 81, 181, 0.2)',
                            borderColor: 'rgba(63, 81, 181, 1)',
