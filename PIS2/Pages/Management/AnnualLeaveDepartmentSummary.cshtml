@page
@model PIS2.Pages.Management.AnnualLeaveDepartmentSummaryModel
@{
}
@await Html.PartialAsync("headerSimple", "")
<div>
    <h1 class="fw-bold">Department Annual Leave Report</h1>
    <h4 class="fw-bold">@Model.DepartmentName, @Model.CompanyName</h4>
    <hr />
    
</div><!--SUMMARY-->
@if (Model.annualLeaveSummaries != null)
{
    <!--SUMMARY POINTS-->
    <div class="d-flex justify-content-between">


        <div class="card m-2 p-2 shadow flex-grow-1">
            <p>Total Employees (Records) </p>
            <h6 class="fw-bold">
                <u id="TotalRecords"></u>@Model.annualLeaveSummaries.Count().ToString("N2")
            </h6>
        </div>
        <div class="card m-2 p-2 shadow flex-grow-1">
            <p>Total Sum </p>
            <h6 class="fw-bold">
                <u id="TotalSum"></u>@Math.Round(Model.annualLeaveSummaries.Sum(l => l.adjustedLeaveBalanceCost)).ToString("N2")/ Birr
            </h6>

        </div>


    </div>

}
    @await Html.PartialAsync("filter")
    <table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
        <thead class="bg-black text-white">
            <tr>
                <th>S/No</th>
                <th>Employee ID</th>
                <th>Leave Balance(Days)</th>
                <th>Allowed Leave(Days)</th>
                <th>Payable(Birr)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
            }
            @foreach (var item in Model.annualLeaveSummaries.OrderBy(l => l.givenID))
            {
                <tr>
                    <td >@index</td>
                    <td onclick =" location.href='@Url.Page("/Employment/Details", new { id = item.employmentID })' " style="cursor:pointer;">@item.givenID</td>
                    <td>@item.leaveBalance.ToString("N2")</td>
                    <td>@item.adjustedLeaveBalance.ToString("N2")</td>
                    <td>@Math.Round(item.adjustedLeaveBalanceCost, 2).ToString("N2")</td>
                </tr>
                index++;
            }
            

        </tbody>
        <tfoot class="bg-secondary ">
            <tr>
                <th colspan="2">ToTal</th>
                <th>@Model.annualLeaveSummaries.Sum(als => als.leaveBalance).ToString("N2")</th>
                <th>@Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalance).ToString("N2")</th>
                <th>@Math.Round(Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalanceCost)).ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
    <div class="d-flex justify-content-end">
        @await Html.PartialAsync("print")
    </div>
</div>
