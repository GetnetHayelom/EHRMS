@page
@model PIS2.Pages.Management.AnnualLeaveDepartmentSummaryModel
@{
}
@await Html.PartialAsync("headerSimple", "")
<div>
    <h1 class="fw-bold">Department Annual Leave Report</h1>
    <h4 class="fw-bold">@Model.DepartmentName, @Model.CompanyName</h4>
    <hr />
    
</div><!--SUMMARY-->
@if (Model.annualLeaveSummaries != null)
{
    <!--SUMMARY POINTS-->
    <div class="card p-2 m-2 shadow-sm">
        <div class="d-flex gap-3 mb-4 d-print-flex">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Offered Leave</small>
                                <h3 class="fw-bold mb-0"><u>@Model.annualLeaveSummaries.Sum(als => als.leaveBalance).ToString("N2") (Days)</u></h3>
                            </div>
                            <div><i class="bi bi-tags fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Allowed Leave (Days)</small>
                                <h3 class="fw-bold mb-0"><u>@Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalance).ToString("N2") (Days)</u></h3>
                            </div>
                            <div><i class="bi bi-check fs-2 text-primary"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Allowed Leave Cost</small>
                                <h3 class="fw-bold mb-0"><u>@Math.Round(Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalanceCost), 2).ToString("N2") Br</u></h3>
                            </div>
                            <div><i class="bi bi-cash-stack fs-2 text-warning"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card p-2 mb-2 shadow-sm">
        <div class="d-flex justify-content-end d-print-none">
            <div class="mx-2">@await Html.PartialAsync("filter")</div>
            <div class="mx-2">@await Html.PartialAsync("print")</div>
            <div class="mx-2"><excel-export table="dataTable" filename="Department_Annual_Leave_Summary_@(DateTime.UtcNow).xlsx"></excel-export></div>
        </div>
    </div>

}


<div>   
    <table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
        <thead class="bg-black text-white">
            <tr>
                <th>S/No</th>
                <th>Employee ID</th>
                <th>Leave Balance(Days)</th>
                <th>Allowed Leave(Days)</th>
                <th>Payable(Birr)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
            }
            @foreach (var item in Model.annualLeaveSummaries.OrderByDescending(l => l.adjustedLeaveBalanceCost))
            {
                <tr>
                    <td >@index</td>
                    <td onclick =" location.href='@Url.Page("/Employment/Details", new { id = item.employmentID })' " style="cursor:pointer;">@item.givenID</td>
                    <td>@item.leaveBalance.ToString("N2")</td>
                    <td>@item.adjustedLeaveBalance.ToString("N2")</td>
                    <td>@Math.Round(item.adjustedLeaveBalanceCost, 2).ToString("N2")</td>
                </tr>
                index++;
            }
            

        </tbody>
        <tfoot class="bg-secondary ">
            <tr>
                <th colspan="2">ToTal</th>
                <th>@Model.annualLeaveSummaries.Sum(als => als.leaveBalance).ToString("N2")</th>
                <th>@Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalance).ToString("N2")</th>
                <th>@Math.Round(Model.annualLeaveSummaries.Sum(als => als.adjustedLeaveBalanceCost)).ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
    <div class="d-flex justify-content-end">
        @await Html.PartialAsync("print")
    </div>
</div>
