@page
@model PIS2.Pages.EmployeeService.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container-fluid mt-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h1 class="fw-bold mb-0">Earnings</h1>
            <h5 class="text-muted">@string.Join(", ", Model.Company)</h5>
        </div>

        <div class="d-flex gap-2">
            @await Html.PartialAsync("print")
            
        </div>
    </div>

    <!-- SUMMARY: Salary, Allowance, Total -->
    <div class="card shadow-sm p-2 mb-4 ">
        <div class="d-flex gap-3 d-print-flex flex-wrap">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Salary</small>
                            <h3 class="fw-bold mb-0">@Model.SalarySum.ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-currency-dollar fs-2 text-primary"></i></div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Allowance</small>
                            <h3 class="fw-bold mb-0">@Math.Round(Model.allowanceSum, 2).ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-wallet2 fs-2 text-warning"></i></div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total</small>
                            <h3 class="fw-bold mb-0">@Math.Round(Model.allowanceSum + Model.SalarySum, 2).ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-calculator fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    

    <!-- TAB NAVIGATION -->
    <div class="card shadow-sm p-2">
        <div class="d-flex justify-content-between">
            <ul class="nav nav-tabs mb-3 d-print-none" id="mainTabs" role="tablist">
                

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="list-tab" data-bs-toggle="tab"
                            data-bs-target="#list-content" type="button" role="tab">
                        List View
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="dep-tab" data-bs-toggle="tab"
                            data-bs-target="#dep-content" type="button" role="tab">
                        Department View
                    </button>
                </li>

            </ul>
            <div class="d-flex justify-content-end mb-2">
                <a href="/EarningRecord/Create" class="btn btn-success text-white m-2 d-print-none">
                    <i class="bi bi-plus-circle"></i>Add Earning
                </a>
                <a href="/DeductionRecord/Create" class="btn btn-danger text-white m-2 d-print-none">
                    <i class="bi bi-plus-circle"></i>Add Deduction
                </a>
            </div>
        </div>
    </div>
    
    
    <!-- TAB CONTENT -->
    <div class="card shadow-sm p-2 tab-content" id="mainTabsContent">

       
        <!-- TAB 2: LIST VIEW -->
        <div class="tab-pane fade" id="list-content" role="tabpanel">
            @await Html.PartialAsync("filter")

            <table class="table table-striped table-hover mt-3 print-full-width">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Emp-ID</th>
                        <th>Employee Name</th>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Salary</th>
                        <th>Allowance</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.EarningView)
                    {
                        <tr onclick="location.href='@Url.Page("Earning", new { id = item.empID })'" style="cursor:pointer">
                            <td>@item.EmployeeID</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.JobTitle</td>
                            <td>@item.Department</td>
                            <td>@item.Salary.ToString("N2")</td>
                            <td>@item.Allowance.ToString("N2")</td>
                            <td class="fw-bold">@Math.Round(item.Allowance + item.Salary, 2).ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="d-flex justify-content-end gap-3 d-print-none">
                <excel-export table="list-content" filename="Earnings_Employees_Report_@(DateTime.UtcNow).xlsx"></excel-export>
                @await Html.PartialAsync("print")
            </div>
           
        </div>
        
        <!-- TAB 3: DEPARTMENT VIEW -->
        <div class="tab-pane fade" id="dep-content" role="tabpanel">

            <table class="table table-striped table-hover mt-3 print-full-width">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>S/No</th>
                        <th>Department Name</th>
                        <th>Salary</th>
                        <th>Allowance</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody id="departmentsAccordion">
                    @{
                        int index = 0;
                        int rowNo = 1;
                    }
                    @foreach (var dep in Model.GroupedEarning)
                    {
                        var collapseId = $"collapse{index}";
                        <tr data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                            <td><strong>@rowNo</strong></td>
                            <td>@dep.Name</td>
                            <td>@Math.Round(dep.Salary, 2).ToString("N2")</td>
                            <td>@Math.Round(dep.Allowance, 2).ToString("N2")</td>
                            <td class="fw-bold">@Math.Round(dep.Salary + dep.Allowance, 2).ToString("N2")</td>
                        </tr>

                        <tr>
                            <td colspan="5" class="p-0">
                                <div id="@collapseId" class="collapse" data-bs-parent="#departmentsAccordion">
                                    <table class="table table-hover mb-0">
                                        <thead class="bg-secondary text-white">
                                            <tr>
                                                <th>Employment ID</th>
                                                <th>Employee Name</th>
                                                <th>Job Title</th>
                                                <th>Salary</th>
                                                <th>Allowance</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in dep.Records)
                                            {
                                                <tr onclick="location.href='@Url.Page("Earning", new { id = item.empID })'" style="cursor:pointer">
                                                    <td>@item.EmployeeID</td>
                                                    <td>@item.EmployeeName</td>
                                                    <td>@item.JobTitle</td>
                                                    <td>@item.Salary.ToString("N2")</td>
                                                    <td>@item.Allowance.ToString("N2")</td>
                                                    <td>@Math.Round(item.Salary + item.Allowance, 2).ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>

                        index++;
                        rowNo++;
                    }
                </tbody>
            </table>
            <div class="d-flex justify-content-end gap-3 d-print-none">
                <excel-export table="dep-content" filename="Earning_Department_Report_@(DateTime.UtcNow).xlsx"></excel-export>
                @await Html.PartialAsync("print")
            </div>
        </div>
        
    </div>
</div>
