@page
@model PIS2.Pages.EmployeeService.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container-fluid mt-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h2 class="fw-bold mb-0">Earnings</h2>
            <p class="text-muted mb-0">@string.Join(", ", Model.Company)</p>
        </div>

        <div class="d-flex gap-2">
            @await Html.PartialAsync("print")
            
        </div>
    </div>

    <!-- SUMMARY: Salary, Allowance, Total -->
    <div class="card shadow-sm p-2 mb-4 ">
        <div class="d-flex gap-3 d-print-flex flex-wrap">

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Salary</small>
                            <h3 class="fw-bold mb-0">@Model.SalarySum.ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-currency-dollar fs-2 text-primary"></i></div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-warning border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Allowance</small>
                            <h3 class="fw-bold mb-0">@Math.Round(Model.allowanceSum, 2).ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-wallet2 fs-2 text-warning"></i></div>
                    </div>
                </div>
            </div>

            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total</small>
                            <h3 class="fw-bold mb-0">@Math.Round(Model.allowanceSum + Model.SalarySum, 2).ToString("N2")</h3>
                        </div>
                        <div><i class="bi bi-calculator fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    

    <!-- TAB NAVIGATION -->
    <div class="card shadow-sm p-2">
        <div class="d-flex justify-content-between">
            <ul class="nav nav-tabs mb-3 d-print-none" id="mainTabs" role="tablist">
                

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="list-tab" data-bs-toggle="tab"
                            data-bs-target="#list-content" type="button" role="tab">
                        List View
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="dep-tab" data-bs-toggle="tab"
                            data-bs-target="#dep-content" type="button" role="tab">
                        Department View
                    </button>
                </li>

            </ul>
            <div class="d-flex justify-content-end mb-2">
                <a href="/EarningRecord/Create" class="btn btn-success text-white m-2 d-print-none">
                    <i class="bi bi-plus-circle"></i>Add Earning
                </a>
                <a href="/DeductionRecord/Create" class="btn btn-danger text-white m-2 d-print-none">
                    <i class="bi bi-plus-circle"></i>Add Deduction
                </a>
            </div>
        </div>
    </div>
    
    
    <!-- TAB CONTENT -->
    <div class="card shadow-sm p-2 tab-content" id="mainTabsContent">

        <!-- TAB 2: LIST VIEW -->
        <div class="tab-pane fade show active" id="list-content" role="tabpanel">
            <div class="d-flex justify-content-end gap-3 d-print-none">
                @await Html.PartialAsync("filter")
                <excel-export table="list-content" filename="Earnings_Employees_Report_@(DateTime.UtcNow).xlsx"></excel-export>
                @await Html.PartialAsync("print")
            </div>

                <table class="table table-striped table-hover" id="dataTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>
                                Emp-ID & Name
                            </th>
                            <th>
                                Job Title
                            </th>
                            <th>
                                Department/Company
                            </th>

                            <th>
                                Earnings
                            </th>

                            <th>
                                Total
                            </th>
                            <th class="d-print-none text-end px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var item in Model.EarningView.GroupBy(e => e.employmentID))
                        {                            
                            var rowNumb = $"rowNumb{index}";
                            <tr class="" data-bs-toggle="collapse" data-bs-target=".@rowNumb" style="cursor:pointer;">
                                <td>@(index++)</td>
                                <td>
                                    <p class="m-0">@item.FirstOrDefault()?.givenID</p>
                                    <p class="text-muted m-0">@item.FirstOrDefault()?.FullName</p>
                                </td>
                                <td>
                                    @item.FirstOrDefault()?.jobTitle
                                </td>
                                <td>
                                    <p class="m-0">@item.FirstOrDefault()?.departmentName</p>
                                    <p class="text-muted m-0">@item.FirstOrDefault()?.companyName</p>
                                </td>
                                <td>
                                </td>

                                <td>
                                    @item.Sum(e => e.earningAmount).ToString("N2")
                                </td>

                                <td class="d-print-none text-end px-2">
                                    <a asp-page="/EmployeeService/Earning" asp-route-id="@item.FirstOrDefault()?.employmentID" class="btn btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            foreach (var items2 in item)
                            {
                                <tr class="collapse @rowNumb">
                                    <td>@(index++)</td>
                                    <td colspan="3">
                                    </td>
                                    <td>@items2.earningTypeName</td>
                                    <td>
                                        @items2.earningAmount
                                    </td>

                                    <td>
                                    </td>

                                </tr>
                            }
                        }
                        
                       
                    </tbody>
                </table>
                <div class="d-flex justify-content-end">
                    @await Html.PartialAsync("print")
                </div>
           
        </div>
        
        <!-- TAB 3: DEPARTMENT VIEW -->
        <div class="tab-pane fade" id="dep-content" role="tabpanel">

            <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Company/Department Name</th>
                            <th></th>
                            <th>Salary</th>
                            <th>Allowance</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody id="departmentsAccordion">
                        @{
                            int index1 = 0;
                            int rowNo = 1;
                        }
                        @foreach (var dep in Model.EarningView.GroupBy(e => e.companyID))
                        {
                            var collapseId = $"clps{index1}";
                            <tr data-bs-toggle="collapse"
                                data-bs-target=".@collapseId"
                                style="cursor:pointer;">
                                <td><p>@rowNo</p></td>
                                <td colspan="2">                                  
                                        @dep.FirstOrDefault()?.companyName
                                </td>
                                <td colspan="1">                                   
                                        @Math.Round(dep.Where(e => e.earningTypeName.ToLower().Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")                                   
                                </td>
                                <td colspan="1">                                    
                                        @Math.Round(dep.Where(e => !e.earningTypeName.ToLower().Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")                                  
                                </td>
                                <td colspan="2">                                 
                                        @Math.Round(dep.Sum(e => e.earningAmount), 2).ToString("N2")
                                </td>
                            </tr>
                            @foreach (var item in dep.GroupBy(d => d.departmentID))
                            {
                                <tr class="accordion-collapse collapse @collapseId">
                                    <td></td>
                                    <td colspan="2">
                                        @item.FirstOrDefault()?.departmentName
                                    </td>

                                    <td colspan="1">
                                        @Math.Round(item.Where(e => e.earningTypeName.ToLower().Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                                    </td>
                                    <td colspan="1">
                                        @Math.Round(item.Where(e => !e.earningTypeName.ToLower().Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                                    </td>
                                    <td colspan="2">
                                        @Math.Round(item.Sum(e => e.earningAmount), 2).ToString("N2")
                                    </td>

                                </tr>
                            }
                            index++;
                            rowNo++;
                        }
                    </tbody>
                </table>
            
            <div class="d-flex justify-content-end gap-3 d-print-none">
                <excel-export table="dep-content" filename="Earning_Department_Report_@(DateTime.UtcNow).xlsx"></excel-export>
                @await Html.PartialAsync("print")
            </div>
        </div>
        
    </div>
</div>
