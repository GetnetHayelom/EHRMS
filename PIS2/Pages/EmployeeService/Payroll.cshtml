@page
@model PIS2.Pages.EmployeeService.PayrollModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    
}

<h2 class="fw-bold">Earnings</h2>
<p class="text-muted">Earnings Catalog - @Model.Company</p>

<div class="d-flex justify-content-between">
    <div>       
        <a asp-page="Create" class="btn btn-primary m-2 d-print-none" data-bs-toggle="collapse" data-bs-target="#rawView">List View</a>
        <a asp-page="Create" class="btn btn-primary m-2 d-print-none" data-bs-toggle="collapse" data-bs-target="#groupDepView">Department View</a>
        @await Html.PartialAsync("print")
    </div>
    
</div>
<hr />
<div class="d-flex justify-content-between">
    <h4 class="fw-bold">Salary:<u>@Model.SalarySum.ToString("N2")</u></h4>
    <h4 class="fw-bold">Allowance:<u>@Math.Round(Model.allowanceSum, 2).ToString("N2") </u></h4>
    <h4 class="fw-bold">Total:<u>@Math.Round(Model.allowanceSum + Model.SalarySum, 2).ToString("N2")</u> </h4>
</div>

<div id="parentDiv">
    <!--List View-->
    <div id="rawView" class="show" data-bs-parent="#parentDiv">
        @await Html.PartialAsync("filter")
        <table class="table table-striped table-hover" id="dataTable">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>
                        Emp-ID & Name</th>
                    <th>
                        Job Title
                    </th>
                    <th>
                        Department/Company
                    </th>

                    <th>
                        Earnings
                    </th>
                    
                    <th>
                        Total
                    </th>
                    <th class="d-print-none text-end px-2">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in Model.EarningView.GroupBy(e => e.employmentID)) {
                    <tr class="collapse" data-bs-toggle="collapse" data-bs-target="._@index" style="cursor:pointer;">
                        <td>@(index++)</td>
                        <td>
                            <p>@item.FirstOrDefault()?.givenID</p>
                            <p class=text-muted>@item.FirstOrDefault()?.FullName</p>
                        </td>
                        <td>
                            @item.FirstOrDefault()?.jobTitle
                        </td>
                        <td>
                            <p>@item.FirstOrDefault()?.departmentName</p>
                            <p class=text-muted>@item.FirstOrDefault()?.companyName</p>
                        </td>
                        <td>
                            
                        </td>
                        
                        <td>
                            @item.Sum(e => e.earningAmount).ToString("N2")
                        </td>
                        
                        <td class="d-print-none text-end px-2">
                            <a asp-page="/EmployeeService/Earning" asp-route-id="@item.FirstOrDefault()?.employmentID" class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i> 
                            </a>
                        </td>
                    </tr>
                    foreach(var items2 in item)
                    {
                        <tr class="collapse _@index" >
                            <td>@(index++)</td>
                            <td colspan="3">
                                
                            </td>
                            <td>@items2.earningTypeName</td>
                            <td>
                                @items2.earningAmount
                            </td>

                            <td>
                                
                            </td>

                        </tr>
                    }
                }
                <tr class="fw-bold">
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
        <div class="d-flex justify-content-end">
            @await Html.PartialAsync("print")
        </div>

    </div>
    <!--Group View-->
    <div id="groupDepView" class="show" data-bs-parent="#parentDiv">
        <table class="table table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>Company Name</th>
                    <th>Department Name</th>
                    <th>Department Salary</th>
                    <th>Department Allowance</th>
                    <th>Department Total</th>
                </tr>
            </thead>
            <tbody id="departmentsAccordion">
                @{
                    int index1 = 0;
                    int rowNo = 1;
                }
                @foreach (var dep in Model.EarningView.GroupBy(e => e.companyID))
                {
                    var collapseId = $"collapse{index1}";
                    <tr class="" data-bs-toggle="collapse"
                        data-bs-target=".@collapseId"
                        style="cursor:pointer;">
                        <td><h5>@rowNo</h5></td>
                        <td colspan="2" >
                            <h5 class="">
                                @dep.FirstOrDefault()?.companyName 
                            </h5>

                        </td>
                       
                        <td colspan="1">
                            <h5 class="">
                                @Math.Round(dep.Where(e => e.earningTypeName.Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                            </h5>

                        </td>
                        <td colspan="1">
                            <h5 class="">
                                @Math.Round(dep.Where(e => !e.earningTypeName.Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                            </h5>

                        </td>
                        <td colspan="2">
                            <h5 class="fw-bold">
                                @Math.Round(dep.Sum(e => e.earningAmount),2).ToString("N2")
                            </h5>
                        </td>

                    </tr>
                    @foreach (var item in Model.EarningView.GroupBy(e => e.companyID))
                    {
                        
                    }
                    <tr id="@collapseId" class="accordion-collapse collapse"
                        data-bs-parent="#departmentsAccordion">
                        <td><h5>@rowNo</h5></td>
                        <td colspan="2">
                            <h5 class="">
                                @dep.FirstOrDefault()?.companyName
                            </h5>

                        </td>

                        <td colspan="1">
                            <h5 class="">
                                @Math.Round(dep.Where(e => e.earningTypeName.Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                            </h5>

                        </td>
                        <td colspan="1">
                            <h5 class="">
                                @Math.Round(dep.Where(e => !e.earningTypeName.Contains("salary")).Sum(e => e.earningAmount), 2).ToString("N2")
                            </h5>

                        </td>
                        <td colspan="2">
                            <h5 class="fw-bold">
                                @Math.Round(dep.Sum(e => e.earningAmount), 2).ToString("N2")
                            </h5>
                        </td>
                        
                    </tr>
                    index++;
                    rowNo++;

                }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end">
@await Html.PartialAsync("print")
</div>