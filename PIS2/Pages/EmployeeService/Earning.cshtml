@page
@model PIS2.Pages.EmployeeService.EarningModel

@{
    ViewData["Title"] = "Edit Employment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")

<h1 class="fw-bold">Earnings</h1>
<h6 class="text-muted">Employee Current Earnings Detail </h6>
<hr />

<div class="">
    <div class="card shadow-sm border-0 px-3 py-2 m-2">
        <div class="d-flex justify-content-between align-items-center">
            @if (Model.EmpSelected)
            {
                <h4 class="fw-bold mb-0" onclick="location.href='@Url.Page("/Person/Details", new { id = Model.personModel.personID })'" style="cursor:pointer;">
                    <u>@Model.personModel.personFullName</u>
                </h4>
            }
            else
            {
                <div></div>
            }

            <!--EMPLOYEE LOOKUP-->
            
                <form method="get" class="d-flex align-items-center gap-2">
                    <label for="givenID" class="text-nowrap small fw-bold text-uppercase text-muted mb-0">Find Employee:</label>
                    <input asp-for="employmentModel.givenID" id="givenID" class="form-control form-control-sm" placeholder="Enter ID..." name="givenID" style="width: 150px;" />
                    <button type="submit" class="btn btn-sm btn-primary px-3" id="goButton">Go</button>
                </form>

        </div>
    </div>
</div>

@if (Model.EmpSelected)
{
    var totalEarnings = Model.payrollPay?.EarningRecords?.Sum(e => e.earningAmount) ?? 0;
    var totalDeductions = Model.payrollPay?.DeductionRecords?.Sum(d => d.deductionAmount) ?? 0;

    <div class="container print-full-width">

        <!-- Personal Info -->
        <div class="row mb-4 g-3">
            <div class="col-md-12">
                <div class="card">
                    <h4 class="card-header bg-dark text-white fw-bold p-2">Employment Information</h4>
                    <div class="card-body">
                        <div class="d-flex d-print-flex flex-wrap gap-4">
                            <div class="mb-2">
                                <strong>Employee ID:</strong>
                                <span class="text-decoration-underline ms-2">@Model.employmentModel.givenID</span>
                            </div>
                            <div class="mb-2">
                                <strong>Name:</strong>
                                <span class="text-decoration-underline ms-2">@Model.personModel.personFullName</span>
                            </div>
                            <div class="mb-2">
                                <strong>Job Title:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.jobModel?.jobTitle</span>
                            </div>
                            <div class="mb-2">
                                <strong>Salary:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.jobPlacementSalary</span>
                            </div>
                            <div class="mb-2">
                                <strong>Grade:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.jobStepModel?.jobGradeModel?.jobGradeName</span>
                            </div>
                            <div class="mb-2">
                                <strong>Step:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.jobStepModel?.jobStepName</span>
                            </div>
                            <div class="mb-2">
                                <strong>Department:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.departmentModel?.departmentName</span>
                            </div>
                            <div class="mb-2">
                                <strong>Company:</strong>
                                <span class="text-decoration-underline ms-2">@Model.jobPlacementModel?.departmentModel?.companyModel?.companyName</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>

        <div class="row mb-4">
            <!--EARNINGS-->
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="card h-100">
                    <div class="card-header bg-success text-white fw-bold">
                        <h4 class="mb-0">Earnings</h4>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-success sticky-top">
                                    <tr>
                                        <th>Earning Name</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.payrollPay?.EarningRecords?.Any() == true)
                                    {
                                        @foreach (var item in Model.payrollPay.EarningRecords)
                                        {
                                            <tr>
                                                <td>@(item.earningType?.earningTypeName)<br />
                                                    <p class="text-secondary small mb-0">@item.earningReference</p>
                                                </td>
                                                <td class="text-end fw-bold">@item.earningAmount.ToString("N2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center text-muted">No earnings found</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-success">
                                    <tr>
                                        <th class="text-end">Total:</th>
                                        <th class="text-end">@totalEarnings.ToString("N2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!--DEDUCTIONS-->
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header bg-danger text-white fw-bold">
                        <h4 class="mb-0">Deductions</h4>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-danger sticky-top">
                                    <tr>
                                        <th>Deduction Name</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.payrollPay?.DeductionRecords?.Any() == true)
                                    {
                                        @foreach (var item in Model.payrollPay.DeductionRecords)
                                        {
                                            <tr>
                                                <td>@(item.DeductionType?.deductionName)
                                                    <p class="text-secondary small mb-0">@item.deductionReference</p>
                                                </td>
                                                <td class="text-end fw-bold">@item.deductionAmount?.ToString("N2")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center text-muted">No deductions found</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-danger">
                                    <tr>
                                        <th class="text-end">Total:</th>
                                        <th class="text-end">@totalDeductions.ToString("N2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm p-2 border-0">
                    <div class="d-flex justify-content-around align-items-center">
                        <h4 class="fw-bold">Gross Pay: <span class="text-success">@(Model.payrollPay?.GrossPay.ToString("N2") ?? "0")</span></h4>
                        <h4 class="fw-bold">Net Pay: <span class="text-primary">@(Model.payrollPay?.NetPay.ToString("N2") ?? "0")</span></h4>
                        
                    </div>
                </div>
            </div>
        </div>

    </div>


<div class="d-flex justify-content-end mb-2 d-print-none">
    @if(User.IsInRole("MIE\\PMS_HRCLERK"))
    {
        <a href="/EarningRecord/Create?id=@Model.employmentModel?.employmentID" class="btn btn-success text-white m-2">
            <i class="bi bi-plus-circle"></i> Add Earning
        </a>
        <a href="/DeductionRecord/Create?id=@Model.employmentModel?.employmentID" class="btn btn-danger text-white m-2">
            <i class="bi bi-plus-circle"></i> Add Deduction
        </a>
    }
    
    @await Html.PartialAsync("print")
</div>

<!-- Three separate charts -->
<div class="row mb-4 g-3">
    <!-- Earnings Pie Chart -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-success text-white">
                <h5 class="fw-bold text-center mb-0">Earnings Breakdown</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 250px;">
                    <canvas id="earningsChart"></canvas>
                </div>
                <div class="text-center mt-2">
                    <small class="text-muted">Total Earnings: @Model.payrollPay?.EarningRecords?.Sum(e => e.earningAmount).ToString("N2") Br</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Deductions Pie Chart -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-danger text-white">
                <h5 class="fw-bold text-center mb-0">Deductions Breakdown</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 250px;">
                    <canvas id="deductionsChart"></canvas>
                </div>
                <div class="text-center mt-2">
                    <small class="text-muted">Total Deductions: @(Model.payrollPay?.DeductionRecords?.Sum(d => d.deductionAmount)?.ToString("N2") ?? "0") Br</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Gross vs Net vs Deductions Chart -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="fw-bold text-center mb-0">Gross vs Net vs Deductions</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 250px;">
                    <canvas id="summaryChart"></canvas>
                </div>
                <div class="text-center mt-2">
                    <small class="text-muted">Gross: @(Model.Gross.ToString("N2") ?? "0") Br | Net: @(Model.payrollPay?.NetPay.ToString("N2") ?? "0") Br</small>
                </div>
            </div>
        </div>
    </div>
</div>
}
<div class="d-print-none"><a asp-page="./Index">View All Employees Earnings</a></div>

@section Scripts {
    <script>
        // Store chart instances
        let earningsChartInstance = null;
        let deductionsChartInstance = null;
        let summaryChartInstance = null;

        document.addEventListener('DOMContentLoaded', function() {
            if (typeof Chart !== 'undefined') {
                initializeCharts();
            }
        });

        function initializeCharts() {
            // Destroy existing chart instances
            if (earningsChartInstance) earningsChartInstance.destroy();
            if (deductionsChartInstance) deductionsChartInstance.destroy();
            if (summaryChartInstance) summaryChartInstance.destroy();

            // Check if we have data
            @if (Model.EmpSelected && Model.payrollPay != null)
            {
                <text>
                // Prepare data from C# model
                const totalEarnings = @Model.payrollPay.EarningRecords.Sum(e => e.earningAmount);
                const totalDeductions = @Model.payrollPay.DeductionRecords.Sum(d => d.deductionAmount);
                const grossPay = @(Model.payrollPay?.GrossPay ?? 0);
                const netPay = @(Model.payrollPay?.NetPay ?? 0);
                
                // Prepare earnings data with proper labels
                            const earningsLabels = [
                @if (Model.payrollPay?.EarningRecords != null)
                {
                        foreach (var earning in Model.payrollPay.EarningRecords)
                        {
                                <text>@Html.Raw(Json.Serialize(
                                                        earning?.earningType?.earningTypeName
                                                )),</text>
                        }
                }
            ];

                const earningsValues = [
                    @if (Model.payrollPay?.EarningRecords != null)
                    {
                        foreach (var earning in Model.payrollPay.EarningRecords)
                        {
                            <text>@earning.earningAmount, </text>
                        }
                    }
                ];

                // Prepare deductions data with proper labels
                            const deductionsLabels = [
                @if (Model.payrollPay?.DeductionRecords != null)
                {
                        foreach (var deduction in Model.payrollPay.DeductionRecords)
                        {
                                <text>@Html.Raw(Json.Serialize(
                                                        deduction?.DeductionType?.deductionName
                                                )),</text>
                        }
                }
            ];

                const deductionsValues = [
                    @if (Model.payrollPay?.DeductionRecords != null)
                    {
                        foreach (var deduction in Model.payrollPay.DeductionRecords)
                        {
                            <text>@deduction.deductionAmount, </text>
                        }
                    }
                ];

                // Generate colors
                const generateColors = (count, startHue = 0) => {
                    const colors = [];
                    const goldenAngle = 137.5;
                    for (let i = 0; i < count; i++) {
                        const hue = (startHue + (i * goldenAngle)) % 360;
                        colors.push(`hsl(${hue}, 70%, 65%)`);
                    }
                    return colors;
                };

                // 1. Earnings Chart
                if (earningsValues.length > 0 && totalEarnings > 0) {
                    const earningsColors = generateColors(earningsValues.length, 120); // Green-ish hues
                    
                    earningsChartInstance = new Chart(document.getElementById('earningsChart'), {
                        type: 'pie',
                        data: {
                            labels: earningsLabels,
                            datasets: [{
                                data: earningsValues,
                                backgroundColor: earningsColors,
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: earningsLabels.length, // Show legend only if not too many items
                                    position: 'right',
                                    labels: {
                                        padding: 10,
                                        usePointStyle: true,
                                        font: {
                                            size: 10
                                        },
                                        generateLabels: function(chart) {
                                            const labels = Chart.defaults.plugins.legend.labels.generateLabels(chart);
                                            labels.forEach((label, index) => {
                                                const value = earningsValues[index];
                                                const percentage = Math.round((value / totalEarnings) * 100);
                                                label.text = `${label.text}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}%)`;
                                            });
                                            return labels;
                                        }
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const label = context.label || '';
                                            const value = context.raw || context.parsed;
                                            const percentage = Math.round((value / totalEarnings) * 100);
                                            return `${label}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                } else {
                    // No earnings data
                    document.getElementById('earningsChart').parentElement.innerHTML = 
                        '<div class="text-center text-muted p-4">No earnings data available</div>';
                }

                // 2. Deductions Chart
                if (deductionsValues.length > 0 && totalDeductions > 0) {
                    const deductionsColors = generateColors(deductionsValues.length, 0); // Red-ish hues
                    
                    deductionsChartInstance = new Chart(document.getElementById('deductionsChart'), {
                        type: 'pie',
                        data: {
                            labels: deductionsLabels,
                            datasets: [{
                                data: deductionsValues,
                                backgroundColor: deductionsColors,
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    display: deductionsLabels.length <= 6,
                                    position: 'right',
                                    labels: {
                                        padding: 10,
                                        usePointStyle: true,
                                        font: {
                                            size: 10
                                        },
                                        generateLabels: function(chart) {
                                            const labels = Chart.defaults.plugins.legend.labels.generateLabels(chart);
                                            labels.forEach((label, index) => {
                                                const value = deductionsValues[index];
                                                const percentage = Math.round((value / totalDeductions) * 100);
                                                label.text = `${label.text}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}%)`;
                                            });
                                            return labels;
                                        }
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const label = context.label || '';
                                            const value = context.raw || context.parsed;
                                            const percentage = Math.round((value / totalDeductions) * 100);
                                            return `${label}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                } else {
                    // No deductions data
                    document.getElementById('deductionsChart').parentElement.innerHTML = 
                        '<div class="text-center text-muted p-4">No deductions data available</div>';
                }

                // 3. Summary Chart (Gross vs Net vs Deductions)
                if (grossPay > 0) {
                    const summaryLabels = ['Net Pay', 'Total Deductions'];
                    const summaryValues = [Math.max(netPay, 0.01), Math.max(totalDeductions, 0.01)];
                    const summaryColors = ['#28a745', '#dc3545']; // Green for net, red for deductions
                    
                    // Calculate percentages
                    const netPercentage = Math.round((netPay / grossPay) * 100);
                    const deductionsPercentage = Math.round((totalDeductions / grossPay) * 100);
                    
                    summaryChartInstance = new Chart(document.getElementById('summaryChart'), {
                        type: 'pie',
                        data: {
                            labels: summaryLabels,
                            datasets: [{
                                data: summaryValues,
                                backgroundColor: summaryColors,
                                borderWidth: 2,
                                borderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        padding: 10,
                                        usePointStyle: true,
                                        font: {
                                            size: 11
                                        },
                                        generateLabels: function(chart) {
                                            const labels = Chart.defaults.plugins.legend.labels.generateLabels(chart);
                                            labels.forEach((label, index) => {
                                                const value = summaryValues[index];
                                                const percentage = index === 0 ? netPercentage : deductionsPercentage;
                                                label.text = `${label.text}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}%)`;
                                            });
                                            return labels;
                                        }
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            const label = context.label || '';
                                            const value = context.raw || context.parsed;
                                            const percentage = context.dataIndex === 0 ? netPercentage : deductionsPercentage;
                                            return `${label}: ${value.toLocaleString('en-US', {minimumFractionDigits: 2})} Br (${percentage}% of Gross)`;
                                        },
                                        afterLabel: function(context) {
                                            return `Gross Pay: ${grossPay.toLocaleString('en-US', {minimumFractionDigits: 2})} Br`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                } else {
                    // No gross pay data
                    document.getElementById('summaryChart').parentElement.innerHTML = 
                        '<div class="text-center text-muted p-4">No payroll data available</div>';
                }
                </text>
            }
        }
    </script>
}