@page
@model PIS2.Pages.LeaveHistory.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>leaveHistoryModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="leaveHistoryModel.leaveHistoryID" />
            <div class="form-group">
                <label asp-for="leaveHistoryModel.leaveID" class="control-label"></label>
                <select asp-for="leaveHistoryModel.leaveID" class="form-control" asp-items="ViewBag.leaveID"></select>
                <span asp-validation-for="leaveHistoryModel.leaveID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveHistoryModel.leaveHistoryAction" class="control-label"></label>
                <select asp-for="leaveHistoryModel.leaveHistoryAction" class="form-control" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()"></select>
                <span asp-validation-for="leaveHistoryModel.leaveHistoryAction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveHistoryModel.leaveHistoryDate" class="control-label"></label>
                <input asp-for="leaveHistoryModel.leaveHistoryDate" class="form-control" type="date"/>
                <span asp-validation-for="leaveHistoryModel.leaveHistoryDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
