@page
@model PIS2.Pages.Applications.IndexModel

@{
    ViewData["Title"] = "Applicants";
}

<h1 class="fw-bold">Applicants</h1>

<div class="mb-3 d-flex justify-content-between">
    <a asp-page="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add Applicant
    </a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Applicant</th>
            <th>Vacancy</th>
            <th>Applied Date</th>
            <th>Status</th>
            <th>Resume</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var applicant in Model.Applicants)
        {
            <tr>
                <td>@applicant.personModel?.personFullName</td>
                <td>@applicant.VacancyModel?.VacancyTitle</td>
                <td>@applicant.AppliedDate.ToString("MM/dd/yyyy")</td>
                <td>
                    <span class="badge @(
                        applicant.Status == Models.ApplicantStatus.Pending ? "bg-warning" :
                          applicant.Status == Models.ApplicantStatus.ScreenPass ? "bg-info" :
                          applicant.Status == Models.ApplicantStatus.InterviewPass ? "bg-info" :
                          applicant.Status == Models.ApplicantStatus.ExamPass ? "bg-info" :
                          applicant.Status == Models.ApplicantStatus.Accepted ? "bg-success" : "bg-danger"
                    )">@applicant.Status</span>
                </td> 
                <td>
                    @if (!string.IsNullOrEmpty(applicant.ResumeFilePath))
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Content(applicant.ResumeFilePath)" target="_blank">Download</a>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@applicant.ApplicantID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@applicant.ApplicantID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
