@page
@model PIS2.Pages.Applications.DetailsModel
@{
    ViewData["Title"] = "Applicant Details";
}
<div class="d-flex justify-content-between align-items-end mb-2">
    <div>
        <h2 class="fw-bold">Applicant Details</h2>
        <p class="text-muted mb-4"> Vacancy Applicant Details #@Model.Applicant.ApplicantID</p>
    </div>
    <div class="btn-group">
        <a asp-page="/Person/Details"
           asp-route-id="@Model.Applicant.personID"
           class="btn btn-outline-primary">
            <i class="bi bi-eye me-2"></i> Person Info
        </a>
        <a asp-page="/Applications/Create"
           asp-route-vacancyId="@Model.Applicant.VacancyID"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-2"></i> Add Applicant
        </a>
        
    </div>
    
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Applicant ID</dt>
            <dd class="col-sm-9">@Model.Applicant.ApplicantID</dd>

            <dt class="col-sm-3">Vacancy</dt>
            <dd class="col-sm-9">
                @Model.Applicant.VacancyModel?.VacancyTitle
            </dd>

            <dt class="col-sm-3">Person</dt>
            <dd class="col-sm-9">
                @Model.Applicant.personModel?.personFullName
            </dd>

            <dt class="col-sm-3">Applied Date</dt>
            <dd class="col-sm-9">
                @Model.Applicant.AppliedDate.ToString("MM/dd/yyyy")
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @{
                    string badgeClass = Model.Applicant.Status switch
                    {
                        Enums.ApplicantStatus.Accepted => "bg-success",
                        Enums.ApplicantStatus.Rejected => "bg-danger",
                        Enums.ApplicantStatus.Pending => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass">@Model.Applicant.Status</span>

            </dd>

            <dt class="col-sm-3">Resume</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrEmpty(Model.Applicant.ResumeFilePath))
                {
                    <a href="@Url.Content(Model.Applicant.ResumeFilePath)"
                       target="_blank"
                       class="btn btn-sm btn-outline-primary">
                        View Resume
                    </a>
                }
                else
                {
                    <span class="text-muted">No resume uploaded</span>
                }
            </dd>

            <dt class="col-sm-3">Last Modified</dt>
            <dd class="col-sm-9">
                @Model.Applicant.modifiedDate.ToString("dd MMM yyyy HH:mm")
                <br />
                <small class="text-muted">
                    by @Model.Applicant.modifiedBy
                </small>
            </dd>

        </dl>

    </div>

    <div class="card-footer text-end">
        <a asp-page="./Index" class="btn btn-secondary">Back</a>
        <a asp-page="./Edit"
           asp-route-id="@Model.Applicant.ApplicantID"
           class="btn btn-primary">
            Edit
        </a>
    </div>
</div>

<h5 class="mt-4">Education</h5>

@if (Model.Applicant.personModel?.PersonEducationLevels?.Any() == true)
{
    <div class="card mt-4">
    <div class="card-body">
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Level</th>
                    <th>Field</th>
                    <th>Institution</th>
                    <th>Mark</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var edu in Model.Applicant.personModel.PersonEducationLevels)
                {
                    <tr>
                        <td>@edu.educationLevelModel?.educationLevelName</td>
                        <td>@edu.educationField</td>
                        <td>@edu.educationLevelInstitutionName</td>
                        <td>@edu.educationLevelMark</td>
                        <td>@edu.educationLevelDate.ToString("yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
    </div>
}
else
{
    <p class="text-muted">No education records found.</p>
}

<h5 class="mt-4">Work Experience</h5>

@if (Model.Applicant.personModel?.Experiences?.Any() == true)
{
    <div class="card mt-4">
    <div class="card-body">
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Type</th>
                    <th>Period</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exp in Model.Applicant.personModel.Experiences)
                {
                    <tr>
                        <td>@exp.jobTitle</td>
                        <td>@exp.jobDepartment</td>
                        <td>@exp.experienceType</td>
                        <td>
                            @exp.experienceStartDate.ToString("MMM yyyy")
                            -
                            @(exp.experienceEndDate == DateTime.MinValue
                                                ? "Present"
                                                : exp.experienceEndDate.ToString("MMM yyyy"))
                </td>
            </tr>
                        }
            </tbody>
        </table>
    </div>
        </div>
    </div>
}
else
{
    <p class="text-muted">No experience records found.</p>
}
@await Html.PartialAsync("_AttachmentPartial",
new Pages.Shared.AttachmentPartialModel
{
    tableName = "Applicants",
    recordId = Model.Applicant.ApplicantID
})