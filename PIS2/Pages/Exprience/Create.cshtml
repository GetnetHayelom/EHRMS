@page
@model PIS2.Pages.Exprience.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>experienceModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="experienceModel.personID" class="control-label"></label>
                <input asp-for="experienceModel.personID" class="form-control" />
                <span asp-validation-for="experienceModel.personID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="experienceModel.experienceStartDate" class="control-label"></label>
                <input asp-for="experienceModel.experienceStartDate" class="form-control" />
                <span asp-validation-for="experienceModel.experienceStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experienceModel.experienceEndDate" class="control-label"></label>
                <input asp-for="experienceModel.experienceEndDate" class="form-control" />
                <span asp-validation-for="experienceModel.experienceEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experienceModel.jobPlacementID" class="control-label"></label>
                <input asp-for="experienceModel.jobPlacementID" class="form-control" />
                <span asp-validation-for="experienceModel.jobPlacementID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
