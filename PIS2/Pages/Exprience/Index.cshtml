@page
@model PIS2.Pages.Exprience.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table" id="dataTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.experienceModel[0].personID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experienceModel[0].experienceStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experienceModel[0].experienceEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experienceModel[0].jobTitle)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.experienceModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.personID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experienceStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experienceEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobTitle)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.experienceID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.experienceID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.experienceID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
