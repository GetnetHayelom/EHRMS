@page
@model PIS2.Pages.JobRequirement.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Placement Request</h1>

<h6 class="text-muted">Add New Job Placement Request</h6>
<hr />
<div class="d-flex gap-3">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobRequirementModel.departmentID" class="control-label">Department Name</label>
                <select asp-for="jobRequirementModel.departmentID" class ="form-control" asp-items="ViewBag.departmentID"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobRequirementModel.jobID" class="control-label">Job Title</label>
                <input type="text" class="form-control" list="jobList" placeholder="Type to search..." oninput="selector(this, 'jobIDHidden')" />
                <input type="hidden" asp-for="jobRequirementModel.jobID" id="jobIDHidden" />
                <datalist id="jobList">
                    @foreach (var job in Model.Jobs)
                    {
                        <option data-id="@job.Value" value="@job.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="jobRequirementModel.jobID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobRequirementModel.requiredNumber" class="control-label">Required Number</label>
                <input asp-for="jobRequirementModel.requiredNumber" class="form-control" />
                <span asp-validation-for="jobRequirementModel.requiredNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobRequirementModel.requiredReason" class="control-label">Reason</label>
                <input asp-for="jobRequirementModel.requiredReason" class="form-control" />
                <span asp-validation-for="jobRequirementModel.requiredReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="jobRequirementModel.employmentTypeID" class="control-label">Employment Type</label>
                <select asp-for="jobRequirementModel.employmentTypeID" class="form-control" asp-items="@Model.EmploymentTypes"> 
                    <option value="">--select employment type--</option>
                </select>
                <span asp-validation-for="jobRequirementModel.employmentTypeID" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Save" class="btn btn-success" />
            </div>
        </form>
    </div>
    
        @if (Model.JobRequests != null && Model.JobRequests.Any())
        { <div class="card shadow-sm p-2 flex-fill">
            <h6 class="fw-bold">Requests for Department</h6>
            <table class="table table-striped table-hover">
                <thead class="bg-dark text-white">
                    <tr>

                        <th>
                            Job Title
                        </th>
                        <th>
                            Required Number
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            Modified By
                        </th>
                        <th>
                            Modified Date
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.JobRequests)
                    {
                        <tr onclick="location.href='@Url.Page("Details", new { id = item.jobRequirementID })'" style="cursor:pointer;">

                            <td>
                                @Html.DisplayFor(modelItem => item.JobModel.jobTitle)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.requiredNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.jobRequirementStatus)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.modifiedBy)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.modifiedDate)
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    
</div>





<div>
    <a asp-page="Index">View All Job Requirements</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
