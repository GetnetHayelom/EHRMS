@page
@model PIS2.Pages.JobRequirement.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">JobPlacement Request</h1>

<div class="d-flex">
    <h4 class="fw-bold">Job Placement Request Details</h4>
    <hr />
    <dl class="row col-md-4">
        <dt class="col-sm-2">
            Company:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.DepartmentModel.companyModel.companyName) ?? "";
        </dd>
        <dt class="col-sm-2">
            Department:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.DepartmentModel.departmentName)
        </dd>
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.JobModel.jobID)
        </dd>
        <dt class="col-sm-2">
            Required Number:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.requiredNumber)
        </dd>
        <dt class="col-sm-2">
           Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.jobRequirementStatus)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.modifiedBy)
        </dd>
        <dt class="col-sm-2">
            Modified Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.modifiedDate)
        </dd>
    </dl>

    <div class="flex-grow">
        <h4 class="fw-bold">Request History</h4>
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-info text-white">
                <tr>
                    <th>Date</th>
                    <th>Modified By</th>
                    <th>Requested Number</th>
                    <th>Status</th>
                   
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.RequestHistory)
                {
                    <tr>
                        <td>@item?.modifiedBy</td>
                        <td>@item?.modifiedDate</td>
                        <td>@item?.requiredNumber</td>
                        <td>@item?.jobRequirementStatus</td>
                       
                    </tr>
                }
                
            </tbody>
        </table>
        <h4 class="fw-bold">Job Request Costs</h4>
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-info text-white">
                <tr>
                    <th>Date</th>
                    <th>Modified By</th>
                    <th>Stage</th>
                    <th>Reason</th>
                    <th>Estimate</th>
                    <th>Actual</th>
                    <th>Reference</th>
                   
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.JobReqCosts)
                {
                    <tr>
                        <td>@item?.jobReqCostReason</td>
                        <td>@item?.modifiedBy</td>
                        <td>@item?.modifiedDate</td>
                        <td>@item?.jobReqStatus</td>
                        <td>@item?.jobReqCostReason</td>
                        <td>@item?.jobReqCostEstimate</td>
                        <td>@item?.jobReqCostReference</td>
                      

                    </tr>
                }
                <tr>
                    <th colspan="5">Total</th>
                    <th >@Model.JobReqCosts?.Sum(jrc => jrc.jobReqCostEstimate) </th>
                    <th>@Model.JobReqCosts?.Sum(jrc => jrc.jobReqCostActual) </th>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.jobRequirementModel.jobRequirementID" class="btn btn-primary">Edit</a> 
</div>
<a asp-page="./Index">View All Job Placement Requests</a>