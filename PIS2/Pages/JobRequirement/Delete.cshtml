@page
@model PIS2.Pages.JobRequirement.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Placement Request</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Company:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.DepartmentModel.companyModel.companyName)
        </dd>
        <dt class="col-sm-2">
            Department:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.DepartmentModel.departmentName)
        </dd>
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.JobModel.jobID)
        </dd>
        <dt class="col-sm-2">
            Required Number:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.requiredNumber)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.jobRequirementStatus)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.modifiedBy)
        </dd>
        <dt class="col-sm-2">
            Modified Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobRequirementModel.modifiedDate)
        </dd>
    </dl>
    
    <form method="post" class=" d-flex justify-content-end">
        <input type="hidden" asp-for="jobRequirementModel.jobRequirementID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
