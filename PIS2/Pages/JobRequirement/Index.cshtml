@page
@model PIS2.Pages.JobRequirement.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Requests</h1>

<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Department
            </th>
            <th>
                Job Title
            </th>
            <th>
                Required Number
            </th>
            <th>
                Status
            </th>
            <th>
                Modified By
            </th>
            <th>
                Modified Date
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.jobRequirementModel) {
        <tr onclick="location.href='@Url.Page("Details", new{id=item.jobRequirementID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentModel.departmentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.JobModel.jobTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.requiredNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobRequirementStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedDate)
            </td>
            
        </tr>
}
    </tbody>
</table>
