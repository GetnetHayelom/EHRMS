@page
@model PIS2.Pages.JobRequirement.EditModel

@{
    ViewData["Title"] = "Edit Job Placement Request";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="mb-4">
    <h1 class="fw-bold text-dark">Job Placement Requests</h1>
    <p class="text-muted mb-0">Update details of the selected job placement request</p>
</div>

<!-- Form Card -->
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="jobRequirementModel.jobRequirementID" />

                    <!-- Department -->
                    <div class="mb-3">
                        <label asp-for="jobRequirementModel.departmentID" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Department
                        </label>
                        <select asp-for="jobRequirementModel.departmentID" class="form-select" asp-items="ViewBag.departmentID"></select>
                        <span asp-validation-for="jobRequirementModel.departmentID" class="text-danger"></span>
                    </div>

                    <!-- Job Title -->
                    <div class="mb-3">
                        <label asp-for="jobRequirementModel.jobID" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Job Title
                        </label>
                        <select asp-for="jobRequirementModel.jobID" class="form-select" asp-items="ViewBag.jobID"></select>
                        <span asp-validation-for="jobRequirementModel.jobID" class="text-danger"></span>
                    </div>

                    <!-- Required Number -->
                    <div class="mb-3">
                        <label asp-for="jobRequirementModel.requiredNumber" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Required Number
                        </label>
                        <input asp-for="jobRequirementModel.requiredNumber" class="form-control" />
                        <span asp-validation-for="jobRequirementModel.requiredNumber" class="text-danger"></span>
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label asp-for="jobRequirementModel.jobRequirementStatus" class="form-label fw-semibold">Status</label>
                        <select asp-for="jobRequirementModel.jobRequirementStatus" class="form-select"></select>
                        <span asp-validation-for="jobRequirementModel.jobRequirementStatus" class="text-danger"></span>
                    </div>

                    <!-- Modified By & Date -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="jobRequirementModel.modifiedBy" class="form-label fw-semibold">Modified By</label>
                            <input asp-for="jobRequirementModel.modifiedBy" class="form-control" readonly />
                            <span asp-validation-for="jobRequirementModel.modifiedBy" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="jobRequirementModel.modifiedDate" class="form-label fw-semibold">Modified Date</label>
                            <input asp-for="jobRequirementModel.modifiedDate" class="form-control" readonly />
                            <span asp-validation-for="jobRequirementModel.modifiedDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end mt-4">
                        <input type="submit" value="Save Changes" class="btn btn-primary px-4" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index" class="btn btn-outline-secondary">← Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
