@page
@model PIS2.Pages.Benefits.DetailsModel
@{
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark fw-bold">Payment Details</h2>
        <div>
            <a asp-page="./Edit" asp-route-id="@Model.OtherPay.payrollID" class="btn btn-warning">Edit</a>
            <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"> @Model.OtherPay.referenceType: @Model.OtherPay.reference</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">@Html.Raw(FormatStatus(Model.OtherPay.payrollStatus))</dd>


                        <dt class="col-sm-5">Gross Pay</dt>
                        <dd class="col-sm-7 text-primary fw-bold">@Model.OtherPay.totalGross?.ToString("C")</dd>

                        <dt class="col-sm-5">Net Pay</dt>
                        <dd class="col-sm-7 text-success fw-bold">@Model.OtherPay.totalNet?.ToString("C")</dd>

                        <dt class="col-sm-5 text-muted">Last Modified By</dt>
                        <dd class="col-sm-7 small">@Model.OtherPay.modifiedBy</dd>
                    </dl>
                    <hr />
                    <h6>Remarks:</h6>
                    <p class="text-muted small">@(Model.OtherPay.remark ?? "No remarks provided.")</p>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-clock-history me-2"></i> Audit Trail
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Field</th>
                                    <th>Old Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.History.Any())
                                {
                                    @foreach (var log in Model.History)
                                    {
                                        <tr>
                                            <td class="small">@log.ModifiedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td class="small fw-bold">@log.ModifiedBy</td>
                                            <td><span class="badge bg-light text-dark">@Model.GetFriendlyColumnName(log.ColumnName)</span></td>
                                            <td class="text-muted italic small">
                                                <span class="text-danger text-decoration-line-through small">
                                                    @Model.FormatAuditValue(log.ColumnName, log.OldValue)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No change history found for this record.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white small text-muted">
                    Total changes tracked: @Model.History.Count
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.OtherPay.PayrollPays.Any())
{
    <ul class="nav nav-tabs d-print-none">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#detailView">Full Detail View</button>
        </li>

        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#workTimeView">Work Time View</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#overTimeView">Overtime Time View</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#allowanceView">Allowance View</button>
        </li>

    </ul>

    <div class="tab-content mt-0">

        <!-- ============================= TAB 1 : DETAIL VIEW ============================= -->
        <div id="detailView" class="card shadow-sm p-2 tab-pane fade show active">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold">Payroll Details</h4>

                <div class="d-flex d-print-none">
                    <div class="me-2">
                        @await Html.PartialAsync("filter")
                    </div>

                    <excel-export table="dataTable" filename="Payroll_Detail_@(Model.OtherPay.payrollName)_@(DateTime.Now).xlsx"></excel-export>
                    <div>@await Html.PartialAsync("print")</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Employee ID</th>
                            <th>Full Name</th>
                            <th>Gross Pay</th>
                            <th>Net Pay</th>
                            <th>Earnings Breakdown</th>
                            <th>Deductions Breakdown</th>
                            <th class="d-print-none">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OtherPay.PayrollPays == null || !Model.OtherPay.PayrollPays.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    No payroll pay detail found.
                                </td>
                            </tr>
                        }

                        else
                        {
                            int detIndex = 1;
                            @foreach (var pay in Model.OtherPay.PayrollPays.OrderBy(p => p.EmploymentModel?.givenID))
                            {
                                <tr>
                                    <td>@(detIndex++)</td>
                                    <td onclick="location.href='@Url.Page("/EmployeeService/Earning", new { id = pay.EmploymentModel?.employmentID })'">
                                        @pay.EmploymentModel?.givenID
                                    </td>
                                    <td>@pay.EmploymentModel?.personModel?.personFullName</td>
                                    <td>@pay.GrossPay.ToString("N2")</td>
                                    <td>@pay.NetPay.ToString("N2")</td>
                                    <td>
                                        @foreach (var earn in pay.EarningRecords)
                                        {
                                            <div>
                                                @(Model.EarningTypes.First(e => e.earningTypeID == earn.earningTypeID).earningTypeName)
                                                = <u>@(earn.earningAmount.ToString("N2"))</u>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var ded in pay.DeductionRecords)
                                        {
                                            <div>
                                                @(Model.DeductionTypes.First(e => e.deductionTypeID == ded.deductionTypeID).deductionName)
                                                = <u>@(ded.deductionAmount?.ToString("N2"))</u>
                                            </div>
                                        }
                                    </td>
                                    <td class="d-print-none">
                                        <a asp-page="./PayDetails" asp-route-id="@pay.payrollPayID" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
   

        <!-- ============================= TAB 3 : WORK TIME VIEW ============================= -->
        <div id="workTimeView" class="card shadow-sm p-2 tab-pane fade">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold">Worked Hours Summary</h4>
                <div class="d-flex justify-content-between d-print-none">
                    <div class="me-2">
                        <input type="text" id="searchBox2" class="searchBox form-control m-2 filter-input" placeholder="finder..." data-target="#dataTable2" oninput="filterTable1(this)">
                    </div>
                    <excel-export table="dataTable2" filename="WorkTime_@(Model.OtherPay.payrollName)_@(DateTime.Now).xlsx"></excel-export>
                    <div>@await Html.PartialAsync("print")</div>
                </div>
            </div>


            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="dataTable2">
                    <thead class="table-dark">
                        <tr>
                            <th>S\No</th>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Hours</th>
                            <th>Rate</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                    <tbody>
                        @if (Model.OtherPay.PayrollPays == null || !Model.OtherPay.PayrollPays.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    No payroll pay detail found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int whIndex = 1;

                            @foreach (var wh in Model.OtherPay.PayrollPays.OrderBy(p => p.EmploymentModel?.givenID))
                            {
                                <tr>
                                    <td>@(whIndex++)</td>
                                    <td>@wh.EmploymentModel?.givenID</td>
                                    <td>@wh.EmploymentModel?.personModel?.personFullName</td>
                                    <td>@wh.Department?.departmentShort</td>
                                    <td>@wh.workedHours</td>
                                    <td>@wh.hourlyRate.ToString("N2")</td>
                                    <td>@((wh.hourlyRate * wh.workedHours).ToString("N2"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ============================= TAB 4 : OVERTIME VIEW ============================= -->
        <div id="overTimeView" class="card shadow-sm p-2 tab-pane fade">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold">Overtime Pays</h4>
                <div class="d-flex justify-content-between d-print-none">
                    <div class="me-2">
                        <input type="text" id="searchBox4" class="searchBox form-control m-2 filter-input" placeholder="finder..." data-target="#dataTable4" oninput="filterTable1(this)">
                    </div>
                    <excel-export table="dataTable4" filename="WorkTime_@(Model.OtherPay.payrollName)_@(DateTime.Now).xlsx"></excel-export>
                    <div>@await Html.PartialAsync("print")</div>
                </div>
            </div>


            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="dataTable4">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Total</th>
                            <th class="d-print-none text-end px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OtherPay.PayrollPays == null || !Model.OtherPay.PayrollPays.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    No payroll pay detail found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int otIndex = 1;

                            @foreach (var p in Model.OtherPay.PayrollPays.OrderBy(p => p.EmploymentModel?.givenID))
                            {
                                if (@p.EarningRecords?.Where(e => e.earningReference == "overtime")?.Sum(e => e.earningAmount) > 0)
                                {
                                    <tr>
                                        <td>@(otIndex++)</td>
                                        <td>@p.EmploymentModel?.givenID</td>
                                        <td>@p.EmploymentModel?.personModel?.personFullName</td>
                                        <td>@p.Department?.departmentShort</td>
                                        <td>@p.EarningRecords?.Where(e => e.earningReference == "overtime")?.Sum(e => e.earningAmount)</td>
                                        <td class="d-print-none text-end px-2">
                                            <a asp-page="/OvertimeRecord/PersonOTR" asp-route-empID="@p.employmentID" target="_blank" class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>

        <!-- ============================= TAB 5 : ALLOWANCE VIEW ============================= -->
        <div id="allowanceView" class="card shadow-sm p-2 tab-pane fade">
            <div class="d-flex justify-content-between align-items-end">
                <h4 class="fw-bold">Allowance Pays</h4>
                <div class="d-flex justify-content-between d-print-none">
                    <div class="me-2">
                        <input type="text" id="searchBox5" class="searchBox form-control m-2 filter-input" placeholder="finder..." data-target="#dataTable5" oninput="filterTable1(this)">
                    </div>
                    <excel-export table="dataTable5" filename="WorkTime_@(Model.OtherPay.payrollName)_@(DateTime.Now).xlsx"></excel-export>
                    <div>@await Html.PartialAsync("print")</div>
                </div>
            </div>


            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="dataTable5">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Total</th>
                            <th class="d-print-none text-end px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OtherPay.PayrollPays == null || !Model.OtherPay.PayrollPays.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    No payroll pay detail found.
                                </td>
                            </tr>
                        }
                        else
                        {

                            int alIndex = 1;

                            foreach (var p in Model.OtherPay.PayrollPays.OrderBy(p => p.EmploymentModel?.givenID))
                            {
                                if (@p.EarningRecords?.Where(e => e.earningReference == "allowance").Sum(e => e.earningAmount) > 0)
                                {
                                    <tr>
                                        <td>@(alIndex++)</td>
                                        <td>@p.EmploymentModel?.givenID</td>
                                        <td>@p.EmploymentModel?.personModel?.personFullName</td>
                                        <td>@p.Department?.departmentShort</td>
                                        <td>@p.EarningRecords?.Where(e => e.earningReference == "allowance").Sum(e => e.earningAmount)</td>
                                        <td class="d-print-none text-end px-2">
                                            <a asp-page="/AllowanceAssignment/PersonAllowance" asp-route-id="@p.employmentID" target="_blank" class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
       
    </div>

}

@functions {
    public string FormatStatus(PIS2.Enums.payrollStatus status)
    {
        return status switch
        {
            Enums.payrollStatus.PENDING => "<span class='badge bg-warning text-dark'><i class='bi bi-hourglass-split'></i> Pending</span>",
            Enums.payrollStatus.APPROVED => "<span class='badge bg-info'><i class='bi bi-check-circle'></i> Approved</span>",
            Enums.payrollStatus.POSTED => "<span class='badge bg-primary'><i class='bi bi-send-check'></i> Posted</span>",
            Enums.payrollStatus.COMPLETED => "<span class='badge bg-success'><i class='bi bi-flag-fill'></i> Completed</span>",
            _ => $"<span class='badge bg-secondary'>{status}</span>"
        };
    }
}