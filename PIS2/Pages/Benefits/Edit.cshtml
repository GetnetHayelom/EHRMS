@page
@model PIS2.Pages.Benefits.EditModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold mb-0 text-dark">@Model.OtherPay.referenceType: @Model.OtherPay.reference</h4>
                        <span class="badge bg-secondary">ID: @Model.OtherPay.payrollID</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="OtherPay.payrollID" />
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.referenceType" class="form-label fw-bold">Reference Type</label>
                                <input asp-for="OtherPay.referenceType" class="form-control" placeholder="INV-0000" value="" />
                                <span asp-validation-for="OtherPay.referenceType" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OtherPay.reference" class="form-label fw-bold">Reference</label>
                                <input asp-for="OtherPay.reference" class="form-control" placeholder="INV-0000" value=""/>
                                <span asp-validation-for="OtherPay.reference" class="text-danger small"></span>
                            </div>
                            
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.totalGross" class="form-label fw-bold">Gross Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OtherPay.totalGross" class="form-control" type="number" step="0.01" readonly />
                                </div>
                                <span asp-validation-for="OtherPay.totalGross" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OtherPay.totalNet" class="form-label fw-bold">Net Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success-subtle">$</span>
                                    <input asp-for="OtherPay.totalNet" class="form-control border-success" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="OtherPay.totalNet" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.payrollStatus" class="form-label fw-bold">Payment Status</label>
                                <select asp-for="OtherPay.payrollStatus" class="form-select" asp-items="Html.GetEnumSelectList<PIS2.Enums.payrollStatus>()"></select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="OtherPay.remark" class="form-label fw-bold">Remarks</label>
                            <textarea asp-for="OtherPay.remark" class="form-control" rows="3" placeholder="Additional notes..."></textarea>
                        </div>

                        <div class="bg-light p-3 rounded mb-4">
                            <div class="row text-muted small">
                                <div class="col-6">
                                    <strong>Last Modified By:</strong> @Model.OtherPay?.modifiedBy
                                </div>
                                
                            </div>
                        </div>
                        

                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            @if (User.IsInRole("HRMANAGER") && Model.OtherPay?.payrollStatus == Enums.payrollStatus.PENDING)
                            {
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-save"></i>@L.T("Save") Changes
                                </button>
                            }
                            
                        </div>
                    </form>
                </div>
                @switch (Model.OtherPay?.payrollStatus)
                {
                    case Enums.payrollStatus.PENDING:

                        if (User.IsInRole("HRMANAGER"))
                        {
                            <div class="d-flex justify-content-end gap-2">
                                <form method="post" asp-page-handler="Approve">
                                    <input type="hidden" name="id" value="@Model.OtherPay.payrollID" />
                                    <button class="btn btn-success">Approve</button>
                                </form>
                            </div>
                        }

                        break;

                    case Enums.payrollStatus.APPROVED:
                        if (User.IsInRole("PAYROLL"))
                        {
                            <div class="d-flex justify-content-end gap-2">
                                <form method="post" asp-page-handler="Post">
                                    <input type="hidden" name="id" value="@Model.OtherPay.payrollID" />
                                    <button class="btn btn-success">Post</button>
                                </form>
                            </div>
                        }

                        break;

                    case Enums.payrollStatus.POSTED:
                        if (User.IsInRole("FINANCE"))
                        {
                            <div class="d-flex justify-content-end gap-2">
                                <form method="post" asp-page-handler="Post">
                                    <input type="hidden" name="id" value="@Model.OtherPay.payrollID" />
                                    <button class="btn btn-success">Post</button>
                                </form>
                            </div>
                        }

                        break;

                    case Enums.payrollStatus.COMPLETED:
                        <div class="d-flex justify-content-end gap-2">
                            <p class="badge bg-success">Completed</p>
                        </div>
                        break;
                    case Enums.payrollStatus.DISCARDED:
                        <div class="d-flex justify-content-end gap-2">
                            <p class="badge bg-danger">Void</p>
                        </div>
                        break;
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}