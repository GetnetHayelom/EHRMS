@page
@model PIS2.Pages.Benefits.EditModel
@{
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold mb-0 text-dark">Update Payment: @Model.OtherPay.invoiceNo</h4>
                        <span class="badge bg-secondary">ID: @Model.OtherPay.paymentID</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="OtherPay.paymentID" />
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.invoiceNo" class="form-label fw-bold">Invoice Number</label>
                                <input asp-for="OtherPay.invoiceNo" class="form-control" placeholder="INV-0000" />
                                <span asp-validation-for="OtherPay.invoiceNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OtherPay.earningID" class="form-label fw-bold">Earning Category</label>
                                <input asp-for="OtherPay.earningID" class="form-select" readonly hidden/>
                                <input class="form-control" value="@Model.OtherPay?.earningModel?.earningType?.earningTypeName" />

                                <span asp-validation-for="OtherPay.earningID" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.GrossPay" class="form-label fw-bold">Gross Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OtherPay.GrossPay" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="OtherPay.GrossPay" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OtherPay.NetPay" class="form-label fw-bold">Net Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success-subtle">$</span>
                                    <input asp-for="OtherPay.NetPay" class="form-control border-success" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="OtherPay.NetPay" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="OtherPay.paymentStatus" class="form-label fw-bold">Payment Status</label>
                                <select asp-for="OtherPay.paymentStatus" class="form-select" asp-items="Html.GetEnumSelectList<PIS2.Models.payrollStatus>()"></select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="OtherPay.remark" class="form-label fw-bold">Remarks</label>
                            <textarea asp-for="OtherPay.remark" class="form-control" rows="3" placeholder="Additional notes..."></textarea>
                        </div>

                        <div class="bg-light p-3 rounded mb-4">
                            <div class="row text-muted small">
                                <div class="col-6">
                                    <strong>Last Modified By:</strong> @Model.OtherPay?.modifiedBy
                                </div>
                                <div class="col-6">
                                    <strong>Last Date:</strong> @Model.OtherPay?.modifiedDate
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}