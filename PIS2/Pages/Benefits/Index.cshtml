@page
@model PIS2.Pages.Benefits.IndexModel
@{
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-wallet2"></i> Other Payments</h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Record New Payment
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h6 class="text-uppercase small">Total Gross Pay</h6>
                    <h3 class="mb-0">@Model.TotalGross.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <h6 class="text-uppercase small">Total Net Pay</h6>
                    <h3 class="mb-0">@Model.TotalNet.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="text-uppercase small">Total Records</h6>
                    <h3 class="mb-0">@Model.OtherPayments.Count</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3">Invoice No.</th>
                            <th>Earning Type</th>
                            <th>Beneficiary</th>
                            <th class="text-end">Gross Pay</th>
                            <th class="text-end">Net Pay</th>
                            <th>Status</th>
                            <th>Last Modified</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OtherPayments)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.invoiceNo</td>
                                <td>
                                    <span class="text-muted">@item.earningModel?.earningType?.earningTypeName</span>
                                </td>
                                <td>
                                    <div class="small">@item.earningModel?.EmploymentModel?.personModel?.personFullName</div>
                                    <div class="text-muted extra-small" style="font-size: 0.75rem;">@item.earningModel?.EmploymentModel?.givenID</div>
                                </td>
                                <td class="text-end">@item.GrossPay.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.NetPay.ToString("N2")</td>
                                <td>
                                    @Html.Raw(GetStatusBadge(item.paymentStatus))
                                </td>
                                <td>
                                    <div class="small">@item.modifiedBy</div>
                                    <div class="text-muted extra-small" style="font-size: 0.75rem;">@item.modifiedDate</div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="./Edit" asp-route-id="@item.paymentID" class="btn btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="./Details" asp-route-id="@item.paymentID" class="btn btn-outline-info" title="Details"><i class="bi bi-eye"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadge(PIS2.Models.payrollStatus status)
    {
        return status switch
        {
            Models.payrollStatus.APPROVED => "<span class='badge bg-success-subtle text-success border border-success'>Approved</span>",
            Models.payrollStatus.PENDING => "<span class='badge bg-warning-subtle text-warning border border-warning'>Pending</span>",
            Models.payrollStatus.POSTED => "<span class='badge bg-danger-subtle text-danger border border-danger'>Rejected</span>",
            _ => $"<span class='badge bg-secondary'>{status}</span>"
        };
    }
}