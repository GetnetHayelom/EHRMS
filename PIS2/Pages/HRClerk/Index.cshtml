@page
@model PIS2.Pages.HRClerck.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">HR Center</h1>
<hr />
@if (User.IsInRole("PMS_HRMANAGER"))
{
    <div class="d-flex justify-content-around">
        <button class="btn btn-primary m-2 flex-grow-1">Allowance</button>
        <button class="btn btn-warning m-2 flex-grow-1">Prohibition</button>
        <button class="btn btn-primary m-2 flex-grow-1">Employment</button>
        <button class="btn btn-primary m-2 flex-grow-1">Job Placements</button>
        <button class="btn btn-warning m-2 flex-grow-1">Termination</button>
        <button class="btn btn-danger m-2 flex-grow-1">Penality</button>
        <button class="btn btn-success m-2 flex-grow-1">Promotion</button>
    </div>
}

<hr />
<div class="d-flex">
    <div class="col-4">
        <div class="d-flex card shadow justify-content-center m-2 p-2" onclick="getList('Leave')" style="cursor:pointer">
            <h4 class="fw-bold">Leaves On Hold</h4>
            <div class="d-flex justify-content-center bg-info text-white">
                <h2 class="fw-bold justify-content-center">@Model.leaveCount</h2>
            </div>
        </div>
        <div class="d-flex card shadow justify-content-center m-2 p-2" onclick="getList('Overtime')" style="cursor:pointer">
            <h4 class="fw-bold">Overtime On Hold</h4>
            <div class="d-flex justify-content-center bg-info text-white">
                <h2 class="fw-bold">@Model.overtimeCount</h2>
            </div>
        </div>
        <div class="d-flex card shadow justify-content-center m-2 p-2" onclick="getList('Service')" style="cursor:pointer">
            <h4 class="fw-bold">Service Requests</h4>
            <div class="d-flex justify-content-center bg-info text-white">
                <h2 class="fw-bold justify-content-center">@Model.serviceRequestCount</h2>
            </div>
        </div>
        <div class="d-flex card shadow justify-content-center m-2 p-2" onclick="getList('Contract')" style="cursor:pointer">
            <h4 class="fw-bold">Contract Termination Within this Week</h4>
            <div class="d-flex justify-content-center bg-info text-white">
                <h2 class="fw-bold justify-content-center">@Model.contractEndCount</h2>
            </div>
        </div>
        <div class="d-flex card shadow justify-content-center m-2 p-2" onclick="getList('Pension')" style="cursor:pointer">
            <h4 class="fw-bold">Pensioners within 6 Months</h4>
            <div class="d-flex justify-content-center bg-info text-white">
                <h2 class="fw-bold justify-content-center">@Model.pensionCount</h2>
            </div>
        </div>
    </div>
    <div class="col-8">
        <div class="d-flex mb-2">
            <h4 class="fw-bold" id="tableTitle"></h4>
        </div>
        <table class="table table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr id="tableHeader"></tr>
            </thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>
<script>
    function getList(summaryType) {
        const tableHeader = document.getElementById("tableHeader");
        const tableBody = document.getElementById("tableBody");
        const tableTitle = document.getElementById("tableTitle");

        //summaryType = "Pension";
        const url = '/HRClerk/Index?handler=GetSummary&sumType=' + summaryType;
        fetch(url)
            .then(response => response.json())
            .then(data => {
                tableHeader.innerHTML = data.tableHeader;
                tableBody.innerHTML = data.tableBody;
                tableTitle.innerHTML = data.tableTitle;
            })
            .catch(error => console.error('Error:', error));
    }
</script>
