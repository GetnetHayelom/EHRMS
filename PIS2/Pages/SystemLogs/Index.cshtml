@page
@model PIS2.Pages.SystemLogs.IndexModel
@await Html.PartialAsync("headerSimple","")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">System Logs</h2>
        <p class="text-muted">Preview and filter system logs</p>
    </div>
    <div class="d-flex justify-content-end align-items-end d-print-none">
        @await Html.PartialAsync("back")
        @await Html.PartialAsync("print")
    </div>
</div>
<hr />

<div style="display:flex; gap:20px">

    <!-- Log File List -->
    <div class="col-md-2 d-print-none">
        <h4 class="fw-bold">Log Files</h4>

        <ul>
            @foreach (var file in Model.LogFiles)
            {
                <li>
                    <a asp-page="Index" asp-route-file="@file">
                        @file
                    </a>
                </li>
            }
        </ul>
    </div>

    <!-- Log Content -->
    <div class="col-md-10">

        <h4 class="fw-bold">System Log Content</h4>

        <!-- Filters -->
        <div class="card mb-3 d-print-none">
            <div class="card-body d-flex gap-3">

                <input type="text"
                       id="searchBox"
                       class="form-control"
                       placeholder="Search logs...">

                <select id="levelFilter" class="form-select" style="max-width:200px">
                    <option value="">All Levels</option>
                    <option value="[INF]">Info</option>
                    <option value="[WRN]">Warning</option>
                    <option value="[ERR]">Error</option>
                </select>

                <button class="btn btn-secondary"
                        onclick="location.reload()">
                    Refresh
                </button>

            </div>
        </div>

        <!-- Log Table -->
        <div class="card">
            <div class="table-responsive" style="max-height:600px;overflow:auto">

                <table class="table table-sm table-striped mb-0 print-full-width" id="logTable">

                    <thead class="table-dark">
                        <tr>
                            <th>Time</th>
                            <th>Level</th>
                            <th>Message</th>
                        </tr>
                    </thead>

                    <tbody id="logViewer"></tbody>

                </table>

            </div>
        </div>

    </div>

</div>

<div class="d-flex justify-content-end align-items-end d-print-none">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>


<script>

    const rawLogs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LogContent ?? ""));
    const allLines = rawLogs.split("\n");

    function parseLog(line){

        let level = "";
        let time = "";
        let message = line;

        if(line.includes("[INF]")) level="INF";
        if(line.includes("[WRN]")) level="WRN";
        if(line.includes("[ERR]")) level="ERR";

        let parts = line.split("[");
        if(parts.length > 0)
            time = parts[0].trim();

        return {time, level, message};
    }

    function levelBadge(level){

        if(level === "ERR")
            return `<span class="badge bg-danger">Error</span>`;

        if(level === "WRN")
            return `<span class="badge bg-warning text-dark">Warning</span>`;

        if(level === "INF")
            return `<span class="badge bg-info text-dark">Info</span>`;

        return "";
    }
    
    function highlight(text, search){

        if(!search) return text;

        const regex = new RegExp(`(${search})`, "gi");

        return text.replace(regex, `<mark class="bg-warning">$1</mark>`);

    }
        function renderLogs(lines){

        let search = document.getElementById("searchBox").value.toLowerCase();
        let levelFilter = document.getElementById("levelFilter").value;

        let html="";

        lines.forEach(line=>{

            if(line.trim()==="") return;

            let matchSearch = line.toLowerCase().includes(search);
            let matchLevel = levelFilter === "" || line.includes(levelFilter);

            if(matchSearch && matchLevel){

                let log = parseLog(line);

                let highlightedMessage = highlight(log.message, search);

                html += `
                    <tr>
                        <td>${log.time}</td>
                        <td>${levelBadge(log.level)}</td>
                        <td>${highlightedMessage}</td>
                    </tr>
                `;
            }

        });

        document.getElementById("logViewer").innerHTML = html;

    }

    document.getElementById("searchBox").addEventListener("input", () => renderLogs(allLines));
    document.getElementById("levelFilter").addEventListener("change", () => renderLogs(allLines));

    renderLogs(allLines);

</script>