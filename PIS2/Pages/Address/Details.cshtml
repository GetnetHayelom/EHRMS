@page
@model PIS2.Pages.Address.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Address</h1>

<div class="col-6">
    <h4 class="fw-bold">Address Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Country
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressCountry)
        </dd>
        <dt class="col-sm-2">
            Region
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressRegion)
        </dd>
        <dt class="col-sm-2">
            Zone
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressZone)
        </dd>
        <dt class="col-sm-2">
            Woreda
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressWoreda)
        </dd>
        <dt class="col-sm-2">
            Tabya
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressTabya)
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressStatus)
        </dd>
    </dl>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.addressModel.addressID" class="btn btn-primary m-2" >@L.T("Edit")</a>
    <a asp-page="./Delete" asp-route-id="@Model.addressModel.addressID" class="btn btn-danger m-2" >Delete</a>
</div>
<a asp-page="./Index">View All Address</a>