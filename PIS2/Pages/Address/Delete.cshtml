@page
@model PIS2.Pages.Address.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Address</h1>

<h3 class="fw-bold">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Country
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressCountry)
        </dd>
        <dt class="col-sm-2">
            Region
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressRegion)
        </dd>
        <dt class="col-sm-2">
            Zone
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressZone)
        </dd>
        <dt class="col-sm-2">
            Wereda/District/Subcity
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressWoreda)
        </dd>
        <dt class="col-sm-2">
            Tabya/Kebelle
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressTabya)
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.addressModel.addressStatus)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="addressModel.addressID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        
    </form>
    <a asp-page="./Index">View All Addresses</a>
</div>
