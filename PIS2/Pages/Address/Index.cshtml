@page
@model PIS2.Pages.Address.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Addresses</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Address</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-stripped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Country
            </th>
            <th>
                Region
            </th>
            <th>
                zone
            </th>
            <th>
                Woreda
            </th>
            <th>
                Tabiya
            </th>
            <th>
                Status
            </th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.addressModel) {
            <tr onclick="location.href='@Url.Page("Details", new {id = item.addressID})'" style="cursor:pointer;">
                <td>
                    @Html.DisplayFor(modelItem => item.addressCountry)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.addressRegion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.addressZone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.addressWoreda)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.addressTabya)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.addressStatus)
                </td>
                    
            </tr>
        }
    </tbody>
</table>
