@page
@model PIS2.Pages.Vacancy.IndexModel

@{
    ViewData["Title"] = "Vacancies";
}


<div class="mb-3 d-flex justify-content-between align-items-center">
    <div class="">
        <h2 class="fw-bold">Vacancies</h2>
        <h6 class="text-muted">Vacancy Catalogue</h6>
    </div>
    
    <a asp-page="Create" class="btn btn-success m-2">
        <i class="bi bi-plus-circle"></i> Add Vacancy
    </a>
</div>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>S/No</th>
            <th>Title</th>
            <th>Job</th>
            <th>Department</th>
            <th>Location</th>
            <th>Slots</th>
            <th>Status</th>
            <th>Date Posted</th>
            <th>Closing Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Vacancies.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">
                    No vacancies found.
                </td>
            </tr>
        }
        @{
            int index = 0;
        }
        @foreach (var vacancy in Model.Vacancies)
        {
            index++;
            <tr>
                <td>@index</td>
                <td>@vacancy.VacancyTitle</td>
                <td>@vacancy.jobModel?.jobTitle</td>
                <td>@vacancy.departmentModel?.departmentName</td>
                <td>@vacancy.Location</td>
                <td>@vacancy.VacancyRequiredNumber</td>
                <td>
                    @if (vacancy.Status == Models.VacancyStatus.Open)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => vacancy.Status)</span>

                    }
                    else if (vacancy.Status == Models.VacancyStatus.OnHold)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => vacancy.Status)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => vacancy.Status)</span>
                    }
                </td>
                <td>@vacancy.DatePosted.ToString("MM/dd/yyyy")</td>
                <td>@vacancy.ClosingDate?.ToString("MM/dd/yyyy")</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@vacancy.VacancyID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@vacancy.VacancyID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
