@page
@model PIS2.Pages.DeductionRecord.CreateModel

@{
    ViewData["Title"] = "Create Deduction";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<h2 class="fw-bold">Employee Deductions</h2>
<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Deduction</h4>
        </div>

        <div class="card-body">

            <!-- EMPLOYEE SEARCH -->
            <div class="mb-4 col-md-4">
                <label class="form-label">Enter Employee ID</label>
                <div class="input-group col-md-4">
                    <input id="employeeInput" type="text" class="form-control" placeholder="Enter employee givenID">
                    <button id="searchEmployeeBtn" type="button" class="btn btn-primary">Search</button>
                </div>

                <div id="employeeNotFound" class="alert alert-danger mt-3 d-none">
                    Employee not found.
                </div>

                <div id="employeeInfo" class="alert alert-info mt-3 d-none">
                    <strong>Name:</strong> <span id="empName"></span><br />
                    <strong>Job Title:</strong> <span id="empJob"></span><br />
                    <strong>Department:</strong> <span id="empDept"></span><br />
                    <strong>Company:</strong> <span id="empCompany"></span>
                </div>
            </div>

            <!-- MAIN FORM (HIDDEN UNTIL EMPLOYEE FOUND) -->
            <form id="deductionForm" method="post" class="d-none">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Deduction.employmentID" id="hiddenEmploymentID" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Deduction Type</label>
                        <select asp-for="Deduction.deductionTypeID" class="form-select" asp-items="Model.DeductionTypes"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Reference</label>
                        <input asp-for="Deduction.deductionReference" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Iteration (Months)</label>
                        <input asp-for="Deduction.deductionIteration" type="number" min="1" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input asp-for="Deduction.deductionAmount" type="number" step="0.01" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Is Percentage?</label>
                        <select asp-for="Deduction.IsPercentage" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No (Fixed)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="Deduction.deductionStatus" class="form-select">
                            @foreach (var s in Enum.GetValues(typeof(Models.mainStatus)))
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Deduction</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    async function loadForm(empId){
        const response = await fetch(`/api/core/EmployeeLookup/${empId}`);
        const data = await response.json();

        const notFoundDiv = document.getElementById("employeeNotFound");
        const infoDiv = document.getElementById("employeeInfo");
        const form = document.getElementById("deductionForm");

        if (!data.isFound) {
            notFoundDiv.classList.remove("d-none");
            infoDiv.classList.add("d-none");
            form.classList.add("d-none");
            return;
        }

        // Hide Not Found
        notFoundDiv.classList.add("d-none");

        // Fill Employee Info
        document.getElementById("empName").innerText = data.employeeName;
        document.getElementById("empJob").innerText = data.jobTitle;
        document.getElementById("empDept").innerText = data.department;
        document.getElementById("empCompany").innerText = data.company;
        document.getElementById("employeeInput").innerText = empId;

        infoDiv.classList.remove("d-none");

        // Assign employmentID to hidden field
        document.getElementById("hiddenEmploymentID").value = data.employmentID;

        // Show main form
        form.classList.remove("d-none");
    }

    document.getElementById("searchEmployeeBtn").addEventListener("click", async function () {
        const empId = document.getElementById("employeeInput").value.trim();
        if (!empId) return;

        loadForm(empId);
    });
</script>
<script>
    window.addEventListener("DOMContentLoaded", function () {
        const autoID = "@ViewData["GivenID"]";

        if (autoID && autoID !== "") {
            loadForm(autoID);
        }
    });
</script>
