@page "{id:int}"
@model PIS2.Pages.DeductionRecord.EditModel
@{
    ViewData["Title"] = "Edit Deduction";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Edit Deduction</h4>
        </div>

        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Deduction.deductionID" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Deduction Type</label>
                        <select asp-for="Deduction.deductionTypeID" class="form-select" asp-items="Model.DeductionTypes"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Employee</label>
                        <select asp-for="Deduction.employmentID" class="form-select" asp-items="Model.Employees"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Reference</label>
                        <input asp-for="Deduction.deductionReference" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">No of Payments</label>
                        <input asp-for="Deduction.deductionIteration" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Remaining No of Payments</label>
                        <input asp-for="Deduction.remainingIteration" type="number" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Amount</label>
                        <input asp-for="Deduction.deductionAmount" type="number" step="0.01" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Is Percentage?</label>
                        <select asp-for="Deduction.IsPercentage" class="form-select">
                            <option value="true">Yes</option>
                            <option value="false">No (Fixed)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select asp-for="Deduction.deductionStatus" class="form-select">
                            @foreach (var s in Enum.GetValues(typeof(Models.mainStatus)))
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-warning">Update Deduction</button>
                </div>
            </form>
        </div>
    </div>
</div>
