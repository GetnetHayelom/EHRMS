@page
@using PIS2.Enums
@model PIS2.Pages.DeductionRecord.IndexModel
@{
}
@{
    ViewData["Title"] = "Deductions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Deduction Records</h3>
        <a class="btn btn-primary" asp-page="Create">+ Add Deduction</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Ref</th>
                        <th>Type</th>
                        <th>Employee</th>
                        <th>Iteration</th>
                        <th>Amount</th>
                        <th>Is %</th>
                        <th>Status</th>
                        <th style="width: 130px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.deductions)
                    {
                        <tr>
                            <td>@item.deductionReference</td>
                            <td>@item.DeductionType?.deductionName</td>
                            <td>@item.EmploymentModel?.givenID</td>
                            <td>@item.deductionIteration</td>
                            <td>@item.deductionAmount</td>
                            <td>@(item.IsPercentage ? "Yes" : "No")</td>
                            <td>
                                @if (item.deductionStatus == mainStatus.Active)
                                {
                                    <span class="badge bg-success">@Html.DisplayFor(modelItem => item.deductionStatus)</span>

                                }
                                else if (item.deductionStatus == mainStatus.Suspended)
                                {
                                    <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.deductionStatus)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.deductionStatus)</span>
                                }
                            </td>
                            <td>
                                
                                <div class="btn-group" role="group">
                                    <a asp-page="./Details" asp-route-id="@item.deductionID" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Edit" asp-route-id="@item.deductionID" class="btn btn-sm btn-outline-success" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div>
    <a asp-page="Index">View All Deductions</a>
</div>