@page
@model PIS2.Pages.Letter.DetailsModel
@{
    Layout = "headerFull";
    ViewData["RefNo"] = Model.Letter?.letterNumber ?? "";
}
<h2 class="fw-bold d-print-none mb-0">Letters</h2>
<p class="text-muted d-print-none mb-0">Letter Details #@Model.Letter?.letterID</p>
<div class="container mt-4">
    @section LetterBody
    {
    <div class="d-flex flex-column">
        <div class="d-flex d-print-none m-2">
            <label class="fw-bold me-2">Ref.No:</label>
                <label class=""><u>@Model.Letter?.letterNumber</u></label>
        </div>
            
        <div class="d-flex justify-content-center m-2">
            <h3 class="fw-bold"><u>@Model.Letter?.letterTitle</u></h3>
        </div>
           
        <div class="d-flex m-2">
            <h5 class="fw-bold me-2">Subject:</h5>
            <h5 class=""><u>@Model.Letter?.letterSubject</u></h5>
        </div>
            <div class="d-flex gap-2 m-2 @(String.IsNullOrEmpty(Model.Letter?.letterSender) ? "d-print-none" : "")">
                <lable class="fw-bold me-2">From:</lable>
                <lable class=""><u>@Model.Letter?.letterSender</u></lable>
            </div>

            <div class="d-flex gap-2 m-2 @(String.IsNullOrEmpty(Model.Letter?.letterReceiver) ? "d-print-none" : "")">
                <lable class="fw-bold me-2">To:</lable>
                <lable class=""><u>@Model.Letter?.letterReceiver</u></lable>
            </div>
        <div class="d-flex gap-2 d-print-none m-2">
                <label class="fw-bold me-2">Type:</label>
                <label class=""><u>@Model.Letter?.LetterType?.letterTypeName</u></label>
        </div>
        
        <div class="d-flex d-print-none m-2">
                <label class="fw-bold me-2">Group:</label>
                <label class=""><u>@Model.Letter?.letterGroup</u></label>
        </div>
        
        <div class="d-flex gap-2 d-print-none m-2">
                <lable class="fw-bold me-2">Status:</lable>
                <lable class=""><u>@Model.Letter?.letterStatus</u></lable>
        </div>
        
    </div>

        <div class="ql-editor card p-4 ">
        @Html.Raw(Model.Letter?.letterBody)
    </div>
        <div class="d-flex mt-6">
            <lable class="fw-bold d-print-none me-2">Signed By:</lable>
            <lable class="">@Model.Letter?.letterSignedBy</lable>
        </div>
        <div class="d-flex justify-content-end d-print-none">
            <a asp-page="Index" class="btn btn-secondary m-2">Back</a>
          
        @if(Model.Letter?.letterStatus == Models.LetterStatus.Draft)
        {
            <a asp-page="Edit" asp-route-id="@Model.Letter?.letterID" class="btn btn-warning m-2">Edit</a>
        }
        @if (User.IsInRole("MIE\\PMS_HRMANAGER") && Model.Letter?.letterStatus == Models.LetterStatus.Draft)
        {
            <form method="post" asp-page-handler="Approve">
                <input type="hidden" asp-for="LetterId" value="@Model.Letter.letterID"/>
                <button type="submit" class="btn btn-success m-2">
                    Approve
                </button>
            </form>
        }
        @if(User.IsInRole("MIE\\PMS_HRCLERK") && Model.Letter?.letterStatus == Models.LetterStatus.Approved)
        {
            <a asp-page="/Archive/Create" asp-route-id="@Model.Letter?.letterID" class="btn btn-primary m-2">Archive</a>
        }
            @await Html.PartialAsync("print")
    </div>
    

}</div>

