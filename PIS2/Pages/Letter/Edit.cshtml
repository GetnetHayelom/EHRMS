@page
@model PIS2.Pages.Letter.EditModel
@{
}
<h2 class="fw-bold">Letters</h2>
<h6 class="text-muted">Update Letter</h6>
<div class="card shadow-sm p-2 mt-4 col-md-8">
    <form method="post">
        <input type="hidden" value="@Model.Letter.letterID" asp-for="Letter.letterID" />
        <div class="row mb-3">
            <div class="col-md-6">
                <label>Letter Group</label>
                <select asp-for="Letter.letterGroup"
                        asp-items="Html.GetEnumSelectList<Models.LetterGroup>()"
                        class="form-select"></select>
            </div>

            <div class="col-md-6">
                <label>Letter Type</label>
                <select asp-for="Letter.letterTypeID"
                        asp-items="Model.LetterTypes"
                        class="form-select"></select>
            </div>
        </div>
        <div class="mb-3">
            <label>Title</label>
            <input asp-for="Letter.letterTitle" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Subject</label>
            <input asp-for="Letter.letterSubject" class="form-control" />
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label>Sender</label>
                <input asp-for="Letter.letterSender" class="form-control" />
            </div>
            <div class="col-md-6">
                <label>Receiver</label>
                <input asp-for="Letter.letterReceiver" class="form-control" />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-6 align-items-center">
                <label>Status:</label><br />
                
                @if (Model.Letter.letterStatus == Models.LetterStatus.Draft)
                {
                    <span class="badge bg-warning">@Model.Letter.letterStatus</span>

                }
                else if (Model.Letter.letterStatus == Models.LetterStatus.Approved)
                {
                    <span class="badge bg-success">@Model.Letter.letterStatus</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Models.LetterStatus.Draft</span>
                }
            </div>
            <div class="col-md-6 align-items-center">
                <label>Last Modified By:</label><br />
                <label class="text-muted">@Model.Letter.modifiedBy on @Model.Letter.modifiedDate</label>
            </div>
        </div>
        <div class="form-group">
            <label for="editor">Content</label>

            @await Html.PartialAsync("_EditorHeader")
            <!-- Hidden input for form -->
            <input type="hidden" id="letterBody" name="Letter.letterBody" />
        </div>
        <!-- Selector -->
        <div class="mb-3">
            <label asp-for="Letter.letterSignedBy" class="form-label fw-semibold">
                <span class="text-danger">*</span> Signed By
            </label>
            <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.Letter.letterSignedBy"/>
            <input type="hidden" asp-for="Letter.letterSignedBy" id="personIDHidden" value="@Model.Letter.letterSignedBy" />
            <datalist id="personList">
                @foreach (var person in Model.PersonList)
                {
                    <option data-id="@person.Value" value="@person.Text"></option>
                }
            </datalist>
            <span asp-validation-for="Letter.letterSignedBy" class="text-danger"></span>
        </div>
        <div class="d-flex justify-content-end m-2 gap-2">
            
            <button class="btn btn-success">Save</button>
            <a asp-page="Details" asp-route-id="@Model.Letter.letterID" class="btn btn-primary">View</a>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
        
    </form>
</div>

@section Scripts {
    <script src="/lib/quill/quill.min.js"></script>
    <script src="/js/quill-editor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.initQuillEditor({
                editorId: 'editor',
                hiddenInputId: 'letterBody',
                initialContent: '@Html.Raw(Model.Letter.letterBody)'
            });
        });
    </script>
}

