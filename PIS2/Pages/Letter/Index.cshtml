@page
@model PIS2.Pages.Letter.IndexModel
@{
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h2 class="fw-bold">Letters</h2>
            <h6 class="text-muted">Letter Details</h6>
        </div>
        <a asp-page="Create" class="btn btn-primary">+ New Letter</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>S/No</th>
                <th>Number</th>
                <th>Subject</th>
                <th>Type</th>
                <th>Group</th>
                <th>Date</th>
                <th>Status</th>
                <th width="160"></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Letters.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">
                        No letter found.
                    </td>
                </tr>
            }
        @{
            int index = 1;
        }
            @foreach (var l in Model.Letters)
        {
            <tr>
                <td>@(index++)</td>
                <td>@l.letterNumber</td>
                <td>@l.letterSubject</td>
                <td>@l.LetterType?.letterTypeName</td>
                <td>@l.letterGroup</td>
                <td>@l.letterDate.ToShortDateString()</td>
                <td>
                    
                        @if (l.letterStatus == Models.LetterStatus.Draft)
                        {
                            <span class="badge bg-warning">@Html.DisplayFor(modelItem => l.letterStatus)</span>

                        }
                        else if (l.letterStatus == Models.LetterStatus.Approved)
                        {
                            <span class="badge bg-success">@Html.DisplayFor(modelItem => l.letterStatus)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => l.letterStatus)</span>
                        }
                </td>
                <td>
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@l.letterID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@l.letterID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                  
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-end m-2">
    <a asp-page="/Archive/Index" class="btn btn-outline-primary m-2">Archives</a>
    @await Html.PartialAsync("print")
</div>
