 @page
@model PIS2.Pages.Payroll.EditModel
@{
    ViewData["Title"] = "Edit Payroll";
}
<h2 class="fw-bold mb-0">Payroll</h2>
<p class="text-muted mb-0">@L.T("Update") Payroll</p>
<div class="card p-2 shadow-sm col-md-6">
    <form method="post">
        <input asp-for="Payroll.payrollID" readonly hidden value="@Model.Payroll.payrollID"/>
        <div class="form-group">
            <label asp-for="Payroll.payrollName" class="form-label" ><span class="text-danger">*</span>Payroll Name</label>
            <input asp-for="Payroll.payrollName" class="form-control" required />
            <span asp-validation-for="Payroll.payrollName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Payroll.companyID" class="form-label">Company</label>
            <select asp-for="Payroll.companyID" class="form-control" asp-items="Model.Companies">
                <option value="">-- Select Company (optional) --</option>
            </select>
            <span asp-validation-for="Payroll.companyID" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Payroll.StartDate" class="form-label"><span class="text-danger">*</span>Start</label>
            <input asp-for="Payroll.StartDate" type="date" class="form-control" required/>
            <span asp-validation-for="Payroll.StartDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Payroll.EndDate" class="form-label"><span class="text-danger">*</span>End</label>
            <input asp-for="Payroll.EndDate" type="date" class="form-control" required/>
            <span asp-validation-for="Payroll.EndDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Status</label>
            <input class="form-control" value="@Model.Payroll.payrollStatus" readonly />
        </div>
        <div class="d-flex justify-content-end m-2 gap-2">
            <a asp-page="Index" class="btn btn-outline-seconadry"><i class="bi bi-arrow-left me-2"></i> Back to catalog</a>
            <button type="submit" class="btn btn-success">@L.T("Save")</button>
        </div>

    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

