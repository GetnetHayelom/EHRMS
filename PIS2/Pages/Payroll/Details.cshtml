@page "{id:int}"
@model PIS2.Pages.Payroll.DetailsModel
@{
    ViewData["Title"] = "Payroll Details";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="mb-4 fw-bold">Payroll Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Payroll.payrollName</h5>
        <div class="d-flex d-print-flex gap-3 flex-wrap">
            <p class="card-text"><strong>Company:</strong><u></u> @(Model.Payroll.companyModel?.companyName ?? "All Companies")</p>
            <p class="card-text"><strong>Period:</strong><u></u> @(Model.Payroll.StartDate.ToString("yyyy-MM-dd")) - @(Model.Payroll.EndDate.ToString("yyyy-MM-dd"))</p>
            <p class="card-text">
                <strong>Status:</strong>
                <span class="badge
                @(Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.PENDING ? "bg-warning" :
                                                          Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.APPROVED ? "bg-primary" :
                                                          Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.POSTED ? "bg-info" :
                                                          "bg-success")">
                    @Model.Payroll.payrollStatus
                </span>
            </p>
            <p class="card-text"><strong>Total Employees:</strong> <u>@Model.Payroll.totalEmployees</u></p>
            <p class="card-text"><strong>Total Gross:</strong><u>@Model.Payroll.totalGross</u> </p>
            <p class="card-text"><strong>Total Net:</strong> <u>@Model.Payroll.totalNet</u></p>

            <p class="card-text"><strong>Total Tax:</strong><u>@Model.Payroll.totalTax</u> </p>
            <p class="card-text"><strong>Total Pension(Employee):</strong><u>@Model.Payroll.totalPensionEmployee.ToString()</u> </p>
            <p class="card-text"><strong>Total Pension(Employer):</strong> <u>@Model.Payroll.totalPensionEmployer</u></p>
        </div>
        
    </div>
</div>

<div class="mb-4">
    @if (Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.PENDING)
    {
        <form method="post" asp-page-handler="Approve" class="d-inline">
            <input type="hidden" name="id" value="@Model.Payroll.payrollID" />
            <button type="submit" class="btn btn-primary">Approve Payroll</button>
        </form>
    }
    else if (Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.APPROVED)
    {
        <form method="post" asp-page-handler="Post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Payroll.payrollID" />
            <button type="submit" class="btn btn-success">Post & Generate Payroll</button>
        </form>
    }
    else if (Model.Payroll.payrollStatus == PIS2.Models.payrollStatus.POSTED)
    {
        <form method="post" asp-page-handler="Post" class="d-inline">
            <input type="hidden" name="id" value="@Model.Payroll.payrollID" />
            <button type="submit" class="btn btn-success">Re-Generate Payroll</button>
        </form>
    }
</div>

@if (Model.PayrollPays.Any())
{
    <div class="d-flex justify-content-between">
        <h3 class="m-2 fw-bold">Payroll Pays</h3>
        <div class="d-flex d-print-none gap-3">
            <div>@await Html.PartialAsync("filter")</div>
            <excel-export table="dataTable" filename="payroll_@(Model.Payroll.payrollName)_@(DateTime.Now).xlsx" ></excel-export>
            <div>@await Html.PartialAsync("print")</div>
        </div>
        
    </div>
    
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover print-full-width" id="dataTable">
            <thead class="table-dark">
                <tr>
                    <th>Employee</th>
                    <th>Gross Pay</th>
                    <th>Net Pay</th>
                    <th>Earnings Breakdown</th>
                    <th>Deductions Breakdown</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pay in Model.PayrollPays.OrderBy(p => p.EmploymentModel?.givenID))
                {
                    <tr>
                        <td onclick ="location.href='@Url.Page("/EmployeeService/Earning", new { id = pay.EmploymentModel?.employmentID })'" style="cursor:pointer;">@pay.EmploymentModel?.givenID</td>
                        <td>@pay.GrossPay.ToString("N2")</td>
                        <td>@pay.NetPay.ToString("N2")</td>
                        <td>
                            @foreach (var earn in pay.EarningRecords)
                            {
                                <div>@(earn.earningType?.earningTypeName ?? "Other"): <u>@earn.earningAmount.ToString("N2")</u></div>
                            }
                        </td>
                        <td>
                            @foreach (var ded in pay.DeductionRecords)
                            {
                                <div>@(ded.DeductionType?.deductionName ?? "Other"): <u>@ded.deductionAmount</u></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end">
        <excel-export table="dataTable" filename="payroll_@(Model.Payroll.payrollName)_@(DateTime.Now).xlsx"></excel-export>
        @await Html.PartialAsync("print")
    </div>
}
