
@page
@using System.Text.RegularExpressions
@model PIS2.Pages.AuditLog.IndexModel
@{
}
<div class="container py-2">
    <h4 class="fw-bold"><i class="bi bi-clock-history me-2"></i>Record History</h4>
    <h6 class="fw-bold text-muted">Find Record History</h6>
    <form method="get" class="card p-4 mb-4 shadow-sm">
        
        <div class="d-flex gap-3 align-items-end">
            <!-- Table selector -->
            <div class="mb-3">
                <label class="form-label">Select Table</label>
                <select name="tableName"
                        asp-items="Model.TableList"
                        class="form-select"
                        required>
                    <option value="">-- Select Table --</option>
                </select>
            </div>

            <!-- Record ID -->
            <div class="mb-3">
                <label class="form-label">Record ID</label>
                <input name="recordId"
                       type="number"
                       class="form-control"
                       placeholder="Enter record ID"
                       required />
            </div>

            <!-- Submit -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary w-100">
                    Load Record
                </button>
            </div>
            
        </div>
        

    </form>


    <div class="timeline">
        @if (!Model.History.Any())
        {
            <div class="text-center p-5 border rounded bg-light">
                <i class="bi bi-info-circle fs-2 text-muted"></i>
                <p class="mt-2">No history found for this record.</p>
            </div>
        }

        @foreach (var session in Model.History)
        {
            <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                @session.User.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <span class="fw-bold">@session.User</span>
                                <span class="text-muted small"> updated the record</span>
                            </div>
                        </div>
                        <span class="badge bg-light text-dark border">@session.Date.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0">
                            <thead class="text-muted small uppercase">
                                <tr>
                                    <th style="width: 30%">Field</th>
                                    <th>Previous Value</th>
                                    <th style="width: 5%"></th>
                                    <th>New Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var change in session.Changes)
                                {
                                    <tr>
                                        <td class="fw-medium text-primary">@Regex.Replace(change.ColumnName, "([a-z])([A-Z])", "$1 $2")</td>
                                        <td class="text-muted">@(string.IsNullOrEmpty(change.OldValue) ? "(Empty)" : change.OldValue)</td>
                                        <td><i class="bi bi-arrow-right text-muted"></i></td>
                                        <td class="fw-bold">
                                            @* @change.NewValue *@ 
                                                    <span class="text-success">@L.T("Update")d</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

