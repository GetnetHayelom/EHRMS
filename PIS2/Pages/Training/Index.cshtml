@page
@model PIS2.Pages.Training.IndexModel
@{
    ViewData["Title"] = "Training Catalog";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold h3 mb-0 text-gray-800">Training Catalog</h2>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50 mr-2"></i>New Training
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Mandatory</th>
                            <th>Validity</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Trainings)
                        {
                            <tr>
                                <td><strong>@item.trainingTitle</strong></td>
                                <td><span class="badge bg-info text-dark">@item.category</span></td>
                                <td>
                                    @if (item.isMandatory)
                                    {
                                        <span class="badge bg-danger">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Optional</span>
                                    }
                                </td>
                                <td>@(item.validityMonths?.ToString() ?? "N/A")</td>
                                <td>
                                    @if (item.isActive)
                                    {
                                        <i class="fas fa-circle text-success small"></i>
                                        <span>Active</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-circle text-muted small"></i>
                                        <span>Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-page="./Edit" asp-route-id="@item.trainingID" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-page="./Details" asp-route-id="@item.trainingID" class="btn btn-sm btn-outline-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>