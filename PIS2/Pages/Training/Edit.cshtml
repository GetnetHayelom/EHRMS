@page "{id:int}"
@model PIS2.Pages.Training.EditModel
@{
    ViewData["Title"] = "Edit Training";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="./Index">Catalog</a></li>
                    <li class="breadcrumb-item active">Edit @Model.Training.trainingTitle</li>
                </ol>
            </nav>

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-edit me-2"></i> Update Training Configuration</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Training.trainingID" />

                        <div class="mb-3">
                            <label asp-for="Training.trainingTitle" class="form-label fw-bold">Training Title</label>
                            <input asp-for="Training.trainingTitle" class="form-control form-control-lg" />
                            <span asp-validation-for="Training.trainingTitle" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Training.description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Training.description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Training.category" class="form-label fw-bold">Category</label>
                                <select asp-for="Training.category" asp-items="Html.GetEnumSelectList<Models.trainingCategory>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Training.validityMonths" class="form-label fw-bold">Validity (Months)</label>
                                <div class="input-group">
                                    <input asp-for="Training.validityMonths" class="form-control" />
                                    <span class="input-group-text">Months</span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check form-switch p-3 border rounded shadow-sm bg-light">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Training.isMandatory">
                                    <label class="form-check-label fw-bold" asp-for="Training.isMandatory">Mandatory</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch p-3 border rounded shadow-sm bg-light">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Training.isActive">
                                    <label class="form-check-label fw-bold" asp-for="Training.isActive">Active Status</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>