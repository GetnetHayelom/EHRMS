@page
@model PIS2.Pages.Department.EditModel

@{
    ViewData["Title"] = "Edit Department";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold mb-3">Departments</h1>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white fw-bold">
                Update Department
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <input type="hidden" asp-for="departmentModel.departmentID" />

                   <div class="mb-3">
                        <label asp-for="departmentModel.departmentShort" class="form-label">Department Alias</label>
                        <input asp-for="departmentModel.departmentShort" class="form-control" />
                        <span asp-validation-for="departmentModel.departmentShort" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="departmentModel.departmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
                        <input asp-for="departmentModel.departmentName" class="form-control" />
                        <span asp-validation-for="departmentModel.departmentName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="departmentModel.departmentStatus" class="form-label">Status</label>
                        <select asp-for="departmentModel.departmentStatus" class="form-select" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                        <span asp-validation-for="departmentModel.departmentStatus" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="departmentModel.subAccountID" class="form-label">Sub-Account</label>
                        <select asp-for="departmentModel.subAccountID" class="form-select" asp-items="ViewBag.subAccountID"></select>
                        <span asp-validation-for="departmentModel.subAccountID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="departmentModel.companyID" class="form-label">Company</label>
                        <select asp-for="departmentModel.companyID" class="form-select" asp-items="ViewBag.companyID"></select>
                        <span asp-validation-for="departmentModel.companyID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Manager</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="EmployeeID" value="@Model.departmentModel.employmentModel?.givenID" required placeholder="Enter ID" />
                            <input type="hidden" class="form-control" id="employmentID" asp-for="departmentModel.employmentID"/>
                            <button class="btn btn-outline-secondary" type="button" id="lookupButton" onclick="fetchEmployeeData($('#EmployeeID').val())">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                        <div id="statusMessage" class="mt-1"></div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-success" />
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.DepartmentHistories?.Any() == true)
    {
        <div class="col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-info text-white fw-bold">
                    Department Record History
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Department Name</th>
                                <th>Status</th>
                                <th>Department Head</th>
                                <th>Modified By</th>
                                <th>Modified Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.DepartmentHistories)
                            {
                                <tr>
                                    <td>@item.departmentName</td>
                                    <td>@item.departmentStatus</td>
                                    <td>@item.employmentModel?.personModel?.personFullName</td>
                                    <td>@item.modifiedBy</td>
                                    <td>@item.modifiedDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


</div>

<div class="mt-2">
    <a asp-page="./Index" class="text-decoration-none">&larr; View All Departments</a>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/js/employeeLookup.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
