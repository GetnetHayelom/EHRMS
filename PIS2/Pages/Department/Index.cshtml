@page
@model PIS2.Pages.Department.IndexModel

@{
    ViewData["Title"] = "Department";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Departments</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Department</a>    
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Department Alias
            </th>
            <th>
                Department Name
            </th>
            <th>
                Status
            </th>
            <th>
                Sub-Account
            </th>
            <th>
                Company
            </th>
            <th>
                Manager
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.departmentModel) {
        <tr onclick="location.href='@Url.Page("Details", new{id = item.departmentName})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.departmentShort)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.departmentName)
            </td>
            <td>
                    @if(item.departmentStatus == Models.mainStatus.Active)
                    {
                        <p class="fw-bold text-success">@Html.DisplayFor(modelItem => item.departmentStatus)</p>
                    }
                    else
                    {
                        <p class="fw-bold text-danger">@Html.DisplayFor(modelItem => item.departmentStatus)</p>
                    }
                    
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.subAccountModel.subAccountDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.companyModel.companyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.personModel.personFullName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.departmentID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.departmentID">Details</a>
                
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("print")
</div>
<script>
   </script>