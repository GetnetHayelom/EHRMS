@page
@using PIS2.Enums
@model PIS2.Pages.Department.IndexModel

@{
    ViewData["Title"] = "Department";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">Departments</h2>
        <h6 class="text-muted">Departments Catalogue</h6>
    </div>

    <p class="d-print-none">
        <a asp-page="Create" class="btn btn-primary">Add New Department</a>
    </p>
</div>

<div class="card shadow-sm p-2 m-2">
    <div class="d-flex d-print-flex gap-3 align-items-end">
        <div class="flex-fill mb-2">
            <label class="form-label fw-bold">Status</label>
            <select id="statusFilter" class="form-select" asp-items="@Html.GetEnumSelectList<mainStatus>()">
                <option value="" selected>-- All Statuses --</option>
            </select>
        </div>
        <div class="flex-fill mb-2">
            <label class="form-label fw-bold">Company</label>
            <select id="companyFilter" class="form-select">
                <option value="">-- All Companies --</option>
                @foreach (var company in Model.Companies)
                {
                    <option value="@company.companyID">@company.companyName</option>
                }
            </select>
        </div>
        <div class="flex-fill d-flex justify-content-end d-print-none">
            <div class="me-2">@await Html.PartialAsync("filter")</div>
            @await Html.PartialAsync("print")
            <excel-export table="dataTable" filename="Department_@(DateTime.UtcNow).xlsx"></excel-export>
        </div>
    </div>
</div>

<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Department Name
            </th>
            <th>
                Department Alias
            </th>
            
            <th>
                Status
            </th>
            <th>
                Sub-Account
            </th>
            <th>
                Company
            </th>
            <th>
                Manager
            </th>
            <th class="d-print-none">Action</th>
        </tr>
    </thead>
    <tbody>
        @await Html.PartialAsync("_DepartmentsPartial", Model.departmentModel)      
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
    
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function() {
        $('#companyFilter, #statusFilter').on('change', function () {
            var companyId = $('#companyFilter').val();
            var status = $('#statusFilter').val();

            $.ajax({
                url: '@Url.Page("Index", "Filter")',
                type: 'GET',
                data: { companyId: companyId, status: status },
                success: function (result) {
                    $('#dataTable').find('tbody').html(result);
                },
                error: function () {
                    alert('Failed to filter departments.');
                }
            });
        });
    });
</script>

  