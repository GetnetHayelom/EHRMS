@page
@model PIS2.Pages.Department.DetailsModel

@{
    ViewData["Title"] = "Department Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Department</h1>

<div>
    <h4>Department Details</h4>
    <hr />
    <dl class="d-flex justify-content-between">
        <div class="flex-grow-0 m-1 ">
            <dt class="">
                Department Alias:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.departmentShort)
            </dd>
        </div>
        <div class="flex-grow-0 m-1">
            <dt class="">
                Department Name:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.departmentName)
            </dd>
        </div>
        <div class="m-1">
            <dt class="">
                Status:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.departmentStatus)
            </dd>
        </div>
        <div class="m-1">
            <dt class="">
                Sub-Account:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.subAccountModel.subAccountDescription)
            </dd>
        </div>
        <div class="m-1">
            <dt class="">
                Company:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.companyModel.companyName)
            </dd>
        </div>
        <div class="m-1">
            <dt class="">
                Manager:
            </dt>
            <dd class="">
                @Html.DisplayFor(model => model.departmentModel.employmentID)
            </dd>
        </div>
    </dl>
    <hr />
</div>
<div>
    <!-- Summary Points -->
    <div class="row d-flex flex-inline justify-content-center">
        
        <!--EMPLOYMENTS-->
        <div class="p-2 border borber-1 rounded-2 border-primary col-3 m-2">
            <div class="w-100">
                <div class="d-flex">
                    <h5 class="flex-grow-1 border border-success border-2 rounded-start text-success p-1">Active Employees</h5>
                    <h2 class="bg-success text-white rounded-end p-1">@Model.DepartmentSummary.Employees</h2>
                </div>

                <div class="d-flex">
                    <h6 class="flex-grow-1 border border-danger border-2 rounded-start text-danger p-1">Former Employees</h6>
                    <h4 class="bg-danger text-white rounded-end p-1">@Model.DepartmentSummary.xEmployees</h4>
                </div>
                <div class="d-flex">
                    <h6 class="flex-grow-1 border border-info border-2 rounded-start text-info p-1">Total Number of Employee</h6>
                    <h4 class="bg-info text-white rounded-end p-1">@Model.Employments.Count()</h4>
                </div>
            </div>
        </div>
        <div class="p-2 border borber-1 rounded-2 border-primary col-2 m-2">
            <div class="w-100">
                @foreach (var item in Model.EmploymentTypes)
                {
                    <div class="d-flex">
                        <h5 class="flex-grow-1 border border-success border-2 rounded-start text-success p-1">@item.zName</h5>
                        <h2 class="bg-success text-white rounded-end p-1">@item.zCount</h2>
                    </div>

                }
                <div class="d-flex">
                    <h6 class="flex-grow-1 border border-info border-2 rounded-start text-info p-1">Employees On Leave</h6>
                    <h4 class="bg-info text-white rounded-end p-1">@Model.leaveEmployments</h4>
                </div>
            </div>
        </div>
    </div>
    <!--Payables summary-->

    <h3>Current Payable</h3><hr />
    <div class="d-flex flex-wrap justify-content-between p-2">
        <div class="">
            <p class="small mb-1">Salary</p>
            <h5 class="fw-bold">$@Math.Round((Model.DepartmentSummary.Salary), 2).ToString("N0")</h5>
        </div>
        <div>
            <p class="small mb-1">Overtime</p>
            <h5 class="fw-bold">$@Math.Round((Model.DepartmentSummary.Salary), 2).ToString("N0")</h5>
        </div>
        <div>
            <p class="small mb-1">Acc. Leaves</p>
            <h5 class="fw-bold">$@Math.Round((Model.leaveCost), 2).ToString("N0")</h5>
        </div>
        <div>

            <p class="small mb-1">Allowance</p>
            <h5 class="fw-bold">$@Math.Round((Model.DepartmentSummary.Salary), 2).ToString("N0")</h5>
        </div>
        <div>
            <p class="small mb-1">Total</p>
            <h4 class="fw-bold">$@Math.Round((Model.DepartmentSummary.Salary), 2).ToString("N0")</h4>
        </div>
    </div>
    <hr />
</div>
<div class="">
    <h3><b>Active Employees</b></h3>
    <table class="table table-striped table-hover">
        <thead class="bg-dark text-white">
            <tr>
                <th>Employee ID</th>
                <th> Name</th>
                <th> Job Title</th>
                <th> Salary</th>
                <th> Allowed Leave</th>
                <th> Shift</th>
                <th> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model.EmploymentView)
            {
                <tr>
                    <td>
                        @item.Employment.givenID
                    </td>
                    <td>
                        @item.Person.personFullName
                    </td>
                    <td>
                        @item.Job.jobModel.jobTitle
                    </td>
                    <td>
                        @item.Job.jobPlacementSalary
                    </td>
                    <td>
                        
                    </td>
                    <td>
                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.departmentModel.departmentID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
