@page
@model PIS2.Pages.Department.DeleteModel

@{
    ViewData["Title"] = "Delete Department";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Departments</h1>

<h3>Are you sure you want to delete this department?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Department Alias:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.departmentShort)
        </dd>
        <dt class="col-sm-2">
            Department Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.departmentName)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.departmentStatus)
        </dd>
        <dt class="col-sm-2">
            Sub-Account:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.subAccountModel.subAccountDescription)
        </dd>
        <dt class="col-sm-2">
            Company:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.companyModel.companyName)
        </dd>
        <dt class="col-sm-2">
            Manager:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.departmentModel.employmentID)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="departmentModel.departmentID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
