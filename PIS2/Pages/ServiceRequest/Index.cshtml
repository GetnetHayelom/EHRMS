@page
@model PIS2.Pages.ServiceRequest.IndexModel

@{
    ViewData["Title"] = "Service Requests";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-dark mb-0">Service Requests</h1>
        <p class="text-muted mb-0">Manage and track employee service requests</p>
    </div>

    <a asp-page="Create" class="btn btn-primary d-print-none">
        + Create New
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4 d-print-none">
    <div class="card-body">
        <form class="row g-3">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Company</label>
                <select class="form-select" id="filter-company" onchange="filter()" asp-items="Model.Companies">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Department</label>
                <select class="form-select" id="filter-department" onchange="filter()">
                    <option value="">All</option>

                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Status</label>
                <select class="form-select" id="filter-status" onchange="filter()"
                        asp-items="Html.GetEnumSelectList<Models.ServiceRequestStatus>()">
                    <option value="">All</option>
                </select>
            </div>
            
           
            <div class="col-md-2">
                <label class="form-label fw-semibold">Date From</label>
                <input class="form-control" type="date" id="dateStart"
                       onchange="filter()" asp-for="StartDate" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Date To</label>
                <input class="form-control" type="date" id="dateEnd"
                       onchange="filter()" asp-for="EndDate" />
            </div>

        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Employee ID</th>
                    <th>Requested Service</th>
                    <th>Requested By</th>
                    <th>Request Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.serviceRequestModel)
                { 
                    string badgeClass = item.serviceRequestStatus switch
                    {
                        Models.ServiceRequestStatus.Hold => "bg-warning text-dark",
                        Models.ServiceRequestStatus.Completed => "bg-success",
                        Models.ServiceRequestStatus.Reviewed => "bg-primary",
                        _ => "bg-secondary"
                    };

                    string UrlTo = item.requestedService switch
                    {

                        Models.ServiceRequestTypes.Experience => "/Experience/Index?id=" + item.Employment?.personID,
                        Models.ServiceRequestTypes.Guaranty => "/Guaranty/Create?id=" + item.Employment?.personID,
                        Models.ServiceRequestTypes.Termination => "/Termination/Details?id=" + item.employmentID,
                        _ => "Details/id="+ item.serviceRequestID

                    };

                    <tr onclick="location.href='@UrlTo'"
                        style="cursor:pointer">
                        <td>@item.Employment?.givenID</td>
                        <td>@item.requestedService</td>
                        <td>@item.modifiedBy</td>
                        <td>@item.serviceRequestDate</td>
                        <td>
                            <span class="badge @badgeClass">
                                @item.serviceRequestStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Print -->
<div class="d-flex justify-content-end mt-3">
    @await Html.PartialAsync("print")
</div>

<script>
    function filter() {
        const params = new URLSearchParams({
            status: document.getElementById("filter-status").value,
            department: document.getElementById("filter-department").value,
            company: document.getElementById("filter-company").value,
            workLoc: document.getElementById("filter-workLoc").value,
            startDate: document.getElementById("dateStart").value,
            endDate: document.getElementById("dateEnd").value
        });

        window.location.href = `/ServiceRequest/Index?${params.toString()}`;
    }
</script>
