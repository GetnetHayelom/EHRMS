@page
@model PIS2.Pages.ServiceRequest.IndexModel

@{
    ViewData["Title"] = "Service Requests";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@Html.AntiForgeryToken()
@await Html.PartialAsync("headerSimple","")
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Service Requests</h2>
        <p class="text-muted mb-0">Manage and track employee service requests</p>
    </div>
</div>
<div class="card shadow-sm border-0 mb-4 d-print-none">
    <div class="card-body">
        <form class="row g-3">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Company</label>
                <select class="form-select" id="filter-company" asp-items="Model.Companies" onchange="filter()">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Department</label>
                <select class="form-select" id="filter-department" onchange="filter()">
                    <option value="">All</option>

                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Type</label>
                <select class="form-select" id="filter-type" asp-items="@Model.RequestTypes" onchange="filter()">
                    <option value="">All</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Status</label>
                <select class="form-select" id="filter-status"
                        asp-items="Html.GetEnumSelectList<Models.ServiceRequestStatus>()" onchange=" filter()">
                    <option value="">All</option>
                </select>
            </div>


            <div class="col-md-2">
                <label class="form-label fw-semibold">Date From</label>
                <input class="form-control" type="date" id="dateStart" asp-for="StartDate" onchange="filter()" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Date To</label>
                <input class="form-control" type="date" id="dateEnd" asp-for="EndDate" onchange="filter()" />
            </div>

        </form>
    </div>
</div>
@if(Model.serviceRequestModel.Any())
{
    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>S/No</th>
                        <th>Employee ID</th>
                        <th>Requested Service</th>
                        <th>Requested By</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th class="d-print-none text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                    }
                    @foreach (var item in Model.serviceRequestModel)
                { 
                    string badgeClass = item.serviceRequestStatus switch
                    {
                        Models.ServiceRequestStatus.Hold => "bg-warning text-dark",
                        Models.ServiceRequestStatus.Completed => "bg-success",
                        Models.ServiceRequestStatus.Reviewed => "bg-primary",
                        _ => "bg-secondary"
                    };

                    <tr onclick="update(this)"
                        style="cursor:pointer" data-id="@item.serviceRequestID">
                        <td>@(index++)</td>
                        <td>@item.Employment?.givenID</td>
                        <td>@item.ServiceRequestType?.serviceRequestTypeName</td>
                        <td>@item.modifiedBy</td>
                        <td>@item.serviceRequestDate</td>
                        <td>
                            <span class="badge @badgeClass">
                                @item.serviceRequestStatus
                            </span>
                        </td>
                            <td class="d-print-none text-end px-4">
                            <div class="btn-group" role="group">
                                <a asp-page="./Details" asp-route-id="@item.serviceRequestID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.serviceRequestID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

    <!-- Print -->
    <div class="d-flex justify-content-end mt-3">
        @await Html.PartialAsync("print")
    </div>
}
else
{
    <h6> The are no request records!</h6>
}
<!-- Filters -->


<script>
    function filter() {
        const params = new URLSearchParams({
            reqStatus: document.getElementById("filter-status").value,
            department: document.getElementById("filter-department").value,
            company: document.getElementById("filter-company").value,
            reqType: document.getElementById("filter-type").value,
            startDate: document.getElementById("dateStart").value,
            endDate: document.getElementById("dateEnd").value
        });

        window.location.href = `/ServiceRequest/Index?${params.toString()}`;
    }

    async function update(row){
        const id = row.dataset.id;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const response = await fetch('/ServiceRequest/Index?handler=Update&id='+id,
        {
            method:"POST",
            headers:{"RequestVerificationToken": token}
        });
        
        if (!response.ok) {
            showToast("Error", "Request failed");
            window.location.href='/ServiceRequest/Details/id='+id;
            return;
        }

        const res = await response.json();

        if(!res.success){window.location.href='/ServiceRequest/Details/id=${id}';}

            let urlTo;

            switch (res.type) {
                case "Experience":
                    urlTo = `/Experience/Index?id=${res.prsnID}`;
                    break;

                case "Guaranty":
                    urlTo = `/Guaranty/Create?id=${res.prsnID}`;
                    break;

                case "Termination":
                    urlTo = `/Termination/Create?id=${res.empID}`;
                    break;

                default:
                
                    urlTo = `/ServiceRequest/Details?id=${id}`;
            }

            window.location.href = urlTo;
    
    }
</script>
