@page
@model PIS2.Pages.ServiceRequest.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold text-dark mb-0">Service Requests</h2>
<p class="text-muted">Request Details</p>
<hr />
<div class="d-flex gap-4">
  
    <dl class="card shadow-sm p-2 col-md-4 row">
        <dt class="col-sm-6">
            Employee ID:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.serviceRequestModel.Employment.givenID)
        </dd>
        <dt class="col-sm-6">
            Employee Name:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.serviceRequestModel.Employment.personModel.personFullName)
        </dd>
        <dt class="col-sm-6">
            Request Type:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.serviceRequestModel.ServiceRequestType.serviceRequestTypeName)
        </dd>
        <dt class="col-sm-6">
            Status:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.serviceRequestModel.serviceRequestStatus)
        </dd>
        <dt class="col-sm-6">
            Request Date:
        </dt>
        <dd class="col-sm-6">
            @Html.DisplayFor(model => model.serviceRequestModel.serviceRequestDate)
        </dd>
    </dl>

    <div class="card shadow-sm p-2 flex-fill">
        <div class="card-header"> <h6 card="fw-bold">Request History</h6></div>
        <div class="card-body">
            <table class="table table-striped table-hover print-full-width">
                <thead class="text-white bg-dark">
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.RequestHistory)
                    {
                        <tr>
                            <td>@item.modifiedDate</td>
                            <td>@item.modifiedBy</td>
                            <td>@item.serviceRequestStatus</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
       

    </div>
</div>
<div class="d-flex justify-content-end m-2 gap-2 d-print-none">
    <a class="btn btn-secondary" asp-page="./Index">Back</a>
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.serviceRequestModel.serviceRequestID">Edit</a>
    
</div>
