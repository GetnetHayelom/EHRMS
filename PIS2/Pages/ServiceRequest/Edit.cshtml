@page
@model PIS2.Pages.ServiceRequest.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold text-dark mb-0">Service Requests</h2>
<p class="text-muted">@L.T("Update") Service Request Status</p>
<hr />
<div class="d-flex gap-4">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="serviceRequestModel.serviceRequestID" />
            <dl class="card shadow-sm p-2 row">
                <dt class="col-sm-6">
                    Employee ID:
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.serviceRequestModel.Employment.givenID)
                </dd>
                <dt class="col-sm-6">
                    Employee Name:
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.serviceRequestModel.Employment.personModel.personFullName)
                </dd>
                <dt class="col-sm-6">
                    Request Type:
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.serviceRequestModel.ServiceRequestType.serviceRequestTypeID)
                </dd>
                <dt class="col-sm-6">
                    Status:
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.serviceRequestModel.serviceRequestStatus)
                </dd>
                <dt class="col-sm-6">
                    Request Date:
                </dt>
                <dd class="col-sm-6">
                    @Html.DisplayFor(model => model.serviceRequestModel.serviceRequestDate)
                </dd>
            </dl>
            <div class="form-group">
                <label asp-for="serviceRequestModel.serviceRequestStatus" class="control-label">Select Status</label>
                <select asp-for="serviceRequestModel.serviceRequestStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Enums.ServiceRequestStatus>()"></select>
                <span asp-validation-for="serviceRequestModel.serviceRequestStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group justify-content-end m-2">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>


    <div class="card shadow-sm p-2 flex-fill">
        <div class="card-header"> <h6 card="fw-bold">Request History</h6></div>
        <div class="card-body">
            <table class="table table-striped table-hover print-full-width">
                <thead class="text-white bg-dark">
                    <tr>
                        <th>Date</th>
                        <th>User</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RequestHistory)
                    {
                        <tr>
                            <td>@item.modifiedDate</td>
                            <td>@item.modifiedBy</td>
                            <td>@item.serviceRequestStatus</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
</div>
</div>
<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
