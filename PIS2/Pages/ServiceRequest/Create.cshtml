@page
@model PIS2.Pages.ServiceRequest.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>serviceRequestModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="serviceRequestModel.employmentID" class="control-label"></label>
                <select asp-for="serviceRequestModel.employmentID" class ="form-control" asp-items="ViewBag.employmentID"></select>
            </div>
            <div class="form-group">
                <label asp-for="serviceRequestModel.requestedService" class="control-label"></label>
                <select asp-for="serviceRequestModel.requestedService" class="form-control"></select>
                <span asp-validation-for="serviceRequestModel.requestedService" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="serviceRequestModel.serviceRequestStatus" class="control-label"></label>
                <select asp-for="serviceRequestModel.serviceRequestStatus" class="form-control"></select>
                <span asp-validation-for="serviceRequestModel.serviceRequestStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="serviceRequestModel.modifiedBy" class="control-label"></label>
                <input asp-for="serviceRequestModel.modifiedBy" class="form-control" />
                <span asp-validation-for="serviceRequestModel.modifiedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
