@page "{id:int}"
@model PIS2.Pages.Notice.DetailsModel
@{
    ViewData["Title"] = "Notice Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-primary fw-bold">@Model.Notice.noticeTitle</h4>
            <span class="badge bg-@GetPriorityColor(Model.Notice.noticePriority)">
                @Model.Notice.noticePriority
            </span>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Notice.noticeSubTitle))
            {
                <h6 class="text-muted mb-3">@Model.Notice.noticeSubTitle</h6>
            }

            <div class="mb-4">
                <p class="text-secondary" style="white-space: pre-line;">@Model.Notice.noticeContent</p>
            </div>

            <dl class="row small mb-0">
                <dt class="col-sm-3">Posted By:</dt>
                <dd class="col-sm-9">@Model.Notice.noticePostedBy</dd>

                <dt class="col-sm-3">Approved By:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeApprovedBy</dd>

                <dt class="col-sm-3">Notice From:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeFrom</dd>

                <dt class="col-sm-3">Date Posted:</dt>
                <dd class="col-sm-9">@Model.Notice.DatePosted.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">Expiry Date:</dt>
                <dd class="col-sm-9">
                    @(Model.Notice.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                </dd>

                <dt class="col-sm-3">Active:</dt>
                <dd class="col-sm-9">
                    @if (Model.Notice.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                @if (!string.IsNullOrEmpty(Model.Notice.AttachmentPath))
                {
                    <dt class="col-sm-3">Attachment:</dt>
                    <dd class="col-sm-9">
                        <a href="@Url.Content(Model.Notice.AttachmentPath)" class="btn btn-sm btn-outline-primary" target="_blank">
                            <i class="bi bi-paperclip"></i> View Attachment
                        </a>
                    </dd>
                }
            </dl>
        </div>

        <div class="card-footer bg-white d-flex justify-content-between">
            <div>
                <a asp-page="/Notice/Index" class="btn btn-outline-secondary d-print-none m-2">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
            
            <div class="d-flex justify-content-end"> 
                @await Html.PartialAsync("print")
                <div>
                    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
                    {
                        <a asp-page="/Notice/Edit" asp-route-id="@Model.Notice.noticeID" class="btn btn-primary d-print-none m-2">
                            <i class="bi bi-pencil"></i> Edit Notice
                        </a>
                    }
                    
                </div>
                
            </div>
            
            
        </div>
    </div>
</div>

@functions {
    string GetPriorityColor(PIS2.Models.Priority priority)
    {
        return priority switch
        {
            PIS2.Models.Priority.Low => "success",
            PIS2.Models.Priority.Medium => "warning",
            PIS2.Models.Priority.High => "danger",
            PIS2.Models.Priority.Urgent => "dark",
            _ => "secondary"
        };
    }
}
