@page "{id:int}"
@model PIS2.Pages.Notice.DetailsModel
@{
    ViewData["Title"] = "Notice Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="mb-0 text-primary fw-bold">@Model.Notice.noticeTitle</h4>
            <span class="badge bg-@GetPriorityColor(Model.Notice.noticePriority)">
                @Model.Notice.noticePriority
            </span>
        </div>

        <div class="card-body">
            <dl>
                <dt class="col-sm-3">Date Posted:</dt>
                <dd class="col-sm-9">@Model.Notice.DatePosted.ToString("MM/dd/yyyy")</dd>

                <dt class="col-sm-3">Notice From:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeFrom</dd>

                <dt class="col-sm-3">Notice To:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeTo</dd>
            </dl>
            @if (!string.IsNullOrEmpty(Model.Notice.noticeSubTitle))
            {
                <h5 class="fw-bold mb-2">@Model.Notice.noticeSubTitle</h5>
            }
            <div class="ql-editor" >
                @Html.Raw(Model.Notice.noticeContent)
            </div>        

            <dl class="row small mb-0">
                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeStatus</dd>

                <dt class="col-sm-3">Signed By:</dt>
                <dd class="col-sm-9">@Model.Notice.noticeSignedBy</dd>

                <dt class="col-sm-3">Expiry Date:</dt>
                <dd class="col-sm-9">
                    @(Model.Notice.ExpiryDate?.ToString("MM/dd/yyyy") ?? "—")
                </dd>

                <dt class="col-sm-3">Active:</dt>
                <dd class="col-sm-9">
                    @if (Model.Notice.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                @await Html.PartialAsync("_AttachmentPartial",
                new Pages.Shared.AttachmentPartialModel
                {
                    tableName = "Notice",
                    recordId = Model.Notice.noticeID
                })
            </dl>
        </div>

        <div class="card-footer bg-white">
            
            
            <div class="d-flex justify-content-end">
                <div>
                    <a asp-page="/Notice/Index" class="btn btn-outline-secondary d-print-none m-2">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
                @if (User.IsInRole("MIE\\PMS_HRMANAGER") && Model.Notice.noticeStatus == Models.NoticeStatus.Pending)
                {
                    <form method="post" asp-page-handler="Approve">
                        <input type="hidden" asp-for="Notice.noticeID" />
                        <button type="submit" class="btn btn-success m-2">
                            Approve
                        </button>
                    </form>
                }
                @if (User.IsInRole("MIE\\PMS_HRMANAGER") && (Model.Notice.noticeStatus == Models.NoticeStatus.Approved || Model.Notice.noticeStatus == Models.NoticeStatus.Posted))
                {
                    <form method="post" asp-page-handler="Expire">
                        <input type="hidden" asp-for="Notice.noticeID" />
                        <button type="submit" class="btn btn-danger m-2">
                            Expire
                        </button>
                    </form>
                }
                @await Html.PartialAsync("print")
                <div>
                    @if (User.IsInRole("MIE\\PMS_HRCLERK") && Model.Notice.noticeStatus == Models.NoticeStatus.Pending)
                    {
                        <a asp-page="/Notice/Edit" asp-route-id="@Model.Notice.noticeID" class="btn btn-primary d-print-none m-2">
                            <i class="bi bi-pencil"></i> Edit Notice
                        </a>
                    }
                    
                </div>
                
            </div>
        </div>
    </div>
</div>

@functions {
    string GetPriorityColor(PIS2.Models.Priority priority)
    {
        return priority switch
        {
            PIS2.Models.Priority.Low => "success",
            PIS2.Models.Priority.Medium => "warning",
            PIS2.Models.Priority.High => "danger",
            PIS2.Models.Priority.Urgent => "dark",
            _ => "secondary"
        };
    }
}
