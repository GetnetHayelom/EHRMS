@page
@model PIS2.Pages.Notice.EditModel
@{
    ViewData["Title"] = $"Edit Notice ID: {Model.Notice.noticeID}";
}
<h2 class="fw-bold">Notice and Announcements</h2>
<p class="text-muted mb-0">Update Existing Announcement / Notice #@Model.Notice.noticeID</p>

<div class="container mt-2">
    <div class="card shadow-lg border-0">
        
        <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.StatusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <!-- CRUCIAL: Hidden input to pass the ID back on POST -->
                <input type="hidden" asp-for="Notice.noticeID" />

                <!-- Title & Sub-Title -->
                <div class="row mb-3">
                    <div class="col-md-7">
                        <label asp-for="Notice.noticeTitle" class="form-label"></label>
                        <input asp-for="Notice.noticeTitle" class="form-control" />
                        <span asp-validation-for="Notice.noticeTitle" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Notice.noticeSubTitle" class="form-label"></label>
                        <input asp-for="Notice.noticeSubTitle" class="form-control" />
                        <span asp-validation-for="Notice.noticeSubTitle" class="text-danger"></span>
                    </div>
                </div>

                <!-- Content (Main Section) -->
                <div class="row mb-3">
                    <div class="col-12">
                        <label for="editor">Content</label>

                        @await Html.PartialAsync("_EditorHeader")
                        <!-- Hidden input for form -->
                        <input type="hidden" id="letterBody" asp-for="Notice.noticeContent" />
                        <span asp-validation-for="Notice.noticeContent" class="text-danger"></span>
                    </div>
                </div>

                <!-- Priority, Date Posted, Expiry Date -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Notice.noticePriority" class="form-label"></label>
                        <select asp-for="Notice.noticePriority" asp-items="@Html.GetEnumSelectList<Models.Priority>()" class="form-control">
                            <option value="">Select Priority</option>
                        </select>
                        <span asp-validation-for="Notice.noticePriority" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Notice.DatePosted" class="form-label"></label>
                        <input asp-for="Notice.DatePosted" class="form-control" type="date" />
                        <span asp-validation-for="Notice.DatePosted" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Notice.ExpiryDate" class="form-label"></label>
                        <input asp-for="Notice.ExpiryDate" class="form-control" type="date" />
                        <span asp-validation-for="Notice.ExpiryDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Posted By, Approved By, Notice From -->
                <div class="row mb-4">
                    
                    <div class="col-md-4">
                        <label asp-for="Notice.noticeFrom" class="form-label">From</label>
                        <input asp-for="Notice.noticeFrom" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Notice.noticeTo" class="form-label">To</label>
                        <input asp-for="Notice.noticeTo" class="form-control" />
                    </div>
                    <!-- Selector -->
                    <div class="col-md-4">
                        <label asp-for="Notice.noticeSignedBy" class="form-label">Signed By</label>
                        
                        <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.Notice.noticeSignedBy" />
                        <input type="hidden" asp-for="Notice.noticeSignedBy" id="personIDHidden" value="@Model.Notice.noticeSignedBy"/>
                        <datalist id="personList">
                            @foreach (var person in Model.PersonList)
                            {
                                <option data-id="@person.Text" value="@person.Text"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Notice.noticeSignedBy" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActiveSwitch" asp-for="Notice.IsActive">
                            <label class="form-check-label" for="isActiveSwitch" asp-for="Notice.IsActive"></label>
                        </div>
                    </div>
                </div>

                <hr />

 
                <!-- Submission Button -->
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <div>
                        <a asp-page="/Notice/Index" class="btn btn-outline-secondary d-print-none m-2">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                    
                    @if (Model.Notice.noticeStatus == Models.NoticeStatus.Pending) {
                        <button type="submit" class="btn btn-success m-2">
                            <i class="fas fa-save me-2"></i> Update Notice
                    </button>
                    }
                    
                    <a asp-page="/Notice/Details" asp-route-id="@Model.Notice.noticeID" class="btn btn-primary m-2">View</a>
                    <a asp-page="/Notice/Index" class="btn btn-secondary m-2">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>
@await Html.PartialAsync("_AttachmentPartial",
new Pages.Shared.AttachmentPartialModel
{
    tableName = "Notice",
    recordId = Model.Notice.noticeID
})
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="/lib/quill/quill.min.js"></script>
    <script src="/js/quill-editor.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.initQuillEditor({
                editorId: 'editor',
                hiddenInputId: 'letterBody',
                initialContent: '@Html.Raw(Model.Notice.noticeContent)'
            });
        });
    </script>
}

