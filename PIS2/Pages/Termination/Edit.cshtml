@page
@model PIS2.Pages.Termination.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employment</h1>

<h6 class="fw-bold text-muted">@L.T("Update") Termination</h6>
<hr />
<div class="d-flex gap-4">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="terminationModel.terminationID" />
            <input asp-for="terminationModel.modifiedBy" type="hidden" value="@User.Identity.Name"/>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="terminationModel.employmentID" class="control-label">Employee ID</label>
                <select asp-for="terminationModel.employmentID" class="form-control" asp-items="ViewBag.employmentID"></select>
                <span asp-validation-for="terminationModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationDate" class="control-label">Termination Date</label>
                <input asp-for="terminationModel.terminationDate" class="form-control" type="date"/>
                <span asp-validation-for="terminationModel.terminationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationReason" class="control-label">Reason</label>
                <input asp-for="terminationModel.terminationReason" class="form-control" />
                <span asp-validation-for="terminationModel.terminationReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationRemark" class="control-label">Remark</label>
                <input asp-for="terminationModel.terminationRemark" class="form-control" />
                <span asp-validation-for="terminationModel.terminationRemark" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationStatus" class="control-label">Status</label>
                <select asp-for="terminationModel.terminationStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Enums.terminationStatus>()"></select>
                <span asp-validation-for="terminationModel.terminationStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value='@L.T("Save")' class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    <div class="card shadow-sm text-center mt-3">
        <div class="card-header bg-success text-white"><h4 class="fw-bold"><u>@Model.terminationModel?.EmploymentModel?.personModel?.personFullName</u></h4></div>
        <div class="card-body text-start">
            <strong>Position:</strong> <span>@Model.terminationModel.EmploymentModel?.employmentPosition</span><br />
            <strong>Job Title:</strong> <span>@Model.jobPlacement?.jobModel?.jobTitle</span><br />
            <strong>Salary:</strong> <span>@Model.jobPlacement?.jobPlacementSalary.ToString("N2")</span><br />
            <strong>Department:</strong> <span>@Model.jobPlacement?.departmentModel?.departmentName</span><br />
            <strong>Company:</strong> <span>@Model.jobPlacement?.departmentModel?.companyModel?.companyName</span>
        </div>

    </div>
    <div class="flex-fill d-flex gap-3">
        <div class="card shadow-sm text-center mt-3">
            <div class="card-header bg-warning text-white">
                <h6 class="fw-bold mb-1"> Severance Pay</h6>
            </div>
            <div class="card-body">
                <h4 class="card-body fw-bold">@Model.SeverancePay.ToString("N2")</h4>
            </div>
            <div class="card-footer text-muted"><p class="fw-bold">Year of Service: @Model.YearsOfService.ToString("N2")</p></div>
        </div>

        <div class="card shadow-sm text-center mt-3">
            <div class="card-header bg-info text-white"><h6 class="fw-bold mb-1">Leave Payable</h6></div>
            <div class="card-body"><h4 class="card-body fw-bold">@(Model.LeaveSummary?.adjustedLeaveBalanceCost.ToString("N2") ?? "0.00")</h4></div>
            <div class="card-footer  text-muted"><p class="fw-bold">Leave Balance: @(Math.Round(Model.LeaveSummary?.adjustedLeaveBalance ?? 0, 2))</p></div>
        </div>
    </div>
</div>


<div>
    <a asp-page="./Index">View All Termination</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
