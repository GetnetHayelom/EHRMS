@page
@model PIS2.Pages.Termination.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employment</h1>

<h4 class="fw-bold">Update Termination</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="terminationModel.terminationID" />
            <input asp-for="terminationModel.modifiedBy" type="hidden" value="@User.Identity.Name"/>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="terminationModel.employmentID" class="control-label">Employee ID</label>
                <select asp-for="terminationModel.employmentID" class="form-control" asp-items="ViewBag.employmentID"></select>
                <span asp-validation-for="terminationModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationDate" class="control-label">Termination Date</label>
                <input asp-for="terminationModel.terminationDate" class="form-control" type="date"/>
                <span asp-validation-for="terminationModel.terminationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationReason" class="control-label">Reason</label>
                <input asp-for="terminationModel.terminationReason" class="form-control" />
                <span asp-validation-for="terminationModel.terminationReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationRemark" class="control-label">Remark</label>
                <input asp-for="terminationModel.terminationRemark" class="form-control" />
                <span asp-validation-for="terminationModel.terminationRemark" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="terminationModel.terminationStatus" class="control-label">Status</label>
                <select asp-for="terminationModel.terminationStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Models.terminationStatus>()"></select>
                <span asp-validation-for="terminationModel.terminationStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Termination</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
