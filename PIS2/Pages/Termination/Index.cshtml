@page
@model PIS2.Pages.Termination.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employment</h1>
<h4 class="fw-bold">Terminations</h4>
<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Termination Date
            </th>
            <th>
                Termination Reason
            </th>
            <th>
                Termination Remark
            </th>
            <th>
                Termination Status
            </th>
            <th>
                Modified By
            </th>
            <th>Modified Date</th>
        </tr>
    </thead>
    <tbody id="tbody">
@foreach (var item in Model.terminationModel) {
        <tr onclick="location.href='@Url.Page("Edit", new {id = item.terminationID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.EmploymentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationReason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationRemark)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.terminationID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.terminationID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.terminationID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
