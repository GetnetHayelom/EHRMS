@page
@model PIS2.Pages.Termination.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Terminations</h1>
<p>
    <a asp-page="Create" class="btn btn-primary">Create New Termination</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Termination Date
            </th>
            <th>
                Termination Reason
            </th>
            <th>
                Termination Remark
            </th>
            <th>
                Termination Status
            </th>
            <th>
                Modified By
            </th>

        </tr>
    </thead>
    <tbody id="tbody">
@foreach (var item in Model.terminationModel) {
        <tr onclick="location.href='@Url.Page("Details", new {id = item.terminationID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.EmploymentModel.givenID)
            </td>
            <td>
                @item.terminationDate.ToString("yyyy-MM-dd")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationReason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationRemark)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.terminationStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>

        </tr>
}
    </tbody>
</table>
