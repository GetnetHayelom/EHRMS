@page
@model PIS2.Pages.Termination.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between mb-4">
    <h1 class="fw-bold">Terminations</h1>
    @if (User.IsInRole("MIE\\PMS_HRCLERK"))
    {
        <p>
            <a asp-page="Create" class="btn btn-primary">New Termination</a>
        </p>
    }
</div>

@{
    int others = Model.total - Model.management - Model.professional;
}
<!-- Summary Cards -->
<div class="card shadow-sm mb-4 p-2">
    <div class="d-flex gap-3 mb-4 d-print-flex" id="summaryRow">
        <div class="flex-fill">
            <div class="card shadow-sm border-start border-primary border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Total</small>
                            <h3 class="mb-0">@Model.total</h3>
                        </div>
                        <div><i class="bi bi-people fs-2 text-primary"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-success border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Male</small>
                            <h3 class="mb-0">@Model.male</h3>
                        </div>
                        <div><i class="bi bi-gender-male fs-2 text-success"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-danger border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Female</small>
                            <h3 class="mb-0">@Model.female</h3>
                        </div>
                        <div><i class="bi bi-gender-female fs-2 text-danger"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-warning border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Management</small>
                            <h3 class="mb-0">@Model.management</h3>
                        </div>
                        <div><i class="bi bi-briefcase fs-2 text-warning"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-info border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Professional</small>
                            <h3 class="mb-0">@Model.professional</h3>
                        </div>
                        <div><i class="bi bi-award fs-2 text-info"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex-fill">
            <div class="card shadow-sm border-start border-muted border-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Others</small>
                            <h3 class="mb-0"> @others</h3>
                        </div>
                        <div><i class="bi bi-gear fs-2 text-muted"></i></div>
                    </div>
                </div>
            </div>
        </div>


    </div>
</div>

<!-- Filter Form -->
<div class="card p-3 mb-3">
    <form method="get" id="filterForm" class="row g-3 align-items-end d-print-flex">
        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Company</label>
            <select asp-for="CompanyID" class="form-select" id="filter-company">
                <option value="">All</option>
                @foreach (var c in Model.Companies)
                {
                    <option value="@c.companyID">@c.companyName</option>
                }
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Department</label>
            <select asp-for="DepartmentID" class="form-select" id="filter-department">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues(typeof(PIS2.Models.terminationStatus)).Cast<PIS2.Models.terminationStatus>())
                {
                    <option value="@( (int)s )">@s</option>
                }
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Job Class</label>
            <select asp-for="jClass" class="form-select">
                <option value="">All</option>
                @foreach (var jc in Model.JobClasses)
                {
                    <option value="@jc.jobClassId">@jc.jobClassName</option>
                }
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Reason</label>
            <select asp-for="Reason" class="form-select">
                <option value="">All</option>
                @foreach (var r in Model.Reasons)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">Category</label>
            <select name="Category" class="form-select">
                <option value="">All</option>
                @foreach (var jc in Model.JobCategories)
                {
                    <option value="@jc.jobCategoryID">@jc.jobCategoryName</option>
                }
            </select>
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">From</label>
            <input asp-for="From" type="date" class="form-control" />
        </div>

        <div class="col-auto mb-2">
            <label class="form-label fw-bold">To</label>
            <input asp-for="To" type="date" class="form-control" />
        </div>

        <div class="col-auto mb-2 d-print-none">
            <button type="submit" class="btn btn-primary">Load</button>
        </div>
        <div class="col-auto mb-2 d-prtin-none">
            <button type="button" class="btn btn-outline-secondary" id="resetBtn">Reset</button>
        </div>
        <div class="col-auto d-print-none">
            @await Html.PartialAsync("print")
        </div>
        <div class="col-auto d-print-none">
            <excel-export table="dataTable" filename="Termination_Report_@(DateTime.Now).xlsx"></excel-export>
        </div>
        <div class="col-auto">@await Html.PartialAsync("filter")</div>
    </form>
</div>

<table class="table table-hover table-striped print-full-width" id="dataTable">
    <thead class="table-dark">
        <tr>
            <th>Employee</th>
            <th>Gender</th>           
            <th>Job Category</th>
            <th>Job Class</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @{
            int index = 0;
        }
        @foreach (var comp in Model.terminationModel.GroupBy(t =>
                t.companyID))
        {
            index++;
            <tr class="table-primary fw-bold">
                <td colspan="9">@(index). @comp.FirstOrDefault().companyName</td>
            </tr>
            int index2 = 0;
            foreach (var dep in comp.GroupBy(t =>
            t.departmentID))
            {
                index2++;
                <tr class="table-secondary fw-bold">
                    <td colspan="9">@(index).@(index2). @dep.FirstOrDefault().departmentName</td>
                </tr>
                int index3 = 0;
                foreach (var t in dep)
                {
                    index3++;
                    <tr>
                        <td>
                            @(index3). @t.FullName
                        </td>
                        <td>@((Models.Gender) t.personGender)</td>
                        <td>@t.jobCategoryName</td>
                        <td>@t.jobClassName</td>
                        <td>@t.terminationReason</td>
                        <td>
                            @{
                                var badgeClass = t.terminationStatus switch
                                {
                                    (int) PIS2.Models.terminationStatus.Posted => "bg-success",
                                    (int) PIS2.Models.terminationStatus.Hold => "bg-warning",
                                    (int) PIS2.Models.terminationStatus.Complete => "bg-secondary",
                                    (int )PIS2.Models.terminationStatus.Approved => "bg-info",
                                    _ => "bg-primary"
                                };
                            }
                            <span class="badge rounded-pill @badgeClass" style="min-width: 80px;">
                                @((PIS2.Models.terminationStatus)t.terminationStatus)
                            </span>
                        </td>
                        <td>@t.terminationDate.ToString("MM/dd/yyyy")</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-page="./Details" asp-route-id="@t.terminationID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@t.terminationID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/filter-department.js"></script>
<script>
        $("#resetBtn").click(function () {
        $("#filterForm")[0].reset();
    });

</script>