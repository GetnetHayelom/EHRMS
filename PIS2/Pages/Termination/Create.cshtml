@page
@using PIS2.Enums
@model PIS2.Pages.Termination.CreateModel

@{
    ViewData["Title"] = "New Termination";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Employment Management</h2>

<p class="text-muted mb-0">Employment Termination @Model.lastPayTest</p>
<hr />

<!--EMPLOYEE LOOKUP-->
<div class="card shadow-sm border-0 px-3 py-2">
    <div class="d-flex justify-content-between align-items-center">
        <div class ="d-flex align-items-center">
            <h6 class="fw-bold">Termination Details</h6>
        </div>
        <form method="get" class="d-flex align-items-center justify-content-end gap-2">
            <label for="givenID" class="text-nowrap small fw-bold text-uppercase text-muted mb-0">Find Employee:</label>
            <input asp-for="employmentModel.givenID" id="givenID" class="form-control form-control-sm" placeholder="Enter ID..." name="givenID" style="width: 150px;" />
            <button type="submit" class="btn btn-sm btn-primary px-3" id="goButton">Go</button>
        </form>
    </div>
    
</div>

@if(Model.employmentModel != null && Model.employmentModel.employmentID !=0)
{
    @if (Model.employmentModel.employmentStatus == mainStatus.Active)
    {
        <div class="d-flex gap-4">

            <div class="card shadow-sm p-2 flex-fill mt-3">

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div> 
                    <input asp-for="terminationModel.employmentID" value= "@Model.employmentModel.employmentID" type="hidden"/>
            
                    <div class="form-group">
                        <label asp-for="terminationModel.terminationDate" class="control-label">Date</label>
                        <input asp-for="terminationModel.terminationDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")"/>
                        <span asp-validation-for="terminationModel.terminationDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="terminationModel.terminationReason" class="control-label">Reason</label>
                        <input asp-for="terminationModel.terminationReason" class="form-control" />
                        <span asp-validation-for="terminationModel.terminationReason" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="terminationModel.terminationRemark" class="control-label">Remark</label>
                        <input asp-for="terminationModel.terminationRemark" class="form-control" />
                        <span asp-validation-for="terminationModel.terminationRemark" class="text-danger"></span>
                    </div>
 
                    <div class="form-group d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-primary m-2" />
                    </div>
                </form>
            
            </div>
            <div class="card shadow-sm text-center mt-3">
                <div class="card-header bg-success text-white"><h4 class="fw-bold"><u>@Model.employeeDetail?.FullName</u></h4></div>
                <div class="card-body text-start">
                    <strong>Position:</strong> <span>@Model.employeeDetail?.EmploymentPosition</span><br />
                    <strong>Job Title:</strong> <span>@Model.employeeDetail?.JobTitle</span><br />
                    <strong>Salary:</strong> <span>@Model.employeeDetail?.Salary?.ToString("N2")</span><br />
                    <strong>Department:</strong> <span>@Model.employeeDetail?.DepartmentName</span><br />
                    <strong>Company:</strong> <span>@Model.employeeDetail?.CompanyName</span>
                </div>
            
            </div>
            <div class="flex-fill d-flex gap-4">
                <div class="card shadow-sm text-center mt-3">
                    <div class="card-header bg-warning text-white">
                        <h6 class="fw-bold mb-1"> Severance Pay</h6>
                    </div>
                    <div class="card-body p-4 ">
                        <h4 class="card-body fw-bold">@Model.SeverancePay.ToString("N2") </h4>
                        
                    </div>
                    <div class="card-footer text-muted"><p class="fw-bold">Year of Service: @Model.YearsOfService.ToString("N2")</p></div>
                </div>

                <div class="card shadow-sm text-center mt-3">
                    <div class="card-header bg-info text-white"><h6 class="fw-bold mb-1">Leave Payable</h6></div>
                        <div class="card-body p-4">
                            <h4 class="card-body fw-bold">@(Model.LeaveSummary?.adjustedLeaveBalanceCost.ToString("N2")??"0.00")</h4>
                        
                        </div>
                    <div class="card-footer  text-muted"><p class="fw-bold">Leave Balance: @(Model.LeaveSummary?.adjustedLeaveBalance.ToString("N2")??"0")</p></div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Earnings</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var earning in Model.PayrollPay.EarningRecords)
                                {
                                    <tr>
                                        <td>@earning.earningType?.earningTypeName</td>
                                        <td><small class="text-muted">@earning.earningReference</small></td>
                                        <td class="text-end font-monospace">@earning.earningAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-info fw-bold">
                                    <td colspan="2">Total Earnings</td>
                                    <td class="text-end">@Model.PayrollPay.TotalEarning.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-light text-danger">
                        <h6 class="mb-0 text-dark">Deductions</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th>Reference</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deduction in Model.PayrollPay.DeductionRecords)
                                {
                                    <tr>
                                        <td>@deduction.DeductionType?.deductionName</td>
                                        <td><small class="text-muted">@deduction.deductionReference</small></td>
                                        <td class="text-end font-monospace text-danger">@deduction.deductionAmount?.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-warning fw-bold text-danger">
                                    <td colspan="2">Total Deductions</td>
                                    <td class="text-end">@Model.PayrollPay.TotalDeduction.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div>
            <h4 class="fw-bold text-danger">Employee Not Active</h4>
        </div>
    }

}
else
{
    <h5 class="fw-bold text-info">Enter Employee ID To Proceed!</h5>
}

@if (User.IsInRole("MIE\\PMS_HRCLERCK") || User.IsInRole("MIE\\PMS_HRMANAGER"))
{
    <div>
        <a asp-page="Index">View All Terminations</a>
    </div>
}


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
