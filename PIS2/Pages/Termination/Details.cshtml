@page
@model PIS2.Pages.Termination.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold mb-0">Termination</h2>
        <p class="text-muted mb-0">Termination Details #@Model.terminationModel.terminationID</p>
    </div>
    <div class="btn-group d-print-none">
        <a asp-page="./Index" class="btn btn-outline-secondary m-2"><i class="bi bi-arrow-left me-2"></i>Back to Catalog</a>
        @await Html.PartialAsync("print")
    </div>
</div>


<div>

    <hr />
    <div class="row">
        <div class="col-sm-12 col-md-5 card shadow-sm p-2">
            <dl class="row">
                <dt class="col-sm-5">
                    Employee Name & ID:
                </dt>
                <dd class="col-sm-7">
                    @Model.employeeDetail?.FullName - @Model.employeeDetail?.GivenID
                    <a asp-page="/Employment/Details" asp-route-id="@Model.terminationModel?.employmentID" class="btn btn-sm btn-outline-primary" title="View Details">
                        <i class="bi bi-eye"></i>
                    </a>
                </dd>
                <dt class="col-sm-5">
                    Job/Salary:
                </dt>
                <dd class="col-sm-7">
                    @Model.employeeDetail?.JobTitle - @Model.employeeDetail?.Salary?.ToString("N2")
                </dd>
                <dt class="col-sm-5">
                    Termination Date:
                </dt>
                <dd class="col-sm-7">
                    @Model.terminationModel?.terminationDate.ToString("MM/dd/yyyy")
                </dd>
                <dt class="col-sm-5">
                    Termination Reason:
                </dt>
                <dd class="col-sm-7">
                    @Html.DisplayFor(model => model.terminationModel.terminationReason)
                </dd>
                <dt class="col-sm-5">
                    Termination Remark:
                </dt>
                <dd class="col-sm-7">
                    @Html.DisplayFor(model => model.terminationModel.terminationRemark)
                </dd>
                <dt class="col-sm-5">
                    Status:
                </dt>
                @{
                    string bgColor = Model.terminationModel?.terminationStatus switch
                    {
                        Enums.terminationStatus.Hold => "bg-warning",
                        Enums.terminationStatus.Approved => "bg-success",
                        Enums.terminationStatus.Posted => "bg-primary",
                        _ => "bg-secondary"
                    };
                }

                <dd class="col-sm-7">
                    
                    <span class="badge @bgColor">@Model.terminationModel?.terminationStatus</span>
                </dd>
                <dt class="col-sm-5">
                    Modified By:
                </dt>
                <dd class="col-sm-7">
                    @Html.DisplayFor(model => model.terminationModel.modifiedBy)
                </dd>
            </dl>
        </div>
        <div class="col-sm-12 col-md-7 p-2">
            <button class="btn btn-primary d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#auditDiv">
                Show Record History
            </button>
            <div class="card shadow-sm border-0 collapse d-md-block" id="auditDiv">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-clock-history me-2"></i> Audit Trail
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Field</th>
                                    <th>Old Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.History.Any())
                                {
                                    @foreach (var log in Model.History)
                                    {
                                        <tr>
                                            <td class="small">@log.ModifiedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                            <td class="small fw-bold">@log.ModifiedBy</td>
                                            <td><span class="badge bg-light text-dark">@Model.GetFriendlyColumnName(log.ColumnName)</span></td>
                                            <td class="text-muted italic small">
                                                <span class="text-danger text-decoration-line-through small">
                                                    @Model.FormatAuditValue(log.ColumnName, log.OldValue)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No change history found for this record.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white small text-muted">
                    Total changes tracked: @Model.History.Count
                </div>
            </div>
        </div>
        <div class="d-flex gap-3">
            <div class="card shadow-sm text-center mt-3 col-md-3 col-6">
                <div class="card-header bg-warning text-white">
                    <h6 class="fw-bold mb-1"> Severance Pay</h6>
                </div>
                <div class="card-body p-4 ">
                    <h4 class="card-body fw-bold">@Model.SeverancePay.ToString("N2") </h4>
                    
                </div>
                <div class="card-footer text-muted"><p class="fw-bold">Year of Service: @Model.YearsOfService.ToString("N2")</p></div>
            </div>

            <div class="card shadow-sm text-center mt-3 col-md-3 col-6" >
                <div class="card-header bg-info text-white"><h6 class="fw-bold mb-1">Leave Payable</h6></div>
                <div class="card-body p-4">
                    <h4 class="card-body fw-bold">@(Model.LeaveSummary?.adjustedLeaveBalanceCost.ToString("N2") ?? "0.00")</h4>
                    
                </div>
                <div class="card-footer  text-muted"><p class="fw-bold">Leave Balance: @(Model.LeaveSummary?.adjustedLeaveBalance.ToString("N2") ?? "0")</p></div>
            </div>
            <div class="row mt-3 col-md-6 col-12" >
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Earnings</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var earning in Model.Payments.EarningRecords)
                                    {
                                        <tr>
                                            <td>@earning.earningType?.earningTypeName</td>
                                            <td><small class="text-muted">@earning.earningReference</small></td>
                                            <td class="text-end font-monospace">@earning.earningAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info fw-bold">
                                        <td colspan="2">Total Earnings</td>
                                        <td class="text-end">@Model.Payments.TotalEarning.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light text-danger">
                            <h6 class="mb-0 text-dark">Deductions</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var deduction in Model.Payments.DeductionRecords)
                                    {
                                        <tr>
                                            <td>@deduction.DeductionType?.deductionName</td>
                                            <td><small class="text-muted">@deduction.deductionReference</small></td>
                                            <td class="text-end font-monospace text-danger">@deduction.deductionAmount?.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-warning fw-bold text-danger">
                                        <td colspan="2">Total Deductions</td>
                                        <td class="text-end">@Model.Payments.TotalDeduction.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    
</div>
<div class="d-flex justify-content-end d-print-none">
    <div class="btn-group">
        @if (Model.terminationModel.terminationStatus == Enums.terminationStatus.Hold && User.IsInRole("HRMANAGER"))
        {
            <form method="post" asp-page-handler="Approve">
                <input asp-for="terminationID" value="@Model.terminationModel.terminationID" type="hidden" />
                <button class="btn btn-success m-2 d-print-none" type="submit">Approve</button>
            </form>
        }
        @if (Model.terminationModel.terminationStatus == Enums.terminationStatus.Hold && User.IsInRole("HRPERSONNEL"))
        {
            <a asp-page="./Edit" asp-route-id="@Model.terminationModel.terminationID" class="btn btn-primary m-2"><i class="bi bi-pencil-square me-2"></i>@L.T("Edit")</a>
        }
        @if(Model.terminationModel.terminationStatus == Enums.terminationStatus.Approved && User.IsInRole("HRMANAGER"))
        {
            <form method="post">
                <input asp-for="terminationID" value="@Model.terminationModel.terminationID" type="hidden" />
                <button class="btn btn-success m-2 d-print-none" type="submit">Post</button>
            </form>
        }
    </div>
  

        
</div>
<a asp-page="./Index" class="d-print-none">View All Termination</a>