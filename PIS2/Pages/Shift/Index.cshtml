@page
@using PIS2.Enums
@model PIS2.Pages.Shift.IndexModel

@{
    ViewData["Title"] = "Shifts";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h1 class="fw-bold">Shifts</h1>

        <p>
            <a asp-page="Create" class="btn btn-primary">Add New Shift</a>
        </p>
    </div>
    <div class="d-flex justify-content-end">
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
    </div>
</div>



<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Shift Name
            </th>
            <th>
                Shift Starting Time
            </th>
            <th>
               Shift Ending Time
            </th>
            <th>
               Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.shiftModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.shiftName)
            </td>
            <td>
                @DateTime.Today.Add(item.shiftStart).ToString("hh:mm tt")
            </td>
            <td>
                @DateTime.Today.Add(item.shiftEnd).ToString("hh:mm tt")
            </td>
            <td>
                    @if (item.shiftStatus == mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.shiftStatus)</span>

                    }
                    else if (item.shiftStatus == mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.shiftStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.shiftStatus)</span>
                    }
            </td>
            <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.shiftID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.shiftID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end">
    @await Html.PartialAsync("print")
</div>
