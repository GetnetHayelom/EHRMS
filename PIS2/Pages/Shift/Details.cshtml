@page
@model PIS2.Pages.Shift.DetailsModel

@{
    ViewData["Title"] = "Shift Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Shifts</h1>

<div>
    <h4>Shift Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Shift Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.shiftModel.shiftName)
        </dd>
        <dt class="col-sm-2">
            Shift Start Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.shiftModel.shiftStart).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            Shift End Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.shiftModel.shiftEnd).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.shiftModel.shiftStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.shiftModel.shiftID">@L.T("Edit")</a> |
    <a asp-page="./Index">Back to List</a>
</div>
