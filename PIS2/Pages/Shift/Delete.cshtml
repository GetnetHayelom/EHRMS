@page
@model PIS2.Pages.Shift.DeleteModel

@{
    ViewData["Title"] = "Delete Shift";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Shifts</h1>

<h3>Are you sure you want to delete this shift?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Shift Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.shiftModel.shiftName)
        </dd>
        <dt class="col-sm-2">
            Shift Start Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.shiftModel.shiftStart).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            Shift End Time:
        </dt>
        <dd class="col-sm-10">
            @DateTime.Today.Add(Model.shiftModel.shiftEnd).ToString("hh:mm tt")
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.shiftModel.shiftStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="shiftModel.shiftID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
