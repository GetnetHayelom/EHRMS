
@model IEnumerable<PIS2.Models.HR.leaveModel>
@{
}
@if (Model == null)
{
    <p>No Leave Records Found.</p>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom">
            <h3 class="fw-bold">Attendance and Leave History</h3>
        </div>
        <div class="card-body">
      

            
                <table class="table table-striped table-hover">
                    <thead>
                        <tr class="bg-dark text-white">
                            <th>S/No</th>
                            <th>
                                Voucher Number
                            </th>
                            <th>
                                Request Date
                            </th>
                            <th>
                                Start Date
                            </th>
                            <th>
                                End Date
                            </th>
                            <th>
                                Number of Days
                            </th>
                            <th>
                                Leave Type
                            </th>
                            <th>
                                Leave Status
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 0;
                            string bg = "";
                        }
                        @foreach (var item in Model.OrderByDescending(l => l.leaveRequestDate))
                        {
                            bg = item.leaveStatus switch
                            {
                                Enums.leaveStatus.Hold => "bg-warning",
                                Enums.leaveStatus.Approved => "bg-success",
                                Enums.leaveStatus.Posted => "bg-secondary",
                                Enums.leaveStatus.Completed => "bg-secondary",
                                _ => "bg-danger"
                            };

                            index++;
                            <tr onclick="location.href='@Url.Page("/Leave/Details", new { id = item.leaveID })'" style="cursor:pointer;">
                                <td>@index</td>
                                <td>
                                    <a asp-page="/Leave/Details" asp-route-id="@item.leaveID" class="text-decoration-none text-dark">
                                        @item.leaveID
                                    </a>
                                </td>
                                <td>
                                    @item.leaveRequestDate.ToString("MM/dd/yyyy")
                                </td>
                                <td>
                                    @item.leaveStartDate.ToString("MM/dd/yyyy")
                                </td>
                                <td>
                                    @item.leaveEndDate.ToString("MM/dd/yyyy")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.leaveDays)
                                </td>
                                <td>
                                    @item.leaveTypeModel?.leaveTypeName
                                </td>
                                <td>
                                    <span class="badge @bg">@Html.DisplayFor(modelItem => item.leaveStatus)</span>
                                </td>

                            </tr>
                        }


                    </tbody>
                </table>
            

        </div>
        <div class="card-footer">
            @await Html.PartialAsync("print")
        </div>
    </div>
}
