@page
@model PIS2.Pages.Employment.CreateModel

@{
    ViewData["Title"] = "Add New Employment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}

<h2 class="fw-bold">Employment</h2>

<h6 class="text-muted">Maintain New Employment</h6>
<hr />
@if (!string.IsNullOrEmpty(successMessage))
{
<div class="alert alert-success" role="alert">
    @successMessage
</div>
}
<div class="row">
    <form method="post" class="d-flex justify-content-end">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="card shadow-sm p-2 col-md-4">
            <div class="mb-3">
                <label asp-for="employmentModel.personID" class="form-label fw-semibold">
                    <span class="text-danger">*</span> Person
                </label>
                <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.Person?.personFullName"/>
                <input type="hidden" asp-for="employmentModel.personID" id="personIDHidden" value="@Model.Person?.personID"/>
                <datalist id="personList">
                    @foreach (var person in (SelectList)ViewData["personID"])
                    {
                        <option data-id="@person.Value" value="@person.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="employmentModel.personID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="employmentModel.givenID" class="control-label">Employment ID</label>
                <input asp-for="employmentModel.givenID" class="form-control" />
                <span asp-validation-for="employmentModel.givenID" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="employmentModel.employmentTypeID" class="control-label">Employment Type</label>
                <select asp-for="employmentModel.employmentTypeID" class="form-control" asp-items="ViewBag.employmentTypeID"></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="employmentModel.employmentDate" class="control-label">Employment Date</label>
                <input asp-for="employmentModel.employmentDate" class="form-control" type="date" />
                <span asp-validation-for="employmentModel.employmentDate" class="text-danger"></span>
            </div>
            <div class="form-group" id="terminationDateGroup">
                <span class="text-danger">*</span>
                <label asp-for="employmentModel.employmentTerminationDate" class="control-label">Termination Date</label>
                <input asp-for="employmentModel.employmentTerminationDate" class="form-control" type="date" />
                <span asp-validation-for="employmentModel.employmentTerminationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="employmentModel.employmentStatus" class="control-label">Employment Status</label>
                <select asp-for="employmentModel.employmentStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="employmentModel.employmentStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="employmentModel.employmentReference" class="control-label">Employment Reference</label>
                <input asp-for="employmentModel.employmentReference" class="form-control" />
                <span asp-validation-for="employmentModel.employmentReference" class="text-danger"></span>
            </div>
            
            
            

        </div>
        <div class="card shadow-sm p-2 col-md-4">
            <h4 class="fw-bold">Aditional Info</h4>
            <div class="form-group">
                <label asp-for="employmentModel.employmentCarriedOverLeave" class="control-label">Carried Over Leave</label>
                <input asp-for="employmentModel.employmentCarriedOverLeave" class="form-control" type="number" value="0"/>
                <span asp-validation-for="employmentModel.employmentCarriedOverLeave" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="employmentModel.jobRequirementID" class="form-label fw-semibold">Assocciated Employment Request</label>
                <input type="text" class="form-control" list="requestList" placeholder="Type to search..." oninput="selector(this, 'requestIDHidden')"/>
                <input type="hidden" asp-for="employmentModel.jobRequirementID" id="requestIDHidden" />
                <datalist id="requestList">
                    @foreach (var req in (SelectList)ViewData["employmentRequest"])
                    {
                        <option data-id="@req.Value" value="@req.Text"></option>
                    }
                </datalist>
                <span asp-validation-for="employmentModel.jobRequirementID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="employmentModel.employmentMethodID" class="control-label">Employment Method</label>
                <select asp-for="employmentModel.employmentMethodID" class="form-control" asp-items="ViewBag.employmentMethod"></select>
                <span asp-validation-for="employmentModel.employmentMethodID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="employmentModel.employmentPosition" class="control-label">Employment Position</label>
                <select asp-for="employmentModel.employmentPosition" class="form-control" asp-items="Html.GetEnumSelectList<Models.EmploymentPositions>()"></select>
                <span asp-validation-for="employmentModel.employmentPosition" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </div>
        <div class="card shadow-sm p-2 flex-fill">
            <div class="avatar-lg bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2">
                <img id="previewImg" src="/images/male-default.png" alt="Preview" style="max-width:200px">

            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    </form>
</div>

<div>
    <a asp-page="Index">View All Employments</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const employmentType = document.getElementById("employmentModel_employmentTypeID");
        const terminationDateGroup = document.getElementById("terminationDateGroup");

        function toggleTerminationDate() {
            // Replace "2" with the actual value for Contract from your employmentTypeID
            if (employmentType.value != "1") {
                terminationDateGroup.style.display = "block";
            } else {
                terminationDateGroup.style.display = "none";
                // Optionally clear value when not contract
                document.getElementById("employmentModel_terminationDate").value = "";
            }
        }

        // Run on load and on change
        toggleTerminationDate();
        employmentType.addEventListener("change", toggleTerminationDate);
    });
</script>
<script>
    const input = document.getElementById('personIDHidden');
    const img = document.getElementById('previewImg');

    // Function to update the img src based on input value
    function updateProfileImg() {
        const src = input.value ? '/images/'+input.value +'.jpg' : '/images/male-default.png';
        img.src = src;

        // If image fails to load, fallback to default
        img.onerror = () => {
            img.src = '/images/male-default.png';
        };
    }

    // Observe changes to the hidden input value
    const observer = new MutationObserver(updateProfileImg);
    observer.observe(input, { attributes: true, attributeFilter: ['value'] });

    // Initial load
    updateProfileImg();

    // Example: update the input programmatically
    // input.value = 'newProfile.jpg'; // img will auto-update
    // updateProfileImg(); // optional manual call
</script>