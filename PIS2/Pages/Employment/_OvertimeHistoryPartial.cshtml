
@model IEnumerable<PIS2.Models.overtimeRecordModel>
@{
}
@if (Model == null)
{
    <p>No Overtime Record Founds.</p>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom">
            <h3 class="fw-bold">Overtime History</h3>
        </div>
        <div class="card-body">
            
           
                <table class="table table-striped table-hover">
                    <thead>
                        <tr class="bg-dark text-white">

                            <th>
                                Request Date
                            </th>
                            <th>
                                Start Date
                            </th>
                            <th>
                                End Date
                            </th>
                            <th>
                                Number of Hours
                            </th>
                            <th>
                                Overtime Type
                            </th>
                            <th>
                                Overtime Cost
                            </th>
                            <th>
                                Overtime Status
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gr in Model.GroupBy(o => o.overtimeRecordDate))
                        {
                            bool first = true;

                            @foreach (var item in gr.OrderByDescending(or => or.overtimeRecordStartTime))
                            {
                                var idList = gr.Select(x => x.overtimeRecordID).ToList();

                                <tr style="cursor:pointer;" onclick="location.href='@Url.Page("/OvertimeRecord/Details", new { id = item.overtimeRecordID })'">

                                    @if (first)
                                    {
                                        <th rowspan="@gr.Count()"
                                            onclick="event.stopPropagation(); location.href='@Url.Page("/OvertimeRecord/PersonOTR", new { otrID = idList, empID = item.employmentID, date = gr.Key })'"
                                            style="cursor:pointer;">
                                            @gr.Key.ToString("MM/dd/yyyy")
                                        </th>
                                        first = false;
                                    }
                                    <td>@item.overtimeRecordStartTime.ToString(@"hh\:mm")</td>
                                    <td>@item.overtimeRecordEndTime.ToString(@"hh\:mm")</td>
                                    <td>@item.TimeElapsed.ToString(@"hh\:mm")</td>
                                    <td>@item.overtimeModel?.overtimeName</td>
                                    <td> @Math.Round((item.overtimeRate * item.overtimeRecordEmploymentRate * (decimal)item.TimeElapsed.TotalMinutes / 60), 2).ToString("N2")</td>
                                    <td>
                                        @if (item.overtimeRecordStatus == Enums.overtimeStatus.Posted)
                                        {
                                            <span class="badge bg-success">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                                        }
                                        else if (item.overtimeRecordStatus == Enums.overtimeStatus.Hold)
                                        {
                                            <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                                        }
                                        else if (item.overtimeRecordStatus == Enums.overtimeStatus.Approved)
                                        {
                                            <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.overtimeRecordStatus)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }


                    </tbody>
                </table>
            
        </div>
        <div class="card-footer">
            @await Html.PartialAsync("print")
        </div>
    </div>
}