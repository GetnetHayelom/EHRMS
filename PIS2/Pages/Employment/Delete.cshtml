@page
@model PIS2.Pages.Employment.DeleteModel

@{
    ViewData["Title"] = "Delete Employment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employments</h1>
<h4>Delete Employments</h4>

<h3>Are you sure you want to delete this employment?</h3>
<div>
       <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Full Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.personModel.personFullName)
        </dd>
        <dt class="col-sm-2">
            Hire Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.employmentDate)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.employmentStatus)
        </dd>
        @if(Model.employmentModel.employmentStatus == Models.mainStatus.Inactive)
        {
            <dt class="col-sm-2">
                Termination Date:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.employmentModel.employmentTerminationDate)
            </dd>
        }
        <dt class="col-sm-2">
            Reference:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.employmentReference)
        </dd>
        <dt class="col-sm-2">
            Hours Per Week:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentModel.workingHoursPerWeek)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="employmentModel.employmentID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
