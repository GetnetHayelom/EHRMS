@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between">
    <div class="flex-grow">
        <h1 class="fw-bold">Employments</h1>
        <h4 class="fw-bold">@Model.Company</h4>
    </div>

    <div>
        <div class="d-flex justify-content-between align-content-end">
            <h6 class="">Male:<u>@Model.maleCount (@Math.Round((decimal)Model.maleCount * 100 / Model.totalCount, 2)%)</u></h6>
            <h6 class="">Female:<u>@Model.femaleCount (@Math.Round((decimal)Model.femaleCount * 100 / Model.totalCount, 2)%)</u></h6>
            <h4 class="fw-bold">Total:<u>@Model.employmentModel.Count()</u></h4>
        </div>
        <p class="d-flex justify-content-between">
            <a asp-page="Create" class="d-print-none btn btn-primary m-2">Add New Employee</a>
            <a class="d-print-none btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#rawView">List View</a>
            <a class="d-print-none btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#groupView">Department View</a>
        </p>
        
    </div>
</div>

<hr />
<div id="parentDiv">
    <!--List View-->
    <div id="rawView" class="show" data-bs-parent="#parentDiv">
        <div class="d-flex justify-content-end">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>

        <table class="table table-bordered table-striped table-hover table-fixed" id="dataTable">
            <thead class ="bg-dark text-white">
        
                <tr>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Empoyment Date
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Type
                    </th>
                    <th>
                        Job Title
                    </th>
                    <th>Department</th>
            
                </tr>
            </thead>
            <tbody id="table-body">
                @foreach (var item in Model.employmentModel) {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'" style="cursor:pointer;")>
                        <td>
                            @Html.DisplayFor(modelItem => item.givenID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.personModel.personFullName)
                        </td>
                        <td>
                            @item.employmentDate.ToString("MM/dd/yyyy")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.employmentStatus)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
                        </td>

                        <td class="text-wrap">
                            @if (item.JobPlacements != null && item.JobPlacements.Any())
                            {
                                //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                @item.JobPlacements.OrderByDescending(jp=> jp.jobPlacementDate).FirstOrDefault().jobModel.jobTitle
                            }
                            else
                            {
                                <p>N/A</p>
                            }
                        </td>
                        <td class="text-wrap">
                                @if (item.JobPlacements != null && item.JobPlacements.Any())
                                {
                                    //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                }
                                else
                                {
                                    <p>N/A</p>
                                }
                        </td>
                
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!--Group View-->
    <div id="groupView" class="collapse" data-bs-parent="#parentDiv">
        <h4 class="fw-bold">Employees By Department</h4>
        <table class="table table-bordered table-striped table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th>S/No</th>
                    <th>Department</th>
                    <th>Male</th>
                    <th>Female</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="departmentsAccordion">
                @{
                    int index = 0;
                    int rowCounter = 1;
                }
                @foreach (var dep in Model.GroupedEmployments)
                {
                    var collapseId = $"collapse{index}";
                    <tr data-bs-toggle="collapse"
                        data-bs-target="#@collapseId"
                        style="cursor:pointer;" class="">
                        <td>                           
                            @rowCounter                          
                        </td>
                        <td>                           
                            @dep.DepartmentName                            
                        </td>
                        <td>                            
                             @dep.Male (@Math.Round((decimal)dep.Male*100/dep.Count,2)%)                           
                        </td>
                        <td>                            
                            @dep.Female (@Math.Round((decimal)dep.Female * 100 / dep.Count,2)%)
                        </td>
                        <td>                            
                            @dep.Count                         
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" class="p-0">
                            <div id="@collapseId" class="accordion-collapse collapse"
                                 data-bs-parent="#departmentsAccordion">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-info text-white">

                                        <tr>
                                            <th>
                                                Employee ID
                                            </th>
                                            <th>
                                                Name
                                            </th>
                                            <th>
                                                Empoyment Date
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                            <th>
                                                Type
                                            </th>
                                            <th>
                                                Job Title
                                            </th>
                                            <th>Department</th>

                                        </tr>
                                    </thead>
                                    <tbody id="table-body">
                                        @foreach (var item in dep.Records)
                                        {
                                            <tr onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'" style="cursor:pointer;" )>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.givenID)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.personModel.personFullName)
                                                </td>
                                                <td>
                                                    @item.employmentDate.ToString("MMM dd,yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentStatus)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
                                                </td>

                                                <td class="text-wrap">
                                                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                                                    {
                                                        //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                        @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().jobModel.jobTitle
                                                    }
                                                    else
                                                    {
                                                        <p>N/A</p>
                                                    }
                                                </td>
                                                <td class="text-wrap">
                                                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                                                    {
                                                        //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                        @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                    }
                                                    else
                                                    {
                                                        <p>N/A</p>
                                                    }
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    index++;
                    rowCounter++;
                }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-end">
@await Html.PartialAsync("print")
</div>

