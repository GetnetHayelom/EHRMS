@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employments</h1>

<p>
    <a asp-page="Create">Add New Employee</a>
    @await Html.PartialAsync("filter")
    <i
</p>
<p id="countId"></p>
<table class="table table-striped table-hover" id="dataTable">
    <thead class ="bg-dark text-white">
        <tr>
            <th><input type="text" id="epFilter" oninput="filterVisibleRows('epFilter', 0)" placeholder="Filter EP"></th>
            <th><input type="text" id="nameFilter" oninput="filterVisibleRows('departmentFilter', 1)"  placeholder="Filter Name"></th>
            <th><input type="text" id="dateFilter" oninput="filterVisibleRows('departmentFilter', 2)"  placeholder="Filter Date"></th>
            <th><input type="text" id="statusFilter" oninput="filterVisibleRows('departmentFilter', 3)"  placeholder="Filter Status"></th>
            <th><input type="text" id="typeFilter" oninput="filterVisibleRows('departmentFilter', 4)"  placeholder="Filter Type"></th>
            <th><input type="text" id="referenceFilter" oninput="filterVisibleRows('departmentFilter', 5)"  placeholder="Filter Reference"></th>
            <th><input type="text" id="departmentFilter" oninput="filterVisibleRows('departmentFilter', 6)" placeholder="Filter Department"></th>
        </tr>
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Name
            </th>
            <th>
                Empoyment Date
            </th>
            <th>
                Status
            </th>
            <th>
                Type
            </th>
            <th>
                Reference
            </th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.employmentModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personModel.personFullName)
            </td>
            <td>
                @item.employmentDate.ToString("MMM dd,yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
            </td>
               
            <td>
                @Html.DisplayFor(modelItem => item.employmentReference)
            </td>
            <td>
                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                    {
                        @item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                    }
                    else
                    {
                        <p>No Job</p>
                    }
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.employmentID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.employmentID">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>
<!-- JavaScript for Filtering -->
<script>
    
</script>
