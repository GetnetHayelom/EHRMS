@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employments</h1>

<p>
    <a asp-page="Create" class="d-print-none">Add New Employee</a>
</p>
<div class="d-inline-flex">
    @await Html.PartialAsync("filter")
    @await Html.PartialAsync("print")
    
</div>
<div class="row">
    <div class="col-3">
        <label for="filter-status">Filter Status:</label>
        <select class="form-select" aria-label="Default select example" id="filter-status" onchange="filterEmployees()" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-3">
        <label for="filter-empType">Filter Employment Type:</label>
        <select class="form-select" aria-label="Default select example" id="filter-empType" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var empType in Model.EmploymentTypes)
            {
                <option value="@empType.employmentTypeID">@empType.employmentTypeName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-job">Filter Job:</label>
        <select class="form-select" aria-label="Default select example" id="filter-job" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var jobTitle in Model.JobTitles)
            {
                <option value="@jobTitle.jobID">@jobTitle.jobTitle</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-department">Filter Department:</label>
        <select class="form-select" aria-label="Default select example" id="filter-department" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var department in Model.Departments)
            {
                <option value="@department.departmentID">@department.departmentName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-company">Filter Company:</label>
        <select class="form-select" aria-label="Default select example" id="filter-company" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.companyID">@company.companyName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="filter-workLoc">Filter Work Location:</label>
        <select class="form-select" aria-label="Default select example" id="filter-workLoc" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var workLocation in Model.WorkLocations)
            {
                <option value="@workLocation.workSiteID">@workLocation.workSiteName</option>
            }
        </select>
    </div>
    <div class="col-3">
        <label for="dateStart">Date of Employment From:</label>
        <input class="form-control" type="date" id="dateStart" onchange="filterEmployees()" />
    </div>
    <div class="col-3">
        <label for="dateEnd">Date of Employment Upto:</label>
        <input class="form-control" type="date" id="dateEnd" onchange="filterEmployees()" />
    </div>
</div>

<p>Showing @Model.filteredCount of @Model.totalCount</p>
<table class="table table-striped table-hover table-fixed" id="dataTable">
    <thead class ="bg-dark text-white">
        
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Name
            </th>
            <th>
                Empoyment Date
            </th>
            <th>
                Status
            </th>
            <th>
                Type
            </th>
            <th>
                Job Title
            </th>
            <th>Department</th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody id="table-body">
        @foreach (var item in Model.employmentModel) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.givenID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.personModel.personFullName)
                </td>
                <td>
                    @item.employmentDate.ToString("MMM dd,yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.employmentStatus)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
                </td>

                <td class="text-wrap">
                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                    {
                        //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                        @item.JobPlacements.OrderByDescending(jp=> jp.jobPlacementDate).FirstOrDefault().jobModel.jobTitle
                    }
                    else
                    {
                        <p>N/A</p>
                    }
                </td>
                <td class="text-wrap">
                        @if (item.JobPlacements != null && item.JobPlacements.Any())
                        {
                            //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                        @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                        }
                        else
                        {
                            <p>N/A</p>
                        }
                </td>
                <td class="d-print-none">
                    <a asp-page="./Edit" asp-route-id="@item.employmentID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.employmentID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- JavaScript for Filtering -->
<script>
    function filterEmployees() {

        var department = document.getElementById("filter-department").value;
        var empStatus = document.getElementById("filter-status").value;
        var jobTitle = document.getElementById("filter-job").value;
        var empType = document.getElementById("filter-empType").value;
        var workLoc = document.getElementById("filter-workLoc").value;
        var company = document.getElementById("filter-company").value;
        var dateStart = document.getElementById("dateStart").value;
        var dateEnd = document.getElementById("dateEnd").value;

        // If the "All" option is selected, send null to indicate no filter
        department = (!department || department === "") ? null : department;
        empStatus = (!empStatus || empStatus === "") ? null : empStatus;
        jobTitle = (!jobTitle || jobTitle === "") ? null : jobTitle;
        empType = (!empType || empType === "") ? null : empType;

        // Build the URL with multiple filters
        const url = `/Employment/Index?handler=Filter&department=${encodeURIComponent(department)}&jobTitle=${encodeURIComponent(jobTitle)}&empStatus=${encodeURIComponent(empStatus)}&empType=${encodeURIComponent(empType)}&company=${encodeURIComponent(company)}&workLoc=${encodeURIComponent(workLoc)}&dateStart=${encodeURIComponent(dateStart)}&dateEnd=${encodeURIComponent(dateEnd)}`;

        fetch(url)
            .then(response => response.text())
            .then(data => {
                document.getElementById('table-body').innerHTML = data;
            })
            .catch(error => console.error('Error:', error));
    }
</script>
