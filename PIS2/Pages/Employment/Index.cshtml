@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employments</h1>

<p>
    <a asp-page="Create">Add New Employee</a>
    @await Html.PartialAsync("filter")
</p>
<table class="table table-striped table-hover" id="dataTable">
    <thead class ="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Name
            </th>
            <th>
                Empoyment Date
            </th>
            <th>
                Status
            </th>
            <th>
                Type
            </th>
            <th>
                Reference
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.employmentModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.personModel.personFullName)
            </td>
            <td>
                @item.employmentDate.ToString("MMM dd,yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
            </td>
                
            <td>
                @Html.DisplayFor(modelItem => item.employmentReference)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.workingHoursPerWeek)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.employmentID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.employmentID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.employmentID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<!-- JavaScript for Filtering -->
<script>
    
</script>
