@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employments";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employments</h1>

<div class="d-flex justify-content-between">
    <p>
        <a asp-page="Create" class="d-print-none btn btn-primary">Add New Employee</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#rawView">List View</a>
        <a asp-page="Create" class="btn btn-primary m-2" data-bs-toggle="collapse" data-bs-target="#groupView">Department View</a>
    </p>
    <h4 class="fw-bold">Total:@Model.employmentModel.Count()</h4>
</div>
<hr />
<div id="parentDiv">
    <!--List View-->
    <div id="rawView" class="show" data-bs-parent="#parentDiv">
        <div class="d-inline-flex">
            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>

        <table class="table table-striped table-hover table-fixed" id="dataTable">
            <thead class ="bg-dark text-white">
        
                <tr>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Name
                    </th>
                    <th>
                        Empoyment Date
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Type
                    </th>
                    <th>
                        Job Title
                    </th>
                    <th>Department</th>
            
                </tr>
            </thead>
            <tbody id="table-body">
                @foreach (var item in Model.employmentModel) {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'" style="cursor:pointer;")>
                        <td>
                            @Html.DisplayFor(modelItem => item.givenID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.personModel.personFullName)
                        </td>
                        <td>
                            @item.employmentDate.ToString("MMM dd,yyyy")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.employmentStatus)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
                        </td>

                        <td class="text-wrap">
                            @if (item.JobPlacements != null && item.JobPlacements.Any())
                            {
                                //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                @item.JobPlacements.OrderByDescending(jp=> jp.jobPlacementDate).FirstOrDefault().jobModel.jobTitle
                            }
                            else
                            {
                                <p>N/A</p>
                            }
                        </td>
                        <td class="text-wrap">
                                @if (item.JobPlacements != null && item.JobPlacements.Any())
                                {
                                    //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                }
                                else
                                {
                                    <p>N/A</p>
                                }
                        </td>
                
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!--Group View-->
    <div id="groupView" class="collapse" data-bs-parent="#parentDiv">
        <table class="table table-striped table-hover">
            <tbody id="departmentsAccordion">
                @{
                    int index = 0;
                }
                @foreach (var dep in Model.GroupedEmployments)
                {
                    var collapseId = $"collapse{index}";
                    <tr class="">
                        <td colspan="6" data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            style="cursor:pointer;">
                            <h4 class="fw-bold"
                                >
                                @dep.DepartmentName : @dep.Count
                            </h4>

                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" class="p-0">
                            <div id="@collapseId" class="accordion-collapse collapse"
                                 data-bs-parent="#departmentsAccordion">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-dark text-white">

                                        <tr>
                                            <th>
                                                Employee ID
                                            </th>
                                            <th>
                                                Name
                                            </th>
                                            <th>
                                                Empoyment Date
                                            </th>
                                            <th>
                                                Status
                                            </th>
                                            <th>
                                                Type
                                            </th>
                                            <th>
                                                Job Title
                                            </th>
                                            <th>Department</th>

                                        </tr>
                                    </thead>
                                    <tbody id="table-body">
                                        @foreach (var item in dep.Records)
                                        {
                                            <tr onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'" style="cursor:pointer;" )>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.givenID)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.personModel.personFullName)
                                                </td>
                                                <td>
                                                    @item.employmentDate.ToString("MMM dd,yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentStatus)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.employmentTypeModel.employmentTypeName)
                                                </td>

                                                <td class="text-wrap">
                                                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                                                    {
                                                        //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                        @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().jobModel.jobTitle
                                                    }
                                                    else
                                                    {
                                                        <p>N/A</p>
                                                    }
                                                </td>
                                                <td class="text-wrap">
                                                    @if (item.JobPlacements != null && item.JobPlacements.Any())
                                                    {
                                                        //@item.JobPlacements.OrderByDescending(JobPlacement => JobPlacement.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                        @item.JobPlacements.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault().departmentModel.departmentName
                                                    }
                                                    else
                                                    {
                                                        <p>N/A</p>
                                                    }
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>

