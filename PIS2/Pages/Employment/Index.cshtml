@page
@model PIS2.Pages.Employment.IndexModel

@{
    ViewData["Title"] = "Employment Dashboard";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1 class="fw-bold text-dark mb-1">Employee Management</h1>
        <div class="d-flex align-items-center gap-2">
            <h5 class="text-muted mb-0">@Model.Company</h5>
            <span class="badge bg-secondary fs-6">@Model.totalCount Employees</span>
        </div>
    </div>

    <div class="d-flex flex-column align-items-end gap-2">
        <div class="d-flex gap-3 mb-2">
            <div class="text-center p-2 bg-light rounded shadow-sm" style="min-width:100px;">
                <div class="text-muted small">Male</div>
                <div class="fw-semibold text-primary">@Model.maleCount</div>
                <div class="text-muted small">(@(Model.totalCount == 0 ? "0" : Math.Round((decimal)Model.maleCount * 100 / Model.totalCount, 2))%)</div>
            </div>
            <div class="text-center p-2 bg-light rounded shadow-sm" style="min-width:100px;">
                <div class="text-muted small">Female</div>
                <div class="fw-semibold text-danger">@Model.femaleCount</div>
                <div class="text-muted small">(@(Model.totalCount == 0 ? "0" : Math.Round((decimal)Model.femaleCount * 100 / Model.totalCount, 2))%)</div>
            </div>
            <div class="text-center p-2 bg-light rounded shadow-sm" style="min-width:100px;">
                <div class="text-muted small">Total</div>
                <div class="fw-bold">@Model.employmentModel.Count()</div>
            </div>
        </div>

        <a asp-page="Create" class="btn btn-success">
            <i class="bi bi-person-plus me-1"></i> Add Employee
        </a>
    </div>
</div>

<hr />

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="employmentTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="list-tab" data-bs-toggle="tab" data-bs-target="#listView" type="button" role="tab">
            <i class="bi bi-list me-1"></i> List View
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="department-tab" data-bs-toggle="tab" data-bs-target="#departmentView" type="button" role="tab">
            <i class="bi bi-diagram-3 me-1"></i> Department View
        </button>
    </li>
</ul>

<div class="tab-content" id="employmentTabContent">
    <!-- List View -->
    <div class="tab-pane fade show active" id="listView" role="tabpanel" aria-labelledby="list-tab">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-people me-2"></i>All Employees</h5>
                <div class="d-flex gap-2">
                    @await Html.PartialAsync("filter")
                    @await Html.PartialAsync("print")
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="dataTable">
                        <thead class="table-light">
                            <tr>
                                <th>Employee ID</th>
                                <th>Full Name</th>
                                <th>Employment Date</th>
                                <th>Status</th>
                                <th>Type</th>
                                <th>Job Title</th>
                                <th>Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.employmentModel)
                            {
                                <tr class="clickable-row" onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'">
                                    <td class="fw-semibold text-primary">@item.givenID</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3">
                                                <div class="avatar-initial bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                                                    @item.personModel?.personFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0]).FirstOrDefault()
                                                </div>
                                            </div>
                                            <div>@item.personModel?.personFullName</div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@item.employmentDate.ToString("MMM dd, yyyy")</span></td>
                                    <td>
                                        @{
                                            var statusClass = item.employmentStatus.ToString() switch
                                            {
                                                "Active" => "badge bg-success",
                                                "Inactive" => "badge bg-secondary",
                                                "Terminated" => "badge bg-danger",
                                                "OnLeave" => "badge bg-warning",
                                                _ => "badge bg-info"
                                            };
                                        }
                                        <span class="@statusClass">@item.employmentStatus</span>
                                    </td>
                                    <td><span class="badge bg-info text-dark">@item.employmentTypeModel.employmentTypeName</span></td>
                                    <td>@(item.JobPlacements?.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault()?.jobModel?.jobTitle ?? "N/A")</td>
                                    <td>@(item.JobPlacements?.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault()?.departmentModel?.departmentName ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                <div class="text-muted">Showing @Model.employmentModel.Count() records</div>
                <div class="d-flex gap-2">
                    <excel-export table="dataTable" filename="Employees_@(DateTime.Now).xlsx"></excel-export>
                    @await Html.PartialAsync("print")
                </div>
            </div>
        </div>
    </div>
    <!-- Department View -->
    <div class="tab-pane fade" id="departmentView" role="tabpanel" aria-labelledby="department-tab">
        @foreach(var comp in Model.GroupedEmployments.GroupBy(e => e.CompanyName))
        {
            <div>
                <h4 class="fw-bold">@comp.First().CompanyName</h4>
            </div>
        
            <div class="accordion" id="departmentsAccordion">
                @{
                    var counter = 0;
                }
                @foreach (var dep in comp)
                {
                    counter++;
                    var collapseId = $"collapse{counter}";
                    <div class="accordion-item mb-2 shadow-sm">
                        <h2 class="accordion-header" id="heading@collapseId">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                @dep.DepartmentName
                                <span class="ms-auto badge bg-primary-subtle text-primary me-2"><i class="bi bi-gender-male"></i> @dep.Male</span>
                                <span class="badge bg-danger-subtle text-danger me-2"><i class="bi bi-gender-female"></i>@dep.Female</span>
                                <span class="badge bg-secondary text-dark"><i class="bi bi-plus-circle"></i>@dep.Count</span>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading@collapseId" data-bs-parent="#departmentsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Employee ID</th>
                                                <th>Name</th>
                                                <th>Employment Date</th>
                                                <th>Status</th>
                                                <th>Job Title</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in dep.Records)
                                            {
                                                <tr class="clickable-row" onclick="location.href='@Url.Page("Details", new { id = item.employmentID })'">
                                                    <td class="fw-semibold">@item.givenID</td>
                                                    <td>@item.personModel.personFullName</td>
                                                    <td>@item.employmentDate.ToString("MM/dd/yyyy")</td>
                                                    <td>
                                                        @{
                                                            var statusClass = item.employmentStatus.ToString() switch
                                                            {
                                                                "Active" => "badge bg-success",
                                                                "Inactive" => "badge bg-secondary",
                                                                "Terminated" => "badge bg-danger",
                                                                "OnLeave" => "badge bg-warning",
                                                                _ => "badge bg-info"
                                                            };
                                                        }
                                                        <span class="@statusClass">@item.employmentStatus</span>
                                                    </td>
                                                    <td>@(item.JobPlacements?.OrderByDescending(jp => jp.jobPlacementDate).FirstOrDefault()?.jobModel?.jobTitle ?? "N/A")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        
    </div>
</div>