@page
@model PIS2.Pages.Employment.DetailsModel

@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employments</h1>
@if (Model.isSelf)
{
    <!--top buttons -->
    <div class="m-3 d-flex justify-content-lg-between bg-primary text-white d-print-none">
        @if (Model.employmentModel.employmentStatus == Models.mainStatus.Active)
        {
            <!--Leave Request button-->
            <a role="button" class="text-white nav-link flex-grow-1" asp-page="/Leave/Create">Leave Request</a>

            <!--Ovetime Button-->
            <a role="button" class="text-white nav-link flex-grow-1" asp-page="/OvertimeRecord/Create">Overtime Record</a>

        }

        <!--leave report-->
        @if (Model.employmentModel.Leaves != null && Model.employmentModel.Leaves.Any())
        {
            <a role="button" class="text-white nav-link flex-grow-1" id="leaveHistory" data-bs-toggle="collapse" data-bs-target="#leaveHistoryView" onclick="closeOtherCollapses('#collapseOne')">Leave History</a>
            <a role="button" class="text-white nav-link flex-grow-1" id="leaveAggrigate" data-bs-toggle="collapse" data-bs-target="#leaveAggrigate" onclick="closeOtherCollapses('#collapseOne')">Leave Summary</a>
            <a role="button" class="text-white nav-link flex-grow-1" id="overtimeHistory" data-bs-toggle="collapse" data-bs-target="#overtimeHistoryView" onclick="closeOtherCollapses('#collapseOne')">Overtime History</a>

        }
        <a role="button" class="text-white nav-link flex-grow-1">Evaluation</a>

    </div>
}
<div class="d-flex flex-column" id="employmentDetail">
    <div class="">
        <form method="get" class="d-print-none">
            <div class="d-flex justify-content-between">
                <h4 class="fw-bold">Full Name</h4>
                <div class="d-flex">
                    <input asp-for="employmentModel.givenID" id="givenID" class="form-control me-2" placeholder="Enter Given ID" name="givenID"/>
                    <button type="submit" class="btn btn-primary" id="goButton">Go</button>
                </div>
            </div>
        </form>
    </div>
    <hr />
    <div class="">
        <h5 class="fw-bold">Personal Information</h5>
        <hr />
        <div class="d-flex flex-wrap">
            <dl class="d-flex flex-column gap-3 d-print-flex flex-grow-1">
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Full Name:
                    </dt>
                    <dd>
                        <u onclick="location.href='@Url.Page("/Person/Details", new {id = Model.employmentModel.personID})'" style="cursor:pointer;">@Html.DisplayFor(model => model.employmentModel.personModel.personFullName)</u>
                    </dd>
                </div>
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Phone Number:
                    </dt>
                    <dd>
                        <u>@Html.DisplayFor(model => model.employmentModel.personModel.personPhoneNumber)</u>
                    </dd>
                </div>
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Email:
                    </dt>
                    <dd>
                        <u>@Html.DisplayFor(model => model.employmentModel.personModel.personEmailAddress)</u>
                    </dd>
                </div>
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Date Of Birth:
                    </dt>
                    <dd>
                        <u>@Model.employmentModel.personModel.personDoB.ToString("MMM dd, yyyy")</u>
                    </dd>
                </div>
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Address:
                    </dt>
                    <dd>
                        <u>@Html.DisplayFor(model => model.employmentModel.personModel.addressModel.addressFormatted)</u>
                    </dd>
                </div>
            
            </dl>

            @if (Model.employmentModel.personModel.PersonEducationLevels.Any() || Model.employmentModel.personModel.PersonEducationLevels != null)
            {
                <div class="flex-grow-1">
                <h5 class="fw-bold">Education Background and Certification</h5>
                <table class="table table-striped table-hover flex-grow-1">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Name</th>
                        <th>Grade</th>
                        <th>Category</th>
                        <th>Field of Study</th>
                        <th>GPA</th>
                        <th>Institution</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.employmentModel.personModel.PersonEducationLevels)
                    {
                        <tr>
                            <td>@item.educationLevelModel.educationLevelName</td>
                            <td>@item.educationLevelModel.educationLevelGrade</td>
                            <td>@item.educationLevelModel.educationLevelCategory</td>
                            <td>@item.educationField</td>
                            <td>@item.educationLevelMark</td>
                            <td>@item.educationLevelInstitutionName</td>
                            <td>@item.educationLevelDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            }
        </div>
    </div>
    <div class="">
    <hr />
        @if(Model.employmentModel.employmentStatus == Models.mainStatus.Active)
        {
            <h5 class="fw-bold text-success p-2">Employment Information</h5>
        }
        else
        {
            <h5 class="fw-bold text-danger  p-2">Employment Information</h5>
        }

        <hr />
        <dl class="d-flex flex-wrap flex-grow-1 gap-3 d-print-flex">
            
            <div class="d-flex me-3">
                <dt class="me-1">
                    Employee ID:
                </dt>
                <dd>
                    <u>@Html.DisplayFor(model => model.employmentModel.givenID)</u>
                </dd>
            </div>

            <div class="d-flex me-3">
                <dt class="me-1">
                    Hire Date:
                </dt>
                <dd>
                    <u>@Model.employmentModel.employmentDate.ToString("MMM dd, yyy")</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Employment Type:
                </dt>
                <dd>
                    <u>@Html.DisplayFor(model => model.employmentModel.employmentTypeModel.employmentTypeName)</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Employment Position:
                </dt>
                <dd>
                    <u>@Html.DisplayFor(model => model.employmentModel.employmentPosition)</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Status:
                </dt>
                <dd>
                    <u>@Html.DisplayFor(model => model.employmentModel.employmentStatus)</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Reference:
                </dt>
                <dd>
                    <u>@Html.DisplayFor(model => model.employmentModel.employmentReference)</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Exprience:
                </dt>
                <dd>
                    <u>@Model.Exprience</u>
                </dd>
            </div>
            <div class="d-flex me-3">
                <dt class="me-1">
                    Age:
                </dt>
                <dd>
                    <u>@Model.Age</u>
                </dd>
            </div>

            @if (Model.employmentModel.employmentStatus == Models.mainStatus.Inactive)
            {
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Termination Date:
                    </dt>
                    <dd>
                        <u>@Model.employmentModel.TerminationModel.terminationDate.ToString("MMM dd, yyyy")</u>
                    </dd>
                </div>
                <div class="d-flex me-3">
                    <dt class="me-1">
                        Termination Reason;
                    </dt>
                    <dd>
                        <u>@Model.employmentModel.TerminationModel.terminationReason</u>
                    </dd>
                </div>
                
            }
            else
            {
               
                
            }
        </dl>
        <div class="d-flex justify-content-end">
            <a asp-page="/EmployeeService/Earning" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-primary">View Earnings</a>
        </div>
    </div>
    <div class="w-100">
    <hr />
        <h4 class="fw-bold">Employment History</h4>
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-dark text-white">
                    <th>Date</th>
                    <th>Type</th>
                    <th>Position</th>
                    <th>Status</th>
                    <th>Remark</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.employmentModel.EmploymentHistories)
                {
                    <tr>
                        <td>@item.modifiedDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.employmentTypeModel.employmentTypeName</td>
                        <td>@item.employmentPosition</td>
                        <td>@item.employmentStatus</td>
                        
                        <td>@item.employmentHistoryRemark</td>

                        <td>@item.modifiedBy</td>
                    </tr>
                }
                </tbody>
            </table>

        @if (Model.employmentModel.JobPlacements != null && Model.employmentModel.JobPlacements.Any())
        {
            <h4 class="fw-bold">Job Placements History</h4>
            <table class="table table-stripped table-hover">
                <thead>
                    <tr class="bg-info text-white">
                        <th>Date</th>
                        <th>Job Title</th>
                        <th>Grade</th>
                        <th>Step</th>
                        <th>Salary</th>
                        <th>Department</th>
                        <th>Company</th>
                        <th>Work Location</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.employmentModel.JobPlacements)
                    {
                        <tr onclick="location.href='@Url.Page("/JobPlacement/Details", new {id = item.jobPlacementID})'" style="cursor:pointer">
                            <td>@item.jobPlacementDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.jobModel?.jobTitle</td>
                            <td>@item.jobModel?.jobGradeModel?.jobGradeName</td>
                            <td>@item.jobStepModel?.jobStepNumber</td>
                            <td>@item.jobPlacementSalary</td>
                            <td>@item.departmentModel?.departmentName</td>
                            <td>@item.departmentModel?.companyModel?.companyName</td>
                            <td></td>
                            <td>@item.jobPlacementStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>

</div>

<div class="d-print-none d-flex justify-content-end">
    @if (User.IsInRole("PMS_HRCLERK"))
    {
        <a class="btn btn-primary m-2" asp-page="./Edit" asp-route-id="@Model.employmentModel.employmentID">Edit</a>
    }
    
    <a class = "btn btn-primary m-2" asp-page="./Index">View All Employee List</a> 
    @await Html.PartialAsync("print")
</div>
