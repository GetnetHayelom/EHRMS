@page
@model PIS2.Pages.Employment.DetailsModel

@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employments</h1>
<div class="d-flex flex-wrap" id="employmentDetail">
    <div class="">
        <h4>Employment Details</h4>

        <hr />
        <dl class="d-flex flex-wrap gap-3 d-print-flex">
            <div class ="d-flex">
            <dt class="me-1">
                Employee ID:
            </dt>
            <dd>
                @Html.DisplayFor(model => model.employmentModel.givenID)
            </dd>
            </div>
            <div class="d-flex">
                <dt class="me-1">
                Full Name:
            </dt>
            <dd>
                @Html.DisplayFor(model => model.employmentModel.personModel.personFullName)
                </dd>
            </div>
            <div class="d-flex">
                <dt class="me-1">
                Hire Date:
            </dt>
            <dd>
                @Model.employmentModel.employmentDate.ToString("MMM dd, yyy")
            </dd>
            </div>
            <div class="d-flex">
                <dt class="me-1">
                Employment Type:
            </dt>
            <dd>
                @Html.DisplayFor(model => model.employmentModel.employmentTypeModel.employmentTypeName)
                </dd>
            </div>
            <div class="d-flex">
                <dt class="me-1">
                Status:
            </dt>
            <dd >
                @Html.DisplayFor(model => model.employmentModel.employmentStatus)
                </dd>
            </div>
            
            @if (Model.employmentModel.employmentStatus == Models.mainStatus.Inactive)
                {
                    <div class="d-flex">
                    <dt class="me-1">
                    Termination Date:
                </dt>
                <dd >
                    @Html.DisplayFor(model => model.employmentModel.employmentTerminationDate)
                </dd></div>
            }
            
            <div class="d-flex">
                <dt class="me-1">
                Reference:
            </dt>
            <dd>
                @Html.DisplayFor(model => model.employmentModel.employmentReference)
            </dd>
            </div>
            <div class="d-flex">
                <dt class="me-1">
                Working Hours Per Week:
            </dt>
            <dd>
                @Html.DisplayFor(model => model.employmentModel.workingHoursPerWeek)
            </dd>
            </div>
        </dl>
    </div>
    <div class="w-100">
        <h4>Employment History</h4>
        <table class="table table-striped table-hover">
        <thead>
            <tr class="bg-dark text-white">
                        <th>Date</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Remark</th>
                        <th>User</th>
            </tr></thead>
            <tbody>
                    @foreach(var item in Model.employmentModel.EmploymentHistories)
                    {
                        <tr>
                            <td>@item.modifiedDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.employmentTypeModel.employmentTypeName</td>

                            <td>@Html.DisplayFor(item => item.employmentModel.employmentStatus)</td>

                            <td>@item.employmentHistoryRemark</td>

                            <td>@item.modifiedBy</td>
                        </tr>
                    }
                </tbody>
                </table>

        @if (Model.employmentModel.JobPlacements != null && Model.employmentModel.JobPlacements.Any())
        {
            <h4>Job Placements History</h4>
            <table class="table table-stripped table-hover">
                <thead>
                    <tr class="bg-info text-white">
                        <th>Date</th>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Work Location</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.employmentModel.JobPlacements)
                    {
                        <tr>
                            <td>@item.jobPlacementDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.jobModel.jobTitle</td>
                            <td>@item.departmentModel.departmentName</td>
                            <td>@item.workSiteModel.workSiteName</td>
                            <td>@item.jobPlacementStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>

</div>

<div class="d-print-none">
    <a asp-page="./Edit" asp-route-id="@Model.employmentModel.employmentID">Edit</a> |
    <a asp-page="./Index">Back to List</a> |
    @await Html.PartialAsync("print")
</div>
