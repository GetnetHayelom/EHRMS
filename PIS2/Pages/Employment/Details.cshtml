@page
@using PIS2.Enums
@model PIS2.Pages.Employment.DetailsModel

@{
    ViewData["Title"] = "Employment Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-1 d-print-none gap-3">
        <div>
            <h2 class="fw-bold m-0 text-dark">Employment Record</h2>
            <small class="text-muted m-0">Manage employee leave, overtime, and job history #@Model.employmentModel.employmentID</small>
        </div>
        <!--EMPLOYEE LOOKUP-->
        <div class="card shadow-sm border-0 px-3 py-2">
            <form method="get" class="d-flex align-items-center gap-2">
                <label for="givenID" class="text-nowrap small fw-bold text-uppercase text-muted mb-0">Find Employee:</label>
                <input asp-for="employmentModel.givenID" id="givenID" class="form-control form-control-sm" placeholder="Enter ID..." name="givenID" style="width: 150px;" />
                <button type="submit" class="btn btn-sm btn-primary px-3" id="goButton">Go</button>
            </form>
        </div>
    </div>

    <!--CALL TO ACTION-->
    <div class="card shadow-sm border-0 mb-1 d-print-none">
        <div class="card-body p-2 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
            <ul class="nav nav-pills gap-2" id="employmentTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="btn btn-outline-primary btn-sm active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-content" type="button" role="tab">
                        <i class="bi bi-person-lines-fill me-1"></i> Employment Details
                    </button>
                </li>
                    @if (Model.employmentModel.employmentStatus == mainStatus.Active)
                    {
                        <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm" asp-page="/Leave/Create" asp-route-id="@Model.employmentModel.employmentID"><i class="bi bi-calendar-plus"></i> Leave Request</a>
                        </li>
                        <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm" asp-page="/OvertimeRecord/Create" asp-route-id="@Model.employmentModel.employmentID"><i class="bi bi-clock-history"></i> Overtime Record</a>
                        </li>  
                    }

                    @if (Model.employmentModel.Leaves != null && Model.employmentModel.Leaves.Any())
                    {
                        <li class="nav-item" role="presentation">
                            <button class="btn btn-light btn-sm border" data-bs-toggle="tab" data-bs-target="#leaveHistoryView" role="tab"><i class="bi bi-list-check"></i> Leave History</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="btn btn-light btn-sm border" data-bs-toggle="tab" data-bs-target="#leaveSummaryView" role="tab"><i class="bi bi-pie-chart"></i> Leave Summary</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="btn btn-light btn-sm border" data-bs-toggle="tab" data-bs-target="#overtimeHistoryView" role="tab"><i class="bi bi-stopwatch"></i> Overtime History</button>
                        </li>
                    }
                    
                    <li class="nav-item">
                        <button class="btn btn-light btn-sm border" data-bs-toggle="tab" data-bs-target="#evaluationHistoryView" role="tab"><i class="bi bi-star"></i> Evaluation</button>
                    </li>
            </ul>
        </div>
    </div>

    <!--BODY-->
    <div class="row">

        <!--PERSON INFORMATION CARD-->
        <div class="col-lg-4">
            
            @await Html.PartialAsync("_PersonalInfoPartial", Model.Person)

            <!--SERVICE YEAR AND SEVERANCE-->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Service</small>
                        <h4 class="fw-bold m-0 text-primary">@Model.Exprience</h4>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Severance</small>
                        <h4 class="fw-bold m-0 text-success">@Math.Round(Model.Severance, 2).ToString("N2")</h4>
                        <small class="text-muted small">ETB</small>
                    </div>
                </div>
            </div>
            <!--LEAVE AND LEAVE PAYABLE-->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Allowed Leave</small>
                        <h4 class="fw-bold m-0 text-primary">@Model.LeaveDetail?.AllowedLeave.ToString("N1")</h4>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Leave Payable</small>
                        <h4 class="fw-bold m-0 text-success">@Math.Round(Model.LeaveDetail.leaveCost, 2).ToString("N2")</h4>
                        <small class="text-muted small">ETB</small>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="tab-content col-lg-8" id="employmentTabContent">
            
            
            <!--EMPLOYMENT STATUS-->
            <div class="tab-pane fade show active" id="details-content" role="tabpanel" aria-labelledby="details-tab">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title fw-bold m-0 text-primary">Employment Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Employee ID</label>
                                <span class="fw-bold">#@Model.employmentModel.givenID</span>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Hire Date</label>
                                <span class="fw-bold">@Model.employmentModel.employmentDate.ToString("MM/dd/yyyy")</span>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Type</label>
                                <span class="badge bg-light text-dark border fw-medium">@Model.employmentModel.employmentTypeModel.employmentTypeName</span>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Current Position</label>
                                <span class="fw-bold text-uppercase">@Model.employmentModel.employmentPosition</span>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Age</label>
                                <span class="fw-bold">@Model.Age Years</span>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small d-block">Reference</label>
                                <span class="fw-bold">@Model.employmentModel.employmentReference</span>
                            </div>

                            @if (Model.employmentModel.employmentStatus == mainStatus.Inactive)
                            {
                                <div class="col-12 mt-3">
                                    <div class="bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded p-3">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label class="text-danger small fw-bold">Termination Date</label>
                                                <div class="fw-bold">@Model.employmentModel.TerminationModel?.terminationDate.ToString("MM/dd/yyyy")</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="text-danger small fw-bold">Termination Reason</label>
                                                <div class="fw-bold">@Model.employmentModel.TerminationModel?.terminationReason</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        
                        </div>
                        <div class="text-end mt-4 d-print-none">
                            <a asp-page="/EmployeeService/Earning" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-outline-primary">
                                <i class="bi bi-wallet2"></i> View Earnings Details
                            </a>
                        </div>
                    </div>
                </div>
                <!--ACCORDION-->
                <div class="accordion accordion-flush border rounded shadow-sm overflow-hidden bg-white" id="employmentHistoryAccordion">

                    <!--EMPLOYMENT HISTORY-->
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#histCollapse">
                                Employment History Log
                            </button>
                        </h2>
                        <div id="histCollapse" class="accordion-collapse collapse" data-bs-parent="#employmentHistoryAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Type</th>
                                                <th>Position</th>
                                                <th>Status</th>
                                                <th>Modified By</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.employmentModel.EmploymentHistories.OrderBy(e => e.modifiedDate))
                                            {
                                                <tr>
                                                    <td class="fw-bold">@item.employmentTypeModel?.employmentTypeName</td>
                                                    <td>@item.employmentPosition</td>
                                                    <td><span class="badge @(item.employmentStatus == mainStatus.Active ? "bg-success" : "bg-secondary")">@item.employmentStatus</span></td>
                                                    <td class="text-muted">
                                                        <p class="mb-0">@item.modifiedBy</p>
                                                        <p class="ps-3 mb-0">@item.modifiedDate.ToString("MM/dd/yyyy")</p>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--JOB PLACEMENT-->
                    @if (Model.employmentModel.JobPlacements?.Any() == true)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#jobCollapse">
                                    Job Placements History
                                </button>
                            </h2>
                            <div id="jobCollapse" class="accordion-collapse collapse" data-bs-parent="#employmentHistoryAccordion">
                                <div class="accordion-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 small">
                                            <thead class="table-light text-nowrap">
                                                <tr>
                                                    <th class="ps-3">Date</th>
                                                    <th>Title</th>
                                                    <th>Grade/Step</th>
                                                    <th>Salary</th>
                                                    <th>Dept/Company</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.employmentModel.JobPlacements.OrderBy(j => j.jobPlacementDate))
                                                {
                                                    <tr onclick="location.href='@Url.Page("/JobPlacement/Details", new { id = item.jobPlacementID })'" style="cursor:pointer">
                                                        <td class="ps-3">@item.jobPlacementDate.ToString("MM/dd/yy")</td>
                                                        <td class="fw-bold">@item.jobModel?.jobTitle</td>
                                                        <td>@item.jobModel?.jobGradeModel?.jobGradeName / @item.jobStepModel?.jobStepNumber</td>
                                                        <td class="text-success fw-bold">@item.jobPlacementSalary</td>
                                                        <td>
                                                            <div class="fw-bold">@item.departmentModel?.departmentName</div>
                                                            <div class="text-muted small">@item.departmentModel?.companyModel?.companyName</div>
                                                        </td>
                                                        <td><span class="badge @(item.jobPlacementStatus == mainStatus.Active ? "bg-success" : "border text-dark")">@item.jobPlacementStatus</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }


                    <!--EDUCATION AND CERTIFICATION-->
                    @if (Model.employmentModel.personModel.PersonEducationLevels?.Any() == true)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#eduCollapse">
                                    Education & Certifications
                                </button>
                            </h2>
                            <div id="eduCollapse" class="accordion-collapse collapse" data-bs-parent="#employmentHistoryAccordion">
                                <div class="accordion-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 small">
                                            <thead class="table-light text-nowrap">
                                                <tr>
                                                    <th class="ps-3">Category/Level</th>
                                                    <th>Field of Study</th>
                                                    <th>Grade/GPA</th>
                                                    <th>Institution</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.employmentModel.personModel.PersonEducationLevels)
                                                {
                                                    <tr>
                                                        <td class="ps-3 fw-bold">@item.educationLevelModel.educationLevelCategory (@item.educationLevelModel.educationLevelName)</td>
                                                        <td>@item.educationField</td>
                                                        <td><span class="badge bg-secondary">@item.educationLevelMark</span></td>
                                                        <td>@item.educationLevelInstitutionName</td>
                                                        <td>@item.educationLevelDate.ToString("yyyy")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!--CAREER PROGRESSION-->
                    <div class="card shadow-sm mt-2">
                        <div class="card-header"><h5 class="fw-bold">Career Progression & Grade Benchmarking</h5></div>
                        <div class="card-body"><canvas id="careerChart" width="800" height="200"></canvas></div>
                    </div>
                    <!--CAREER PATH-->
                    <div class="career-path-container mt-2 p-2">
                        <h5 class="fw-bold">Projected Career Growth Path</h5>
                        <ul id="careerTimeline" class="d-flex flex-wrap w-auto gap-2">
                        </ul>
                    </div>
                    <!--ATTACHMENT-->
                    @await Html.PartialAsync("_AttachmentPartial",
                    new Pages.Shared.AttachmentPartialModel
                    {
                        tableName = "Employment",
                        recordId = Model.employmentModel.employmentID
                    })
                </div>
            </div>
            
            <!--LEAVE HISTORY-->
            <div class="tab-pane fade" id="leaveHistoryView" role="tabpanel" aria-labelledby="leave-tab">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Leave History & Summary</h5>
                        
                        @if (Model.employmentModel.Leaves != null)
                        {
                            @await Html.PartialAsync("_LeaveHistoryPartial", Model.Leaves)
                        }
                        else
                        {
                            <p class="text-muted">No leave records found.</p>
                        }
                    </div>
                </div>
            </div>

            <!--LEAVE SUMMARY-->
            <div class="tab-pane fade" id="leaveSummaryView" role="tabpanel" aria-labelledby="leave-tab">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Leave History & Summary</h5>

                        @if (Model.employmentModel.Leaves != null)
                        {
                            @await Html.PartialAsync("_LeaveSummaryPartial", Model.LeaveDetail)
                        }
                        else
                        {
                            <p class="text-muted">No leave records found.</p>
                        }
                    </div>
                </div>
            </div>

            <!--OVERTIME HISTORY-->
            <div class="tab-pane fade" id="overtimeHistoryView" role="tabpanel" aria-labelledby="overtime-tab">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Overtime Records</h5>
                        @if (Model.employmentModel.OvertimeRecords != null)
                        {
                            @await Html.PartialAsync("_OvertimeHistoryPartial", Model.Overtimes)
                        }
                        else
                        {
                            <p class="text-muted">No overtime records found.</p>
                        }
                    </div>
                </div>
            </div>

            <!--EVALUATION HISTORY-->
            <div class="tab-pane fade" id="evaluationHistoryView" role="tabpanel" aria-labelledby="overtime-tab">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Evaluation Records</h5>
                        @if (Model.EvalReport != null)
                        {
                            @foreach(var eval in Model.EvalReport)
                            {
                                @await Html.PartialAsync("_EvaluationPartial", eval)
                            }
                            
                        }
                        else
                        {
                            <p class="text-muted">No evaluation records found.</p>
                        }
                    </div>
                </div>
            </div>
            
        </div>

    </div>
    
    
    
    <div class="mt-4 pt-3 border-top d-print-none d-flex justify-content-end align-items-center">
        <a class="btn btn-outline-secondary" asp-page="./Index"><i class="bi bi-arrow-left"></i> Employee Catalog</a>
        <div class="d-flex gap-2">
            @if (User.IsInRole("HRPERSONNEL"))
            {
                <a class="btn btn-primary m-2" asp-page="./Edit" asp-route-id="@Model.employmentModel.employmentID"><i class="bi bi-pencil-square me-2"></i>@L.T("Edit") Record</a>
            }
            @await Html.PartialAsync("print")
        </div>
    </div>
</div>




<script>
    document.addEventListener("DOMContentLoaded", function () {

        const typeElems = document.querySelectorAll('.overall-score');

        typeElems.forEach((el, index) => {
            const next = typeElems[index + 1]; // compare to older row
            if (!next) return;

            const current = parseFloat(el.dataset.value);
            const older = parseFloat(next.dataset.value);

            if (current > older) {
                el.insertAdjacentHTML('afterend',
                    '<span class="text-success ms-2">▲</span>');
            }
            else if (current < older) {
                el.insertAdjacentHTML('afterend',
                    '<span class="text-danger ms-2">▼</span>');
            }
        });

        });
    document.addEventListener("DOMContentLoaded", function () {

        const currentTypes = document.querySelectorAll(
            '.type-contribution'
        );

        currentTypes.forEach((el, index) => {
            const typeKey = el.dataset.type;
            const currentValue = parseFloat(el.dataset.value);
            const next = currentTypes[index +1];
            if (!next) return;

            if (next.dataset.type !== typeKey) return;

            const previousValue = parseFloat(next.dataset.value);

            if (currentValue > previousValue) {
                el.insertAdjacentHTML('afterend',
                    '<span class="text-success ms-2" title="Improved">▲</span>');
            }
            else if (currentValue < previousValue) {
                el.insertAdjacentHTML('afterend',
                    '<span class="text-danger ms-2" title="Dropped">▼</span>');
            }
            
            
        });

    });
</script>

<script>
    fetch('?handler=EmployeeProgress&employmentId=@Model.employmentModel.employmentID')
        .then(response => response.json())
        .then(data => {
            const ctx = document.getElementById('careerChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.dates,
                    datasets: [
                        {
                            label: 'Employee Actual Salary',
                            data: data.employeeSalaries,
                            borderColor: 'rgba(0, 225, 255, 1)',
                            borderWidth: 3,
                            fill: false,
                            tension: 0.1
                        },
                        {
                            label: 'Dept Average Salary',
                            data: data.averageSalaries,
                            borderColor: 'rgba(255, 225, 64, 0.5)',
                            borderDash: [5, 5],
                            fill: false
                        },
                        {
                            label: 'Grade Max (Path)',
                            data: data.gradeMax,
                            borderColor: 'rgba(255, 99, 132, 0.2)',
                            backgroundColor: 'rgba(255, 99, 132, 0.05)',
                            fill: true, // This creates the "band" effect
                            pointRadius: 0
                        },
                        {
                            label: 'Grade Midpoint',
                            data: data.gradeMidpoints,
                            borderColor: 'rgba(54, 162, 235, 0.4)',
                            borderDash: [2, 2],
                            fill: false,
                            pointStyle: 'rectRot'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            title: { display: true, text: 'Salary Amount' },
                            beginAtZero: false
                        },
                        x: {
                            title: { display: true, text: 'Placement Date' }
                        }
                    },
                    plugins: {
                        tooltip: { mode: 'index', intersect: false },
                        title: { display: true, text: 'Career Progression & Grade Benchmarking' }
                    }
                }
            });
        });
</script>

<script>
    fetch('?handler=CareerPath&employmentId=@Model.employmentModel.employmentID')
        .then(res => res.json())
        .then(data => {
            const container = document.getElementById('careerTimeline');
            const filteredData = data.filter(step => step.potentialTitles && step.potentialTitles.length > 0);

            if (filteredData.length === 0) {
                container.innerHTML = '<li class="text-muted">No further career progression found within this job class.</li>';
                return;}
            container.innerHTML = filteredData.map((step, index) => `
                <li class="card shadow-sm p-2">
                <div class="card-header">
                    <div class="badge bg-primary">${step.gradeName}</div>
                </div>

                <div class="card-body">
                    <strong>Possible Titles:</strong>
                    ${step.potentialTitles.length > 0 ? step.potentialTitles.join(", <br>") : "No titles defined for this grade"}
                    <br/>
                    <small class="text-muted">Pay Range: ${step.salaryRange}</small>
                </div>
                </li>
            `).join('<div class="d-flex align-items-center"><div class="badge bg-outline-success" ><i class="bi bi-arrow-right mx-2"></i></div></div>');
        });
</script>
