@page
@using PIS2.Enums
@model PIS2.Pages.Employment.EditModel

@{
    ViewData["Title"] = "Edit Employment Master";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!--TITLE PART-->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-page="./Index" class="text-decoration-none">Employments</a></li>
                    <li class="breadcrumb-item active">@L.T("Edit") Master Data</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark m-0"><i class="bi bi-database-gear me-2 text-primary"></i>Employee Master Record</h2>
        </div>
        <div class="d-print-none">
            <a asp-page="./Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!--PERSON INFORMATION AND SEARCH-->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center justify-content-between">
                <div class="col-md-auto">
                    @if (Model.EmpSelected)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <img src="/api/attachments/viewprofile/@Model?.personModel?.personID"
                                 class="rounded-circle border shadow-sm" width="55" height="55" style="object-fit: cover;"
                                 onerror="this.onerror=null; this.src='/images/@(Model.personModel.personGender == Gender.Female ? "female-default.png" : "male-default.png")';">
                            <div>
                                <h5 class="fw-bold m-0 text-dark" style="cursor:pointer;" onclick="location.href='@Url.Page("/Person/Details", new { id = Model.personModel.personID })'">
                                    @Model.personModel.personFullName
                                </h5>
                                <div class="small text-muted d-flex gap-3">
                                    <span><i class="bi bi-hash"></i> @Model.personModel.personID</span>
                                    <span><i class="bi bi-telephone"></i> @Model.personModel.personPhoneNumber</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic"><i class="bi bi-info-circle me-1"></i> No employee selected.</span>
                    }
                </div>
                <div class="col-md-4" style="max-width: 400px;">
                    <div class="input-group">
                        <input asp-for="employmentModel.givenID" class="form-control border-end-0 shadow-none" placeholder="Enter Employee ID..." name="givenID" />
                        <button type="submit" class="btn btn-primary px-3"><i class="bi bi-search"></i> Load</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

   <!--PAGE BODY-->
    @if (Model.EmpSelected)
    { 
        <!--FORMS-->
        <div class="row g-4">
            <div class="col-lg-8">
                <!--PERSON INFORMATION FORM-->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="card-title fw-bold m-0 text-primary"><i class="bi bi-person-vcard me-2"></i>Personal Information</h6>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="UpdatePerson">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                            <input type="hidden" asp-for="personModel.personID" />

                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label asp-for="personModel.personFirstName" class="form-label small fw-bold text-muted">First Name</label>
                                    <input asp-for="personModel.personFirstName" class="form-control form-control-sm" />
                                    <span asp-validation-for="personModel.personFirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="personModel.personFatherName" class="form-label small fw-bold text-muted">Father's Name</label>
                                    <input asp-for="personModel.personFatherName" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="personModel.personLastName" class="form-label small fw-bold text-muted">Last Name</label>
                                    <input asp-for="personModel.personLastName" class="form-control form-control-sm" />
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="personModel.personDoB" class="form-label small fw-bold text-muted">Date of Birth</label>
                                    <input asp-for="personModel.personDoB" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.personGender" class="form-label small fw-bold text-muted">Gender</label>
                                    <select asp-for="personModel.personGender" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Gender>()"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.personPhoneNumber" class="form-label small fw-bold text-muted">Phone Number</label>
                                    <input asp-for="personModel.personPhoneNumber" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.personEmailAddress" class="form-label small fw-bold text-muted">Email Address</label>
                                    <input asp-for="personModel.personEmailAddress" class="form-control form-control-sm" />
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="personModel.personIDType" class="form-label small fw-bold text-muted">ID Type</label>
                                    <input asp-for="personModel.personIDType" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.personIDNumber" class="form-label small fw-bold text-muted">ID Number</label>
                                    <input asp-for="personModel.personIDNumber" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.personRecordNumber" class="form-label small fw-bold text-muted">Record Number</label>
                                    <input asp-for="personModel.personRecordNumber" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="personModel.addressID" class="form-label small fw-bold text-muted">Physical Address</label>
                                    <select asp-for="personModel.addressID" class="form-select form-select-sm" asp-items="ViewBag.addressID"></select>
                                </div>
                            </div>

                            <div class="mt-3 pt-3 border-top text-end">
                                <a asp-page="/Person/Details" asp-route-id="@Model.personModel.personID" class="btn btn-link text-decoration-none btn-sm me-2">View Full Profile <i class="bi bi-arrow-up-right"></i></a>
                                <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm"><i class="bi bi-check2-circle me-1"></i>@L.T("Save") Personal Info</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!--EMPLOYMENT FORM-->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="card-title fw-bold m-0 text-primary"><i class="bi bi-briefcase me-2"></i>Employment Status</h6>
                        <span class="badge @(Model.employmentModel.employmentStatus == mainStatus.Active ? "bg-success bg-opacity-75" : "bg-danger bg-opacity-75")">
                            @Model.employmentModel.employmentStatus
                        </span>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="UpdateEmployment">
                            <input type="hidden" asp-for="employmentModel.employmentID" />
                            <input type="hidden" asp-for="employmentModel.personID" value="@Model.personModel.personID" />

                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label asp-for="employmentModel.givenID" class="form-label small fw-bold text-muted">Employee ID</label>
                                    <input asp-for="employmentModel.givenID" class="form-control form-control-sm bg-light" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="employmentModel.employmentTypeID" class="form-label small fw-bold text-muted">Type</label>
                                    <select asp-for="employmentModel.employmentTypeID" class="form-select form-select-sm" asp-items="ViewBag.employmentTypeID"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="employmentModel.employmentDate" class="form-label small fw-bold text-muted">Hire Date</label>
                                    <input asp-for="employmentModel.employmentDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="employmentModel.employmentStatus" class="form-label small fw-bold text-muted">Current Status</label>
                                    <input asp-for="employmentModel.employmentStatus" class="form-control form-control-sm bg-light" readonly />
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="employmentModel.employmentPosition" class="form-label small fw-bold text-muted">Position Category</label>
                                    <select asp-for="employmentModel.employmentPosition" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Enums.EmploymentPositions>()"></select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="employmentModel.employmentReference" class="form-label small fw-bold text-muted">Reference No.</label>
                                    <input asp-for="employmentModel.employmentReference" class="form-control form-control-sm" />
                                </div>
                            </div>

                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (Model.employmentModel.employmentStatus != mainStatus.Inactive)
                                    {
                                        <a asp-page="/Termination/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle me-1"></i> Terminate</a>
                                    }
                                </div>
                                <div>
                                    <a asp-page="/Employment/Details" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-link text-decoration-none btn-sm me-2">View Details <i class="bi bi-arrow-up-right"></i></a>
                                    <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm"><i class="bi bi-check2-circle me-1"></i> Update Employment</button>
                                </div>
                            </div>
                        </form>
                        
                    </div>
                </div>

                <!--JOB PLACEMENT FORM-->
                @if (Model.employmentModel.employmentStatus != mainStatus.Inactive)
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom py-3">
                            <h6 class="card-title fw-bold m-0 text-primary"><i class="bi bi-geo-alt me-2"></i>Active Job Placement</h6>
                        </div>
                        <div class="card-body">
                            @if (Model.jobPlacementModel.jobPlacementID != 0)
                            {
                                <form method="post" asp-page-handler="SaveJobPlacement">
                                    <input type="hidden" asp-for="jobPlacementModel.jobPlacementID" />
                                    <input type="hidden" asp-for="jobPlacementModel.employmentID" value="@Model.employmentModel.employmentID" />

                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold text-muted">Company</label>
                                            <select asp-for="jobPlacementModel.departmentModel.companyID" class="form-select form-select-sm shadow-none" asp-items="ViewBag.companyID" id="filter-company"></select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold text-muted">Department</label>
                                            <select asp-for="jobPlacementModel.departmentID" class="form-select form-select-sm" asp-items="ViewBag.departmentID" id="filter-department"></select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold text-muted">Job Title (Locked)</label>
                                            <select asp-for="jobPlacementModel.jobID" class="form-select form-select-sm bg-light" asp-items="ViewBag.jobID" style="pointer-events: none;"></select>
                                        </div>

                                        <div class="col-md-3">
                                            <label asp-for="jobPlacementModel.jobStepID" class="form-label small fw-bold text-muted">Grade & Step</label>
                                            <select asp-for="jobPlacementModel.jobStepID" class="form-select form-select-sm" asp-items="ViewBag.jobStepID"></select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-muted">Basic Salary</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text text-muted">$</span>
                                                <input asp-for="jobPlacementModel.jobPlacementSalary" class="form-control" type="number" />
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold text-muted">Effective Date</label>
                                            <input asp-for="jobPlacementModel.jobPlacementDate" class="form-control form-control-sm" type="date" />
                                        </div>
                                        <div class="col-md-3">
                                            <label asp-for="jobPlacementModel.jobPlacementReference" class="form-label small fw-bold text-muted">Reference No.</label>
                                            <input asp-for="jobPlacementModel.jobPlacementReference" class="form-control form-control-sm" />
                                        </div>

                                        <div class="col-md-4">
                                            <label asp-for="jobPlacementModel.jobPlacementStatus" class="form-label small fw-bold text-muted">Placement Status</label>
                                            <select asp-for="jobPlacementModel.jobPlacementStatus" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                                        </div>
                                        <div class="col-md-8">
                                            <label asp-for="jobPlacementModel.jobPlacementReason" class="form-label small fw-bold text-muted">Reason for Action</label>
                                            <select asp-for="jobPlacementModel.jobPlacementReason" class="form-select form-select-sm">
                                                <option value="">-- Select Reason --</option>
                                                <option>New Hire</option>
                                                <option>Promotion</option>
                                                <option>Transfer</option>
                                                <option>Demotion</option>
                                                <option>Temporary Assignment</option>
                                                <option>Other</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mt-3 pt-3 border-top d-flex justify-content-end align-items-center gap-2">
                                        <a asp-page="/JobPlacement/Details" asp-route-id="@Model.jobPlacementModel.jobPlacementID" class="btn btn-link text-decoration-none btn-sm me-2">History <i class="bi bi-arrow-up-right"></i></a>
                                        <a asp-page="/JobPlacement/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-outline-primary btn-sm"><i class="bi bi-plus-lg"></i> New Assignment</a>
                                        <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm"><i class="bi bi-check2-circle me-1"></i>@L.T("Save") Placement</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox text-muted fs-1"></i>
                                    <p class="text-muted fw-bold mt-2">No active job placement found.</p>
                                    <a asp-page="/JobPlacement/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-primary btn-sm px-4">Assign a Job Now</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!--EXPERIENCE AND EDUCATION-->
            <div class="col-lg-4">
                <!--EXPERIENCE FORM AND VIEW-->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history me-2"></i>Experience</h6>
                        <button class="btn btn-xs btn-outline-primary py-0 px-2 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#expForm">
                            <i class="bi bi-plus"></i> Add New
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <!--EXPERIENCE FORM-->
                        <div class="collapse p-3 bg-light border-bottom" id="expForm">
                            <form method="post" asp-page-handler="AddExperience" class="row g-2">
                                <input type="hidden" asp-for="experienceModel.personID" value="@Model.personModel.personID" />

                                <div class="col-12">
                                    <select asp-for="experienceModel.experienceType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Enums.Ex_In>()"></select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted mb-0">From</label>
                                    <input asp-for="experienceModel.experienceStartDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted mb-0">To</label>
                                    <input asp-for="experienceModel.experienceEndDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-12">
                                    <input asp-for="experienceModel.jobTitle" class="form-control form-control-sm" placeholder="Job Title" />
                                </div>
                                <div class="col-12">
                                    <input asp-for="experienceModel.jobDepartment" class="form-control form-control-sm" placeholder="Company/Department" />
                                </div>
                                <div class="col-4">
                                    <input asp-for="experienceModel.jobSalary" class="form-control form-control-sm" placeholder="Salary" />
                                </div>
                                <div class="col-4">
                                    <input asp-for="experienceModel.jobGrade" class="form-control form-control-sm" placeholder="Grade" />
                                </div>
                                <div class="col-4">
                                    <input asp-for="experienceModel.jobStep" class="form-control form-control-sm" placeholder="Step" />
                                </div>

                                <div class="col-12 text-end mt-2 d-flex justify-content-between">
                                    <button type="submit" name="handler" value="PrintExperience" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer"></i> Print</button>
                                    <button type="submit" name="handler" value="AddExperience" class="btn btn-success btn-sm px-3">@L.T("Save") Record</button>
                                </div>
                            </form>
                        </div>
                        <!--EXPERIENCE TABLE-->
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0 small align-middle text-nowrap">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3">Company / Title</th>
                                        <th>Salary</th>
                                        <th class="text-end pe-3">Yrs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Experiences)
                                    {
                                        <tr onclick="location.href='@Url.Page("/Experience/Edit", new { id = item.experienceID })'" style="cursor:pointer">
                                            <td class="ps-3">
                                                <div class="fw-bold text-dark text-truncate" style="max-width:150px;">@item.jobTitle</div>
                                                <div class="text-muted small text-truncate" style="max-width:150px;">@item.jobDepartment</div>
                                            </td>
                                            <td>@item.jobSalary</td>
                                            <td class="text-end pe-3 text-muted">
                                                @(item.experienceEndDate.Year - item.experienceStartDate.Year)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!--EDUCATIOn FORM AND VIEW-->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold m-0 text-dark"><i class="bi bi-mortarboard me-2"></i>Education</h6>
                        <button class="btn btn-xs btn-outline-primary py-0 px-2 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#eduForm">
                            <i class="bi bi-plus"></i> Add New
                        </button>
                    </div>

                    <div class="card-body p-0">
                        <!--EDUCATION FORM-->
                        <div class="collapse p-3 bg-light border-bottom" id="eduForm">
                            <form method="post" asp-page-handler="AddEducation" class="row g-2">
                                <input type="hidden" asp-for="personEducationLevelModel.personID" value="@Model.personModel.personID" />

                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted mb-0">Level</label>
                                    <select asp-for="personEducationLevelModel.educationLevelID" class="form-select form-select-sm" asp-items="ViewBag.educationLevelID"></select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted mb-0">Obtained Date</label>
                                    <input asp-for="personEducationLevelModel.educationLevelDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold text-muted mb-0">CGPA/Mark</label>
                                    <input asp-for="personEducationLevelModel.educationLevelMark" class="form-control form-control-sm" placeholder="e.g. 3.8" />
                                </div>
                                <div class="col-12">
                                    <input asp-for="personEducationLevelModel.educationField" class="form-control form-control-sm" placeholder="Qualification Title (e.g. BSc in CS)" />
                                </div>
                                <div class="col-12">
                                    <input asp-for="personEducationLevelModel.educationLevelInstitutionName" class="form-control form-control-sm" placeholder="Institution Name" />
                                </div>
                                <div class="col-12">
                                    <input asp-for="personEducationLevelModel.educationLevelNumber" class="form-control form-control-sm" placeholder="Certificate No." />
                                </div>

                                <div class="col-12 text-end mt-2">
                                    <button type="submit" class="btn btn-success btn-sm px-3">@L.T("Save") Certification</button>
                                </div>
                            </form>
                        </div>

                        <!--EDUCATION TABLE-->
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0 small align-middle text-nowrap">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="ps-3">Level / Institution</th>
                                        <th class="text-end pe-3">Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PersonEducationLevels)
                                    {
                                        <tr onclick="location.href='@Url.Page("/PersonEducationLevel/Edit", new { id = item.personEducationLevelID })'" style="cursor:pointer">
                                            <td class="ps-3">
                                                <div class="fw-bold text-dark text-truncate" style="max-width:160px;">@item.educationLevelModel?.educationLevelCategory</div>
                                                <div class="text-muted small text-truncate" style="max-width:160px;">@item.educationLevelInstitutionName</div>
                                            </td>
                                            <td class="text-end pe-3">
                                                <span class="badge bg-light text-dark border">@item.educationLevelMark</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/filter-department.js"></script>
}