@page
@model PIS2.Pages.Employment.EditModel

@{
    ViewData["Title"] = "Edit Employment";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<h1 class="fw-bold">Employments</h1>
<h3 class="fw-bold">Employment Master Data </h3>
<hr />
<div class="">
    <form method="get" class="d-print-none">
        <div class="d-flex justify-content-between">
            @if(Model.EmpSelected){
                <h4 class="fw-bold" onclick="location.href='@Url.Page("/Person/Details", new { id = Model.personModel.personID })'" style="cursor:pointer;"><u>@Model.personModel.personFullName</u></h4>
            }
            <div class="d-flex m-2">
                <input asp-for="employmentModel.givenID" id="givenID" class="form-control me-2" placeholder="Enter Given ID" name="givenID" />
                <button type="submit" class="btn btn-primary" id="goButton">Go</button>
            </div>
        </div>
    </form>
</div>

@if(Model.EmpSelected){
<div class="container">

    <!--personal info-->
    <div class="row">
        <h4 class="bg-dark text-white fw-bold p-2">Person Information / @Model.personModel.personID</h4>
        <form method="post" asp-page-handler="UpdatePerson">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="personModel.personID" />
           
            <div class="d-flex flex-wrap">
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personFirstName" class="control-label">First Name</label>
                    <input asp-for="personModel.personFirstName" class="form-control" />
                    <span asp-validation-for="personModel.personFirstName" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personFatherName" class="control-label">Fathers Name</label>
                    <input asp-for="personModel.personFatherName" class="form-control" />
                    <span asp-validation-for="personModel.personFatherName" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personLastName" class="control-label">Last Name</label>
                    <input asp-for="personModel.personLastName" class="form-control" />
                    <span asp-validation-for="personModel.personLastName" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personDoB" class="control-label">Date of Birth</label>
                    <input asp-for="personModel.personDoB" class="form-control" type="date" />
                    <span asp-validation-for="personModel.personDoB" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personGender" class="control-label">Gender</label>
                    <select asp-for="personModel.personGender" class="form-control" asp-items="Html.GetEnumSelectList<Models.Gender>()"></select>
                    <span asp-validation-for="personModel.personGender" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personIDType" class="control-label">ID Type</label>
                    <input asp-for="personModel.personIDType" class="form-control" />
                    <span asp-validation-for="personModel.personIDType" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personIDNumber" class="control-label">ID Number</label>
                    <input asp-for="personModel.personIDNumber" class="form-control" />
                    <span asp-validation-for="personModel.personIDNumber" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personPhoneNumber" class="control-label">Phone</label>
                    <input asp-for="personModel.personPhoneNumber" class="form-control" />
                    <span asp-validation-for="personModel.personPhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personRecordNumber" class="control-label">Record Number</label>
                    <input asp-for="personModel.personRecordNumber" class="form-control" />
                    <span asp-validation-for="personModel.personRecordNumber" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.addressID" class="control-label">Address</label>
                    <select asp-for="personModel.addressID" class="form-control" asp-items="ViewBag.addressID"></select>
                    <span asp-validation-for="personModel.addressID" class="text-danger"></span>
                </div>
                <div class="form-group pe-4 pt-2">
                    <label asp-for="personModel.personEmailAddress" class="control-label">Email</label>
                    <input asp-for="personModel.personEmailAddress" class="form-control" />
                    <span asp-validation-for="personModel.personEmailAddress" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group d-flex justify-content-end">
                <input type="submit" value="Save" class="btn btn-success m-2" />
                <a asp-page="/Person/Details" asp-route-id="@Model.personModel.personID" class="btn btn-Info m-2">More...</a>
            </div>
        </form>
    </div>
    
    <!--job info-->
    <div class="row">
        <div class="col-md-6">
            <!--employment info-->
            <div class="row">
                <h4 class="bg-dark text-white fw-bold p-2">Employment Information/@Model.employmentModel.employmentID</h4>
                <form method="post" asp-page-handler="UpdateEmployment">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="employmentModel.employmentID" />
                    <input type="hidden" asp-for="employmentModel.personID" value="@Model.personModel.personID" />
                    <div class="d-flex flex-wrap">
                        <div class="form-group pe-4 pt-2">
                            <span class="text-danger">*</span>
                            <label asp-for="employmentModel.givenID" class="control-label">Employee ID</label>
                            <input asp-for="employmentModel.givenID" class="form-control" readonly />
                            <span asp-validation-for="employmentModel.givenID" class="text-danger"></span>
                        </div>

                        <div class="form-group pe-4 pt-2">
                            <label asp-for="employmentModel.employmentTypeID" class="control-label">Employment Type</label>
                            <select asp-for="employmentModel.employmentTypeID" class="form-control" asp-items="ViewBag.employmentTypeID"></select>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <span class="text-danger">*</span>
                            <label asp-for="employmentModel.employmentDate" class="control-label"> Hire Date</label>
                            <input asp-for="employmentModel.employmentDate" class="form-control" type="date" />
                            <span asp-validation-for="employmentModel.employmentDate" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="employmentModel.employmentStatus" class="control-label">Employment Status</label>
                            <input asp-for="employmentModel.employmentStatus" class="form-control"  readonly />
                            <span asp-validation-for="employmentModel.employmentStatus" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="employmentModel.employmentPosition" class="control-label">Employment Position</label>
                            <select asp-for="employmentModel.employmentPosition" class="form-control" asp-items="Html.GetEnumSelectList<Models.EmploymentPositions>()"></select>
                            <span asp-validation-for="employmentModel.employmentPosition" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="employmentModel.employmentReference" class="control-label">Reference No</label>
                            <input asp-for="employmentModel.employmentReference" class="form-control" />
                            <span asp-validation-for="employmentModel.employmentReference" class="text-danger"></span>
                        </div>
                        
                    </div>
                    <div class="form-group pe-4 m-2 d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-success m-2" />
                        @if(Model.employmentModel.employmentStatus != Models.mainStatus.Inactive)
                        {
                            <a asp-page="/Termination/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-danger m-2">Terminate Employment</a>
                        }
                            <a asp-page="/Employment/Details" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-Info m-2">More...</a>
                    </div>

                </form>
            </div>
            <!--Job Placement-->
            @if (Model.employmentModel.employmentStatus != Models.mainStatus.Inactive)
            {
                            
                <h4 class="bg-dark text-white fw-bold p-2">Job Information</h4>
                @if(Model.jobPlacementModel.jobPlacementID != 0)
                {
               
                    <form method="post" asp-page-handler="SaveJobPlacement">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="jobPlacementModel.jobPlacementID"/>
                        <input type="hidden" asp-for="jobPlacementModel.employmentID" value="@Model.employmentModel.employmentID" />
                        <div class="d-flex flex-wrap">
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="jobPlacementModel.departmentID" class="control-label">Department</label>
                                <select asp-for="jobPlacementModel.departmentID" class="form-control" asp-items="ViewBag.departmentID"></select>
                                <span asp-validation-for="jobPlacementModel.departmentID" class="text-danger"></span>
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="jobPlacementModel.jobID" class="control-label">Job Title</label>
                                <select asp-for="jobPlacementModel.jobID" class="form-control" asp-items="ViewBag.jobID"></select>
                                <span asp-validation-for="jobPlacementModel.jobID" class="text-danger"></span>
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="jobPlacementModel.jobStepID" class="control-label">Job Grade And Step</label>
                                <select asp-for="jobPlacementModel.jobStepID" class="form-control" asp-items="ViewBag.jobStepID"></select>
                                <span asp-validation-for="jobPlacementModel.jobStepID" class="text-danger"></span>
                            </div>
                            
                            <div class="form-group pe-4 pt-2">
                                <span class="text-danger">*</span>
                                <label asp-for="jobPlacementModel.jobPlacementSalary" class="control-label">Basic Salary</label>
                                <input asp-for="jobPlacementModel.jobPlacementSalary" class="form-control" type="number"/>
                                <span asp-validation-for="jobPlacementModel.jobPlacementSalary" class="text-danger"></span>
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="jobPlacementModel.jobPlacementDate" class="control-label">Date</label>
                                <input asp-for="jobPlacementModel.jobPlacementDate" class="form-control" type="date"/>
                                <span asp-validation-for="jobPlacementModel.jobPlacementDate" class="text-danger"></span>
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <span class="text-danger">*</span>
                                <label asp-for="jobPlacementModel.jobPlacementReference" class="control-label">Reference Number</label>
                                <input asp-for="jobPlacementModel.jobPlacementReference" class="form-control" />
                                <span asp-validation-for="jobPlacementModel.jobPlacementReference" class="text-danger"></span>
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="jobPlacementModel.jobPlacementStatus" class="control-label">Status</label>
                                <select asp-for="jobPlacementModel.jobPlacementStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                                <span asp-validation-for="jobPlacementModel.jobPlacementStatus" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <span class="text-danger">*</span>
                                <label asp-for="jobPlacementModel.jobPlacementReason" class="control-label">Reason</label>
                                <select asp-for="jobPlacementModel.jobPlacementReason" class="form-control">
                                    <option value=""> -- Select Reason--</option>
                                    <option value="New Hire"> New Hire</option>
                                    <option value="Promotion"> Promotion</option>
                                    <option value="Transfer"> Transfer</option>
                                    <option value="Demotion"> Demotion</option>
                                    <option value="Temporary Assignment"> Temporary Assignment</option>
                                    <option value="Other"> Other</option>
                                </select>
                                <span asp-validation-for="jobPlacementModel.jobPlacementReason" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group d-flex justify-content-end">
                            <input type="submit" value="Save" class="btn btn-success align-items-baseline m-2" />
                            <a asp-page="/JobPlacement/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-primary m-2">Assign a new job</a>
                            <a asp-page="/JobPlacement/Details" asp-route-id="@Model.jobPlacementModel.jobPlacementID" class="btn btn-Info m-2">More...</a>
                        </div>
                    </form>
                }
                else
                {
                    <a asp-page="/JobPlacement/Create" asp-route-id="@Model.employmentModel.employmentID" class="btn btn-primary m-2">Assign a job</a>
                   
                }
            }
        </div>
        <div class="col-md-6">
            <div class="row">
            <!--Experience -->
                <h4 class="bg-dark text-white fw-bold p-2">Experience</h4>
                <form method="post" asp-page-handler="AddExperience" class="">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="experienceModel.personID" value="@Model.personModel.personID" />
                    
                    <div class="d-flex flex-wrap">
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="experienceModel.experienceType" class="control-label">Experience Type</label>
                            <select asp-for="experienceModel.experienceType" class="form-control" asp-items="Html.GetEnumSelectList<Models.Ex_In>()"></select>
                            <span asp-validation-for="experienceModel.experienceType" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="experienceModel.experienceStartDate" class="control-label">From</label>
                            <input asp-for="experienceModel.experienceStartDate" class="form-control" type="date" />
                            <span asp-validation-for="experienceModel.experienceStartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="experienceModel.experienceEndDate" class="control-label">To</label>
                            <input asp-for="experienceModel.experienceEndDate" class="form-control" type="date" />
                            <span asp-validation-for="experienceModel.experienceEndDate" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <div class="form-group m-2">
                                <label asp-for="experienceModel.jobTitle" class="control-label">Job Title</label>
                                <input asp-for="experienceModel.jobTitle" class="form-control" />
                                <span asp-validation-for="experienceModel.jobTitle" class="text-danger"></span>
                            </div>
                            <div class="form-group m-2">
                                <label asp-for="experienceModel.jobDepartment" class="control-label">Company</label>
                                <input asp-for="experienceModel.jobDepartment" class="form-control" />
                                <span asp-validation-for="experienceModel.jobDepartment" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="experienceModel.jobSalary" class="control-label">Salary</label>
                                <input asp-for="experienceModel.jobSalary" class="form-control" />
                            </div>
                            <div class="form-group pe-4 pt-2">                           
                                <label asp-for="experienceModel.jobGrade" class="control-label">Job Grade</label>
                                <input asp-for="experienceModel.jobGrade" class="form-control" />
                            </div>
                            <div class="form-group pe-4 pt-2">
                                <label asp-for="experienceModel.jobStep" class="control-label">Job Step</label>
                                <input asp-for="experienceModel.jobStep" class="form-control" />
                            </div>
                        </div>
                   
                    </div>
                    <div class="form-group d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-success align-items-baseline m-2" />
                        <input type="submit" value="Print Experience" class="btn btn-primary align-items-baseline m-2" />
                    </div>
                </form>

                <table class="table table-striped table-hover">
                    <thead class="bg-info text-white">
                        <tr>
                            <td>From-To</td>
                            <td>Job Title</td>
                            <td>Salary</td>
                            
                            <td>Type</td>
                            <td>Company</td>
                            <td>Duration</td>
                            
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.Experiences)
                        {
                            <tr onclick="location.href='@Url.Page("/Experience/Edit", new {id = item.experienceID})'" style="cursor:pointer">
                                <td>@item.experienceStartDate.ToString("dd/MM/yyyy") - @item.experienceEndDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.jobTitle</td>
                                <td>@item.jobSalary</td>
 
                                <td>@item.experienceType</td>
                                <td>@item.jobDepartment</td>
                                <td>@(item.experienceEndDate.Year - item.experienceStartDate.Year)</td>
                               
                            </tr>
                        }
                    </tbody>
                </table>
                <!--Education and Certification-->
                <h4 class="bg-dark text-white fw-bold p-2">Certification</h4>
                <form method="post" asp-page-handler="AddEducation" class="">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="personEducationLevelModel.personID" value="@Model.personModel.personID" />
                    
                    <div class="d-flex flex-wrap">
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationLevelID" class="control-label">Level Name</label>
                            <select asp-for="personEducationLevelModel.educationLevelID" class="form-control" asp-items="ViewBag.educationLevelID"></select>
                            <span asp-validation-for="personEducationLevelModel.educationLevelID" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationLevelDate" class="control-label">Date Obtained</label>
                            <input asp-for="personEducationLevelModel.educationLevelDate" class="form-control" type="date" />
                            <span asp-validation-for="personEducationLevelModel.educationLevelDate" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationLevelMark" class="control-label">Grade/Mark</label>
                            <input asp-for="personEducationLevelModel.educationLevelMark" class="form-control" />
                            <span asp-validation-for="personEducationLevelModel.educationLevelMark" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationField" class="control-label">Title</label>
                            <input asp-for="personEducationLevelModel.educationField" class="form-control" />
                            <span asp-validation-for="personEducationLevelModel.educationField" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationLevelInstitutionName" class="control-label">School/College</label>
                            <input asp-for="personEducationLevelModel.educationLevelInstitutionName" class="form-control" />
                            <span asp-validation-for="personEducationLevelModel.educationLevelInstitutionName" class="text-danger"></span>
                        </div>
                        <div class="form-group pe-4 pt-2">
                            <label asp-for="personEducationLevelModel.educationLevelNumber" class="control-label">Cerificate Number</label>
                            <input asp-for="personEducationLevelModel.educationLevelNumber" class="form-control" />
                            <span asp-validation-for="personEducationLevelModel.educationLevelNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group d-flex justify-content-end">
                        <input type="submit" value="Save" class="btn btn-success align-items-baseline m-2" />
                    </div>
                </form>

                <table class="table table-striped table-hover">
                    <thead class="bg-info text-white">
                        <tr>
                            <td>Certification Type</td>
                            <td>Date</td>
                            <td>CGPA</td>
                            <td>Title</td>
                            <td>School</td>
                            <td>Certificate Number</td>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PersonEducationLevels)
                        {
                            <tr onclick="location.href='@Url.Page("/PersonEducationLevel/Edit", new {id = item.personEducationLevelID})'" style="cursor:pointer">
                                <td>@item.educationLevelModel?.educationLevelCategory</td>
                                <td>@item.educationLevelDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.educationLevelMark</td>
                                <td>@item.educationField</td>
                                <td>@item.educationLevelInstitutionName</td>
                                <td>@item.educationLevelNumber</td>
                                                               
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
}
<div>
    <a asp-page="./Index">View All Employees List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
