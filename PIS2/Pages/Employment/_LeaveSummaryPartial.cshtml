
@model PIS2.Views.leaveDetail
@{
    var Employment = Model.Employee;
}
@if (1 == 1)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom">
            <div class="card-header bg-white border-bottom">
                <h5 class="fw-bold mb-0">Annual Leave Summary</h5>
            </div>
           
        </div>
        <div class="card-body">
            <div class="d-flex">
                <div class="flex-fill d-flex flex-column justify-content-center align-items-center">
                    <h6 class="fw-bold">Allowed Leave:</h6>
                   
                        <h2 class="text-success fw-bold"><u>@Model.AllowedLeave.ToString("0.0")</u></h2>
                    
                </div>
                <div class="flex-fill d-flex flex-column justify-content-center align-items-center">
                    <h6 class="fw-bold">Total Leave<u></u></h6>
                    <h2 class="text-success fw-bold">@Model.TotalLeave</h2>
                </div>
                <div class="flex-fill d-flex flex-column justify-content-center align-items-center">
                    <h6 class="fw-bold">Last Increment: <u></u></h6>
                    <h2 class="text-success fw-bold">@Model.LastAccrualIncrement</h2>
                </div>
                <div class="flex-fill d-flex flex-column justify-content-center align-items-center">
                    <h6 class="fw-bold">Leave Value: <u></u></h6>
                    <h2 class="text-success fw-bold">@Model.leaveCost.ToString("N2")<span class="fs-6">Br</span></h2>
                </div>
            </div>


            <!--LEAVE SUMMARY TABLE-->
            <table class="table table-striped table-hover">

                <thead>
                    <tr class="bg-dark text-white">
                        <th>Year</th>
                        <th>Starting Balance</th>
                        <th>Increments</th>
                        <th>Used Leave</th>
                        <th>Ending Balance</th>
                        <th>Year Balance</th>
                        <th>Cost</th>

                    </tr>

                </thead>
                <tbody id="tbody">
                    @foreach (var item in Model.AnnualLeaveHistory)
                    {
                        <tr>
                            <td>@item.startDate.ToString("MM/dd/yyyy") - @item.endDate.ToString("MM/dd/yyyy")</td>
                            <td>@item.startingLeaveAmount</td>
                            <td>@item.accruedLeaveAmount</td>
                            <td>@item.usedLeaveAmount</td>
                            <td>@item.remainingLeaveAmount</td>
                            <td>@item.rollOverLeave</td>
                            <td>@item?.remainingLeaveCost.ToString("N2") <span class="small">Br</span></td>
                        </tr>
                    }

                </tbody>
            </table>
            @await Html.PartialAsync("print")
        </div>
    </div>
}
else
{
    <div class="alert"><p>No leave record found.</p></div>
}
