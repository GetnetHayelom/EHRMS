@page
@model PIS2.Pages.ServiceRequestType.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold">Services Types</h2>

<p class="text-muted">Maintain Service Types</p>
<hr />
<div class="row">
    <div class="card shadow-sm p-2 col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="serviceRequestType.serviceRequestTypeName" class="control-label">Service Name</label>
                <input asp-for="serviceRequestType.serviceRequestTypeName" class="form-control" />
                <span asp-validation-for="serviceRequestType.serviceRequestTypeName" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="serviceRequestType.serviceRequestTypeDescription" class="control-label">Decription</label>
                <input asp-for="serviceRequestType.serviceRequestTypeDescription" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="serviceRequestType.serviceRequestTypeStatus" class="control-label">Status</label>
                <select asp-for="serviceRequestType.serviceRequestTypeStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="serviceRequestType.serviceRequestTypeStatus" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Save" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">View Catalog</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
