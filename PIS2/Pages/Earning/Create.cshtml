@page
@model PIS2.Pages.Earning.CreateModel
@{
    ViewData["Title"] = "Add New Earning Type";
}
<h2 class="fw-bold mb-0">Earning Types</h2>
<p class="text-muted mb-0">Maintain new earning type</p>
<div class="container">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i> Add New Earning Type
            </h5>
            <a asp-page="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card-body">
            <form method="post" class="needs-validation" novalidate>
                <!-- Earning Name -->
                <div class="mb-3">
                    <label asp-for="EarningType.earningTypeName" class="form-label fw-semibold">Name</label>
                    <input asp-for="EarningType.earningTypeName" class="form-control" placeholder="Enter earning type name (e.g. Basic Salary, Overtime)" />
                    <span asp-validation-for="EarningType.earningTypeName" class="text-danger"></span>
                </div>
                <div class="mb3">
                    <label asp-for="EarningType.earningTypeCode" class="form-label fw-semibold"><span class="text-danger">*</span>Code</label>
                    <input asp-for="EarningType.earningTypeCode" class="form-control rounded-3" placeholder="Enter earning type code" required />
                    <span asp-validation-for="EarningType.earningTypeCode" class="text-danger small" value=""></span>
                </div>
                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="EarningType.earningTypeDescription" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="EarningType.earningTypeDescription" class="form-control" rows="3" placeholder="Optional: short description about this earning type"></textarea>
                    <span asp-validation-for="EarningType.earningTypeDescription" class="text-danger"></span>
                </div>

                <!-- Toggles -->
                <div class="row mb-3">
                    <div class="col-md-6 d-flex justify-content-between align-items-end">
                        <div class="col-md-4 form-check form-switch">
                            <input asp-for="EarningType.isRecurring" class="form-check-input" type="checkbox" />
                            <label asp-for="EarningType.isRecurring" class="form-check-label fw-semibold">Monthly</label>
                        </div>
                        <div class="col-md-4 form-check form-switch">
                            <input asp-for="EarningType.isTaxable" class="form-check-input" type="checkbox" />
                            <label asp-for="EarningType.isTaxable" class="form-check-label fw-semibold">Tax</label>
                        </div>
                        <div class="col-md-4 form-check form-switch">
                            <input asp-for="EarningType.isPayroll" class="form-check-input" type="checkbox" />
                            <label asp-for="EarningType.isPayroll" class="form-check-label fw-semibold">Payroll</label>
                        </div>
                    </div>
                    
                    
                </div>

                <!-- Toggles -->
                <div class="row mb-3">
                    <!-- Type Selector-->
                    <div class="col-md-6 ">
                        <label asp-for="EarningType.accountID" class="form-label fw-semibold">
                            <span class="text-danger">*</span> Account
                        </label>
                        <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" />
                        <input type="hidden" asp-for="EarningType.accountID" id="personIDHidden" />
                        <datalist id="personList">
                            @foreach (var person in Model.Accounts)
                            {
                                <option data-id="@person.Value" value="@person.Text"></option>
                            }
                        </datalist>
                        <span asp-validation-for="EarningType.accountID" class="text-danger"></span>
                    </div>
                    <!-- Status -->
                    <div class="col-md-6">
                        <label asp-for="EarningType.earningTypeStatus" class="form-label fw-semibold">Status</label>
                        <select asp-for="EarningType.earningTypeStatus" class="form-select" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                            <option value="">-- Select Status --</option>
                        </select>
                        <span asp-validation-for="EarningType.earningTypeStatus" class="text-danger"></span>
                    </div>
                </div>
                

                <!-- Save Button -->
                <div class="text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save2 me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
