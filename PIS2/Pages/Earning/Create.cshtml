@page
@model PIS2.Pages.Earning.CreateModel
@{
    ViewData["Title"] = "Add New Earning Type";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-plus-circle me-2"></i> Add New Earning Type
            </h5>
            <a asp-page="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card-body">
            <form method="post" class="needs-validation" novalidate>
                <!-- Earning Name -->
                <div class="mb-3">
                    <label asp-for="EarningType.earningTypeName" class="form-label fw-semibold"></label>
                    <input asp-for="EarningType.earningTypeName" class="form-control" placeholder="Enter earning type name (e.g. Basic Salary, Overtime)" />
                    <span asp-validation-for="EarningType.earningTypeName" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="EarningType.earningTypeDescription" class="form-label fw-semibold"></label>
                    <textarea asp-for="EarningType.earningTypeDescription" class="form-control" rows="3" placeholder="Optional: short description about this earning type"></textarea>
                    <span asp-validation-for="EarningType.earningTypeDescription" class="text-danger"></span>
                </div>

                <!-- Toggles -->
                <div class="row mb-3">
                    <div class="col-md-6 form-check form-switch">
                        <input asp-for="EarningType.isRecurring" class="form-check-input" type="checkbox" />
                        <label asp-for="EarningType.isRecurring" class="form-check-label fw-semibold"></label>
                    </div>
                    <div class="col-md-6 form-check form-switch">
                        <input asp-for="EarningType.isTaxable" class="form-check-input" type="checkbox" />
                        <label asp-for="EarningType.isTaxable" class="form-check-label fw-semibold"></label>
                    </div>
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <label asp-for="EarningType.earningTypeStatus" class="form-label fw-semibold"></label>
                    <select asp-for="EarningType.earningTypeStatus" class="form-select" asp-items="Html.GetEnumSelectList<Models.mainStatus>()">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="EarningType.earningTypeStatus" class="text-danger"></span>
                </div>

                <!-- Save Button -->
                <div class="text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save2 me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
