@page
@using PIS2.Enums
@model PIS2.Pages.Earning.IndexModel
@{
    ViewData["Title"] = "Compensation & Benefits";
}
@await Html.PartialAsync("headerSimple","")
<div class="container">
    <div class="d-flex justify-content-between align-items-end mb-2">
        <div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="bi bi-cash-stack me-2 text-secondary"></i> Earning Types
            </h2>
            <p class="text-muted mb-0">Earning Types Catalog</p>
        </div>
        
        <a asp-page="Create" class="btn btn-primary m-2">
            <i class="bi bi-plus-circle me-1"></i> Add New Earning Type
        </a>
        
        
    </div>

    @if (Model.EarningTypes.Any())
    {
        <div class="card shadow-sm m-1 p-0">
            <div class="d-flex justify-content-end align-items-end m-0">
                @await Html.PartialAsync("filter")
                @await Html.PartialAsync("back")
                @await Html.PartialAsync("print")
            </div>
        </div>
        
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle table-striped print-full-width" id="dataTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>S/No</th>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Recurring</th>
                            <th>Taxable</th>
                            <th>Payroll</th>
                            <th>Status</th>
                            <th class="text-end d-print-none">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var earning in Model.EarningTypes)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@earning.earningTypeName
                                <p class="text-muted m-0">@earning.Account?.accountName</p></td>
                                <td>@earning.earningTypeCode</td>
                                <td><i class="bi @(earning.isRecurring ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i></td>
                                <td><i class="bi @(earning.isTaxable ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i></td>
                                <td><i class="bi @(earning.isPayroll ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i></td>
                                <td>
                                    <span class="badge @(earning.earningTypeStatus == mainStatus.Active ? "bg-success" : "bg-secondary")">
                                        @earning.earningTypeStatus
                                    </span>
                                </td>
                                <td class="text-end d-print-none">
                                    <div class="btn-group" role="group">
                                        <a asp-page="Details" asp-route-id="@earning.earningTypeID" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@earning.earningTypeID" class="btn btn-sm btn-outline-success" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                    
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4">
            <i class="bi bi-info-circle me-1"></i> No earning types found.
        </div>
    }
</div>
<div class="d-flex justify-content-end align-items-center m-0">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>