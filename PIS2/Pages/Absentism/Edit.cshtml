@page
@model PIS2.Pages.Absentism.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var isPosted = Model.leaveModel.leaveStatus == Enums.leaveStatus.Hold ? "" : "readonly";
}

<h1 class="fw-bold">Absenteeism</h1>

<h4>@L.T("Update") Absenteeism Record</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="leaveModel.leaveID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="leaveModel.employmentID" class="control-label">Employment ID</label>
                <select asp-for="leaveModel.employmentID" class="form-control" asp-items="ViewBag.employmentID"></select>
                <span asp-validation-for="leaveModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="leaveModel.leaveRequestDate" class="control-label">Record Date</label>
                <input asp-for="leaveModel.leaveRequestDate" class="form-control" type="date" readonly/>
                <span asp-validation-for="leaveModel.leaveRequestDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="leaveModel.leaveStartDate" class="control-label">Start Date</label>
                <input asp-for="leaveModel.leaveStartDate" class="form-control" type="date" isPosted/>
                <span asp-validation-for="leaveModel.leaveStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="leaveModel.leaveEndDate" class="control-label">End Date</label>
                <input asp-for="leaveModel.leaveEndDate" class="form-control" type="date"/>
                <span asp-validation-for="leaveModel.leaveEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="leaveModel.leaveDays" class="control-label">Days</label>
                <input asp-for="leaveModel.leaveDays" class="form-control" />
                <span asp-validation-for="leaveModel.leaveDays" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.leaveTypeID" class="control-label">Type</label>
                <select asp-for="leaveModel.leaveTypeID" class="form-control" asp-items="ViewBag.leaveTypeID"></select>
                <span asp-validation-for="leaveModel.leaveTypeID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.oldBatchNbr" class="control-label">Old Batch No</label>
                <input asp-for="leaveModel.oldBatchNbr" class="form-control" readonly/>
                <span asp-validation-for="leaveModel.oldBatchNbr" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.ratePerHour" class="control-label">Hourly Rate</label>
                <input asp-for="leaveModel.ratePerHour" class="form-control" readonly/>
                <span asp-validation-for="leaveModel.ratePerHour" class="text-danger"></span>
            </div>
            <div class="form-group">
                @{
                    
                }
                <label asp-for="leaveModel.leaveStatus" class="control-label">Status</label>
                <select asp-for="leaveModel.leaveStatus" class="form-control" asp-items="@Html.GetEnumSelectList<Enums.leaveStatus>()"></select>
                <span asp-validation-for="leaveModel.leaveStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="leaveModel.modifiedBy" class="control-label">Modified By</label>
                <input asp-for="leaveModel.modifiedBy" class="form-control" readonly/>
                <span asp-validation-for="leaveModel.modifiedBy" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value='@L.T("Save")' class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Absenteeism</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
