@page
@model PIS2.Pages.Absentism.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Absentism</h1>
<h4 class="fw-bold">Absentism Records for the last six months</h4>
<hr />
<p>
    <a asp-page="Create" class="btn btn-primary text-decoration-none text-white">Add New Absentism Record</a>
</p>
<form method="POST" class="d-flex">
    <div class="m-2 flex-wrap">
        <label for="filter-status">Filter Status:</label>
        <select asp-for="filter.Status" class="form-select" aria-label="Default select example" id="filter-status" onchange="filter()" asp-items="Html.GetEnumSelectList<Models.leaveStatus>()">
            <option value="">All</option>
        </select>
    </div>

    <div class="m-2 flex-wrap">
        <label for="filter-department">Filter Department:</label>
        <select asp-for="filter.Status" class="form-select" aria-label="Default select example" id="filter-department" onchange="filter()">
            <option value="">All</option>
            @foreach (var department in Model.Departments)
            {
                <option value="@department.departmentID">@department.departmentName</option>
            }
        </select>
    </div>
    <div class="m-2 flex-wrap">
        <label for="filter-company">Filter Company:</label>
        <select asp-for="filter.Status" class="form-select" aria-label="Default select example" id="filter-company" onchange="filter()">
            <option value="">All</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.companyID">@company.companyName</option>
            }
        </select>
    </div>
    <div class="m-2 flex-wrap">
        <label for="filter-workLoc">Filter Work Location:</label>
        <select asp-for="filter.Status" class="form-select" aria-label="Default select example" id="filter-workLoc" onchange="filterEmployees()">
            <option value="">All</option>
            @foreach (var workLocation in Model.WorkLocations)
            {
                <option value="@workLocation.workSiteID">@workLocation.workSiteName</option>
            }
        </select>
    </div>
    <div class="m-2 flex-wrap">
        <label for="dateStart">Date From:</label>
        <input asp-for="filter.Status" class="form-control" type="date" id="dateStart" onchange="filterEmployees()" asp-for="StartDate" />
    </div>
    <div class="m-2 flex-wrap">
        <label for="dateEnd">Date Upto:</label>
        <input asp-for="filter.Status" class="form-control" type="date" id="dateEnd" onchange="filterEmployees()" asp-for="EndDate" />
    </div>
</form>
<table class="table table-bordered table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Absentism Record Date
            </th>
            <th>
                Absentism Start Date
            </th>
            <th>
                Absentism End Date
            </th>
            <th>
                Number Of Days
            </th> 

            <th>
                Absentism Reason
            </th>
            <th>
                Absentism Status
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.leaveModel) {
            <tr onclick="location.href='@Url.Page("Details", new { id = item.leaveID })'" style="cursor:pointer;" )>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @item.leaveRequestDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                @item.leaveStartDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                @item.leaveEndDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.leaveDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.leaveTypeModel.leaveTypeName)
            </td>
                @{
                    string bg_color="";
                    if (item.leaveStatus == Models.leaveStatus.Hold || item.leaveStatus == Models.leaveStatus.Approved)
                    {
                        bg_color = "bg-warning text-black";
                    }
                    else if (item.leaveStatus == Models.leaveStatus.Posted)
                    {
                        bg_color = "bg-success text-white";
                    }
                    else
                    {
                        bg_color = "bg-grey text-black";
                    }
                }
            <td class="@bg_color">
                @Html.DisplayFor(modelItem => item.leaveStatus)
            </td>
            
        </tr>
}
    </tbody>
</table>
