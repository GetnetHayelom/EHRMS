@page
@model PIS2.Pages.Absentism.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Absenteeism</h1>

<div>
    <div class="flex-grow-1 print-full-width">
        <h3 class="fw-bold">Absenteeism Detail</h3>
        <hr />
        <dl class="">
            <div class="d-flex justify-content-between  me-3">
                <div class="flex-grow-1">
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Voucher ID:
                        </dt>
                        <dd class="me-4">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveID)</u>
                        </dd>
                        <dt class="me-2">
                            Employee ID:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.employmentModel.givenID)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Company:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.Job.departmentModel.companyModel.companyName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Work Location:
                        </dt>
                        <dd class="">
                            
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Leave Type:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveTypeModel.leaveTypeName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Start Date:
                        </dt>
                        <dd class="">
                            <u> @Model.leaveModel.leaveStartDate.ToString("MMM dd, yyyy")</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Leave Days:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveDays)</u>
                        </dd>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Name:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.employmentModel.personModel.personFullName)</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Department:
                        </dt>
                        <dd class="">
                            <u>@Model.Job.departmentModel.departmentName</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Shift:
                        </dt>
                        <dd class="">
                            <u></u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Request Date:
                        </dt>
                        <dd class="">
                            <u>@Model.leaveModel.leaveRequestDate.ToString("MM/dd/yyyy")</u>
                        </dd>
                    </div>

                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            End Date:
                        </dt>
                        <dd class="">
                            <u>@Model.leaveModel.leaveEndDate.ToString("MM/dd/yyyy")</u>
                        </dd>
                    </div>
                    <div class="d-flex mb-2">
                        <dt class="me-2">
                            Status:
                        </dt>
                        <dd class="">
                            <u>@Html.DisplayFor(model => model.leaveModel.leaveStatus)</u>
                        </dd>
                    </div>
                </div>



            </div>
        </dl>
    </div>
</div>
<div class="d-print-none d-flex justify-content-end">
    
    @if (User.IsInRole("MIE\\PMS_HRCLERK") && (Model.leaveModel.leaveStatus == Enums.leaveStatus.Hold))
    {
        <div class="d-flex justify-content-between">

            <a asp-page="./Create" asp-route-id="@Model.leaveModel.leaveID" role="button" class="btn btn-secondary m-2"><i class="bi bi-x-circle-fill"></i>Back</a>
            <a asp-page="./Edit" asp-route-id="@Model.leaveModel.leaveID" role="button" class="btn btn-primary m-2">Edit</a>
            <a asp-page="./Delete" asp-route-id="@Model.leaveModel.leaveID" role="button" class="btn btn-danger m-2">Delete</a>
            <form method="post">
                <input asp-for="leaveModel.leaveID" name="leaveId" type="hidden" />
                <button type="submit" class="btn btn-success post-button d-print-none m-2" data-id="Model.leaveID">Post</button>
            </form>
        </div>
        
    }
    @await Html.PartialAsync("print")
</div>
