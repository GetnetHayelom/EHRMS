@page
@model PIS2.Pages.EmploymentType.DetailsModel

@{
    ViewData["Title"] = "Employment Type Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Employment Types</h1>

<div>
    <h4 class="fw-bold">Employment Type Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Type Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeName)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeDescription)
        </dd>
        <dt class="col-sm-2">
            Leave:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isLeaveCount)
        </dd>
        <dt class="col-sm-2">
            Exprience:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isExprienceCount)
        </dd>
        <dt class="col-sm-2">
            Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isSalaryAllowed)
        </dd>
        <dt class="col-sm-2">
            Loyalty:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isLoyalityAllowed)
        </dd>
        <dt class="col-sm-2">
            Severance:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isSeveranceAllowed)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeStatus)
        </dd>
        <dt class="col-sm-2">
            Min Age:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentMinAge)
        </dd>
        <dt class="col-sm-2">
            Max Age:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentMaxAge)
        </dd>
        @if (Model.employmentTypeModel.isLeaveCount)
        {
            <dt class="col-sm-2">
                Leave per Year Rate:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.employmentTypeModel.annualAccrualRate)
            </dd>
            <dt class="col-sm-2">
                Base:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.employmentTypeModel.employmentBaseLeave)
            </dd>
            <dt class="col-sm-2">
                Leave Ceiling:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.employmentTypeModel.maxLeaveIncrement)
            </dd>
        }
        
    </dl>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.employmentTypeModel.employmentTypeID" class="btn btn-primary">Edit</a>
    
</div>
<a asp-page="./Index">View All Employment Types</a>