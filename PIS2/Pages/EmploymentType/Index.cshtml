@page
@using PIS2.Enums
@model PIS2.Pages.EmploymentType.IndexModel

@{
    ViewData["Title"] = "Employment Types";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end mb-2">
    <div>
        <h2 class="fw-bold mb-0">Employment Types</h2>
        <p class="text-muted mb-0">Employment types catalog</p>
    </div>
    <p>
        <a asp-page="Create" class="btn btn-primary d-print-none"><i class="bi bi-plus-circle me-2"></i>Add New Employment Type</a>
    </p>
</div>
<div class="card shadow-sm mb-1 p-0">
    <div class="d-flex justify-content-end align-items-end m-0">
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("back")
        @await Html.PartialAsync("print")
    </div>
</div>


<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>S\No</th>
            <th>
                Type Name
            </th>
            <th>
                Description
            </th>
            <th>
                Leave
            </th>
            <th>
                Experience
            </th>
            <th>
                Salary
            </th>
            <th>
                Loyalty
            </th>
            <th>
                Severance
            </th>
            <th>
                Pension
            </th>
            <th>
                Status
            </th>
            <th>
                Leave Rate
            </th>
            <th>
                Base Leave
            </th>
            <th class="d-print-none text-end px-2">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.employmentTypeModel == null || !Model.employmentTypeModel.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted">
                    No employment types found.
                </td>
            </tr>
        }
        @{
            int index = 1;
        }
        @foreach (var item in Model.employmentTypeModel) {
        <tr>
            <td>@(index++)</td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentTypeDescription)
            </td>
            <td>
                <i class="bi @(item.isLeaveCount ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
            </td>
            <td>
                
                    <i class="bi @(item.isExprienceCount ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
            </td>
            <td>
                
                    <i class="bi @(item.isSalaryAllowed ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
            </td>
            <td>
                
                    <i class="bi @(item.isLoyalityAllowed ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
            </td>
            <td>
                
                    <i class="bi @(item.isSeveranceAllowed ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
            </td>
                <td>
                    
                    <i class="bi @(item.isPensionAllowed ? "bi-check-circle-fill text-success" : "bi-x-circle text-danger") fs-4 me-2"></i>
                </td>
            <td>

                @if (item.employmentTypeStatus == mainStatus.Active)
                {
                    <span class="badge bg-success">@Html.DisplayFor(modelItem => item.employmentTypeStatus)</span>

                }
                else if (item.employmentTypeStatus == mainStatus.Suspended)
                {
                    <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.employmentTypeStatus)</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.employmentTypeStatus)</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.annualAccrualRate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.employmentBaseLeave)
            </td>
                <td class="d-print-none text-end px-2">
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.employmentTypeID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.employmentTypeID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
               
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end m-2">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>
