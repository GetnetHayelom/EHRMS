@page
@model PIS2.Pages.EmploymentType.DeleteModel

@{
    ViewData["Title"] = "Delete Employment type";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Employment Types</h1>

<h3>Are you sure you want to delete this employment type?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Type Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeName)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeDescription)
        </dd>
        <dt class="col-sm-2">
            Leave:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isLeaveCount)
        </dd>
        <dt class="col-sm-2">
            Exprience:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isExprienceCount)
        </dd>
        <dt class="col-sm-2">
            Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isSalaryAllowed)
        </dd>
        <dt class="col-sm-2">
            Loyalty:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isLoyalityAllowed)
        </dd>
        <dt class="col-sm-2">
            Severance:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.isSeveranceAllowed)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentTypeStatus)
        </dd>
        <dt class="col-sm-2">
            Leave Increment per Year:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.annualAccrualRate)
        </dd>
        <dt class="col-sm-2">
            Base Leave:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.employmentTypeModel.employmentBaseLeave)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="employmentTypeModel.employmentTypeID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
