@page "{id:int}"
@model PIS2.Pages.TaxRate.EditModel
@{
    ViewData["Title"] = "Edit Tax Rate";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Edit Tax Rate</h4>
            <a asp-page="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card-body">
            <form method="post" class="needs-validation" novalidate>
                <input type="hidden" asp-for="TaxRate.taxRateID" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="TaxRate.amount" class="form-label fw-semibold">Amount</label>
                        <input asp-for="TaxRate.amount" class="form-control" />
                        <span asp-validation-for="TaxRate.amount" class="text-danger"></span>
                    </div>

                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="TaxRate.taxRate" class="form-label fw-semibold">Tax Rate (%)</label>
                        <input asp-for="TaxRate.taxRate" class="form-control" />
                        <span asp-validation-for="TaxRate.taxRate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TaxRate.deduction" class="form-label fw-semibold">Deduction</label>
                        <input asp-for="TaxRate.deduction" class="form-control" />
                        <span asp-validation-for="TaxRate.deduction" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TaxRate.reference" class="form-label fw-semibold">Reference / Proclamation</label>
                    <input asp-for="TaxRate.reference" class="form-control" />
                    <span asp-validation-for="TaxRate.reference" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TaxRate.taxStatus" class="form-label fw-semibold">Status</label>
                    <select asp-for="TaxRate.taxStatus" class="form-select">
                        <option value="0" selected="@((int)Model.TaxRate.taxStatus == 0)">Inactive</option>
                        <option value="1" selected="@((int)Model.TaxRate.taxStatus == 1)">Active</option>
                    </select>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-warning px-4 shadow-sm">
                        <i class="bi bi-pencil-square"></i> Update Tax Rate
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}
