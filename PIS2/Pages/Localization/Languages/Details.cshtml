@page
@model PIS2.Pages.Localization.Languages.DetailsModel

@{
ViewData["Title"] = $"{Model.Language.languageName} Translations";
}

<div class="container-fluid">

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="d-flex align-items-center">

        <a asp-page="Index"
           class="btn btn-outline-secondary me-3">

            <i class="bi bi-arrow-left"></i>

        </a>

        <div>

            <h3 class="mb-1">

                <i class="bi bi-translate me-2"></i>

                @Model.Language.languageName
                @L.T("Language")

            </h3>

            <div class="text-muted">

                @Model.Language.nativeName

                <span class="badge text-bg-secondary ms-2">
                    @Model.Language.languageCode
                </span>

                @if (Model.Language.isRTL)
                {
                    <span class="badge text-bg-primary ms-1">
                        RTL
                    </span>
                }
                else
                {
                    <span class="badge text-bg-primary border ms-1">
                        LTR
                    </span>
                }

            </div>

        </div>

    </div>

    <div>

        <span class="badge text-bg-primary fs-6">

            @Model.Translations.Count
            @L.T("Translation") 

        </span>

    </div>

</div>


<!-- Success Message -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- Translation Card -->

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <div class="row align-items-center">

            <div class="col-md-6">

                <h5 class="mb-0">

                    <i class="bi bi-journal-text me-2"></i>

                    Translation Dictionary

                </h5>

                <small class="text-muted">

                    Edit the translations below and click
                    <strong>@L.T("Save")</strong>.

                </small>

            </div>

            <div class="col-md-6">

                <div class="input-group">

                    <span class="input-group-text">

                        <i class="bi bi-search"></i>

                    </span>

                    <input type="text" id="translationSearch" class="form-control" placeholder="Search translations..." />

                </div>

            </div>

        </div>

    </div>


    <form method="post">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   id="translationTable">

                <thead class="table-light">

                    <tr>

                        <th style="width: 25%;">
                            Key
                        </th>

                        <th style="width: 15%;">
                            Module
                        </th>

                        <th>
                            @Model.Language.nativeName
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @for (var i = 0;
                          i < Model.Translations.Count;
                          i++)
                    {
                        <tr class="translation-row">

                            <td>

                                <input type="hidden"
                                       asp-for="Translations[i].TranslationKey" />

                                <input type="hidden"
                                       asp-for="Translations[i].Module" />

                                <input type="hidden"
                                       asp-for="Translations[i].Description" />

                                <div class="fw-semibold translation-key">

                                    @Model.Translations[i].TranslationKey

                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Translations[i].Description))
                                {
                                    <small class="text-muted">

                                        @Model.Translations[i].Description

                                    </small>
                                }

                            </td>


                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    Model.Translations[i].Module))
                                {
                                    <span class="badge text-bg-primary border">

                                        @Model.Translations[i].Module

                                    </span>
                                }

                            </td>


                            <td>

                                <input asp-for="Translations[i].TranslationValue" class="form-control translation-input" placeholder="Enter translation..." />

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Footer -->

        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <a asp-page="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    @L.T("Back")

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    @L.T("Save")

                </button>

            </div>

        </div>

    </form>

</div>


</div>

@section Scripts {

<script>

    document
        .getElementById("translationSearch")
        .addEventListener("keyup", function () {

            const search =
                this.value.toLowerCase();

            document
                .querySelectorAll(".translation-row")
                .forEach(function (row) {

                    const text =
                        row.textContent.toLowerCase();

                    row.style.display =
                        text.includes(search)
                            ? ""
                            : "none";
                });

        });

</script>


}
