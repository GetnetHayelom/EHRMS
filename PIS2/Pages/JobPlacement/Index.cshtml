@page
@model PIS2.Pages.JobPlacement.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Employee ID
            </th>
            <th>
                Department
            </th>
            <th>
                Job Title
            </th>
            <th>
                Shift
            </th>
            <th>
                Salary
            </th>
            <th>
                Date
            </th>
            <th>
                Status
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.jobPlacementModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.departmentModel.departmentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobModel.jobTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.shiftModel.shiftName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementSalary)
            </td>
            <td>
                @item.jobPlacementDate.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobPlacementStatus)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.jobPlacementID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.jobPlacementID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.jobPlacementID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
