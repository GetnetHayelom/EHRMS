@page
@model PIS2.Pages.JobPlacement.IndexModel

@{
    ViewData["Title"] = "Job Placements";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-end m-2">
    <div>
        <h2 class="fw-bold mb-0">Job Placements</h2>
        <p class="text-muted">Active Job Placements Catalog - Total:@Model.jpCount</p>
    </div>
    

    <a asp-page="Create" class="btn btn-primary">Add New Job Placement</a>
    
</div>
<hr />
<div class="card shadow-sm m-2">
    <div class="d-flex justify-content-end align-items-end">
        @await Html.PartialAsync("filter")
        @await Html.PartialAsync("back")
        @await Html.PartialAsync("print")
    </div>
</div>

<div class="card shadow-sm p-2">
    <table class="table table-striped table-hover" id="dataTable">
        <thead>
            <tr class="bg-dark text-white">
                <th>S/No</th>
                <th>
                    Employee ID
                </th>
                <th>
                    Department
                </th>
                <th>
                    Job Title
                </th>
                <th>
                    Job Class
                </th>
                <th>
                    Salary
                </th>
                <th>
                    Date
                </th>
                <th>
                    Status
                </th>
                <th>Grade</th>
                <th>Step</th>
                <th class="d-print-none px-4 text-end">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int index = 1;
            }
            @foreach (var item in Model.jobPlacementModel)
            {
                <tr onclick="location.href='@Url.Page("Details", new { id = item.jobPlacementID })'" style="cursor:pointer">
                    <td>@(index++)</td>
                    <td>
                        @Html.DisplayFor(modelItem => item.employmentModel.givenID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.departmentModel.departmentName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.jobModel.jobTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.jobModel.jobClassModel.jobClassName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.jobPlacementSalary)
                    </td>
                    <td>
                        @item.jobPlacementDate.ToString("yyyy-MM-dd")
                    </td>
                    <td>
                        
                        @if (item.jobPlacementStatus == Models.mainStatus.Active)
                        {
                            <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobPlacementStatus)</span>

                        }
                        else if (item.jobPlacementStatus == Models.mainStatus.Suspended)
                        {
                            <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobPlacementStatus)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobPlacementStatus)</span>
                        }
                    </td>
                    <td>
                        @item.jobStepModel?.jobGradeModel?.jobGradeName
                    </td>
                    <td>
                        @item.jobStepModel?.jobStepName
                    </td>
                    <td class="d-print-none px-4 text-end">
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-end align-itemsend m-2">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>
