@page
@using PIS2.Enums
@model PIS2.Pages.JobPlacement.CreateModel

@{
    ViewData["Title"] = "Job Placements";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Job Placements</h2>
        <p class="text-muted mb-0">Assign and manage employee job placements</p>
    </div>
    
        <!-- Main Form Card -->
        <div class="card shadow-sm">
            <div class="card-body">

                <h5 class="fw-semibold mb-4">Assign New Job Placement</h5>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="jobPlacementModel.jobPlacementStatus"
                           value="@mainStatus.Suspended"
                           type="hidden" />

                    <div class="row g-4">

                        <!-- LEFT COLUMN -->
                        <div class="col-md-6">
                        <!--EMPLOYEE LOOKUP-->
                        <!-- Selector -->
                        <div class="mb-3">
                            <label asp-for="jobPlacementModel.employmentID" class="form-label fw-semibold">
                                <span class="text-danger">*</span> Select Employee
                            </label>
                            
                            <input type="text" class="form-control" list="personList" placeholder="Type to search..." oninput="selector(this, 'personIDHidden')" value="@Model.employmentModel.givenID-@Model.employmentModel?.personModel?.personFullName" />
                            <input type="hidden" asp-for="jobPlacementModel.employmentID" id="personIDHidden" value="@Model.employmentModel?.employmentID" />
                            <datalist id="personList">
                                @foreach (var person in Model.Employments)
                                {
                                    <option data-id="@person.Value" value="@person.Text"></option>
                                }
                            </datalist>
                            <span asp-validation-for="jobPlacementModel.employmentID" class="text-danger"></span>
                        </div>
                            <div class="mb-3">
                                <label asp-for="company" class="form-label fw-semibold">Company</label>
                                <select asp-for="company" class="form-control" asp-items="ViewBag.companyID" id="filter-company">
                                    <option value="">-- Select Company --</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="jobPlacementModel.departmentID" class="form-label fw-semibold">Department</label>
                                <select asp-for="jobPlacementModel.departmentID" class="form-control" id="filter-department">
                                    <option value="">-- Select Department --</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="jobPlacementModel.jobID" class="form-label fw-semibold">
                                    <span class="text-danger">*</span> Job
                                </label>

                                <input type="text" class="form-control" list="jobList" placeholder="Type to search..." oninput="selector(this, 'jobIDHidden')" />

                                <input type="hidden" asp-for="jobPlacementModel.jobID" id="jobIDHidden" onchange="getJobGrade(this, '#jobGradeID');" />

                                <datalist id="jobList">
                                    @foreach (var job in (SelectList)ViewData["jobID"])
                                    {
                                        <option data-id="@job.Value" value="@job.Text"></option>
                                    }
                                </datalist>

                                <span asp-validation-for="jobPlacementModel.jobID" class="text-danger"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Job Grade</label>
                                    <select class="form-control"
                                            asp-items="ViewBag.jobGradeID"
                                            id="jobGradeID"
                                            onchange="getJobSteps(this, '#jobStepID');">
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="jobPlacementModel.jobStepID" class="form-label fw-semibold">Job Step</label>
                                    <select asp-for="jobPlacementModel.jobStepID"
                                            class="form-control"
                                            id="jobStepID"
                                            onchange="getJobSalary(this, '#salary');">
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="jobPlacementModel.jobPlacementSalary" class="form-label fw-semibold">
                                        <span class="text-danger">*</span> Salary
                                    </label>
                                    <input asp-for="jobPlacementModel.jobPlacementSalary"
                                           class="form-control fw-bold"
                                           id="salary" />
                                    <span asp-validation-for="jobPlacementModel.jobPlacementSalary" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <!-- RIGHT COLUMN -->
                        <div class="col-md-6">

                            <div class="mb-3">
                                <label asp-for="jobPlacementModel.jobPlacementDate" class="form-label fw-semibold">Placement Date</label>
                                <input asp-for="jobPlacementModel.jobPlacementDate"
                                       class="form-control"
                                       type="date"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="jobPlacementModel.jobPlacementDate" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="jobPlacementModel.jobPlacementReason" class="form-label fw-semibold">
                                    <span class="text-danger">*</span> Reason
                                </label>
                                <select asp-for="jobPlacementModel.jobPlacementReason" class="form-control">
                                    <option value="">-- Select Reason --</option>
                                    <option value="New Hire">New Hire</option>
                                    <option value="Promotion">Promotion</option>
                                    <option value="Transfer">Transfer</option>
                                    <option value="Demotion">Demotion</option>
                                    <option value="Temporary Assignment">Temporary Assignment</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="jobPlacementModel.jobPlacementReason" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="jobPlacementModel.jobPlacementReference" class="form-label fw-semibold">
                                    <span class="text-danger">*</span> Reference
                                </label>
                                <input asp-for="jobPlacementModel.jobPlacementReference" class="form-control" />
                                <span asp-validation-for="jobPlacementModel.jobPlacementReference" class="text-danger"></span>
                            </div>

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end border-top pt-3 mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            Save Job Placement
                        </button>
                    </div>

                </form>
            </div>
        </div>
    
    <div class="mt-4">
        <a asp-page="/JobPlacement/Index" class="link-primary fw-semibold">
            ← View Job Placements
        </a>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/filter-department.js"></script>
}
