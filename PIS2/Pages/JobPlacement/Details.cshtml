@page
@model PIS2.Pages.JobPlacement.DetailsModel

@{
    ViewData["Title"] = "Job Placement Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Placements</h1>

<div class ="row d-flex" id="jobPlacementDiv">
    <h4 class="fw-bold">Job Placement Details</h4>
    <hr />
    <div class="col-md-6">
      
        <dl class="row d-print-flex">
            <div class="d-flex">
                <dt class="m-2">
                    Employee ID:
                </dt>
                <dd class="m-2">
                    <u onclick="location.href='@Url.Page("/Employment/Details", new{id = Model.jobPlacementModel.employmentID})'" style="cursor:pointer;">@Html.DisplayFor(model => model.jobPlacementModel.employmentModel.givenID)</u>
                </dd>
             </div>
            <div class="d-flex">
                <dt class="m-2">
                    Department:
                </dt>
                <dd class="m-2">
                    <u>@Html.DisplayFor(model => model.jobPlacementModel.departmentModel.departmentName)</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Job Title:
                </dt>
                <dd class="m-2">
                    <u>@Html.DisplayFor(model => model.jobPlacementModel.jobModel.jobTitle)</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Shift:
                </dt>
                <dd class="m-2">
                    <u>@Html.DisplayFor(model => model.jobPlacementModel.shiftModel.shiftName)</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Grade:
                </dt>
                <dd class="m-2">
                    <u>@Model.jobPlacementModel?.jobModel?.jobGradeModel?.jobGradeName</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Step:
                </dt>

                <dd class="m-2">
                    <u>@Model.jobPlacementModel?.jobStepModel?.jobStepNumber</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Salary:
                </dt>
                <dd class="m-2">
                    <u>@Html.DisplayFor(model => model.jobPlacementModel.jobPlacementSalary)</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Date:
                </dt>
                <dd class="m-2">
                    <u>@Model.jobPlacementModel?.jobPlacementDate.ToString("MMM dd, yyyy")</u>
                </dd>
            </div>
            <div class="d-flex">
                <dt class="m-2">
                    Status:
                </dt>
                <dd class="m-2">
                    <u>@Html.DisplayFor(model => model.jobPlacementModel.jobPlacementStatus)</u>
                </dd>
            </div>
        </dl>
    </div>
    <div class="col-md-6">
        <h4 class="fw-bold">Job Placement History</h4>
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-info text-white">
                    <th>Date</th>
                    <th>Step</th>
                    <th>Salary</th>                   
                    <th>Department</th>
                    <th>Status</th>
                    <th>Modified By</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.jobPlacementModel.JobPlacementHistories)
                {
                    <tr>
                        <td>@item.modifiedDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.jobStepModel?.jobStepNumber</td>
                        <td>@item.jobPlacementSalary</td>
                        <td>@item.departmentModel?.departmentName</td>
                        <td>@item.jobPlacementStatus</td>
                        <td>@item.modifiedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="d-print-none d-flex justify-content-end">
    @if (User.IsInRole("PMS_HRCLERK"))
    {
        <a asp-page="./Edit" asp-route-id="@Model.jobPlacementModel.jobPlacementID" class="btn btn-primary m-2">Edit</a>
        <a asp-page="./Delete" asp-route-id="@Model.jobPlacementModel.jobPlacementID" class="btn btn-danger m-2">Delete</a>
    }
    
    @await Html.PartialAsync("print")
</div>
