@page
@model PIS2.Pages.JobPlacement.DetailsModel

@{
    ViewData["Title"] = "Job Placement Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Placements</h1>

<div class ="row d-flex" id="jobPlacementDiv">
    <h4>Job Placement Details</h4>
    <hr />
    <div class="col-md-6">
      
        <dl class="row">
    
            <dt class="col-sm-2">
                Employee ID:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.employmentModel.givenID)
            </dd>
            <dt class="col-sm-2">
                Department:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.departmentModel.departmentName)
            </dd>
            <dt class="col-sm-2">
                Job Title:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.jobModel.jobTitle)
            </dd>
            <dt class="col-sm-2">
                Shift:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.shiftModel.shiftName)
            </dd>
            <dt class="col-sm-2">
                Salary:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.jobPlacementSalary)
            </dd>
            <dt class="col-sm-2">
                Date:
            </dt>
            <dd class="col-sm-10">
                @Model.jobPlacementModel.jobPlacementDate.ToString("MMM dd, yyyy")
            </dd>
            <dt class="col-sm-2">
                Status:
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.jobPlacementModel.jobPlacementStatus)
            </dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h4>Job Placement History</h4>
        <table class="table table-striped table-hover">
            <thead>
                <tr class="bg-dark text-white">
                    <th>Job Title</th>
                    <th>Date</th>
                    <th>Salary</th>
                    <th>Department</th>
                    <th>Shift</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.jobPlacementList)
                {
                    <tr>
                        <td>@item.jobModel.jobTitle</td>
                        <td>@item.jobPlacementDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.jobPlacementSalary</td>
                        <td>@item.departmentModel.departmentName</td>
                        <td>@item.shiftModel.shiftName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.jobPlacementModel.jobPlacementID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
    <button class="btn btn-outline-primary" onclick="printDiv('jobPlacementDiv')">Print</button>
</div>
