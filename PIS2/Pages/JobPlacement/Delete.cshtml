@page
@model PIS2.Pages.JobPlacement.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Job Placement</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employment ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Department:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.departmentModel.departmentName)
        </dd>
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.jobModel.jobID)
        </dd>
        <dt class="col-sm-2">
            Shift:
        </dt>
        
        <dt class="col-sm-2">
            Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.jobPlacementSalary)
        </dd>
        <dt class="col-sm-2">
            Placement Date:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.jobPlacementDate)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobPlacementModel.jobPlacementStatus)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="jobPlacementModel.jobPlacementID" />
        <input type="submit" value="Delete" class="btn btn-danger m-2" /> 
        
    </form>
    <a asp-page="./Index">View All Job Placements</a>
</div>
