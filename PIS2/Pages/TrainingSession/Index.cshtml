@page
@model PIS2.Pages.TrainingSession.IndexModel
@{
    ViewData["Title"] = "Training Sessions";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0 fw-bold">Training Sessions</h2>
            <h6 class="text-muted">Sessions Catalog</h6>
        </div>
        
        <a asp-page="Create" class="btn btn-primary shadow-sm d-print-none">
            <i class="fas fa-calendar-plus me-2"></i> Schedule Session
        </a>
    </div>
    <div class="card shadow-sm p-2 m-2 d-print-none">
        <div class="d-flex justify-content-end  align-items-center">

            @await Html.PartialAsync("filter")
            @await Html.PartialAsync("print")
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 print-full-width" id="dataTable">
                <thead class="table-dark">
                    <tr>
                        <th>S/No</th>
                        <th>Training Program</th>
                        <th>Date & Time</th>
                        <th>Trainer / Provider</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th class="text-end px-4 d-print-none">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Sessions.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted">
                                No session found.
                            </td>
                        </tr>
                    }
                    @{
                        int index = 1;
                    }
                    @foreach(var trainings in Model.Sessions.GroupBy(t => t.trainingID))
                    {
                       
                         int index1 = 1;
                        
                        <tr>
                            <td>@(index)</td>
                            <td colspan="6"><div class="fw-bold">@trainings.FirstOrDefault().Training?.trainingTitle</div></td>
                        </tr>
                        @foreach (var item in trainings.OrderBy(t => t.startDate))
                        {
                            <tr>
                                 <td>@(index).@(index1++)</td>
                                <td onclick="location.href='@Url.Page("/TrainingSession/Details", new {id=item.trainingSessionID})'" style="cursor:pointer;">
                                    <div class="fw-bold text-muted">@item.trainingSessionTitle</div>
                                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i> @item.location</small>
                                </td>
                                <td>
                                    <div>@item.startDate.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@item.startDate.ToShortTimeString() - @item.endDate.ToShortTimeString()</small>
                                </td>
                                <td>
                                    @if (String.IsNullOrEmpty(item.PersonModel?.personFullName))
                                    {
                                        <p>To be arranged</p>
                                    }
                                    else { <div><a href="/Person/Details?id=@item.personID">@item.PersonModel?.personFullName</a></div>
                                    <small class="text-muted">@item.provider</small>}

                                    
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.deliveryMode</span></td>
                                <td>
                                    @{
                                        var statusClass = item.sessionStatus switch
                                        {
                                            Models.trainingStatus.Planned => "bg-info",
                                            Models.trainingStatus.Ongoing => "bg-warning",
                                            Models.trainingStatus.Completed => "bg-success",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@item.sessionStatus</span>
                                </td>
                                <td class="text-end px-4 d-print-none">
                                    <a asp-page="./Edit" asp-route-id="@item.trainingSessionID" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a asp-page="./Details" asp-route-id="@item.trainingSessionID" class="btn btn-sm btn-primary">Attendance</a>
                                </td>
                            </tr>
                        }
                            index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="d-flex justify-content-end m-2">
    @await Html.PartialAsync("back")
    @await Html.PartialAsync("print")
</div>