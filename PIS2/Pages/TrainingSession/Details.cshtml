@page "{id:int}"
@model PIS2.Pages.TrainingSession.DetailsModel
<div class="d-flex justify-content-between mb-2 align-items-end">
    <div>
        <h2 class="fw-bold">Training</h2>
        <h6 class="text-muted">Training session details and status</h6>
    </div>
    <a class="btn btn-outline-primary" asp-page="Index">View Sessions Catalog</a>
</div>
<div class="container mt-4">
  
    <div class="row">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="fw-bold card-title mb-0">Session Overview</h5>
                </div>
                <div class="card-body">
                    <h4 class="fw-bold text-dark">@Model.Session.Training?.trainingTitle</h4>
                    <p class="fw-bold text-muted small">@Model.Session.trainingSessionTitle</p>
                    <p class="text-muted small">@Model.Session.Training?.description</p>
                    <hr />
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7"><span class="badge bg-info">@Model.Session.sessionStatus</span></dd>

                        <dt class="col-sm-5">Delivery</dt>
                        <dd class="col-sm-7">@Model.Session.deliveryMode</dd>

                        <dt class="col-sm-5">Cost</dt>
                        <dd class="col-sm-7">@(Model.Session.cost?.ToString("C") ?? "Free")</dd>

                        <dt class="col-sm-5">Trainer</dt>
                        <dd class="col-sm-7">@(Model.Session?.PersonModel?.personFullName)</dd>

                        <dt class="col-sm-5">Date & Time</dt>
                        <dd class="col-sm-7">
                            <div>@Model.Session?.startDate.ToString("MMM dd, yyyy")</div>
                            <small class="text-muted">@Model.Session?.startDate.ToShortTimeString() - @Model.Session.endDate.ToShortTimeString()</small>
                        </dd>
                    </dl>
                    
                </div>
            </div>
            <div class="d-flex justify-content-end m-2">
                <a asp-page="/TrainingSession/Edit" asp-route-id="@Model.Session.trainingSessionID" class="btn btn-primary ">@L.T("Edit")</a>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Registered Attendees</h5>
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAttendeeModal">
                        <i class="bi bi-person-plus"></i> Add Attendee
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th>Result</th>
                                <th>Score</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Session?.Attendances ?? new List<PIS2.Models.HR.trainingAttendanceModel>())
                            {
                                <tr>
                                    <td>
                                        <strong>@item.EmploymentModel?.givenID - @item.EmploymentModel?.personModel?.personFullName</strong>
                                        <div class="text-muted small">Cert: @(item.certificateNumber ?? "N/A")</div>
                                    </td>
                                    <td>
                                        <span class="badge @(item.result == PIS2.Enums.trainingResult.Passed ? "bg-success" : "bg-warning")">
                                            @item.result
                                        </span>
                                    </td>
                                    <td>@(item.score?.ToString("N2") ?? "-")</td>
                                    <td class="text-end">
                                        <a asp-page="/TrainingSessionAttendance/Details" asp-route-id="@item.trainingAttendanceID" class="btn btn-outline-secondary btn-sm">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addAttendeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AddAttendance">
                <input asp-for="NewAttendance.trainingSessionID" value="@Model.Session?.trainingSessionID" type="hidden" />
                <div class="modal-header">
                    <h5 class="modal-title">Record Attendance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewAttendance.employmentID" class="form-label">Employee ID</label>
                        <input type="text" class="form-control" list="personList" placeholder="Enter ID" oninput="selector(this, 'personIDHidden')" />
                        <input type="hidden" asp-for="NewAttendance.employmentID" class="form-control" id="personIDHidden" />
                        <datalist id="personList">
                            @foreach (var person in Model.EmpList)
                            {
                                <option data-id="@person.Value" value="@person.Text"></option>
                            }
                        </datalist>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="NewAttendance.result" class="form-label">Result</label>
                            <select asp-for="NewAttendance.result" class="form-select" asp-items="Html.GetEnumSelectList<PIS2.Enums.trainingResult>()"></select>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="NewAttendance.score" class="form-label">Score</label>
                            <input asp-for="NewAttendance.score" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Attendee</button>
                </div>
            </form>
        </div>
    </div>
</div>