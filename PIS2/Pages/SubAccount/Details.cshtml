@page
@model PIS2.Pages.SubAccount.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Sub-Accounts</h1>

<div>
    <h4>Sub-Account Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Master Account: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.accountModel.accountNumber)
        </dd>
        <dt class="col-sm-2">
            Sub-Account Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountName)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.subAccountModel.subAccountID">@L.T("Edit")</a> |
    <a asp-page="./Index">Back to List</a>
</div>
