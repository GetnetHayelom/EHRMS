@page
@model PIS2.Pages.SubAccount.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Sub-Accounts</h1>

<h3>Are you sure you want to delete this sub-account?</h3>
<div>
    <h4>subAccountModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Master Account: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.accountModel.accountNumber)
        </dd>
        <dt class="col-sm-2">
            Sub-Account Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountName)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.subAccountModel.subAccountStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="subAccountModel.subAccountID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
