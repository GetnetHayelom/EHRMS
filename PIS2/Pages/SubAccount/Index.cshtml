@page
@model PIS2.Pages.SubAccount.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-end">
    <div>
        <h2 class="fw-bold">Sub-Accounts</h2>

        <p class=" d-print-none">
            <a asp-page="Create" class="btn btn-primary">Add New Sub-Accounts</a>
        </p>
    </div>
    <div class="d-flex justify-content-end d-print-none">
        <form method="get" class="d-flex">
            <label class="form-label"> Filter by Status</label>
            <select asp-for="SubAccountStatus" class="form-control m-2" asp-items="@Html.GetEnumSelectList<Models.mainStatus>()" onchange="this.form.submit()">
                <option value="" selected> All</option>
            </select>
        </form>
        <div class="me-2">@await Html.PartialAsync("filter")</div>
        @await Html.PartialAsync("print")
        <excel-export table="dataTable" filename="SubAccounts_@(DateTime.UtcNow).xlsx"></excel-export>
    </div>
</div>


<table class="table table-striped table-hover print-full-width" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Master Account
            </th>
            <th>
                Sub-Account Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th class="d-print-none">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var subs in Model.subAccountModel.GroupBy(s => s.accountID))
        {
            <tr class="table-primary">
                <th>@subs.FirstOrDefault().accountModel?.accountName
                (@subs.FirstOrDefault().accountModel?.accountNumber)</th>
                <th colspan="4"></th>
            </tr>
            @foreach (var item in subs) {
            <tr>
                <td>
                    
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.subAccountName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.subAccountDescription)
                </td>
                <td>
                        @if (item.subAccountStatus == Models.mainStatus.Active)
                        {
                            <span class="badge bg-success">@Html.DisplayFor(modelItem => item.subAccountStatus)</span>

                        }
                        else if (item.subAccountStatus == Models.mainStatus.Suspended)
                        {
                            <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.subAccountStatus)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.subAccountStatus)</span>
                        }
                </td>
                <td class="d-print-none">
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.subAccountID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.subAccountID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                </td>
            </tr>
        }
    
        }
        
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("print")
    <excel-export table="dataTable" filename="SubAccounts_@(DateTime.UtcNow).xlsx"></excel-export>
</div>
