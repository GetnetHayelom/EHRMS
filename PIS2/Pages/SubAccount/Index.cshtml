@page
@model PIS2.Pages.SubAccount.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Sub-Accounts</h1>

<p>
    <a asp-page="Create">Add New Sub-Accounts</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Master Account
            </th>
            <th>
                Sub-Account Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.subAccountModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.accountModel.accountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.subAccountName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.subAccountDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.subAccountStatus)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.subAccountID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.subAccountID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.subAccountID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
