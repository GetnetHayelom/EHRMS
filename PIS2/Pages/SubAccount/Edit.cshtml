@page
@using PIS2.Enums
@model PIS2.Pages.SubAccount.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Sub-Accounts</h1>

<h4 class="fw-bold">Edit Sub-Account</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="subAccountModel.subAccountID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="subAccountModel.accountID" class="control-label">Master Account</label>
                <select asp-for="subAccountModel.accountID" class="form-control" asp-items="ViewBag.accountID"></select>
                <span asp-validation-for="subAccountModel.accountID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="subAccountModel.subAccountNumber" class="control-label">Sub-Account Number</label>
                <input asp-for="subAccountModel.subAccountNumber" class="form-control" />
                <span asp-validation-for="subAccountModel.subAccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="subAccountModel.subAccountName" class="control-label">Sub-Account Name</label>
                <input asp-for="subAccountModel.subAccountName" class="form-control" />
                <span asp-validation-for="subAccountModel.subAccountName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="subAccountModel.subAccountDescription" class="control-label">Description</label>
                <input asp-for="subAccountModel.subAccountDescription" class="form-control" />
                <span asp-validation-for="subAccountModel.subAccountDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="subAccountModel.subAccountStatus" class="control-label">Status</label>
                <select asp-for="subAccountModel.subAccountStatus" class="form-control" asp-items="Html.GetEnumSelectList<mainStatus>()"></select>
                <span asp-validation-for="subAccountModel.subAccountStatus" class="text-danger"></span>
            </div>
            <div class="form-group justify-content-end m-2">
                <input type="submit" value="Update" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Sub Accounts</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
