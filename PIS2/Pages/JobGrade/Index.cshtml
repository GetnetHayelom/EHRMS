@page
@using PIS2.Enums
@model PIS2.Pages.JobGrade.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between">
    <div>
        <h2 class="fw-bold mb-0">Job Grades</h2>
        <p class="text-muted mb-0">Job Grades catalog</p>
    </div>

    <div class="d-flex justify-content-end align-items-end">
        <div class="card shadow-sm m-1">
            <div class="d-flex justify-content-end d-print-none">
                <form method="get" class="d-flex align-items-end">
                    <label class="form-label fw-bold m-2">Status</label>
                    <select asp-for="JobGradeStatus" class="form-control m-2" asp-items="@Html.GetEnumSelectList<mainStatus>()" onchange="this.form.submit()">
                        <option value="" selected> All</option>
                    </select>
                </form>
                <div class="me-2">@await Html.PartialAsync("filter")</div>
                <excel-export table="dataTable" filename="Companies_@(DateTime.UtcNow).xlsx"></excel-export>
                @await Html.PartialAsync("print")            
                <a asp-page="Create" class="btn btn-primary m-2"><i class="bi bi-plus-circle"></i>Add New Job Grade</a>
            </div>
        </div>
    </div>
</div>


<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Job Grade Name
            </th>
            <th>
                Description
            </th>
            <th>
                Basic Monthly Salary
            </th>
            <th>
                Basic Annual Salary
            </th>
            <th>
                Maximum Annual Salary
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.jobGradeModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.jobGradeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.jobGradeDescription)
            </td>
            <td> @Math.Round(item.jobGradeBasicSalary/12, 2).ToString("N2")</td>
            <td>
                @Html.DisplayFor(modelItem => item.jobGradeBasicSalary)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.jobGradeMaxSalary)
                </td>
            <td>
                @if (item.jobGradeStatus == mainStatus.Active)
                {
                    <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobGradeStatus)</span>

                }
                else if (item.jobGradeStatus == mainStatus.Suspended)
                {
                    <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobGradeStatus)</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobGradeStatus)</span>
                }
                
            </td>
            <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.jobGradeID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.jobGradeID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end d-print-none">
    @await Html.PartialAsync("back")
    <excel-export table="dataTable" filename="JobGrades_@(DateTime.UtcNow).xlsx"></excel-export>
    @await Html.PartialAsync("print")
</div>
