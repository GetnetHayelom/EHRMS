@page
@model PIS2.Pages.JobGrade.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Job Grade</h1>

<h3>Are you sure you want to delete this job grade?</h3>
<div>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Job Grade Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeName)
        </dd>
        <dt class="col-sm-2">
            Decription: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeDescription)
        </dd>
        <dt class="col-sm-2">
            Basic Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeBasicSalary)
        </dd>
        <dt class="col-sm-2">
            Maximum Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeMaxSalary)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="jobGradeModel.jobGradeID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
