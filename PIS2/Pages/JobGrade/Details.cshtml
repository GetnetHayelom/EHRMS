@page
@using PIS2.Enums
@model PIS2.Pages.JobGrade.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-0">Job Grades</h2>
<p class="text-muted mb-0">Job grade details #@Model.jobGradeModel.jobGradeID</p>

<div class="d-flex justify-content-between">

    <hr />
    <dl class="row col-md-5">
        <dt class="col-sm-2">
            Name: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeName)
        </dd>
        <dt class="col-sm-2">
            Decription: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeDescription)
        </dd>
        <dt class="col-sm-2">
            Basic Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeBasicSalary)
        </dd>
        <dt class="col-sm-2">
            Maximum Salary:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeMaxSalary)
        </dd>
        <dt class="col-sm-2">
            Status: 
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobGradeModel.jobGradeStatus)
        </dd>
    </dl>
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex align-items-center">
                <i class="bi bi-clock-history me-2"></i> Audit Trail
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase">
                                <th>Date</th>
                                <th>User</th>
                                <th>Field</th>
                                <th>Old Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.History.Any())
                            {
                                @foreach (var log in Model.History)
                                {
                                    <tr>
                                        <td class="small">@log.ModifiedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                        <td class="small fw-bold">@log.ModifiedBy</td>
                                        <td><span class="badge bg-light text-dark">@Model.GetFriendlyColumnName(log.ColumnName)</span></td>
                                        <td class="text-muted italic small">
                                            <span class="text-danger text-decoration-line-through small">
                                                @Model.FormatAuditValue(log.ColumnName, log.OldValue)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No change history found for this record.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white small text-muted">
                Total changes tracked: @Model.History.Count
            </div>
        </div>
    </div>
  
</div>
<div class="card shadow-sm mt-2">
    <div class="card-header"><h5 class="fw-bold">Job Steps in Grade</h5></div>
    <table class="card-body table table-striped table-hover" id="dataTable">
        <thead class="bg-dark text-white">
            <tr>
                <th>
                    Job Step Name
                </th>

                <th>Job Step Number</th>
                <th>
                    Job Step Salary
                </th>
                <th>
                    Job Step Status
                </th>
                <th>
                    Modified By
                </th>
                <th class="d-print-none">Action</th>

            </tr>
        </thead>
        <tbody>
           
            @foreach (var item in Model.JobSteps.OrderBy(j => j.jobStepSalary))
            {
                    <tr onclick="location.href='@Url.Page("Details", new { id = item.jobStepID })'" style="cursor:pointer">
                        <td>
                            @Html.DisplayFor(modelItem => item.jobStepName)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.jobStepNumber)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.jobStepSalary)
                        </td>
                        <td>
                            @if (item.jobStepStatus == mainStatus.Active)
                            {
                                <span class="badge bg-success">@Html.DisplayFor(modelItem => item.jobStepStatus)</span>

                            }
                            else if (item.jobStepStatus == mainStatus.Suspended)
                            {
                                <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.jobStepStatus)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.jobStepStatus)</span>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.modifiedBy)
                        </td>
                        <td class="d-print-none">
                            <div class="btn-group" role="group">
                                <a asp-page="/JobStep/Details" asp-route-id="@item.jobStepID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="/JobStep/Edit" asp-route-id="@item.jobStepID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            
        </tbody>
    </table>
    </div>
<div class="card shadow-sm mt-2">
    <div class="card-header"><h5 class="fw-bold">Jobs in Grade</h5></div>
    <table class="card-body table table-hover align-middle" id="dataTable">
        <thead class="table-dark text-white">
            <tr>
                <th>Job Title</th>
                <th>Job Grade</th>
                <th>Job Category</th>
                <th>Job Class</th>
                <th>Experience</th>
                <th>Status</th>
                <th class="no-print text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Jobs.OrderBy(j => j.jobTitle))
            {
                <tr>
                    <td>@item.jobTitle</td>
                    <td>@item.jobGradeModel?.jobGradeName</td>
                    <td>@item.jobCategoryModel?.jobCategoryName</td>
                    <td>@item.jobClassModel?.jobClassName</td>
                    <td>@item.jobExperience</td>
                    <td>
                        @if (item.jobStatus.ToString() == "Active")
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (item.jobStatus.ToString() == "Inactive")
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        else
                        {
                            <span class="badge bg-info">@item.jobStatus</span>
                        }
                    </td>
                    <td class="no-print text-center">
                        <div class="btn-group" role="group">
                            <a asp-page="/Job/Details" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="/Job/Edit" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-success" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.jobGradeModel.jobGradeID" class="btn btn-primary me-2"><i class="bi bi-pencil-square me-2"></i>Edit</a> 
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
</div>
