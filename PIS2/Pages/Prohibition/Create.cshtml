@page
@using PIS2.Enums
@model PIS2.Pages.Prohibition.CreateModel
@{
    ViewData["Title"] = "Create Prohibition";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    var successMessage = TempData["SuccessMessage"] as string;
}

@await Html.PartialAsync("headerSimple", "")
<div class="d-print-none">
    <h1 class="fw-bold mb-2">Prohibition Management</h1>
    <h5 class="text-secondary mb-4">Add new prohibition record</h5>
</div>

<hr />

<div class="row print-full-width">
    <!-- Left Column -->
    <div class="col-md-4 d-print-none">

        <!-- Search Employee Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light fw-bold">
                Look up by Employee ID
            </div>

            <div class="card-body">
                <form method="get" class="d-flex">
                    <input id="givenID" name="searchID" type="text"
                           class="form-control me-2"
                           asp-for="@Model.Employment.givenID"
                           placeholder="Enter Employee ID"
                           list="givenIDList" />
                    <button type="submit" class="btn btn-primary">View</button>
                </form>

                <div class="mt-3">
                    @if (Model.Employment != null && Model.Employment.employmentID != 0)
                    {
                        <h5 class="fw-bold text-success">
                            @Model.Employment?.personModel?.personFullName
                        </h5>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-2" role="alert">
                            @successMessage
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Prohibition Form / Employee Status Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">

                @if (Model.Employment.employmentID == 0)
                {
                    <div class="bg-info text-white p-3 rounded">
                        <h5>Select an Employee</h5>
                    </div>
                }
                else if (Model.Employment?.employmentStatus == mainStatus.Inactive)
                {
                    <div class="bg-danger text-white p-3 rounded">
                        <h5>Employee is Inactive</h5>
                    </div>
                }
                else if (Model.Employment?.employmentStatus == mainStatus.Active)
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               asp-for="prohibitionModel.employmentID"
                               value="@Model.Employment.employmentID" />

                        <div class="form-group mb-3">
                            <label asp-for="prohibitionModel.prohibitionStart" class="form-label">Start Date</label>
                            <input asp-for="prohibitionModel.prohibitionStart" class="form-control" type="date"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="prohibitionModel.prohibitionStart" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="prohibitionModel.prohibitionEnd" class="form-label">End Date</label>
                            <input asp-for="prohibitionModel.prohibitionEnd" class="form-control" type="date" />
                            <span asp-validation-for="prohibitionModel.prohibitionEnd" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="prohibitionModel.prohibitionReason" class="form-label">Reason</label>
                            <input asp-for="prohibitionModel.prohibitionReason" class="form-control" />
                            <span asp-validation-for="prohibitionModel.prohibitionReason" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="prohibitionModel.prohibitionType" class="form-label">Type</label>
                            <select asp-for="prohibitionModel.prohibitionType"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<Enums.ProhibitionType>()"></select>
                            <span asp-validation-for="prohibitionModel.prohibitionType" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="prohibitionModel.prohibitionRemark" class="form-label">Remark</label>
                            <textarea asp-for="prohibitionModel.prohibitionRemark"
                                      class="form-control" rows="2"></textarea>
                            <span asp-validation-for="prohibitionModel.prohibitionRemark" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success px-4">Save</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="bg-danger text-white p-3 rounded">
                        <h5>Employee is Not Active</h5>
                    </div>
                }
            </div>
        </div>

        <div class="text-end">
            <a asp-page="Index" class="text-decoration-none">
                <i class="bi bi-list"></i> View All Prohibition Records
            </a>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-md-8 print-full-width">
        @if (Model.Prohibitions != null && Model.Prohibitions.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold mb-3">Employee Prohibition History</h4>

                    <div class="d-flex justify-content-between mb-3">
                        <div><strong>Employee ID:</strong> <u>@Model.Employment?.givenID</u></div>
                        <div><strong>Name:</strong> <u>@Model.Employment?.personModel?.personFullName</u></div>
                    </div>

                    <table class="table table-striped table-hover align-middle print-full-width">
                        <thead class="table-dark">
                            <tr>
                                <th>Issue Date</th>
                                <th>Type</th>
                                <th>Reason</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Status</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prob in Model.Prohibitions.OrderByDescending(p => p.prohibitionDate))
                            {
                                <tr onclick="location.href='@Url.Page("Details", new { id = prob.prohibitionID })'"
                                    style="cursor:pointer;">
                                    <td>@prob.prohibitionDate.ToString("MM/dd/yyyy")</td>
                                    <td>@prob.prohibitionType</td>
                                    <td>@prob.prohibitionReason</td>
                                    <td>@prob.prohibitionStart.ToString("MM/dd/yyyy")</td>
                                    <td>@prob.prohibitionEnd.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        @if (prob.prohibitionStatus == mainStatus.Active)
                                        {
                                            <span class="badge bg-success">@prob.prohibitionStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@prob.prohibitionStatus</span>
                                        }
                                    </td>
                                    <td>@prob.prohibitionRemark</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-end">
                        @await Html.PartialAsync("print")
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
