@page
@model PIS2.Pages.Prohibition.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Prohibition</h1>

<h4 class="fw-bold">Update Prohibition</h4>
<hr />
<div class="row">
    <div class="col-md-4 card shadow-sm p-2">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="prohibitionModel.prohibitionID" />
            
            <div class="form-group">
                <label asp-for="prohibitionModel.employmentModel.givenID" class="control-label">Employee ID</label>
                <input class="form-control" value="@Model.prohibitionModel.employmentModel?.givenID" readonly />
                <span asp-validation-for="prohibitionModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.employmentModel.personModel.personFullName" class="control-label">Employee ID</label>
                <input class="form-control" value="@Model.prohibitionModel.employmentModel?.personModel?.personFullName" readonly />
                <span asp-validation-for="prohibitionModel.employmentID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionStart" class="control-label">Start</label>
                <input asp-for="prohibitionModel.prohibitionStart" class="form-control" type="date"/>
                <span asp-validation-for="prohibitionModel.prohibitionStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionEnd" class="control-label">End</label>
                <input asp-for="prohibitionModel.prohibitionEnd" class="form-control" type="date"/>
                <span asp-validation-for="prohibitionModel.prohibitionEnd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionStatus" class="control-label">Status</label>
                <select asp-for="prohibitionModel.prohibitionStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="prohibitionModel.prohibitionStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionReason" class="control-label">Reason</label>
                <input asp-for="prohibitionModel.prohibitionReason" class="form-control" />
                <span asp-validation-for="prohibitionModel.prohibitionReason" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionType" class="control-label">Type</label>
                <select asp-for="prohibitionModel.prohibitionType" class="form-control" asp-items="Html.GetEnumSelectList<Models.ProhibitionType>()"></select>
                <span asp-validation-for="prohibitionModel.prohibitionType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="prohibitionModel.prohibitionRemark" class="control-label">Remark</label>
                <input asp-for="prohibitionModel.prohibitionRemark" class="form-control" />
                <span asp-validation-for="prohibitionModel.prohibitionRemark" class="text-danger"></span>
            </div>
            
            <div class="form-group d-flex justify-content-end">
                @await Html.PartialAsync("back")
                <input type="submit" value="Save" class="btn btn-success m-2" />
            </div>
        </form>
    </div>
    <div class="col-md-8 m-2">
        <div class="card shadow-sm p-2">
            <h4 class="fw-bold">Prohibition History</h4>
            <table class="table table-hover table-striped">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Date</th>
                        <th>Modified By</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.prohibitionHistory)
                    {
                        <tr>
                            <td>@item.modifiedDate</td>
                            <td>@item.modifiedBy</td>
                            <td>
                                @if (item.prohibitionStatus == Models.mainStatus.Active)
                                {
                                    <span class="badge bg-success">@item.prohibitionStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.prohibitionStatus</span>
                                }
                            </td>
                            <td>@item.prohibitionStart</td>
                            <td>@item.prohibitionEnd</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="m-2">
    <a asp-page="./Index">View All Prohibirion</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
