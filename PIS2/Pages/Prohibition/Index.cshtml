@page
@model PIS2.Pages.Prohibition.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Prohibitions</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">New Prohibition</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover">
    <thead class="bg-dark text-white">
        <tr>
            <th>
                Employee ID
            </th>
            <th>
                Start
            </th>
            <th>
                End
            </th>
            <th>
                Status
            </th>
            <th>
                Reason
            </th>
            <th>
                Type
            </th>
            <th>
                Remark
            </th>
            <th>
                Modified By
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.prohibitionModel) {
        <tr onclick="location.href='@Url.Page("Details", new {id = item.prohibitionID})'" style="cursor:pointer;">
            <td>
                @Html.DisplayFor(modelItem => item.employmentModel.givenID)
            </td>
            <td>
                @item.prohibitionStart.ToString("MMM dd, yyyy")
            </td>
            <td>
                @item.prohibitionEnd.ToString("MMM dd, yyyy")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.prohibitionStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.prohibitionReason)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.prohibitionType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.prohibitionRemark)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modifiedBy)
            </td>
            
        </tr>
}
    </tbody>
</table>
