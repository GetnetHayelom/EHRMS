@page
@model PIS2.Pages.Prohibition.DeleteModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Prohibition</h1>

<h3 class="fw-bold">Are you sure you want to delete this?</h3>
<div>
    <h4>prohibitionModel</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Start:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionStart)
        </dd>
        <dt class="col-sm-2">
            End:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionEnd)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionStatus)
        </dd>
        <dt class="col-sm-2">
            Reason:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionReason)
        </dd>
        <dt class="col-sm-2">
            Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionType)
        </dd>
        <dt class="col-sm-2">
            Remark:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionRemark)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.modifiedBy)
        </dd>
    </dl>
    
    <form method="post" class="d-flex justify-content-end">
        <input type="hidden" asp-for="prohibitionModel.prohibitionID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">View All Prohibitions</a>
    </form>
</div>
