@page
@model PIS2.Pages.Prohibition.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="fw-bold">Prohibition</h1>

<div>
    <h4 class="fw-bold">Prohibition Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Employee ID:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.employmentModel.givenID)
        </dd>
        <dt class="col-sm-2">
            Start:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionStart)
        </dd>
        <dt class="col-sm-2">
            End:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionEnd)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionStatus)
        </dd>
        <dt class="col-sm-2">
            Reason:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionReason)
        </dd>
        <dt class="col-sm-2">
            Type:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionType)
        </dd>
        <dt class="col-sm-2">
            Remark:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.prohibitionRemark)
        </dd>
        <dt class="col-sm-2">
            Modified By:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.prohibitionModel.modifiedBy)
        </dd>
    </dl>
</div>
<div class="d-flex justify-content-end">
    <a asp-page="./Edit" asp-route-id="@Model.prohibitionModel.prohibitionID" class="btn btn-success m-2">Edit</a>
    <a asp-page="./Delete" asp-route-id="@Model.prohibitionModel.prohibitionID" class="btn btn-danger m-2">Delete</a>
</div>
<a asp-page="./Index">View All Prohibition</a>