@page
@model PIS2.Pages.Prohibition.DetailsModel

@{
    ViewData["Title"] = "Prohibition Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("headerSimple", "")

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-exclamation-circle"></i> Prohibition Details
        </h2>
        <div class="d-print-none">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-list"></i> View All
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="fw-bold text-secondary mb-3">Employee Information</h4>

            <div class="d-flex mb-3">
                <div class="col-md-6">
                    <p><strong>Employee ID:</strong> @Model.prohibitionModel.employmentModel?.givenID</p>
                    <p><strong>Employee Name:</strong> @Model.prohibitionModel.employmentModel?.personModel?.personFullName</p>
                    <p><strong>Start Date:</strong> @Model.prohibitionModel.prohibitionStart.ToString("MMM dd, yyyy")</p>
                    <p><strong>End Date:</strong> @Model.prohibitionModel.prohibitionEnd.ToString("MMM dd, yyyy")</p>
                </div>
                <div class="col-md-6">
                    <p>
                        <strong>Status:</strong>
                        <span class="badge bg-@(Model.prohibitionModel.prohibitionStatus == Models.mainStatus.Suspended ? "danger" : "success")">
                            @Model.prohibitionModel.prohibitionStatus
                        </span>
                    </p>
                    <p><strong>Type:</strong> @Model.prohibitionModel.prohibitionType</p>
                    <p><strong>Reason:</strong> @Model.prohibitionModel.prohibitionReason</p>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <h5 class="fw-bold text-secondary">Remarks</h5>
                <p class="border rounded p-2 bg-light">
                    @Model.prohibitionModel.prohibitionRemark
                </p>
            </div>

            <div class="mb-2">
                <p class="text-muted">
                    <strong>Modified By:</strong> @Model.prohibitionModel.modifiedBy
                </p>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-end gap-2 d-print-none">
            
            @await Html.PartialAsync("print")
            <a asp-page="./Edit" asp-route-id="@Model.prohibitionModel.prohibitionID" class="btn btn-success m-2">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
           
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
