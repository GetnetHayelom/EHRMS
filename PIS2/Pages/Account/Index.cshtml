@page
@model PIS2.Pages.Account.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Accounts</h1>

<p>
    <a asp-page="Create">Add New Account</a>
</p>
@await Html.PartialAsync("filter")
<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Account Number
            </th>
            <th>
                Account Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.accountModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.accountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accountName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accountDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accountStatus)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.accountID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.accountID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.accountID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
