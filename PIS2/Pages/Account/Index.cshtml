@page
@model PIS2.Pages.Account.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h1 class="fw-bold">Accounts</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Account</a>
</p>
<div class="d-flex justify-content-end">
    <div class="me-2">@await Html.PartialAsync("filter")</div>
    @await Html.PartialAsync("print")
</div>

<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr class="bg-dark text-white">
            <th>
                Account Number
            </th>
            <th>
                Account Name
            </th>
            <th>
                Description
            </th>
            <th>
                Status
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.accountModel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.accountNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accountName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accountDescription)
            </td>
            <td>
                
                    @if (item.accountStatus == Models.mainStatus.Active)
                    {
                        <span class="badge bg-success">@Html.DisplayFor(modelItem => item.accountStatus)</span>

                    }
                    else if (item.accountStatus == Models.mainStatus.Suspended)
                    {
                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => item.accountStatus)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.accountStatus)</span>
                    }
            </td>
            <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@item.accountID" class="btn btn-sm btn-outline-primary" title="View Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@item.accountID" class="btn btn-sm btn-outline-success" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
            </td>
        </tr>
}
    </tbody>
</table>
<div class="d-flex justify-content-end">
    

    @await Html.PartialAsync("print")
</div>

