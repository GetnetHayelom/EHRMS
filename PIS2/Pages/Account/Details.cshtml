@page
@using PIS2.Enums
@model PIS2.Pages.Account.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<h2 class="fw-bold mb-0">Accounts</h2>
<p class="text-muted mb-0">Account details #@Model.accountModel.accountID</p>
<div class="d-flex justify-content-between gap-2">
    <div class="flex-fill card shadow-sm p-2">

        <dl class="row">
            <dt class="col-sm-4">
                Account Number:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.accountModel.accountNumber)
            </dd>
            <dt class="col-sm-4">
                Account Name:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.accountModel.accountName)
            </dd>
            <dt class="col-sm-4">
                Descrption:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.accountModel.accountDescription)
            </dd>
            <dt class="col-sm-4">
                Status:
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.accountModel.accountStatus)
            </dd>
        </dl>
        <div class="d-flex justify-content-end d-print-none align-items-end">
            <a asp-page="./Edit" asp-route-id="@Model.accountModel.accountID" class="btn btn-primary m-2"><i class="bi bi-pencil-square me-2"></i>Edit</a>
            @await Html.PartialAsync("print")
            <a asp-page="./Index" class="btn btn-outline-secondary m-2"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
        </div>
    </div>
    <div class="col-md-7 card shadow-sm p-2 d-print-none">
        <div class="">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-clock-history me-2"></i> Audit Trail
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr class="small text-uppercase">
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Field</th>
                                    <th>Old Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.History.Any())
                                {
                                    @foreach (var log in Model.History)
                                    {
                                        <tr>
                                            <td class="small">@log.ModifiedDate.ToString("MM/dd/yyyy HH:mm")</td>
                                            <td class="small fw-bold">@log.ModifiedBy</td>
                                            <td><span class="badge bg-light text-dark">@Model.GetFriendlyColumnName(log.ColumnName)</span></td>
                                            <td class="text-muted italic small">
                                                <span class="text-danger text-decoration-line-through small">
                                                    @Model.FormatAuditValue(log.ColumnName, log.OldValue)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No change history found for this record.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white small text-muted">
                    Total changes tracked: @Model.History.Count
                </div>
            </div>
        </div>

    </div>
</div>


<div>
    <!--TAB CONTROLS-->
    <div class="d-flex d-print-none mt-2">
        <ul class="nav nav-tabs">

            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#subAccounts"><strong>Sub Accounts</strong></button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#journal"><strong>Journal Entries</strong></button>
            </li>
           
        </ul>
    </div>
    <div class="tab-content">
        <!--SUB ACCOUNTS-->
        <div class="tab-pane fade show active" id="subAccounts">
            <div class="card shadow-sm p-2">
                <div class="card shadow-sm m-1 p-0">
                    <div class="d-flex justify-content-between align-items-end">
                        <h4 class="fw-bold m-2">Sub Accounts (@Model.SubAccounts.Count())</h4>
                        <div class="d-flex justify-content-end align-items-end m-0">
                            @await Html.PartialAsync("filter")
                            <excel-export table="dataTable" filename="@(Model.accountModel.accountName)_SubAccounts_@(DateTime.UtcNow).xlsx"></excel-export>
                        </div>
                    </div>
                    
                </div>
                <table class="table table-striped table-hover" id="dataTable">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Number</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="d-print-none text-end px-2">Actions</th>
                        </tr>
                        
                    </thead>
                    <tbody>
                        @if (Model.SubAccounts == null || !Model.SubAccounts.Any())
                        {
                            <tr>
                                
                                <td colspan="10" class="text-center text-muted">
                                    No sub accounts found.
                                </td>
                            </tr>
                        }
                        @{
                            int index = 1;
                        }
                        @foreach (var s in Model.SubAccounts.OrderBy(s => s.subAccountNumber))
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td>@s.subAccountNumber</td>
                                <td>@s.subAccountName</td>
                                <td>@s.subAccountDescription</td>
                                <td>
                                    @if (s.subAccountStatus == mainStatus.Active)
                                    {
                                        <span class="badge bg-success">@Html.DisplayFor(modelItem => s.subAccountStatus)</span>

                                    }
                                    else if (s.subAccountStatus == mainStatus.Suspended)
                                    {
                                        <span class="badge bg-warning">@Html.DisplayFor(modelItem => s.subAccountStatus)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Html.DisplayFor(modelItem => s.subAccountStatus)</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-page="./Details" asp-route-id="@s.subAccountID" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@s.subAccountID" class="btn btn-sm btn-outline-success" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!--JOURNAL ENTRIES-->
        <div class="tab-pane fade" id="journal">
            <div class="card shadow-sm p-2">
                <div class="card shadow-sm m-1 p-0">
                    <div class="d-flex justify-content-between align-items-end">
                        <h4 class="fw-bold m-2">Journal Entries</h4>
                        <div class="d-flex justify-content-end align-items-end m-0">
                            <div class="m-2"><input type="text" id="searchBox1" data-target="dataTable1" placeholder="finder..." class="searchBox form-control d-print-none"></div>
                            <excel-export table="dataTable1" filename="@(Model.accountModel.accountName)_Journal_@(DateTime.UtcNow).xlsx"></excel-export>
                        </div>
                    </div>

                </div>
                <table class="table table-hover" id="dataTable1">
                    <thead class="table-dark">
                        <tr>
                            <th>S/No</th>
                            <th>Account Name & Number</th>
                            <th>Account Description</th>
                            <th>Debit</th>
                            <th>Credit</th>
                        </tr>

                    </thead>
                    <tbody>
                        @if (Model.Journals == null || !Model.Journals.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted">
                                    No journal entries found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int index1 = 1;

                            foreach (var j in Model.Journals)
                            {
                                var collapseId = $"collapse_{index1}";

                                <tr class="table-light" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor:pointer;">
                                    <th>@index1</th>
                                    <th>
                                        <strong>
                                            @j.Reference
                                        </strong>
                                    </th>
                                    <th>@j.Count Entries</th>
                                    <th>@j.TotalDebit.ToString("N2")</th>
                                    <th>@j.TotalCredit.ToString("N2")</th>
                                </tr>

                                int index2 = 1;

                                foreach (var line in j.Lines)
                                {
                                    <tr id="@collapseId" class="collapse">
                                        <td>@($"{index1}.{index2++}")</td>
                                        <td>
                                            @line.subAccountName
                                            <span class="small text-muted">
                                                @line.subAccountNumber
                                            </span>
                                        </td>
                                        <td>@line.subAccountDescription</td>
                                        <td>@line.Debit.ToString("N2")</td>
                                        <td>@line.Credit.ToString("N2")</td>
                                    </tr>
                                }

                                <tr id="@collapseId" class="collapse fw-semibold">
                                    <td colspan="3"></td>
                                    <td>@j.TotalDebit.ToString("N2")</td>
                                    <td>@j.TotalCredit.ToString("N2")</td>
                                </tr>

                                index1++;
                            }

                            var grandDebit = Model.Journals.Sum(j => j.TotalDebit);
                            var grandCredit = Model.Journals.Sum(j => j.TotalCredit);

                            <tr class="fw-bold">
                                <td colspan="3"></td>
                                <td>@grandDebit.ToString("N2")</td>
                                <td>@grandCredit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end m-2 d-print-none">
    @await Html.PartialAsync("print")
    <a asp-page="./Index" class="btn btn-outline-secondary m-2"><i class="bi bi-arrow-left me-2"></i>Back to List</a>
</div>

