@page
@model PIS2.Pages.Account.DetailsModel

@{
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Accounts</h1>

<div>
    <h4>Account Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Account Number:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountNumber)
        </dd>
        <dt class="col-sm-2">
            Account Name:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountName)
        </dd>
        <dt class="col-sm-2">
            Descrption:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.accountModel.accountStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.accountModel.accountID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
