@page
@model PIS2.Pages.Account.BalanceSheetModel
@{
    ViewData["Title"] = "Balance Sheet";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0">Balance Sheet</h2>
            <p class="text-muted mb-0">Financial Position Statement</p>
        </div>
        <form method="get" class="form-inline">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text">As of:</span>
                </div>
                <input type="date" name="asOfDate" value="@Model.CurrentAsOfDate.ToString("MM/dd/yyyy")" class="form-control" onchange="this.form.submit()" />
            </div>
        </form>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card bg-light border-primary">
                <div class="card-body py-2">
                    <h6 class="text-primary uppercase small">Total Assets</h6>
                    <h4 class="mb-0">@Model.TotalAssets.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-danger">
                <div class="card-body py-2">
                    <h6 class="text-danger uppercase small">Total Liabilities</h6>
                    <h4 class="mb-0">@Model.TotalLiabilities.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-info">
                <div class="card-body py-2">
                    <h6 class="text-info uppercase small">Total Equity</h6>
                    <h4 class="mb-0">@Model.TotalEquity.ToString("N2")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h5 class="bg-dark text-white p-2">ASSETS</h5>
            <table class="table table-hover table-sm">
                <thead>
                    <tr class="text-muted small">
                        <th>Account</th>
                        <th class="text-right">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AssetAccounts)
                    {
                        <tr>
                            <td><strong>@item.Number</strong> - @item.Name</td>
                            <td class="text-right">@item.Balance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light font-weight-bold">
                    <tr>
                        <td>TOTAL ASSETS</td>
                        <td class="text-right border-top border-dark">@Model.TotalAssets.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="col-md-6">
            <h5 class="bg-secondary text-white p-2">LIABILITIES</h5>
            <table class="table table-hover table-sm mb-4">
                <tbody>
                    @foreach (var item in Model.LiabilityAccounts)
                    {
                        <tr>
                            <td><strong>@item.Number</strong> - @item.Name</td>
                            <td class="text-right">@item.Balance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light font-weight-bold">
                    <tr>
                        <td>TOTAL LIABILITIES</td>
                        <td class="text-right">@Model.TotalLiabilities.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <h5 class="bg-secondary text-white p-2">EQUITY</h5>
            <table class="table table-hover table-sm">
                <tbody>
                    @foreach (var item in Model.EquityAccounts)
                    {
                        <tr>
                            <td><strong>@item.Number</strong> - @item.Name</td>
                            <td class="text-right">@item.Balance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light font-weight-bold">
                    <tr>
                        <td>TOTAL EQUITY</td>
                        <td class="text-right">@Model.TotalEquity.ToString("N2")</td>
                    </tr>
                    <tr class="table-info">
                        <td>TOTAL LIABILITIES & EQUITY</td>
                        <td class="text-right border-top border-dark">@((Model.TotalLiabilities + Model.TotalEquity).ToString("N2"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-5">
        <h4 class="border-bottom pb-2">Trial Balance Detail</h4>
        <table class="table table-striped table-sm mt-3">
            <thead class="thead-dark">
                <tr>
                    <th>Account</th>
                    <th>Type</th>
                    <th class="text-right">Debit</th>
                    <th class="text-right">Credit</th>
                    <th class="text-right">Net Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TrialBalance)
                {
                    <tr>
                        <td>@item.Number - @item.Name</td>
                        <td><span class="badge badge-warning text-dark">@item.Type</span></td>
                        <td class="text-right text-success">@item.Debit.ToString("N2")</td>
                        <td class="text-right text-danger">@item.Credit.ToString("N2")</td>
                        <td class="text-right font-weight-bold">@item.Balance.ToString("N2")</td>
                    </tr>
                }
                
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2">Totals</th>
                    <th>@Model.TrialBalance.Sum(t => t.Debit).ToString("N2")</th>
                    <th>@Model.TrialBalance.Sum(t => t.Credit).ToString("N2")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>