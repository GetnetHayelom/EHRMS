@page
@model PIS2.Pages.Account.EditModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2 class="fw-bold mb-0">Accounts</h2>
<p class="text-muted mb-0">Update Account Details #@Model.accountModel.accountID</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="accountModel.accountID" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="accountModel.accountNumber" class="control-label">Account Number</label>
                <input asp-for="accountModel.accountNumber" class="form-control" />
                <span asp-validation-for="accountModel.accountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="accountModel.accountName" class="control-label">Account Name</label>
                <input asp-for="accountModel.accountName" class="form-control" />
                <span asp-validation-for="accountModel.accountName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="accountModel.accountDescription" class="control-label">Description</label>
                <input asp-for="accountModel.accountDescription" class="form-control" />
                <span asp-validation-for="accountModel.accountDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="accountModel.accountType" class="control-label">Type</label>
                <select asp-for="accountModel.accountType" class="form-control" asp-items="Html.GetEnumSelectList<Models.AccountType>()"></select>
                <span asp-validation-for="accountModel.accountType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="accountModel.accountStatus" class="control-label">Status</label>
                <select asp-for="accountModel.accountStatus" class="form-control" asp-items="Html.GetEnumSelectList<Models.mainStatus>()"></select>
                <span asp-validation-for="accountModel.accountStatus" class="text-danger"></span>
            </div>
            <div class="form-group d-flex justify-content-end m-2">
                <input type="submit" value="Update" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">View All Accounts</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
