@page
@model PIS2.Pages.Job.DeleteModel

@{
    ViewData["Title"] = "Delete Job";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Jobs</h1>

<h3>Are you sure you want to delete this job?</h3>
<div>
 
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobTitle)
        </dd>
        <dt class="col-sm-2">
            Job Grade:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobGradeModel.jobGradeID)
        </dd>
        <dt class="col-sm-2">
            Job Category:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobCategoryModel.jobCategoryID)
        </dd>
        <dt class="col-sm-2">
            Job Class:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobClassModel.jobClassDescription)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobStatus)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="jobModel.jobID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
