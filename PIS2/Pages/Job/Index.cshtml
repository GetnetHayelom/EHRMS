@page
@model PIS2.Pages.Job.IndexModel

@{
    ViewData["Title"] = "Jobs";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container py-4 print-container">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h1 class="fw-bold text-dark mb-1">Jobs</h1>
            <h5 class="text-muted">Manage and Review Job Records</h5>
        </div>
        <div>
            <a asp-page="Create" class="btn btn-primary me-2">
                <i class="bi bi-plus-circle"></i> Add New Job
            </a>
            <button type="button" onclick="window.print()" class="btn btn-success">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @await Html.PartialAsync("filter")

            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle" id="dataTable">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>Job Title</th>
                            <th>Job Grade</th>
                            <th>Job Category</th>
                            <th>Job Class</th>
                            <th>Experience</th>
                            <th>Status</th>
                            <th class="no-print text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.jobModel)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.jobTitle)</td>
                                <td>@Html.DisplayFor(modelItem => item.jobGradeModel.jobGradeName)</td>
                                <td>@Html.DisplayFor(modelItem => item.jobCategoryModel.jobCategoryName)</td>
                                <td>@Html.DisplayFor(modelItem => item.jobClassModel.JobClassName)</td>
                                <td>@Html.DisplayFor(modelItem => item.jobExperience)</td>
                                <td>
                                    @if (item.jobStatus.ToString() == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.jobStatus.ToString() == "Inactive")
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@item.jobStatus</span>
                                    }
                                </td>
                                <td class="no-print text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-success" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* --- Print Styles --- */
        @@media print {
            body {
                background: white !important;
                color: black !important;
            }

            .no-print {
                display: none !important;
            }

            .table {
                border-collapse: collapse !important;
                width: 100%;
            }

            .table th, .table td {
                border: 1px solid #000 !important;
                padding: 6px !important;
                font-size: 11pt !important;
            }

            .badge {
                color: black !important;
                background: none !important;
                border: none !important;
            }

            .card, .btn, .form-control {
                box-shadow: none !important;
                border: none !important;
            }

            .print-container {
                margin: 0;
                padding: 0;
            }

            h1, h5 {
                color: black !important;
            }

            @@page {
                size: A4 landscape;
                margin: 10mm;
            }
        }
    </style>
}
