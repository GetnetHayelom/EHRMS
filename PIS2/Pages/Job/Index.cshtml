@page
@using PIS2.Enums
@model PIS2.Pages.Job.IndexModel

@{
    ViewData["Title"] = "Jobs";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="d-flex justify-content-between align-items-center no-print">
    <div>
        <h2 class="fw-bold text-dark">Jobs</h2>
        <h6 class="text-muted">Manage and Review Jobs</h6>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-primary me-2">
            <i class="bi bi-plus-circle"></i> Add New Job
        </a>
        
    </div>
</div>
<div class="container py-4 print-container mb-2">

    <!-- SUMMARY POINTS -->
    <div class="card shadow-sm p-2 mb-2">
        <div class="d-flex gap-3 mb-4 d-print-flex flex-wrap">
            <div class="flex-fill">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Total No Of Jobs</small>
                                <h4 class="fw-bold mb-0"><u id="TotalRecords"></u>@Model.jobModel.Count().ToString("N0")</h4>
                            </div>
                            <div><i class="bi bi-journal-check fs-2 text-info"></i></div>
                        </div>
                    </div>
                </div>
            </div> <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Active</small> <h4 class="fw-bold mb-0"><u id="activeCount"></u>@Model.jobModel.Count(j => j.jobStatus == mainStatus.Active).ToString("N0")</h4>
                            </div>
                            <div><i class="bi bi-check-circle fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex-fill">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div> <small class="text-muted">Assigned</small> <h4 class="fw-bold mb-0"><u id="assignedCount"></u>@Model.AssignedJobs.ToString("N0")</h4> </div>
                            <div><i class="bi bi-people fs-2 text-success"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm m-2 p-2">
        <div class="card-header">
            <h4 class="fw-bold mb-0">Job Category Distribution</h4>
        </div>
        <div class="card-body d-flex flex-wrap gap-2">
            @foreach (var i in Model.jobModel.GroupBy(a => a.jobCategoryID).OrderByDescending(g => g.Count()))
            {
                <h6 class="fw-bold me-2">@i.FirstOrDefault()?.jobCategoryModel?.jobCategoryName -><span class="text-secondary fw-light">@i.Count().ToString("N0")</span></h6>
            }
        </div>

    </div>
    <div class="card shadow-sm m-2 p-2">
        <div class="card-header">
            <h4 class="fw-bold mb-0">Top 10 Job Class Distribution</h4>
        </div>
        <div class="card-body d-flex flex-wrap gap-2">
            @foreach (var i in Model.jobModel.GroupBy(a => a.jobClassID).OrderByDescending(g => g.Count()).Take(10))
            {
                <h6 class="fw-bold me-2">@i.FirstOrDefault()?.jobClassModel?.jobClassName -><span class="text-secondary fw-light">@i.Count().ToString("N0")</span></h6>
            }
        </div>

    </div>
    
    <div class="card shadow-sm p-2 mb-3">
        <div class="d-flex justify-content-between align-items-end gap-3">
            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Grade</label>
                <select class="form-select" asp-items="ViewBag.jobGradeID" id="jobGrade">
                    <option value="" selected> All</option>
                </select>
            </div>

            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Category</label>
                <select class="form-select" asp-items="ViewBag.jobCategoryID" id="jobCategory"><option value="" selected> All</option></select>
            </div>

            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Class</label>
                <select class="form-select" asp-items="ViewBag.jobClassID" id="jobClass"><option value="" selected> All</option></select>
            </div>
            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Status</label>
                <select class="form-select" asp-items="@Html.GetEnumSelectList<mainStatus>()" id="jobStatus"><option value="" selected> All</option></select>
            </div>
            <div class="felx-fill btn-group d-flex justify-content-end align-items-center">
                <button class="btn btn-primary" onclick="filterJobs()">Load</button>
                @await Html.PartialAsync("print")
                <excel-export table="dataTable" filename="Jobs_@(DateTime.Now).xlsx"></excel-export>
            </div>
        </div>

    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            @await Html.PartialAsync("filter")

            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle" id="dataTable">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>Job Title</th>
                            <th>Job Grade</th>
                            <th>Job Category</th>
                            <th>Job Class</th>
                            <th>Experience</th>
                            <th>Status</th>
                            <th class="no-print text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @await Html.PartialAsync("_JobTableRows", Model.jobModel)                   
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



<script>
    function filterJobs() {
        var jobGrade = $("#jobGrade").val();
        var jobCategory = $("#jobCategory").val();
        var jobClass = $("#jobClass").val();
        var jobStatus = $("#jobStatus").val();

        $.ajax({
            url: "@Url.Page("Index", "Filter")",
            type: "GET",
            data: {
                jobGrade: jobGrade || null,
                jobCategory: jobCategory || null,
                jobClass: jobClass || null,
                jobStatus: jobStatus || null
            },
            success: function (response) {
                $("#dataTable tbody").html(response);
            },
            error: function () {
                alert("Error loading filtered results.");
            }
        });
    }
</script>

