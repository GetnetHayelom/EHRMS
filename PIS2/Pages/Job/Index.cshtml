@page
@model PIS2.Pages.Job.IndexModel

@{
    ViewData["Title"] = "Jobs";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container py-4 print-container mb-2">
    <div class="d-flex justify-content-between align-items-center no-print">
        <div>
            <h2 class="fw-bold text-dark">Jobs</h2>
            <h6 class="text-muted">Manage and Review Jobs</h6>
        </div>
        <div>
            <a asp-page="Create" class="btn btn-primary me-2">
                <i class="bi bi-plus-circle"></i> Add New Job
            </a>
            <button type="button" onclick="window.print()" class="btn btn-success">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>
    <div class="card shadow-sm p-2 mb-3">
        <div class="d-flex justify-content-between gap-3">
            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Grade</label>
                <select class="form-select" asp-items="ViewBag.jobGradeID" id="jobGrade">
                    <option value="" selected> All</option>
                </select>
            </div>

            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Category</label>
                <select class="form-select" asp-items="ViewBag.jobCategoryID" id="jobCategory"><option value="" selected> All</option></select>
            </div>

            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Class</label>
                <select class="form-select" asp-items="ViewBag.jobClassID" id="jobClass"><option value="" selected> All</option></select>
            </div>
            <div class="flex-fill">
                <label class="form-label fw-semibold">Job Status</label>
                <select class="form-select" asp-items="@Html.GetEnumSelectList<Models.mainStatus>()" id="jobStatus"><option value="" selected> All</option></select>
            </div>
            <div class="col-md-1 d-flex justify-content-end align-items-center">
                <button class="btn btn-primary" onclick="filterJobs()">Load</button>
            </div>
        </div>

    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            @await Html.PartialAsync("filter")

            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle" id="dataTable">
                    <thead class="table-dark text-white">
                        <tr>
                            <th>Job Title</th>
                            <th>Job Grade</th>
                            <th>Job Category</th>
                            <th>Job Class</th>
                            <th>Experience</th>
                            <th>Status</th>
                            <th class="no-print text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.jobModel.OrderBy(j => j.jobTitle))
                        {
                            <tr>
                                <td>@item.jobTitle</td>
                                <td>@item.jobGradeModel?.jobGradeName</td>
                                <td>@item.jobCategoryModel?.jobCategoryName</td>
                                <td>@item.jobClassModel?.jobClassName</td>
                                <td>@item.jobExperience</td>
                                <td>
                                    @if (item.jobStatus.ToString() == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.jobStatus.ToString() == "Inactive")
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@item.jobStatus</span>
                                    }
                                </td>
                                <td class="no-print text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.jobID" class="btn btn-sm btn-outline-success" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* --- Print Styles --- */
        @@media print {
            body {
                background: white !important;
                color: black !important;
            }

            .no-print {
                display: none !important;
            }

            .table {
                border-collapse: collapse !important;
                width: 100%;
            }

            .table th, .table td {
                border: 1px solid #000 !important;
                padding: 6px !important;
                font-size: 11pt !important;
            }

            .badge {
                color: black !important;
                background: none !important;
                border: none !important;
            }

            .card, .btn, .form-control {
                box-shadow: none !important;
                border: none !important;
            }

            .print-container {
                margin: 0;
                padding: 0;
            }

            h1, h5 {
                color: black !important;
            }

            @@page {
                size: A4 landscape;
                margin: 10mm;
            }
        }
    </style>
}

<script>
    function filterJobs() {
        var jobGrade = $("#jobGrade").val();
        var jobCategory = $("#jobCategory").val();
        var jobClass = $("#jobClass").val();
        var jobStatus = $("#jobStatus").val();

        $.ajax({
            url: "@Url.Page("Index", "Filter")",
            type: "GET",
            data: {
                jobGrade: jobGrade || null,
                jobCategory: jobCategory || null,
                jobClass: jobClass || null,
                jobStatus: jobStatus || null
            },
            success: function (response) {
                $("#dataTable tbody").html(response);
            },
            error: function () {
                alert("Error loading filtered results.");
            }
        });
    }
</script>

