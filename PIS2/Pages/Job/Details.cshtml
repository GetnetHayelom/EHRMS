@page
@model PIS2.Pages.Job.DetailsModel

@{
    ViewData["Title"] = "Job Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Jobs</h1>

<div>
    <h4>Job Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Job Title:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobTitle)
        </dd>
        <dt class="col-sm-2">
            Job Grade:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobGradeModel.jobGradeID)
        </dd>
        <dt class="col-sm-2">
            Job Category:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobCategoryModel.jobCategoryID)
        </dd>
        <dt class="col-sm-2">
            Job Class:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobClassModel.JobClassDescription)
        </dd>
        <dt class="col-sm-2">
            Description:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobDescription)
        </dd>
        <dt class="col-sm-2">
            Status:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.jobModel.jobStatus)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.jobModel.jobID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
