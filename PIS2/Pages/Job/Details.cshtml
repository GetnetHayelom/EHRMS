@page
@model PIS2.Pages.Job.DetailsModel

@{
    ViewData["Title"] = "Job Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container py-4 print-container">
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <h2 class="fw-bold mb-0">Jobs</h2>
            <h6 class="text-muted">Job Details</h6>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary me-2 d-print-none">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
            <a asp-page="Edit" asp-route-id="@Model.jobModel.jobID" class="btn btn-primary me-2 d-print-none">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <button type="button" onclick="window.print()" class="btn btn-primary">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-0">@Model.jobModel.jobTitle</h3>
                <p class="text-muted mb-0">Detailed Job Information</p>
                <hr class="w-25 mx-auto my-3" />
            </div>

            <dl class="d-flex flex-wrap mb-0">
                <dt class="col-sm-2 fw-semibold text-secondary">Job Title:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobTitle)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Grade:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobGradeModel.jobGradeID)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Category:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobCategoryModel.jobCategoryID)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Class:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobClassModel.jobClassDescription)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Description:</dt>
                <dd class="col-sm-10 ql-editor">@Html.Raw(Model.jobModel.jobDescription)</dd>
                
                <dt class="col-sm-2 fw-semibold text-secondary">Qualifications:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobQualifications)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Experience (years):</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobExperience)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Status:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobStatus)</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4 d-print-none align-items-end">
        <a asp-page="Index" class="btn btn-outline-secondary px-4 m-2">
            <i class="bi bi-arrow-left-circle"></i> Back
        </a>
        <a asp-page="Edit" asp-route-id="@Model.jobModel.jobID" class="btn btn-primary px-4 m-2">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        @await Html.PartialAsync("print")
        
    </div>
</div>

@section Scripts {

}
