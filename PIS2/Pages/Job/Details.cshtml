@page
@using PIS2.Enums
@model PIS2.Pages.Job.DetailsModel

@{
    ViewData["Title"] = "Job Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
@await Html.PartialAsync("headerSimple", "")
<div class="container py-4 print-container">
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <h2 class="fw-bold mb-0">Jobs</h2>
            <p class="text-muted">Job Details #@Model.jobModel.jobID</p>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary me-2 d-print-none">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
            <a asp-page="Edit" asp-route-id="@Model.jobModel.jobID" class="btn btn-primary me-2 d-print-none">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <button type="button" onclick="window.print()" class="btn btn-primary">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-0">@Model.jobModel.jobTitle</h3>
                <p class="text-muted mb-0">Detailed Job Information</p>
                <hr class="w-25 mx-auto my-3" />
            </div>

            <dl class="d-flex flex-wrap mb-0">
                <dt class="col-sm-2 fw-semibold text-secondary">Job Title:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobTitle)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Grade:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobGradeModel.jobGradeName)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Category:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobCategoryModel.jobCategoryName)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Job Class:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobClassModel.jobClassName)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Description:</dt>
                <dd class="col-sm-10 ql-editor">@Html.Raw(Model.jobModel.jobDescription)</dd>
                
                <dt class="col-sm-2 fw-semibold text-secondary">Qualifications:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobQualifications)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Experience (years):</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobExperience)</dd>

                <dt class="col-sm-2 fw-semibold text-secondary">Status:</dt>
                <dd class="col-sm-10">@Html.DisplayFor(m => m.jobModel.jobStatus)</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4 d-print-none align-items-end">
        <a asp-page="Index" class="btn btn-outline-secondary px-4 m-2">
            <i class="bi bi-arrow-left-circle"></i> Back
        </a>
        <a asp-page="Edit" asp-route-id="@Model.jobModel.jobID" class="btn btn-primary px-4 m-2">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        @await Html.PartialAsync("print")
        
    </div>
</div>
<div class="card shadow-sm p-2 m-2">
    <div class="card-header"><h5 class="fw-bold m-0">Active Placements</h5></div>
    <div class="card-body">
        <table class="table table-striped table-hover print-full-width" id="dataTable">
            <thead>
                <tr class="bg-dark text-white">
                    <th>S/No</th>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Department
                    </th>

                    <th>
                        Salary
                    </th>
                    <th>
                        Date
                    </th>
                    
                    <th>Grade & Step</th>
                    <th class="d-print-none px-4 text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in Model.jobPlacementModel.Where(j => j.jobPlacementStatus == mainStatus.Active))
                {
                    <tr>
                        <td>@(index++)</td>
                        <td>
                            @Html.DisplayFor(modelItem => item.givenID)
                            <p class="text-secondary small m-0">@item.FullName</p>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.departmentName)
                        </td>
                      
                        <td>
                            @item.jobPlacementSalary.ToString("N2")
                        </td>
                        <td>
                            @item.jobPlacementDate.ToString("MM/dd/yyyy")
                        </td>
                       
                        <td>
                            @item.jobGradeName
                            <p class="text-secondary small m-0">@item.jobStepName</p>
                        </td>

                        <td class="d-print-none px-4 text-end">
                            <div class="btn-group" role="group">
                                <a asp-page="./Details" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>       
</div>
<div class="card shadow-sm p-2">
    <div class="card-header"><h5 class="fw-bold m-0">Previous Placements</h5></div>
    <div class="card-body">
        <table class="table table-striped table-hover print-full-width" id="dataTable">
            <thead>
                <tr class="bg-dark text-white">
                    <th>S/No</th>
                    <th>
                        Employee ID
                    </th>
                    <th>
                        Department
                    </th>
                    
                    <th>
                        Salary
                    </th>
                    <th>
                        Date
                    </th>
            
                    <th>Grade & Step</th>
                    <th class="d-print-none px-4 text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index1 = 1;
                }
                @foreach (var item in Model.jobPlacementModel.Where(j => j.jobPlacementStatus == mainStatus.Inactive))
                {
                    <tr>
                        <td>@(index1++)</td>
                        <td>
                            @Html.DisplayFor(modelItem => item.givenID)
                            <p class="text-secondary small m-0">@item.FullName</p>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.departmentName)
                        </td>
                        
                        <td>
                            @item.jobPlacementSalary.ToString("N2")
                        </td>
                        <td>
                            @item.jobPlacementDate.ToString("MM/dd/yyyy")
                        </td>
                        
                        <td>
                            @item.jobGradeName
                            <p class="text-secondary small m-0">@item.jobStepName</p>
                        </td>

                        <td class="d-print-none px-4 text-end">
                            <div class="btn-group" role="group">
                                <a asp-page="./Details" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.jobPlacementID" class="btn btn-sm btn-outline-success" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
@section Scripts {

}
